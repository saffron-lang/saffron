//! Host FFI for the playground frontend.
//!
//! Two things the UI cannot do from inside Saffron:
//!
//!   1. Talk to the compile service (browser `fetch`).
//!   2. Instantiate and run the *returned* wasm module.
//!
//! (2) is the interesting one. The compiled user program is a second, independent
//! wasm module. We cannot instantiate it from inside this module — the JS loader
//! has to do it, in its own import environment, with `js_log_*` rerouted into a
//! buffer instead of the console. That keeps the user's program strictly separate
//! from the UI's own memory: it gets a fresh linear memory and only the imports
//! the loader hands it.

// --- Compile service ---

@extern("void js_fetch_post(void*, void*, i64)")
fun _fetch_post(url: String, body: String, callback_id: Float)

@extern("void js_fetch_json(void*, i64)")
fun _fetch_get(url: String, callback_id: Float)

// --- Run a compiled module, base64-encoded ---
//
// Asynchronous because instantiation is async in the browser and because the
// program may suspend on the scheduler; the loader pumps it and only then reports.
@extern("void js_run_wasm(void*, i64)")
fun _run_wasm(wasm_base64: String, callback_id: Float)

// --- Clipboard / permalink helpers ---

@extern("void js_set_hash_source(void*)")
fun _set_hash_source(source: String)

@extern("i64 js_get_hash_source()")
fun _get_hash_source(): String

/// Pending callbacks, indexed by position.
///
/// A `Map<Float, ...>` is the obvious choice and it does not work. Callback ids
/// make a round trip out to JS and back in through an exported wasm function,
/// and a value arriving that way is a **bare machine integer**, not a NaN-boxed
/// one: JS hands wasm `1n`, whereas the id the module stored was the f64 bit
/// pattern of 1.0 (`0x3FF0000000000000`). `__map_key_cmp`
/// (src/runtime/runtime.sf:287) compares non-string keys by exact bit pattern,
/// so `_callbacks.has(id)` was false for every id and every completion handler
/// was silently dropped — the Run button POSTed, the response came back, and
/// nothing happened. See BUGS.md #73.
///
/// A List sidesteps it entirely: an index only has to compare numerically, which
/// survives the representation change. This is also why Turmeric's own
/// `__dispatch_event` (turmeric/src/prelude/03_callbacks.sf:27) is List-based.
/// Slots are never reused, so ids stay unique for the page's lifetime.
var _callbacks: List<(String) => Nil> = []

fun _register(callback: (String) => Nil): Float {
    _callbacks.push(callback)
    return _callbacks.length() - 1
}

fun _resolve(id: Float, payload: String) {
    if (id >= 0 and id < _callbacks.length()) {
        var callback: (String) => Nil = _callbacks[id]
        callback(payload)
    }
}

/// POST source to the compile service. `callback` receives the raw JSON body.
///
/// The parameter is `program_text`, not `source`, and that is load-bearing: a
/// function parameter whose name collides with ANY module-level global anywhere
/// in the program silently reads the global instead (BUGS.md #40). main.sf has a
/// `var source = signal("")`, so a parameter called `source` here compiled to
/// `load i64, i64* @__g_source` — the Signal object — and the editor contents
/// never reached the request. The symptom was a Run button that POSTed
/// `{"source":"<3 bytes of garbage>"}` with no error anywhere.
fun compile(program_text: String, callback: (String) => Nil) {
    var payload: String = "{\"source\":" + json_quote(program_text) + "}"
    _fetch_post("/api/compile", payload, _register(callback))
}

/// GET the bundled examples. `callback` receives the raw JSON body.
fun examples(callback: (String) => Nil) {
    _fetch_get("/api/examples", _register(callback))
}

/// Instantiate and run a base64 module. `callback` receives the captured output.
fun run(wasm_base64: String, callback: (String) => Nil) {
    _run_wasm(wasm_base64, _register(callback))
}

// Same shadowing hazard as `compile` above (BUGS.md #40): `source` collides
// with main.sf's global signal.
fun share(program_text: String) {
    _set_hash_source(program_text)
}

fun initial_source(): String {
    return _get_hash_source()
}

/// Exported to JS: resolution for both fetch helpers.
fun __on_fetch_complete(id: Float, response: String) {
    _resolve(id, response)
}

/// Exported to JS: resolution for `js_run_wasm`.
fun __on_run_complete(id: Float, captured: String) {
    // `captured`, not `output`: main.sf has a global `var output = signal("")`
    // and a parameter of that name would read the Signal instead (BUGS.md #40).
    _resolve(id, captured)
}

/// Minimal JSON string escaping.
///
/// Hand-rolled rather than using @json, because @json is a native module that is
/// not available on wasm32 — it has no wasm implementation, so importing it here
/// fails to link. Program source is exactly the payload most likely to contain
/// quotes, backslashes and newlines, so getting this right matters.
fun json_quote(value: String): String {
    var out: String = "\""
    var i: Int = 0
    while (i < value.length()) {
        var ch: String = value.char_at(i)
        if (ch == "\"") {
            out = out + "\\\""
        } else if (ch == "\\") {
            out = out + "\\\\"
        } else if (ch == "\n") {
            out = out + "\\n"
        } else if (ch == "\r") {
            out = out + "\\r"
        } else if (ch == "\t") {
            out = out + "\\t"
        } else {
            out = out + ch
        }
        i = i + 1
    }
    return out + "\""
}

/// Pull one string field out of a flat JSON object.
///
/// Deliberately not a real parser: the only responses we consume are produced by
/// our own service, and the `wasm` field is a multi-megabyte base64 blob that a
/// naive character-at-a-time Saffron parser would be very slow over. This scans
/// for `"key":"` and reads to the closing quote, honouring backslash escapes.
fun json_field(body: String, key: String): String {
    var needle: String = "\"" + key + "\""
    var at: Int = body.index_of(needle)
    if (at < 0) { return "" }
    var i: Int = at + needle.length()
    // Skip whitespace and the colon. Saffron has no `break` (BUGS.md #6), so the
    // loops here carry an explicit `scanning` flag rather than jumping out.
    var scanning: Bool = true
    while (scanning and i < body.length()) {
        var c: String = body.char_at(i)
        if (c == ":" or c == " " or c == "\n" or c == "\t" or c == "\r") {
            i = i + 1
        } else {
            scanning = false
        }
    }
    if (i >= body.length()) { return "" }
    if (body.char_at(i) != "\"") {
        // Not a string value — read the bare token (true/false/number).
        var bare: String = ""
        var reading: Bool = true
        while (reading and i < body.length()) {
            var bc: String = body.char_at(i)
            if (bc == "," or bc == "}") {
                reading = false
            } else {
                bare = bare + bc
                i = i + 1
            }
        }
        return bare.trim()
    }
    i = i + 1
    var start: Int = i

    // Locate the closing quote WITHOUT accumulating, then take one slice.
    //
    // The obvious `out = out + ch` per character is quadratic in allocation:
    // Saffron strings are immutable, so each `+` mallocs a fresh copy of
    // everything so far. The `wasm` field is an 11 KB base64 blob, which made
    // that ~11000 allocations averaging 5.5 KB — about 60 MB of garbage — and it
    // died with "memory access out of bounds" inside strcpy on wasm32, where
    // linear memory does not grow to meet that. Scanning for the end index and
    // slicing once is a single allocation.
    var has_escape: Bool = false
    var scanning_value: Bool = true
    while (scanning_value and i < body.length()) {
        var ch: String = body.char_at(i)
        if (ch == "\\") {
            has_escape = true
            i = i + 2
        } else if (ch == "\"") {
            scanning_value = false
        } else {
            i = i + 1
        }
    }
    var raw: String = body.slice(start, i)
    if (!has_escape) { return raw }
    return json_unescape(raw)
}

/// Expand backslash escapes in an already-extracted JSON string body.
///
/// Only called for fields that actually contain a backslash, which in practice
/// means `diagnostics` (compiler output, with newlines) — never the base64
/// `wasm` payload, whose alphabet has no escapable characters. So the quadratic
/// concatenation here is bounded by a diagnostic message rather than a module.
fun json_unescape(raw: String): String {
    var out: String = ""
    var i: Int = 0
    while (i < raw.length()) {
        var ch: String = raw.char_at(i)
        if (ch == "\\") {
            var next: String = ""
            if (i + 1 < raw.length()) { next = raw.char_at(i + 1) }
            if (next == "n") { out = out + "\n" }
            else if (next == "t") { out = out + "\t" }
            else if (next == "r") { out = out + "\r" }
            else if (next == "\"") { out = out + "\"" }
            else if (next == "\\") { out = out + "\\" }
            else { out = out + next }
            i = i + 2
        } else {
            out = out + ch
            i = i + 1
        }
    }
    return out
}
