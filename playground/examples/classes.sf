//! Classes, interfaces and operator overloading
// A subclass inherits its parent's fields and methods, and can override them.
class Animal {
    var name: String
    fun init(name: String) { this.name = name }
    fun speak(): String { return "..." }
}

class Dog extends Animal {
    fun speak(): String { return "Woof" }
}

class Cat extends Animal {
    fun speak(): String { return "Meow" }
}

var rex = Dog("Rex")
var mia = Cat("Mia")
// `name` comes from Animal; `speak` is the subclass's own.
// Each is called on its concrete type: a `List<Animal>` would not dispatch to
// the override yet — see BUGS.md #50.
IO.println("${rex.name} says ${rex.speak()}")
IO.println("${mia.name} says ${mia.speak()}")

// An interface declares methods an implementor must provide.
// (Interfaces may also carry default method bodies, but a default that calls
// back into an abstract method reads 0 today — BUGS.md #50.)
interface Shape {
    fun area(): Float
}

class Square extends Shape {
    var side: Float
    fun init(side: Float) { this.side = side }
    fun area(): Float { return this.side * this.side }
}

IO.println(Square(3.0).area())

// Operator overloading: define `add` to make `+` work
class Vec2 {
    var x: Float
    var y: Float
    fun init(x: Float, y: Float) { this.x = x; this.y = y }
    fun add(other: Vec2): Vec2 { return Vec2(this.x + other.x, this.y + other.y) }
    fun to_string(): String { return "(${this.x}, ${this.y})" }
}

var sum = Vec2(1.0, 2.0) + Vec2(3.0, 4.0)
IO.println(sum.to_string())
