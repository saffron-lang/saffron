    fun is_list_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => base == "List"
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_string_list_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => {
                if (base != "List") return false
                if (args.length() == 0) return false
                return this.is_string_type(args[0])
            }
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_map_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => base == "Map"
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
