// LLVM IR code generator for Saffron-mini

import "./ast.sf" as AST
import "llvm/types" as LLVMTypes
import "llvm/instructions" as LLVMInst
import "llvm/module" as LLVMMod
import "llvm/function" as LLVMFunc
import "llvm/block" as LLVMBlock
import "llvm/nanbox" as LLVMNanBox

// Runtime function prefix — change this to avoid collisions with user code.
// Currently "__" (e.g., __list_new, __map_get). Could become "__sf_" later.
var RT_PREFIX: String = "__"
var __codegen_errors: Bool = false

class Codegen {
    var sb: StringBuilder
    var label_counter: Float
    var local_counter: Float
    var globals: List<String>
    var string_constants: List<String>
    var block_terminated: Bool
    var enum_defs: Map<String, List<String>>
    var enum_variant_tags: Map<String, Float>
    var enum_variant_fields: Map<String, String>
    var type_defs: StringBuilder
    var known_functions: List<String>
    var func_ret_types: Map<String, AST.Type>
    var class_fields: Map<String, String>
    var class_field_list: Map<String, List<String>>
    var class_struct_names: Map<String, String>
    var class_methods: Map<String, List<String>>
    var current_class: String
    var current_parent: String
    var current_function_name: String
    var string_vars: List<String>
    var last_type: AST.Type
    var typed_vars: Map<String, AST.Type>
    var loop_end_label: String
    var loop_break_label: String
    var loop_continue_label: String
    var current_ret_type: String
    var called_functions: List<String>
    var called_function_arity: Map<String, Float>
    var module_prefixes: Map<String, String>
    var func_prefix_map: Map<String, String>
    var func_defaults: Map<String, List<AST.Expr>>
    var func_param_count: Map<String, Float>
    var func_param_names: Map<String, List<String>>
    var current_prefix: String
    var module_globals: Map<String, Bool>
    var global_var_types: Map<String, String>
    var register_only: Bool
    var in_function: Bool
    var intrinsic_funcs: List<String>
    var extern_sigs: Map<String, String>
    var defined_funcs: List<String>
    var builtin_methods: Map<String, String>
    var extend_map: Map<String, String>
    var pending_extend_class: String
    var named_imports: Map<String, String>
    var target: String
    var has_errors: Bool
    var module_init_names: List<String>
    var identity_mode: Bool
    var coroutine_funcs: List<String>
    var inline_funcs: List<String>
    var is_coroutine: Bool
    var use_llvm_lib: Bool
    var emit_llvm_lib: Bool
    var gc_root_count: Float
    var class_type_ids: Map<String, Float>
    var next_class_type_id: Float
    var llvm_module: LLVMMod.Module
    var llvm_func_builder: LLVMFunc.FunctionBuilder
    var llvm_block_builder: LLVMBlock.BlockBuilder
    var llvm_values: Map<String, Any>
    var actor_classes: Map<String, Bool>
    var force_next_lambda_coro: Bool
    var check_spawn_sendable: Bool

    fun init() {
        this.sb = StringBuilder()
        this.label_counter = 0
        this.local_counter = 0
        this.globals = []
        this.string_constants = []
        this.block_terminated = false
        this.enum_defs = {}
        this.enum_variant_tags = {}
        this.enum_variant_fields = {}
        this.type_defs = StringBuilder()
        this.known_functions = []
        this.func_ret_types = {}
        this.class_fields = {}
        this.class_field_list = {}
        this.class_struct_names = {}
        this.class_methods = {}
        this.current_class = ""
        this.current_parent = ""
        this.current_function_name = ""
        this.string_vars = []
        this.last_type = AST.Type.IntType
        this.typed_vars = {}
        this.loop_end_label = ""
        this.loop_break_label = ""
        this.loop_continue_label = ""
        this.current_ret_type = "i64"
        this.called_functions = []
        this.called_function_arity = {}
        this.module_prefixes = {}
        this.func_prefix_map = {}
        this.func_defaults = {}
        this.func_param_count = {}
        this.func_param_names = {}
        this.current_prefix = ""
        this.module_globals = {}
        this.global_var_types = {}
        this.register_only = false
        this.in_function = false
        this.intrinsic_funcs = []
        this.extern_sigs = {}
        this.defined_funcs = []
        this.builtin_methods = {}
        this.extend_map = {}
        this.pending_extend_class = ""
        this.named_imports = {}
        this.target = "native"
        this.has_errors = false
        this.module_init_names = []
        this.identity_mode = false
        this.coroutine_funcs = []
        this.inline_funcs = []
        this.is_coroutine = false
        this.use_llvm_lib = true
        this.emit_llvm_lib = false
        this.gc_root_count = 0
        this.class_type_ids = {}
        this.next_class_type_id = 10
        this.actor_classes = {}
        this.force_next_lambda_coro = false
        this.check_spawn_sendable = false
        this.llvm_module = LLVMMod.Module("saffron_program")
        // Workaround: gen2 doesn't emit init calls for cross-module class constructors.
        // Explicitly call init to set up internal lists/fields.
        this.llvm_module.init("saffron_program")
        var dummy_params: List<LLVMFunc.Param> = []
        this.llvm_func_builder = LLVMFunc.FunctionBuilder("__dummy", LLVMTypes.Type.I64, dummy_params)
        this.llvm_func_builder.init("__dummy", LLVMTypes.Type.I64, dummy_params)
        var dummy_bb: LLVMFunc.BasicBlock = LLVMFunc.BasicBlock("entry")
        dummy_bb.init("entry")
        this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, dummy_bb)
        this.llvm_block_builder.init(this.llvm_func_builder, dummy_bb)
        this.llvm_values = {}
        // String methods are dispatched via class_methods (see methods_body.sf)

        // Register built-in type classes in class_methods so method resolution
        // finds them. These mirror the type class definitions in src/lib/*.sf.
        // Methods listed here will be resolved via gen_namespace_call when the
        // receiver's type is known — keeping inline emission for primitives while
        // enabling proper dispatch for user-visible .to_string(), .abs(), etc.
        this.class_methods.set("String", ["length", "char_at", "contains", "starts_with", "ends_with", "index_of", "trim", "to_upper", "to_lower", "slice", "split", "replace", "repeat", "to_string", "to_number"])
        this.class_methods.set("List", ["length", "push", "pop", "get", "set", "remove", "contains", "reverse", "copy", "sort", "slice", "join", "to_string"])
        this.class_methods.set("Map", ["length", "has", "get", "set", "keys", "values", "to_string"])
        this.class_methods.set("Int", ["to_string", "to_float", "abs", "floor", "ceil"])
        this.class_methods.set("Float", ["to_string", "floor", "ceil", "abs"])
        this.class_methods.set("Bool", ["to_string"])

        // HTML element functions (provided by turmeric runtime library)
        this.known_functions.push("div")
        this.known_functions.push("span")
        this.known_functions.push("h1")
        this.known_functions.push("h2")
        this.known_functions.push("h3")
        this.known_functions.push("h4")
        this.known_functions.push("h5")
        this.known_functions.push("h6")
        this.known_functions.push("p")
        this.known_functions.push("button")
        this.known_functions.push("input")
        this.known_functions.push("ul")
        this.known_functions.push("ol")
        this.known_functions.push("li")
        this.known_functions.push("a")
        this.known_functions.push("nav")
        this.known_functions.push("header")
        this.known_functions.push("footer")
        this.known_functions.push("main")
        this.known_functions.push("section")
        this.known_functions.push("form")
        this.known_functions.push("label")
        this.known_functions.push("table")
        this.known_functions.push("tr")
        this.known_functions.push("td")
        this.known_functions.push("th")
        this.known_functions.push("textarea")
        this.known_functions.push("select")
        this.known_functions.push("option")
        this.known_functions.push("pre")
        this.known_functions.push("code")
        this.known_functions.push("br")
        this.known_functions.push("hr")
        this.known_functions.push("img")
        this.known_functions.push("text")
    }

    // Split a string by delimiter, respecting nested <> brackets.
    fun split_respecting_generics(s: String, delim: String): List<String> {
        var result: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">") {
                depth = depth - 1
                current = current + ch
            } else if (ch == delim and depth == 0) {
                result.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            result.push(current)
        }
        return result
    }

    fun sanitize_name(name: String): String {
        // Prefix reserved LLVM names to avoid collisions with labels
        if (name == "entry" or name == "end" or name == "loop" or name == "body") {
            return "v_" + name
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < name.length()) {
            var ch: String = name.char_at(i)
            if (ch == "." or ch == "(" or ch == ")") {
                sb.append("_")
            } else {
                sb.append(ch)
            }
            i = i + 1
        }
        return sb.to_string()
    }

    fun fresh_label(prefix: String): String {
        this.label_counter = this.label_counter + 1
        return prefix + this.label_counter.floor().to_string()
    }

    fun fresh_local(): String {
        this.local_counter = this.local_counter + 1
        return "%t" + this.local_counter.floor().to_string()
    }

    fun reset_locals() {
        this.local_counter = 0
    }

    fun set_last_type(t: AST.Type) {
        this.last_type = t
    }

    fun set_current_class(c: String) {
        this.current_class = c
    }

    fun set_current_prefix(p: String) {
        this.current_prefix = p
    }

    fun emit(line: String) {
        this.sb.append(line)
        this.sb.append("\n")
    }

    fun emit_indent(line: String) {
        if (this.block_terminated) return nil
        this.sb.append("  ")
        this.sb.append(line)
        this.sb.append("\n")
    }

    fun emit_terminator(line: String) {
        if (this.block_terminated) return nil
        this.sb.append("  ")
        this.sb.append(line)
        this.sb.append("\n")
        this.block_terminated = true
    }

    // --- Pointer ↔ value helpers (wasm32-aware) ---
    // On wasm32, pointers are i32 but value slots are i64.
    // These helpers insert the necessary i32↔i64 conversions.

    fun ptr_to_val(ptr_reg: String): String {
        // Convert an i8* pointer register to an i64 value
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = ptrtoint i8* " + ptr_reg + " to i32")
            var i64_reg: String = this.fresh_local()
            this.emit_indent(i64_reg + " = zext i32 " + i32_reg + " to i64")
            return i64_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = ptrtoint i8* " + ptr_reg + " to i64")
        return reg
    }

    fun val_to_ptr(val_reg: String): String {
        // Convert an i64 value to an i8* pointer register
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = trunc i64 " + val_reg + " to i32")
            var ptr_reg: String = this.fresh_local()
            this.emit_indent(ptr_reg + " = inttoptr i32 " + i32_reg + " to i8*")
            return ptr_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = inttoptr i64 " + val_reg + " to i8*")
        return reg
    }

    fun typed_ptr_to_val(ptr_reg: String, ptr_type: String): String {
        // Convert a typed pointer (e.g. [2 x i64]*) to an i64 value
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = ptrtoint " + ptr_type + " " + ptr_reg + " to i32")
            var i64_reg: String = this.fresh_local()
            this.emit_indent(i64_reg + " = zext i32 " + i32_reg + " to i64")
            return i64_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = ptrtoint " + ptr_type + " " + ptr_reg + " to i64")
        return reg
    }

    fun val_to_typed_ptr(val_reg: String, ptr_type: String): String {
        // Convert an i64 value to a typed pointer (e.g. [2 x i64]*)
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = trunc i64 " + val_reg + " to i32")
            var ptr_reg: String = this.fresh_local()
            this.emit_indent(ptr_reg + " = inttoptr i32 " + i32_reg + " to " + ptr_type)
            return ptr_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = inttoptr i64 " + val_reg + " to " + ptr_type)
        return reg
    }

    fun fn_ptr_to_val(fn_type_str: String, fn_name: String): String {
        // Convert a function pointer (@name with type) to an i64 value
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = ptrtoint " + fn_type_str + " " + fn_name + " to i32")
            var i64_reg: String = this.fresh_local()
            this.emit_indent(i64_reg + " = zext i32 " + i32_reg + " to i64")
            return i64_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = ptrtoint " + fn_type_str + " " + fn_name + " to i64")
        return reg
    }

    fun val_to_fn_ptr(val_reg: String, fn_type: String): String {
        // Convert an i64 value to a function pointer
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = trunc i64 " + val_reg + " to i32")
            var ptr_reg: String = this.fresh_local()
            this.emit_indent(ptr_reg + " = inttoptr i32 " + i32_reg + " to " + fn_type)
            return ptr_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = inttoptr i64 " + val_reg + " to " + fn_type)
        return reg
    }

    fun malloc_size_arg(size_reg: String): String {
        // malloc always takes i64 (runtime truncates internally for wasm32)
        return size_reg
    }

    fun malloc_size_type(): String {
        return "i64"
    }

    fun start_block(label: String) {
        this.emit(label + ":")
        this.block_terminated = false
    }

    // --- Type mapping ---

    fun llvm_type(t: String): String {
        if (t == "Int") return "i64"
        if (t == "Float") return "i64"
        if (t == "Bool") return "i64"
        if (t == "String") return "i64"
        if (t == "Nil") return "i64"
        if (t == "Any") return "i64"
        if (t == "List") return "i64"
        if (t == "Map") return "i64"
        return "i64"
    }

    // --- String constants ---

    fun add_string_constant(s: String): String {
        var idx: Float = this.string_constants.length()
        var name: String = "@.str." + idx.floor().to_string()
        this.string_constants.push(s)
        return name
    }

    fun emit_string_constants() {
        var i: Float = 0
        while (i < this.string_constants.length()) {
            var s: String = this.string_constants[i]
            var name: String = "@.str." + i.floor().to_string()
            var len: Float = s.length() + 1
            this.emit(name + " = private unnamed_addr constant [" + len.to_string() + " x i8] c\"" + this.escape_llvm_string(s) + "\\00\"")
            i = i + 1
        }
    }

    fun escape_llvm_string(s: String): String {
        var result: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "\n") { result.append("\\0A") }
            else if (ch == "\r") { result.append("\\0D") }
            else if (ch == "\t") { result.append("\\09") }
            else if (ch == "\\") { result.append("\\5C") }
            else if (ch == "\"") { result.append("\\22") }
            else { result.append(ch) }
            i = i + 1
        }
        return result.to_string()
    }

    // --- Expression codegen ---
    // Returns the LLVM local name holding the result
    // Sets this.last_type to the Saffron type of the result
    // @codegen-split: types
    fun make_list_type(): AST.Type {
        return AST.Type.GenericType("List", [AST.Type.AnyType])
    }
    fun make_list_str_type(): AST.Type {
        return AST.Type.GenericType("List", [AST.Type.StringType])
    }
    fun make_map_type(): AST.Type {
        return AST.Type.GenericType("Map", [AST.Type.StringType, AST.Type.AnyType])
    }
    fun make_generic_type(base: String, args: List<AST.Type>): AST.Type {
        return AST.Type.GenericType(base, args)
    }

    fun params_to_string(params: List<AST.Param>): String {
        if (!(params is List)) {
            return ""
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < params.length()) {
            if (i > 0) { sb.append(",") }
            var p: AST.Param = params[i]
            var pname: String = match (p) { Param(n, t, d) => n }
            var pt: AST.Type = match (p) { Param(n, t, d) => t }
            var ptype: String = this.type_to_string(pt)
            sb.append(pname)
            sb.append(":")
            sb.append(ptype)
            i = i + 1
        }
        return sb.to_string()
    }

    fun str_to_type(s: String): AST.Type {
        if (!(s is String)) return AST.Type.AnyType
        if (s == "String") return AST.Type.StringType
        if (s == "Int" or s == "Number") return AST.Type.IntType
        if (s == "Float") return AST.Type.FloatType
        if (s == "Bool") return AST.Type.BoolType
        if (s == "Nil") return AST.Type.NilType
        if (s == "Any") return AST.Type.AnyType
        // Union types: check for "|" at top level (not inside <> or ())
        if (s.contains("|")) {
            var union_parts: List<String> = this.split_type_union(s)
            if (union_parts.length() > 1) {
                var types: List<AST.Type> = []
                var ui: Float = 0
                while (ui < union_parts.length()) {
                    types.push(this.str_to_type(union_parts[ui]))
                    ui = ui + 1
                }
                return AST.Type.UnionType(types)
            }
        }
        // Function types: Fun(Int,String):Bool
        if (s.starts_with("Fun(")) {
            return this.parse_func_type_str(s)
        }
        if (s == "List") return this.make_list_type()
        if (s.starts_with("List<") and s.ends_with(">")) {
            var inner: String = s.slice(5, s.length() - 1)
            return this.make_generic_type("List", [this.str_to_type(inner)])
        }
        if (s == "Map") return this.make_map_type()
        if (s.starts_with("Map<") and s.ends_with(">")) {
            var map_inner: String = s.slice(4, s.length() - 1)
            var map_parts: List<String> = this.split_respecting_generics(map_inner, ",")
            if (map_parts.length() >= 2) {
                return this.make_generic_type("Map", [this.str_to_type(map_parts[0]), this.str_to_type(map_parts[1])])
            }
            return this.make_map_type()
        }
        if (s == "StringBuilder") return AST.Type.ClassType("StringBuilder")
        return AST.Type.ClassType(s)
    }

    fun parse_func_type_str(s: String): AST.Type {
        // Format: Fun(param1,param2):RetType
        // Find the closing paren that matches the opening one
        var depth: Float = 0
        var close_paren: Float = -1
        var i: Float = 4  // skip "Fun("
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "(") {
                depth = depth + 1
            } else if (ch == ")") {
                if (depth == 0) {
                    close_paren = i
                    i = s.length()
                } else {
                    depth = depth - 1
                }
            }
            i = i + 1
        }
        if (close_paren < 0) {
            return AST.Type.FuncType([], AST.Type.AnyType)
        }
        var params_str: String = s.slice(4, close_paren)
        var param_types: List<AST.Type> = []
        if (params_str.length() > 0) {
            var param_parts: List<String> = this.split_respecting_generics(params_str, ",")
            var pi: Float = 0
            while (pi < param_parts.length()) {
                param_types.push(this.str_to_type(param_parts[pi]))
                pi = pi + 1
            }
        }
        var ret_type: AST.Type = AST.Type.AnyType
        // After ")" there should be ":RetType"
        if (close_paren + 1 < s.length() and s.char_at(close_paren + 1) == ":") {
            var ret_str: String = s.slice(close_paren + 2, s.length())
            ret_type = this.str_to_type(ret_str)
        }
        return AST.Type.FuncType(param_types, ret_type)
    }

    fun type_to_string(t: AST.Type): String {
        var result: String = match (t) {
            IntType => "Int"
            FloatType => "Float"
            BoolType => "Bool"
            StringType => "String"
            NilType => "Nil"
            AnyType => "Any"
            ClassType(n) => n
            EnumType(n) => n
            GenericType(base, args) => this.generic_type_string(base, args)
            UnionType(types) => this.union_type_string(types)
            FuncType(p, r) => this.func_type_string(p, r)
            NullableType(inner) => this.type_to_string(inner) + "|Nil"
        }
        // In identity mode, Float and Int are both i64 — treat Float as Int
        if (this.identity_mode and result == "Float") { return "Int" }
        return result
    }

    fun union_type_string(types: List<AST.Type>): String {
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < types.length()) {
            if (i > 0) { sb.append("|") }
            sb.append(this.type_to_string(types[i]))
            i = i + 1
        }
        return sb.to_string()
    }

    fun func_type_string(params: List<AST.Type>, ret: AST.Type): String {
        var sb: StringBuilder = StringBuilder()
        sb.append("Fun(")
        var i: Float = 0
        while (i < params.length()) {
            if (i > 0) { sb.append(",") }
            sb.append(this.type_to_string(params[i]))
            i = i + 1
        }
        sb.append("):")
        sb.append(this.type_to_string(ret))
        return sb.to_string()
    }

    fun split_type_union(s: String): List<String> {
        var result: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<" or ch == "(") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">" or ch == ")") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "|" and depth == 0) {
                result.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            result.push(current)
        }
        return result
    }

    fun split_type_args(s: String): List<String> {
        var result: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<" or ch == "(") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">" or ch == ")") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "," and depth == 0) {
                result.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            result.push(current)
        }
        return result
    }

    fun generic_type_string(base: String, args: List<AST.Type>): String {
        if (args.length() > 1) {
            var sb: StringBuilder = StringBuilder()
            sb.append(base)
            sb.append("<")
            var gi: Float = 0
            while (gi < args.length()) {
                if (gi > 0) { sb.append(",") }
                sb.append(this.type_to_string(args[gi]))
                gi = gi + 1
            }
            sb.append(">")
            return sb.to_string()
        }
        if (args.length() > 0) {
            return base + "<" + this.type_to_string(args[0]) + ">"
        }
        return base
    }

    fun get_list_element_type(t: AST.Type): AST.Type {
        return match (t) {
            GenericType(base, args) => {
                if (base == "List" and args.length() > 0) {
                    return args[0]
                }
                return AST.Type.AnyType
            }
            IntType => AST.Type.AnyType
            FloatType => AST.Type.AnyType
            BoolType => AST.Type.AnyType
            StringType => AST.Type.AnyType
            NilType => AST.Type.AnyType
            AnyType => AST.Type.AnyType
            ClassType(n) => AST.Type.AnyType
            EnumType(n) => AST.Type.AnyType
            UnionType(types) => AST.Type.AnyType
            FuncType(p, r) => AST.Type.AnyType
            NullableType(inner) => AST.Type.AnyType
        }
    }

    fun is_string_type(t: AST.Type): Bool {
        return match (t) {
            StringType => true
            IntType => false
            FloatType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_int_type(t: AST.Type): Bool {
        return match (t) {
            IntType => true
            FloatType => true
            StringType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_float_type(t: AST.Type): Bool {
        return match (t) {
            FloatType => true
            IntType => false
            StringType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_bool_type(t: AST.Type): Bool {
        return match (t) {
            BoolType => true
