            this.last_type = slice_saved_type
            return local
        }
        var str_ptr: String = this.emit_untag_ptr(obj)
        var start_tagged: String = this.gen_arg_value(args[0])
        var start: String = this.emit_untag_int(start_tagged)
        var end_tagged: String = this.gen_arg_value(args[1])
        var end: String = this.emit_untag_int(end_tagged)
        var slice_len: String = this.fresh_local()
        this.emit_indent(slice_len + " = sub i64 " + end + ", " + start)
        var buf_size: String = this.fresh_local()
        this.emit_indent(buf_size + " = add i64 " + slice_len + ", 1")
        var buf: String = this.fresh_local()
        this.emit_indent(buf + " = call i8* @malloc(i64 " + buf_size + ")")
        var src: String = this.fresh_local()
        this.emit_indent(src + " = getelementptr i8, i8* " + str_ptr + ", i64 " + start)
        this.emit_indent("call void @llvm.memcpy.p0i8.p0i8.i64(i8* " + buf + ", i8* " + src + ", i64 " + slice_len + ", i1 false)")
        var null_pos: String = this.fresh_local()
        this.emit_indent(null_pos + " = getelementptr i8, i8* " + buf + ", i64 " + slice_len)
        this.emit_indent("store i8 0, i8* " + null_pos)
        var local: String = this.emit_tag_ptr(buf)
        this.last_type = AST.Type.StringType
        return local
