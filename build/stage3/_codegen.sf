    if (!is_user_class and method == "is_upper") {
        var str_ptr: String = this.emit_untag_ptr(obj)
        var ch: String = this.fresh_local()
        this.emit_indent(ch + " = load i8, i8* " + str_ptr)
        var ge_a: String = this.fresh_local()
        this.emit_indent(ge_a + " = icmp uge i8 " + ch + ", 65")
        var le_z: String = this.fresh_local()
        this.emit_indent(le_z + " = icmp ule i8 " + ch + ", 90")
        var both: String = this.fresh_local()
        this.emit_indent(both + " = and i1 " + ge_a + ", " + le_z)
        var local: String = this.fresh_local()
        this.emit_indent(local + " = zext i1 " + both + " to i64")
        this.last_type = AST.Type.BoolType
        return local
    }
    if (!is_user_class and method == "is_lower") {
        var str_ptr: String = this.emit_untag_ptr(obj)
        var ch: String = this.fresh_local()
        this.emit_indent(ch + " = load i8, i8* " + str_ptr)
        var ge_a: String = this.fresh_local()
        this.emit_indent(ge_a + " = icmp uge i8 " + ch + ", 97")
        var le_z: String = this.fresh_local()
        this.emit_indent(le_z + " = icmp ule i8 " + ch + ", 122")
        var both: String = this.fresh_local()
        this.emit_indent(both + " = and i1 " + ge_a + ", " + le_z)
        var local: String = this.fresh_local()
        this.emit_indent(local + " = zext i1 " + both + " to i64")
        this.last_type = AST.Type.BoolType
        return local
    }
    if (!is_user_class and method == "slice" and args.length() > 0) {
        var slice_obj_type: String = this.type_to_string(this.last_type)
        var slice_saved_type: AST.Type = this.last_type
        // Prefer typed_vars for more precise element type
        if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
            slice_saved_type = this.typed_vars.get(obj_name)
            slice_obj_type = this.type_to_string(slice_saved_type)
        }
        if (slice_obj_type == "Any") {
            IO.println("[codegen] Warning: dispatching 'slice' on untyped value (type inference failed)")
        }
        if (slice_obj_type.starts_with("List") or slice_obj_type == "Any") {
            // For Any type, default to list slice (safer than string slice which dereferences a pointer)
            var sl_start: String = this.gen_arg_value(args[0])
            var sl_end: String = this.gen_arg_value(args[1])
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__list_slice(i64 " + obj + ", i64 " + sl_start + ", i64 " + sl_end + ")")
