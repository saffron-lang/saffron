// LLVM IR code generator for Saffron-mini

import "./ast.sf" as AST
import "llvm/types" as LLVMTypes
import "llvm/instructions" as LLVMInst
import "llvm/module" as LLVMMod
import "llvm/function" as LLVMFunc
import "llvm/block" as LLVMBlock
import "llvm/nanbox" as LLVMNanBox

// Runtime function prefix — change this to avoid collisions with user code.
// Currently "__" (e.g., __list_new, __map_get). Could become "__sf_" later.
var RT_PREFIX: String = "__"
var __codegen_errors: Bool = false

class Codegen {
    var sb: StringBuilder
    var label_counter: Float
    var local_counter: Float
    var globals: List<String>
    var string_constants: List<String>
    var block_terminated: Bool
    var enum_defs: Map<String, List<String>>
    var enum_variant_tags: Map<String, Float>
    var enum_variant_fields: Map<String, String>
    var type_defs: StringBuilder
    var known_functions: List<String>
    var func_ret_types: Map<String, AST.Type>
    var class_fields: Map<String, String>
    var class_field_list: Map<String, List<String>>
    var class_struct_names: Map<String, String>
    var class_methods: Map<String, List<String>>
    // The declared generic parameter names of each class: `class Box<T>` → ["T"].
    // Keyed by the bare class name, like every other class table. A method
    // declared `fun getItem(k: Int): T` registers "T" as its return type, which
    // names nothing at the IR level; substituting the receiver's own type
    // arguments — `Box<String>` says `T` is `String` — is what lets the next
    // dispatch on the result pick the right arm (BUGS #95).
    var class_type_params: Map<String, List<String>>
    // Methods declared with an empty body. Only these are requirements on a
    // subclass; a parent method WITH a body is simply inherited.
    var class_abstract_methods: Map<String, List<String>>
    var current_class: String
    var current_parent: String
    var current_function_name: String
    var string_vars: List<String>
    var last_type: AST.Type
    var typed_vars: Map<String, AST.Type>
    var loop_end_label: String
    var loop_break_label: String
    var loop_continue_label: String
    var current_ret_type: String
    var called_functions: List<String>
    var called_function_arity: Map<String, Float>
    var module_prefixes: Map<String, String>
    var func_prefix_map: Map<String, String>
    var func_defaults: Map<String, List<AST.Expr>>
    var func_param_count: Map<String, Float>
    var func_param_names: Map<String, List<String>>
    var current_prefix: String
    var module_globals: Map<String, Bool>
    var global_var_types: Map<String, String>
    var register_only: Bool
    var in_function: Bool
    // Names bound by `var`/`let` in the body of the function currently being
    // emitted. A name in here is a local, no matter that module_globals holds a
    // same-named module global (BUGS #59): the alloca and store sites consult
    // this before falling back to module_globals. Empty at top level / module
    // init, where a `var` really is a global.
    var current_fn_locals: Map<String, Bool>
    // Locals of the function currently being emitted that live in a heap cell
    // instead of an alloca, because a nested lambda both captures and writes to
    // them (BUGS #51 defect B). gen_lambda consults this to decide whether the
    // env slot gets the cell pointer or a snapshot of its contents. Saved and
    // restored around each function body, like current_fn_locals.
    var boxed_locals: Map<String, Bool>
    var intrinsic_funcs: List<String>
    var extern_sigs: Map<String, String>
    // Saffron-level parameter types of each `@extern`, comma-joined, keyed by
    // emit name. `extern_sigs` only carries the *C* signature, which cannot
    // distinguish "an i64 holding a machine integer" from "an i64 holding an
    // opaque NaN-boxed value" — and gen_extern_call must untag the first and
    // pass the second through untouched. Only `Any` params are read from here;
    // see the `Any` branch in gen_extern_call for why (BUGS #38).
    var extern_param_types: Map<String, String>
    var defined_funcs: List<String>
    var builtin_methods: Map<String, String>
    var extend_map: Map<String, String>
    var pending_extend_class: String
    var named_imports: Map<String, String>
    var target: String
    var has_errors: Bool
    var module_init_names: List<String>
    var identity_mode: Bool
    var coroutine_funcs: List<String>
    var inline_funcs: List<String>
    var is_coroutine: Bool
    var use_llvm_lib: Bool
    var emit_llvm_lib: Bool
    var gc_root_count: Float
    var class_type_ids: Map<String, Float>
    var next_class_type_id: Float
    // Parent of each class that has one. gen_class_decl_with_parents is *handed*
    // the parent name and used to discard it after inheriting fields and
    // methods, which made the hierarchy look unavailable to codegen (it is not
    // — only checker.sf recorded it). Writing it down here is what lets
    // __class_is_a answer `d is Animal` for a Dog, which no amount of
    // compile-time folding can (BUGS #61, #50).
    var class_parent_of: Map<String, String>
    // Every declared base of each class, struct-keyed like class_parent_of.
    // class_parent_of above deliberately stays the *primary* base — parents[0] —
    // because that is the one whose field layout the child extends and whose
    // `init` it forwards to; __class_parent_tag still reports exactly it. This
    // map is the full set, and it is what __class_is_a is built from, so
    // `duck is Swimmable` answers true for `class Duck extends Flyable,
    // Swimmable, Walkable` instead of stopping at Flyable.
    var class_parents_of: Map<String, List<String>>
    // Methods a class declares *itself* (real symbols, not inherited forwarders),
    // and the bare (unprefixed) name for each struct name. Both keyed by struct
    // name and populated in the generate() pre-registration pass, before the
    // forwarder logic in gen_class_decl_with_parents pushes inherited names into
    // class_methods — that mixing is why class_methods can't answer "does this
    // class override the method" on its own. gen_virtual_dispatch (BUGS #50)
    // needs exactly that: to switch a call on the receiver's runtime tag it must
    // know which descendants change the method's behaviour.
    var class_own_methods: Map<String, List<String>>
    var class_bare_of: Map<String, String>
    var llvm_module: LLVMMod.Module
    var llvm_func_builder: LLVMFunc.FunctionBuilder
    var llvm_block_builder: LLVMBlock.BlockBuilder
    var llvm_values: Map<String, Any>
    var actor_classes: Map<String, Bool>
    var force_next_lambda_coro: Bool
    var check_spawn_sendable: Bool

    fun init() {
        this.sb = StringBuilder()
        this.label_counter = 0
        this.local_counter = 0
        this.globals = []
        this.string_constants = []
        this.block_terminated = false
        this.enum_defs = {}
        this.enum_variant_tags = {}
        this.enum_variant_fields = {}
        this.type_defs = StringBuilder()
        this.known_functions = []
        this.func_ret_types = {}
        this.class_fields = {}
        this.class_field_list = {}
        this.class_struct_names = {}
        this.class_methods = {}
        this.class_type_params = {}
        this.class_abstract_methods = {}
        this.current_class = ""
        this.current_parent = ""
        this.current_function_name = ""
        this.string_vars = []
        this.last_type = AST.Type.IntType
        this.typed_vars = {}
        this.loop_end_label = ""
        this.loop_break_label = ""
        this.loop_continue_label = ""
        this.current_ret_type = "i64"
        this.called_functions = []
        this.called_function_arity = {}
        this.module_prefixes = {}
        this.func_prefix_map = {}
        this.func_defaults = {}
        this.func_param_count = {}
        this.func_param_names = {}
        this.current_prefix = ""
        this.module_globals = {}
        this.global_var_types = {}
        this.register_only = false
        this.in_function = false
        this.current_fn_locals = {}
        this.boxed_locals = {}
        this.intrinsic_funcs = []
        this.extern_sigs = {}
        this.extern_param_types = {}
        this.defined_funcs = []
        this.builtin_methods = {}
        this.extend_map = {}
        this.pending_extend_class = ""
        this.named_imports = {}
        this.target = "native"
        this.has_errors = false
        this.module_init_names = []
        this.identity_mode = false
        this.coroutine_funcs = []
        this.inline_funcs = []
        this.is_coroutine = false
        this.use_llvm_lib = true
        this.emit_llvm_lib = false
        this.gc_root_count = 0
        this.class_type_ids = {}
        this.next_class_type_id = 10
        this.class_parent_of = {}
        this.class_parents_of = {}
        this.class_own_methods = {}
        this.class_bare_of = {}
        this.actor_classes = {}
        this.force_next_lambda_coro = false
        this.check_spawn_sendable = false
        this.llvm_module = LLVMMod.Module("saffron_program")
        // Workaround: gen2 doesn't emit init calls for cross-module class constructors.
        // Explicitly call init to set up internal lists/fields.
        this.llvm_module.init("saffron_program")
        var dummy_params: List<LLVMFunc.Param> = []
        this.llvm_func_builder = LLVMFunc.FunctionBuilder("__dummy", LLVMTypes.Type.I64, dummy_params)
        this.llvm_func_builder.init("__dummy", LLVMTypes.Type.I64, dummy_params)
        var dummy_bb: LLVMFunc.BasicBlock = LLVMFunc.BasicBlock("entry")
        dummy_bb.init("entry")
        this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, dummy_bb)
        this.llvm_block_builder.init(this.llvm_func_builder, dummy_bb)
        this.llvm_values = {}
        // String methods are dispatched via class_methods (see methods_body.sf)

        // Register built-in type classes in class_methods so method resolution
        // finds them. These mirror the type class definitions in src/lib/*.sf.
        // Methods listed here will be resolved via gen_namespace_call when the
        // receiver's type is known — keeping inline emission for primitives while
        // enabling proper dispatch for user-visible .to_string(), .abs(), etc.
        this.class_methods.set("String", ["length", "char_at", "contains", "starts_with", "ends_with", "index_of", "trim", "to_upper", "to_lower", "slice", "split", "replace", "repeat", "to_string", "to_number"])
        this.class_methods.set("List", ["length", "push", "pop", "get", "set", "remove", "contains", "reverse", "copy", "sort", "slice", "join", "to_string"])
        this.class_methods.set("Map", ["length", "has", "get", "set", "keys", "values", "to_string"])
        this.class_methods.set("Int", ["to_string", "to_float", "abs", "floor", "ceil"])
        this.class_methods.set("Float", ["to_string", "floor", "ceil", "abs"])
        this.class_methods.set("Bool", ["to_string"])

        // HTML element functions (provided by turmeric runtime library)
        this.known_functions.push("div")
        this.known_functions.push("span")
        this.known_functions.push("h1")
        this.known_functions.push("h2")
        this.known_functions.push("h3")
        this.known_functions.push("h4")
        this.known_functions.push("h5")
        this.known_functions.push("h6")
        this.known_functions.push("p")
        this.known_functions.push("button")
        this.known_functions.push("input")
        this.known_functions.push("ul")
        this.known_functions.push("ol")
        this.known_functions.push("li")
        this.known_functions.push("a")
        this.known_functions.push("nav")
        this.known_functions.push("header")
        this.known_functions.push("footer")
        this.known_functions.push("main")
        this.known_functions.push("section")
        this.known_functions.push("form")
        this.known_functions.push("label")
        this.known_functions.push("table")
        this.known_functions.push("tr")
        this.known_functions.push("td")
        this.known_functions.push("th")
        this.known_functions.push("textarea")
        this.known_functions.push("select")
        this.known_functions.push("option")
        this.known_functions.push("pre")
        this.known_functions.push("code")
        this.known_functions.push("br")
        this.known_functions.push("hr")
        this.known_functions.push("img")
        this.known_functions.push("text")
    }

    // Split a string by delimiter, respecting nested <>, () and [] brackets.
    //
    // All three pairs nest, and all three appear in the type strings this splits.
    // Angle brackets were the only pair tracked, which was enough only while no
    // populated function type could reach a parameter list: `type_to_string`
    // renders a FuncType via `func_type_string` as "Fun(A,B):R" — with a PLAIN
    // comma between the parameter types — and `params_to_string` joins parameters
    // with a plain comma too. So `gen_function` splitting "b:Box,f:Fun(Box,Int):String"
    // on top-level commas cut the function type in half and manufactured a fourth
    // "parameter" named "Int)", which `sanitize_name` turned into %Int_ (BUGS #114).
    //
    // That was a silent wrong answer, not a crash: the phantom parameter lands
    // between the real ones, so every later argument is read from the wrong slot.
    // `src/lib/iter.sf`'s `reduce(iterable, func: (R, T) => R, initial)` returned
    // 12 instead of 10 for a sum over [1,2,3,4] because `initial` shifted.
    //
    // `[]` is tracked for the receiver spelling "Fun[Recv](A,B):R", which nests the
    // same way. This mirrors parser.sf's `split_type_args`, with one deliberate
    // difference: a closer only decrements a depth that is actually positive. An
    // unbalanced closer would otherwise drive depth negative, and since the split
    // is gated on `depth == 0`, a single stray ")" would silently disable ALL
    // splitting for the rest of the string — a worse failure than the one being
    // fixed. Clamping degrades to the old paren-blind behaviour instead.
    fun split_respecting_generics(s: String, delim: String): List<String> {
        var result: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<" or ch == "(" or ch == "[") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">" or ch == ")" or ch == "]") {
                if (depth > 0) { depth = depth - 1 }
                current = current + ch
            } else if (ch == delim and depth == 0) {
                result.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            result.push(current)
        }
        return result
    }

    fun sanitize_name(name: String): String {
        // Prefix reserved LLVM names to avoid collisions with labels
        if (name == "entry" or name == "end" or name == "loop" or name == "body") {
            return "v_" + name
        }
        // ...and with fresh_local()'s temporaries, which are `%t<counter>`. A
        // user variable named `t1` emitted `%t1` alongside codegen's own `%t1`
        // and the module failed to assemble with "multiple definition of local
        // value named 't1'" — no source location, no hint that the *name* was
        // the problem. `t1`/`t2` are ordinary names for tasks or temporaries, so
        // this was easy to hit; it is what blocked the #38 async repro.
        //
        // Renaming here rather than changing fresh_local()'s prefix keeps it to
        // one edit: sanitize_name is the single funnel every local name goes
        // through, whereas `%t` is baked into thousands of lines of expected IR.
        if (this.is_temp_local_name(name)) {
            return "v_" + name
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < name.length()) {
            var ch: String = name.char_at(i)
            if (ch == "." or ch == "(" or ch == ")") {
                sb.append("_")
            } else {
                sb.append(ch)
            }
            i = i + 1
        }
        return sb.to_string()
    }

    /// True for exactly the names fresh_local() can produce: `t` followed by one
    /// or more digits. `t`, `t1x` and `tone` are left alone — only the shapes
    /// that can actually collide are renamed, so ordinary names keep the
    /// spelling that appears in diagnostics and IR.
    fun is_temp_local_name(name: String): Bool {
        if (name.length() < 2) { return false }
        if (name.char_at(0) != "t") { return false }
        var i: Float = 1
        while (i < name.length()) {
            // Same digit test the lexer uses (lexer.sf:128), rather than a `<`
            // comparison on Strings.
            if (!"0123456789".contains(name.char_at(i))) { return false }
            i = i + 1
        }
        return true
    }

    fun fresh_label(prefix: String): String {
        this.label_counter = this.label_counter + 1
        return prefix + this.label_counter.floor().to_string()
    }

    fun fresh_local(): String {
        this.local_counter = this.local_counter + 1
        return "%t" + this.local_counter.floor().to_string()
    }

    fun reset_locals() {
        this.local_counter = 0
    }

    fun set_last_type(t: AST.Type) {
        this.last_type = t
    }

    fun set_current_class(c: String) {
        this.current_class = c
    }

    fun set_current_prefix(p: String) {
        this.current_prefix = p
    }

    fun emit(line: String) {
        this.sb.append(line)
        this.sb.append("\n")
    }

    fun emit_indent(line: String) {
        if (this.block_terminated) return nil
        this.sb.append("  ")
        this.sb.append(line)
        this.sb.append("\n")
    }

    fun emit_terminator(line: String) {
        if (this.block_terminated) return nil
        this.sb.append("  ")
        this.sb.append(line)
        this.sb.append("\n")
        this.block_terminated = true
    }

    // --- Pointer ↔ value helpers (wasm32-aware) ---
    // On wasm32, pointers are i32 but value slots are i64.
    // These helpers insert the necessary i32↔i64 conversions.

    fun ptr_to_val(ptr_reg: String): String {
        // Convert an i8* pointer register to an i64 value
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = ptrtoint i8* " + ptr_reg + " to i32")
            var i64_reg: String = this.fresh_local()
            this.emit_indent(i64_reg + " = zext i32 " + i32_reg + " to i64")
            return i64_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = ptrtoint i8* " + ptr_reg + " to i64")
        return reg
    }

    fun val_to_ptr(val_reg: String): String {
        // Convert an i64 value to an i8* pointer register
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = trunc i64 " + val_reg + " to i32")
            var ptr_reg: String = this.fresh_local()
            this.emit_indent(ptr_reg + " = inttoptr i32 " + i32_reg + " to i8*")
            return ptr_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = inttoptr i64 " + val_reg + " to i8*")
        return reg
    }

    fun typed_ptr_to_val(ptr_reg: String, ptr_type: String): String {
        // Convert a typed pointer (e.g. [2 x i64]*) to an i64 value
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = ptrtoint " + ptr_type + " " + ptr_reg + " to i32")
            var i64_reg: String = this.fresh_local()
            this.emit_indent(i64_reg + " = zext i32 " + i32_reg + " to i64")
            return i64_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = ptrtoint " + ptr_type + " " + ptr_reg + " to i64")
        return reg
    }

    fun val_to_typed_ptr(val_reg: String, ptr_type: String): String {
        // Convert an i64 value to a typed pointer (e.g. [2 x i64]*)
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = trunc i64 " + val_reg + " to i32")
            var ptr_reg: String = this.fresh_local()
            this.emit_indent(ptr_reg + " = inttoptr i32 " + i32_reg + " to " + ptr_type)
            return ptr_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = inttoptr i64 " + val_reg + " to " + ptr_type)
        return reg
    }

    fun fn_ptr_to_val(fn_type_str: String, fn_name: String): String {
        // Convert a function pointer (@name with type) to an i64 value
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = ptrtoint " + fn_type_str + " " + fn_name + " to i32")
            var i64_reg: String = this.fresh_local()
            this.emit_indent(i64_reg + " = zext i32 " + i32_reg + " to i64")
            return i64_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = ptrtoint " + fn_type_str + " " + fn_name + " to i64")
        return reg
    }

    fun val_to_fn_ptr(val_reg: String, fn_type: String): String {
        // Convert an i64 value to a function pointer
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = trunc i64 " + val_reg + " to i32")
            var ptr_reg: String = this.fresh_local()
            this.emit_indent(ptr_reg + " = inttoptr i32 " + i32_reg + " to " + fn_type)
            return ptr_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = inttoptr i64 " + val_reg + " to " + fn_type)
        return reg
    }

    fun malloc_size_arg(size_reg: String): String {
        // malloc always takes i64 (runtime truncates internally for wasm32)
        return size_reg
    }

    fun malloc_size_type(): String {
        return "i64"
    }

    fun start_block(label: String) {
        this.emit(label + ":")
        this.block_terminated = false
    }

    // --- Type mapping ---

    fun llvm_type(t: String): String {
        if (t == "Int") return "i64"
        if (t == "Float") return "i64"
        if (t == "Bool") return "i64"
        if (t == "String") return "i64"
        if (t == "Nil") return "i64"
        if (t == "Any") return "i64"
        if (t == "List") return "i64"
        if (t == "Map") return "i64"
        return "i64"
    }

    // --- String constants ---

    fun add_string_constant(s: String): String {
        var idx: Float = this.string_constants.length()
        var name: String = "@.str." + idx.floor().to_string()
        this.string_constants.push(s)
        return name
    }

    fun emit_string_constants() {
        var i: Float = 0
        while (i < this.string_constants.length()) {
            var s: String = this.string_constants[i]
            var name: String = "@.str." + i.floor().to_string()
            var len: Float = s.length() + 1
            this.emit(name + " = private unnamed_addr constant [" + len.to_string() + " x i8] c\"" + this.escape_llvm_string(s) + "\\00\"")
            i = i + 1
        }
    }

    fun escape_llvm_string(s: String): String {
        var result: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "\n") { result.append("\\0A") }
            else if (ch == "\r") { result.append("\\0D") }
            else if (ch == "\t") { result.append("\\09") }
            else if (ch == "\\") { result.append("\\5C") }
            else if (ch == "\"") { result.append("\\22") }
            else { result.append(ch) }
            i = i + 1
        }
        return result.to_string()
    }

    // --- Expression codegen ---
    // Returns the LLVM local name holding the result
    // Sets this.last_type to the Saffron type of the result
    // @codegen-split: types
    fun make_list_type(): AST.Type {
        return AST.Type.GenericType("List", [AST.Type.AnyType])
    }
    fun make_list_str_type(): AST.Type {
        return AST.Type.GenericType("List", [AST.Type.StringType])
    }
    fun make_map_type(): AST.Type {
        return AST.Type.GenericType("Map", [AST.Type.StringType, AST.Type.AnyType])
    }
    fun make_generic_type(base: String, args: List<AST.Type>): AST.Type {
        return AST.Type.GenericType(base, args)
    }

    fun params_to_string(params: List<AST.Param>): String {
        if (!(params is List)) {
            return ""
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < params.length()) {
            if (i > 0) { sb.append(",") }
            var p: AST.Param = params[i]
            var pname: String = match (p) { Param(n, t, d, p_vis) => n }
            var pt: AST.Type = match (p) { Param(n, t, d, p_vis) => t }
            var ptype: String = this.type_to_string(pt)
            sb.append(pname)
            sb.append(":")
            sb.append(ptype)
            i = i + 1
        }
        return sb.to_string()
    }

    /// The Saffron type names of `params`, comma-joined and positional
    /// ("Int,Any,Float"). Unlike `params_to_string` this drops the names, so it
    /// can be indexed straight against an extern's C parameter list.
    fun param_types_csv(params: List<AST.Param>): String {
        if (!(params is List)) {
            return ""
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < params.length()) {
            if (i > 0) { sb.append(",") }
            var p: AST.Param = params[i]
            var pt: AST.Type = match (p) { Param(n, t, d, p_vis) => t }
            sb.append(this.type_to_string(pt))
            i = i + 1
        }
        return sb.to_string()
    }

    fun str_to_type(s: String): AST.Type {
        if (!(s is String)) return AST.Type.AnyType
        if (s == "String") return AST.Type.StringType
        // `Number` is deprecated: it is one surface name for two representations,
        // so no mapping of it can be right. `fun area(): Number` returning 12.0 is
        // relabelled Int and the caller's `.to_string()` untags a double as an
        // integer and prints 0; mapping it to Float instead breaks every `Number`
        // used as a list index. Int is kept because it is the integer-ish reading
        // that user code overwhelmingly means, and because src/lib no longer writes
        // `Number` at all — the remaining users are user programs and test/.
        // Retire the spelling rather than re-tune this line. See BUGS.md #49 and
        // M2 in docs/design/compiler-rewrite.md ("Int is the bottom type").
        if (s == "Int" or s == "Number") return AST.Type.IntType
        if (s == "Float") return AST.Type.FloatType
        if (s == "Bool") return AST.Type.BoolType
        if (s == "Nil") return AST.Type.NilType
        if (s == "Any") return AST.Type.AnyType
        // Union types: check for "|" at top level (not inside <> or ())
        if (s.contains("|")) {
            var union_parts: List<String> = this.split_type_union(s)
            if (union_parts.length() > 1) {
                var types: List<AST.Type> = []
                var ui: Float = 0
                while (ui < union_parts.length()) {
                    types.push(this.str_to_type(union_parts[ui]))
                    ui = ui + 1
                }
                return AST.Type.UnionType(types)
            }
        }
        // Function types: Fun(Int,String):Bool
        if (s.starts_with("Fun(")) {
            return this.parse_func_type_str(s)
        }
        if (s == "List") return this.make_list_type()
        if (s.starts_with("List<") and s.ends_with(">")) {
            var inner: String = s.slice(5, s.length() - 1)
            return this.make_generic_type("List", [this.str_to_type(inner)])
        }
        if (s == "Map") return this.make_map_type()
        if (s.starts_with("Map<") and s.ends_with(">")) {
            var map_inner: String = s.slice(4, s.length() - 1)
            var map_parts: List<String> = this.split_respecting_generics(map_inner, ",")
            if (map_parts.length() >= 2) {
                return this.make_generic_type("Map", [this.str_to_type(map_parts[0]), this.str_to_type(map_parts[1])])
            }
            return this.make_map_type()
        }
        if (s == "StringBuilder") return AST.Type.ClassType("StringBuilder")
        return AST.Type.ClassType(s)
    }

    fun parse_func_type_str(s: String): AST.Type {
        // Format: Fun(param1,param2):RetType
        // Find the closing paren that matches the opening one
        var depth: Float = 0
        var close_paren: Float = -1
        var i: Float = 4  // skip "Fun("
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "(") {
                depth = depth + 1
            } else if (ch == ")") {
                if (depth == 0) {
                    close_paren = i
                    i = s.length()
                } else {
                    depth = depth - 1
                }
            }
            i = i + 1
        }
        if (close_paren < 0) {
            return AST.Type.FuncType([], AST.Type.AnyType)
        }
        var params_str: String = s.slice(4, close_paren)
        var param_types: List<AST.Type> = []
        if (params_str.length() > 0) {
            var param_parts: List<String> = this.split_respecting_generics(params_str, ",")
            var pi: Float = 0
            while (pi < param_parts.length()) {
                param_types.push(this.str_to_type(param_parts[pi]))
                pi = pi + 1
            }
        }
        var ret_type: AST.Type = AST.Type.AnyType
        // After ")" there should be ":RetType"
        if (close_paren + 1 < s.length() and s.char_at(close_paren + 1) == ":") {
            var ret_str: String = s.slice(close_paren + 2, s.length())
            ret_type = this.str_to_type(ret_str)
        }
        return AST.Type.FuncType(param_types, ret_type)
    }

    fun type_to_string(t: AST.Type): String {
        var result: String = match (t) {
            IntType => "Int"
            FloatType => "Float"
            BoolType => "Bool"
            StringType => "String"
            NilType => "Nil"
            AnyType => "Any"
            ClassType(n) => n
            EnumType(n) => n
            GenericType(base, args) => this.generic_type_string(base, args)
            UnionType(types) => this.union_type_string(types)
            FuncType(p, r) => this.func_type_string(p, r)
            NullableType(inner) => this.type_to_string(inner) + "|Nil"
        }
        // In identity mode, Float and Int are both i64 — treat Float as Int
        if (this.identity_mode and result == "Float") { return "Int" }
        return result
    }

    fun union_type_string(types: List<AST.Type>): String {
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < types.length()) {
            if (i > 0) { sb.append("|") }
            sb.append(this.type_to_string(types[i]))
            i = i + 1
        }
        return sb.to_string()
    }

    fun func_type_string(params: List<AST.Type>, ret: AST.Type): String {
        var sb: StringBuilder = StringBuilder()
        sb.append("Fun(")
        var i: Float = 0
        while (i < params.length()) {
            if (i > 0) { sb.append(",") }
            sb.append(this.type_to_string(params[i]))
            i = i + 1
        }
        sb.append("):")
        sb.append(this.type_to_string(ret))
        return sb.to_string()
    }

    fun split_type_union(s: String): List<String> {
        var result: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<" or ch == "(") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">" or ch == ")") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "|" and depth == 0) {
                result.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            result.push(current)
        }
        return result
    }

    fun split_type_args(s: String): List<String> {
        var result: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<" or ch == "(") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">" or ch == ")") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "," and depth == 0) {
                result.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            result.push(current)
        }
        return result
    }

    fun generic_type_string(base: String, args: List<AST.Type>): String {
        if (args.length() > 1) {
            var sb: StringBuilder = StringBuilder()
            sb.append(base)
            sb.append("<")
            var gi: Float = 0
            while (gi < args.length()) {
                if (gi > 0) { sb.append(",") }
                sb.append(this.type_to_string(args[gi]))
                gi = gi + 1
            }
            sb.append(">")
            return sb.to_string()
        }
        if (args.length() > 0) {
            return base + "<" + this.type_to_string(args[0]) + ">"
        }
        return base
    }

    fun get_list_element_type(t: AST.Type): AST.Type {
        return match (t) {
            GenericType(base, args) => {
                if (base == "List" and args.length() > 0) {
                    return args[0]
                }
                return AST.Type.AnyType
            }
            IntType => AST.Type.AnyType
            FloatType => AST.Type.AnyType
            BoolType => AST.Type.AnyType
            StringType => AST.Type.AnyType
            NilType => AST.Type.AnyType
            AnyType => AST.Type.AnyType
            ClassType(n) => AST.Type.AnyType
            EnumType(n) => AST.Type.AnyType
            UnionType(types) => AST.Type.AnyType
            FuncType(p, r) => AST.Type.AnyType
            NullableType(inner) => AST.Type.AnyType
        }
    }

    fun is_string_type(t: AST.Type): Bool {
        return match (t) {
            StringType => true
            IntType => false
            FloatType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_int_type(t: AST.Type): Bool {
        return match (t) {
            IntType => true
            FloatType => true
            StringType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_float_type(t: AST.Type): Bool {
        return match (t) {
            FloatType => true
            IntType => false
            StringType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_bool_type(t: AST.Type): Bool {
        return match (t) {
            BoolType => true
            IntType => false
            FloatType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_nil_type(t: AST.Type): Bool {
        return match (t) {
            NilType => true
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_list_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => base == "List"
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_string_list_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => {
                if (base != "List") return false
                if (args.length() == 0) return false
                return this.is_string_type(args[0])
            }
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_map_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => base == "Map"
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    // True when the type admits more than one runtime representation, so no
    // compile-time answer about a value's actual type is available. Every
    // is_*_type predicate answers `false` for these, which makes a whitelist
    // of "is it Any?" silently wrong: both arms of `x is Int` / `x is Nil` on
    // an `Int|Nil` compiled to a literal false. See BUGS #69.
    fun is_undecidable_type(t: AST.Type): Bool {
        return match (t) {
            AnyType => true
            UnionType(types) => true
            NullableType(inner) => true
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            FuncType(p, r) => false
        }
    }

    fun is_class_type(t: AST.Type, name: String): Bool {
        return match (t) {
            ClassType(n) => n == name
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    // Extract the value type string from a Map<K, V> type annotation.
    // e.g. "Map<String,AST.Type>" → "AST.Type"
    //      "Map<String,String>"   → "String"
    //      "Map" or unknown       → "Any"
    fun get_map_value_type(map_type: String): String {
        if (!map_type.starts_with("Map<")) return "Any"
        // Strip "Map<" prefix and trailing ">"
        var inner: String = map_type.slice(4, map_type.length() - 1)
        // Split on first comma respecting nested generics
        var parts: List<String> = this.split_respecting_generics(inner, ",")
        if (parts.length() < 2) return "Any"
        return parts[1]
    }

    // The type an iteration over `coll` yields per step — the static counterpart
    // of what __any_iter_get computes at runtime (BUGS #62).
    //
    // A List<T> yields T, a String yields String (one character), and a Map<K,V>
    // yields List<Any> because the runtime hands back a two-element [key, value]
    // pair whose two slots have different types. `List<K|V>` would be more
    // precise but `is` is broken on union types (BUGS #69), so it would type
    // check and then silently take the wrong branch — Any is the honest answer
    // until that is fixed.
    //
    // Any receiver whose type is unknown, generic, or not iterable yields Any.
    // That is not a diagnostic here: `for-in` over a non-iterable is a checker
    // concern, and reporting it from a type helper would fire on every
    // Any-typed receiver that works fine at runtime.
    fun iter_element_type(coll: AST.Expr): AST.Type {
        var name: String = this.get_variable_name(coll)
        var ts: String = ""
        if (name.length() > 0) {
            ts = this.get_var_type_str(name)
        }
        if (ts.length() == 0) { return AST.Type.AnyType }
        if (ts == "String") { return AST.Type.StringType }
        if (ts.starts_with("Map")) {
            return this.make_generic_type("List", [AST.Type.AnyType])
        }
        if (ts.starts_with("List<")) {
            var inner: String = ts.slice(5, ts.length() - 1)
            var parts: List<String> = this.split_respecting_generics(inner, ",")
            if (parts.length() < 1) { return AST.Type.AnyType }
            return this.str_to_type(parts[0])
        }
        return AST.Type.AnyType
    }

    // Extract the key type string from a Map<K, V> type annotation.
    // e.g. "Map<String,AST.Type>" → "String"
    //      "Map<Int,String>"      → "Int"
    //      "Map" or unknown       → "Any"
    fun get_map_key_type(map_type: String): String {
        if (!map_type.starts_with("Map<")) return "Any"
        var inner: String = map_type.slice(4, map_type.length() - 1)
        var parts: List<String> = this.split_respecting_generics(inner, ",")
        if (parts.length() < 1) return "Any"
        return parts[0]
    }

    // Fold one map-literal entry's key/value types into the receiver's Map type.
    //
    // Called once per desugared .set() of a map literal. Each call merges the
    // new entry against what the earlier entries established: agreement keeps
    // the precise type, disagreement widens that side to Any. A side already
    // widened to Any stays there.
    //
    // Restricted to the parser's map-literal temporary. That is exactly the
    // scope of the bug, and it means an explicit `var m: Map<String, Any> = ...`
    // is never touched: a user-named variable keeps the type its annotation
    // gave it, rather than being silently narrowed by its own initializer.
    fun refine_map_entry_type(name: String, key_type: String, val_type: String) {
        if (!name.starts_with("__map")) { return }
        var current: String = this.get_var_type_str(name)
        if (current.length() == 0) { return }
        if (!(current == "Map" or current.starts_with("Map<"))) { return }
        var known_k: String = this.get_map_key_type(current)
        var known_v: String = this.get_map_value_type(current)
        // Seed from nothing on the first entry. A bare "Map" annotation resolves
        // through str_to_type to Map<String, Any>, so treating that String as an
        // observation would make {1: "x"} merge Int against String and widen the
        // key back to Any — learning nothing. The literal's own entries are the
        // only evidence here, so start both sides unknown.
        if (current == "Map") {
            known_k = "Any"
            known_v = "Any"
        }
        var next_k: String = this.merge_entry_type(known_k, key_type)
        var next_v: String = this.merge_entry_type(known_v, val_type)
        this.typed_vars.set(name, this.make_generic_type("Map", [this.str_to_type(next_k), this.str_to_type(next_v)]))
    }

    // Merge one entry's observed type into the accumulated type for that side.
    // "Any" on either side is the unknown/widened state, so it absorbs.
    fun merge_entry_type(known: String, observed: String): String {
        if (observed.length() == 0 or observed == "Any" or observed == "Nil") { return "Any" }
        if (known == "Any") { return observed }
        if (known == observed) { return known }
        return "Any"
    }

    // Get the type string for a variable from typed_vars (the single source of truth).
    // Returns "" if the variable is not registered.
    fun get_var_type_str(name: String): String {
        var result: String = ""
        if (this.typed_vars.has(name)) {
            result = this.type_to_string(this.typed_vars.get(name))
        } else if (this.global_var_types.has(name)) {
            result = this.global_var_types.get(name)
        } else if (this.current_prefix.length() > 0 and this.global_var_types.has(this.current_prefix + name)) {
            result = this.global_var_types.get(this.current_prefix + name)
        }
        // In identity mode, Float and Int are both i64 — treat Float as Int
        if (this.identity_mode and result == "Float") { return "Int" }
        return result
    }

    /// The bare name of a possibly-generic type: "Box<String>" → "Box",
    /// "Map<String,List<Int>>" → "Map", "Dict" → "Dict".
    ///
    /// `class_fields`, `class_methods` and the `ClassName__method` symbol names
    /// are all keyed by the bare name, but a variable's declared type carries its
    /// arguments. Testing `class_fields.has("Box<String>")` is therefore always
    /// false, which silently skipped dispatch for every generic receiver
    /// (BUGS #94 second half).
    fun generic_base_name(typ: String): String {
        if (!typ.contains("<")) { return typ }
        return typ.slice(0, typ.index_of("<"))
    }

    /// `typ` with the receiver's class type arguments substituted in:
    ///
    ///     substitute_class_type_params("T", "Box<String>")         → "String"
    ///     substitute_class_type_params("List<V>", "Pair<Int,Str>")  → "List<Str>"
    ///     substitute_class_type_params("Int", "Box<String>")        → "Int"
    ///
    /// A method declared `fun getItem(k: Int): T` registers "T" as its return
    /// type, and "T" names no runtime representation — dispatch on the result
    /// matches no arm. The receiver's declared type is the authority: the source
    /// wrote `Box<String>`, so `T` is `String`, and nothing has to be inferred
    /// from the argument list. A parameter the annotation leaves unbound (a bare
    /// `Box`, or fewer arguments than parameters) comes back unchanged rather
    /// than as Any, so the caller can tell the difference between "resolved" and
    /// "the source did not say" (BUGS #95).
    fun substitute_class_type_params(typ: String, recv_type: String): String {
        if (typ.length() == 0) { return typ }
        if (!recv_type.contains("<")) { return typ }
        var base_name: String = this.generic_base_name(recv_type)
        if (!this.class_type_params.has(base_name)) { return typ }
        var params: List<String> = this.class_type_params.get(base_name)
        if (params.length() == 0) { return typ }
        var recv_args: List<String> = this.split_type_args(this.strip_generic_brackets(recv_type))
        // Whole-type match: `fun unwrap(): T`.
        var pi: Float = 0
        while (pi < params.length()) {
            if (params[pi] == typ) {
                if (pi < recv_args.length()) {
                    var arg: String = recv_args[pi]
                    if (arg.length() > 0) { return arg }
                }
                return typ
            }
            pi = pi + 1
        }
        // Otherwise recurse into the arguments: `fun items(): List<T>`.
        if (typ.contains("<")) {
            var lt: Float = typ.index_of("<")
            var tbase: String = typ.slice(0, lt)
            var parts: List<String> = this.split_type_args(this.strip_generic_brackets(typ))
            var out: List<String> = []
            var i: Float = 0
            while (i < parts.length()) {
                out.push(this.substitute_class_type_params(parts[i], recv_type))
                i = i + 1
            }
            return tbase + "<" + out.join(",") + ">"
        }
        return typ
    }

    /// The inside of the outermost `<...>`: "Map<String,Int>" → "String,Int".
    /// A type with no arguments yields "".
    fun strip_generic_brackets(typ: String): String {
        if (!typ.contains("<")) { return "" }
        var lt: Float = typ.index_of("<")
        if (typ.length() - 1 <= lt + 1) { return "" }
        return typ.slice(lt + 1, typ.length() - 1)
    }

    /// `typ` with a `Nil` member dropped from a union: "String|Nil" → "String".
    /// A non-union, or a union with no Nil member, comes back unchanged.
    ///
    /// This exists for *method dispatch*, which needs the type a receiver has
    /// once it is known non-nil. The checker already narrows `String|Nil` to
    /// `String` inside a `!= nil` guard and rejects every unguarded call
    /// ("cannot call .length() on nullable 'r'; add a nil check first"), but
    /// that narrowing lives in the checker's own env and never reaches
    /// `typed_vars` — so codegen still sees "String|Nil". The dispatch arms
    /// match on exact names ("String", "List<...>", "Map<...>"), so the union
    /// spelling matched nothing and fell through to the catch-all `else`, which
    /// assumes List. `__list_length` does `inttoptr` on the value as given: a
    /// List is stored untagged, a String is NaN-tagged, so it dereferenced
    /// 0x7FF8... and segfaulted. Other arms (to_upper, trim, ...) missed their
    /// String test the same way and silently emitted nothing at all.
    ///
    /// Because the checker guarantees non-nil at every call site, dropping Nil
    /// here cannot mask a real nil access — it only tells dispatch what the
    /// checker already proved (BUGS #93).
    fun strip_nil_type_str(typ: String): String {
        if (typ == "Nil") { return typ }
        if (!typ.contains("|")) { return typ }
        var parts: List<String> = typ.split("|")
        var kept: List<String> = []
        var i: Float = 0
        while (i < parts.length()) {
            if (parts[i] != "Nil") { kept.push(parts[i]) }
            i = i + 1
        }
        // Only a single surviving member is a usable dispatch target. A genuine
        // multi-member union ("Int|String") stays as it was: it has no single
        // right arm, and picking one would be the same guess that caused #93.
        if (kept.length() == 1) { return kept[0] }
        return typ
    }

    /// The receiver type for builtin method dispatch: the variable's annotation
    /// when it has one, else the type codegen just inferred, with a nullable
    /// wrapper stripped. Ten dispatch arms in `methods_body.sf` open with this
    /// exact three-step preamble; centralising it means a fix lands in all of
    /// them at once rather than in whichever one is being read (BUGS #93).
    fun dispatch_recv_type(obj_name: String, fallback: AST.Type): String {
        var t: String = this.type_to_string(fallback)
        if (obj_name.length() > 0) {
            var annotated: String = this.get_var_type_str(obj_name)
            if (annotated.length() > 0) { t = annotated }
        }
        return this.strip_nil_type_str(t)
    }

    // Resolve a type string to the class name registered in class_fields.
    // Handles module-prefixed types like "Mod.Thing" by stripping the prefix
    // when class_fields only has "Thing".
    fun resolve_class_type(vtype: String): String {
        // Try module-prefixed version first to get correct struct type
        if (this.current_prefix.length() > 0) {
            var prefixed: String = this.current_prefix + vtype
            if (this.class_fields.has(prefixed)) {
                return prefixed
            }
        }
        if (this.class_fields.has(vtype)) {
            // Return the actual struct type name (may be prefixed)
            if (this.class_struct_names.has(vtype)) {
                return this.class_struct_names.get(vtype)
            }
            return vtype
        }
        // Strip module prefix: "Mod.Thing" -> "Thing"
        if (vtype.contains(".")) {
            var dot_idx: Float = vtype.index_of(".")
            var bare: String = vtype.slice(dot_idx + 1, vtype.length())
            // Try current module prefix on the bare name
            if (this.current_prefix.length() > 0) {
                var prefixed_bare: String = this.current_prefix + bare
                if (this.class_fields.has(prefixed_bare)) {
                    return prefixed_bare
                }
            }
            if (this.class_fields.has(bare)) {
                if (this.class_struct_names.has(bare)) {
                    return this.class_struct_names.get(bare)
                }
                return bare
            }
        }
        // Strip generic params then try: "Mod.Thing<X>" -> "Thing"
        if (vtype.contains("<")) {
            var base: String = vtype.slice(0, vtype.index_of("<"))
            if (this.current_prefix.length() > 0) {
                var prefixed_base: String = this.current_prefix + base
                if (this.class_fields.has(prefixed_base)) {
                    return prefixed_base
                }
            }
            if (this.class_fields.has(base)) {
                if (this.class_struct_names.has(base)) {
                    return this.class_struct_names.get(base)
                }
                return base
            }
            if (base.contains(".")) {
                var dot_idx2: Float = base.index_of(".")
                var bare2: String = base.slice(dot_idx2 + 1, base.length())
                if (this.current_prefix.length() > 0) {
                    var prefixed_bare2: String = this.current_prefix + bare2
                    if (this.class_fields.has(prefixed_bare2)) {
                        return prefixed_bare2
                    }
                }
                if (this.class_fields.has(bare2)) {
                    if (this.class_struct_names.has(bare2)) {
                        return this.class_struct_names.get(bare2)
                    }
                    return bare2
                }
            }
        }
        return ""
    }

    // --- Identity-mode tag/untag helpers ---
    // In identity mode, these are no-ops (values are raw i64).
    // In normal mode, they emit __val_tag/untag calls for NaN-boxing.

    fun emit_tag_int(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_int(i64 " + val + ")")
        return local
    }

    fun emit_untag_int(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_untag_int(i64 " + val + ")")
        return local
    }

    fun emit_tag_ptr(ptr: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = ptrtoint i8* " + ptr + " to i64")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_ptr(i8* " + ptr + ")")
        return local
    }

    fun emit_untag_ptr(val: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = inttoptr i64 " + val + " to i8*")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i8* @__val_untag_ptr(i64 " + val + ")")
        return local
    }

    // Tag a void* extern return, but map NULL to int-tagged 0 so a `== 0` guard
    // fires (BUGS #84). In identity mode ptrtoint already turns NULL into 0, so
    // plain emit_tag_ptr is correct there and the _nullable runtime symbol is
    // never referenced during the (identity-mode) bootstrap.
    fun emit_tag_ptr_nullable(ptr: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = ptrtoint i8* " + ptr + " to i64")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_ptr_nullable(i8* " + ptr + ")")
        return local
    }

    fun emit_tag_bool(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_bool(i64 " + val + ")")
        return local
    }

    fun emit_untag_bool(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_untag_bool(i64 " + val + ")")
        return local
    }

    fun emit_tag_float(val: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = bitcast double " + val + " to i64")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_float(double " + val + ")")
        return local
    }

    fun emit_untag_float(val: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = bitcast i64 " + val + " to double")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call double @__val_untag_float(i64 " + val + ")")
        return local
    }

    // Untag a value used as an integer index, given its static type. A
    // Float-tagged value must be *converted* (untag to double, fptosi), not
    // untagged as an int — emit_untag_int reinterprets the double's bit pattern,
    // which for small values lands on index 0 with no warning (BUGS #52). The
    // caller passes the type it saw in this.last_type right after evaluating the
    // index. Non-Float types keep the plain int untag.
    fun emit_untag_index(val: String, idx_type: AST.Type): String {
        if (this.type_to_string(idx_type) == "Float") {
            var as_double: String = this.emit_untag_float(val)
            var as_int: String = this.fresh_local()
            this.emit_indent(as_int + " = fptosi double " + as_double + " to i64")
            return as_int
        }
        return this.emit_untag_int(val)
    }

    // @codegen-split: expr
    fun gen_expr(expr: AST.Expr): String {
        return match (expr) {
            IntLit(v) => {
                this.last_type = AST.Type.IntType
                var raw: String = this.fresh_local()
                this.emit_indent(raw + " = add i64 0, " + v.floor().to_string())
                // LLVM lib parallel path — builds IntLit in the LLVM Module alongside string emission
                if (this.use_llvm_lib and !this.identity_mode) {
                    var llvm_zero: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(0, 64))
                    var llvm_val: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(v.floor(), 64))
                    var llvm_result: LLVMTypes.Value = this.llvm_block_builder.add(llvm_zero, llvm_val)
                    this.llvm_values.set(raw, llvm_result)
                }
                var local: String = this.emit_tag_int(raw)
                local
            }
            FloatLit(v) => {
                this.last_type = AST.Type.FloatType
                // v is the float literal text (e.g. "3.14").
                var local: String = this.emit_tag_float(v)
                local
            }
            BoolLit(v) => {
                this.last_type = AST.Type.BoolType
                var raw: String = this.fresh_local()
                var val_str: String = "0"
                if (v) { val_str = "1" }
                this.emit_indent(raw + " = add i64 0, " + val_str)
                // LLVM lib parallel path — builds BoolLit in the LLVM Module alongside string emission
                if (this.use_llvm_lib and !this.identity_mode) {
                    var bool_int: Float = 0
                    if (v) { bool_int = 1 }
                    var llvm_zero: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(0, 64))
                    var llvm_val: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(bool_int, 64))
                    var llvm_result: LLVMTypes.Value = this.llvm_block_builder.add(llvm_zero, llvm_val)
                    this.llvm_values.set(raw, llvm_result)
                }
                var local: String = this.emit_tag_bool(raw)
                local
            }
            StringLit(s) => {
                this.last_type = AST.Type.StringType
                var const_name: String = this.add_string_constant(s)
                var gep: String = this.fresh_local()
                var len: Float = s.length() + 1
                this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
                var local: String = this.emit_tag_ptr(gep)
                // LLVM lib parallel path — string literal ptrtoint
                // Full path needs Module.add_global_string() + GEP + ptrtoint;
                // deferred until the LLVM lib gains global string constant support
                if (this.use_llvm_lib and !this.identity_mode) {
                    // placeholder: string constants need Module.add_global_string()
                }
                local
            }
            NilLit => {
                this.last_type = AST.Type.NilType
                if (this.identity_mode or !this.in_function) {
                    "0"
                } else {
                    var local: String = this.fresh_local()
                    this.emit_indent(local + " = call i64 @__val_nil()")
                    local
                }
            }
            Variable(name) => {
                if (this.typed_vars.has(name)) {
                    this.last_type = this.typed_vars.get(name)
                } else {
                    // Module-level globals are registered in global_var_types by the
                    // pre-scan, not in typed_vars. This arm used to fall straight to
                    // IntType without consulting that table, so a global read from
                    // inside any function claimed to be an Int — the dishonest
                    // "unknown means Int" fallback of BUGS #32/#33. Method dispatch
                    // then took no branch and returned a literal "0" (#37):
                    //
                    //   var _order = "abc"          // module level
                    //   fun f() { _order.index_of("b") }   // was 0, ignoring the string
                    //
                    // Reading the same global at top level worked, because typed_vars
                    // has it there. That asymmetry is what made this survive so long.
                    var gv_type: String = this.get_var_type_str(name)
                    if (gv_type.length() > 0) {
                        this.last_type = this.str_to_type(gv_type)
                    } else {
                        this.last_type = AST.Type.IntType
                    }
                }
                // Error check: undefined variable
                // Skip check for module aliases and enum names (they are valid in expressions)
                if (!this.typed_vars.has(name) and !this.module_globals.has(this.current_prefix + name) and !this.module_globals.has(name) and !this.str_in_list(this.known_functions,name) and !this.str_in_list(this.known_functions,this.current_prefix + name) and name != "self" and name != "this" and name != "super" and name != "IO" and name != "OS" and name != "GC" and name != "Task" and !this.module_prefixes.has(name) and !this.enum_defs.has(name) and !this.class_fields.has(name)) {
                    // Error, not a warning (BUGS #37). Emitting a load from an
                    // undeclared %name produces invalid LLVM, so the compile
                    // fails regardless — just with "use of undefined value
                    // '%data'" from llc instead of a source-level diagnostic.
                    // Failing here names the variable and stops before codegen.
                    IO.println("[codegen] Error: undefined variable '" + name + "'")
                    this.has_errors = true
                }
                // A nested `fun` declared in THIS body shadows a like-named module
                // global, so it must be answered as a function reference even though
                // the module_globals guards below would otherwise divert to a load
                // from @__g_. Tested first for exactly that reason (BUGS #80).
                if (this.current_fn_locals.has("__nestedfn:" + name) and !this.typed_vars.has(name) and !this.named_imports.has(name)) {
                    if (this.str_in_list(this.known_functions,this.current_prefix + name)) {
                        return this.gen_func_ref(this.current_prefix + name)
                    }
                    if (this.str_in_list(this.known_functions,name)) {
                        return this.gen_func_ref(name)
                    }
                }
                // Function reference as first-class value: ptrtoint (check BEFORE load)
                // Skip for named imports — they should go through gen_call for direct dispatch
                if (this.str_in_list(this.known_functions,name)) {
                    if (!this.typed_vars.has(name)) {
                        if (!this.module_globals.has(this.current_prefix + name) and !this.module_globals.has(name)) {
                            if (!this.named_imports.has(name)) {
                                return this.gen_func_ref(name)
                            }
                        }
                    }
                }
                if (this.str_in_list(this.known_functions,this.current_prefix + name)) {
                    if (!this.typed_vars.has(name)) {
                        if (!this.module_globals.has(this.current_prefix + name) and !this.module_globals.has(name)) {
                            if (!this.named_imports.has(name)) {
                                return this.gen_func_ref(this.current_prefix + name)
                            }
                        }
                    }
                }
                var local: String = this.fresh_local()
                var var_ref: String = "%" + this.sanitize_name(name)
                // `super` names the same receiver pointer as `this` — only the
                // dispatch differs, and gen_method_call handles that above. In
                // value position there is no `%super` alloca, so the generic
                // load below emitted `load i64, i64* %super` and the module
                // failed LLVM verification (BUGS #70).
                if (name == "super") {
                    var_ref = "%self"
                }
                if (this.module_globals.has(this.current_prefix + name)) {
                    var_ref = "@__g_" + this.current_prefix + this.sanitize_name(name)
                } else if (this.module_globals.has(name)) {
                    var_ref = "@__g_" + this.sanitize_name(name)
                }
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_load(local, "i64", var_ref))
                    // LLVM lib parallel path: propagate stored Value for this variable
                    if (!this.identity_mode and this.llvm_values.has(var_ref)) {
                        this.llvm_values.set(local, this.llvm_values.get(var_ref))
                    }
                } else {
                    this.emit_indent(local + " = load i64, i64* " + var_ref)
                    this.verify_load(local, "i64", var_ref)
                }
                local
            }
            Ref(rkind, rname, rslot) => {
                // Resolved by resolve.sf with a scope chain in hand, so the
                // local-vs-global question is already answered. The Variable arm
                // above has to re-derive it from module_globals, and gets it
                // wrong whenever a module global shares a name with a parameter
                // (BUGS #40): the global branch wins because it is tested first,
                // and the parameter becomes unreachable. Here `rkind` decides,
                // and no side table is consulted at all.
                if (this.typed_vars.has(rname)) {
                    this.last_type = this.typed_vars.get(rname)
                } else {
                    var rgv_type: String = this.get_var_type_str(rname)
                    if (rgv_type.length() > 0) {
                        this.last_type = this.str_to_type(rgv_type)
                    } else {
                        this.last_type = AST.Type.IntType
                    }
                }
                if (rkind == "unknown") {
                    IO.println("[codegen] Error: undefined variable '" + rname + "'")
                    this.has_errors = true
                }
                if (rkind == "func") {
                    if (!this.named_imports.has(rname)) {
                        return this.gen_func_ref(rslot + rname)
                    }
                }
                var rlocal: String = this.fresh_local()
                var rvar_ref: String = "%" + this.sanitize_name(rname)
                if (rkind == "global") {
                    rvar_ref = "@__g_" + rslot + this.sanitize_name(rname)
                }
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_load(rlocal, "i64", rvar_ref))
                    if (!this.identity_mode and this.llvm_values.has(rvar_ref)) {
                        this.llvm_values.set(rlocal, this.llvm_values.get(rvar_ref))
                    }
                } else {
                    this.emit_indent(rlocal + " = load i64, i64* " + rvar_ref)
                    this.verify_load(rlocal, "i64", rvar_ref)
                }
                rlocal
            }
            Binary(left, op, right) => {
                this.gen_binary(left, op, right)
            }
            Unary(op, right) => {
                this.gen_unary(op, right)
            }
            Call(callee, args) => {
                this.gen_call(callee, args)
            }
            Assign(name, value) => {
                var val: String = this.gen_arg_value(value)
                // Prefixed key only — see the note in stmts_body.sf's
                // gen_var_decl_with_name. The bare-name fallback could only
                // ever fire across a module boundary, so `i = i - 1` inside
                // @random's shuffle() stored to the main program's @__g_i while
                // every read used %i: the loop counter never decremented and
                // shuffle() spun forever.
                if (this.typed_vars.has(name) or this.module_globals.has(this.current_prefix + name)) {
                    var var_ref: String = "%" + this.sanitize_name(name)
                    if (this.module_globals.has(this.current_prefix + name)) {
                        var_ref = "@__g_" + this.current_prefix + this.sanitize_name(name)
                    }
                    if (this.use_llvm_lib) {
                        this.emit_indent(this.lib_store(val, "i64", var_ref))
                    } else {
                        this.emit_indent("store i64 " + val + ", i64* " + var_ref)
                        this.verify_store(val, "i64", var_ref)
                    }
                }
                val
            }









            Logical(left, op, right) => {
                this.gen_logical(left, op, right)
            }
            MemberAccess(object, field) => {
                // Check if object is This -> field access
                if (this.is_this_expr(object)) {
                    return this.gen_get_field(object, field)
                }
                // Check if object is a variable of class type -> field access
                var obj_name: String = this.get_variable_name(object)
                // Tuple field access: t._0, t._1, etc.
                if (obj_name.length() > 0 and field.starts_with("_") and field.length() >= 2) {
                    var tf_vtype: String = this.get_var_type_str(obj_name)
                    if (tf_vtype.starts_with("Tuple<")) {
                        var tf_rest: String = field.slice(1, field.length())
                        var tf_idx: Float = tf_rest.to_number()
                        var tf_obj: String = this.gen_arg_value(object)
                        var tf_idx_val: String = this.fresh_local()
                        this.emit_indent(tf_idx_val + " = add i64 0, " + tf_idx.floor().to_string())
                        var tf_result: String = this.fresh_local()
                        this.emit_indent(tf_result + " = call i64 @__list_get(i64 " + tf_obj + ", i64 " + tf_idx_val + ")")
                        var tf_inner: String = tf_vtype.slice(6, tf_vtype.length() - 1)
                        var tf_args: List<String> = this.split_type_args(tf_inner)
                        if (tf_idx >= 0 and tf_idx < tf_args.length()) {
                            this.last_type = this.str_to_type(tf_args[tf_idx])
                        } else {
                            this.last_type = AST.Type.AnyType
                        }
                        return tf_result
                    }
                }
                if (obj_name.length() > 0) {
                    // Check enum first
                    var key: String = obj_name + "." + field
                    if (this.enum_variant_tags.has(key)) {
                        return this.gen_enum_construct(obj_name, field, [])
                    }
                    // Check if variable holds a class instance
                    var vtype: String = this.get_var_type_str(obj_name)
                    var resolved_type: String = this.resolve_class_type(vtype)
                    if (resolved_type.length() > 0) {
                        // It's a class instance — do field access
                        var obj_val: String = this.gen_arg_value(object)
                        var saved_class: String = this.current_class
                        this.current_class = resolved_type
                        var field_idx: Float = this.get_field_index(resolved_type, field)
                        var obj_ptr: String = this.val_to_typed_ptr(obj_val, "%" + resolved_type + "*")
                        var field_ptr: String = this.fresh_local()
                        this.emit_indent(field_ptr + " = getelementptr %" + resolved_type + ", %" + resolved_type + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
                        var result: String = this.fresh_local()
                        this.emit_indent(result + " = load i64, i64* " + field_ptr)
                        // `resolved_type` is the bare/struct name (resolve_class_type
                        // strips the generic arguments), which is what the field
                        // tables are keyed by; `vtype` still has the arguments, and
                        // those are what a field declared `var v: T` needs to become
                        // a String on a `Box<String>` (BUGS #95).
                        var gf_ft: String = this.get_field_type(resolved_type, field)
                        this.last_type = this.str_to_type(this.substitute_class_type_params(gf_ft, vtype))
                        this.current_class = saved_class
                        return result
                    }
                    // Package namespace: check named_imports for "Alias.field" first
                    if (this.named_imports.has(obj_name + "." + field)) {
                        var pe_ref: String = this.named_imports.get(obj_name + "." + field)
                        if (this.str_in_list(this.known_functions, pe_ref)) {
                            return this.gen_func_ref(pe_ref)
                        }
                    }
                    // Module-prefixed function reference: e.g. Routes.list_packages used as value
                    if (this.module_prefixes.has(obj_name)) {
                        var mp_resolved: String = this.module_prefixes.get(obj_name) + field
                        if (this.str_in_list(this.known_functions, mp_resolved)) {
                            return this.gen_func_ref(mp_resolved)
                        }
                        // Module-prefixed global variable: e.g. Cache.store
                        if (this.module_globals.has(mp_resolved)) {
                            var mg_local: String = this.fresh_local()
                            var mg_ref: String = "@__g_" + this.sanitize_name(mp_resolved)
                            this.emit_indent(mg_local + " = load i64, i64* " + mg_ref)
                            // Publish the type so a method call on this receiver
                            // dispatches. Without it last_type is stale/unknown and
                            // `Flag.items.push(1)` hit the silent `return "0"` in the
                            // method dispatcher: the load was emitted, the call was
                            // discarded, and the program compiled clean but did nothing.
                            if (this.global_var_types.has(mp_resolved)) {
                                this.last_type = this.str_to_type(this.global_var_types.get(mp_resolved))
                            }
                            return mg_local
                        }
                        // Neither a function nor a global under this module's
                        // prefix. The alias is *known* to be a module here, so
                        // "not found" is expressible — and this is the only place
                        // it is. Falling through instead reached the generic
                        // receiver path below, which evaluated the bare alias as
                        // a local and emitted `load i64, i64* %Math` — invalid IR
                        // blamed on the compiler for what is a typo in the user's
                        // program (BUGS #118). Same family as #22/#40/#78/#37/
                        // #103/#113/#114: a resolver with no way to say "not
                        // found" guesses instead of reporting absence.
                        //
                        // This arm is currently unreachable — `gen_arg_value`'s
                        // parallel copy of this block wins for every spelling
                        // measured (336 files) — but it is kept correct so it
                        // reports rather than guesses if it ever goes live.
                        IO.println("[codegen] Error: no member '" + field + "' in module '" + obj_name + "'")
                        this.has_errors = true
                        return "0"
                    }
                }
                // Fallback: evaluate object, check last_type for class (handles chained expr like list[i].field)
                var ma_obj_val: String = this.gen_arg_value(object)
                var ma_type_str: String = this.type_to_string(this.last_type)
                var ma_resolved: String = this.resolve_class_type(ma_type_str)
                if (ma_resolved.length() > 0 and this.class_fields.has(ma_resolved)) {
                    var saved_class: String = this.current_class
                    this.current_class = ma_resolved
                    var struct_name: String = ma_resolved
                    if (this.class_struct_names.has(ma_resolved)) {
                        struct_name = this.class_struct_names.get(ma_resolved)
                    }
                    var field_idx: Float = this.get_field_index(ma_resolved, field)
                    var obj_ptr: String = this.val_to_typed_ptr(ma_obj_val, "%" + struct_name + "*")
                    var field_ptr: String = this.fresh_local()
                    this.emit_indent(field_ptr + " = getelementptr %" + struct_name + ", %" + struct_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
                    var result: String = this.fresh_local()
                    this.emit_indent(result + " = load i64, i64* " + field_ptr)
                    // Same split as the annotated-variable path above: the tables
                    // want the bare name, the substitution wants the arguments.
                    var ma_ft: String = this.get_field_type(ma_resolved, field)
                    this.last_type = this.str_to_type(this.substitute_class_type_params(ma_ft, ma_type_str))
                    this.current_class = saved_class
                    return result
                }
                "0"
            }
            EnumConstruct(enum_name, variant, args) => {
                this.gen_enum_construct(enum_name, variant, args)
            }
            Match(subject, arms) => {
                this.gen_match(subject, arms)
            }
            Lambda(params, ret_type, body) => {
                this.gen_lambda(params, ret_type, body)
            }
            This => {
                this.last_type = this.str_to_type(this.current_class)
                var local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_load(local, "i64", "%self"))
                } else {
                    this.emit_indent(local + " = load i64, i64* %self")
                }
                local
            }
            GetField(object, field) => {
                this.gen_get_field(object, field)
            }
            SetField(object, field, value) => {
                // This arm is currently UNREACHABLE, and measured so rather than
                // argued: with a distinct marker string on each of the two write
                // sites, 18 syntactic positions were swept (top level, function
                // body, if/else, while, for-in, C-style for, try, catch, match
                // arm, class method, `init`, nested `fun`, actor method, bare
                // block, two writes in a row) and `gen_arg_value`'s `set_field`
                // branch fired in every one — this arm in none. `gen_expr` has
                // only four callers, all inside `gen_arg_value`, and
                // `gen_arg_value` handles `set_field` before reaching any of
                // them. Kept correct anyway, exactly as #118 kept its own dead
                // read copy correct: a fix applied only to the readable one would
                // have changed nothing and still bootstrapped green.
                if (this.report_missing_module_write(object, field)) {
                    return "0"
                }
                this.gen_set_field(object, field, value)
            }
            ListLit(elements) => {
                this.gen_list_lit(elements)
            }
            IndexGet(object, index) => {
                this.gen_index_get(object, index)
            }
            IndexSet(object, index, value) => {
                this.gen_index_set(object, index, value)
            }
            MethodCall(object, method, args) => {
                this.gen_method_call(object, method, args)
            }
            MapLit => {
                this.last_type = this.make_map_type()
                var local: String = this.fresh_local()
                this.emit_indent(local + " = call i64 @__map_new()")
                local
            }
            BlockExpr(stmts, value) => {
                this.gen_stmts(stmts)
                this.gen_arg_value(value)
            }
            IsCheck(value, type_name) => {
                this.gen_is_check(value, type_name)
            }
            IfExpr(cond, then_stmts, then_val, else_stmts, else_val) => {
                this.gen_if_expr(cond, then_stmts, then_val, else_stmts, else_val)
            }
            TryExpr(try_stmts, try_val, catch_name, catch_stmts, catch_val) => {
                this.gen_try_expr(try_stmts, try_val, catch_name, catch_stmts, catch_val)
            }
            Yield(value) => {
                this.gen_yield(value)
            }
            TupleLit(elements) => {
                var result: String = this.gen_list_lit(elements)
                var tuple_type_str: String = "Tuple<"
                var tti: Float = 0
                while (tti < elements.length()) {
                    if (tti > 0) { tuple_type_str = tuple_type_str + "," }
                    var elem_type: String = this.get_expr_type(elements[tti])
                    tuple_type_str = tuple_type_str + elem_type
                    tti = tti + 1
                }
                tuple_type_str = tuple_type_str + ">"
                this.last_type = this.str_to_type(tuple_type_str)
                result
            }
        }
    }

    fun gen_yield(value: AST.Expr): String {
        // Detect yield [reason, arg] pattern for sleep/IO
        var is_list: String = match (value) { ListLit(elems) => "yes" _ => "no" }
        if (is_list == "yes") {
            var elems: List<AST.Expr> = match (value) { ListLit(e) => e    _ => [] }
            if (elems.length() >= 1) {
                var reason: String = this.gen_arg_value(elems[0])
                this.emit_indent("store i64 " + reason + ", i64* @__yield_reason")
                if (elems.length() >= 2) {
                    var arg: String = this.gen_arg_value(elems[1])
                    this.emit_indent("store i64 " + arg + ", i64* @__yield_arg")
                }
            }
        }

        // Coroutine suspend sequence
        var save_tok: String = this.fresh_local()
        this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
        var susp_result: String = this.fresh_local()
        this.emit_indent(susp_result + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")

        var resume_label: String = this.fresh_label("yield.resume")
        var cleanup_label: String = this.fresh_label("yield.cleanup")

        // Default (suspend) case branches to the shared __coro_suspend block.
        // CoroSplit requires all suspend points to share a single suspend/ret block;
        // per-yield suspend blocks become unreachable in the .resume function.
        this.emit_terminator("switch i8 " + susp_result + ", label %__coro_suspend [i8 0, label %" + resume_label + " i8 1, label %" + cleanup_label + "]")

        // Cleanup path (coroutine destroyed while suspended)
        this.emit(cleanup_label + ":")
        this.block_terminated = false
        this.emit_terminator("br label %__coro_cleanup")

        // Resume path — read resume value from promise slot
        this.emit(resume_label + ":")
        this.block_terminated = false
        var resume_val: String = "0"

        this.last_type = AST.Type.IntType
        return resume_val
    }

    fun gen_is_check(value: AST.Expr, type_name: String): String {
        var val: String = this.gen_arg_value(value)
        var val_type: AST.Type = this.last_type
        this.last_type = AST.Type.BoolType

        // A type that admits several runtime representations — Any, a union, a
        // nullable — cannot be decided at compile time, so emit a runtime
        // NaN-boxing tag check. This condition used to be `val_type_str ==
        // "Any"`, a whitelist that silently mis-answered everything it forgot:
        // an `Int|Nil` reached the compile-time path below, where every
        // is_*_type predicate answers false for a union, so BOTH `x is Int` and
        // `x is Nil` compiled to a literal false. See BUGS #69.
        var val_type_str: String = this.type_to_string(val_type)
        if (this.is_undecidable_type(val_type)) {
            var rt_func: String = ""
            if (type_name == "Int" or type_name == "Number") {
                rt_func = "__val_is_int"
            } else if (type_name == "Float") {
                rt_func = "__val_is_float"
            } else if (type_name == "String") {
                rt_func = "__val_is_string"
            } else if (type_name == "Bool") {
                rt_func = "__val_is_bool"
            } else if (type_name == "Nil") {
                rt_func = "__val_is_nil"
            } else if (type_name == "List") {
                rt_func = "__val_is_list"
            } else if (type_name == "Map") {
                rt_func = "__val_is_map"
            }
            if (rt_func.length() > 0) {
                var check_result: String = this.fresh_local()
                this.emit_indent(check_result + " = call i1 @" + rt_func + "(i64 " + val + ")")
                var raw_bool: String = this.fresh_local()
                this.emit_indent(raw_bool + " = zext i1 " + check_result + " to i64")
                return this.emit_tag_bool(raw_bool)
            }
            // A class name: dispatch on the object's actual GC type tag. This
            // used to emit a literal 0 plus a warning, because codegen was
            // believed to have no runtime model of the hierarchy; it now emits
            // one (see emit_class_hierarchy_helpers). __class_is_a walks the
            // parent chain, so `d is Animal` for a Dog answers true — something
            // the old path could not express at all, warning or not.
            var cls_check: String = this.gen_class_tag_check(val, type_name)
            if (cls_check.length() > 0) { return cls_check }
            // Not a known class (an enum name, a generic parameter, an
            // interface with no instances): still undecidable. Warn rather than
            // answering silently — a dead `is` branch is invisible at runtime.
            IO.println("[codegen] Warning: `is " + type_name + "` on a value of type " + val_type_str + " always answers false — class identity is not checked at runtime")
            var local: String = this.fresh_local()
            this.emit_indent(local + " = add i64 0, 0")
            return this.emit_tag_bool(local)
        }

        // Compile-time resolution when type is statically known
        var matches: String = "0"
        if (type_name == "Int" or type_name == "Number" or type_name == "Float") {
            if (this.is_int_type(val_type)) { matches = "1" }
        } else if (type_name == "String") {
            if (this.is_string_type(val_type)) { matches = "1" }
        } else if (type_name == "Bool") {
            if (this.is_bool_type(val_type)) { matches = "1" }
        } else if (type_name == "Nil") {
            if (this.is_nil_type(val_type)) { matches = "1" }
        } else if (type_name == "List") {
            if (this.is_list_type(val_type)) { matches = "1" }
        } else if (type_name == "Map") {
            if (this.is_map_type(val_type)) { matches = "1" }
        } else {
            // A class name. Folding via is_class_type is only correct when the
            // static type is *exactly* type_name and cannot be a subclass —
            // is_class_type answers `n == name`, so it says false for a Dog
            // tested against Animal and for anything the checker could not
            // infer precisely. That was the other half of BUGS #61, and a fix
            // confined to the undecidable branch above would have looked
            // complete while leaving it. Emit the runtime check and let LLVM
            // fold the cases it can prove.
            var cls_check2: String = this.gen_class_tag_check(val, type_name)
            if (cls_check2.length() > 0) { return cls_check2 }
            if (this.is_class_type(val_type, type_name)) { matches = "1" }
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = add i64 0, " + matches)
        return this.emit_tag_bool(local)
    }

    // Emit `__class_is_a(__val_class_tag(val), <tag of type_name>)` as a tagged
    // Saffron Bool, or "" when type_name is not a class this program declares —
    // an enum name, a generic parameter, an interface with no instances. The
    // empty string is the "I don't know" the callers need: gen_is_check falls
    // back rather than emitting a check against a tag that does not exist.
    // Returning a plausible `false` instead is the exact shape of failure that
    // made BUGS #61, #69 and #22 all silent.
    fun gen_class_tag_check(val: String, type_name: String): String {
        var hit: String = this.gen_class_tag_check_i1(val, type_name)
        if (hit.length() == 0) { return "" }
        var raw: String = this.fresh_local()
        this.emit_indent(raw + " = zext i1 " + hit + " to i64")
        return this.emit_tag_bool(raw)
    }

    // The raw i1 behind gen_class_tag_check, for callers that want to branch on
    // it rather than produce a value — gen_match's class-pattern chain does,
    // and re-truncating a freshly tagged Bool just to test it would be silly.
    // Same "" contract: not a class this program declares.
    fun gen_class_tag_check_i1(val: String, type_name: String): String {
        // Identity mode has no GC headers and no hierarchy helpers, so there is
        // no tag to read; the caller keeps its compile-time answer.
        if (this.identity_mode) { return "" }
        var struct_name: String = type_name
        if (this.class_struct_names.has(type_name)) { struct_name = this.class_struct_names.get(type_name) }
        if (!this.class_type_ids.has(struct_name)) { return "" }
        var target: Float = this.class_type_ids.get(struct_name)
        var tag_reg: String = this.fresh_local()
        this.emit_indent(tag_reg + " = call i64 @__val_class_tag(i64 " + val + ")")
        var hit: String = this.fresh_local()
        this.emit_indent(hit + " = call i1 @__class_is_a(i64 " + tag_reg + ", i64 " + target.floor().to_string() + ")")
        return hit
    }

    fun gen_if_expr(cond: AST.Expr, then_stmts: List<AST.Stmt>, then_val: AST.Expr, else_stmts: List<AST.Stmt>, else_val: AST.Expr): String {
        var result_ptr: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_alloca(result_ptr, "i64"))
        } else {
            this.emit_indent(result_ptr + " = alloca i64")
            this.verify_alloca(result_ptr, "i64")
        }

        var cond_val: String = this.to_i1(this.gen_arg_value(cond))
        var then_label: String = this.fresh_label("ifexpr.then")
        var else_label: String = this.fresh_label("ifexpr.else")
        var end_label: String = this.fresh_label("ifexpr.end")

        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_cond_br(cond_val, then_label, else_label))
        } else {
            this.emit_terminator("br i1 " + cond_val + ", label %" + then_label + ", label %" + else_label)
            this.verify_cond_br(cond_val, then_label, else_label)
        }

        this.start_block(then_label)
        this.gen_stmts(then_stmts)
        var then_result: String = this.gen_arg_value(then_val)
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_store(then_result, "i64", result_ptr))
        } else {
            this.emit_indent("store i64 " + then_result + ", i64* " + result_ptr)
            this.verify_store(then_result, "i64", result_ptr)
        }
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(end_label))
        } else {
            this.emit_terminator("br label %" + end_label)
            this.verify_br(end_label)
        }

        this.start_block(else_label)
        this.gen_stmts(else_stmts)
        var else_result: String = this.gen_arg_value(else_val)
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_store(else_result, "i64", result_ptr))
        } else {
            this.emit_indent("store i64 " + else_result + ", i64* " + result_ptr)
            this.verify_store(else_result, "i64", result_ptr)
        }
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(end_label))
        } else {
            this.emit_terminator("br label %" + end_label)
            this.verify_br(end_label)
        }

        this.start_block(end_label)
        var result: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_load(result, "i64", result_ptr))
        } else {
            this.emit_indent(result + " = load i64, i64* " + result_ptr)
            this.verify_load(result, "i64", result_ptr)
        }
        return result
    }

    fun gen_try_expr(try_stmts: List<AST.Stmt>, try_val: AST.Expr, catch_name: String, catch_stmts: List<AST.Stmt>, catch_val: AST.Expr): String {
        var result_ptr: String = this.fresh_local()
        this.emit_indent(result_ptr + " = alloca i64")

        var try_label: String = this.fresh_label("tryexpr.try")
        var catch_label: String = this.fresh_label("tryexpr.catch")
        var end_label: String = this.fresh_label("tryexpr.end")

        // Allocate a local jmp_buf on the stack
        var jmp_buf: String = this.fresh_local()
        this.emit_indent(jmp_buf + " = alloca [512 x i8], align 16")
        var jmp_buf_ptr: String = this.fresh_local()
        this.emit_indent(jmp_buf_ptr + " = getelementptr [512 x i8], [512 x i8]* " + jmp_buf + ", i64 0, i64 0")

        // Save previous jmp_buf
        var saved_jmp: String = this.fresh_local()
        this.emit_indent(saved_jmp + " = load i8*, i8** @__jmp_buf_current")
        this.emit_indent("store i8* " + jmp_buf_ptr + ", i8** @__jmp_buf_current")

        // Save shadow stack depth for restoration on catch
        var saved_ss_depth: String = this.fresh_local()
        this.emit_indent(saved_ss_depth + " = call i64 @__gc_shadow_stack_depth()")

        // setjmp
        var setjmp_result: String = this.fresh_local()
        this.emit_indent(setjmp_result + " = call i32 @setjmp(i8* " + jmp_buf_ptr + ")")
        var is_throw: String = this.fresh_local()
        this.emit_indent(is_throw + " = icmp ne i32 " + setjmp_result + ", 0")
        this.emit_terminator("br i1 " + is_throw + ", label %" + catch_label + ", label %" + try_label)

        // Try body
        this.start_block(try_label)
        this.gen_stmts(try_stmts)
        var try_result: String = this.gen_arg_value(try_val)
        this.emit_indent("store i64 " + try_result + ", i64* " + result_ptr)
        this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
        this.emit_terminator("br label %" + end_label)

        // Catch body
        this.start_block(catch_label)
        this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
        // Restore shadow stack depth (longjmp skipped pop_roots)
        var cur_ss_depth: String = this.fresh_local()
        this.emit_indent(cur_ss_depth + " = call i64 @__gc_shadow_stack_depth()")
        var ss_pop_n: String = this.fresh_local()
        this.emit_indent(ss_pop_n + " = sub i64 " + cur_ss_depth + ", " + saved_ss_depth)
        this.emit_indent("call void @__gc_pop_roots(i64 " + ss_pop_n + ")")
        var exc_val: String = this.fresh_local()
        this.emit_indent(exc_val + " = load i64, i64* @__exception_value")
        this.emit_indent("store i64 " + exc_val + ", i64* %" + this.sanitize_name(catch_name))
        this.gen_stmts(catch_stmts)
        var catch_result: String = this.gen_arg_value(catch_val)
        this.emit_indent("store i64 " + catch_result + ", i64* " + result_ptr)
        this.emit_terminator("br label %" + end_label)

        this.start_block(end_label)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = load i64, i64* " + result_ptr)
        return result
    }

    /// Does this static type name settle the *representation* of an ordering
    /// comparison, so `<` can be a direct icmp/fcmp with no tag inspection?
    ///
    /// Only the numeric primitives qualify. Everything else — `Any`, a class, a
    /// union, a generic parameter, or the empty string get_expr_type returns when
    /// inference gave up — leaves the representation unknown at compile time, and
    /// a comparison on an unknown representation has to ask the value itself.
    ///
    /// `Bool` is deliberately absent: it is TAG_SPEC, not an integer, so an icmp
    /// on the boxed bit pattern is not its order. It falls to the runtime helper
    /// along with everything else.
    fun is_ordered_primitive(t: String): Bool {
        return t == "Int" or t == "Number" or t == "Float"
    }

    /// The runtime helper implementing `op` for operands whose static types do
    /// not settle the comparison. Empty for a non-relational op.
    fun ordering_helper(op: String): String {
        if (op == "<") { return "__val_lt" }
        if (op == "<=") { return "__val_le" }
        if (op == ">") { return "__val_gt" }
        if (op == ">=") { return "__val_ge" }
        return ""
    }

    fun op_to_method(op: String): String {
        if (op == "+") { return "add" }
        if (op == "-") { return "sub" }
        if (op == "*") { return "mul" }
        if (op == "/") { return "div" }
        if (op == "%") { return "mod" }
        if (op == "<") { return "lt" }
        if (op == ">") { return "gt" }
        if (op == "==") { return "eq" }
        return ""
    }

    fun gen_binary(left: AST.Expr, op: String, right: AST.Expr): String {
        // Operator overloading: check if left operand is a class with the method
        var method_name: String = this.op_to_method(op)
        if (method_name.length() > 0) {
            var left_name: String = this.get_variable_name(left)
            var left_class: String = ""
            if (left_name.length() > 0) {
                left_class = this.get_var_type_str(left_name)
            } else {
                // The left operand is not a plain variable. It used to be given
                // up on here, so `Vec2(1,2) + Vec2(3,4)` — a constructor call,
                // `this.pos`, a method result — skipped overload dispatch
                // entirely and fell through to the primitive integer path,
                // emitting `add i64` on two *pointers* and printing a garbage
                // address. Silent wrong answer, no diagnostic. get_expr_type
                // already resolves calls and field accesses, so just ask it.
                //
                // Accept the answer ONLY if it names a declared class.
                // get_expr_type also returns primitives ("Int", "Number",
                // "Any"), and letting those through made `a + b + c` — whose
                // left operand is itself a Binary — resolve to a primitive that
                // collided with a user function sharing the overload method
                // name, rewriting the addition into a call to the user's own
                // global `add`: "'add' expects 3 arguments, got 2".
                var inferred_class: String = this.get_expr_type(left)
                if (this.class_fields.has(inferred_class)) {
                    left_class = inferred_class
                }
            }
            if (left_class.length() > 0) {
                if (this.class_methods.has(left_class)) {
                    var methods: List = this.class_methods.get(left_class)
                    if (methods.contains(method_name)) {
                        // Dispatch: left.method(right)
                        var lhs: String = this.gen_arg_value(left)
                        var rhs: String = this.gen_arg_value(right)
                        var full_method: String = left_class + "__" + method_name
                        if (this.func_prefix_map.has(full_method)) {
                            full_method = this.func_prefix_map.get(full_method)
                        } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions,this.current_prefix + full_method)) {
                            full_method = this.current_prefix + full_method
                        }
                        this.called_functions.push(full_method)
                        var local: String = this.fresh_local()
                        this.emit_indent(local + " = call i64 @" + full_method + "(i64 " + lhs + ", i64 " + rhs + ")")
                        if (this.func_ret_types.has(full_method)) {
                            this.last_type = this.func_ret_types.get(full_method)
                        } else {
                            this.last_type = this.str_to_type(left_class)
                        }
                        return local
                    }
                }
            }
        }

        // String equality comparison
        if (op == "==" or op == "!=") {
            var left_type: String = this.get_expr_type(left)
            var right_type: String = this.get_expr_type(right)
            var lhs: String = this.gen_arg_value(left)
            if (left_type == "Any") { left_type = this.type_to_string(this.last_type) }
            var rhs: String = this.gen_arg_value(right)
            if (right_type == "Any") { right_type = this.type_to_string(this.last_type) }

            // Nil comparison: use __val_is_nil in NaN-boxing mode
            // Must come before string comparison to handle cases like:
            // map.get("missing") == nil where get returns "String" type but actual value is nil
            if (!this.identity_mode) {
                // Which side is the *literal* nil, syntactically. This is the only
                // reliable signal for "test the other operand for nil".
                //
                // Keying off the inferred type alone is wrong when both sides are typed
                // Nil, which happens for `var x: Any = nil; ...; x == nil`: the
                // declaration used to narrow x to Nil (now fixed in gen_var_decl, but
                // any other Nil-typed expression reaches here too), and then
                // `check_val` picked whichever side the type test happened to name —
                // ending up testing the nil literal against itself, which is
                // unconditionally true regardless of what the variable holds.
                var left_is_literal_nil: Bool = this.is_nil_expr(left)
                var right_is_literal_nil: Bool = this.is_nil_expr(right)

                var is_nil_cmp: Bool = false
                if (left_type == "Nil") { is_nil_cmp = true }
                if (right_type == "Nil") { is_nil_cmp = true }
                if (left_is_literal_nil or right_is_literal_nil) { is_nil_cmp = true }
                if (is_nil_cmp) {
                    // Prefer the syntactic literal: check the side that is NOT `nil`.
                    var check_val: String = lhs
                    if (left_is_literal_nil and !right_is_literal_nil) {
                        check_val = rhs
                    } else if (right_is_literal_nil) {
                        check_val = lhs
                    } else if (left_type == "Nil") {
                        // Neither side is a literal; fall back to the type test.
                        check_val = rhs
                    }
                    var is_nil_raw: String = this.fresh_local()
                    this.emit_indent(is_nil_raw + " = call i1 @__val_is_nil(i64 " + check_val + ")")
                    var nil_bool: String = is_nil_raw
                    if (op == "!=") {
                        nil_bool = this.fresh_local()
                        this.emit_indent(nil_bool + " = xor i1 " + is_nil_raw + ", true")
                    }
                    var raw_bool: String = this.fresh_local()
                    this.emit_indent(raw_bool + " = zext i1 " + nil_bool + " to i64")
                    this.last_type = AST.Type.BoolType
                    var local: String = this.emit_tag_bool(raw_bool)
                    return local
                }
            }

            // Static-String comparison. Requires BOTH sides to be statically known
            // non-Any: __string_eq / __string_ne dereference their operands as char*
            // without inspecting the tag, so an Any operand holding nil (or an int,
            // or a list) segfaults inside strcmp.
            //
            // An `Any` operand must therefore fall through to the __any_eq/__any_ne
            // branch below, which unmasks and routes on the real tag and compares
            // string *contents* when both sides do turn out to be strings. Before
            // this ordering fix, `var x: Any = nil; x != "something"` crashed.
            if ((left_type == "String" or right_type == "String") and left_type != "Any" and right_type != "Any") {
                var raw_bool: String = this.fresh_local()
                if (op == "==") {
                    this.emit_indent(raw_bool + " = call i64 @__string_eq(i64 " + lhs + ", i64 " + rhs + ")")
                } else {
                    this.emit_indent(raw_bool + " = call i64 @__string_ne(i64 " + lhs + ", i64 " + rhs + ")")
                }
                this.last_type = AST.Type.BoolType
                var local: String = this.emit_tag_bool(raw_bool)
                return local
            }

            // Any-typed equality: use __any_eq/__any_ne for deep comparison
            // (handles strings with different pointers but same content)
            if (left_type == "Any" or right_type == "Any") {
                var raw_bool: String = this.fresh_local()
                if (op == "==") {
                    this.emit_indent(raw_bool + " = call i64 @__any_eq(i64 " + lhs + ", i64 " + rhs + ")")
                } else {
                    this.emit_indent(raw_bool + " = call i64 @__any_ne(i64 " + lhs + ", i64 " + rhs + ")")
                }
                this.last_type = AST.Type.BoolType
                var local: String = this.emit_tag_bool(raw_bool)
                return local
            }

            // Float equality: untag both sides as float and compare at double level.
            // Raw icmp eq fails when one value is int-tagged (0x7FF9...) and the
            // other is float-tagged (after arithmetic), even if semantically equal.
            if (left_type == "Float" or right_type == "Float") {
                var lf: String = this.fresh_local()
                this.emit_indent(lf + " = call double @__val_untag_float(i64 " + lhs + ")")
                var rf: String = this.fresh_local()
                this.emit_indent(rf + " = call double @__val_untag_float(i64 " + rhs + ")")
                var cmp_local: String = this.fresh_local()
                if (op == "==") { this.emit_indent(cmp_local + " = fcmp oeq double " + lf + ", " + rf) }
                else { this.emit_indent(cmp_local + " = fcmp une double " + lf + ", " + rf) }
                var raw_bool: String = this.fresh_local()
                this.emit_indent(raw_bool + " = zext i1 " + cmp_local + " to i64")
                this.last_type = AST.Type.BoolType
                var local: String = this.emit_tag_bool(raw_bool)
                return local
            }

            // Enum equality: structural, not by address (BUGS #116).
            //
            // This arm must sit above the integer fall-through, which is where two
            // operands of the same EnumType used to land. A payload variant is a
            // heap `[tag, f0, ...]` array (gen_enum_construct below), so `icmp eq`
            // on the two value slots compared the two *malloc addresses*:
            // `Option.Some(42) == Option.Some(42)` answered false, and so did
            // `Option.None == Option.None`, because as soon as ANY variant of the
            // enum carries a field EVERY variant is heap-allocated — a fieldless
            // one becomes a one-slot `[tag]` array instead of the `tag << 56`
            // immediate. `==` therefore meant value equality for an enum declared
            // without payloads and identity for one declared with them: one
            // spelling, two semantics, chosen by a detail of the declaration that
            // the comparison site cannot see.
            //
            // The comparison is routed to a per-enum `__enum_eq_<Name>` function
            // rather than to a generic runtime helper because variant arity and
            // field types live only in codegen's `enum_variant_fields`, and the
            // heap array carries no GC header or type tag that a runtime helper
            // could read (which is why `__rt_gc_tag_of` cannot identify one, and
            // why #115's enum half wants the header). Everything needed to compare
            // two of these values is known statically, right here.
            //
            // Only fires when both operands are the SAME declared enum and that
            // enum is heap-encoded. A fieldless enum keeps the `icmp eq` below,
            // which is already correct for immediates, and a mismatched pair falls
            // through unchanged.
            var __ee_lbase: String = this.generic_base_name(left_type)
            var __ee_rbase: String = this.generic_base_name(right_type)
            if (__ee_lbase == __ee_rbase and this.enum_defs.has(__ee_lbase) and this.get_max_fields(__ee_lbase) > 0) {
                var ee_sym: String = this.ensure_enum_eq(__ee_lbase)
                var ee_raw: String = this.fresh_local()
                this.emit_indent(ee_raw + " = call i64 @" + ee_sym + "(i64 " + lhs + ", i64 " + rhs + ")")
                // `!=` is the negation of the same call, so the two operators
                // cannot drift apart.
                var ee_cmp: String = this.fresh_local()
                if (op == "==") { this.emit_indent(ee_cmp + " = icmp ne i64 " + ee_raw + ", 0") }
                else { this.emit_indent(ee_cmp + " = icmp eq i64 " + ee_raw + ", 0") }
                var ee_bool: String = this.fresh_local()
                this.emit_indent(ee_bool + " = zext i1 " + ee_cmp + " to i64")
                this.last_type = AST.Type.BoolType
                return this.emit_tag_bool(ee_bool)
            }

            // Integer comparison (tagged values compare equal correctly)
            var cmp_local: String = this.fresh_local()
            if (op == "==") { this.emit_indent(cmp_local + " = icmp eq i64 " + lhs + ", " + rhs) }
            else { this.emit_indent(cmp_local + " = icmp ne i64 " + lhs + ", " + rhs) }
            var raw_bool: String = this.fresh_local()
            this.emit_indent(raw_bool + " = zext i1 " + cmp_local + " to i64")
            // LLVM lib parallel path: track Value for == / != integer comparison
            if (this.use_llvm_lib and !this.identity_mode and this.llvm_values.has(lhs) and this.llvm_values.has(rhs)) {
                var lhs_v: Any = this.llvm_values.get(lhs)
                var rhs_v: Any = this.llvm_values.get(rhs)
                var cmp_v: Any = lhs_v
                if (op == "==") { cmp_v = this.llvm_block_builder.icmp_eq(lhs_v, rhs_v) }
                else { cmp_v = this.llvm_block_builder.icmp_ne(lhs_v, rhs_v) }
                var zext_v: Any = this.llvm_block_builder.zext(cmp_v, LLVMTypes.Type.I64)
                this.llvm_values.set(raw_bool, zext_v)
            }
            this.last_type = AST.Type.BoolType
            var local: String = this.emit_tag_bool(raw_bool)
            return local
        }

        if (op == "+") {
            // Type-directed: check types before generating code
            var left_type: String = this.get_expr_type(left)
            var right_type: String = this.get_expr_type(right)
            var lhs: String = this.gen_arg_value(left)
            if (left_type == "Any") { left_type = this.type_to_string(this.last_type) }
            var rhs: String = this.gen_arg_value(right)
            if (right_type == "Any") { right_type = this.type_to_string(this.last_type) }

            if (left_type == "String" or right_type == "String") {
                // String concatenation
                this.last_type = AST.Type.StringType
                var lptr: String = this.emit_untag_ptr(lhs)
                var rptr: String = this.emit_untag_ptr(rhs)
                var llen: String = this.fresh_local()
                this.emit_indent(llen + " = call i64 @strlen(i8* " + lptr + ")")
                var rlen: String = this.fresh_local()
                this.emit_indent(rlen + " = call i64 @strlen(i8* " + rptr + ")")
                var total: String = this.fresh_local()
                this.emit_indent(total + " = add i64 " + llen + ", " + rlen)
                var total1: String = this.fresh_local()
                this.emit_indent(total1 + " = add i64 " + total + ", 1")
                var buf: String = this.fresh_local()
                this.emit_indent(buf + " = call i8* @__sf_malloc(" + this.malloc_size_type() + " " + this.malloc_size_arg(total1) + ")")
                this.emit_indent("call i8* @strcpy(i8* " + buf + ", i8* " + lptr + ")")
                this.emit_indent("call i8* @strcat(i8* " + buf + ", i8* " + rptr + ")")
                var raw_result: String = this.ptr_to_val(buf)
                var result: String = this.fresh_local()
                this.emit_indent(result + " = call i64 @__string_intern(i64 " + raw_result + ")")
                // Tag the interned pointer for NaN-boxing
                var intern_ptr: String = this.fresh_local()
                this.emit_indent(intern_ptr + " = inttoptr i64 " + result + " to i8*")
                var tagged_result: String = this.emit_tag_ptr(intern_ptr)
                // LLVM lib parallel path: track string concatenation result
                if (!this.identity_mode) {
                    var sc_res: LLVMTypes.Value = this.llvm_block_builder.call("__string_concat", LLVMTypes.Type.I64, [])
                    this.llvm_values.set(tagged_result, sc_res)
                }
                return tagged_result
            }

            if (left_type == "Float" or right_type == "Float") {
                this.last_type = AST.Type.FloatType
                var ld: String = this.emit_untag_float(lhs)
                var rd: String = this.emit_untag_float(rhs)
                var fd: String = this.fresh_local()
                this.emit_indent(fd + " = fadd double " + ld + ", " + rd)
                return this.emit_tag_float(fd)
            }

            // Integer addition
            this.last_type = AST.Type.IntType
            var lhs_raw: String = this.emit_untag_int(lhs)
            var rhs_raw: String = this.emit_untag_int(rhs)
            var add_result: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("add", add_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for add
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.add(lhs_v, rhs_v)
                    this.llvm_values.set(add_result, res_v)
                }
            } else {
                this.emit_indent(add_result + " = add i64 " + lhs_raw + ", " + rhs_raw)
            }
            var local: String = this.emit_tag_int(add_result)
            return local
        }

        var left_type2: String = this.get_expr_type(left)
        var lhs: String = this.gen_arg_value(left)
        if (left_type2 == "Any") { left_type2 = this.type_to_string(this.last_type) }
        var right_type2: String = this.get_expr_type(right)
        var rhs: String = this.gen_arg_value(right)
        if (right_type2 == "Any") { right_type2 = this.type_to_string(this.last_type) }

        var __is_float_l: Bool = left_type2 == "Float"
        var __is_float_r: Bool = right_type2 == "Float"
        var __either_float: Bool = __is_float_l or __is_float_r
        var __is_sub: Bool = op == "-"
        var __is_mul: Bool = op == "*"
        var __is_div: Bool = op == "/"
        var __is_mod: Bool = op == "%"
        var __any_arith_op: Bool = __is_sub or __is_mul or __is_div or __is_mod
        var __take_float_path: Bool = __either_float and __any_arith_op

        if (__take_float_path) {
            this.last_type = AST.Type.FloatType
            var ld: String = this.emit_untag_float(lhs)
            var rd: String = this.emit_untag_float(rhs)
            var fd: String = this.fresh_local()
            if (op == "-") {
                this.emit_indent(fd + " = fsub double " + ld + ", " + rd)
            } else if (op == "*") {
                this.emit_indent(fd + " = fmul double " + ld + ", " + rd)
            } else if (op == "/") {
                this.emit_indent(fd + " = fdiv double " + ld + ", " + rd)
            } else {
                this.emit_indent(fd + " = frem double " + ld + ", " + rd)
            }
            return this.emit_tag_float(fd)
        }

        // Untag integer operands for arithmetic/comparison
        var lhs_raw: String = this.emit_untag_int(lhs)
        var rhs_raw: String = this.emit_untag_int(rhs)

        // Guard against division/modulo by zero
        if (op == "/" or op == "%") {
            var is_zero: String = this.fresh_local()
            this.emit_indent(is_zero + " = icmp eq i64 " + rhs_raw + ", 0")
            var lbl_err: String = this.fresh_label("div_err")
            var lbl_ok: String = this.fresh_label("div_ok")
            this.emit_terminator("br i1 " + is_zero + ", label %" + lbl_err + ", label %" + lbl_ok)
            this.start_block(lbl_err)
            this.emit_indent("call i64 @__division_error()")
            this.emit_terminator("unreachable")
            this.start_block(lbl_ok)
        }
        var op_result: String = this.fresh_local()
        this.last_type = AST.Type.IntType

        if (op == "-") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("sub", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for sub
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.sub(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = sub i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "*") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("mul", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for mul
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.mul(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = mul i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "/") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("sdiv", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for sdiv
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.sdiv(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = sdiv i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "%") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("srem", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for srem
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.srem(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = srem i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "&") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("and", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = and i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "|") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("or", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = or i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "^") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("xor", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = xor i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "<<") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("shl", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = shl i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == ">>") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("ashr", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = ashr i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=") {
            this.last_type = AST.Type.BoolType
            var cmp_local: String = this.fresh_local()
            var __ord_helper: String = this.ordering_helper(op)
            var __ord_static: Bool = this.is_ordered_primitive(left_type2) and this.is_ordered_primitive(right_type2)
            if (__ord_helper.length() > 0 and (left_type2 == "String" or right_type2 == "String")) {
                var strcmp_result: String = this.fresh_local()
                this.emit_indent(strcmp_result + " = call i64 @__safe_strcmp(i64 " + lhs + ", i64 " + rhs + ")")
                if (op == "<") { this.emit_indent(cmp_local + " = icmp slt i64 " + strcmp_result + ", 0") }
                else if (op == "<=") { this.emit_indent(cmp_local + " = icmp sle i64 " + strcmp_result + ", 0") }
                else if (op == ">") { this.emit_indent(cmp_local + " = icmp sgt i64 " + strcmp_result + ", 0") }
                else { this.emit_indent(cmp_local + " = icmp sge i64 " + strcmp_result + ", 0") }
            }
            // Ordering with at least one operand whose static type does not pin
            // down its representation. This is the #104 arm, and it must sit
            // ABOVE the Float and integer arms: those untag both sides as a
            // number, so reaching them with a TAG_PTR operand compares the bit
            // patterns of two heap pointers. The comparison then depended on heap
            // layout, which is how the same program answered differently at -O0
            // and -O2 while `run_tests.sh` (which builds -O2) stayed green.
            //
            // `Any` is not a rare annotation to sprinkle a special case on: it is
            // what every generic container's elements are, so `_bisect(value: Any)`
            // in sorted_set.sf, heap.sf's default comparators and test.sf's
            // assert_lt all landed here. The dispatch is deferred to __val_cmp,
            // which reads the tags of both operands (BUGS #104).
            //
            // Numeric comparison does NOT regress into a call: when both static
            // types are Int/Number/Float, __ord_static is true and control falls
            // through to the fcmp/icmp arms below exactly as before.
            else if (__ord_helper.length() > 0 and !__ord_static) {
                // Registering the call is what emits `declare i64 @__val_lt(i64,
                // i64)`: output_body's trailing loop declares every
                // called_function that this module does not itself define. That
                // keeps the four helpers out of runtime_declares(), which matters
                // because runtime.sf *defines* them — a declare there would
                // collide with the definition.
                this.called_functions.push(__ord_helper)
                this.called_function_arity.set(__ord_helper, 2)
                var ord_raw: String = this.fresh_local()
                this.emit_indent(ord_raw + " = call i64 @" + __ord_helper + "(i64 " + lhs + ", i64 " + rhs + ")")
                this.emit_indent(cmp_local + " = icmp ne i64 " + ord_raw + ", 0")
            } else if (left_type2 == "Float" or right_type2 == "Float") {
                var cld: String = this.emit_untag_float(lhs)
                var crd: String = this.emit_untag_float(rhs)
                if (op == "==") { this.emit_indent(cmp_local + " = fcmp oeq double " + cld + ", " + crd) }
                else if (op == "!=") { this.emit_indent(cmp_local + " = fcmp one double " + cld + ", " + crd) }
                else if (op == "<") { this.emit_indent(cmp_local + " = fcmp olt double " + cld + ", " + crd) }
                else if (op == "<=") { this.emit_indent(cmp_local + " = fcmp ole double " + cld + ", " + crd) }
                else if (op == ">") { this.emit_indent(cmp_local + " = fcmp ogt double " + cld + ", " + crd) }
                else if (op == ">=") { this.emit_indent(cmp_local + " = fcmp oge double " + cld + ", " + crd) }
            } else if (op == "==") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("eq", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_eq value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_eq(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp eq i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == "!=") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("ne", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_ne value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_ne(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp ne i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == "<") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("slt", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_slt value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_slt(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp slt i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == "<=") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("sle", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_sle value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_sle(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp sle i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == ">") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("sgt", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_sgt value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_sgt(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp sgt i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == ">=") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("sge", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_sge value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_sge(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp sge i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_zext_op(op_result, cmp_local))
                // LLVM lib parallel path: track zext value
                if (!this.identity_mode and this.llvm_values.has(cmp_local)) {
                    var cmp_v: Any = this.llvm_values.get(cmp_local)
                    var ext_v: Any = this.llvm_block_builder.zext(cmp_v, LLVMTypes.Type.I64)
                    this.llvm_values.set(op_result, ext_v)
                }
            } else {
                this.emit_indent(op_result + " = zext i1 " + cmp_local + " to i64")
            }
        }

        // Tag the result: int for arithmetic/bitwise, bool for comparisons
        var local: String = op_result
        if (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=") {
            local = this.emit_tag_bool(op_result)
        } else {
            local = this.emit_tag_int(op_result)
        }
        return local
    }

    fun gen_string_concat(left: AST.Expr, right: AST.Expr): String {
        // Flatten string concat at compile time
        var combined: String = this.flatten_string_expr(left) + this.flatten_string_expr(right)
        var const_name: String = this.add_string_constant(combined)
        var gep: String = this.fresh_local()
        var len: Float = combined.length() + 1
        this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
        var local: String = this.emit_tag_ptr(gep)
        return local
    }

    fun flatten_string_expr(expr: AST.Expr): String {
        return match (expr) {
            StringLit(s) => s
            Binary(l, o, r) => this.flatten_string_expr(l) + this.flatten_string_expr(r)
            // Every caller guards with is_string_expr, which admits only those
            // two shapes, so this arm is unreachable. It still has to be written:
            // a missing arm yields an indeterminate value rather than a
            // diagnostic (BUGS #76), so a future caller that forgot the guard
            // would silently emit a garbage string constant instead of "".
            _ => ""
        }
    }

    fun gen_func_ref(fn_name: String): String {
        this.last_type = AST.Type.IntType
        var nparams: Float = 0
        if (this.func_param_count.has(fn_name)) {
            nparams = this.func_param_count.get(fn_name)
        }

        // Check if this function has captures (nested function with free variables).
        // If so, we must build a closure that packs the captured variable addresses
        // into an environment, and generate a trampoline that unpacks them.
        var has_captures: Bool = this.called_function_arity.has("__captures_" + fn_name)
        var cap_names: List<String> = []
        if (has_captures) {
            var caps_str: String = this.func_prefix_map.get("__caps_" + fn_name)
            if (caps_str.length() > 0) {
                cap_names = caps_str.split(",")
            } else {
                has_captures = false
            }
        }

        if (has_captures and cap_names.length() > 0) {
            // --- Nested function with captures: build a proper closure ---
            // The real function signature is: (cap0_ptr, cap1_ptr, ..., user_arg0, ...)
            // We create:
            //   1. An environment array holding the capture pointer values
            //   2. A trampoline that takes (env, user_args...), unpacks captures from
            //      env, and calls the real function with (caps..., user_args...)

            var num_caps: Float = cap_names.length()

            // Allocate environment: array of i64, one slot per capture
            var env_bytes: Float = num_caps * 8
            var env_raw: String = this.fresh_local()
            this.emit_indent(env_raw + " = call i8* @__sf_malloc(i64 " + env_bytes.floor().to_string() + ")")
            var env_ptr: String = this.fresh_local()
            this.emit_indent(env_ptr + " = bitcast i8* " + env_raw + " to [" + num_caps.floor().to_string() + " x i64]*")

            // Store capture pointer values into the environment
            var ci: Float = 0
            while (ci < num_caps) {
                var cap_val: String = this.typed_ptr_to_val("%" + this.sanitize_name(cap_names[ci]), "i64*")
                var slot: String = this.fresh_local()
                this.emit_indent(slot + " = getelementptr [" + num_caps.floor().to_string() + " x i64], [" + num_caps.floor().to_string() + " x i64]* " + env_ptr + ", i64 0, i64 " + ci.floor().to_string())
                this.emit_indent("store i64 " + cap_val + ", i64* " + slot)
                ci = ci + 1
            }

            // Generate trampoline: takes (i64 env, user_args...) and calls real function
            this.label_counter = this.label_counter + 1
            var wrap_name: String = "__wrap_" + this.label_counter.floor().to_string() + "_" + this.sanitize_name(fn_name)

            var wrap_params: List<String> = []
            wrap_params.push("i64 %__env.arg")
            var pi: Float = 0
            while (pi < nparams) {
                wrap_params.push("i64 %__a" + pi.floor().to_string() + ".arg")
                pi = pi + 1
            }

            var wrap_linkage: String = "define linkonce_odr"
            if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
                wrap_linkage = "define"
            }

            // Trampoline body: unpack captures from env, then call real function
            var wrap_ir: String = "\n" + wrap_linkage + " i64 @" + wrap_name + "(" + wrap_params.join(", ") + ") {\nentry:\n"

            // Cast env to typed array pointer
            if (this.target == "wasm32") {
                wrap_ir = wrap_ir + "  %__env_i32 = trunc i64 %__env.arg to i32\n"
                wrap_ir = wrap_ir + "  %__env_ptr = inttoptr i32 %__env_i32 to [" + num_caps.floor().to_string() + " x i64]*\n"
            } else {
                wrap_ir = wrap_ir + "  %__env_ptr = inttoptr i64 %__env.arg to [" + num_caps.floor().to_string() + " x i64]*\n"
            }

            // Extract each capture from env
            var fwd_args: List<String> = []
            ci = 0
            while (ci < num_caps) {
                var slot_name: String = "%__cap_slot_" + ci.floor().to_string()
                var val_name: String = "%__cap_" + ci.floor().to_string()
                wrap_ir = wrap_ir + "  " + slot_name + " = getelementptr [" + num_caps.floor().to_string() + " x i64], [" + num_caps.floor().to_string() + " x i64]* %__env_ptr, i64 0, i64 " + ci.floor().to_string() + "\n"
                wrap_ir = wrap_ir + "  " + val_name + " = load i64, i64* " + slot_name + "\n"
                fwd_args.push("i64 " + val_name)
                ci = ci + 1
            }

            // Add user args
            pi = 0
            while (pi < nparams) {
                fwd_args.push("i64 %__a" + pi.floor().to_string() + ".arg")
                pi = pi + 1
            }

            // Call the real function
            wrap_ir = wrap_ir + "  %r = call i64 @" + fn_name + "(" + fwd_args.join(", ") + ")\n"
            wrap_ir = wrap_ir + "  ret i64 %r\n}\n"
            this.globals.push(wrap_ir)

            // Build closure pair [trampoline_fn_ptr, env_ptr]
            var num_total_params: Float = nparams + 1
            var fn_type_str: String = "i64 ("
            var tti: Float = 0
            while (tti < num_total_params) {
                if (tti > 0) { fn_type_str = fn_type_str + ", " }
                fn_type_str = fn_type_str + "i64"
                tti = tti + 1
            }
            fn_type_str = fn_type_str + ")*"

            var closure_raw: String = this.fresh_local()
            this.emit_indent(closure_raw + " = call i8* @__sf_malloc(i64 16)")
            var closure_ptr: String = this.fresh_local()
            this.emit_indent(closure_ptr + " = bitcast i8* " + closure_raw + " to [2 x i64]*")
            var fn_as_int: String = this.fn_ptr_to_val(fn_type_str, "@" + wrap_name)
            var fn_slot: String = this.fresh_local()
            this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
            var env_as_int: String = this.typed_ptr_to_val(env_ptr, "[" + num_caps.floor().to_string() + " x i64]*")
            var env_slot: String = this.fresh_local()
            this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
            this.emit_indent("store i64 " + env_as_int + ", i64* " + env_slot)
            var result: String = this.typed_ptr_to_val(closure_ptr, "[2 x i64]*")
            return result
        }

        // --- No captures: plain function reference ---
        // Generate a trampoline wrapper that accepts (i64 env, <original params>)
        // and forwards to the real function (dropping env). This ensures the closure
        // calling convention (env first) works for plain function references.
        this.label_counter = this.label_counter + 1
        var wrap_name: String = "__wrap_" + this.label_counter.floor().to_string() + "_" + this.sanitize_name(fn_name)

        // Build trampoline param list: env + original params
        var wrap_params: List<String> = []
        wrap_params.push("i64 %__env.arg")
        var fwd_args: List<String> = []
        var pi: Float = 0
        while (pi < nparams) {
            var pname: String = "%__a" + pi.floor().to_string() + ".arg"
            wrap_params.push("i64 " + pname)
            fwd_args.push("i64 " + pname)
            pi = pi + 1
        }

        // Build the trampoline function IR
        // On WASM targets, use plain define to avoid function table index mismatch
        var wrap_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            wrap_linkage = "define"
        }
        var wrap_ir: String = "\n" + wrap_linkage + " i64 @" + wrap_name + "(" + wrap_params.join(", ") + ") {\nentry:\n"
        if (nparams == 0) {
            wrap_ir = wrap_ir + "  %r = call i64 @" + fn_name + "()\n"
        } else {
            wrap_ir = wrap_ir + "  %r = call i64 @" + fn_name + "(" + fwd_args.join(", ") + ")\n"
        }
        wrap_ir = wrap_ir + "  ret i64 %r\n}\n"
        this.globals.push(wrap_ir)

        // Build closure pair [trampoline_fn_ptr, 0] on the heap
        var num_total_params: Float = nparams + 1
        var fn_type_str: String = "i64 ("
        var tti: Float = 0
        while (tti < num_total_params) {
            if (tti > 0) { fn_type_str = fn_type_str + ", " }
            fn_type_str = fn_type_str + "i64"
            tti = tti + 1
        }
        fn_type_str = fn_type_str + ")*"

        var closure_raw: String = this.fresh_local()
        this.emit_indent(closure_raw + " = call i8* @__sf_malloc(i64 16)")
        var closure_ptr: String = this.fresh_local()
        this.emit_indent(closure_ptr + " = bitcast i8* " + closure_raw + " to [2 x i64]*")
        var fn_as_int: String = this.fn_ptr_to_val(fn_type_str, "@" + wrap_name)
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        this.emit_indent("store i64 0, i64* " + env_slot)
        var result: String = this.typed_ptr_to_val(closure_ptr, "[2 x i64]*")
        return result
    }

    fun gen_arg_value(expr: AST.Expr): String {
        // Handle function references as values (e.g. passing HomePage to Router.Route)
        var expr_kind: String = this.classify_expr(expr)
        if (expr_kind == "variable") {
            var __vn: String = match (expr) { Variable(n) => n
                Ref(rk, rn, rs) => rn
                _ => ""
            }
            // Nested-`fun` binding in this body wins over a like-named module
            // global. Same rule as the Variable arm of gen_expr; this is the copy
            // that `return cl` and `f(cl)` go through, and it was the one actually
            // producing the null closure in BUGS #80.
            if (this.current_fn_locals.has("__nestedfn:" + __vn) and !this.typed_vars.has(__vn) and !this.named_imports.has(__vn)) {
                if (this.str_in_list(this.known_functions,this.current_prefix + __vn)) {
                    return this.gen_func_ref(this.current_prefix + __vn)
                }
                if (this.str_in_list(this.known_functions,__vn)) {
                    return this.gen_func_ref(__vn)
                }
            }
            if (this.str_in_list(this.known_functions,__vn)) {
                if (!this.typed_vars.has(__vn)) {
                    if (!this.module_globals.has(this.current_prefix + __vn)) {
                        if (!this.named_imports.has(__vn)) {
                            return this.gen_func_ref(__vn)
                        }
                    }
                }
            }
            if (this.str_in_list(this.known_functions,this.current_prefix + __vn)) {
                if (!this.typed_vars.has(__vn)) {
                    if (!this.module_globals.has(this.current_prefix + __vn)) {
                        if (!this.named_imports.has(__vn)) {
                            return this.gen_func_ref(this.current_prefix + __vn)
                        }
                    }
                }
            }
        }
        if (expr_kind == "method_call") {
            var mc_obj: AST.Expr = match (expr) { MethodCall(o, m, a) => o
                _ => AST.Expr.NilLit
            }
            var mc_method: String = match (expr) { MethodCall(o, m, a) => m
                _ => ""
            }
            var mc_args: List<AST.Expr> = match (expr) { MethodCall(o, m, a) => a
                _ => []
            }
            return this.gen_method_call(mc_obj, mc_method, mc_args)
        }
        if (expr_kind == "list_lit") {
            var elems: List<AST.Expr> = match (expr) { ListLit(e) => e
                _ => []
            }
            return this.gen_list_lit(elems)
        }
        if (expr_kind == "tuple_lit") {
            var elems: List<AST.Expr> = match (expr) { TupleLit(e) => e
                _ => []
            }
            var result: String = this.gen_list_lit(elems)
            var tuple_type_str: String = "Tuple<"
            var tti: Float = 0
            while (tti < elems.length()) {
                if (tti > 0) { tuple_type_str = tuple_type_str + "," }
                var elem_type: String = this.get_expr_type(elems[tti])
                tuple_type_str = tuple_type_str + elem_type
                tti = tti + 1
            }
            tuple_type_str = tuple_type_str + ">"
            this.last_type = this.str_to_type(tuple_type_str)
            return result
        }
        if (expr_kind == "index_get") {
            var ig_obj: AST.Expr = match (expr) { IndexGet(o, i) => o
                _ => AST.Expr.NilLit
            }
            var ig_idx: AST.Expr = match (expr) { IndexGet(o, i) => i
                _ => AST.Expr.NilLit
            }
            return this.gen_index_get(ig_obj, ig_idx)
        }
        if (expr_kind == "map_lit") {
            this.last_type = this.make_map_type()
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__map_new()")
            return local
        }
        if (expr_kind == "match_expr") {
            // Fall through to gen_expr which handles Match(subject, arms) directly
            return this.gen_expr(expr)
        }
        if (expr_kind == "if_expr") {
            return this.gen_expr(expr)
        }
        if (expr_kind == "try_expr") {
            return this.gen_expr(expr)
        }
        if (expr_kind == "block_expr") {
            var be_stmts: List<AST.Stmt> = match (expr) { BlockExpr(s, v) => s
                _ => []
            }
            var be_value: AST.Expr = match (expr) { BlockExpr(s, v) => v
                _ => AST.Expr.NilLit
            }
            this.gen_stmts(be_stmts)
            return this.gen_arg_value(be_value)
        }
        if (expr_kind == "get_field") {
            var gf_obj: AST.Expr = match (expr) { GetField(o, f) => o
                _ => AST.Expr.NilLit
            }
            var gf_field: String = match (expr) { GetField(o, f) => f
                _ => ""
            }
            return this.gen_get_field(gf_obj, gf_field)
        }
        if (expr_kind == "this") {
            this.last_type = this.str_to_type(this.current_class)
            var local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_load(local, "i64", "%self"))
            } else {
                this.emit_indent(local + " = load i64, i64* %self")
            }
            return local
        }
        if (expr_kind == "set_field") {
            var sf_obj: AST.Expr = match (expr) { SetField(o, f, v) => o
                _ => AST.Expr.NilLit
            }
            var sf_field: String = match (expr) { SetField(o, f, v) => f
                _ => ""
            }
            var sf_val: AST.Expr = match (expr) { SetField(o, f, v) => v
                _ => AST.Expr.NilLit
            }
            // The LIVE write site — this is the copy every spelling of
            // `Alias.member = value` reaches (BUGS #122). See the `SetField` arm
            // of `gen_expr` for the dead twin and how that was established.
            if (this.report_missing_module_write(sf_obj, sf_field)) {
                return "0"
            }
            return this.gen_set_field(sf_obj, sf_field, sf_val)
        }
        if (expr_kind == "binary") {
            var b_left: AST.Expr = match (expr) { Binary(l, o, r) => l
                _ => AST.Expr.NilLit
            }
            var b_op: String = match (expr) { Binary(l, o, r) => o
                _ => ""
            }
            var b_right: AST.Expr = match (expr) { Binary(l, o, r) => r
                _ => AST.Expr.NilLit
            }
            return this.gen_binary(b_left, b_op, b_right)
        }
        if (expr_kind == "variable") {
            // A resolved Ref already knows local-vs-global, so take it at its
            // word instead of re-deriving from module_globals below. That
            // re-derivation tests the global branch first, so a module global
            // beat a like-named parameter and the parameter became unreachable
            // — BUGS #40, whose repro is `var x` in the main program silently
            // capturing math.sf's `sqrt(x)` parameter.
            var ref_kind: String = match (expr) { Ref(rk, rn, rs) => rk
                _ => ""
            }
            if (ref_kind == "local" or ref_kind == "param") {
                var pname: String = match (expr) { Ref(rk, rn, rs) => rn
                    _ => ""
                }
                if (this.typed_vars.has(pname)) {
                    this.last_type = this.typed_vars.get(pname)
                } else {
                    this.last_type = AST.Type.IntType
                }
                var plocal: String = this.fresh_local()
                var pref: String = "%" + this.sanitize_name(pname)
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_load(plocal, "i64", pref))
                    if (!this.identity_mode and this.llvm_values.has(pref)) {
                        this.llvm_values.set(plocal, this.llvm_values.get(pref))
                    }
                } else {
                    this.emit_indent(plocal + " = load i64, i64* " + pref)
                    this.verify_load(plocal, "i64", pref)
                }
                return plocal
            }
            var vname: String = match (expr) { Variable(n) => n
                Ref(rk, rn, rs) => rn
                _ => ""
            }
            if (this.typed_vars.has(vname)) {
                this.last_type = this.typed_vars.get(vname)
            } else if (this.global_var_types.has(vname)) {
                this.last_type = this.str_to_type(this.global_var_types.get(vname))
            } else if (this.current_prefix.length() > 0 and this.global_var_types.has(this.current_prefix + vname)) {
                this.last_type = this.str_to_type(this.global_var_types.get(this.current_prefix + vname))
            } else {
                this.last_type = AST.Type.IntType
            }
            // Undefined variable check. Kept as an error (BUGS #37): the load
            // emitted below references %name, which llc rejects anyway, so a
            // warning only delays the same failure into an opaque IR error.
            if (!this.typed_vars.has(vname) and !this.module_globals.has(this.current_prefix + vname) and !this.module_globals.has(vname) and !this.str_in_list(this.known_functions,vname) and !this.str_in_list(this.known_functions,this.current_prefix + vname) and vname != "self" and vname != "this" and vname != "super" and vname != "IO" and vname != "OS" and vname != "GC" and vname != "Task" and !this.module_prefixes.has(vname) and !this.enum_defs.has(vname) and !this.class_fields.has(vname)) {
                IO.println("[codegen] Error: undefined variable '" + vname + "'")
                this.has_errors = true
            }
            var local: String = this.fresh_local()
            var var_ref: String = "%" + this.sanitize_name(vname)
            // Same as the Variable arm at :128 — `super` is the receiver
            // pointer, whose alloca is `%self`; there is no `%super` slot, so
            // the load below produced invalid IR (BUGS #70). This copy of the
            // variable-load path is the one arguments take.
            if (vname == "super") {
                var_ref = "%self"
            }
            if (this.module_globals.has(this.current_prefix + vname)) {
                var_ref = "@__g_" + this.current_prefix + this.sanitize_name(vname)
            } else if (this.module_globals.has(vname)) {
                var_ref = "@__g_" + this.sanitize_name(vname)
            }
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_load(local, "i64", var_ref))
                // LLVM lib parallel path: propagate stored Value for this variable
                if (!this.identity_mode and this.llvm_values.has(var_ref)) {
                    this.llvm_values.set(local, this.llvm_values.get(var_ref))
                }
            } else {
                this.emit_indent(local + " = load i64, i64* " + var_ref)
                this.verify_load(local, "i64", var_ref)
            }
            return local
        }
        if (expr_kind == "member") {
            var m_obj: Any = match (expr) { MemberAccess(o, f) => o
                _ => ""
            }
            var m_field: String = match (expr) { MemberAccess(o, f) => f
                _ => ""
            }
            // Check if object is This → field access
            var obj_kind: String = this.classify_expr(m_obj)
            if (obj_kind == "this") {
                return this.gen_get_field(m_obj, m_field)
            }
            // Tuple field access: t._0, t._1, etc.
            var mn: String = this.get_variable_name(m_obj)
            if (mn.length() > 0 and m_field.starts_with("_") and m_field.length() >= 2) {
                var tf_vtype2: String = this.get_var_type_str(mn)
                if (tf_vtype2.starts_with("Tuple<")) {
                    var tf_rest2: String = m_field.slice(1, m_field.length())
                    var tf_idx2: Float = tf_rest2.to_number()
                    var tf_obj2: String = this.gen_arg_value(m_obj)
                    var tf_idx_val2: String = this.fresh_local()
                    this.emit_indent(tf_idx_val2 + " = add i64 0, " + tf_idx2.floor().to_string())
                    var tf_result2: String = this.fresh_local()
                    this.emit_indent(tf_result2 + " = call i64 @__list_get(i64 " + tf_obj2 + ", i64 " + tf_idx_val2 + ")")
                    var tf_inner2: String = tf_vtype2.slice(6, tf_vtype2.length() - 1)
                    var tf_args2: List<String> = this.split_type_args(tf_inner2)
                    if (tf_idx2 >= 0 and tf_idx2 < tf_args2.length()) {
                        this.last_type = this.str_to_type(tf_args2[tf_idx2])
                    } else {
                        this.last_type = AST.Type.AnyType
                    }
                    return tf_result2
                }
            }
            // Handle as field access on class instance or enum
            var vt: String = ""
            if (mn.length() > 0) {
                vt = this.get_var_type_str(mn)
            }
            var vt_resolved: String = this.resolve_class_type(vt)
            if (vt_resolved.length() > 0) {
                    var ov: String = this.gen_arg_value(m_obj)
                    var fi: Float = this.get_field_index(vt_resolved, m_field)
                    var op: String = this.val_to_typed_ptr(ov, "%" + vt_resolved + "*")
                    var fp: String = this.fresh_local()
                    this.emit_indent(fp + " = getelementptr %" + vt_resolved + ", %" + vt_resolved + "* " + op + ", i32 0, i32 " + fi.floor().to_string())
                    var result: String = this.fresh_local()
                    this.emit_indent(result + " = load volatile i64, i64* " + fp)
                    // The declared type may name a class type parameter; the
                    // receiver's own annotation (`vt`, arguments intact) binds it.
                    var vt_ft: String = this.get_field_type(vt_resolved, m_field)
                    this.last_type = this.str_to_type(this.substitute_class_type_params(vt_ft, vt))
                    return result
            }
            if (mn.length() > 0 and this.enum_variant_tags.has(mn + "." + m_field)) {
                return this.gen_enum_construct(mn, m_field, [])
            }
            // Package namespace: check named_imports for "Alias.field" first
            if (mn.length() > 0 and this.named_imports.has(mn + "." + m_field)) {
                var pe_ref2: String = this.named_imports.get(mn + "." + m_field)
                if (this.str_in_list(this.known_functions, pe_ref2)) {
                    return this.gen_func_ref(pe_ref2)
                }
            }
            // Module-prefixed function reference: e.g. Routes.list_packages used as value
            if (mn.length() > 0 and this.module_prefixes.has(mn)) {
                var mp_resolved: String = this.module_prefixes.get(mn) + m_field
                if (this.str_in_list(this.known_functions, mp_resolved)) {
                    return this.gen_func_ref(mp_resolved)
                }
                // Module-prefixed global variable: e.g. Cache.store
                if (this.module_globals.has(mp_resolved)) {
                    var mg_local: String = this.fresh_local()
                    var mg_ref: String = "@__g_" + this.sanitize_name(mp_resolved)
                    this.emit_indent(mg_local + " = load i64, i64* " + mg_ref)
                    // Publish the type so a method call on this receiver dispatches
                    // (see the matching comment in the MemberAccess handler above).
                    if (this.global_var_types.has(mp_resolved)) {
                        this.last_type = this.str_to_type(this.global_var_types.get(mp_resolved))
                    }
                    return mg_local
                }
                // Neither a function nor a global under this module's prefix.
                // `mn` is known to be a module alias here, so "not found" is
                // expressible at this point and nowhere downstream — which is
                // exactly why the diagnostic belongs here.
                //
                // Falling through instead reached the generic receiver fallback
                // below, which evaluates the *object* — the bare alias `Math` —
                // as if it were a local, emitting `load i64, i64* %Math` from an
                // SSA name that was never defined. The compile exited 0 and the
                // failure surfaced as "the compiler emitted invalid LLVM IR /
                // this is a compiler bug, not an error in your program" for what
                // is a plain typo in the user's source (BUGS #118).
                //
                // The undefined-variable check at the Variable arm above cannot
                // catch it: that check deliberately exempts module_prefixes,
                // because for a *valid* member access the bare alias really is
                // not a variable. So this is the only honest place to report.
                //
                // Eighth instance of one family (#22, #40, #78, #37, #103, #113,
                // #114): a resolver with no way to express "not found" guesses
                // instead of reporting absence.
                //
                // Measured before making the miss fatal: a probe compiler logged
                // every arrival here across 336 files (test/, test/pass/,
                // test/fail/, src/lib/, src/compiler/, examples/, turmeric/,
                // basil/, bazaar/, parsley/, pantry/). Exactly three arrivals,
                // and `opt` rejects the IR for all three — no valid spelling
                // depends on the fall-through. Enum variants, enum/class/actor
                // constructors, @inline functions, named imports, forward
                // references and locals shadowing an alias all resolve before
                // reaching here and were each confirmed unaffected.
                IO.println("[codegen] Error: no member '" + m_field + "' in module '" + mn + "'")
                this.has_errors = true
                return "0"
            }
            // Module-qualified zero-arg enum: AST.Expr.This → try Expr.This
            if (mn.length() == 0) {
                var obj_kind2: String = this.classify_expr(m_obj)
                if (obj_kind2 == "member") {
                    var inner_field: String = match (m_obj) { MemberAccess(o, f) => f
                        _ => ""
                    }
                    var key: String = inner_field + "." + m_field
                    if (this.enum_variant_tags.has(key)) {
                        return this.gen_enum_construct(inner_field, m_field, [])
                    }
                    // Fallback: maybe the inner MemberAccess root is a module alias
                    // e.g. AST.Type.IntType where AST is module, Type is enum, IntType is variant
                    var inner_obj: AST.Expr = match (m_obj) { MemberAccess(o, f) => o
                        _ => AST.Expr.NilLit
                    }
                    var root_name: String = this.get_variable_name(inner_obj)
                    if (root_name.length() > 0 and !this.typed_vars.has(root_name)) {
                        if (this.enum_variant_tags.has(inner_field + "." + m_field)) {
                            return this.gen_enum_construct(inner_field, m_field, [])
                        }
                    }
                }
                // Nested field access: obj.field1.field2
                if (obj_kind2 == "get_field" or obj_kind2 == "member" or obj_kind2 == "this") {
                    var inner_val: String = this.gen_arg_value(m_obj)
                    var inner_type: String = this.type_to_string(this.last_type)
                    if (this.class_fields.has(inner_type)) {
                        // Resolve struct name via class_struct_names for module-prefixed types
                        var inner_struct: String = inner_type
                        if (this.class_struct_names.has(inner_type)) {
                            inner_struct = this.class_struct_names.get(inner_type)
                        }
                        var fi: Float = this.get_field_index(inner_type, m_field)
                        var op: String = this.val_to_typed_ptr(inner_val, "%" + inner_struct + "*")
                        var fp: String = this.fresh_local()
                        this.emit_indent(fp + " = getelementptr %" + inner_struct + ", %" + inner_struct + "* " + op + ", i32 0, i32 " + fi.floor().to_string())
                        var result: String = this.fresh_local()
                        this.emit_indent(result + " = load i64, i64* " + fp)
                        var it_ft: String = this.get_field_type(inner_type, m_field)
                        this.last_type = this.str_to_type(this.substitute_class_type_params(it_ft, inner_type))
                        return result
                    }
                }
            }
            // General fallback: evaluate the object expression (e.g. IndexGet) and use last_type
            var fb_val: String = this.gen_arg_value(m_obj)
            var fb_type_str: String = this.type_to_string(this.last_type)
            var fb_resolved: String = this.resolve_class_type(fb_type_str)
            if (fb_resolved.length() > 0 and this.class_fields.has(fb_resolved)) {
                var fb_struct: String = fb_resolved
                if (this.class_struct_names.has(fb_resolved)) {
                    fb_struct = this.class_struct_names.get(fb_resolved)
                }
                var fi: Float = this.get_field_index(fb_resolved, m_field)
                var op: String = this.val_to_typed_ptr(fb_val, "%" + fb_struct + "*")
                var fp: String = this.fresh_local()
                this.emit_indent(fp + " = getelementptr %" + fb_struct + ", %" + fb_struct + "* " + op + ", i32 0, i32 " + fi.floor().to_string())
                var result: String = this.fresh_local()
                this.emit_indent(result + " = load i64, i64* " + fp)
                var fb_ft: String = this.get_field_type(fb_resolved, m_field)
                this.last_type = this.str_to_type(this.substitute_class_type_params(fb_ft, fb_type_str))
                return result
            }
            // Nothing above could establish a class for the receiver, so the
            // field's offset is unknown — and this path answers with the integer
            // zero, emitting no GEP and no load at all.
            //
            // That is how `f(1).v` read 0 (BUGS #56): `Fun` carries no return
            // type, so an indirect call's result has no recoverable class, and
            // codegen handed back a plausible-looking constant rather than
            // admitting it did not know. The object was constructed correctly
            // the whole time; only this fallback was wrong.
            //
            // Report it — but only for that shape. This same fallback is the
            // normal, working route for several unrelated things (a module
            // constant like `Math.PI`, reflective field reads), which either
            // return 0 here legitimately or get resolved by a later stage.
            // Erroring unconditionally traded one silent wrong answer for a
            // batch of false rejections, so the diagnostic is narrowed to a
            // receiver that really is a call — the case that is genuinely
            // unknowable here rather than merely unresolved.
            //
            // The proper fix is a return type on `Fun`, a language change beyond
            // this repair; M2 in docs/design/compiler-rewrite.md ("unknown is
            // never spelled as something concrete") is why this reports instead
            // of guessing an offset.
            var fb_obj_kind: String = this.classify_expr(m_obj)
            if (fb_obj_kind == "call") {
                IO.println("[codegen] Error: cannot determine the type of the receiver of '." + m_field + "': an indirect call through 'Fun' has no known return type, so the field's offset is unknown. Annotate the result first, e.g. 'var x: T = f(...)' then use 'x." + m_field + "'.")
                this.has_errors = true
            }
            this.last_type = AST.Type.AnyType
            return "0"
        }

        // Handle string literals directly
        if (this.is_string_expr(expr)) {
            this.last_type = AST.Type.StringType
            var str_val: String = this.flatten_string_expr(expr)
            var const_name: String = this.add_string_constant(str_val)
            var gep: String = this.fresh_local()
            var slen: Float = str_val.length() + 1
            this.emit_indent(gep + " = getelementptr [" + slen.to_string() + " x i8], [" + slen.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
            var local: String = this.emit_tag_ptr(gep)
            return local
        }
        return this.gen_expr(expr)
    }

    fun gen_string_ptr(expr: AST.Expr): String {
        if (this.is_string_expr(expr)) {
            // String literal: get pointer directly
            var str_val: String = this.flatten_string_expr(expr)
            var const_name: String = this.add_string_constant(str_val)
            var ptr: String = this.fresh_local()
            var slen: Float = str_val.length() + 1
            this.emit_indent(ptr + " = getelementptr [" + slen.to_string() + " x i8], [" + slen.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
            return ptr
        }
        // Variable or expression: gen_expr gives i64 (possibly tagged), convert to i8*
        var val: String = this.gen_arg_value(expr)
        var ptr: String = this.emit_untag_ptr(val)
        return ptr
    }

    fun gen_runtime_string_concat(left: AST.Expr, right: AST.Expr): String {
        var lptr: String = this.gen_string_ptr(left)
        var rptr: String = this.gen_string_ptr(right)
        // Get lengths
        var llen: String = this.fresh_local()
        this.emit_indent(llen + " = call i64 @strlen(i8* " + lptr + ")")
        var rlen: String = this.fresh_local()
        this.emit_indent(rlen + " = call i64 @strlen(i8* " + rptr + ")")
        // Total = llen + rlen + 1
        var total: String = this.fresh_local()
        this.emit_indent(total + " = add i64 " + llen + ", " + rlen)
        var total1: String = this.fresh_local()
        this.emit_indent(total1 + " = add i64 " + total + ", 1")
        // Malloc
        var buf: String = this.fresh_local()
        this.emit_indent(buf + " = call i8* @__sf_malloc(" + this.malloc_size_type() + " " + this.malloc_size_arg(total1) + ")")
        // strcpy + strcat
        this.emit_indent("call i8* @strcpy(i8* " + buf + ", i8* " + lptr + ")")
        this.emit_indent("call i8* @strcat(i8* " + buf + ", i8* " + rptr + ")")
        // Intern the result for O(1) equality
        var raw_result: String = this.ptr_to_val(buf)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = call i64 @__string_intern(i64 " + raw_result + ")")
        return result
    }

    fun gen_unary(op: String, right: AST.Expr): String {
        var right_type: String = this.get_expr_type(right)
        var rhs: String = this.gen_arg_value(right)

        if (op == "-") {
            if (right_type == "Float") {
                // Float negation: untag as double, fsub from 0.0, retag
                var raw_f: String = this.emit_untag_float(rhs)
                var negated: String = this.fresh_local()
                this.emit_indent(negated + " = fsub double 0.0, " + raw_f)
                var local: String = this.emit_tag_float(negated)
                this.last_type = AST.Type.FloatType
                return local
            }
            // NaN-boxed integer negation: untag → negate → retag
            var raw: String = this.emit_untag_int(rhs)
            var negated: String = this.fresh_local()
            this.emit_indent(negated + " = sub i64 0, " + raw)
            var local: String = this.emit_tag_int(negated)
            this.last_type = AST.Type.IntType
            return local
        }
        if (op == "!") {
            // Logical not: untag bool, flip, retag as bool
            var raw: String = this.emit_untag_bool(rhs)
            var flipped: String = this.fresh_local()
            this.emit_indent(flipped + " = xor i64 " + raw + ", 1")
            var local: String = this.emit_tag_bool(flipped)
            this.last_type = AST.Type.BoolType
            return local
        }
        if (op == "~") {
            // Bitwise not: untag int, flip all bits, retag
            var raw: String = this.emit_untag_int(rhs)
            var flipped: String = this.fresh_local()
            this.emit_indent(flipped + " = xor i64 " + raw + ", -1")
            var local: String = this.emit_tag_int(flipped)
            this.last_type = AST.Type.IntType
            return local
        }

        return rhs
    }

    fun gen_call(callee: AST.Expr, args: List<AST.Expr>): String {
        var callee_name: String = this.resolve_callee(callee)

        // Check if this is an enum constructor
        if (callee_name.contains(".")) {
            var parts: List<String> = callee_name.split(".")
            if (parts.length() >= 2) {
                var key: String = parts[0] + "." + parts[1]
                if (this.enum_variant_tags.has(key)) {
                    return this.gen_enum_construct(parts[0], parts[1], args)
                }
            }
            // Module-qualified enum: AST.Stmt.FunDecl → try Stmt.FunDecl
            if (parts.length() >= 3) {
                var key2: String = parts[1] + "." + parts[2]
                if (this.enum_variant_tags.has(key2)) {
                    return this.gen_enum_construct(parts[1], parts[2], args)
                }
            }
        }

        // Task.spawn(fn) — call the coroutine function to get a handle, enqueue it
        if (callee_name == "Task.spawn") {
            var spawn_arg: String = this.gen_arg_value(args[0])
            var hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_inttoptr(hdl, spawn_arg))
            } else {
                this.emit_indent(hdl + " = inttoptr i64 " + spawn_arg + " to ptr")
                this.verify_inttoptr(hdl, spawn_arg)
            }
            var task_hdl: String = this.fresh_local()
            this.emit_indent(task_hdl + " = call ptr " + hdl + "()")
            var task_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(task_i64, task_hdl))
            } else {
                this.emit_indent(task_i64 + " = ptrtoint ptr " + task_hdl + " to i64")
                this.verify_ptrtoint(task_i64, task_hdl)
            }
            this.emit_indent("call i64 @enqueue(i64 " + task_i64 + ")")
            this.called_functions.push("enqueue")
            this.last_type = AST.Type.IntType
            return task_i64
        }

        // Check if it's a method call on a class instance: obj.method(args)
        if (callee_name.contains(".") and !callee_name.starts_with("IO")) {
            var parts: List<String> = callee_name.split(".")
            if (parts.length() >= 2) {
                var obj_name: String = parts[0]
                var method_name: String = parts[1]
                // Check if any class has this method
                var class_name: String = this.find_class_for_method(method_name)
                if (class_name.length() > 0) {
                    var obj_val: String = this.fresh_local()
                    this.emit_indent(obj_val + " = load i64, i64* %" + this.sanitize_name(obj_name))
                    var arg_strs: List<String> = []
                    arg_strs.push("i64 " + obj_val)
                    var ai: Float = 0
                    while (ai < args.length()) {
                        var val: String = this.gen_arg_value(args[ai])
                        arg_strs.push("i64 " + val)
                        ai = ai + 1
                    }
                    var full_method: String = class_name + "__" + method_name
                    if (this.func_prefix_map.has(full_method)) {
                        full_method = this.func_prefix_map.get(full_method)
                    } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions,this.current_prefix + full_method)) {
                        full_method = this.current_prefix + full_method
                    }
                    this.called_functions.push(full_method)
                    var local: String = this.fresh_local()
                    this.emit_indent(local + " = call i64 @" + full_method + "(" + arg_strs.join(", ") + ")")
                    if (this.func_ret_types.has(full_method)) {
                        this.last_type = this.func_ret_types.get(full_method)
                    } else {
                        this.last_type = AST.Type.IntType
                    }
                    return local
                }
            }
        }

        if (callee_name == "IO.println") {
            var arg: String = this.gen_arg_value(args[0])
            var arg_type: String = this.type_to_string(this.last_type)
            if (this.identity_mode and arg_type == "String") {
                // Identity mode: strings are raw pointers, use __io_println_str directly
                this.emit_indent("call void @__io_println_str(i64 " + arg + ")")
            } else {
                // Runtime dispatch: pass tagged value directly to __io_println_any
                this.emit_indent("call void @__io_println_any(i64 " + arg + ")")
            }
            this.last_type = AST.Type.NilType
            var nil_val: String = this.fresh_local()
            this.emit_indent(nil_val + " = call i64 @__val_nil()")
            return nil_val
        }
        if (callee_name == "IO.print") {
            var arg: String = this.gen_arg_value(args[0])
            var arg_type: String = this.type_to_string(this.last_type)
            if (this.identity_mode and arg_type == "String") {
                // Identity mode: strings are raw pointers, use __io_print_str directly
                this.emit_indent("call void @__io_print_str(i64 " + arg + ")")
            } else {
                // Runtime dispatch: __io_print_any handles all NaN-boxed types
                this.emit_indent("call void @__io_print_any(i64 " + arg + ")")
            }
            this.last_type = AST.Type.NilType
            var nil_val: String = this.fresh_local()
            this.emit_indent(nil_val + " = call i64 @__val_nil()")
            return nil_val
        }

        // Task.spawn(fn) — call the coroutine function to get a handle, enqueue it
        if (callee_name == "Task.spawn") {
            // The argument is a lambda or function reference that is a coroutine
            var spawn_arg: String = this.gen_arg_value(args[0])
            // The lambda was compiled as a coroutine returning ptr.
            // Call it to get the handle, then enqueue to scheduler.
            // For now: the lambda is an indirect call via function pointer.
            // The spawned function returns a ptr handle immediately (at first suspend).
            var hdl: String = this.fresh_local()
            this.emit_indent(hdl + " = inttoptr i64 " + spawn_arg + " to ptr")
            var task_hdl: String = this.fresh_local()
            this.emit_indent(task_hdl + " = call ptr " + hdl + "()")
            // Enqueue to scheduler (convert ptr to i64 for scheduler's List<Int>)
            var task_i64: String = this.fresh_local()
            this.emit_indent(task_i64 + " = ptrtoint ptr " + task_hdl + " to i64")
            this.emit_indent("call i64 @enqueue(i64 " + task_i64 + ")")
            this.called_functions.push("enqueue")
            this.last_type = AST.Type.IntType
            return task_i64
        }

        // Check if it's a known direct function or an indirect call through a variable
        // Check for same-name enum variant: Token(kind, line, col) where enum Token { Token(...) }
        if (this.enum_defs.has(callee_name)) {
            var variants: List = this.enum_defs.get(callee_name)
            if (variants.contains(callee_name)) {
                return this.gen_enum_construct(callee_name, callee_name, args)
            }
        }

        var resolved_callee: String = callee_name
        // Named imports take highest priority: explicit user directive
        if (this.named_imports.has(callee_name)) {
            var ni_target: String = this.named_imports.get(callee_name)
            if (this.str_in_list(this.known_functions,ni_target)) {
                resolved_callee = ni_target
            } else {
                // Trust the named import even if target not yet in known_functions
                resolved_callee = ni_target
            }
        } else if (this.current_prefix.length() > 0) {
            if (this.str_in_list(this.known_functions,this.current_prefix + callee_name)) {
                resolved_callee = this.current_prefix + callee_name
            }
        }
        // Resolve module-qualified names (e.g. "Async.gather" → "stdlib_async_gather")
        // before intrinsic/extern/coroutine checks
        if (resolved_callee.contains(".")) {
            // Package namespace: check named_imports for dotted key first
            if (this.named_imports.has(resolved_callee)) {
                resolved_callee = this.named_imports.get(resolved_callee)
            } else {
                var dot_parts: List<String> = resolved_callee.split(".")
                if (dot_parts.length() >= 2 and this.module_prefixes.has(dot_parts[0])) {
                    resolved_callee = this.module_prefixes.get(dot_parts[0]) + dot_parts[1]
                } else if (this.func_prefix_map.has(resolved_callee)) {
                    resolved_callee = this.func_prefix_map.get(resolved_callee)
                }
            }
        }
        if (this.str_in_list(this.intrinsic_funcs,resolved_callee)) {
            return this.gen_intrinsic_call(resolved_callee, args)
        }
        if (this.extern_sigs.has(resolved_callee)) {
            return this.gen_extern_call(resolved_callee, args)
        }

        // Coroutine-calls-coroutine: emit await forwarding pattern
        if (this.is_coroutine) {
            var is_coro_callee: Bool = this.str_in_list(this.coroutine_funcs,resolved_callee)
            if (!is_coro_callee and this.str_in_list(this.coroutine_funcs,this.current_prefix + resolved_callee)) {
                is_coro_callee = true
                resolved_callee = this.current_prefix + resolved_callee
            }
            if (is_coro_callee) {
                this.called_functions.push(resolved_callee)
                // Generate arguments
                var coro_arg_strs: List<String> = []
                var cai: Float = 0
                while (cai < args.length()) {
                    var val: String = this.gen_arg_value(args[cai])
                    coro_arg_strs.push("i64 " + val)
                    cai = cai + 1
                }
                // Call the coroutine — returns a handle (ptr)
                var b_hdl: String = this.fresh_local()
                this.emit_indent(b_hdl + " = call ptr @" + resolved_callee + "(" + coro_arg_strs.join(", ") + ")")

                // Await loop: resume child until done, yielding ourselves each iteration
                var await_loop: String = this.fresh_label("await.loop")
                var await_yield: String = this.fresh_label("await.yield")
                var await_cleanup: String = this.fresh_label("await.cleanup")
                var await_done: String = this.fresh_label("await.done")

                // Await pattern using opaque calls (defeats CoroElide):
                // check done → yield → resume child → loop
                // Use __sched_coro_* functions (opaque to LLVM) instead of intrinsics
                var b_hdl_i64: String = this.fresh_local()
                this.emit_indent(b_hdl_i64 + " = ptrtoint ptr " + b_hdl + " to i64")
                var await_check: String = this.fresh_label("await.check")
                this.emit_terminator("br label %" + await_check)

                this.start_block(await_check)
                var b_done: String = this.fresh_local()
                this.emit_indent(b_done + " = call i64 @__sched_coro_done(i64 " + b_hdl_i64 + ")")
                var b_done_cmp: String = this.fresh_local()
                this.emit_indent(b_done_cmp + " = icmp eq i64 " + b_done + ", 1")
                this.emit_terminator("br i1 " + b_done_cmp + ", label %" + await_done + ", label %" + await_yield)

                this.start_block(await_yield)
                var save_tok: String = this.fresh_local()
                this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
                var susp_result: String = this.fresh_local()
                this.emit_indent(susp_result + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")
                this.emit_terminator("switch i8 " + susp_result + ", label %__coro_suspend [i8 0, label %" + await_loop + " i8 1, label %" + await_cleanup + "]")

                this.start_block(await_cleanup)
                this.emit_terminator("br label %__coro_cleanup")

                this.start_block(await_loop)
                this.emit_indent("call void @__sched_coro_resume(i64 " + b_hdl_i64 + ")")
                this.emit_terminator("br label %" + await_check)

                this.start_block(await_done)
                // Read the child coroutine's return value from @__task_result
                var coro_result: String = this.fresh_local()
                this.emit_indent(coro_result + " = load i64, i64* @__task_result")
                // Use the callee's return type
                if (this.func_ret_types.has(resolved_callee)) {
                    this.last_type = this.func_ret_types.get(resolved_callee)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return coro_result
            }
        }

        // Sync-calls-coro: non-coroutine calling a coroutine directly — drive to completion
        if (!this.is_coroutine) {
            var is_sync_coro_callee: Bool = this.str_in_list(this.coroutine_funcs,resolved_callee)
            if (!is_sync_coro_callee and this.str_in_list(this.coroutine_funcs,this.current_prefix + resolved_callee)) {
                is_sync_coro_callee = true
                resolved_callee = this.current_prefix + resolved_callee
            }
            if (is_sync_coro_callee) {
                this.called_functions.push(resolved_callee)
                var sync_arg_strs: List<String> = []
                var sai: Float = 0
                while (sai < args.length()) {
                    var val: String = this.gen_arg_value(args[sai])
                    sync_arg_strs.push("i64 " + val)
                    sai = sai + 1
                }
                var s_hdl: String = this.fresh_local()
                this.emit_indent(s_hdl + " = call ptr @" + resolved_callee + "(" + sync_arg_strs.join(", ") + ")")
                var s_i64: String = this.fresh_local()
                this.emit_indent(s_i64 + " = ptrtoint ptr " + s_hdl + " to i64")
                var sc: String = this.fresh_label("sync.check")
                var sl: String = this.fresh_label("sync.loop")
                var sd: String = this.fresh_label("sync.done")
                this.emit_terminator("br label %" + sc)
                this.start_block(sc)
                var s_done: String = this.fresh_local()
                this.emit_indent(s_done + " = call i64 @__sched_coro_done(i64 " + s_i64 + ")")
                var s_cmp: String = this.fresh_local()
                this.emit_indent(s_cmp + " = icmp eq i64 " + s_done + ", 1")
                this.emit_terminator("br i1 " + s_cmp + ", label %" + sd + ", label %" + sl)
                this.start_block(sl)
                this.emit_indent("call void @__sched_coro_resume(i64 " + s_i64 + ")")
                this.emit_terminator("br label %" + sc)
                this.start_block(sd)
                var s_result: String = this.fresh_local()
                this.emit_indent(s_result + " = load i64, i64* @__task_result")
                if (this.func_ret_types.has(resolved_callee)) {
                    this.last_type = this.func_ret_types.get(resolved_callee)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return s_result
            }
        }

        // Error check: argument count validation (skip if named args present)
        var has_named_check: Bool = false
        var nac: Float = 0
        while (nac < args.length()) {
            if (this.classify_expr(args[nac]) == "assign") { has_named_check = true }
            nac = nac + 1
        }
        if (!has_named_check) {
            var has_real_defs: Bool = false
            if (this.func_defaults.has(resolved_callee)) {
                var __defs: List<AST.Expr> = this.func_defaults.get(resolved_callee)
                var __di: Float = 0
                while (__di < __defs.length()) {
                    if (this.classify_expr(__defs[__di]) != "nil") { has_real_defs = true }
                    __di = __di + 1
                }
            }
            // Only error on arity for functions defined in same compilation unit
            // (not imported via named imports), to avoid false positives from pipe |>
            var is_named_import: Bool = this.named_imports.has(callee_name)
            if (!is_named_import) {
                // The arity comes from one of two maps, and only ONE of them is a
                // trustworthy record of a *declared* arity.
                //
                //   func_param_count is written only where a declaration is
                //   processed -- gen_fun_decl (both the plain and @inline arms),
                //   gen_class_method, prescan_fun_decl, prescan_class_decl. A 0
                //   there therefore means "this function is declared to take no
                //   arguments", which is a real arity and must be checked.
                //
                //   called_function_arity is overloaded. Declarations write it for
                //   class methods and inheritance forwarders, where the value is
                //   always >= 1 because of the implicit `self`; but CALL SITES
                //   also write args.length() into it (gen_method_call, the package
                //   re-export arms) purely to size the `declare i64 @f(...)` lines
                //   emit_module writes for undefined callees. A 0 in that map thus
                //   cannot have come from a declaration -- it is a 0-argument call
                //   site's leftover, or the key is simply absent.
                //
                // So `expected > 0` is a legitimate "we never recorded a real
                // arity" guard for called_function_arity and pure damage for
                // func_param_count. It used to be applied to both, which exempted
                // every genuinely 0-arity function from arity checking altogether:
                // `fun c() {}` then `c("too", "many")` compiled clean (BUGS #113).
                // Consult the declaration-derived map first; where a key lives in
                // both they agree, so the order only decides who answers.
                //
                // Measured, not assumed: a variant that drops `expected > 0` from
                // BOTH arms and keeps the original order was built and run over the
                // compiler's own source, the stdlib and the whole test corpus (285
                // files). It produced byte-identical diagnostics to this version --
                // no unrecorded-arity case is reachable today, so the exemption
                // below is currently dead weight. It is kept because the call-site
                // writers make 0 unfalsifiable in that map: the moment a
                // gen_method_call path starts feeding this check, `expected > 0`
                // is the only thing standing between a 0-arg call-site leftover
                // and a fabricated "expects 0 arguments" on a function that takes
                // three. Do NOT "simplify" it away without re-running that
                // comparison.
                if (this.func_param_count.has(resolved_callee)) {
                    var expected: Float = this.func_param_count.get(resolved_callee)
                    if (args.length() != expected and !has_real_defs) {
                        IO.println("[codegen] Error: '" + callee_name + "' expects " + expected.floor().to_string() + " arguments, got " + args.length().floor().to_string())
                        this.has_errors = true
                    }
                } else if (this.called_function_arity.has(resolved_callee)) {
                    var expected: Float = this.called_function_arity.get(resolved_callee)
                    if (args.length() != expected and expected > 0 and !has_real_defs) {
                        IO.println("[codegen] Error: '" + callee_name + "' expects " + expected.floor().to_string() + " arguments, got " + args.length().floor().to_string())
                        this.has_errors = true
                    }
                }
            }
        }

        if (this.str_in_list(this.known_functions,resolved_callee) and !this.typed_vars.has(callee_name)) {
            // Direct call to known function (only when callee is NOT a local variable/param)
            var call_target: String = resolved_callee
            // Redirect `main()` to the entry point's emitted name, but ONLY when the
            // callee actually resolved to the unprefixed `main`. Testing callee_name
            // meant a call that resolved to some OTHER module's `main` (e.g.
            // turmeric_prelude_main, the <main> element builder) was rewritten to
            // __saffron_main as well, so the call landed on the wrong function --
            // with the wrong arity, and no diagnostic.
            if (resolved_callee == "main" and this.str_in_list(this.defined_funcs,"__saffron_main")) {
                call_target = "__saffron_main"
            }
            this.called_functions.push(resolved_callee)

            // Check if this is a class constructor call with args
            // Pattern: ClassName(args) → call @ClassName() + call @ClassName__init(instance, args)
            var is_constructor: Bool = false
            // Extract the simple class name from module-qualified callee (e.g. "Func.BasicBlock" → "BasicBlock")
            var simple_callee: String = callee_name
            if (callee_name.contains(".")) {
                var sc_parts: List<String> = callee_name.split(".")
                simple_callee = sc_parts[sc_parts.length() - 1]
            }
            if (this.func_ret_types.has(resolved_callee)) {
                var ret_type_node: AST.Type = this.func_ret_types.get(resolved_callee)
                var ret_type_val: String = this.type_to_string(ret_type_node)
                if (ret_type_val == callee_name or ret_type_val == simple_callee) {
                    is_constructor = true
                }
                if (!is_constructor and ret_type_val == resolved_callee) {
                    if (this.class_fields.has(callee_name) or this.class_fields.has(simple_callee)) {
                        is_constructor = true
                    }
                }
            }

            if (is_constructor) {
                // Constructor: allocate instance, then call init
                var instance: String = this.fresh_local()
                this.emit_indent(instance + " = call i64 @" + resolved_callee + "()")
                // Call init for user-defined classes (not runtime builtins)
                var init_name: String = resolved_callee + "__init"
                if (!this.str_in_list(this.known_functions,init_name)) {
                    init_name = callee_name + "__init"
                }
                // Resolve via func_prefix_map (class methods are emitted with module prefix)
                if (this.func_prefix_map.has(init_name)) {
                    init_name = this.func_prefix_map.get(init_name)
                } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions,this.current_prefix + init_name)) {
                    init_name = this.current_prefix + init_name
                }
                if (this.str_in_list(this.known_functions,init_name)) {
                    var init_args: List<String> = []
                    init_args.push("i64 " + instance)
                    var i: Float = 0
                    while (i < args.length()) {
                        var val: String = this.gen_arg_value(args[i])
                        init_args.push("i64 " + val)
                        i = i + 1
                    }
                    this.called_functions.push(init_name)
                    var discard_init: String = this.fresh_local()
                    this.emit_indent(discard_init + " = call i64 @" + init_name + "(" + init_args.join(", ") + ")")
                }
                this.last_type = this.str_to_type(simple_callee)
                return instance
            }

            var arg_strs: List<String> = []
            // If this is a nested function with captures, prepend capture POINTERS as args
            if (this.called_function_arity.has("__captures_" + resolved_callee)) {
                var caps_str: String = this.func_prefix_map.get("__caps_" + resolved_callee)
                if (caps_str.length() > 0) {
                    var cap_names: List<String> = caps_str.split(",")
                    var ci3: Float = 0
                    while (ci3 < cap_names.length()) {
                        var cap_val: String = this.typed_ptr_to_val("%" + this.sanitize_name(cap_names[ci3]), "i64*")
                        arg_strs.push("i64 " + cap_val)
                        ci3 = ci3 + 1
                    }
                }
            }
            // Named argument reordering: if any arg is an Assign node (named arg),
            // reorder args to match parameter order instead of source order
            var reordered_args: List<AST.Expr> = args
            var has_named_args: Bool = false
            var trailing_closure_applied: Bool = false
            // Trailing closure: if last arg is a lambda and fewer args than params,
            // place it at the last param position (Kotlin-style trailing closure)
            if (this.func_param_names.has(resolved_callee) and args.length() > 0) {
                var tc_pnames: List<String> = this.func_param_names.get(resolved_callee)
                var tc_last: AST.Expr = args[args.length() - 1]
                if (this.classify_expr(tc_last) == "lambda" and args.length() < tc_pnames.length()) {
                    // Separate non-trailing args from the trailing closure
                    var tc_args: List<AST.Expr> = []
                    var tc_i: Float = 0
                    while (tc_i < args.length() - 1) {
                        tc_args.push(args[tc_i])
                        tc_i = tc_i + 1
                    }
                    // Check if non-trailing args have named args
                    var tc_has_named: Bool = false
                    var tc_ni: Float = 0
                    while (tc_ni < tc_args.length()) {
                        if (this.classify_expr(tc_args[tc_ni]) == "assign") {
                            tc_has_named = true
                        }
                        tc_ni = tc_ni + 1
                    }
                    // Build reordered args: handle named args among non-trailing args
                    var tc_new: List<AST.Expr> = []
                    if (tc_has_named) {
                        // Named arg reordering for params before the last one
                        var positional_idx: Float = 0
                        var pi: Float = 0
                        while (pi < tc_pnames.length() - 1) {
                            var pname: String = tc_pnames[pi]
                            var found: Bool = false
                            var si: Float = 0
                            while (si < tc_args.length()) {
                                if (this.classify_expr(tc_args[si]) == "assign") {
                                    var arg_name: String = match (tc_args[si]) { Assign(n, v) => n
                                        _ => ""
                                    }
                                    if (arg_name == pname) {
                                        var arg_value: AST.Expr = match (tc_args[si]) { Assign(n, v) => v
                                            _ => AST.Expr.NilLit
                                        }
                                        tc_new.push(arg_value)
                                        found = true
                                    }
                                }
                                si = si + 1
                            }
                            if (!found) {
                                var used_pos: Bool = false
                                while (positional_idx < tc_args.length() and !used_pos) {
                                    if (this.classify_expr(tc_args[positional_idx]) != "assign") {
                                        tc_new.push(tc_args[positional_idx])
                                        positional_idx = positional_idx + 1
                                        used_pos = true
                                    } else {
                                        positional_idx = positional_idx + 1
                                    }
                                }
                                if (!used_pos) {
                                    tc_new.push(AST.Expr.NilLit)
                                }
                            }
                            pi = pi + 1
                        }
                    } else {
                        // No named args, just copy positional args and fill gaps
                        tc_i = 0
                        while (tc_i < tc_args.length()) {
                            tc_new.push(tc_args[tc_i])
                            tc_i = tc_i + 1
                        }
                        while (tc_new.length() < tc_pnames.length() - 1) {
                            tc_new.push(AST.Expr.NilLit)
                        }
                    }
                    // Place trailing closure at the end
                    tc_new.push(tc_last)
                    reordered_args = tc_new
                    has_named_args = true
                    trailing_closure_applied = true
                }
            }
            var nai: Float = 0
            while (nai < args.length()) {
                if (this.classify_expr(args[nai]) == "assign") {
                    has_named_args = true
                }
                nai = nai + 1
            }
            if (has_named_args and this.func_param_names.has(resolved_callee) and !trailing_closure_applied) {
                var param_names: List<String> = this.func_param_names.get(resolved_callee)
                var new_args: List<AST.Expr> = []
                var positional_idx: Float = 0
                var pi: Float = 0
                while (pi < param_names.length()) {
                    var pname: String = param_names[pi]
                    // Search for a named arg matching this param
                    var found: Bool = false
                    var si: Float = 0
                    while (si < args.length()) {
                        if (this.classify_expr(args[si]) == "assign") {
                            var arg_name: String = match (args[si]) { Assign(n, v) => n
                                _ => ""
                            }
                            if (arg_name == pname) {
                                var arg_value: AST.Expr = match (args[si]) { Assign(n, v) => v
                                    _ => AST.Expr.NilLit
                                }
                                new_args.push(arg_value)
                                found = true
                            }
                        }
                        si = si + 1
                    }
                    if (!found) {
                        // Use positional arg (skip over named args in positional counting)
                        var used_positional: Bool = false
                        while (positional_idx < args.length() and !used_positional) {
                            if (this.classify_expr(args[positional_idx]) != "assign") {
                                new_args.push(args[positional_idx])
                                positional_idx = positional_idx + 1
                                used_positional = true
                            } else {
                                positional_idx = positional_idx + 1
                            }
                        }
                        if (!used_positional) {
                            // No positional arg available — use default (will be filled below)
                            // Push a nil placeholder to signal "use default"
                            new_args.push(AST.Expr.NilLit)
                        }
                    }
                    pi = pi + 1
                }
                reordered_args = new_args
            }
            var i: Float = 0
            while (i < reordered_args.length()) {
                // Skip nil placeholders that signal "use default"
                var used_default: Bool = false
                if (has_named_args and this.classify_expr(reordered_args[i]) == "nil" and this.func_defaults.has(resolved_callee)) {
                    var defs: List<AST.Expr> = this.func_defaults.get(resolved_callee)
                    if (i < defs.length() and this.classify_expr(defs[i]) != "nil") {
                        var def_val: String = this.gen_arg_value(defs[i])
                        arg_strs.push("i64 " + def_val)
                        used_default = true
                    }
                }
                if (!used_default) {
                    var val: String = this.gen_arg_value(reordered_args[i])
                    arg_strs.push("i64 " + val)
                }
                i = i + 1
            }
            // Fill missing args with default values
            if (this.func_defaults.has(resolved_callee)) {
                var defaults: List<AST.Expr> = this.func_defaults.get(resolved_callee)
                var param_count: Float = defaults.length()
                if (this.func_param_names.has(resolved_callee)) {
                    var pc2: Float = this.func_param_names.get(resolved_callee).length()
                    if (pc2 > param_count) { param_count = pc2 }
                }
                while (i < param_count) {
                    if (i < defaults.length()) {
                        var def_expr: AST.Expr = defaults[i]
                        var is_nil: Bool = this.classify_expr(def_expr) == "nil"
                        if (!is_nil) {
                            var def_val: String = this.gen_arg_value(def_expr)
                            arg_strs.push("i64 " + def_val)
                        } else {
                            var __nil_fill: String = this.fresh_local()
                            this.emit_indent(__nil_fill + " = call i64 @__val_nil()")
                            arg_strs.push("i64 " + __nil_fill)
                        }
                    } else {
                        var __nil_fill: String = this.fresh_local()
                        this.emit_indent(__nil_fill + " = call i64 @__val_nil()")
                        arg_strs.push("i64 " + __nil_fill)
                    }
                    i = i + 1
                }
            } else if (this.func_param_names.has(resolved_callee)) {
                var param_count: Float = this.func_param_names.get(resolved_callee).length()
                while (arg_strs.length() < param_count) {
                    var __nil_fill: String = this.fresh_local()
                    this.emit_indent(__nil_fill + " = call i64 @__val_nil()")
                    arg_strs.push("i64 " + __nil_fill)
                }
            }
            var local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(local, "i64", call_target, arg_strs.join(", ")))
            } else {
                this.emit_indent(local + " = call i64 @" + call_target + "(" + arg_strs.join(", ") + ")")
                this.verify_call(local, "i64", call_target, arg_strs.join(", "))
            }
            if (this.func_ret_types.has(resolved_callee)) {
                this.last_type = this.func_ret_types.get(resolved_callee)
            } else if (this.func_ret_types.has(callee_name)) {
                this.last_type = this.func_ret_types.get(callee_name)
            } else {
                this.last_type = AST.Type.IntType
            }
            return local
        }

        // Check if it looks like a direct function call (not a local variable)
        if (!this.typed_vars.has(callee_name) and callee_name.length() > 0) {
            // Runtime builtin constructors
            if (callee_name == "Map") {
                var local: String = this.fresh_local()
                this.emit_indent(local + " = call i64 @__map_new()")
                this.last_type = this.make_map_type()
                return local
            }
            var emit_callee: String = this.current_prefix + callee_name
            // Named imports take priority over all other resolution
            if (this.named_imports.has(callee_name)) {
                emit_callee = this.named_imports.get(callee_name)
            } else if (!this.str_in_list(this.known_functions,emit_callee)) {
                if (this.str_in_list(this.known_functions,callee_name)) {
                    emit_callee = callee_name
                } else if (this.func_prefix_map.has(callee_name)) {
                    emit_callee = this.func_prefix_map.get(callee_name)
                } else {
                    // Warning: calling undefined function
                    // Suppress if it's a known class method (ClassName__method pattern)
                    var is_known_method: Bool = false
                    var kfi: Float = 0
                    while (kfi < this.known_functions.length()) {
                        if (this.known_functions[kfi].ends_with("__" + callee_name)) {
                            is_known_method = true
                            kfi = this.known_functions.length()
                        }
                        kfi = kfi + 1
                    }
                    if (!is_known_method) {
                        IO.println("[codegen] Warning: calling undefined function '" + callee_name + "'")
                    }

                }
            }
            this.called_functions.push(emit_callee)
            // Named argument reordering for fallback path
            var reordered_args2: List<AST.Expr> = args
            var has_named2: Bool = false
            var tc_applied2: Bool = false
            // Trailing closure for fallback path
            if (this.func_param_names.has(emit_callee) and args.length() > 0) {
                var tc_pnames2: List<String> = this.func_param_names.get(emit_callee)
                var tc_last2: AST.Expr = args[args.length() - 1]
                if (this.classify_expr(tc_last2) == "lambda" and args.length() < tc_pnames2.length()) {
                    var tc_args2: List<AST.Expr> = []
                    var tc_i2: Float = 0
                    while (tc_i2 < args.length() - 1) {
                        tc_args2.push(args[tc_i2])
                        tc_i2 = tc_i2 + 1
                    }
                    var tc_has_named2: Bool = false
                    var tc_ni2: Float = 0
                    while (tc_ni2 < tc_args2.length()) {
                        if (this.classify_expr(tc_args2[tc_ni2]) == "assign") {
                            tc_has_named2 = true
                        }
                        tc_ni2 = tc_ni2 + 1
                    }
                    var tc_new2: List<AST.Expr> = []
                    if (tc_has_named2) {
                        var positional_idx2: Float = 0
                        var pi2: Float = 0
                        while (pi2 < tc_pnames2.length() - 1) {
                            var pname2: String = tc_pnames2[pi2]
                            var found2: Bool = false
                            var si2: Float = 0
                            while (si2 < tc_args2.length()) {
                                if (this.classify_expr(tc_args2[si2]) == "assign") {
                                    var arg_name2: String = match (tc_args2[si2]) { Assign(n, v) => n
                                        _ => ""
                                    }
                                    if (arg_name2 == pname2) {
                                        var arg_value2: AST.Expr = match (tc_args2[si2]) { Assign(n, v) => v
                                            _ => AST.Expr.NilLit
                                        }
                                        tc_new2.push(arg_value2)
                                        found2 = true
                                    }
                                }
                                si2 = si2 + 1
                            }
                            if (!found2) {
                                var used_pos2: Bool = false
                                while (positional_idx2 < tc_args2.length() and !used_pos2) {
                                    if (this.classify_expr(tc_args2[positional_idx2]) != "assign") {
                                        tc_new2.push(tc_args2[positional_idx2])
                                        positional_idx2 = positional_idx2 + 1
                                        used_pos2 = true
                                    } else {
                                        positional_idx2 = positional_idx2 + 1
                                    }
                                }
                                if (!used_pos2) {
                                    tc_new2.push(AST.Expr.NilLit)
                                }
                            }
                            pi2 = pi2 + 1
                        }
                    } else {
                        tc_i2 = 0
                        while (tc_i2 < tc_args2.length()) {
                            tc_new2.push(tc_args2[tc_i2])
                            tc_i2 = tc_i2 + 1
                        }
                        while (tc_new2.length() < tc_pnames2.length() - 1) {
                            tc_new2.push(AST.Expr.NilLit)
                        }
                    }
                    tc_new2.push(tc_last2)
                    reordered_args2 = tc_new2
                    has_named2 = true
                    tc_applied2 = true
                }
            }
            var nai2: Float = 0
            while (nai2 < args.length()) {
                if (this.classify_expr(args[nai2]) == "assign") {
                    has_named2 = true
                }
                nai2 = nai2 + 1
            }
            if (has_named2 and this.func_param_names.has(emit_callee) and !tc_applied2) {
                var param_names2: List<String> = this.func_param_names.get(emit_callee)
                var new_args2: List<AST.Expr> = []
                var positional_idx2: Float = 0
                var pi2: Float = 0
                while (pi2 < param_names2.length()) {
                    var pname2: String = param_names2[pi2]
                    var found2: Bool = false
                    var si2: Float = 0
                    while (si2 < args.length()) {
                        if (this.classify_expr(args[si2]) == "assign") {
                            var arg_name2: String = match (args[si2]) { Assign(n, v) => n
                                _ => ""
                            }
                            if (arg_name2 == pname2) {
                                var arg_value2: AST.Expr = match (args[si2]) { Assign(n, v) => v
                                    _ => AST.Expr.NilLit
                                }
                                new_args2.push(arg_value2)
                                found2 = true
                            }
                        }
                        si2 = si2 + 1
                    }
                    if (!found2) {
                        var used_pos2: Bool = false
                        while (positional_idx2 < args.length() and !used_pos2) {
                            if (this.classify_expr(args[positional_idx2]) != "assign") {
                                new_args2.push(args[positional_idx2])
                                positional_idx2 = positional_idx2 + 1
                                used_pos2 = true
                            } else {
                                positional_idx2 = positional_idx2 + 1
                            }
                        }
                        if (!used_pos2) {
                            new_args2.push(AST.Expr.NilLit)
                        }
                    }
                    pi2 = pi2 + 1
                }
                reordered_args2 = new_args2
            }
            var arg_strs: List<String> = []
            var i: Float = 0
            while (i < reordered_args2.length()) {
                var used_default2: Bool = false
                if (has_named2 and this.classify_expr(reordered_args2[i]) == "nil" and this.func_defaults.has(emit_callee)) {
                    var defs2: List<AST.Expr> = this.func_defaults.get(emit_callee)
                    if (i < defs2.length() and this.classify_expr(defs2[i]) != "nil") {
                        var def_val2: String = this.gen_arg_value(defs2[i])
                        arg_strs.push("i64 " + def_val2)
                        used_default2 = true
                    }
                }
                if (!used_default2) {
                    var val: String = this.gen_arg_value(reordered_args2[i])
                    arg_strs.push("i64 " + val)
                }
                i = i + 1
            }
            // Fill missing args with default values
            if (this.func_defaults.has(emit_callee)) {
                var defaults2: List<AST.Expr> = this.func_defaults.get(emit_callee)
                var param_count2: Float = defaults2.length()
                if (this.func_param_names.has(emit_callee)) {
                    var pc2b: Float = this.func_param_names.get(emit_callee).length()
                    if (pc2b > param_count2) { param_count2 = pc2b }
                }
                while (i < param_count2) {
                    if (i < defaults2.length()) {
                        var def_expr2: AST.Expr = defaults2[i]
                        var is_nil2: Bool = this.classify_expr(def_expr2) == "nil"
                        if (!is_nil2) {
                            var def_val2b: String = this.gen_arg_value(def_expr2)
                            arg_strs.push("i64 " + def_val2b)
                        } else {
                            var __nil_fill2: String = this.fresh_local()
                            this.emit_indent(__nil_fill2 + " = call i64 @__val_nil()")
                            arg_strs.push("i64 " + __nil_fill2)
                        }
                    } else {
                        var __nil_fill2: String = this.fresh_local()
                        this.emit_indent(__nil_fill2 + " = call i64 @__val_nil()")
                        arg_strs.push("i64 " + __nil_fill2)
                    }
                    i = i + 1
                }
            } else if (this.func_param_names.has(emit_callee)) {
                var param_count2: Float = this.func_param_names.get(emit_callee).length()
                while (arg_strs.length() < param_count2) {
                    var __nil_fill2: String = this.fresh_local()
                    this.emit_indent(__nil_fill2 + " = call i64 @__val_nil()")
                    arg_strs.push("i64 " + __nil_fill2)
                }
            }
            var local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(local, "i64", emit_callee, arg_strs.join(", ")))
            } else {
                this.emit_indent(local + " = call i64 @" + emit_callee + "(" + arg_strs.join(", ") + ")")
                this.verify_call(local, "i64", emit_callee, arg_strs.join(", "))
            }
            if (this.func_ret_types.has(emit_callee)) {
                this.last_type = this.func_ret_types.get(emit_callee)
            } else {
                this.last_type = AST.Type.IntType
            }
            return local
        }

        // Indirect call: callee is a variable or expression holding a function pointer
        //
        // A name can be claimed by BOTH a `var` and a `fun` (`var a = 1` next to
        // `fun a() {...}`). Nothing rejects that, and the direct-call branch above
        // declines it because a binding exists, so `a()` fell through to here and
        // loaded the *variable* as a closure pair. With `var a = 1` that pair
        // pointer is the NaN-boxed integer 0x7FF9000000000001, and unpacking it
        // dereferences that address — the exact fault address observed in
        // test/functions.sf (BUGS #80).
        //
        // The recorded type settles it: an indirect call is only meaningful if the
        // binding could hold a callable. `Fun` (and an unknown/`Any` type, which
        // may be a lambda) stay indirect; anything concretely non-callable means
        // the `fun` is what the programmer named, so dispatch directly and keep the
        // value load out of it entirely.
        if (callee_name.length() > 0 and this.str_in_list(this.known_functions,resolved_callee)) {
            var cty: String = ""
            if (this.typed_vars.has(callee_name)) {
                cty = this.type_to_string(this.typed_vars.get(callee_name))
            } else if (this.global_var_types.has(this.current_prefix + callee_name)) {
                cty = this.global_var_types.get(this.current_prefix + callee_name)
            } else if (this.global_var_types.has(callee_name)) {
                cty = this.global_var_types.get(callee_name)
            }
            var callable: Bool = cty.length() == 0 or cty == "Any" or cty == "Fun" or cty.starts_with("Fun")
            if (!callable) {
                var direct: String = this.fresh_local()
                var d_args: List<String> = []
                var dai: Float = 0
                while (dai < args.length()) {
                    d_args.push("i64 " + this.gen_arg_value(args[dai]))
                    dai = dai + 1
                }
                this.called_functions.push(resolved_callee)
                this.emit_indent(direct + " = call i64 @" + resolved_callee + "(" + d_args.join(", ") + ")")
                if (this.func_ret_types.has(resolved_callee)) {
                    this.last_type = this.func_ret_types.get(resolved_callee)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return direct
            }
        }
        var ptr_val: String = ""
        if (callee_name.length() == 0) {
            ptr_val = this.gen_arg_value(callee)
        } else {
            ptr_val = this.fresh_local()
            var var_ref: String = "%" + this.sanitize_name(callee_name)
            if (this.module_globals.has(this.current_prefix + callee_name)) {
                var_ref = "@__g_" + this.current_prefix + this.sanitize_name(callee_name)
            }
            this.emit_indent(ptr_val + " = load i64, i64* " + var_ref)
        }
        return this.gen_indirect_call(ptr_val, args)
    }

    fun gen_indirect_call(ptr_val: String, args: List<AST.Expr>): String {
        // ptr_val could be either:
        // 1. A plain function pointer (non-capturing lambda)
        // 2. A closure pair pointer: [fn_ptr, env_ptr]
        // We use the closure calling convention for all indirect calls:
        // Unpack [fn_ptr, env_ptr], call fn(env, args...)
        var closure_ptr: String = this.val_to_typed_ptr(ptr_val, "[2 x i64]*")

        // Load fn_ptr from slot 0
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        var fn_int: String = this.fresh_local()
        this.emit_indent(fn_int + " = load i64, i64* " + fn_slot)

        // Load env_ptr from slot 1
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        var env_int: String = this.fresh_local()
        this.emit_indent(env_int + " = load i64, i64* " + env_slot)

        // Build args: env first, then user args
        var arg_strs: List<String> = []
        arg_strs.push("i64 " + env_int)
        var i: Float = 0
        while (i < args.length()) {
            var val: String = this.gen_arg_value(args[i])
            arg_strs.push("i64 " + val)
            i = i + 1
        }

        // Build function type: i64 (i64 env, i64 arg1, ...)
        var num_args: Float = args.length() + 1
        var type_parts: List<String> = []
        var ti: Float = 0
        while (ti < num_args) {
            type_parts.push("i64")
            ti = ti + 1
        }
        var fn_type: String = "i64 (" + type_parts.join(", ") + ")*"

        // Cast and call
        var fn_ptr: String = this.val_to_fn_ptr(fn_int, fn_type)
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 " + fn_ptr + "(" + arg_strs.join(", ") + ")")
        // LLVM lib parallel path: track indirect call result as opaque placeholder
        if (!this.identity_mode) {
            var ic_res: LLVMTypes.Value = this.llvm_block_builder.call("__indirect_call", LLVMTypes.Type.I64, [])
            this.llvm_values.set(local, ic_res)
        }
        // The result type of an indirect call is genuinely unknown: `Fun` carries
        // no return type, so there is nothing here to derive one from. Say so.
        //
        // This function used to leave `last_type` holding whatever the last
        // sub-expression happened to set — usually the type of the final
        // *argument*, or of the callee itself. Callers read that stale value as
        // if it described the result, which is how a field access on a call
        // result silently resolved to offset 0 (BUGS #56): `f(1).v` looked up
        // field `v` on a class inferred from leftover state, and get_field_index
        // answered 0 for a name it could not find. The same staleness made a
        // Float returned through a closure read as an Int and print 0 (the float
        // half of BUGS #51) — `to_string` keys off `last_type`, so it untagged a
        // double as an integer.
        //
        // AnyType is the honest answer, and is already the "unknown" spelling the
        // rest of codegen understands: it routes through the runtime dispatch
        // helpers, which inspect the actual tag instead of trusting a static
        // guess. That turns both silent wrong answers into correct behaviour for
        // to_string/arithmetic, and turns the field case into a diagnostic rather
        // than a wrong offset. (I2/M1 in docs/design/compiler-rewrite.md:
        // unknown is distinct, and codegen must not re-derive a type it lacks.)
        //
        // Annotating the binding (`var x: Box = f(1)`) remains the way to supply
        // the type; the real fix is a return type on `Fun`, a language change.
        this.last_type = AST.Type.AnyType
        return local
    }

    fun has_string_literal(left: AST.Expr, right: AST.Expr): Bool {
        return this.is_string_expr(left) or this.is_string_expr(right) or this.contains_string_lit(left) or this.contains_string_lit(right) or this.is_string_variable(left) or this.is_string_variable(right)
    }

    fun contains_string_lit(expr: AST.Expr): Bool {
        // Only these two shapes can hold a literal that reaches the concat path;
        // everything else is a runtime value. The 26 arms spelled out one per
        // variant, all returning "no", are the `_` arm — and being hand-written
        // they went stale: IndexGet, IndexSet, MethodCall and MapLit were never
        // added, so those four fell through to an indeterminate value instead of
        // false (BUGS #76).
        return match (expr) {
            StringLit(s) => true
            Binary(l, o, r) => this.contains_string_lit(l) or this.contains_string_lit(r)
            _ => false
        }
    }

    fun is_string_variable(expr: AST.Expr): Bool {
        // Same story as contains_string_lit: only a name-shaped expression can be
        // looked up in string_vars, and the 24 hand-written `=> ""` arms had
        // likewise gone stale (MapLit, IndexGet, IndexSet, MethodCall missing).
        var name: String = match (expr) {
            Variable(n) => n
            Ref(rk, rn, rs) => rn
            GetField(o, f) => f
            _ => ""
        }
        if (name.length() > 0) {
            if (this.string_vars.contains(name)) return true
            // Check class fields
            if (this.current_class.length() > 0 and this.class_fields.has(this.current_class)) {
                var fields: String = this.class_fields.get(this.current_class)
                if (fields.contains(name + ":String")) return true
            }
        }
        return false
    }

    fun get_string_lit_value(expr: AST.Expr): String {
        return match (expr) { StringLit(s) => s
            _ => ""
        }
    }

    fun is_string_expr(expr: AST.Expr): Bool {
        // True only for a compile-time-known string: a literal, or a `+` chain of
        // them. flatten_string_expr relies on exactly this: whatever answers true
        // here it must be able to fold to a constant. The 27 remaining arms each
        // named their variant and then all failed the `== "string"` test below, so
        // they were a `_ => false` written the long way — and MapLit had never
        // been added to the list, leaving it indeterminate (BUGS #76).
        return match (expr) {
            StringLit(s) => true
            Binary(l, o, r) => o == "+" and this.is_string_expr(l) and this.is_string_expr(r)
            _ => false
        }
    }

    fun get_format_ptr(fmt: String): String {
        var name: String = this.add_string_constant(fmt)
        var len: Float = fmt.length() + 1
        var local: String = this.fresh_local()
        this.emit_indent(local + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + name + ", i64 0, i64 0")
        return local
    }

    fun gen_enum_construct(enum_name: String, variant: String, args: List<AST.Expr>): String {
        var key: String = enum_name + "." + variant
        var tag: Float = this.enum_variant_tags.get(key)

        // Check if this enum uses simple encoding (no fields) or array encoding
        var max_fields: Float = this.get_max_fields(enum_name)

        if (max_fields == 0) {
            // Simple encoding for enums with no data fields at all: tag << 56
            if (args.length() == 0) {
                var local: String = this.fresh_local()
                this.emit_indent(local + " = shl i64 " + tag.floor().to_string() + ", 56")
                this.last_type = AST.Type.EnumType(enum_name); return local
            }
            // Shouldn't happen (max_fields==0 but args>0), fall through to array encoding
        }

        // Array encoding for enums with multi-field variants: [tag, f0, f1, ...]
        if (args.length() == 0) {
            // No-field variant in a multi-field enum: heap-allocate to outlive function
            var arr_raw: String = this.fresh_local()
            this.emit_indent(arr_raw + " = call i8* @__sf_malloc(i64 8)")
            var arr_ptr: String = this.fresh_local()
            this.emit_indent(arr_ptr + " = bitcast i8* " + arr_raw + " to [1 x i64]*")
            var tag_slot: String = this.fresh_local()
            this.emit_indent(tag_slot + " = getelementptr [1 x i64], [1 x i64]* " + arr_ptr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + tag_slot)
            var as_int: String = this.typed_ptr_to_val(arr_ptr, "[1 x i64]*")
            this.last_type = AST.Type.EnumType(enum_name); return as_int
        }

        // Multi-field: heap-allocate array [tag, field0, field1, ...]
        // Must be heap (not stack) since enum values may outlive the creating function
        var num_slots: Float = args.length() + 1
        var arr_bytes: Float = num_slots * 8
        var arr_raw: String = this.fresh_local()
        this.emit_indent(arr_raw + " = call i8* @__sf_malloc(i64 " + arr_bytes.floor().to_string() + ")")
        var arr_ptr: String = this.fresh_local()
        this.emit_indent(arr_ptr + " = bitcast i8* " + arr_raw + " to [" + num_slots.to_string() + " x i64]*")
        // Store tag at index 0
        var tag_slot: String = this.fresh_local()
        this.emit_indent(tag_slot + " = getelementptr [" + num_slots.to_string() + " x i64], [" + num_slots.to_string() + " x i64]* " + arr_ptr + ", i64 0, i64 0")
        this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + tag_slot)
        // Store fields at indices 1, 2, ...
        var i: Float = 0
        while (i < args.length()) {
            var val: String = this.gen_arg_value(args[i])
            // Int -> Float widening at the payload store, the same fix as BUGS #28
            // applied to enum construction instead of variable declaration.
            //
            // A `Number` field stores whatever representation the argument happened
            // to have: `Some(7)` stored a TAG_INT, `Some(7.5)` a double. The
            // declared field type therefore did not describe the bits, so a binding
            // extracted by `let Some(v) = ...` was unreadable either way — typing it
            // Float made `Some(7)` print nan, and typing it Int made
            // `Circle(2.0)` arithmetic produce nan. Neither static choice can be
            // right while construction is inconsistent.
            //
            // Normalising here makes the declared type true: a Float/Number field
            // always holds a double, so get_variant_field_type's "Float" is correct
            // for every construction. Reuses the untag/tag round trip so the sitofp
            // lives in one place.
            //
            // Gated on !identity_mode for the reason given at the declaration site:
            // identity mode has no tags and Float *is* Int there.
            if (!this.identity_mode) {
                var decl_type: String = this.get_variant_field_type(enum_name, variant, i)
                if (decl_type == "Float" and this.type_to_string(this.last_type) == "Int") {
                    var widened: String = this.emit_untag_float(val)
                    val = this.emit_tag_float(widened)
                }
            }
            var field_idx: Float = i + 1
            var field_slot: String = this.fresh_local()
            this.emit_indent(field_slot + " = getelementptr [" + num_slots.to_string() + " x i64], [" + num_slots.to_string() + " x i64]* " + arr_ptr + ", i64 0, i64 " + field_idx.to_string())
            this.emit_indent("store i64 " + val + ", i64* " + field_slot)
            i = i + 1
        }
        // Cast pointer to i64 for storage
        var as_int: String = this.typed_ptr_to_val(arr_ptr, "[" + num_slots.to_string() + " x i64]*")
        this.last_type = AST.Type.EnumType(enum_name); return as_int
    }

    /// Emit (once per module) `__enum_eq_<Name>`, the structural equality of a
    /// heap-encoded enum, and return its symbol. See the #116 arm in gen_binary
    /// for why the comparison is a *generated* function rather than a runtime
    /// helper: variant arity and field types live only in `enum_variant_fields`,
    /// and the `[tag, f0, ...]` array carries nothing a runtime helper could read
    /// to recover them.
    ///
    /// Shape of the emitted body: bitwise-identical fast path, a guard that both
    /// operands really are bare heap pointers, null checks, tag equality, then a
    /// switch to a per-variant arm that compares that variant's fields in order.
    /// A fieldless variant's arm is just "the tags matched", which is what makes
    /// `Option.None == Option.None` true.
    fun ensure_enum_eq(enum_name: String): String {
        var sym: String = "__enum_eq_" + this.sanitize_name(enum_name)
        if (this.str_in_list(this.defined_funcs, sym)) { return sym }
        // Registered BEFORE the body is built. A recursive enum — `enum Tree {
        // Leaf, Node(l: Tree, r: Tree) }` — reaches ensure_enum_eq for its own
        // name while emitting its payload compare, and this is what makes that
        // emit a self-call instead of expanding forever.
        this.defined_funcs.push(sym)

        var variants: List<String> = this.enum_defs.get(enum_name)

        // Emit into a scratch buffer and park the result in `globals`, the same
        // save/restore as a nested lambda (closures_body.sf). Doing it this way
        // rather than by string concatenation is what keeps the pointer and
        // untag helpers — and so wasm32's i32 pointers — working here for free.
        // The save/restore nests correctly, which matters because the recursive
        // case above re-enters this function mid-body.
        var saved_sb: StringBuilder = this.sb
        var saved_term: Bool = this.block_terminated
        var saved_counter: Float = this.local_counter
        var saved_in_fn: Bool = this.in_function
        this.sb = StringBuilder()
        this.local_counter = 0
        this.block_terminated = false
        this.in_function = true

        var linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            linkage = "define"
        }

        var l_eq: String = this.fresh_label("eeq.yes")
        var l_ne: String = this.fresh_label("eeq.no")
        var l_shape: String = this.fresh_label("eeq.shape")
        var l_null: String = this.fresh_label("eeq.null")
        var l_tags: String = this.fresh_label("eeq.tags")
        var l_disp: String = this.fresh_label("eeq.disp")

        this.emit("")
        this.emit(linkage + " i64 @" + sym + "(i64 %a, i64 %b) {")
        this.emit("entry:")
        var same: String = this.fresh_local()
        this.emit_indent(same + " = icmp eq i64 %a, %b")
        this.emit_terminator("br i1 " + same + ", label %" + l_eq + ", label %" + l_shape)

        // A well-formed value of a heap-encoded enum is a BARE pointer — the
        // construction path ends at a plain ptrtoint, with no NaN-box tag — so
        // its top 16 bits are zero. Anything else (a nil, an int, a value of
        // another type reaching here through an `Any`) is not a comparable
        // payload, and the loads below would dereference its tag bits. Such an
        // operand answers with the bitwise comparison instead, which is what the
        // fast path above already decided: unequal.
        this.start_block(l_shape)
        var ahi: String = this.fresh_local()
        this.emit_indent(ahi + " = lshr i64 %a, 48")
        var bhi: String = this.fresh_local()
        this.emit_indent(bhi + " = lshr i64 %b, 48")
        var ahi_nz: String = this.fresh_local()
        this.emit_indent(ahi_nz + " = icmp ne i64 " + ahi + ", 0")
        var bhi_nz: String = this.fresh_local()
        this.emit_indent(bhi_nz + " = icmp ne i64 " + bhi + ", 0")
        var not_ptr: String = this.fresh_local()
        this.emit_indent(not_ptr + " = or i1 " + ahi_nz + ", " + bhi_nz)
        this.emit_terminator("br i1 " + not_ptr + ", label %" + l_ne + ", label %" + l_null)

        this.start_block(l_null)
        var a_z: String = this.fresh_local()
        this.emit_indent(a_z + " = icmp eq i64 %a, 0")
        var b_z: String = this.fresh_local()
        this.emit_indent(b_z + " = icmp eq i64 %b, 0")
        var either_z: String = this.fresh_local()
        this.emit_indent(either_z + " = or i1 " + a_z + ", " + b_z)
        this.emit_terminator("br i1 " + either_z + ", label %" + l_ne + ", label %" + l_tags)

        this.start_block(l_tags)
        var pa: String = this.val_to_typed_ptr("%a", "i64*")
        var pb: String = this.val_to_typed_ptr("%b", "i64*")
        var ta: String = this.fresh_local()
        this.emit_indent(ta + " = load i64, i64* " + pa)
        var tb: String = this.fresh_local()
        this.emit_indent(tb + " = load i64, i64* " + pb)
        var tag_eq: String = this.fresh_local()
        this.emit_indent(tag_eq + " = icmp eq i64 " + ta + ", " + tb)
        this.emit_terminator("br i1 " + tag_eq + ", label %" + l_disp + ", label %" + l_ne)

        // Tag first, then payload. Without the tag test a future payload
        // comparison could let `None == Some(0)` answer true, since a fieldless
        // variant has no field to disagree about.
        var arm_labels: List<String> = []
        var ai: Float = 0
        while (ai < variants.length()) {
            arm_labels.push(this.fresh_label("eeq.v"))
            ai = ai + 1
        }
        var cases: String = ""
        ai = 0
        while (ai < variants.length()) {
            cases = cases + " i64 " + ai.floor().to_string() + ", label %" + arm_labels[ai]
            ai = ai + 1
        }
        this.start_block(l_disp)
        // Default arm: the tags agree but name no declared variant, so the value
        // is not one this enum can produce and its shape is unknown. Unequal is
        // the only answer that cannot read past the allocation.
        this.emit_terminator("switch i64 " + ta + ", label %" + l_ne + " [" + cases + " ]")

        ai = 0
        while (ai < variants.length()) {
            var vname: String = variants[ai]
            var vkey: String = enum_name + "." + vname
            var vfields: String = ""
            if (this.enum_variant_fields.has(vkey)) { vfields = this.enum_variant_fields.get(vkey) }
            this.start_block(arm_labels[ai])
            if (vfields.length() == 0) {
                // Fieldless variant of a heap-encoded enum: a one-slot [tag]
                // array. The tags already matched and there is nothing else
                // allocated to read, so these two values ARE equal — the case
                // that made `Option.None == Option.None` false.
                this.emit_terminator("br label %" + l_eq)
            } else {
                var fparts: List<String> = this.split_respecting_generics(vfields, ",")
                var fi: Float = 0
                while (fi < fparts.length()) {
                    var slot_idx: Float = fi + 1
                    var a_slot: String = this.fresh_local()
                    this.emit_indent(a_slot + " = getelementptr i64, i64* " + pa + ", i64 " + slot_idx.floor().to_string())
                    var a_val: String = this.fresh_local()
                    this.emit_indent(a_val + " = load i64, i64* " + a_slot)
                    var b_slot: String = this.fresh_local()
                    this.emit_indent(b_slot + " = getelementptr i64, i64* " + pb + ", i64 " + slot_idx.floor().to_string())
                    var b_val: String = this.fresh_local()
                    this.emit_indent(b_val + " = load i64, i64* " + b_slot)
                    var f_type: String = this.declared_field_type(fparts[fi])
                    var f_eq: String = this.emit_enum_field_eq(f_type, a_val, b_val)
                    // Fields are compared in order and short-circuit to "not
                    // equal", so a difference in the FIRST field and a difference
                    // in the LAST are both detected.
                    var l_next: String = this.fresh_label("eeq.f")
                    this.emit_terminator("br i1 " + f_eq + ", label %" + l_next + ", label %" + l_ne)
                    this.start_block(l_next)
                    fi = fi + 1
                }
                this.emit_terminator("br label %" + l_eq)
            }
            ai = ai + 1
        }

        this.start_block(l_eq)
        this.emit_terminator("ret i64 1")
        this.start_block(l_ne)
        this.emit_terminator("ret i64 0")
        this.emit("}")
        this.block_terminated = false

        var ir: String = this.sb.to_string()
        this.sb = saved_sb
        this.block_terminated = saved_term
        this.local_counter = saved_counter
        this.in_function = saved_in_fn
        this.globals.push(ir)
        return sym
    }

    /// The declared type of one entry of an `enum_variant_fields` string
    /// ("value:Int" → "Int"). Unlike `get_variant_field_type` this does NOT
    /// collapse the answer onto the handful of names codegen lowers with —
    /// equality needs to tell a nested enum and a class apart, and that
    /// distinction is exactly what the collapse discards. An entry without a
    /// type is "Any", the honest answer for "the source did not say".
    fun declared_field_type(field_def: String): String {
        if (!field_def.contains(":")) { return "Any" }
        var parts: List<String> = field_def.split(":")
        if (parts.length() < 2) { return "Any" }
        return parts[1]
    }

    /// Emit the comparison of one enum payload slot and return the `i1` register
    /// holding "equal". The comparison is chosen by the field's DECLARED type,
    /// which is the whole reason this lives in codegen: the slot itself is an
    /// opaque i64 and nothing in it says which of these comparisons is right.
    fun emit_enum_field_eq(decl_type: String, av: String, bv: String): String {
        var base: String = this.generic_base_name(decl_type)

        // Identity mode has no tags, so no representation to interpret: every
        // field is its bits. It also links against base.ll, which has no
        // __any_eq at all, so the runtime fallback below is not available here.
        if (this.identity_mode and base != "String") {
            var idc: String = this.fresh_local()
            this.emit_indent(idc + " = icmp eq i64 " + av + ", " + bv)
            return idc
        }

        if (base == "String") {
            // Two equal strings need not share a pointer, which is the same
            // reason gen_binary routes String == to this helper.
            var sr: String = this.fresh_local()
            this.emit_indent(sr + " = call i64 @__string_eq(i64 " + av + ", i64 " + bv + ")")
            var sc: String = this.fresh_local()
            this.emit_indent(sc + " = icmp ne i64 " + sr + ", 0")
            return sc
        }

        if (base == "Float" or base == "Number") {
            // gen_enum_construct normalises a Float/Number payload to a double
            // on construction, so both slots hold the same representation here.
            // Comparing at double level is still the right lowering rather than
            // a bit compare: it is what makes -0.0 equal 0.0, and it matches the
            // Float arm of gen_binary.
            var ad: String = this.emit_untag_float(av)
            var bd: String = this.emit_untag_float(bv)
            var fc: String = this.fresh_local()
            this.emit_indent(fc + " = fcmp oeq double " + ad + ", " + bd)
            return fc
        }

        // A nested value of a heap-encoded enum recurses structurally, so
        // equality is deep for the whole enum tree and not just its top level.
        if (this.enum_defs.has(base) and this.get_max_fields(base) > 0) {
            var sub: String = this.ensure_enum_eq(base)
            var sr2: String = this.fresh_local()
            this.emit_indent(sr2 + " = call i64 @" + sub + "(i64 " + av + ", i64 " + bv + ")")
            var sc2: String = this.fresh_local()
            this.emit_indent(sc2 + " = icmp ne i64 " + sr2 + ", 0")
            return sc2
        }

        // Bit equality covers the cases whose representation the declared type
        // already pins down to a unique pattern per value (a tagged Int, a
        // tagged Bool, a fieldless enum's `tag << 56` immediate), and it is also
        // the deliberate answer for a reference type: two class instances, Lists
        // or Maps compare by identity here for exactly the reason they do
        // everywhere else in the language — value equality for a mutable
        // reference is a separate design question, not something enum equality
        // should decide on its own.
        if (base == "Int" or base == "Bool" or base == "Nil") { return this.emit_bit_eq(av, bv) }
        if (this.enum_defs.has(base)) { return this.emit_bit_eq(av, bv) }
        if (this.class_fields.has(base)) { return this.emit_bit_eq(av, bv) }
        if (base == "List" or base == "Map" or base == "Set" or base == "StringBuilder") {
            return this.emit_bit_eq(av, bv)
        }

        // Anything left is a type this site cannot resolve: an `Any` field, or a
        // generic parameter (`enum Result<T, E> { Ok(value: T) }` — T names
        // nothing at the IR level). A static choice would be a guess, so defer
        // to the one comparison that reads the operands' actual tags. That is
        // the same delegation gen_binary makes for an `Any` operand, and the
        // same one #104 made for ordering.
        var ar: String = this.fresh_local()
        this.emit_indent(ar + " = call i64 @__any_eq(i64 " + av + ", i64 " + bv + ")")
        var ac: String = this.fresh_local()
        this.emit_indent(ac + " = icmp ne i64 " + ar + ", 0")
        return ac
    }

    fun emit_bit_eq(av: String, bv: String): String {
        var c: String = this.fresh_local()
        this.emit_indent(c + " = icmp eq i64 " + av + ", " + bv)
        return c
    }

    /// The write half of the #118 member-read guard: is `object.field = ...` an
    /// assignment to a member that a module alias does not have?
    ///
    /// `gen_set_field` resolves a module write by looking `prefix + field` up in
    /// `module_globals`, and on a miss falls through to the class-instance path,
    /// which evaluates the bare alias as if it were a local and emits
    /// `load i64, i64* %Math` — an SSA name that was never defined. The module
    /// then fails `opt` verification, and the failure is reported as a compiler
    /// bug for what is a typo in the user's program (BUGS #122, the write half of
    /// #118).
    ///
    /// The alias is *known to be a module* here and nowhere downstream, so this
    /// is the only place absence is expressible — same shape as the read guard,
    /// and the same reason each path reaching the fallback needs its own report
    /// (can't-express-unknown family: #22/#40/#78/#37/#103/#113/#114/#118).
    ///
    /// Returns true when it has reported; the caller must then not lower the
    /// store. Every early `return false` is a spelling that must keep working:
    /// a name that merely *looks* like an alias but is shadowed by a local, a
    /// class or enum of that name, and a member that really does exist.
    fun report_missing_module_write(object: AST.Expr, field: String): Bool {
        var obj_name: String = this.get_variable_name(object)
        if (obj_name.length() == 0) { return false }
        if (!this.module_prefixes.has(obj_name)) { return false }
        // A local, parameter or global of the same name shadows the alias: the
        // write is a field store on that value, not a module write. Checked
        // before the member lookup because a shadowed alias has no members.
        if (this.typed_vars.has(obj_name)) { return false }
        if (this.global_var_types.has(obj_name)) { return false }
        if (this.module_globals.has(obj_name)) { return false }
        if (this.current_prefix.length() > 0 and this.module_globals.has(this.current_prefix + obj_name)) { return false }
        if (this.global_var_types.has(this.current_prefix + obj_name)) { return false }
        // An enum or class spelled like the alias is not a namespace write.
        if (this.enum_defs.has(obj_name)) { return false }
        if (this.class_fields.has(obj_name)) { return false }
        if (this.enum_variant_tags.has(obj_name + "." + field)) { return false }
        if (this.named_imports.has(obj_name + "." + field)) { return false }
        // The member itself: a module global is a legitimate write target
        // (`Math.pi = 3.0`, `Flag.enabled = true` in test/cross_module_global.sf),
        // and this is exactly the lookup `gen_set_field` makes before its
        // fall-through.
        var resolved: String = this.module_prefixes.get(obj_name) + field
        if (this.module_globals.has(resolved)) { return false }
        if (this.global_var_types.has(resolved)) { return false }
        // A member that EXISTS but is not a variable — a function, a class, an
        // enum — reaches the same fall-through and gets the same invalid IR, so
        // reporting only absence would leave the hole open for `Math.abs = 1`.
        // Measured: `Math.abs = 1`, `IO.println = 1`, `Inner.Widget = 1` and
        // `Inner.Colour = 1` each gave exit 0 and `load i64, i64* %Math` with the
        // absence check alone. A second message rather than one, because "you
        // typed a name that does not exist" and "that name exists and is not
        // assignable" are different mistakes.
        var not_assignable: Bool = false
        if (this.str_in_list(this.known_functions, resolved)) { not_assignable = true }
        if (this.class_fields.has(resolved)) { not_assignable = true }
        if (this.class_struct_names.has(resolved)) { not_assignable = true }
        if (this.enum_defs.has(resolved)) { not_assignable = true }
        if (not_assignable) {
            IO.println("[codegen] Error: cannot assign to '" + field + "' in module '" + obj_name + "' — it is not a variable")
            this.has_errors = true
            return true
        }
        IO.println("[codegen] Error: no member '" + field + "' in module '" + obj_name + "'")
        this.has_errors = true
        return true
    }

    // @codegen-split: match
    fun gen_match(subject: AST.Expr, arms: List<AST.MatchArm>): String {
        var subj: String = this.gen_arg_value(subject)
        var subj_type: String = this.type_to_string(this.last_type)
        var result_ptr: String = this.fresh_local()
        this.emit_indent(result_ptr + " = alloca i64")

        // Give every arm binding a slot to be stored into before any arm block
        // exists, so the alloca dominates all of them (BUGS #106). Only names that
        // collide with a module global get one here; every other binding already
        // has an alloca from the enclosing frame's hoist list. Emitted for all
        // three lowerings below — enum switch, class pattern, unknown enum — since
        // each stores into the same `%<name>` slots.
        this.ensure_arm_slots(this.all_arm_bound_names(arms))

        // Determine which enum from first arm's pattern
        var first_arm: AST.MatchArm = arms[0]
        var first_pattern: AST.Pattern = match (first_arm) { Arm(p, b) => p
            _ => AST.Pattern.VariantPattern("", [])
        }
        var first_variant: String = match (first_pattern) { VariantPattern(v, b) => v
            _ => ""
        }

        // Check if this is a string literal match (prefix "__strpat:")
        if (first_variant.starts_with("__strpat:")) {
            // String literal match — generate if/else chain with __string_eq
            var end_label: String = this.fresh_label("match.end")
            var match_result_type: AST.Type = AST.Type.StringType
            var i: Float = 0
            while (i < arms.length()) {
                var arm: AST.MatchArm = arms[i]
                var arm_pattern: AST.Pattern = match (arm) { Arm(p, b) => p
                    _ => AST.Pattern.VariantPattern("", [])
                }
                var arm_body: AST.Expr = match (arm) { Arm(p, b) => b
                    _ => AST.Expr.NilLit
                }
                var arm_vname: String = match (arm_pattern) { VariantPattern(v, b) => v
                    _ => ""
                }

                if (arm_vname == "_") {
                    // Default/wildcard arm — just generate body
                    var val: String = this.gen_arg_value(arm_body)
                    if (i == 0) { match_result_type = this.last_type }
                    this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
                    this.emit_terminator("br label %" + end_label)
                } else if (arm_vname.starts_with("__strpat:")) {
                    // String pattern arm — compare with __string_eq
                    var str_val: String = arm_vname.slice(9, arm_vname.length())
                    var const_name: String = this.add_string_constant(str_val)
                    var len: Float = str_val.length() + 1
                    var gep: String = this.fresh_local()
                    this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
                    var pattern_val: String = this.ptr_to_val(gep)
                    var eq_result: String = this.fresh_local()
                    this.emit_indent(eq_result + " = call i64 @__string_eq(i64 " + subj + ", i64 " + pattern_val + ")")
                    var cmp: String = this.fresh_local()
                    this.emit_indent(cmp + " = trunc i64 " + eq_result + " to i1")
                    var then_label: String = this.fresh_label("match.arm")
                    var next_label: String = this.fresh_label("match.next")
                    this.emit_terminator("br i1 " + cmp + ", label %" + then_label + ", label %" + next_label)
                    // Arm body
                    this.start_block(then_label)
                    var val: String = this.gen_arg_value(arm_body)
                    if (i == 0) { match_result_type = this.last_type }
                    this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
                    this.emit_terminator("br label %" + end_label)
                    // Continue to next arm
                    this.start_block(next_label)
                }
                i = i + 1
            }
            // If no arm matched (no wildcard), store nil
            this.emit_indent("store i64 0, i64* " + result_ptr)
            this.emit_terminator("br label %" + end_label)
            this.start_block(end_label)
            var result: String = this.fresh_local()
            this.emit_indent(result + " = load i64, i64* " + result_ptr)
            this.last_type = match_result_type
            // LLVM lib parallel path: track string match result
            if (!this.identity_mode) {
                var smr: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
                this.llvm_values.set(result, smr)
            }
            return result
        }

        var enum_name: String = this.find_enum_for_variant(first_variant)

        // If enum not found, just generate the first arm's body as default
        if (enum_name == "Unknown") {
            // Unknown enum — extract bindings from subject using array encoding
            var first_bindings: List<String> = match (first_pattern) { VariantPattern(v, b) => b
                _ => []
            }
            // `match (x) { is Dog(d) => ..., is Cat(c) => ... }` — class
            // patterns, not enum variants. There is no payload to index into:
            // the binding IS the subject.
            //
            // This used to pick ONE arm at compile time by comparing each arm's
            // name against the subject's static type, because codegen had no
            // runtime class identity. With an `Any` subject — the only shape
            // where a class match is useful — no name matched, so every arm fell
            // through to `_` (measured behaviour in BUGS #61: not "the first arm
            // wins", but "all of them lose"). It now emits an if/else chain of
            // __class_is_a tests, the same shape as the string-literal match
            // above, so the arm is chosen by the object's actual class.
            //
            // Bindings still have to be registered in typed_vars or `d.bark()`
            // cannot resolve, and since BUGS #37 an unresolved Variable is a
            // hard error rather than a silent bad load.
            if (this.class_fields.has(first_variant)) {
                var cls_end: String = this.fresh_label("match.end")
                var cls_type: AST.Type = AST.Type.AnyType
                var cls_wild: Float = -1
                var ci: Float = 0
                while (ci < arms.length()) {
                    var cpat: AST.Pattern = this.get_arm_pattern(arms[ci])
                    var cname: String = match (cpat) { VariantPattern(v, b) => v
                        _ => ""
                    }
                    var cbinds: List<String> = this.get_pattern_bindings(cpat)
                    var cbody: AST.Expr = this.get_arm_body(arms[ci])
                    if (cname == "_") {
                        // Emit the wildcard last, after every test has failed —
                        // its position in the source does not make it a guard.
                        cls_wild = ci
                    } else {
                        var ctest: String = this.gen_class_tag_check_i1(subj, cname)
                        if (ctest.length() == 0) {
                            // Not a class we can test for. Skipping the arm
                            // silently is what made #61 invisible, so say so.
                            IO.println("[codegen] Warning: match arm `is " + cname + "` cannot be tested at runtime and is skipped")
                        } else {
                            var cthen: String = this.fresh_label("match.arm")
                            var cnext: String = this.fresh_label("match.next")
                            this.emit_terminator("br i1 " + ctest + ", label %" + cthen + ", label %" + cnext)
                            this.start_block(cthen)
                            // Same arm scoping as the enum path below (BUGS #106):
                            // `is Dog(d)` binds `d` for this arm only, and `d` may
                            // well name something in the enclosing scope.
                            var cscope: List<String> = []
                            if (cbinds.length() >= 1) { cscope.push(cbinds[0]) }
                            var csaved: List<String> = this.save_arm_slots(cscope)
                            var ctypes: List<String> = this.save_arm_types(cscope)
                            if (cbinds.length() >= 1) {
                                this.emit_indent("store i64 " + subj + ", i64* " + this.arm_slot_ref(cbinds[0]))
                                this.typed_vars.set(cbinds[0], this.str_to_type(cname))
                            }
                            var cval: String = this.gen_arg_value(cbody)
                            if (ci == 0) { cls_type = this.last_type }
                            this.emit_indent("store i64 " + cval + ", i64* " + result_ptr)
                            this.restore_arm_slots(cscope, csaved)
                            this.restore_arm_types(cscope, ctypes)
                            this.emit_terminator("br label %" + cls_end)
                            this.start_block(cnext)
                        }
                    }
                    ci = ci + 1
                }
                if (cls_wild >= 0) {
                    var wpat: AST.Pattern = this.get_arm_pattern(arms[cls_wild.floor()])
                    var wbinds: List<String> = this.get_pattern_bindings(wpat)
                    var wscope: List<String> = []
                    if (wbinds.length() >= 1) { wscope.push(wbinds[0]) }
                    var wsaved: List<String> = this.save_arm_slots(wscope)
                    var wtypes: List<String> = this.save_arm_types(wscope)
                    if (wbinds.length() >= 1) {
                        this.emit_indent("store i64 " + subj + ", i64* " + this.arm_slot_ref(wbinds[0]))
                    }
                    var wval: String = this.gen_arg_value(this.get_arm_body(arms[cls_wild.floor()]))
                    if (cls_wild == 0) { cls_type = this.last_type }
                    this.emit_indent("store i64 " + wval + ", i64* " + result_ptr)
                    this.restore_arm_slots(wscope, wsaved)
                    this.restore_arm_types(wscope, wtypes)
                } else {
                    // No wildcard and nothing matched. Storing nil keeps this an
                    // indeterminate value rather than a fault — the same gap as
                    // the string match above and BUGS #37's general case.
                    this.emit_indent("store i64 0, i64* " + result_ptr)
                }
                this.emit_terminator("br label %" + cls_end)
                this.start_block(cls_end)
                var cls_result: String = this.fresh_local()
                this.emit_indent(cls_result + " = load i64, i64* " + result_ptr)
                this.last_type = cls_type
                if (!this.identity_mode) {
                    var cmr: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
                    this.llvm_values.set(cls_result, cmr)
                }
                return cls_result
            }
            var ue_saved: List<String> = this.save_arm_slots(first_bindings)
            var ue_types: List<String> = this.save_arm_types(first_bindings)
            if (first_bindings.length() >= 1) {
                // Array encoding: inttoptr → GEP for each binding
                var num_slots: Float = first_bindings.length() + 1
                var total_str: String = num_slots.floor().to_string()
                var arr_ptr: String = this.val_to_typed_ptr(subj, "[" + total_str + " x i64]*")
                var bi: Float = 0
                while (bi < first_bindings.length()) {
                    var bname: String = first_bindings[bi]
                    var field_idx: Float = bi + 1
                    var field_slot: String = this.fresh_local()
                    this.emit_indent(field_slot + " = getelementptr [" + total_str + " x i64], [" + total_str + " x i64]* " + arr_ptr + ", i64 0, i64 " + field_idx.floor().to_string())
                    var extracted: String = this.fresh_local()
                    this.emit_indent(extracted + " = load i64, i64* " + field_slot)
                    this.emit_indent("store i64 " + extracted + ", i64* " + this.arm_slot_ref(bname))
                    bi = bi + 1
                }
            }
            var body_expr: AST.Expr = match (first_arm) { Arm(p, b) => b
                _ => AST.Expr.NilLit
            }
            var val: String = this.gen_arg_value(body_expr)
            this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
            this.restore_arm_slots(first_bindings, ue_saved)
            this.restore_arm_types(first_bindings, ue_types)
            var result: String = this.fresh_local()
            this.emit_indent(result + " = load i64, i64* " + result_ptr)
            // LLVM lib parallel path: track unknown-enum match result
            if (!this.identity_mode) {
                var umr: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
                this.llvm_values.set(result, umr)
            }
            return result
        }

        // Determine max fields across variants to pick encoding
        var max_fields: Float = this.get_max_fields(enum_name)

        // Extract tag based on encoding
        var tag_val: String = this.fresh_local()
        if (max_fields == 0) {
            // No-data enum: tag << 56 encoding
            var tag_shifted: String = this.fresh_local()
            this.emit_indent(tag_shifted + " = lshr i64 " + subj + ", 56")
            this.emit_indent(tag_val + " = trunc i64 " + tag_shifted + " to i8")
        } else {
            // Enum with data: heap-allocated array encoding, tag at array[0]
            var arr_ptr: String = this.val_to_typed_ptr(subj, "i64*")
            var tag_i64: String = this.fresh_local()
            this.emit_indent(tag_i64 + " = load i64, i64* " + arr_ptr)
            this.emit_indent(tag_val + " = trunc i64 " + tag_i64 + " to i8")
        }

        // Build switch
        var end_label: String = this.fresh_label("match.end")
        var arm_labels: List<String> = []
        var i: Float = 0
        while (i < arms.length()) {
            arm_labels.push(this.fresh_label("match.arm"))
            i = i + 1
        }

        var default_label: String = end_label
        var switch_cases: String = ""
        i = 0
        while (i < arms.length()) {
            var arm: AST.MatchArm = arms[i]
            var pattern: AST.Pattern = match (arm) { Arm(p, b) => p
                _ => AST.Pattern.VariantPattern("", [])
            }
            if (this.is_wildcard_in_enum(pattern, enum_name)) {
                default_label = arm_labels[i]
            } else {
                var variant_name: String = match (pattern) { VariantPattern(v, b) => v
                    _ => ""
                }
                var lookup_key: String = enum_name + "." + variant_name
                if (this.enum_variant_tags.has(lookup_key)) {
                    var tag_idx: Float = this.enum_variant_tags.get(lookup_key)
                    switch_cases = switch_cases + " i8 " + tag_idx.floor().to_string() + ", label %" + arm_labels[i]
                }
            }
            i = i + 1
        }
        this.emit_terminator("switch i8 " + tag_val + ", label %" + default_label + " [" + switch_cases + " ]")

        // Generate each arm
        var match_result_type: AST.Type = AST.Type.IntType
        i = 0
        while (i < arms.length()) {
            this.start_block(arm_labels[i])
            var arm: AST.MatchArm = arms[i]
            var pattern: AST.Pattern = match (arm) { Arm(p, b) => p
                _ => AST.Pattern.VariantPattern("", [])
            }
            var body_expr: AST.Expr = match (arm) { Arm(p, b) => b
                _ => AST.Expr.NilLit
            }

            // Extract bindings from payload and set their types
            var arm_variant: String = match (pattern) { VariantPattern(v, b) => v
                _ => ""
            }
            // A NamedWildcard binds the subject itself, not a payload field, so
            // it is stored directly rather than GEP'd out of the enum's payload.
            var nw_name: String = match (pattern) { NamedWildcard(n) => n   _ => "" }
            // Every name this arm binds — a NamedWildcard binds one too, and it
            // shadows an enclosing variable exactly the same way.
            var arm_names: List<String> = []
            if (nw_name.length() > 0) {
                arm_names.push(nw_name)
            }
            var bindings: List<String> = match (pattern) { VariantPattern(v, b) => b
                _ => []
            }
            var bind_count: Float = bindings.length()
            var bni: Float = 0
            while (bni < bind_count) {
                arm_names.push(bindings[bni])
                bni = bni + 1
            }
            // Snapshot the slots and the static types BEFORE any payload store,
            // so the enclosing scope's variable can be put back on the way out
            // (BUGS #106).
            var saved_slots: List<String> = this.save_arm_slots(arm_names)
            var saved_types: List<String> = this.save_arm_types(arm_names)
            if (nw_name.length() > 0) {
                this.emit_indent("store i64 " + subj + ", i64* " + this.arm_slot_ref(nw_name))
                this.typed_vars.set(nw_name, this.str_to_type(enum_name))
            }
            if (bind_count > 0) {
                this.extract_arm_bindings(bindings, subj, max_fields)
                var bi: Float = 0
                while (bi < bind_count) {
                    var btype: String = this.get_variant_field_type(enum_name, arm_variant, bi)
                    this.typed_vars.set(bindings[bi], this.str_to_type(btype))
                    if (btype == "String") {
                        this.string_vars.push(bindings[bi])
                    }
                    bi = bi + 1
                }
            }
            var val: String = this.gen_arg_value(body_expr)
            if (i == 0) {
                match_result_type = this.last_type
            }
            this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
            // Restore before the branch out, not after: `end_label` is shared by
            // every arm, so a restore there would run with whichever arm's temps
            // and would not dominate. The arm body's own value is already in
            // result_ptr by now, so putting the outer variable back cannot
            // disturb it.
            this.restore_arm_slots(arm_names, saved_slots)
            this.restore_arm_types(arm_names, saved_types)
            this.emit_terminator("br label %" + end_label)
            i = i + 1
        }

        this.start_block(end_label)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = load i64, i64* " + result_ptr)
        this.last_type = match_result_type
        // LLVM lib parallel path: track match result as opaque call placeholder
        if (!this.identity_mode) {
            var match_res: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
            this.llvm_values.set(result, match_res)
        }
        return result
    }

    // --- Match-arm binding scope (BUGS #106) ---
    //
    // A match arm's bindings are a scope of their own: they shadow whatever the
    // enclosing scope calls by the same name, for the arm's extent only. Codegen
    // has no scope chain, only one flat `%<name>` slot per name, so an arm
    // binding used to be written straight into the enclosing variable's slot.
    // That had two faces:
    //
    //   At module scope the outer variable is a global at `@__g_s`, so no
    //   `%s` alloca exists at all (the alloca loops in output_body.sf skip names
    //   that are module globals). `store i64 %tN, i64* %s` was invalid IR —
    //   "use of undefined value '%s'", caught by `opt -passes=verify`. Loud.
    //
    //   Inside a function `%s = alloca i64` DOES exist, so the store landed in
    //   the outer variable's slot. A `String`-declared local silently came to
    //   hold a tagged Int: `IO.println(s)` printed the payload, `s.length()`
    //   printed 0 (a small integer dereferenced as a char*), exit 0, no
    //   diagnostic. Silent, and the reason this needed fixing.
    //
    // resolve.sf already has this right, which is worth knowing before reading the
    // fix. `resolve_arms` pushes a scope per arm and `declare_pattern` declares
    // each binding `"local"` in it, so the binding reaches codegen as
    // `Ref("local", name, "")` and expr_body.sf loads it from `%<name>`. The arm
    // IS scoped in the AST; what was missing was codegen honouring it. So the
    // slot for an arm binding is always the local one — never `@__g_`, even when
    // a module global shares the name — and the two gaps to close are:
    //
    //   1. At module scope that `%<name>` slot was never allocated, because
    //      output_body.sf's top-level alloca loop skips any name that is a module
    //      global. `ensure_arm_slots` below allocates it, in the block before the
    //      switch so it dominates every arm. The enclosing `@__g_s` is then
    //      untouched by construction, and a read of the outer `s` after the match
    //      resolves to `Ref("global")` → `@__g_s` and is correct.
    //
    //   2. Inside a function the outer variable and the binding genuinely share
    //      one `%<name>` alloca — both are locals of the same function and
    //      codegen has no scope chain to separate them. Nothing structural can be
    //      done per-slot here, so save/restore brackets the arm instead: snapshot
    //      the slot on entry to the arm, put it back before the branch out. Only
    //      one arm runs per match and each ends in an unconditional branch to the
    //      match's end label, so the restore runs exactly once on the taken path.
    //
    // Renaming the binding to a unique slot would be the other shape of fix, and
    // is what `test/oracle_stringify.sf` had to do by hand. It is not available
    // from this file: the READ sites are emitted by expr_body.sf's `Ref`/`Variable`
    // arms, which spell the slot `%<sanitize_name(name)>` with no indirection to
    // redirect.

    fun arm_slot_ref(name: String): String {
        return "%" + this.sanitize_name(name)
    }

    /// True when `name` has no `%<name>` slot in the current frame — the
    /// module-scope collision case, where the alloca loop skipped it as a global.
    fun arm_slot_missing(name: String): Bool {
        if (this.current_fn_locals.has(name)) { return false }
        return this.module_globals.has(this.current_prefix + name) or this.module_globals.has(name)
    }

    /// Allocate the slots the enclosing frame did not, and record that we did.
    ///
    /// Called from gen_match while the pre-switch block is current: an alloca
    /// outside the entry block is legal IR and this block dominates every arm
    /// block, which is all the store and load sites need. (`result_ptr` above is
    /// allocated the same way.)
    ///
    /// The bookkeeping key is `"__armslot:" + name` in `current_fn_locals`, the
    /// same namespaced-key trick stmts_body.sf uses for `"__nestedfn:"`. Two
    /// properties come for free: that map is saved and restored around every
    /// function body, so the record has exactly per-frame lifetime; and nothing
    /// reads a key with that prefix, so no dispatch or alloca decision shifts. It
    /// has to be recorded somewhere, because two matches in one scope binding the
    /// same colliding name would otherwise emit `%s = alloca i64` twice and LLVM
    /// rejects the duplicate name.
    fun ensure_arm_slots(names: List<String>) {
        var i: Float = 0
        while (i < names.length()) {
            var n: String = names[i]
            var key: String = "__armslot:" + n
            if (this.arm_slot_missing(n) and !this.current_fn_locals.has(key)) {
                this.current_fn_locals.set(key, true)
                this.emit_indent("%" + this.sanitize_name(n) + " = alloca i64")
                // Zeroed for the same reason output_body.sf zeroes GC-root
                // allocas: this slot is a save/restore source below, and an undef
                // load is not something to hand to the GC or to rt_strlen. Note
                // the slot is NOT registered as a GC root — the payload it holds
                // is reachable through the subject for the arm's extent, and
                // adding a root here would need a matching pop on every arm exit.
                this.emit_indent("store i64 0, i64* %" + this.sanitize_name(n))
            }
            i = i + 1
        }
    }

    /// Every name any arm of this match binds. Collected across all arms up front
    /// rather than per arm, because the allocas have to be emitted once, in the
    /// single block that dominates all the arm blocks.
    fun all_arm_bound_names(arms: List<AST.MatchArm>): List<String> {
        var out: List<String> = []
        var i: Float = 0
        while (i < arms.length()) {
            var pat: AST.Pattern = this.get_arm_pattern(arms[i])
            // get_pattern_bindings already folds a NamedWildcard's name in, so
            // `x => ...` shadowing an enclosing `x` is covered too.
            var bs: List<String> = this.get_pattern_bindings(pat)
            var j: Float = 0
            while (j < bs.length()) {
                if (!out.contains(bs[j])) { out.push(bs[j]) }
                j = j + 1
            }
            i = i + 1
        }
        return out
    }

    /// Snapshot each binding's slot into a fresh temp. Emitted at the top of the
    /// arm block, before the payload stores, so the temps dominate the restore.
    fun save_arm_slots(bindings: List<String>): List<String> {
        var saved: List<String> = []
        var i: Float = 0
        while (i < bindings.length()) {
            var tmp: String = this.fresh_local()
            this.emit_indent(tmp + " = load i64, i64* " + this.arm_slot_ref(bindings[i]))
            saved.push(tmp)
            i = i + 1
        }
        return saved
    }

    fun restore_arm_slots(bindings: List<String>, saved: List<String>) {
        var i: Float = 0
        while (i < bindings.length()) {
            if (i < saved.length()) {
                this.emit_indent("store i64 " + saved[i] + ", i64* " + this.arm_slot_ref(bindings[i]))
            }
            i = i + 1
        }
    }

    /// The static side of the same shadowing. `typed_vars` and `string_vars` are
    /// flat too, so registering a binding's type overwrote the enclosing
    /// variable's: after the match, a `String` local was typed Int and method
    /// dispatch on it silently picked the integer arms. "" marks a name that had
    /// no entry, which is left alone on restore.
    fun save_arm_types(bindings: List<String>): List<String> {
        var prev: List<String> = []
        var i: Float = 0
        while (i < bindings.length()) {
            if (this.typed_vars.has(bindings[i])) {
                prev.push(this.type_to_string(this.typed_vars.get(bindings[i])))
            } else {
                prev.push("")
            }
            i = i + 1
        }
        return prev
    }

    fun restore_arm_types(bindings: List<String>, prev: List<String>) {
        var i: Float = 0
        while (i < bindings.length()) {
            if (i < prev.length()) {
                var pt: String = prev[i]
                if (pt.length() > 0) {
                    this.typed_vars.set(bindings[i], this.str_to_type(pt))
                    // string_vars is consulted by is_string_variable to decide
                    // whether `+` is concatenation. An Int binding over a String
                    // local must not strip the local's entry, and a String
                    // binding over an Int local must not add one.
                    if (pt == "String") {
                        if (!this.string_vars.contains(bindings[i])) {
                            this.string_vars.push(bindings[i])
                        }
                    } else {
                        this.drop_string_var(bindings[i])
                    }
                }
            }
            i = i + 1
        }
    }

    fun drop_string_var(name: String) {
        var kept: List<String> = []
        var i: Float = 0
        while (i < this.string_vars.length()) {
            if (this.string_vars[i] != name) {
                kept.push(this.string_vars[i])
            }
            i = i + 1
        }
        this.string_vars = kept
    }

    fun extract_arm_bindings(bindings: List<String>, subj: String, max_fields: Float) {
        var bind_count: Float = bindings.length()
        // Always use array encoding: inttoptr and GEP to extract fields
        // (max_fields >= 1 means heap-allocated [tag, field0, field1, ...])
        var total: Float = bind_count + 1
        var total_str: String = total.floor().to_string()
        var arr_ptr: String = this.val_to_typed_ptr(subj, "[" + total_str + " x i64]*")
        // One extraction per binding, however many there are.
        //
        // This used to be five unrolled `if (bind_count >= n)` lines, capped at
        // five, "to avoid VM loop variable bug" — a workaround for the C VM in
        // legacy/, which has been dead and unsupported for a long time. The cap
        // outlived its reason and became a silent arity limit: gen_enum_construct
        // stores every argument in a loop, so a six-field variant was built
        // correctly and then read back with its sixth field never loaded. The
        // binding kept whatever its alloca held, which reads as 0 — and a 0 where
        // a String belongs is a null pointer the next strncmp/strlen dereferences.
        //
        // That is exactly how `ClassDecl` gaining `type_params` (BUGS #95) turned
        // into a segfault in the codegen pre-scan: the sixth field is `docstring`,
        // so `cd3.starts_with("@actor")` ran strncmp against NULL. No diagnostic,
        // no wrong-looking IR — just a truncated payload (BUGS #96).
        var bi: Float = 0
        while (bi < bind_count) {
            this.extract_one_field(bindings[bi], arr_ptr, total_str, bi + 1)
            bi = bi + 1
        }
    }

    fun extract_one_field(bname: String, arr_ptr: String, total_str: String, idx: Float) {
        var field_slot: String = this.fresh_local()
        this.emit_indent(field_slot + " = getelementptr [" + total_str + " x i64], [" + total_str + " x i64]* " + arr_ptr + ", i64 0, i64 " + idx.floor().to_string())
        var extracted: String = this.fresh_local()
        this.emit_indent(extracted + " = load i64, i64* " + field_slot)
        // arm_slot_ref, not a bare `%<name>`: at module scope a name that is a
        // module global has no alloca, and the bare form emitted a store against
        // an undefined `%s` (BUGS #106's loud face). This is also the store site
        // for `let Some(v) = ...`, where the global is likewise the right slot.
        this.emit_indent("store i64 " + extracted + ", i64* " + this.arm_slot_ref(bname))
    }

    fun get_variant_field_type(enum_name: String, variant_name: String, field_idx: Float): String {
        var key: String = enum_name + "." + variant_name
        if (!this.enum_variant_fields.has(key)) return "Int"
        var fields: String = this.enum_variant_fields.get(key)
        if (fields.length() == 0) return "Int"
        var parts: List<String> = this.split_respecting_generics(fields, ",")
        if (field_idx >= parts.length()) return "Int"
        var field_def: String = parts[field_idx.floor()]
        var name_type: List<String> = field_def.split(":")
        if (name_type.length() < 2) return "Int"
        var ftype: String = name_type[1]
        if (ftype == "String") return "String"
        // Float must stay Float. Collapsing it to Int made arithmetic on a
        // match binding emit integer ops against a NaN-boxed double, so
        // `Circle(r) => 3.14159 * r * r` evaluated to nan. Identity mode still
        // wants Int, and type_to_string_for_target already applies that.
        if (ftype == "Float" or ftype == "Number") return "Float"
        if (ftype == "Bool") return "Int"
        if (ftype.starts_with("List")) return "List<String>"
        return "Int"
    }

    fun get_max_fields(enum_name: String): Float {
        var max_f: Float = 0
        if (!this.enum_defs.has(enum_name)) return 0
        var variants: List = this.enum_defs.get(enum_name)
        var i: Float = 0
        while (i < variants.length()) {
            var vname: String = variants[i]
            var key: String = enum_name + "." + vname
            if (this.enum_variant_fields.has(key)) {
                var fields: String = this.enum_variant_fields.get(key)
                if (fields.length() > 0) {
                    var parts: List<String> = this.split_respecting_generics(fields, ",")
                    // Each part is "name:Type", count them
                    var field_count: Float = parts.length()
                    if (field_count > max_f) {
                        max_f = field_count
                    }
                }
            }
            i = i + 1
        }
        return max_f
    }


    // @codegen-split: closures
    fun gen_lambda(params: List<AST.Param>, ret_type: String, body: List<AST.Stmt>): String {
        // Find captured variables (free variables in body not in params)
        var param_names: List<String> = []
        var pi: Float = 0
        while (pi < params.length()) {
            var p: AST.Param = params[pi]
            var pname: String = match (p) { Param(n, t, d, p_vis) => n }
            param_names.push(pname)
            pi = pi + 1
        }
        var captures: List<String> = []
        this.find_free_vars_stmts(body, param_names, captures)

        // Sendable check: warn if Task.spawn captures non-Sendable variables
        if (this.check_spawn_sendable) {
            this.check_spawn_sendable = false
            var sci: Float = 0
            while (sci < captures.length()) {
                var cap_name: String = captures[sci]
                var cap_type: String = this.get_var_type_str(cap_name)
                if (cap_type.length() > 0 and cap_type != "Any" and cap_type != "Int" and cap_type != "Float" and cap_type != "Bool" and cap_type != "String" and cap_type != "Number") {
                    if (!this.actor_classes.has(cap_type) and !this.enum_defs.has(cap_type)) {
                        IO.println("[checker] Warning: Task.spawn closure captures non-Sendable variable '" + cap_name + "' (type " + cap_type + ")")
                    }
                }
                sci = sci + 1
            }
        }

        // Generate a unique name for this lambda (module-prefixed for global uniqueness)
        this.label_counter = this.label_counter + 1
        var lambda_name: String = this.current_prefix + "__lambda_" + this.label_counter.floor().to_string()

        // Check if this lambda is a coroutine (contains yield or calls a coroutine)
        if (this.force_next_lambda_coro) {
            this.coroutine_funcs.push(lambda_name)
            this.force_next_lambda_coro = false
        } else if (this.stmts_have_yield(body)) {
            this.coroutine_funcs.push(lambda_name)
        } else {
            var lambda_calls: List<String> = []
            this.collect_calls_from_stmts(body, lambda_calls)
            var lci: Float = 0
            while (lci < lambda_calls.length()) {
                if (this.str_in_list(this.coroutine_funcs,lambda_calls[lci]) or this.str_in_list(this.coroutine_funcs,this.current_prefix + lambda_calls[lci]) or this.coro_method_match(lambda_calls[lci])) {
                    this.coroutine_funcs.push(lambda_name)
                    lci = lambda_calls.length()
                }
                lci = lci + 1
            }
        }

        // Build the lambda's params: env pointer (if captures) + original params
        var params_str: String = this.params_to_string(params)
        var lambda_params: String = ""
        if (captures.length() > 0) {
            lambda_params = "__env:Int"
            if (params_str.length() > 0) {
                lambda_params = lambda_params + "," + params_str
            }
        } else {
            lambda_params = params_str
        }

        // Which of these captures the enclosing frame put in a heap cell. Computed
        // before the closure body is emitted because both sides need it: the body
        // must dereference a cell slot one extra level, and the env-store loop below
        // must write the pointer rather than a snapshot. `boxed_locals` belongs to
        // the *enclosing* function and is clobbered by gen_closure_function's own
        // body emission, so it is read here while it is still in scope.
        var boxed_caps: List<String> = []
        var bci: Float = 0
        while (bci < captures.length()) {
            if (this.boxed_locals.has(captures[bci])) {
                boxed_caps.push(captures[bci])
            }
            bci = bci + 1
        }

        // Save current state
        var saved_sb: StringBuilder = this.sb
        var saved_terminated: Bool = this.block_terminated
        var saved_counter: Float = this.local_counter
        var saved_typed_vars: Map<String, AST.Type> = this.typed_vars
        var saved_is_coro: Bool = this.is_coroutine

        // Generate the lambda function (disable nested detection to avoid interception)
        var saved_in_fn: Bool = this.in_function
        this.in_function = false
        this.sb = StringBuilder()
        if (captures.length() > 0) {
            // Custom gen: emit function header, extract captures from env, then body
            this.gen_closure_function(lambda_name, lambda_params, ret_type, body, captures, boxed_caps)
        } else {
            this.gen_function(lambda_name, params_str, ret_type, body)
        }
        this.in_function = saved_in_fn
        var lambda_ir: String = this.sb.to_string()

        // Restore state
        this.sb = saved_sb
        this.block_terminated = saved_terminated
        this.local_counter = saved_counter
        this.typed_vars = saved_typed_vars
        this.is_coroutine = saved_is_coro
        this.globals.push(lambda_ir)

        if (captures.length() > 0) {
            // Heap-allocate environment: [cap0, cap1, ...]
            var env_size: Float = captures.length()
            var env_bytes: Float = env_size * 8
            var env_raw: String = this.fresh_local()
            this.emit_indent(env_raw + " = call i8* @__sf_malloc(i64 " + env_bytes.floor().to_string() + ")")
            var env_ptr: String = this.fresh_local()
            this.emit_indent(env_ptr + " = bitcast i8* " + env_raw + " to [" + env_size.floor().to_string() + " x i64]*")
            // Store VALUES of captured variables in env (copy semantics).
            // This allows closures to escape the enclosing stack frame safely.
            //
            // Except for a capture the enclosing frame boxed: that one gets the
            // cell POINTER, so the closure and the enclosing scope address the same
            // storage and a write inside the closure is visible outside it (BUGS
            // #51 defect B). A snapshot is still right for every read-only capture
            // — and is what makes an escaping closure safe, since the enclosing
            // frame may be gone by the time it runs. The boxed cell is heap
            // allocated for that same reason.
            //
            // `boxed_locals` is the enclosing function's set, consulted here rather
            // than re-derived: the decision has to match the one that chose malloc
            // over alloca, or the env would hold a pointer to a stack slot (a
            // dangling escape) or an integer read as a pointer.
            var ci: Float = 0
            while (ci < captures.length()) {
                var cap_name0: String = captures[ci]
                var slot: String = this.fresh_local()
                this.emit_indent(slot + " = getelementptr [" + env_size.floor().to_string() + " x i64], [" + env_size.floor().to_string() + " x i64]* " + env_ptr + ", i64 0, i64 " + ci.floor().to_string())
                if (this.str_in_list(boxed_caps, cap_name0)) {
                    var cell_as_int: String = this.typed_ptr_to_val("%" + this.sanitize_name(cap_name0), "i64*")
                    this.emit_indent("store i64 " + cell_as_int + ", i64* " + slot)
                } else {
                    var cap_val: String = this.fresh_local()
                    this.emit_indent(cap_val + " = load i64, i64* %" + this.sanitize_name(cap_name0))
                    this.emit_indent("store i64 " + cap_val + ", i64* " + slot)
                }
                ci = ci + 1
            }
            // Heap-allocate closure pair: [fn_ptr, env_ptr]
            var closure_raw: String = this.fresh_local()
            this.emit_indent(closure_raw + " = call i8* @__sf_malloc(i64 16)")
            var closure_ptr: String = this.fresh_local()
            this.emit_indent(closure_ptr + " = bitcast i8* " + closure_raw + " to [2 x i64]*")
            // Store fn ptr
            var num_params: Float = param_names.length() + 1
            var ret_ty: String = "i64"
            if (this.str_in_list(this.coroutine_funcs,lambda_name)) { ret_ty = "ptr" }
            var fn_type_str: String = ret_ty + " ("
            var ti: Float = 0
            while (ti < num_params) {
                if (ti > 0) { fn_type_str = fn_type_str + ", " }
                fn_type_str = fn_type_str + "i64"
                ti = ti + 1
            }
            fn_type_str = fn_type_str + ")*"
            var fn_as_int: String = this.fn_ptr_to_val(fn_type_str, "@" + lambda_name)
            var fn_slot: String = this.fresh_local()
            this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
            // Store env ptr
            var env_as_int: String = this.typed_ptr_to_val(env_ptr, "[" + env_size.floor().to_string() + " x i64]*")
            var env_slot: String = this.fresh_local()
            this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
            this.emit_indent("store i64 " + env_as_int + ", i64* " + env_slot)
            // Return closure pointer as i64
            var result: String = this.typed_ptr_to_val(closure_ptr, "[2 x i64]*")
            // LLVM lib parallel path: track lambda/closure result as opaque value
            if (this.use_llvm_lib and !this.identity_mode) {
                this.llvm_values.set(result, LLVMTypes.Value.Constant(LLVMTypes.Const.Int(0, 64)))
            }
            return result
        }

        // No captures: create closure pair with env=0
        // Lambda needs env param too for uniform calling convention
        // Re-generate with env param
        this.globals.pop() // remove the one we just generated
        // Remove from defined_funcs so re-generation isn't skipped
        // Build a new list excluding the lambda_name (avoids List.set which
        // the bootstrap compiler mis-compiles as __map_set)
        var new_defined: List<String> = []
        var df_idx: Float = 0
        while (df_idx < this.defined_funcs.length()) {
            if (this.defined_funcs[df_idx] != lambda_name) {
                new_defined.push(this.defined_funcs[df_idx])
            }
            df_idx = df_idx + 1
        }
        this.defined_funcs = new_defined
        var saved_sb2: StringBuilder = this.sb
        var saved_terminated2: Bool = this.block_terminated
        var saved_counter2: Float = this.local_counter
        var saved_typed_vars2b: Map<String, AST.Type> = this.typed_vars
        var saved_in_fn2: Bool = this.in_function
        this.in_function = false
        this.sb = StringBuilder()
        var full_params: String = "__env:Int"
        if (params_str.length() > 0) {
            full_params = full_params + "," + params_str
        }
        this.gen_function(lambda_name, full_params, ret_type, body)
        this.globals.push(this.sb.to_string())
        this.in_function = saved_in_fn2
        this.sb = saved_sb2
        this.block_terminated = saved_terminated2
        this.local_counter = saved_counter2
        this.typed_vars = saved_typed_vars2b

        // Heap-allocate closure pair: [fn_ptr, 0]
        var closure_raw: String = this.fresh_local()
        this.emit_indent(closure_raw + " = call i8* @__sf_malloc(i64 16)")
        var closure_ptr: String = this.fresh_local()
        this.emit_indent(closure_ptr + " = bitcast i8* " + closure_raw + " to [2 x i64]*")
        var num_total_params: Float = param_names.length() + 1
        var nocap_ret_ty: String = "i64"
        if (this.str_in_list(this.coroutine_funcs,lambda_name)) { nocap_ret_ty = "ptr" }
        var fn_type_str: String = nocap_ret_ty + " ("
        var tti: Float = 0
        while (tti < num_total_params) {
            if (tti > 0) { fn_type_str = fn_type_str + ", " }
            fn_type_str = fn_type_str + "i64"
            tti = tti + 1
        }
        fn_type_str = fn_type_str + ")*"
        var fn_as_int: String = this.fn_ptr_to_val(fn_type_str, "@" + lambda_name)
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        this.emit_indent("store i64 0, i64* " + env_slot)
        var result: String = this.typed_ptr_to_val(closure_ptr, "[2 x i64]*")
        // LLVM lib parallel path: track lambda/closure result as opaque value
        if (this.use_llvm_lib and !this.identity_mode) {
            this.llvm_values.set(result, LLVMTypes.Value.Constant(LLVMTypes.Const.Int(0, 64)))
        }
        return result
    }

    fun gen_closure_function(name: String, params: String, ret_type: String, body: List<AST.Stmt>, captures: List<String>, boxed_caps: List<String>) {
        this.known_functions.push(name)
        // We are about to emit a function body, so `in_function` must be true for
        // the duration.
        //
        // gen_lambda sets it to *false* before calling us — that is deliberate, and
        // is what stops gen_function from treating the lambda as a nested function
        // and hoisting it. But `in_function` is overloaded: it also means "emitted
        // code lives inside a function body", and several expression cases branch
        // on it. NilLit is the load-bearing one: outside a function it emits the
        // literal "0" (correct for a module-level initialiser, where no runtime
        // call can be made), and inside one it emits `call i64 @__val_nil()`.
        //
        // Under NaN boxing nil is 0x7FF8000000000002, not 0, so leaving the flag
        // false made every `return nil` in a capturing closure return integer 0 —
        // which is neither nil nor a valid pointer. `x == nil` was then false for a
        // value that *was* nil, and dereferencing it segfaulted.
        //
        // Restored at the end rather than hard-cleared, so the outer emitter's
        // notion of where it is survives.
        var saved_in_function: Bool = this.in_function
        this.in_function = true
        // Save outer-scope types for captured variables before resetting
        var outer_typed_vars: Map<String, AST.Type> = {}
        var oci: Float = 0
        while (oci < captures.length()) {
            var ocn: String = captures[oci]
            if (this.typed_vars.has(ocn)) {
                outer_typed_vars.set(ocn, this.typed_vars.get(ocn))
            }
            oci = oci + 1
        }
        this.reset_locals()
        this.typed_vars = {}
        this.string_vars = []
        var ret_llvm: String = this.llvm_type(ret_type)
        this.current_ret_type = ret_llvm

        // Check if this closure is a coroutine
        var is_coro: Bool = this.str_in_list(this.coroutine_funcs,name)
        this.is_coroutine = is_coro

        var param_list: List<String> = []
        if (params.length() > 0) {
            param_list = this.split_respecting_generics(params, ",")
        }

        var param_strs: List<String> = []
        var i: Float = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            param_strs.push(this.llvm_type(ptype) + " %" + this.sanitize_name(pname) + ".arg")
            i = i + 1
        }

        this.emit("")
        var closure_linkage: String = "define"
        if (this.current_prefix.length() > 0) {
            // On WASM targets, linkonce_odr breaks indirect calls (function table index
            // mismatch after linker deduplication). Use plain define with unique names.
            if (this.target != "wasm" and this.target != "wasm64" and this.target != "wasm32") {
                closure_linkage = "define linkonce_odr"
            }
        }
        var coro_attr: String = ""
        var ret_type_ll: String = ret_llvm
        if (is_coro) {
            coro_attr = " noinline optnone presplitcoroutine"
            ret_type_ll = "ptr"
        }
        this.emit(closure_linkage + " " + ret_type_ll + " @" + name + "(" + param_strs.join(", ") + ")" + coro_attr + " {")
        this.emit("entry:")
        this.block_terminated = false

        // Coroutine preamble
        if (is_coro) {
            this.emit_indent("%__coro_id = call token @llvm.coro.id(i32 0, ptr null, ptr null, ptr null)")
            this.emit_indent("%__coro_size = call i64 @llvm.coro.size.i64()")
            this.emit_indent("%__coro_mem = call ptr @__sf_malloc(i64 %__coro_size)")
            this.emit_indent("%__coro_hdl = call ptr @llvm.coro.begin(token %__coro_id, ptr %__coro_mem)")
        }

        // Alloca all params and register in typed_vars
        i = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            this.emit_indent("%" + this.sanitize_name(pname) + " = alloca " + this.llvm_type(ptype))
            this.emit_indent("store " + this.llvm_type(ptype) + " %" + this.sanitize_name(pname) + ".arg, " + this.llvm_type(ptype) + "* %" + this.sanitize_name(pname))
            this.typed_vars.set(pname, this.str_to_type(ptype))
            i = i + 1
        }

        // Extract capture POINTERS from __env (reference semantics)
        // Env stores the actual i64 values of captured variables — we point directly
        // at the env slots so mutations persist between closure calls.
        var env_size: Float = captures.length()
        var env_int: String = this.fresh_local()
        this.emit_indent(env_int + " = load i64, i64* %__env")
        var env_ptr: String = this.val_to_typed_ptr(env_int, "[" + env_size.floor().to_string() + " x i64]*")
        var ci: Float = 0
        while (ci < captures.length()) {
            var cap_name: String = captures[ci]
            if (this.str_in_list(boxed_caps, cap_name)) {
                // The enclosing frame boxed this one, so the slot holds a pointer to
                // a heap cell rather than a copy of the value. Load the pointer and
                // let `%<cap>` be the cell — one more indirection than the snapshot
                // case, and the reason a write here reaches the enclosing scope
                // (BUGS #51 defect B). `%<cap>` is still an `i64*`, so gen_stmts
                // loads and stores through it exactly as before.
                var cell_slot: String = this.fresh_local()
                this.emit_indent(cell_slot + " = getelementptr [" + env_size.floor().to_string() + " x i64], [" + env_size.floor().to_string() + " x i64]* " + env_ptr + ", i64 0, i64 " + ci.floor().to_string())
                var cell_int: String = this.fresh_local()
                this.emit_indent(cell_int + " = load i64, i64* " + cell_slot)
                var cell_ptr: String = this.val_to_typed_ptr(cell_int, "i64*")
                this.emit_indent("%" + this.sanitize_name(cap_name) + " = bitcast i64* " + cell_ptr + " to i64*")
            } else {
                // Point directly at the env slot — no alloca, no copy
                this.emit_indent("%" + this.sanitize_name(cap_name) + " = getelementptr [" + env_size.floor().to_string() + " x i64], [" + env_size.floor().to_string() + " x i64]* " + env_ptr + ", i64 0, i64 " + ci.floor().to_string())
            }
            // Register captured variable in typed_vars
            // Use the outer scope's type if available (preserves generic class types)
            if (outer_typed_vars.has(cap_name)) {
                this.typed_vars.set(cap_name, outer_typed_vars.get(cap_name))
            } else {
                this.typed_vars.set(cap_name, this.str_to_type("Int"))
            }
            ci = ci + 1
        }

        // Collect and emit remaining var allocas
        var var_names: List<String> = []
        var var_types: List<String> = []
        this.collect_vars(body, var_names, var_types)
        i = 0
        while (i < var_names.length()) {
            var vname: String = var_names[i]
            if (!this.str_in_list(captures,vname)) {
                this.emit_indent("%" + this.sanitize_name(vname) + " = alloca " + this.llvm_type(var_types[i]))
            }
            i = i + 1
        }

        this.gen_stmts(body)

        // Coroutine epilogue
        if (is_coro) {
            if (!this.block_terminated) {
                this.emit_terminator("br label %__coro_final")
            }

            this.emit("__coro_final:")
            this.block_terminated = false
            this.emit_indent("%__coro_fs_tok = call token @llvm.coro.save(ptr %__coro_hdl)")
            this.emit_indent("%__coro_fs = call i8 @llvm.coro.suspend(token %__coro_fs_tok, i1 true)")
            this.emit_indent("switch i8 %__coro_fs, label %__coro_suspend [i8 0, label %__coro_trap i8 1, label %__coro_cleanup]")

            this.emit("__coro_trap:")
            this.block_terminated = false
            this.emit_terminator("unreachable")

            this.emit("__coro_cleanup:")
            this.block_terminated = false
            this.emit_indent("%__coro_free = call ptr @llvm.coro.free(token %__coro_id, ptr %__coro_hdl)")
            this.emit_indent("call void @free(ptr %__coro_free)")
            this.emit_terminator("br label %__coro_suspend")

            this.emit("__coro_suspend:")
            this.block_terminated = false
            this.emit_indent("call i1 @llvm.coro.end(ptr %__coro_hdl, i1 false)")
            this.emit_terminator("ret ptr %__coro_hdl")
        } else {
            if (!this.block_terminated) {
                if (ret_llvm == "void") {
                    this.emit_terminator("ret void")
                } else {
                    this.emit_terminator("ret i64 0")
                }
            }
        }
        this.emit("}")
        this.block_terminated = false
        this.is_coroutine = false
        this.in_function = saved_in_function
    }


    fun find_free_vars_stmts(stmts: List<AST.Stmt>, bound: List<String>, free: List<String>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.find_free_vars_stmt(stmts[i], bound, free)
            i = i + 1
        }
    }

    fun find_free_vars_stmt(stmt: AST.Stmt, bound: List<String>, free: List<String>) {
        match (stmt) {
            VarDecl(name, typ, init, doc, v_vis) => {
                this.find_free_vars_expr(init, bound, free)
                bound.push(name)
            }
            ExprStmt(expr) => { this.find_free_vars_expr(expr, bound, free) }
            Return(value) => { this.find_free_vars_expr(value, bound, free) }
            If(cond, then_b, else_b) => {
                this.find_free_vars_expr(cond, bound, free)
                this.find_free_vars_stmts(then_b, bound, free)
                this.find_free_vars_stmts(else_b, bound, free)
            }
            While(cond, body) => {
                this.find_free_vars_expr(cond, bound, free)
                this.find_free_vars_stmts(body, bound, free)
            }
            Block(stmts) => { this.find_free_vars_stmts(stmts, bound, free) }
            FunDecl(n, p, r, b, d, f_vis) => {}
            EnumDecl(n, v, d, e_vis) => {}
            ClassDecl(n, __tps, ps, f, m, d, c_vis) => {}
            Break => {}
            Continue => {}
            TryCatch(try_body, catch_name, catch_body, finally_body) => {
                this.find_free_vars_stmts(try_body, bound, free)
                bound.push(catch_name)
                this.find_free_vars_stmts(catch_body, bound, free)
                this.find_free_vars_stmts(finally_body, bound, free)
            }
            Throw(value) => { this.find_free_vars_expr(value, bound, free) }
            LetPattern(pattern, value) => {
            }
            TypeAlias(ta_n, ta_t, ta_vis) => {}
        }
    }

    fun find_free_vars_expr(expr: AST.Expr, bound: List<String>, free: List<String>) {
        match (expr) {
            Variable(name) => {
                if (this.str_in_list(bound,name) or this.str_in_list(free,name)) {
                    // Already bound or already free — skip
                } else if (this.typed_vars.has(name) and !this.module_globals.has(name) and !this.module_globals.has(this.current_prefix + name)) {
                    // Local variable in enclosing scope shadows any function of same name
                    free.push(name)
                } else {
                    var is_known: Bool = this.str_in_list(this.known_functions,name) or this.str_in_list(this.known_functions,this.current_prefix + name) or this.func_prefix_map.has(name) or this.func_ret_types.has(name) or this.class_fields.has(name) or this.enum_defs.has(name) or this.enum_variant_tags.has(name) or this.module_prefixes.has(name) or this.named_imports.has(name) or this.module_globals.has(name) or this.module_globals.has(this.current_prefix + name)
                    if (!is_known and name.length() > 0) {
                        var upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                        if (upper.index_of(name.char_at(0)) >= 0) {
                            is_known = true
                        }
                    }
                    if (!is_known) {
                        free.push(name)
                    }
                }
            }
            Ref(rkind, rname, rslot) => {
                // A capture is exactly a local/param that no enclosing binder
                // provides. `rkind` says which it is, so none of the Variable
                // arm's is_known guessing (uppercase-first-letter heuristics
                // included) is needed here.
                if (this.str_in_list(bound,rname) or this.str_in_list(free,rname)) {
                    // Already accounted for
                } else if (rkind == "local" or rkind == "param") {
                    free.push(rname)
                }
            }
            Binary(l, o, r) => {
                this.find_free_vars_expr(l, bound, free)
                this.find_free_vars_expr(r, bound, free)
            }
            Unary(o, r) => { this.find_free_vars_expr(r, bound, free) }
            Call(c, args) => {
                this.find_free_vars_expr(c, bound, free)
                var i: Float = 0
                while (i < args.length()) {
                    this.find_free_vars_expr(args[i], bound, free)
                    i = i + 1
                }
                // If calling a closure function, add its captures to our free vars
                var call_name: String = match (c) { Variable(n) => n
                    Ref(rk, rn, rs) => rn
                    _ => ""
                }
                if (call_name.length() > 0) {
                    var caps_key: String = "__caps_" + this.current_prefix + call_name
                    if (this.func_prefix_map.has(caps_key)) {
                        var caps_str: String = this.func_prefix_map.get(caps_key)
                        if (caps_str.length() > 0) {
                            var cap_list: List<String> = caps_str.split(",")
                            var ci4: Float = 0
                            while (ci4 < cap_list.length()) {
                                var cn: String = cap_list[ci4]
                                if (!this.str_in_list(bound,cn) and !this.str_in_list(free,cn)) {
                                    free.push(cn)
                                }
                                ci4 = ci4 + 1
                            }
                        }
                    }
                }
            }
            Assign(name, value) => {
                this.find_free_vars_expr(value, bound, free)
                // A module global is NOT a capture. It is addressed as
                // `@__g_<name>` from wherever it is mentioned, so there is
                // nothing in the enclosing frame to copy into the closure's env
                // — and asking for one produces IR that does not verify: the env
                // store loop emits `load i64, i64* %<name>` against an alloca
                // the enclosing body never declared, because output_body.sf skips
                // the alloca for exactly the names that are globals ("use of
                // undefined value '%top'", BUGS #97).
                //
                // The read side (the `Variable` arm above) has always excluded
                // them. This arm did not, so `g = g + 1` inside a lambda over a
                // module-level `var g` captured while `g` alone did not — the
                // asymmetry was the bug, not either half on its own. The store
                // itself was always correct: gen_assign resolves the target to
                // `@__g_` independently, which is why the emitted `%<name>` slot
                // was dead in the lambda body and the failure landed in the
                // *enclosing* function instead.
                var mg_assign: Bool = this.module_globals.has(name) or this.module_globals.has(this.current_prefix + name)
                if (!this.str_in_list(bound,name) and !this.str_in_list(free,name) and !mg_assign and this.typed_vars.has(name)) {
                    free.push(name)
                }
            }
            Logical(l, o, r) => {
                this.find_free_vars_expr(l, bound, free)
                this.find_free_vars_expr(r, bound, free)
            }
            IntLit(v) => {}
            FloatLit(v) => {}
            BoolLit(v) => {}
            StringLit(s) => {}
            NilLit => {}
            MemberAccess(o, f) => { this.find_free_vars_expr(o, bound, free) }
            MethodCall(o, m, a) => {
                this.find_free_vars_expr(o, bound, free)
                var mi: Float = 0
                while (mi < a.length()) {
                    this.find_free_vars_expr(a[mi], bound, free)
                    mi = mi + 1
                }
            }
            GetField(o, f) => { this.find_free_vars_expr(o, bound, free) }
            SetField(o, f, v) => {
                this.find_free_vars_expr(o, bound, free)
                this.find_free_vars_expr(v, bound, free)
            }
            IndexGet(o, idx) => {
                this.find_free_vars_expr(o, bound, free)
                this.find_free_vars_expr(idx, bound, free)
            }
            IndexSet(o, idx, v) => {
                this.find_free_vars_expr(o, bound, free)
                this.find_free_vars_expr(idx, bound, free)
                this.find_free_vars_expr(v, bound, free)
            }
            Match(s, a) => {
                this.find_free_vars_expr(s, bound, free)
                var mi: Float = 0
                while (mi < a.length()) {
                    var arm: AST.MatchArm = a[mi]
                    var arm_pattern: AST.Pattern = match (arm) { Arm(p, b) => p }
                    var arm_body: AST.Expr = match (arm) { Arm(p, b) => b }
                    var arm_bindings: List<String> = match (arm_pattern) {
                        VariantPattern(v, binds) => binds
                        _ => []
                    }
                    // Pattern bindings are local to the arm body
                    var arm_bound: List<String> = []
                    var bi2: Float = 0
                    while (bi2 < bound.length()) {
                        arm_bound.push(bound[bi2])
                        bi2 = bi2 + 1
                    }
                    var bi3: Float = 0
                    while (bi3 < arm_bindings.length()) {
                        arm_bound.push(arm_bindings[bi3])
                        bi3 = bi3 + 1
                    }
                    this.find_free_vars_expr(arm_body, arm_bound, free)
                    mi = mi + 1
                }
            }
            EnumConstruct(e, v, a) => {
                var ei: Float = 0
                while (ei < a.length()) {
                    this.find_free_vars_expr(a[ei], bound, free)
                    ei = ei + 1
                }
            }
            ListLit(elements) => {
                var li: Float = 0
                while (li < elements.length()) {
                    this.find_free_vars_expr(elements[li], bound, free)
                    li = li + 1
                }
            }
            Lambda(p, r, b) => {
                // Scan nested lambda body for free vars that propagate to this scope
                var inner_bound: List<String> = []
                var pi2: Float = 0
                while (pi2 < p.length()) {
                    var pn: String = match (p[pi2]) { Param(n, t, d, p_vis) => n }
                    inner_bound.push(pn)
                    pi2 = pi2 + 1
                }
                var inner_free: List<String> = []
                this.find_free_vars_stmts(b, inner_bound, inner_free)
                var fi: Float = 0
                while (fi < inner_free.length()) {
                    var fv: String = inner_free[fi]
                    // Skip module globals — they are accessed via @__g_ not local capture
                    if (!this.str_in_list(bound,fv) and !this.str_in_list(free,fv) and !this.str_in_list(inner_bound,fv) and !this.module_globals.has(fv) and !this.module_globals.has(this.current_prefix + fv)) {
                        free.push(fv)
                    }
                    fi = fi + 1
                }
            }
            BlockExpr(stmts, value) => {
                this.find_free_vars_stmts(stmts, bound, free)
                this.find_free_vars_expr(value, bound, free)
            }
            IsCheck(val, t) => {
                this.find_free_vars_expr(val, bound, free)
            }
            Yield(v) => {
                this.find_free_vars_expr(v, bound, free)
            }
            TupleLit(elements) => {
                var tli: Float = 0
                while (tli < elements.length()) {
                    this.find_free_vars_expr(elements[tli], bound, free)
                    tli = tli + 1
                }
            }
            This => {
                if (!this.str_in_list(bound,"self") and !this.str_in_list(free,"self")) {
                    free.push("self")
                }
            }
            MapLit => {}
            IfExpr(c, tb, tv, eb, ev) => {
                this.find_free_vars_expr(c, bound, free)
                this.find_free_vars_stmts(tb, bound, free)
                this.find_free_vars_expr(tv, bound, free)
                this.find_free_vars_stmts(eb, bound, free)
                this.find_free_vars_expr(ev, bound, free)
            }
            TryExpr(tb, tv, cn, cb, cv) => {
                this.find_free_vars_stmts(tb, bound, free)
                this.find_free_vars_expr(tv, bound, free)
                if (cn.length() > 0) {
                    bound.push(cn)
                }
                this.find_free_vars_stmts(cb, bound, free)
                this.find_free_vars_expr(cv, bound, free)
            }
        }
    }

    // Collect the names a nested lambda *assigns to*. This is the analysis behind
    // boxed mutable captures (BUGS #51 defect B).
    //
    // A capture is stored into the closure's env as a `load i64` snapshot
    // (gen_lambda) and `%<cap>` inside the closure GEPs the env slot
    // (gen_closure_function), so a write is visible to later calls of that one
    // closure instance but never reaches the enclosing frame, which keeps its own
    // alloca. `count = 0` after two `bump()` calls was that: two storage locations
    // for one variable.
    //
    // The fix needs the two to *be* one location, which means a heap cell the
    // enclosing frame reads and writes through as well. Boxing every local would
    // put a malloc and a double indirection on the hottest path in codegen, so the
    // set is narrowed to exactly the locals that need it: captured by a nested
    // lambda AND assigned inside it. A capture that is only read is unaffected —
    // the snapshot is already correct for it — and a local no lambda touches never
    // leaves its alloca.
    //
    // Only `enter_lambda` bodies are scanned. An assignment in the *enclosing*
    // function's own body is an ordinary local write and must not force boxing;
    // it is the write crossing the closure boundary that the snapshot loses.
    fun collect_lambda_assigned_stmts(stmts: List<AST.Stmt>, out: List<String>, in_lambda: Bool) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.collect_lambda_assigned_stmt(stmts[i], out, in_lambda)
            i = i + 1
        }
    }

    fun collect_lambda_assigned_stmt(stmt: AST.Stmt, out: List<String>, in_lambda: Bool) {
        var sk: String = this.classify_stmt(stmt)
        if (sk == "var") {
            var vi: AST.Expr = match (stmt) { VarDecl(n, t, init, d, v_vis) => init
                _ => AST.Expr.NilLit
            }
            this.collect_lambda_assigned_expr(vi, out, in_lambda)
        } else if (sk == "expr") {
            var ee: AST.Expr = match (stmt) { ExprStmt(e) => e
                _ => AST.Expr.NilLit
            }
            this.collect_lambda_assigned_expr(ee, out, in_lambda)
        } else if (sk == "return") {
            var re: AST.Expr = match (stmt) { Return(v) => v
                _ => AST.Expr.NilLit
            }
            this.collect_lambda_assigned_expr(re, out, in_lambda)
        } else if (sk == "if") {
            var ic: AST.Expr = match (stmt) { If(c, t, e) => c
                _ => AST.Expr.NilLit
            }
            var it: List<AST.Stmt> = match (stmt) { If(c, t, e) => t
                _ => []
            }
            var ie: List<AST.Stmt> = match (stmt) { If(c, t, e) => e
                _ => []
            }
            this.collect_lambda_assigned_expr(ic, out, in_lambda)
            this.collect_lambda_assigned_stmts(it, out, in_lambda)
            this.collect_lambda_assigned_stmts(ie, out, in_lambda)
        } else if (sk == "while") {
            var wc: AST.Expr = match (stmt) { While(c, b) => c
                _ => AST.Expr.NilLit
            }
            var wb: List<AST.Stmt> = match (stmt) { While(c, b) => b
                _ => []
            }
            this.collect_lambda_assigned_expr(wc, out, in_lambda)
            this.collect_lambda_assigned_stmts(wb, out, in_lambda)
        } else if (sk == "block") {
            var bs: List<AST.Stmt> = match (stmt) { Block(s) => s
                _ => []
            }
            this.collect_lambda_assigned_stmts(bs, out, in_lambda)
        } else if (sk == "try") {
            var tb: List<AST.Stmt> = match (stmt) { TryCatch(t, cn, cb, fb) => t
                _ => []
            }
            var cb2: List<AST.Stmt> = match (stmt) { TryCatch(t, cn, cb, fb) => cb
                _ => []
            }
            var fb2: List<AST.Stmt> = match (stmt) { TryCatch(t, cn, cb, fb) => fb
                _ => []
            }
            this.collect_lambda_assigned_stmts(tb, out, in_lambda)
            this.collect_lambda_assigned_stmts(cb2, out, in_lambda)
            this.collect_lambda_assigned_stmts(fb2, out, in_lambda)
        } else if (sk == "throw") {
            var te: AST.Expr = match (stmt) { Throw(v) => v
                _ => AST.Expr.NilLit
            }
            this.collect_lambda_assigned_expr(te, out, in_lambda)
        }
        // FunDecl / EnumDecl / ClassDecl / break / continue / let_pattern: a
        // named nested function is hoisted with by-value capture params, a
        // separate mechanism from lambda envs, so it is deliberately not scanned
        // here. Boxing for it would change the hoisted signature.
    }

    fun collect_lambda_assigned_expr(expr: AST.Expr, out: List<String>, in_lambda: Bool) {
        match (expr) {
            Lambda(p, r, b) => {
                // Everything below this point is inside a closure boundary.
                this.collect_lambda_assigned_stmts(b, out, true)
            }
            Assign(name, value) => {
                if (in_lambda and name.length() > 0 and !this.str_in_list(out, name)) {
                    out.push(name)
                }
                this.collect_lambda_assigned_expr(value, out, in_lambda)
            }
            Binary(l, o, r) => {
                this.collect_lambda_assigned_expr(l, out, in_lambda)
                this.collect_lambda_assigned_expr(r, out, in_lambda)
            }
            Logical(l, o, r) => {
                this.collect_lambda_assigned_expr(l, out, in_lambda)
                this.collect_lambda_assigned_expr(r, out, in_lambda)
            }
            Unary(o, r) => { this.collect_lambda_assigned_expr(r, out, in_lambda) }
            Call(c, args) => {
                this.collect_lambda_assigned_expr(c, out, in_lambda)
                var i: Float = 0
                while (i < args.length()) {
                    this.collect_lambda_assigned_expr(args[i], out, in_lambda)
                    i = i + 1
                }
            }
            MethodCall(o, m, a) => {
                this.collect_lambda_assigned_expr(o, out, in_lambda)
                var mi: Float = 0
                while (mi < a.length()) {
                    this.collect_lambda_assigned_expr(a[mi], out, in_lambda)
                    mi = mi + 1
                }
            }
            MemberAccess(o, f) => { this.collect_lambda_assigned_expr(o, out, in_lambda) }
            GetField(o, f) => { this.collect_lambda_assigned_expr(o, out, in_lambda) }
            SetField(o, f, v) => {
                this.collect_lambda_assigned_expr(o, out, in_lambda)
                this.collect_lambda_assigned_expr(v, out, in_lambda)
            }
            IndexGet(o, idx) => {
                this.collect_lambda_assigned_expr(o, out, in_lambda)
                this.collect_lambda_assigned_expr(idx, out, in_lambda)
            }
            IndexSet(o, idx, v) => {
                this.collect_lambda_assigned_expr(o, out, in_lambda)
                this.collect_lambda_assigned_expr(idx, out, in_lambda)
                this.collect_lambda_assigned_expr(v, out, in_lambda)
            }
            ListLit(elements) => {
                var li: Float = 0
                while (li < elements.length()) {
                    this.collect_lambda_assigned_expr(elements[li], out, in_lambda)
                    li = li + 1
                }
            }
            TupleLit(elements) => {
                var tli: Float = 0
                while (tli < elements.length()) {
                    this.collect_lambda_assigned_expr(elements[tli], out, in_lambda)
                    tli = tli + 1
                }
            }
            EnumConstruct(e, v, a) => {
                var ei: Float = 0
                while (ei < a.length()) {
                    this.collect_lambda_assigned_expr(a[ei], out, in_lambda)
                    ei = ei + 1
                }
            }
            Match(s, a) => {
                this.collect_lambda_assigned_expr(s, out, in_lambda)
                var mi2: Float = 0
                while (mi2 < a.length()) {
                    var arm_body: AST.Expr = match (a[mi2]) { Arm(p, b) => b }
                    this.collect_lambda_assigned_expr(arm_body, out, in_lambda)
                    mi2 = mi2 + 1
                }
            }
            BlockExpr(stmts, value) => {
                this.collect_lambda_assigned_stmts(stmts, out, in_lambda)
                this.collect_lambda_assigned_expr(value, out, in_lambda)
            }
            IfExpr(c, tb, tv, eb, ev) => {
                this.collect_lambda_assigned_expr(c, out, in_lambda)
                this.collect_lambda_assigned_stmts(tb, out, in_lambda)
                this.collect_lambda_assigned_expr(tv, out, in_lambda)
                this.collect_lambda_assigned_stmts(eb, out, in_lambda)
                this.collect_lambda_assigned_expr(ev, out, in_lambda)
            }
            TryExpr(tb, tv, cn, cb, cv) => {
                this.collect_lambda_assigned_stmts(tb, out, in_lambda)
                this.collect_lambda_assigned_expr(tv, out, in_lambda)
                this.collect_lambda_assigned_stmts(cb, out, in_lambda)
                this.collect_lambda_assigned_expr(cv, out, in_lambda)
            }
            IsCheck(val, t) => { this.collect_lambda_assigned_expr(val, out, in_lambda) }
            Yield(v) => { this.collect_lambda_assigned_expr(v, out, in_lambda) }
            Variable(name) => {}
            Ref(rkind, rname, rslot) => {}
            IntLit(v) => {}
            FloatLit(v) => {}
            BoolLit(v) => {}
            StringLit(s) => {}
            NilLit => {}
            This => {}
            MapLit => {}
        }
    }

    // @codegen-split: intrinsics
    // @codegen-split: intrinsics
    fun gen_intrinsic_call(name: String, args: List<AST.Expr>): String {
        if (name.ends_with("load64")) {
            var addr: String = this.gen_arg_value(args[0])
            var ptr: String = this.val_to_typed_ptr(addr, "i64*")
            var val: String = this.fresh_local()
            this.emit_indent(val + " = load i64, i64* " + ptr)
            this.last_type = AST.Type.IntType
            return val
        }
        if (name.ends_with("store64")) {
            var addr: String = this.gen_arg_value(args[0])
            var val: String = this.gen_arg_value(args[1])
            var ptr: String = this.val_to_typed_ptr(addr, "i64*")
            this.emit_indent("store i64 " + val + ", i64* " + ptr)
            this.last_type = AST.Type.NilType
            return "0"
        }
        if (name.ends_with("load8")) {
            var addr: String = this.gen_arg_value(args[0])
            var ptr: String = this.emit_untag_ptr(addr)
            var byte_val: String = this.fresh_local()
            this.emit_indent(byte_val + " = load i8, i8* " + ptr)
            var result: String = this.fresh_local()
            this.emit_indent(result + " = zext i8 " + byte_val + " to i64")
            this.last_type = AST.Type.IntType
            return result
        }
        if (name.ends_with("store8")) {
            var addr: String = this.gen_arg_value(args[0])
            var val: String = this.gen_arg_value(args[1])
            var truncated: String = this.fresh_local()
            this.emit_indent(truncated + " = trunc i64 " + val + " to i8")
            var ptr: String = this.emit_untag_ptr(addr)
            this.emit_indent("store i8 " + truncated + ", i8* " + ptr)
            this.last_type = AST.Type.NilType
            return "0"
        }
        if (name.ends_with("load_argc")) {
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = load i32, i32* @__argc")
            var result: String = this.fresh_local()
            this.emit_indent(result + " = sext i32 " + raw + " to i64")
            this.last_type = AST.Type.IntType
            return result
        }
        if (name.ends_with("load_argv")) {
            var argv: String = this.fresh_local()
            this.emit_indent(argv + " = load i8**, i8*** @__argv")
            var result: String = this.typed_ptr_to_val(argv, "i8**")
            this.last_type = AST.Type.IntType
            return result
        }
        if (name.ends_with("tag_ptr")) {
            var ptr_val: String = this.gen_arg_value(args[0])
            var as_ptr: String = this.val_to_ptr(ptr_val)
            var result: String = this.emit_tag_ptr(as_ptr)
            this.last_type = AST.Type.StringType
            return result
        }
        if (name.ends_with("untag_ptr")) {
            var val: String = this.gen_arg_value(args[0])
            var ptr: String = this.emit_untag_ptr(val)
            var result: String = this.ptr_to_val(ptr)
            this.last_type = AST.Type.IntType
            return result
        }
        // call_void_ptr(fn_ptr, arg) — indirect call with signature void(*)(ptr)
        if (name.ends_with("call_void_ptr")) {
            var fn_val: String = this.gen_arg_value(args[0])
            var arg_val: String = this.gen_arg_value(args[1])
            var fn_ptr: String = this.fresh_local()
            this.emit_indent(fn_ptr + " = inttoptr i64 " + fn_val + " to ptr")
            var arg_ptr: String = this.fresh_local()
            this.emit_indent(arg_ptr + " = inttoptr i64 " + arg_val + " to ptr")
            this.emit_indent("call void " + fn_ptr + "(ptr " + arg_ptr + ")")
            this.last_type = AST.Type.NilType
            return "0"
        }
        // __suspend(reason, arg) — async suspend point
        // Emits coro.save/coro.suspend/switch. Makes containing function a coroutine.
        if (name.ends_with("__suspend")) {
            var reason: String = this.gen_arg_value(args[0])
            this.emit_indent("store i64 " + reason + ", i64* @__yield_reason")
            if (args.length() >= 2) {
                var arg: String = this.gen_arg_value(args[1])
                this.emit_indent("store i64 " + arg + ", i64* @__yield_arg")
            }
            var save_tok: String = this.fresh_local()
            this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var susp_result: String = this.fresh_local()
            this.emit_indent(susp_result + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")
            var resume_label: String = this.fresh_label("suspend.resume")
            var cleanup_label: String = this.fresh_label("suspend.cleanup")
            // Default (suspend) case branches to the shared __coro_suspend block.
            // CoroSplit requires all suspend points to share a single suspend/ret block.
            this.emit_terminator("switch i8 " + susp_result + ", label %__coro_suspend [i8 0, label %" + resume_label + " i8 1, label %" + cleanup_label + "]")
            this.emit(cleanup_label + ":")
            this.block_terminated = false
            this.emit_terminator("br label %__coro_cleanup")
            this.emit(resume_label + ":")
            this.block_terminated = false
            this.last_type = AST.Type.NilType
            return "0"
        }
        return "0"
    }

    fun parse_extern_sig(sig: String): List<String> {
        var paren_idx: Float = sig.index_of("(")
        var left: String = sig.slice(0, paren_idx)
        var params_str: String = sig.slice(paren_idx + 1, sig.length() - 1)
        var space_idx: Float = left.index_of(" ")
        var ret_type: String = left.slice(0, space_idx)
        var c_name: String = left.slice(space_idx + 1, left.length())
        var result: List<String> = []
        result.push(c_name)
        result.push(ret_type)
        if (params_str.length() > 0) {
            var params: List<String> = params_str.split(", ")
            var i: Float = 0
            while (i < params.length()) {
                result.push(params[i].trim())
                i = i + 1
            }
        }
        return result
    }

    fun normalize_c_type(t: String): String {
        if (t == "void*") { return "i8*" }
        if (t == "void**") { return "i8**" }
        return t
    }

    // The C types the two ends of gen_extern_call actually know how to convert.
    //
    // These two lists exist because the parameter side and the return side each
    // ended in a bare `else` that assumed "anything I did not recognise is an
    // i64" — and the two `else`s disagreed about which types they covered, which
    // is BUGS #24's asymmetry in its general form. The param `else` emitted
    // `i64 %v` for an `i8**`/`i16`/`float` declaration whose `declare` says
    // otherwise; the return `else` emitted `__val_tag_int(i64 %r)` on a value
    // LLVM types as `i8**` or `i1`. Both produce a module that fails to
    // assemble, with the failure reported by `opt` against generated IR rather
    // than against the `@extern` line that caused it.
    //
    // The fix is not to add more conversions — a `float` param needs an
    // fptrunc, an `i16` needs a trunc, an `i8**` return needs a real box, and
    // each is its own change with its own tagging question. The fix is that an
    // unhandled type must be a DIAGNOSTIC naming the signature, so the failure
    // arrives at the declaration instead of three layers down in the assembler.
    fun extern_param_type_supported(norm: String): Bool {
        if (norm == "i64") { return true }
        if (norm == "i8*") { return true }
        if (norm == "i8**") { return true }
        if (norm == "i32") { return true }
        if (norm == "double") { return true }
        if (norm == "...") { return true }
        return false
    }

    fun extern_ret_type_supported(norm: String): Bool {
        if (norm == "void") { return true }
        if (norm == "i64") { return true }
        if (norm == "i8*") { return true }
        if (norm == "i32") { return true }
        if (norm == "double") { return true }
        return false
    }

    fun emit_extern_declare(sig: String): String {
        var parsed: List<String> = this.parse_extern_sig(sig)
        var c_name: String = parsed[0]
        var ret_type: String = this.normalize_c_type(parsed[1])
        var sb: StringBuilder = StringBuilder()
        sb.append("declare " + ret_type + " @" + c_name + "(")
        var i: Float = 2
        while (i < parsed.length()) {
            if (i > 2) { sb.append(", ") }
            var ptype: String = this.normalize_c_type(parsed[i])
            if (ptype == "...") {
                sb.append("...")
            } else {
                sb.append(ptype)
            }
            i = i + 1
        }
        sb.append(")")
        return sb.to_string()
    }

    fun gen_extern_call(name: String, args: List<AST.Expr>): String {
        var sig: String = this.extern_sigs.get(name)
        var parsed: List<String> = this.parse_extern_sig(sig)
        var c_name: String = parsed[0]
        var ret_c: String = parsed[1]
        var llvm_ret: String = this.normalize_c_type(ret_c)
        // Saffron-level param types, positional. Only `Any` is consulted; every
        // other annotation keeps the C-type-driven conversion below.
        var saffron_ptypes: List<String> = []
        if (this.extern_param_types.has(name)) {
            var spt_csv: String = this.extern_param_types.get(name)
            if (spt_csv.length() > 0) {
                saffron_ptypes = spt_csv.split(",")
            }
        }
        var call_args: List<String> = []
        var i: Float = 0
        while (i < args.length()) {
            var val: String = this.gen_arg_value(args[i])
            var ptype: String = "i64"
            if (i + 2 < parsed.length()) {
                ptype = parsed[i + 2]
            }
            var norm: String = this.normalize_c_type(ptype)
            // Reject an unconvertible declared C type here, at the signature,
            // rather than letting the `else` below claim it is an i64 (BUGS #24).
            if (!this.extern_param_type_supported(norm)) {
                IO.println("[codegen] Error: @extern \"" + sig + "\": parameter " + (i + 1).floor().to_string() + " has C type '" + ptype + "', which the FFI boundary cannot convert. Supported: i64, i32, double, void*/i8*, void**/i8**.")
                this.has_errors = true
            }
            // An `Any` i64 param is an opaque box in transit: the C side only
            // stores and returns it, so the value must arrive with its tag
            // intact. Untagging it here destroys the type — the scheduler's
            // `store_result(handle, value)` untagged a tagged 42 down to a raw
            // 42, and `__sched_get_stored_result` handed that back untagged, so
            // `task.await() == 42` was false while `.to_string()` still printed
            // "42" (untag tolerates raw). A Float result was worse: `fptosi`
            // truncated it. Mirrors the `Any` return branch below (BUGS #38).
            var is_any_param: Bool = false
            if (i < saffron_ptypes.length()) {
                is_any_param = saffron_ptypes[i] == "Any"
            }
            if (norm == "i64" and is_any_param) {
                call_args.push("i64 " + val)
            } else if (norm == "i8*") {
                var ptr: String = this.emit_untag_ptr(val)
                call_args.push("i8* " + ptr)
            } else if (norm == "i8**") {
                var ptr: String = this.val_to_typed_ptr(val, "i8**")
                call_args.push("i8** " + ptr)
            } else if (norm == "i32") {
                var untagged: String = this.emit_untag_int(val)
                var trunc_val: String = this.fresh_local()
                this.emit_indent(trunc_val + " = trunc i64 " + untagged + " to i32")
                call_args.push("i32 " + trunc_val)
            } else if (norm == "double") {
                var dbl: String = this.emit_untag_float(val)
                call_args.push("double " + dbl)
            } else {
                // Untag i64 params, exactly as the i32 path already does. This is
                // safe for all three things an `Int` param can carry, because
                // __val_untag_int masks 48 bits and sign-extends:
                //   - a NaN-boxed Int      -> payload recovered (incl. negatives)
                //   - a tag_ptr'd handle   -> TAG_PTR stripped, address recovered
                //   - a raw address        -> identity (real addresses are < 2^47)
                // Passing the value through raw was BUG #24: malloc(64) received
                // 0x7FF9000000000040, and every i64-param extern got garbage —
                // sf_tcp_connect could never connect and @process captured nothing.
                var untagged64: String = this.emit_untag_int(val)
                call_args.push("i64 " + untagged64)
            }
            i = i + 1
        }
        // Symmetric with the parameter check above: the return path's own final
        // `else` boxes with __val_tag_int(i64 ...), which is a type error on any
        // return LLVM does not already hold in an i64. `void**` and `i1` both
        // reach it today and both produce IR that fails to assemble.
        if (!this.extern_ret_type_supported(llvm_ret)) {
            IO.println("[codegen] Error: @extern \"" + sig + "\": return C type '" + ret_c + "' cannot be boxed at the FFI boundary. Supported: void, i64, i32, double, void*/i8*.")
            this.has_errors = true
        }
        if (llvm_ret == "void") {
            this.emit_indent("call void @" + c_name + "(" + call_args.join(", ") + ")")
            this.last_type = AST.Type.NilType
            return "0"
        }
        var raw: String = this.fresh_local()
        if (sig.contains("...")) {
            this.emit_indent(raw + " = call " + llvm_ret + " (" + this.extern_param_types(parsed) + ") @" + c_name + "(" + call_args.join(", ") + ")")
        } else {
            this.emit_indent(raw + " = call " + llvm_ret + " @" + c_name + "(" + call_args.join(", ") + ")")
        }
        // Look up the Saffron return type annotation for proper boxing
        var saffron_ret_str: String = "Int"
        if (this.func_ret_types.has(name)) {
            saffron_ret_str = this.type_to_string(this.func_ret_types.get(name))
        }
        if (llvm_ret == "i8*") {
            // NULL-tagging matters here: a void* extern that returns NULL on
            // failure (fopen, fgets, strstr) is guarded with `== 0` in Saffron,
            // and plain emit_tag_ptr turns NULL into TAG_PTR|0, which that guard
            // never matches (BUGS #84). A non-NULL result keeps TAG_PTR, so the
            // String-returning void* wrappers (char_at, slice, File.read) are
            // unaffected and last_type stays String for interpolation.
            var as_int: String = this.emit_tag_ptr_nullable(raw)
            this.last_type = AST.Type.StringType
            return as_int
        }
        if (llvm_ret == "i32") {
            var ext: String = this.fresh_local()
            this.emit_indent(ext + " = sext i32 " + raw + " to i64")
            if (saffron_ret_str == "Any") {
                this.last_type = AST.Type.IntType
                return ext
            }
            if (saffron_ret_str == "Bool") {
                var tagged: String = this.emit_tag_bool(ext)
                this.last_type = AST.Type.BoolType
                return tagged
            }
            var tagged: String = this.emit_tag_int(ext)
            this.last_type = AST.Type.IntType
            return tagged
        }
        if (llvm_ret == "double") {
            var as_int: String = this.emit_tag_float(raw)
            this.last_type = AST.Type.FloatType
            return as_int
        }
        // Default i64 return: box based on Saffron type annotation
        if (saffron_ret_str == "Any") {
            this.last_type = AST.Type.IntType
            return raw
        }
        if (saffron_ret_str == "String") {
            var ptr: String = this.fresh_local()
            this.emit_indent(ptr + " = inttoptr i64 " + raw + " to i8*")
            var tagged: String = this.emit_tag_ptr(ptr)
            this.last_type = AST.Type.StringType
            return tagged
        }
        if (saffron_ret_str == "Bool") {
            var tagged: String = this.emit_tag_bool(raw)
            this.last_type = AST.Type.BoolType
            return tagged
        }
        var tagged: String = this.emit_tag_int(raw)
        this.last_type = AST.Type.IntType
        return tagged
    }

    fun extern_param_types(parsed: List<String>): String {
        var sb: StringBuilder = StringBuilder()
        var i: Float = 2
        while (i < parsed.length()) {
            if (i > 2) { sb.append(", ") }
            var ptype: String = this.normalize_c_type(parsed[i])
            if (ptype == "...") {
                sb.append("...")
            } else {
                sb.append(ptype)
            }
            i = i + 1
        }
        return sb.to_string()
    }

    // @codegen-split: stmts
    fun gen_stmt(stmt: AST.Stmt) {
        match (stmt) {
            ExprStmt(expr) => { this.gen_arg_value(expr) }
            VarDecl(name, type_ann, init, doc, v_vis) => {
                if (!doc.starts_with("@import:")) {
                    this.gen_var_decl(stmt)
                }
            }
            Return(value) => { this.gen_return(stmt) }
            If(cond, then_branch, else_branch) => {
                this.gen_if(cond, then_branch, else_branch)
            }
            While(cond, body) => { this.gen_while(cond, body) }
            Block(stmts) => { this.gen_stmts(stmts) }
            Break => {
                if (this.loop_break_label.length() > 0) {
                    this.emit_terminator("br label %" + this.loop_break_label)
                }
            }
            Continue => {
                if (this.loop_continue_label.length() > 0) {
                    this.emit_terminator("br label %" + this.loop_continue_label)
                }
            }
            TryCatch(try_body, catch_name, catch_body, finally_body) => {
                this.gen_try_catch(try_body, catch_name, catch_body, finally_body)
            }
            Throw(value) => {
                this.gen_throw(value)
            }
            LetPattern(pattern, value) => {
                this.gen_let_pattern(pattern, value)
            }
            FunDecl(name, params, ret_type, body, doc, f_vis) => {
                // Capture and clear pending_extend_class to prevent stale state
                // in nested gen_stmt calls
                var saved_extend: String = this.pending_extend_class
                this.pending_extend_class = ""
                // A nested `fun f` binds `f` in the *enclosing body*, and that
                // binding has to beat a like-named module global — the same
                // innermost-wins rule `var` already gets from current_fn_locals
                // (BUGS #59). Without this, `fun mk() { fun cl() {...}; return cl }`
                // alongside a module-level `var cl` compiled `return cl` to a load
                // from @__g_cl: the global, read before it is initialised, so `mk`
                // handed back 0 and the caller's `cl()` dereferenced a null
                // closure pair (BUGS #80). Recorded under a reserved key rather
                // than the bare name so it can never be mistaken for a `var`
                // binding by the alloca / GC-root sites that also read this map.
                // current_fn_locals is saved and restored around every body, so
                // the marker is scoped to this body for free, and gen_function
                // restores the *same* map object — mutating it here survives the
                // hoisting call below.
                if (this.in_function) {
                    this.current_fn_locals.set("__nestedfn:" + name, true)
                }
                if (doc.starts_with("@intrinsic")) {
                    var emit_name: String = this.current_prefix + name
                    this.known_functions.push(emit_name)
                    this.func_ret_types.set(emit_name, this.str_to_type(ret_type))
                    this.intrinsic_funcs.push(emit_name)
                } else if (doc.starts_with("@inline")) {
                    // Mark function for alwaysinline attribute, then process normally
                    var emit_name: String = this.current_prefix + name
                    this.inline_funcs.push(emit_name)
                    var params_str: String = this.params_to_string(params)
                    var defaults: List<AST.Expr> = []
                    var param_names: List<String> = []
                    var pi: Float = 0
                    while (pi < params.length()) {
                        var p: AST.Param = params[pi]
                        var dval: AST.Expr = match (p) { Param(n, t, d, p_vis) => d }
                        var pname: String = match (p) { Param(n, t, d, p_vis) => n }
                        defaults.push(dval)
                        param_names.push(pname)
                        pi = pi + 1
                    }
                    this.func_defaults.set(emit_name, defaults)
                    this.func_param_count.set(emit_name, params.length())
                    this.func_param_names.set(emit_name, param_names)
                    this.gen_function(name, params_str, ret_type, body)
                } else if (doc.starts_with("@extern:")) {
                    var c_sig: String = doc.slice(8, doc.length())
                    var emit_name: String = this.current_prefix + name
                    this.known_functions.push(emit_name)
                    this.func_ret_types.set(emit_name, this.str_to_type(ret_type))
                    this.extern_sigs.set(emit_name, c_sig)
                    this.extern_param_types.set(emit_name, this.param_types_csv(params))
                } else if (doc.starts_with("@extend:")) {
                    var ext_class: String = doc.slice(8, doc.length())
                    this.gen_extend_method(ext_class, name, params, ret_type, body)
                } else if (saved_extend.length() > 0) {
                    // Fallback: doc field was unreadable for cross-module FunDecl
                    // but pre-scan identified this as an extension method
                    this.gen_extend_method(saved_extend, name, params, ret_type, body)
                } else {
                    var params_str: String = this.params_to_string(params)
                    // Register default values for optional params
                    var emit_name: String = this.current_prefix + name
                    var defaults: List<AST.Expr> = []
                    var param_names: List<String> = []
                    var pi: Float = 0
                    while (pi < params.length()) {
                        var p: AST.Param = params[pi]
                        var dval: AST.Expr = match (p) { Param(n, t, d, p_vis) => d }
                        var pname: String = match (p) { Param(n, t, d, p_vis) => n }
                        defaults.push(dval)
                        param_names.push(pname)
                        pi = pi + 1
                    }
                    this.func_defaults.set(emit_name, defaults)
                    this.func_param_count.set(emit_name, params.length())
                    this.func_param_names.set(emit_name, param_names)
                    this.gen_function(name, params_str, ret_type, body)
                }
            }
            EnumDecl(name, variants, doc, e_vis) => {
                this.gen_enum_decl(name, variants)
            }
            ClassDecl(name, type_params, parents, fields, methods, doc, c_vis) => {
                // Registered before the body is generated: a method returning a
                // class type parameter is typed by substituting the receiver's
                // own type arguments, and that has to be known by the time any
                // call site in this class is emitted (BUGS #95).
                if (type_params.length() > 0) {
                    this.class_type_params.set(name, type_params)
                    if (this.current_prefix.length() > 0) {
                        this.class_type_params.set(this.current_prefix + name, type_params)
                    }
                }
                this.gen_class_decl_with_parents(name, parents, fields, methods)
            }
            TypeAlias(ta_n, ta_t, ta_vis) => {}
        }
    }

    fun get_var_name(stmt: AST.Stmt): String {
        return match (stmt) { VarDecl(n, t, i, d, v_vis) => n
            _ => ""
        }
    }

    fun get_var_type(stmt: AST.Stmt): String {
        return match (stmt) { VarDecl(n, t, i, d, v_vis) => t
            _ => ""
        }
    }

    fun get_var_init(stmt: AST.Stmt): AST.Expr {
        return match (stmt) { VarDecl(n, t, i, d, v_vis) => i
            // Was `_ => ""`: a String default on a function declared to return
            // AST.Expr. Nothing rejected it because the checker never walked
            // method bodies (BUGS #76), and every caller pre-checks for a
            // VarDecl, so the wrong-typed value was never produced. NilLit is
            // the honest "no initializer" of the right type.
            _ => AST.Expr.NilLit
        }
    }

    fun get_var_doc(stmt: AST.Stmt): String {
        return match (stmt) { VarDecl(n, t, i, d, v_vis) => d
            _ => ""
        }
    }

    fun get_fun_doc(stmt: AST.Stmt): String {
        return match (stmt) { FunDecl(n, p, r, b, d, f_vis) => d
            _ => ""
        }
    }

    fun gen_var_decl(stmt: AST.Stmt) {
        var name: String = this.get_var_name(stmt)
        this.gen_var_decl_with_name(name, this.get_var_type(stmt), this.get_var_init(stmt))
    }

    fun gen_var_decl_with_name(name: String, type_ann: String, init: AST.Expr) {
        var vtype: String = type_ann
        if (vtype == "Any") {
            vtype = this.get_expr_type(init)
        }
        var val: String = this.gen_arg_value(init)
        // After gen_arg_value, last_type reflects the actual compiled expression type.
        // Always use last_type when type_ann was "Any" (inference), since get_expr_type
        // may fail for complex expressions involving variables not yet in typed_vars.
        if (type_ann == "Any") {
            var post_type: String = this.type_to_string(this.last_type)
            if (post_type != "Any") {
                vtype = post_type
            }
        }
        // A nil initialiser says nothing about the variable's type, so do not let it
        // narrow to "Nil".
        //
        // `var parsed: Any = nil` (and the inferred `var x = nil`) used to type the
        // variable as Nil for the rest of its life. Nothing widened it on
        // reassignment, so after `parsed = JSON.parse(body)` the variable still
        // claimed to be Nil — and the `== nil` comparison in gen_binary keys off the
        // *static* type, emitting `__val_is_nil` against the nil literal rather than
        // against the variable. The result was a comparison that was unconditionally
        // true: `parsed == nil` reported nil for a live object, and the playground's
        // /api/compile rejected every request as "missing 'source' field".
        //
        // "Any" is the honest type here — it routes through the runtime dispatch
        // helpers, which inspect the actual tag. This is I2 in
        // docs/design/compiler-rewrite.md ("Unknown is distinct"), applied to the one
        // case where the current tree spells unknown as a concrete type.
        if (vtype == "Nil") {
            vtype = "Any"
        }
        // Resolve generic type parameters from lambda argument return types.
        // e.g. var x = computed(fun (): String => ...) infers Computed<String> not Computed<T>
        if (vtype.contains("<") and vtype.contains(">")) {
            var gt_start: Float = vtype.index_of("<")
            var gt_inner: String = vtype.slice(gt_start + 1, vtype.length() - 1)
            var gt_base_name: String = vtype.slice(0, gt_start)
            // Whether `gt_inner` is an unbound type parameter. The class's own
            // declared parameter list is the authority: `class Computed<T>` says
            // "T" is a parameter and "String" is not, with no guessing about
            // name shape. The one-or-two-uppercase-characters test below is the
            // old heuristic, kept only for a class whose declaration this
            // codegen instance never saw (a cross-module type whose params were
            // not registered) — it misses a spelled-out `Element` and would
            // misfire on a two-letter class name (BUGS #95).
            var gt_is_param: Bool = false
            if (this.class_type_params.has(gt_base_name)) {
                var gt_params: List<String> = this.class_type_params.get(gt_base_name)
                gt_is_param = gt_params.contains(gt_inner)
            } else {
                gt_is_param = gt_inner.length() <= 2 and gt_inner.length() > 0 and gt_inner == gt_inner.to_upper()
            }
            if (gt_is_param) {
                // Try to infer from init expression's lambda return type
                var inferred: String = this.infer_generic_from_init(init)
                if (inferred.length() > 0 and inferred != "Any" and inferred != "Int") {
                    var gt_base: String = vtype.slice(0, gt_start)
                    vtype = gt_base + "<" + inferred + ">"
                }
            }
        }
        this.typed_vars.set(name, this.str_to_type(vtype))
        if (vtype == "String") {
            this.string_vars.push(name)
        }
        // Int -> Float widening at an annotated declaration (BUGS #28).
        //
        // `var f: Float = 1` used to store the literal with its TAG_INT intact
        // while every downstream read treated the bits as a double, so `1` came
        // back as the subnormal 4.94e-324 — or NaN once it reached a
        // tag-inspecting path. Mixed arithmetic (`1 + 1.0`) was never affected
        // because `__val_untag_float` already converts an int-tagged operand
        // via sitofp; only the declaration path skipped the conversion.
        //
        // The round trip through untag_float/tag_float reuses exactly that
        // conversion rather than duplicating a sitofp here.
        //
        // Gated on !identity_mode deliberately: identity mode has no tags and
        // compiles Float arithmetic as `add i64`, so Float *is* Int there. The
        // compiler's own sources rely on that in 455 places (`Parser.pos`,
        // `var depth: Float = 1`); converting would corrupt every one of them.
        if (!this.identity_mode and vtype == "Float" and this.type_to_string(this.last_type) == "Int") {
            var widened: String = this.emit_untag_float(val)
            val = this.emit_tag_float(widened)
        }
        var var_ref: String = "%" + this.sanitize_name(name)
        // Only the *prefixed* key is consulted. A bare-name fallback used to
        // follow, and it could never help: when current_prefix is "" the two
        // keys are the same string, so the fallback only ever fired with a
        // non-empty prefix — i.e. it matched a global belonging to some other
        // module. `var p: Project = Project()` inside pantry_config's project()
        // then stored to the main program's @__g_p while output_body.sf still
        // allocated %p, and the local was written to an unrelated global.
        // A local shadowing a module global is a local (BUGS #59):
        // current_fn_locals wins, matching the alloca emitted in gen_function.
        if (!this.current_fn_locals.has(name) and this.module_globals.has(this.current_prefix + name)) {
            var_ref = "@__g_" + this.current_prefix + this.sanitize_name(name)
            this.global_var_types.set(name, vtype)
            this.global_var_types.set(this.current_prefix + name, vtype)
        }
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_store(val, "i64", var_ref))
            // LLVM lib parallel path: associate the variable's alloca with the stored Value
            if (!this.identity_mode and this.llvm_values.has(val)) {
                this.llvm_values.set(var_ref, this.llvm_values.get(val))
            }
        } else {
            this.emit_indent("store i64 " + val + ", i64* " + var_ref)
            this.verify_store(val, "i64", var_ref)
        }
    }

    fun infer_generic_from_init(init: AST.Expr): String {
        // If init is a Call(callee, args), try to infer generic type from args:
        // 1. Lambda args with explicit return type
        // 2. String literal args → String
        // 3. Number literal args → Float
        // 4. Typed variable args → that variable's type
        var ek: String = this.classify_expr(init)
        if (ek == "call") {
            var call_args: List<AST.Expr> = match (init) { Call(c, a) => a   _ => [] }
            var ai: Float = 0
            while (ai < call_args.length()) {
                var arg_kind: String = this.classify_expr(call_args[ai])
                if (arg_kind == "lambda") {
                    var lam_ret: String = match (call_args[ai]) { Lambda(p, r, b) => r   _ => "" }
                    if (lam_ret.length() > 0 and lam_ret != "Int" and lam_ret != "Any") {
                        return lam_ret
                    }
                }
                if (arg_kind == "string") {
                    return "String"
                }
                if (arg_kind == "number") {
                    return "Float"
                }
                if (arg_kind == "bool") {
                    return "Bool"
                }
                if (arg_kind == "ident") {
                    var arg_type: String = this.get_expr_type(call_args[ai])
                    if (arg_type.length() > 0 and arg_type != "Any" and arg_type != "Int") {
                        return arg_type
                    }
                }
                ai = ai + 1
            }
        }
        return ""
    }

    fun gen_return(stmt: AST.Stmt) {
        var value: AST.Expr = match (stmt) { Return(v) => v
            _ => AST.Expr.NilLit
        }
        if (this.is_coroutine) {
            var val: String = this.gen_arg_value(value)
            this.emit_indent("store i64 " + val + ", i64* @__task_result")
            this.emit_terminator("br label %__coro_final")
        } else if (this.current_ret_type == "void") {
            // Pop GC roots before returning
            if (this.gc_root_count > 0) {
                this.emit_indent("call void @__gc_pop_roots(i64 " + this.gc_root_count.floor().to_string() + ")")
            }
            this.emit_terminator("ret void")
        } else {
            var val: String = this.gen_arg_value(value)
            // Pop GC roots before returning
            if (this.gc_root_count > 0) {
                this.emit_indent("call void @__gc_pop_roots(i64 " + this.gc_root_count.floor().to_string() + ")")
            }
            this.emit_terminator("ret i64 " + val)
            // LLVM lib parallel path: ret
            // NOTE: Cannot call bb.ret(val_v) directly — it writes to
            // block.terminator_str and block.is_terminated through nested
            // cross-module field access, which triggers a gen2 segfault.
            // Workaround: call ret_set() which delegates to block.set_terminator_text()
            // (method dispatch works), avoiding direct field assignment.
            if (!this.identity_mode and this.use_llvm_lib and this.llvm_values.has(val)) {
                var ret_val_v: Any = this.llvm_values.get(val)
                this.llvm_block_builder.ret_set(ret_val_v)
            }
        }
    }

    fun gen_class_decl_with_parents(name: String, parents: List<String>, fields: List<AST.Param>, methods: List<AST.Stmt>) {
        // The primary base: the one whose field layout the child extends, whose
        // `init` it may forward to, and which `super` names. Bases 2..n
        // contribute methods only — see the field guard below.
        var parent: String = ""
        if (parents.length() > 0) { parent = parents[0] }
        // Convert fields to string format for internal use
        var fields_str: String = this.params_to_string(fields)
        // Inherit parent fields (prepend parent fields before child's own).
        //
        // Only the FIRST base contributes fields, deliberately. Prepending base
        // 2's fields as well would be more complete but would break the one
        // invariant the whole inheritance lowering rests on: parent field index i
        // must equal child field index i, which is what makes `init` forwarding
        // and every inherited method's field access correct without a vtable.
        // That can hold for exactly one base. Keeping it on parents[0] means a
        // single-inheritance class lays out byte-for-byte as it always has.
        var all_fields: String = fields_str
        if (parent.length() > 0 and this.class_fields.has(parent)) {
            var parent_fields: String = this.class_fields.get(parent)
            if (parent_fields.length() > 0) {
                if (all_fields.length() > 0) {
                    all_fields = parent_fields + "," + all_fields
                } else {
                    all_fields = parent_fields
                }
            }
        }
        // So a second base that carries state cannot work, and must say so rather
        // than emit methods that read the first base's fields at those offsets.
        // Interfaces — the overwhelmingly common case for `extends A, B, C` — are
        // fieldless and are unaffected.
        var gi: Float = 1
        while (gi < parents.length()) {
            var extra: String = parents[gi]
            if (this.class_fields.has(extra) and this.class_fields.get(extra).length() > 0) {
                IO.println("Error: class " + name + " cannot extend " + extra
                    + " as a secondary base: it declares fields, and only the first base's fields are inherited. Make it the first base, or give it no fields.")
            }
            gi = gi + 1
        }
        // For actors, prepend hidden fields: __actor_busy (Int), __actor_queue (Int)
        if (this.actor_classes.has(name)) {
            if (all_fields.length() > 0) {
                all_fields = "__actor_busy:Int,__actor_queue:Int," + all_fields
            } else {
                all_fields = "__actor_busy:Int,__actor_queue:Int"
            }
        }
        // Generate the class with inherited fields
        this.current_parent = parent
        this.gen_class_decl(name, all_fields, methods)
        this.current_parent = ""
        // Record the hierarchy, keyed the same way class_type_ids is (by struct
        // name, i.e. module-prefixed) so __class_is_a can join the two tables.
        // The parent was always available here — it drove field and method
        // inheritance above and was then dropped, which is why `is` on a class
        // could never see a subclass relation (BUGS #61) and dispatch had no
        // hierarchy to switch on (BUGS #50). class_struct_names resolves the
        // parent's own prefix, so a base class in another module still joins.
        if (parents.length() > 0) {
            var child_struct: String = name
            if (this.class_struct_names.has(name)) { child_struct = this.class_struct_names.get(name) }
            var parent_struct: String = parent
            if (this.class_struct_names.has(parent)) { parent_struct = this.class_struct_names.get(parent) }
            this.class_parent_of.set(child_struct, parent_struct)
            // …and the full set, struct-resolved the same way, for __class_is_a.
            var all_structs: List<String> = []
            var psi: Float = 0
            while (psi < parents.length()) {
                var one: String = parents[psi]
                if (this.class_struct_names.has(one)) { one = this.class_struct_names.get(one) }
                all_structs.push(one)
                psi = psi + 1
            }
            this.class_parents_of.set(child_struct, all_structs)
        }
        // Register inherited methods: if child doesn't define a method, map it to
        // parent's — for EVERY base, in declaration order, not just the first.
        // This loop used to run once against parents[0], which is why
        // `class Duck extends Flyable, Swimmable, Walkable` got a Duck__fly
        // forwarder and nothing for swim or walk: `d.swim()` then failed with
        // "type 'Duck' has no method 'swim'". Earlier bases win ties, since
        // str_in_list(child_methods, ...) sees names pushed by previous
        // iterations — the same first-wins rule an override already had.
        var ppi: Float = 0
        while (ppi < parents.length()) {
        var cur_parent: String = parents[ppi]
        if (this.class_methods.has(cur_parent)) {
            var parent_methods: List = this.class_methods.get(cur_parent)
            // Which of this base's methods are bodyless. There is nothing to
            // forward *to* for those, and claiming the name would shadow a real
            // body on a later base: `class Both extends Requires, Provides`,
            // Requires.compute() bodyless and Provides.compute() concrete, forwarded
            // Both__compute to Requires__compute and b.compute() returned 0.
            var cur_abstract: List<String> = []
            if (this.class_abstract_methods.has(cur_parent)) {
                cur_abstract = this.class_abstract_methods.get(cur_parent)
            }
            var child_methods: List = this.class_methods.get(name)
            var i: Int = 0
            while (i < parent_methods.length()) {
                var mname: String = parent_methods[i]
                var forward_method: Bool = !this.str_in_list(child_methods,mname)
                if (this.str_in_list(cur_abstract, mname)) { forward_method = false }
                if (mname == "init") {
                    // Only the primary base's constructor may be forwarded. A
                    // secondary base's fields are NOT prepended to the child (see
                    // the layout note above), so its init would write the child's
                    // inherited-from-parents[0] slots at its own field indices.
                    if (ppi > 0) { forward_method = false }
                    // `init` used to be excluded here, which meant a child that
                    // declares no constructor of its own got no Child__init at
                    // all. The call site in gen_call only emits the __init call
                    // when it is a known function, so `Child("Rex")` compiled to
                    // a bare `call @Child()` with every argument silently
                    // dropped; the fields stayed zero and the first field read
                    // through an inherited method segfaulted.
                    //
                    // Forwarding is safe because the parent's fields are
                    // prepended to the child's, so parent field index i is also
                    // child field index i and all fields are i64. The one case
                    // where that does not hold is an actor inheriting from a
                    // non-actor: the actor gets two hidden fields prepended,
                    // shifting every inherited index by two.
                    if (this.actor_classes.has(name) and !this.actor_classes.has(cur_parent)) {
                        forward_method = false
                    }
                    // Without a known arity we cannot emit matching parameters,
                    // and a forwarder with the wrong arity is worse than none.
                    if (!this.called_function_arity.has(this.current_prefix + cur_parent + "__init")) {
                        forward_method = false
                    }
                }
                if (forward_method) {
                    // Register parent method as callable on child
                    child_methods.push(mname)
                    // Map ChildClass__method to ParentClass__method
                    var child_full: String = name + "__" + mname
                    var parent_full: String = cur_parent + "__" + mname
                    if (this.func_ret_types.has(parent_full)) {
                        this.func_ret_types.set(child_full, this.func_ret_types.get(parent_full))
                    } else {
                        this.func_ret_types.set(child_full, this.str_to_type("Int"))
                    }
                    this.known_functions.push(child_full)
                    // Emit a thin forwarder with proper parameter forwarding
                    var fwd_params_def: String = "i64 %self"
                    var fwd_params_call: String = "i64 %self"
                    var arity_key: String = this.current_prefix + parent_full
                    var fwd_arity: Float = 1
                    if (this.called_function_arity.has(arity_key)) {
                        var arity: Float = this.called_function_arity.get(arity_key)
                        fwd_arity = arity
                        var pi2: Float = 1
                        while (pi2 < arity) {
                            fwd_params_def = fwd_params_def + ", i64 %p" + pi2.floor().to_string()
                            fwd_params_call = fwd_params_call + ", i64 %p" + pi2.floor().to_string()
                            pi2 = pi2 + 1
                        }
                    }
                    // Register the forwarder's own arity, or a grandchild that
                    // inherits through it gets none: the init-forwarding guard
                    // (line 384) checks called_function_arity for the immediate
                    // parent, and a two-level chain (Puppy -> Dog -> Animal)
                    // would break at the second level, dropping constructor
                    // arguments and leaving fields zero (BUGS #87). Set both the
                    // bare and prefixed keys, matching gen_class_method.
                    this.called_function_arity.set(child_full, fwd_arity)
                    if (this.current_prefix.length() > 0) {
                        this.called_function_arity.set(this.current_prefix + child_full, fwd_arity)
                    }
                    this.emit("")
                    this.emit("define i64 @" + child_full + "(" + fwd_params_def + ") {")
                    this.emit("entry:")
                    this.emit("  %r = call i64 @" + parent_full + "(" + fwd_params_call + ")")
                    this.emit("  ret i64 %r")
                    this.emit("}")
                }
                i = i + 1
            }
        }
        ppi = ppi + 1
        }
        // Conformance: only a base's ABSTRACT (bodyless) methods are
        // requirements. Previously this keyed off "parent has no fields" as a
        // proxy for "parent is an interface", then demanded every parent method
        // be redeclared — which rejected legitimate inheritance from a
        // fieldless base class and forced implementors to copy interface
        // default-method bodies. child_methods has had every inherited name
        // pushed into it above, so a method inherited from a grandparent
        // correctly counts as satisfying the requirement.
        //
        // This runs in a SECOND loop, after all forwarding, not interleaved with
        // it. Interleaved, `class C extends Abstract, Provider` — Abstract
        // declares `foo` bodyless, Provider supplies a body — would be checked
        // against Abstract before Provider's foo had been forwarded, and report a
        // requirement that is in fact satisfied. That combination is a large part
        // of why multiple bases are worth having.
        var cpi: Float = 0
        while (cpi < parents.length()) {
            var conf_parent: String = parents[cpi]
            if (this.class_abstract_methods.has(conf_parent)) {
                var have: List = []
                if (this.class_methods.has(name)) { have = this.class_methods.get(name) }
                var required_methods: List = this.class_abstract_methods.get(conf_parent)
                var pi: Int = 0
                while (pi < required_methods.length()) {
                    var required: String = required_methods[pi]
                    if (required != "init" and !this.str_in_list(have,required)) {
                        IO.println("Error: class " + name + " does not implement " + conf_parent + "." + required + "()")
                    }
                    pi = pi + 1
                }
            }
            cpi = cpi + 1
        }
    }

    fun gen_class_decl(name: String, fields: String, methods: List<AST.Stmt>) {
        // Use module-prefixed type name to avoid cross-module class name collisions
        var type_name: String = name
        if (this.current_prefix.length() > 0) {
            type_name = this.current_prefix + name
        }
        this.class_fields.set(name, fields)
        this.class_struct_names.set(name, type_name)
        if (this.current_prefix.length() > 0) {
            this.class_fields.set(type_name, fields)
            this.class_struct_names.set(type_name, type_name)
        }

        // Parse field names for struct layout
        var field_list: List<String> = []
        var field_entries: List<String> = []
        var i: Float = 0
        if (fields.length() > 0) {
            var parts: List<String> = this.split_respecting_generics(fields, ",")
            while (i < parts.length()) {
                var fp: List<String> = parts[i].split(":")
                field_list.push(fp[0])
                field_entries.push(parts[i])
                i = i + 1
            }
        }
        // Store structured field list (each entry is "name:type")
        this.class_field_list.set(name, field_entries)
        if (this.current_prefix.length() > 0) {
            this.class_field_list.set(type_name, field_entries)
        }

        // Emit struct type: { i64 field0, i64 field1, ... }
        var num_fields: Float = field_list.length()
        if (!this.register_only and !this.str_in_list(this.known_functions,"__type_" + type_name)) {
            this.known_functions.push("__type_" + type_name)
            var field_types_str: String = ""
            var fi: Float = 0
            while (fi < num_fields) {
                if (fi > 0) { field_types_str = field_types_str + ", " }
                field_types_str = field_types_str + "i64"
                fi = fi + 1
            }
            this.type_defs.append("%" + type_name + " = type { " + field_types_str + " }\n")
        }

        // Register method names
        var method_names: List<String> = []
        var abstract_method_names: List<String> = []
        i = 0
        while (i < methods.length()) {
            var reg_mname: String = this.get_fun_name(methods[i])
            method_names.push(reg_mname)
            // Bodyless == abstract == a requirement on subclasses.
            if (this.get_fun_body(methods[i]).length() == 0) {
                abstract_method_names.push(reg_mname)
            }
            i = i + 1
        }
        this.class_methods.set(name, method_names)
        this.class_abstract_methods.set(name, abstract_method_names)

        // Pre-register all method return types so forward references resolve correctly
        i = 0
        while (i < methods.length()) {
            var mname: String = this.get_fun_name(methods[i])
            var mret: String = this.get_fun_ret(methods[i])
            var full_name: String = name + "__" + mname
            var prefixed_full: String = this.current_prefix + full_name
            this.func_ret_types.set(prefixed_full, this.str_to_type(mret))
            this.func_ret_types.set(full_name, this.str_to_type(mret))
            this.known_functions.push(prefixed_full)
            this.known_functions.push(full_name)
            this.func_prefix_map.set(full_name, prefixed_full)
            i = i + 1
        }

        // Pre-register constructor so methods can call ClassName(args)
        this.known_functions.push(type_name)
        if (this.current_prefix.length() > 0) {
            this.known_functions.push(name)
        }
        this.func_ret_types.set(type_name, this.str_to_type(name))
        this.func_ret_types.set(name, this.str_to_type(name))

        // Generate methods as functions with name prefix: ClassName__method
        // Methods get 'self' (i64 pointer to instance) as first param
        this.current_class = type_name
        i = 0
        while (i < methods.length()) {
            this.gen_class_method(name, methods[i])
            i = i + 1
        }

        // Generate constructor function: ClassName(args...) -> instance ptr
        this.gen_class_constructor(type_name, fields, field_list)
    }

    fun get_fun_name(stmt: AST.Stmt): String {
        return match (stmt) { FunDecl(n, p, r, b, d, f_vis) => n
            _ => ""
        }
    }

    fun get_fun_params(stmt: AST.Stmt): List<AST.Param> {
        return match (stmt) { FunDecl(n, p, r, b, d, f_vis) => p
            _ => []
        }
    }

    fun get_fun_ret(stmt: AST.Stmt): String {
        return match (stmt) { FunDecl(n, p, r, b, d, f_vis) => r
            _ => ""
        }
    }

    fun get_fun_body(stmt: AST.Stmt): List<AST.Stmt> {
        return match (stmt) { FunDecl(n, p, r, b, d, f_vis) => b
            _ => ""
        }
    }

    fun gen_class_method(class_name: String, method: AST.Stmt) {
        var mname: String = this.get_fun_name(method)
        var mparams: List<AST.Param> = this.get_fun_params(method)
        var mret: String = this.get_fun_ret(method)
        var mbody: List<AST.Stmt> = this.get_fun_body(method)
        var mdoc: String = this.get_fun_doc(method)
        var full_name: String = class_name + "__" + mname
        // Mark method for alwaysinline if annotated with @inline
        if (mdoc.starts_with("@inline")) {
            var inline_emit: String = this.current_prefix + full_name
            this.inline_funcs.push(inline_emit)
            this.inline_funcs.push(full_name)
        }
        var mparams_str: String = this.params_to_string(mparams)
        var full_params: String = "self:Int"
        if (mparams_str.length() > 0) {
            full_params = full_params + "," + mparams_str
        }
        var param_count: Float = 1
        if (mparams_str.length() > 0) {
            param_count = this.split_respecting_generics(mparams_str, ",").length() + 1
        }
        this.called_function_arity.set(full_name, param_count)
        if (this.current_prefix.length() > 0) {
            this.called_function_arity.set(this.current_prefix + full_name, param_count)
        }
        // Register param names for named arg dispatch (self + method params)
        var method_param_names: List<String> = []
        method_param_names.push("self")
        var mpi: Float = 0
        while (mpi < mparams.length()) {
            var mp: AST.Param = mparams[mpi]
            var mpn: String = match (mp) { Param(n, t, d, p_vis) => n }
            method_param_names.push(mpn)
            mpi = mpi + 1
        }
        this.func_param_names.set(full_name, method_param_names)
        if (this.current_prefix.length() > 0) {
            this.func_param_names.set(this.current_prefix + full_name, method_param_names)
        }
        // Register defaults for class methods
        var method_defaults: List<AST.Expr> = []
        method_defaults.push(AST.Expr.NilLit)
        mpi = 0
        while (mpi < mparams.length()) {
            var mp: AST.Param = mparams[mpi]
            var mdval: AST.Expr = match (mp) { Param(n, t, d, p_vis) => d }
            method_defaults.push(mdval)
            mpi = mpi + 1
        }
        this.func_defaults.set(full_name, method_defaults)
        if (this.current_prefix.length() > 0) {
            this.func_defaults.set(this.current_prefix + full_name, method_defaults)
        }
        this.func_param_count.set(full_name, param_count)
        if (this.current_prefix.length() > 0) {
            this.func_param_count.set(this.current_prefix + full_name, param_count)
        }
        this.gen_function(full_name, full_params, mret, mbody)
    }

    fun gen_class_constructor(type_name: String, fields: String, field_list: List<String>) {
        var num_fields: Float = field_list.length()
        var struct_size: Float = num_fields * 8
        this.known_functions.push(type_name)
        this.func_ret_types.set(type_name, this.str_to_type(type_name))
        // Assign a unique type ID for reflection (tags >= 10 are per-class)
        if (!this.class_type_ids.has(type_name)) {
            this.class_type_ids.set(type_name, this.next_class_type_id)
            this.next_class_type_id = this.next_class_type_id + 1
        }
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,type_name)) { return }
        this.defined_funcs.push(type_name)
        this.emit("")
        var ctor_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            ctor_linkage = "define"
        }
        this.emit(ctor_linkage + " i64 @" + type_name + "() {")
        this.emit("entry:")
        this.block_terminated = false
        // Allocate instance on GC-tracked heap with per-class type tag
        var class_tag: Float = this.class_type_ids.get(type_name)
        var raw: String = this.fresh_local()
        if (this.identity_mode) {
            this.emit_indent(raw + " = call i8* @__sf_malloc(i64 " + struct_size.floor().to_string() + ")")
        } else {
            this.emit_indent(raw + " = call i64 @__gc_alloc(i64 " + struct_size.floor().to_string() + ", i64 " + class_tag.floor().to_string() + ")")
        }
        var ptr: String = ""
        if (this.identity_mode) {
            ptr = this.fresh_local()
            this.emit_indent(ptr + " = bitcast i8* " + raw + " to %" + type_name + "*")
        } else {
            ptr = this.fresh_local()
            this.emit_indent(ptr + " = inttoptr i64 " + raw + " to %" + type_name + "*")
        }
        // Zero-initialize fields
        var i: Float = 0
        while (i < num_fields) {
            var field_ptr: String = this.fresh_local()
            this.emit_indent(field_ptr + " = getelementptr %" + type_name + ", %" + type_name + "* " + ptr + ", i32 0, i32 " + i.floor().to_string())
            this.emit_indent("store i64 0, i64* " + field_ptr)
            i = i + 1
        }
        // Return as i64
        var result: String = this.typed_ptr_to_val(ptr, "%" + type_name + "*")
        this.emit_terminator("ret i64 " + result)
        this.emit("}")
        this.block_terminated = false
    }

    fun get_variant_name(v: AST.Variant): String {
        return match (v) { Variant(n, f) => n
            _ => ""
        }
    }

    fun get_variant_fields(v: AST.Variant): String {
        return match (v) { Variant(n, f) => f
            _ => ""
        }
    }

    fun register_variant(name: String, variant_names: List<String>, v: AST.Variant, idx: Float) {
        var vname: String = this.get_variant_name(v)
        var vfields: String = this.get_variant_fields(v)
        variant_names.push(vname)
        this.enum_variant_tags.set(name + "." + vname, idx)
        this.enum_variant_fields.set(name + "." + vname, vfields)
    }

    fun gen_enum_decl(name: String, variants: List<AST.Variant>) {
        var variant_names: List<String> = []
        var i: Float = 0
        while (i < variants.length()) {
            this.register_variant(name, variant_names, variants[i], i)
            i = i + 1
        }
        this.enum_defs.set(name, variant_names)
        if (!this.register_only and !this.str_in_list(this.known_functions,"__type_" + name)) {
            this.known_functions.push("__type_" + name)
            this.type_defs.append("%" + name + " = type { i8, [16 x i8] }\n")
        }

        // Emit constructor functions for variants with fields
        var max_fields: Float = this.get_max_fields(name)
        i = 0
        while (i < variants.length()) {
            var v: AST.Variant = variants[i]
            var vname: String = match (v) { Variant(n, f) => n
                _ => ""
            }
            var vfields: String = match (v) { Variant(n, f) => f
                _ => ""
            }
            if (vfields.length() > 0) {
                this.emit_enum_constructor(vname, i, vfields, max_fields)
            }
            i = i + 1
        }

        // Emit to_string function for this enum
        this.emit_enum_to_string(name, variants)
    }

    fun emit_enum_to_string(name: String, variants: List<AST.Variant>) {
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,name + "__to_string")) { return }
        this.defined_funcs.push(name + "__to_string")
        var max_fields: Float = this.get_max_fields(name)
        var func_name: String = name + "__to_string"

        this.emit("")
        var ts_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            ts_linkage = "define"
        }
        this.emit(ts_linkage + " i64 @" + func_name + "(i64 %self) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()

        // Extract tag based on encoding.
        //
        // The threshold is `== 0`, not `<= 1`. gen_enum_construct (expr_body.sf)
        // and gen_match (match_body.sf) both switch to the heap [tag, f0, ...]
        // array as soon as ANY variant has a field, so a one-field enum is an
        // array too. This used to read `<= 1` and so decoded a one-field enum's
        // heap pointer as a `tag << 56` immediate: `lshr ptr, 56` yields 0 for
        // any real pointer, which is variant 0's tag, so every value of such an
        // enum stringified as its FIRST variant regardless of what it was, and
        // the "payload" it printed was the low 56 bits of the pointer.
        var tag_val: String = ""
        if (max_fields == 0) {
            tag_val = this.fresh_local()
            this.emit_indent(tag_val + " = lshr i64 %self, 56")
        } else {
            var arr_ptr: String = this.val_to_typed_ptr("%self", "i64*")
            tag_val = this.fresh_local()
            this.emit_indent(tag_val + " = load i64, i64* " + arr_ptr)
        }

        // Build switch on tag
        var end_label: String = this.fresh_label("ets.end")
        var arm_labels: List<String> = []
        var i: Float = 0
        while (i < variants.length()) {
            arm_labels.push(this.fresh_label("ets.v"))
            i = i + 1
        }

        var switch_cases: String = ""
        i = 0
        while (i < variants.length()) {
            switch_cases = switch_cases + " i64 " + i.floor().to_string() + ", label %" + arm_labels[i]
            i = i + 1
        }
        this.emit_indent("switch i64 " + tag_val + ", label %" + end_label + " [" + switch_cases + " ]")
        this.block_terminated = true

        // Emit each variant arm
        i = 0
        while (i < variants.length()) {
            var v: AST.Variant = variants[i]
            var vname: String = this.get_variant_name(v)
            var vfields: String = this.get_variant_fields(v)

            this.start_block(arm_labels[i])

            if (vfields.length() == 0) {
                // No fields: just return "VariantName"
                var const_name: String = this.add_string_constant(vname)
                var str_len: Float = vname.length() + 1
                var gep: String = this.fresh_local()
                this.emit_indent(gep + " = getelementptr [" + str_len.to_string() + " x i8], [" + str_len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
                var as_i64: String = this.ptr_to_val(gep)
                this.emit_terminator("ret i64 " + as_i64)
            } else {
                // Has fields: build "VariantName(field0, field1, ...)"
                var parts: List<String> = this.split_respecting_generics(vfields, ",")
                var num_fields: Float = parts.length()

                // Allocate StringBuilder via malloc + manual concat
                // Start with "VariantName("
                var prefix_str: String = vname + "("
                var prefix_const: String = this.add_string_constant(prefix_str)
                var prefix_len: Float = prefix_str.length() + 1
                var prefix_gep: String = this.fresh_local()
                this.emit_indent(prefix_gep + " = getelementptr [" + prefix_len.to_string() + " x i8], [" + prefix_len.to_string() + " x i8]* " + prefix_const + ", i64 0, i64 0")
                var prefix_i64: String = this.ptr_to_val(prefix_gep)

                // Create a StringBuilder, append prefix
                var sb: String = this.fresh_local()
                this.emit_indent(sb + " = call i64 @StringBuilder()")
                this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + prefix_i64 + ")")

                // For each field, extract, convert to string, append
                var fi: Float = 0
                while (fi < num_fields) {
                    // Extract field value
                    var field_val: String = ""
                    if (max_fields == 0) {
                        // Simple encoding: value = self & 0x00FFFFFFFFFFFFFF.
                        // Unreachable in practice — max_fields == 0 means no
                        // variant has a field, so num_fields is 0 and this loop
                        // never runs. Kept as the mirror of the tag read above.
                        field_val = this.fresh_local()
                        this.emit_indent(field_val + " = and i64 %self, 72057594037927935")
                    } else {
                        // Array encoding: fields start at index 1
                        var num_slots: Float = num_fields + 1
                        var total_str: String = num_slots.floor().to_string()
                        var f_arr: String = this.val_to_typed_ptr("%self", "[" + total_str + " x i64]*")
                        var field_idx: Float = fi + 1
                        var f_slot: String = this.fresh_local()
                        this.emit_indent(f_slot + " = getelementptr [" + total_str + " x i64], [" + total_str + " x i64]* " + f_arr + ", i64 0, i64 " + field_idx.floor().to_string())
                        field_val = this.fresh_local()
                        this.emit_indent(field_val + " = load i64, i64* " + f_slot)
                    }

                    // Determine field type and convert to string
                    var field_part: String = parts[fi]
                    var field_type: String = "Int"
                    if (field_part.contains(":")) {
                        var ft_parts: List<String> = field_part.split(":")
                        if (ft_parts.length() > 1) {
                            field_type = ft_parts[1]
                        }
                    }

                    // The payload slot holds a fully NaN-boxed value —
                    // gen_enum_construct stores gen_arg_value's result verbatim —
                    // while __sb_append takes a RAW char* (it calls strlen on it,
                    // through an @extern, so every argument must be untagged).
                    // Each arm below is responsible for landing on a raw pointer.
                    //
                    // Two of the three arms used to get this wrong. A String field
                    // was appended still tagged, so strlen dereferenced
                    // 0x7FF8_0000_0000_0000|ptr and the process died — printing any
                    // enum carrying a String was a segfault. A Bool field was
                    // handed to __bool_to_string without untagging, and that helper
                    // tests `!= 0` against a raw 0/1 on three of the four bases, so
                    // tagged `false` (0x7FFA000000000000, nonzero) read as true:
                    // every Bool field printed "true". Float had no arm at all and
                    // fell into __int_to_string via emit_untag_int, which reads a
                    // double's bits as an integer.
                    //
                    // The arm list is also the whole of the type coverage, and it
                    // was missing List, Map and nested enum (BUGS #108). Those
                    // three fell into the final `else`, which untags the payload as
                    // an integer and formats it with __int_to_string — so a List
                    // payload printed its heap ADDRESS in decimal, varying between
                    // runs of one unchanged binary, and a nested enum printed the
                    // low bits of its `tag << 56` immediate as 0. A String payload
                    // is a heap pointer too and printed fine, which is what showed
                    // this was a missing-formatter list rather than an inability to
                    // handle heap payloads.
                    //
                    // The three arms added below call the SAME helpers the ordinary
                    // `.to_string()` dispatch in methods_body.sf uses for these
                    // types — __list_to_string, __map_to_string, and the payload
                    // enum's own generated to_string. All three already return a
                    // raw char*, which is exactly what __sb_append wants, so no
                    // tag/untag step belongs on any of them. Routing through
                    // __any_to_string was the alternative and is deliberately not
                    // taken: it does not exist in wasm_base.ll, and a static type
                    // is in hand here so the runtime dispatch buys nothing.
                    var field_str: String = ""
                    if (field_type == "String") {
                        var s_ptr: String = this.emit_untag_ptr(field_val)
                        field_str = this.ptr_to_val(s_ptr)
                    } else if (field_type.starts_with("List")) {
                        // __list_to_string accepts the value as stored: a list
                        // literal reaches the payload slot as __list_new's raw
                        // pointer, and the helper inttoptr's whatever it is given
                        // — the same call shape as `"${a_list}"` on a bare local.
                        this.called_functions.push("__list_to_string")
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__list_to_string(i64 " + field_val + ")")
                    } else if (field_type.starts_with("Map")) {
                        this.called_functions.push("__map_to_string")
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__map_to_string(i64 " + field_val + ")")
                    } else if (this.enum_defs.has(field_type)) {
                        // A nested enum formats itself. Its generated to_string
                        // knows its own encoding — `tag << 56` for a fieldless
                        // enum, the heap array otherwise — which is the whole
                        // reason this cannot be open-coded here.
                        var nested_ts: String = field_type + "__to_string"
                        this.called_functions.push(nested_ts)
                        this.called_function_arity.set(nested_ts, 1)
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @" + nested_ts + "(i64 " + field_val + ")")
                    } else if (field_type == "Bool") {
                        var b_raw: String = this.emit_untag_bool(field_val)
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__bool_to_string(i64 " + b_raw + ")")
                    } else if (field_type == "Float" or field_type == "Number") {
                        // __float_to_string takes the tagged value: it untags
                        // internally and its int-tagged path is a sitofp, so a
                        // whole-number Float that happens to be int-tagged still
                        // formats correctly (BUGS #83).
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__float_to_string(i64 " + field_val + ")")
                    } else {
                        var field_raw: String = this.emit_untag_int(field_val)
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__int_to_string(i64 " + field_raw + ")")
                    }

                    this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + field_str + ")")

                    // Append ", " between fields
                    if (fi < num_fields - 1) {
                        var comma_const: String = this.add_string_constant(", ")
                        var comma_len: Float = 3
                        var comma_gep: String = this.fresh_local()
                        this.emit_indent(comma_gep + " = getelementptr [" + comma_len.to_string() + " x i8], [" + comma_len.to_string() + " x i8]* " + comma_const + ", i64 0, i64 0")
                        var comma_i64: String = this.ptr_to_val(comma_gep)
                        this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + comma_i64 + ")")
                    }

                    fi = fi + 1
                }

                // Append closing ")"
                var close_const: String = this.add_string_constant(")")
                var close_len: Float = 2
                var close_gep: String = this.fresh_local()
                this.emit_indent(close_gep + " = getelementptr [" + close_len.to_string() + " x i8], [" + close_len.to_string() + " x i8]* " + close_const + ", i64 0, i64 0")
                var close_i64: String = this.ptr_to_val(close_gep)
                this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + close_i64 + ")")

                // Finalize
                var result: String = this.fresh_local()
                this.emit_indent(result + " = call i64 @__sb_to_string(i64 " + sb + ")")
                this.emit_terminator("ret i64 " + result)
            }

            i = i + 1
        }

        // Default case (unreachable but needed)
        this.start_block(end_label)
        var empty_const: String = this.add_string_constant("Unknown")
        var empty_len: Float = 8
        var empty_gep: String = this.fresh_local()
        this.emit_indent(empty_gep + " = getelementptr [" + empty_len.to_string() + " x i8], [" + empty_len.to_string() + " x i8]* " + empty_const + ", i64 0, i64 0")
        var empty_i64: String = this.ptr_to_val(empty_gep)
        this.emit_terminator("ret i64 " + empty_i64)

        this.emit("}")
        this.block_terminated = false
        this.known_functions.push(func_name)
        this.func_ret_types.set(func_name, this.str_to_type("String"))
    }

    fun emit_enum_constructor(vname: String, tag: Float, fields_str: String, max_fields: Float) {
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,vname)) { return }
        this.defined_funcs.push(vname)
        var parts: List<String> = this.split_respecting_generics(fields_str, ",")
        var num_fields: Float = parts.length()

        // Build param list: (i64 %f0, i64 %f1, ...)
        var params: String = ""
        var pi: Float = 0
        while (pi < num_fields) {
            if (pi > 0) { params = params + ", " }
            params = params + "i64 %f" + pi.floor().to_string()
            pi = pi + 1
        }

        this.emit("")
        var ev_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            ev_linkage = "define"
        }
        this.emit(ev_linkage + " i64 @" + vname + "(" + params + ") {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()

        // `== 0`, matching gen_enum_construct and gen_match. This is only
        // reachable with at least one field (the caller guards on
        // `vfields.length() > 0`), so the simple-encoding branch is dead — but
        // it read `<= 1` and would have packed a one-field variant as
        // `tag << 56 | value`, which no reader decodes that way. Left in place
        // and corrected rather than deleted, so the three encoding decisions
        // read identically.
        if (max_fields == 0) {
            // Simple encoding: (tag << 56) | value
            var t: String = this.fresh_local()
            this.emit_indent(t + " = shl i64 " + tag.floor().to_string() + ", 56")
            var r: String = this.fresh_local()
            this.emit_indent(r + " = or i64 " + t + ", %f0")
            this.emit_terminator("ret i64 " + r)
        } else {
            // Array encoding: malloc [tag, f0, f1, ...]
            var num_slots: Float = num_fields + 1
            var arr_bytes: Float = num_slots * 8
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = call i8* @__sf_malloc(i64 " + arr_bytes.floor().to_string() + ")")
            var arr: String = this.fresh_local()
            this.emit_indent(arr + " = bitcast i8* " + raw + " to [" + num_slots.floor().to_string() + " x i64]*")
            // Store tag
            var ts: String = this.fresh_local()
            this.emit_indent(ts + " = getelementptr [" + num_slots.floor().to_string() + " x i64], [" + num_slots.floor().to_string() + " x i64]* " + arr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + ts)
            // Store fields
            var fi: Float = 0
            while (fi < num_fields) {
                var slot: String = this.fresh_local()
                var slot_idx: Float = fi + 1
                this.emit_indent(slot + " = getelementptr [" + num_slots.floor().to_string() + " x i64], [" + num_slots.floor().to_string() + " x i64]* " + arr + ", i64 0, i64 " + slot_idx.floor().to_string())
                this.emit_indent("store i64 %f" + fi.floor().to_string() + ", i64* " + slot)
                fi = fi + 1
            }
            var result: String = this.typed_ptr_to_val(arr, "[" + num_slots.floor().to_string() + " x i64]*")
            this.emit_terminator("ret i64 " + result)
        }

        this.emit("}")
        this.block_terminated = false
        this.known_functions.push(vname)
    }

    fun get_enum_decl_name(stmt: AST.Stmt): String {
        return match (stmt) { EnumDecl(n, v, d, e_vis) => n
            _ => ""
        }
    }

    fun get_enum_decl_variants(stmt: AST.Stmt): List<AST.Variant> {
        return match (stmt) { EnumDecl(n, v, d, e_vis) => v
            _ => ""
        }
    }

    fun register_external_enums(decls: List<AST.Stmt>) {
        var i: Float = 0
        while (i < decls.length()) {
            this.try_register_enum(decls[i])
            i = i + 1
        }
    }

    fun try_register_enum(decl: AST.Stmt) {
        match (decl) {
            EnumDecl(name, variants, doc, e_vis) => {
                this.register_enum_variants(name, variants)
            }
            VarDecl(n, t, i, d, v_vis) => {}
            FunDecl(n, p, r, b, d, f_vis) => {}
            ClassDecl(n, __tps, ps, f, m, d, c_vis) => {}
            If(c, t, e) => {}
            While(c, b) => {}
            Block(s) => {}
            ExprStmt(e) => {}
            Return(v) => {}
            Break => {}
            Continue => {}
            TryCatch(t, n, c, f) => {}
            Throw(v) => {}
            LetPattern(p, v) => {}
            TypeAlias(ta_n, ta_t, ta_vis) => {}
        }
    }

    fun register_enum_variants(name: String, variants: List<AST.Variant>) {
        var variant_names: List<String> = []
        var j: Float = 0
        while (j < variants.length()) {
            this.register_variant(name, variant_names, variants[j], j)
            j = j + 1
        }
        this.enum_defs.set(name, variant_names)
    }

    fun emit_block_alloca_for(stmt: AST.Stmt) {
        var vname: String = match (stmt) { VarDecl(n, t, init, d, v_vis) => n
            _ => ""
        }
        var vdoc: String = match (stmt) { VarDecl(n, t, init, d, v_vis) => d
            _ => ""
        }
        if (vdoc.starts_with("@import:")) { return }
        if (!this.typed_vars.has(vname) and !this.str_in_list(this.known_functions,"__alloc_" + vname)) {
            this.known_functions.push("__alloc_" + vname)
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_alloca("%" + this.sanitize_name(vname), "i64"))
            } else {
                this.emit_indent("%" + this.sanitize_name(vname) + " = alloca i64")
                this.verify_alloca("%" + this.sanitize_name(vname), "i64")
            }
        }
    }

    fun emit_block_allocas(stmts: List<AST.Stmt>) {
        var i: Float = 0
        while (i < stmts.length()) {
            var kind: String = this.classify_stmt(stmts[i])
            if (kind == "var") {
                this.emit_block_alloca_for(stmts[i])
            }
            i = i + 1
        }
    }

    fun gen_stmts(stmts: List<AST.Stmt>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.gen_stmt(stmts[i])
            i = i + 1
        }
    }

    fun to_i1(val: String): String {
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_trunc(local, val, "i64", "i1"))
            // LLVM lib parallel path: track trunc value
            if (!this.identity_mode and this.llvm_values.has(val)) {
                var val_v: Any = this.llvm_values.get(val)
                var tr_v: Any = this.llvm_block_builder.trunc(val_v, LLVMTypes.Type.I1)
                this.llvm_values.set(local, tr_v)
            }
        } else {
            this.emit_indent(local + " = trunc i64 " + val + " to i1")
            this.verify_trunc(local, val, "i64", "i1")
        }
        return local
    }

    fun gen_if(cond: AST.Expr, then_branch: List<AST.Stmt>, else_branch: List<AST.Stmt>) {
        var end_label: String = this.fresh_label("endif")
        var current_cond: AST.Expr = cond
        var current_then: List<AST.Stmt> = then_branch
        var current_else: List<AST.Stmt> = else_branch

        // LLVM lib parallel path: create end block upfront
        var llvm_end_bb: Any = nil
        if (!this.identity_mode and this.use_llvm_lib) {
            llvm_end_bb = this.llvm_func_builder.new_block(end_label)
        }

        // Iterative else-if chain to avoid deep C stack recursion
        while (true) {
            var cond_val: String = this.to_i1(this.gen_arg_value(current_cond))
            var then_label: String = this.fresh_label("then")
            var else_label: String = this.fresh_label("else")

            if (this.use_llvm_lib) {
                this.emit_terminator(this.lib_cond_br(cond_val, then_label, else_label))
                // LLVM lib parallel path: emit conditional branch and switch to then block
                if (!this.identity_mode and this.llvm_values.has(cond_val)) {
                    var cond_v: Any = this.llvm_values.get(cond_val)
                    this.llvm_block_builder.cond_br_labels_set(cond_v, then_label, else_label)
                    var llvm_then_bb: Any = this.llvm_func_builder.new_block(then_label)
                    this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_then_bb)
                    this.llvm_block_builder.init(this.llvm_func_builder, llvm_then_bb)
                }
            } else {
                this.emit_terminator("br i1 " + cond_val + ", label %" + then_label + ", label %" + else_label)
                this.verify_cond_br(cond_val, then_label, else_label)
            }

            this.start_block(then_label)
            this.gen_stmts(current_then)
            if (this.use_llvm_lib) {
                this.emit_terminator(this.lib_br(end_label))
                // LLVM lib parallel path: terminate then block, switch to else block
                if (!this.identity_mode) {
                    this.llvm_block_builder.br_label_set(end_label)
                    var llvm_else_bb: Any = this.llvm_func_builder.new_block(else_label)
                    this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_else_bb)
                    this.llvm_block_builder.init(this.llvm_func_builder, llvm_else_bb)
                }
            } else {
                this.emit_terminator("br label %" + end_label)
                this.verify_br(end_label)
            }

            this.start_block(else_label)

            // Check if else is a single If (else-if chain)
            var is_elseif: Bool = false
            if (current_else.length() == 1) {
                if (this.classify_stmt(current_else[0]) == "if") {
                    is_elseif = true
                }
            }
            if (is_elseif) {
                var nested: Any = current_else[0]
                current_cond = match (nested) { If(c, t, e) => c   _ => AST.Expr.NilLit }
                current_then = match (nested) { If(c, t, e) => t   _ => [] }
                current_else = match (nested) { If(c, t, e) => e   _ => [] }
                // Continue loop instead of recursing
            } else {
                // Final else or no else
                if (current_else.length() > 0) {
                    this.gen_stmts(current_else)
                }
                this.emit_terminator("br label %" + end_label)
                // LLVM lib parallel path: terminate else block, switch to end block
                if (!this.identity_mode and this.use_llvm_lib) {
                    this.llvm_block_builder.br_label_set(end_label)
                    this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_end_bb)
                    this.llvm_block_builder.init(this.llvm_func_builder, llvm_end_bb)
                }
                break
            }
        }

        this.start_block(end_label)
    }

        fun classify_stmt(stmt: AST.Stmt): String {
        return match (stmt) {
            If(c, t, e) => "if"
            ExprStmt(expr) => "expr"
            VarDecl(n, t, i, d, v_vis) => "var"
            FunDecl(n, p, r, b, d, f_vis) => "fun"
            EnumDecl(n, v, d, e_vis) => "enum"
            ClassDecl(n, __tps, ps, f, m, d, c_vis) => "class"
            Return(v) => "return"
            While(c, b) => "while"
            Block(s) => "block"
            Break => "break"
            Continue => "continue"
            TryCatch(t, n, c, f) => "try"
            Throw(v) => "throw"
            LetPattern(p, v) => "let_pattern"
            // A type alias is erased by the time codegen runs — resolve.sf has
            // already rewritten every use of the name. It still has to be named
            // here: `classify_stmt` returns one tag per variant, and until BUGS
            // #76 made the checker walk method bodies, a missing arm yielded an
            // indeterminate string rather than an error.
            TypeAlias(ta_n, ta_t, ta_vis) => "type_alias"
        }
    }

    fun is_if_stmt(stmt: AST.Stmt): Bool {
        var kind: Any = match (stmt) {
            If(c, t, e) => "if"
            ExprStmt(expr) => "other"
            VarDecl(n, t, i, d, v_vis) => "other"
            FunDecl(n, p, r, b, d, f_vis) => "other"
            EnumDecl(n, v, d, e_vis) => "other"
            ClassDecl(n, __tps, ps, f, m, d, c_vis) => "other"
            Return(v) => "other"
            While(c, b) => "other"
            Block(s) => "other"
            Break => "other"
            Continue => "other"
            TryCatch(t, n, c, f) => "other"
            Throw(v) => "other"
            LetPattern(p, v) => "other"
            TypeAlias(ta_n, ta_t, ta_vis) => "other"
        }
        return kind == "if"
    }

    fun gen_let_pattern(pattern: AST.Pattern, value: AST.Expr) {
        var variant_name: String = match (pattern) {
            VariantPattern(v, b) => v
            ArrayPattern(e, r) => "__array:" + r
            _ => ""
        }
        var bindings: List<String> = match (pattern) {
            VariantPattern(v, b) => b
            ArrayPattern(e, r) => e
            _ => []
        }
        var val: String = this.gen_arg_value(value)
        var val_type: AST.Type = this.last_type
        if (variant_name.starts_with("__array:")) {
            this.gen_let_array_pattern(bindings, variant_name, val, val_type)
            return
        }
        // For variant patterns, extract fields from the tagged value
        if (bindings.length() > 0) {
            // Determine the enum name from the variant
            var enum_name: String = this.find_enum_for_variant(variant_name)
            var max_fields: Float = 0
            if (enum_name != "Unknown") {
                max_fields = this.get_max_fields(enum_name)
            }
            // Use extract_arm_bindings which handles both encodings
            this.extract_arm_bindings(bindings, val, max_fields)
            // Set type information for each binding
            var bi: Float = 0
            while (bi < bindings.length()) {
                var btype: String = "Int"
                if (enum_name != "Unknown") {
                    btype = this.get_variant_field_type(enum_name, variant_name, bi)
                }
                this.typed_vars.set(bindings[bi], this.str_to_type(btype))
                if (btype == "String") {
                    this.string_vars.push(bindings[bi])
                }
                bi = bi + 1
            }
        }
    }

    fun gen_let_array_pattern(elements: List<String>, variant_name: String, val: String, val_type: AST.Type) {
        var rest: String = variant_name.slice(8, variant_name.length())
        // Infer element type from list type
        var elem_type_str: String = "Int"
        var list_type_str: String = this.type_to_string(val_type)
        if (list_type_str.starts_with("List<") and list_type_str.ends_with(">")) {
            elem_type_str = list_type_str.slice(5, list_type_str.length() - 1)
        }
        var elem_type: AST.Type = this.str_to_type(elem_type_str)
        var i: Float = 0
        while (i < elements.length()) {
            var elem_val: String = this.fresh_local()
            this.emit_indent(elem_val + " = call i64 @__list_get(i64 " + val + ", i64 " + i.floor().to_string() + ")")
            this.emit_indent("store i64 " + elem_val + ", i64* %" + this.sanitize_name(elements[i]))
            this.typed_vars.set(elements[i], elem_type)
            if (elem_type_str == "String") {
                this.string_vars.push(elements[i])
            }
            i = i + 1
        }
        if (rest.length() > 0) {
            var len_val: String = this.fresh_local()
            this.emit_indent(len_val + " = call i64 @__list_length(i64 " + val + ")")
            var rest_val: String = this.fresh_local()
            this.emit_indent(rest_val + " = call i64 @__list_slice(i64 " + val + ", i64 " + elements.length().floor().to_string() + ", i64 " + len_val + ")")
            this.emit_indent("store i64 " + rest_val + ", i64* %" + this.sanitize_name(rest))
            this.typed_vars.set(rest, val_type)
        }
    }

    fun gen_throw(value: AST.Expr) {
        var val: String = this.gen_arg_value(value)
        this.emit_indent("store i64 " + val + ", i64* @__exception_value")
        // Load the current jmp_buf pointer and check for null (uncaught exception)
        var jmp_ptr: String = this.fresh_local()
        this.emit_indent(jmp_ptr + " = load i8*, i8** @__jmp_buf_current")
        var is_null: String = this.fresh_local()
        this.emit_indent(is_null + " = icmp eq i8* " + jmp_ptr + ", null")
        var uncaught_label: String = this.fresh_label("uncaught")
        var do_throw_label: String = this.fresh_label("do_throw")
        this.emit_terminator("br i1 " + is_null + ", label %" + uncaught_label + ", label %" + do_throw_label)
        // Uncaught exception: convert to string, print fatal error, and exit
        this.start_block(uncaught_label)
        var msg_str: String = this.fresh_local()
        this.emit_indent(msg_str + " = call i64 @__any_to_string(i64 " + val + ")")
        this.emit_indent("call i64 @__runtime_error_fatal(i64 " + msg_str + ")")
        this.emit_indent("call void @exit(i32 1)")
        this.emit_terminator("unreachable")
        // Normal throw: longjmp to handler
        this.start_block(do_throw_label)
        this.emit_indent("call void @longjmp(i8* " + jmp_ptr + ", i32 1)")
        this.emit_terminator("unreachable")
    }

    fun gen_try_catch(try_body: List<AST.Stmt>, catch_name: String, catch_body: List<AST.Stmt>, finally_body: List<AST.Stmt>) {
        var try_label: String = this.fresh_label("try")
        var catch_label: String = this.fresh_label("catch")
        var finally_label: String = this.fresh_label("finally")
        var end_label: String = this.fresh_label("tryend")

        // Was annotated Float while holding a comparison result. It is only ever
        // used as an `if` condition, so nothing misbehaved — but the annotation
        // was simply wrong, and no pass rejected it until the checker began
        // walking method bodies (BUGS #76).
        var has_finally: Bool = finally_body.length() > 0

        // Allocate a local jmp_buf on the stack (512 bytes, enough for any platform)
        var jmp_buf: String = this.fresh_local()
        this.emit_indent(jmp_buf + " = alloca [512 x i8], align 16")
        var jmp_buf_ptr: String = this.fresh_local()
        this.emit_indent(jmp_buf_ptr + " = getelementptr [512 x i8], [512 x i8]* " + jmp_buf + ", i64 0, i64 0")

        // Save the previous jmp_buf pointer (for nested try/catch)
        var saved_jmp: String = this.fresh_local()
        this.emit_indent(saved_jmp + " = load i8*, i8** @__jmp_buf_current")
        // Set current jmp_buf to our local buffer
        this.emit_indent("store i8* " + jmp_buf_ptr + ", i8** @__jmp_buf_current")

        // Save shadow stack depth so we can restore it on catch (longjmp skips pop_roots)
        var saved_ss_depth: String = this.fresh_local()
        this.emit_indent(saved_ss_depth + " = call i64 @__gc_shadow_stack_depth()")

        // setjmp returns 0 on first call, non-zero on longjmp
        var setjmp_result: String = this.fresh_local()
        this.emit_indent(setjmp_result + " = call i32 @setjmp(i8* " + jmp_buf_ptr + ")")
        var is_throw: String = this.fresh_local()
        this.emit_indent(is_throw + " = icmp ne i32 " + setjmp_result + ", 0")
        this.emit_terminator("br i1 " + is_throw + ", label %" + catch_label + ", label %" + try_label)

        // Try body
        this.start_block(try_label)
        this.gen_stmts(try_body)
        if (!this.block_terminated) {
            // Restore previous jmp_buf before leaving try
            this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
            if (has_finally) {
                this.emit_terminator("br label %" + finally_label)
            } else {
                this.emit_terminator("br label %" + end_label)
            }
        }

        // Catch body
        this.start_block(catch_label)
        // Restore previous jmp_buf before running catch (so re-throws use outer handler)
        this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
        // Restore shadow stack depth (longjmp skipped pop_roots in unwound frames)
        var cur_ss_depth: String = this.fresh_local()
        this.emit_indent(cur_ss_depth + " = call i64 @__gc_shadow_stack_depth()")
        var ss_pop_n: String = this.fresh_local()
        this.emit_indent(ss_pop_n + " = sub i64 " + cur_ss_depth + ", " + saved_ss_depth)
        this.emit_indent("call void @__gc_pop_roots(i64 " + ss_pop_n + ")")
        // Load exception value into catch variable
        var exc_val: String = this.fresh_local()
        this.emit_indent(exc_val + " = load i64, i64* @__exception_value")
        this.emit_indent("store i64 " + exc_val + ", i64* %" + this.sanitize_name(catch_name))
        this.typed_vars.set(catch_name, AST.Type.StringType)
        this.gen_stmts(catch_body)
        if (!this.block_terminated) {
            if (has_finally) {
                this.emit_terminator("br label %" + finally_label)
            } else {
                this.emit_terminator("br label %" + end_label)
            }
        }

        // Finally body (runs after both try and catch paths)
        if (has_finally) {
            this.start_block(finally_label)
            this.gen_stmts(finally_body)
            if (!this.block_terminated) {
                this.emit_terminator("br label %" + end_label)
            }
        }

        this.start_block(end_label)
    }

    fun gen_while(cond: AST.Expr, body: List<AST.Stmt>) {
        var cond_label: String = this.fresh_label("while.cond")
        var body_label: String = this.fresh_label("while.body")
        var end_label: String = this.fresh_label("while.end")

        var saved_loop_end: String = this.loop_end_label
        var saved_break: String = this.loop_break_label
        var saved_continue: String = this.loop_continue_label
        this.loop_end_label = end_label + ":" + cond_label
        this.loop_break_label = end_label
        this.loop_continue_label = cond_label

        // LLVM lib parallel path: create blocks for while structure
        var llvm_cond_bb: Any = nil
        var llvm_body_bb: Any = nil
        var llvm_end_bb: Any = nil
        if (!this.identity_mode and this.use_llvm_lib) {
            llvm_cond_bb = this.llvm_func_builder.new_block(cond_label)
            llvm_body_bb = this.llvm_func_builder.new_block(body_label)
            llvm_end_bb = this.llvm_func_builder.new_block(end_label)
        }

        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(cond_label))
            // LLVM lib parallel path: br to cond block, switch builder
            if (!this.identity_mode) {
                this.llvm_block_builder.br_label_set(cond_label)
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_cond_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_cond_bb)
            }
        } else {
            this.emit_terminator("br label %" + cond_label)
            this.verify_br(cond_label)
        }

        this.start_block(cond_label)
        var cond_val: String = this.to_i1(this.gen_arg_value(cond))
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_cond_br(cond_val, body_label, end_label))
            // LLVM lib parallel path: cond_br, switch to body block
            if (!this.identity_mode and this.llvm_values.has(cond_val)) {
                var cond_v: Any = this.llvm_values.get(cond_val)
                this.llvm_block_builder.cond_br_labels_set(cond_v, body_label, end_label)
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_body_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_body_bb)
            }
        } else {
            this.emit_terminator("br i1 " + cond_val + ", label %" + body_label + ", label %" + end_label)
            this.verify_cond_br(cond_val, body_label, end_label)
        }

        this.start_block(body_label)
        this.gen_stmts(body)
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(cond_label))
            // LLVM lib parallel path: loop back to cond, switch to end block
            if (!this.identity_mode) {
                this.llvm_block_builder.br_label_set(cond_label)
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_end_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_end_bb)
            }
        } else {
            this.emit_terminator("br label %" + cond_label)
            this.verify_br(cond_label)
        }

        this.loop_end_label = saved_loop_end
        this.loop_break_label = saved_break
        this.loop_continue_label = saved_continue

        this.start_block(end_label)
    }

    // Every ancestor struct name of `struct_c`, transitively, through ALL of its
    // bases. Breadth-first with a visited set, so a diamond yields the shared
    // ancestor once and an `extends` cycle terminates instead of hanging codegen.
    // Does not include struct_c itself.
    fun all_ancestor_structs(struct_c: String): List<String> {
        var out: List<String> = []
        var visited: List<String> = [struct_c]
        var work: List<String> = []
        if (this.class_parents_of.has(struct_c)) {
            var seed: List<String> = this.class_parents_of.get(struct_c)
            var si: Float = 0
            while (si < seed.length()) {
                work.push(seed[si])
                si = si + 1
            }
        } else if (this.class_parent_of.has(struct_c)) {
            // Sites that only recorded the primary base still contribute it.
            work.push(this.class_parent_of.get(struct_c))
        }
        while (work.length() > 0) {
            var cur: String = work.pop()
            if (!this.str_in_list(visited, cur)) {
                visited.push(cur)
                out.push(cur)
                var ups: List<String> = []
                if (this.class_parents_of.has(cur)) {
                    ups = this.class_parents_of.get(cur)
                } else if (this.class_parent_of.has(cur)) {
                    ups = [this.class_parent_of.get(cur)]
                }
                var ui: Float = 0
                while (ui < ups.length()) {
                    if (!this.str_in_list(visited, ups[ui])) { work.push(ups[ui]) }
                    ui = ui + 1
                }
            }
        }
        return out
    }

    // Emit the two helpers that give the class hierarchy a runtime existence:
    // __class_parent_tag (the PRIMARY base of each class, one switch arm each)
    // and __class_is_a (does a tag name a target or a descendant of it).
    //
    // Emitted for *every* target and both modes, unlike emit_reflect_helpers
    // which is skipped in identity mode. gen_is_check calls __class_is_a
    // unconditionally, so skipping the definition here would leave an undefined
    // symbol whenever the compiler compiles itself.
    //
    // __class_is_a is a flattened tag -> ancestor-set table, not a chain walk.
    // The walk was O(depth) and easier to read in the IR, but it could only ever
    // follow ONE parent per tag — a switch arm returns a single value — so
    // `duck is Swimmable` was false for `class Duck extends Flyable, Swimmable,
    // Walkable`. Multiple bases are a DAG, not a chain, and no single-successor
    // walk can traverse one. The closure is computed here at compile time (see
    // all_ancestor_structs), so the emitted form is a nested switch and O(1).
    fun emit_class_hierarchy_helpers() {
        var child_names: List<String> = this.class_parent_of.keys()
        this.emit("")
        this.emit("define i64 @__class_parent_tag(i64 %tag) {")
        this.emit("entry:")
        this.block_terminated = false
        var arms: String = ""
        var arm_lbls: List<String> = []
        var arm_parents: List<String> = []
        var hi: Float = 0
        while (hi < child_names.length()) {
            var child: String = child_names[hi]
            var par: String = this.class_parent_of.get(child)
            // An interface or a base declared but never constructed has no type
            // id, so there is no tag to walk to; skip rather than emit an arm
            // pointing at 0, which __class_is_a reads as "chain ended".
            if (this.class_type_ids.has(child) and this.class_type_ids.has(par)) {
                var ctag: Float = this.class_type_ids.get(child)
                var ptag: Float = this.class_type_ids.get(par)
                var lbl: String = this.fresh_label("cpt.a")
                arm_lbls.push(lbl)
                arm_parents.push(ptag.floor().to_string())
                arms = arms + " i64 " + ctag.floor().to_string() + ", label %" + lbl
            }
            hi = hi + 1
        }
        if (arm_lbls.length() == 0) {
            this.emit_terminator("ret i64 0")
            this.emit("}")
            this.block_terminated = false
        } else {
            this.emit_indent("switch i64 %tag, label %cpt.none [" + arms + " ]")
            this.block_terminated = true
            var ai: Float = 0
            while (ai < arm_lbls.length()) {
                this.start_block(arm_lbls[ai])
                this.emit_terminator("ret i64 " + arm_parents[ai])
                ai = ai + 1
            }
            this.start_block("cpt.none")
            this.emit_terminator("ret i64 0")
            this.emit("}")
            this.block_terminated = false
        }

        // __class_is_a(tag, target): does `tag` name `target` or a descendant of
        // it? The zero tests come before the equality test so a target of 0 (a
        // non-class value, whose __gc_get_type_tag is 0) answers false rather
        // than matching the no-such-class sentinel.
        //
        // Outer switch on the receiver's tag, inner switch on the target against
        // that class's precomputed ancestor set. A chain walk cannot do this: it
        // has one successor per step and multiple bases are a DAG.
        var isa_children: List<String> = this.class_parents_of.keys()
        var isa_lbls: List<String> = []
        var isa_sets: List<List<String>> = []
        var isa_arms: String = ""
        var ci: Float = 0
        while (ci < isa_children.length()) {
            var ch: String = isa_children[ci]
            if (this.class_type_ids.has(ch)) {
                // Ancestors that actually have a tag. An interface never
                // constructed has no type id, so there is nothing to compare
                // against and it contributes no arm — but note gen_is_check
                // resolves the *target* through class_type_ids too, so an
                // untagged interface is unaskable rather than wrongly false.
                var tagged: List<String> = []
                var anc: List<String> = this.all_ancestor_structs(ch)
                var ai2: Float = 0
                while (ai2 < anc.length()) {
                    if (this.class_type_ids.has(anc[ai2])) {
                        var atag: Float = this.class_type_ids.get(anc[ai2])
                        tagged.push(atag.floor().to_string())
                    }
                    ai2 = ai2 + 1
                }
                if (tagged.length() > 0) {
                    var chtag: Float = this.class_type_ids.get(ch)
                    var clbl: String = "cia.c" + isa_lbls.length().floor().to_string()
                    isa_lbls.push(clbl)
                    isa_sets.push(tagged)
                    isa_arms = isa_arms + " i64 " + chtag.floor().to_string() + ", label %" + clbl
                }
            }
            ci = ci + 1
        }
        this.emit("")
        this.emit("define i1 @__class_is_a(i64 %tag, i64 %target) {")
        this.emit("entry:")
        this.emit("  %z = icmp eq i64 %tag, 0")
        this.emit("  br i1 %z, label %cia.no, label %cia.tchk")
        this.emit("cia.tchk:")
        this.emit("  %tz = icmp eq i64 %target, 0")
        this.emit("  br i1 %tz, label %cia.no, label %cia.self")
        this.emit("cia.self:")
        this.emit("  %hit = icmp eq i64 %tag, %target")
        if (isa_lbls.length() == 0) {
            this.emit("  br i1 %hit, label %cia.yes, label %cia.no")
        } else {
            this.emit("  br i1 %hit, label %cia.yes, label %cia.disp")
            this.emit("cia.disp:")
            this.emit("  switch i64 %tag, label %cia.no [" + isa_arms + " ]")
            var li: Float = 0
            while (li < isa_lbls.length()) {
                this.emit(isa_lbls[li] + ":")
                var set: List<String> = isa_sets[li]
                var tarms: String = ""
                var ti: Float = 0
                while (ti < set.length()) {
                    tarms = tarms + " i64 " + set[ti] + ", label %cia.yes"
                    ti = ti + 1
                }
                this.emit("  switch i64 %target, label %cia.no [" + tarms + " ]")
                li = li + 1
            }
        }
        this.emit("cia.yes:")
        this.emit("  ret i1 1")
        this.emit("cia.no:")
        this.emit("  ret i1 0")
        this.emit("}")
        this.block_terminated = false
    }

    fun emit_reflect_helpers() {
        var class_names: List<String> = this.class_type_ids.keys()
        if (class_names.length() == 0) { return }
        this.emit("")
        this.emit("define i64 @__reflect_class_name(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var tag_r: String = this.fresh_local()
        this.emit_indent(tag_r + " = call i64 @__gc_get_type_tag(i64 %val)")
        var end_lbl: String = this.fresh_label("rcn.end")
        var switch_str: String = ""
        var arm_labels: List<String> = []
        var ci: Float = 0
        while (ci < class_names.length()) {
            var lbl: String = this.fresh_label("rcn.c")
            arm_labels.push(lbl)
            var tid: Float = this.class_type_ids.get(class_names[ci])
            switch_str = switch_str + " i64 " + tid.floor().to_string() + ", label %" + lbl
            ci = ci + 1
        }
        this.emit_indent("switch i64 " + tag_r + ", label %" + end_lbl + " [" + switch_str + " ]")
        this.block_terminated = true
        ci = 0
        while (ci < class_names.length()) {
            this.start_block(arm_labels[ci])
            var cname: String = class_names[ci]
            var str_const: String = this.add_string_constant(cname)
            var str_len: Float = cname.length() + 1
            var gep: String = this.fresh_local()
            this.emit_indent(gep + " = getelementptr [" + str_len.to_string() + " x i8], [" + str_len.to_string() + " x i8]* " + str_const + ", i64 0, i64 0")
            var as_i64: String = this.ptr_to_val(gep)
            this.emit_terminator("ret i64 " + as_i64)
            ci = ci + 1
        }
        this.start_block(end_lbl)
        var unk_const: String = this.add_string_constant("Unknown")
        var unk_gep: String = this.fresh_local()
        this.emit_indent(unk_gep + " = getelementptr [8 x i8], [8 x i8]* " + unk_const + ", i64 0, i64 0")
        var unk_i64: String = this.ptr_to_val(unk_gep)
        this.emit_terminator("ret i64 " + unk_i64)
        this.emit("}")
        this.block_terminated = false

        this.emit("")
        this.emit("define i64 @__reflect_is_class(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var is_tag: String = this.fresh_local()
        this.emit_indent(is_tag + " = call i64 @__gc_get_type_tag(i64 %val)")
        var cmp: String = this.fresh_local()
        this.emit_indent(cmp + " = icmp uge i64 " + is_tag + ", 10")
        var result: String = this.fresh_local()
        this.emit_indent(result + " = zext i1 " + cmp + " to i64")
        this.emit_terminator("ret i64 " + result)
        this.emit("}")
        this.block_terminated = false

        this.emit("")
        this.emit("define i64 @__reflect_number_to_string(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var untagged: String = this.fresh_local()
        this.emit_indent(untagged + " = call i64 @__val_untag_int(i64 %val)")
        var ns_result: String = this.fresh_local()
        this.emit_indent(ns_result + " = call i64 @__int_to_string(i64 " + untagged + ")")
        var ns_ptr: String = this.fresh_local()
        this.emit_indent(ns_ptr + " = inttoptr i64 " + ns_result + " to i8*")
        var ns_tagged: String = this.fresh_local()
        this.emit_indent(ns_tagged + " = call i64 @__val_tag_ptr(i8* " + ns_ptr + ")")
        this.emit_terminator("ret i64 " + ns_tagged)
        this.emit("}")
        this.block_terminated = false

        // __reflect_get_fields: returns a Map of field_name -> field_value for an instance
        this.emit("")
        this.emit("define i64 @__reflect_get_fields(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var gf_tag: String = this.fresh_local()
        this.emit_indent(gf_tag + " = call i64 @__gc_get_type_tag(i64 %val)")
        var gf_end: String = this.fresh_label("rgf.end")
        var gf_switch: String = ""
        var gf_arms: List<String> = []
        ci = 0
        while (ci < class_names.length()) {
            var gf_lbl: String = this.fresh_label("rgf.c")
            gf_arms.push(gf_lbl)
            var gf_tid: Float = this.class_type_ids.get(class_names[ci])
            gf_switch = gf_switch + " i64 " + gf_tid.floor().to_string() + ", label %" + gf_lbl
            ci = ci + 1
        }
        this.emit_indent("switch i64 " + gf_tag + ", label %" + gf_end + " [" + gf_switch + " ]")
        this.block_terminated = true
        ci = 0
        while (ci < class_names.length()) {
            this.start_block(gf_arms[ci])
            var cname2: String = class_names[ci]
            var fld_entries: List<String> = []
            if (this.class_field_list.has(cname2)) { fld_entries = this.class_field_list.get(cname2) }
            var map_val: String = this.fresh_local()
            this.emit_indent(map_val + " = call i64 @__map_new()")
            var fi: Float = 0
            while (fi < fld_entries.length()) {
                var fp: List<String> = fld_entries[fi].split(":")
                var fname: String = fp[0]
                var fname_const: String = this.add_string_constant(fname)
                var fname_len: Float = fname.length() + 1
                var fname_gep: String = this.fresh_local()
                this.emit_indent(fname_gep + " = getelementptr [" + fname_len.to_string() + " x i8], [" + fname_len.to_string() + " x i8]* " + fname_const + ", i64 0, i64 0")
                var fname_i64: String = this.emit_tag_ptr(fname_gep)
                var inst_ptr: String = this.fresh_local()
                this.emit_indent(inst_ptr + " = inttoptr i64 %val to %" + cname2 + "*")
                var field_ptr: String = this.fresh_local()
                this.emit_indent(field_ptr + " = getelementptr %" + cname2 + ", %" + cname2 + "* " + inst_ptr + ", i32 0, i32 " + fi.floor().to_string())
                var field_val: String = this.fresh_local()
                this.emit_indent(field_val + " = load i64, i64* " + field_ptr)
                this.emit_indent("call i64 @__map_set(i64 " + map_val + ", i64 " + fname_i64 + ", i64 " + field_val + ")")
                fi = fi + 1
            }
            this.emit_terminator("ret i64 " + map_val)
            ci = ci + 1
        }
        this.start_block(gf_end)
        var empty_map: String = this.fresh_local()
        this.emit_indent(empty_map + " = call i64 @__map_new()")
        this.emit_terminator("ret i64 " + empty_map)
        this.emit("}")
        this.block_terminated = false

        // __reflect_construct_from_map: given a class constructor ptr and a map, construct instance
        this.emit("")
        this.emit("define i64 @__reflect_construct_from_map(i64 %klass, i64 %map) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var rc_end: String = this.fresh_label("rcon.end")
        ci = 0
        while (ci < class_names.length()) {
            var cname3: String = class_names[ci]
            var fn_ptr_val: String = this.fresh_local()
            this.emit_indent(fn_ptr_val + " = ptrtoint i64 (...)* bitcast (i64 ()* @" + cname3 + " to i64 (...)*) to i64")
            var cmp_r: String = this.fresh_local()
            this.emit_indent(cmp_r + " = icmp eq i64 %klass, " + fn_ptr_val)
            var rc_arm: String = this.fresh_label("rcon.hit")
            var rc_next: String = this.fresh_label("rcon.next")
            if (ci < class_names.length() - 1) {
                this.emit_terminator("br i1 " + cmp_r + ", label %" + rc_arm + ", label %" + rc_next)
            } else {
                this.emit_terminator("br i1 " + cmp_r + ", label %" + rc_arm + ", label %" + rc_end)
            }
            this.start_block(rc_arm)
            var new_inst: String = this.fresh_local()
            this.emit_indent(new_inst + " = call i64 @" + cname3 + "()")
            var c_entries: List<String> = []
            if (this.class_field_list.has(cname3)) { c_entries = this.class_field_list.get(cname3) }
            if (c_entries.length() > 0) {
                var c_ptr: String = this.fresh_local()
                this.emit_indent(c_ptr + " = inttoptr i64 " + new_inst + " to %" + cname3 + "*")
                var cfi: Float = 0
                while (cfi < c_entries.length()) {
                    var cfp: List<String> = c_entries[cfi].split(":")
                    var cf_name: String = cfp[0]
                    var cf_key_const: String = this.add_string_constant(cf_name)
                    var cf_key_len: Float = cf_name.length() + 1
                    var cf_key_gep: String = this.fresh_local()
                    this.emit_indent(cf_key_gep + " = getelementptr [" + cf_key_len.to_string() + " x i8], [" + cf_key_len.to_string() + " x i8]* " + cf_key_const + ", i64 0, i64 0")
                    var cf_key_i64: String = this.ptr_to_val(cf_key_gep)
                    var cf_val: String = this.fresh_local()
                    this.emit_indent(cf_val + " = call i64 @__map_get(i64 %map, i64 " + cf_key_i64 + ")")
                    var cf_fld_ptr: String = this.fresh_local()
                    this.emit_indent(cf_fld_ptr + " = getelementptr %" + cname3 + ", %" + cname3 + "* " + c_ptr + ", i32 0, i32 " + cfi.floor().to_string())
                    this.emit_indent("store i64 " + cf_val + ", i64* " + cf_fld_ptr)
                    cfi = cfi + 1
                }
            }
            this.emit_terminator("ret i64 " + new_inst)
            if (ci < class_names.length() - 1) {
                this.start_block(rc_next)
            }
            ci = ci + 1
        }
        this.start_block(rc_end)
        this.emit_terminator("ret i64 0")
        this.emit("}")
        this.block_terminated = false
    }

    // @codegen-split: utils
    fun runtime_declares(): String {
        var rt: StringBuilder = StringBuilder()
        rt.append("; --- Runtime declarations ---\n")
        rt.append("%SB = type { i64, i64, i8* }\n\n")
        var names: List<String> = ["__list_new", "__list_push", "__list_get", "__list_set", "__list_length", "__list_pop", "__list_remove", "__list_slice", "StringBuilder", "__sb_append", "__sb_to_string", "__safe_strcmp", "__map_new", "__map_set", "__map_get", "__map_has", "__map_keys", "__str_ends_with", "__str_split", "__str_replace", "__int_to_string", "__list_join", "__join_append", "__list_contains", "__io_read_file", "__io_write_file", "__io_file_exists", "__io_mkdir", "__io_walk_dir", "__io_append_file", "__io_file_size", "__io_read_binary", "__io_is_dir", "__io_rename", "__io_delete_file", "__os_set_env", "__os_home", "__io_read_stdin", "__io_readline", "__os_exec", "__os_args", "__os_cwd", "__os_path_sep", "__os_platform", "__os_env", "__os_system", "__str_get", "__io_println", "__io_print", "__any_iter_get"]
        var sigs: List<String> = ["i64 @__list_new()", "i64 @__list_push(i64, i64)", "i64 @__list_get(i64, i64)", "i64 @__list_set(i64, i64, i64)", "i64 @__list_length(i64)", "i64 @__list_pop(i64)", "i64 @__list_remove(i64, i64)", "i64 @__list_slice(i64, i64, i64)", "i64 @StringBuilder()", "i64 @__sb_append(i64, i64)", "i64 @__sb_to_string(i64)", "i64 @__safe_strcmp(i64, i64)", "i64 @__map_new()", "i64 @__map_set(i64, i64, i64)", "i64 @__map_get(i64, i64)", "i64 @__map_has(i64, i64)", "i64 @__map_keys(i64)", "i64 @__str_ends_with(i64, i64)", "i64 @__str_split(i64, i64)", "i64 @__str_replace(i64, i64, i64)", "i64 @__int_to_string(i64)", "i64 @__list_join(i64, i64)", "i64 @__join_append(i64, i64, i64, i64, i64)", "i64 @__list_contains(i64, i64)", "i64 @__io_read_file(i64)", "i64 @__io_write_file(i64, i64)", "i64 @__io_file_exists(i64)", "i64 @__io_mkdir(i64)", "i64 @__io_walk_dir(i64)", "i64 @__io_append_file(i64, i64)", "i64 @__io_file_size(i64)", "i64 @__io_read_binary(i64, i64, i64)", "i64 @__io_is_dir(i64)", "i64 @__io_rename(i64, i64)", "i64 @__io_delete_file(i64)", "i64 @__os_set_env(i64, i64)", "i64 @__os_home()", "i64 @__io_read_stdin(i64)", "i64 @__io_readline()", "i64 @__os_exec(i64)", "i64 @__os_args()", "i64 @__os_cwd()", "i64 @__os_path_sep()", "i64 @__os_platform()", "i64 @__os_env(i64)", "i64 @__os_system(i64)", "i64 @__str_get(i64, i64)", "i64 @__io_println(i64)", "i64 @__io_print(i64)", "i64 @__any_iter_get(i64, i64)"]
        var di: Float = 0
        while (di < names.length()) {
            if (!this.str_in_list(this.defined_funcs,names[di])) {
                rt.append("declare " + sigs[di] + "\n")
            }
            di = di + 1
        }
        // Debug location tracking
        rt.append("@__debug_location = external global i8*\n")
        // NaN-boxing value constructors
        rt.append("declare i64 @__val_nil()\n")
        // Runtime type-check functions (NaN-boxing tag inspection, return i1)
        rt.append("declare i1 @__val_is_int(i64)\n")
        rt.append("declare i1 @__val_is_float(i64)\n")
        rt.append("declare i1 @__val_is_string(i64)\n")
        rt.append("declare i1 @__val_is_bool(i64)\n")
        rt.append("declare i1 @__val_is_nil(i64)\n")
        rt.append("declare i1 @__val_is_list(i64)\n")
        rt.append("declare i1 @__val_is_map(i64)\n")
        // Per-class GC tag of a value, 0 if it has none. __class_is_a is *defined*
        // in the emitted module (it switches over this program's classes), so it
        // needs no declare; this one lives in the runtime base.
        rt.append("declare i64 @__val_class_tag(i64)\n")
        // GC runtime declarations
        rt.append("\n; --- GC runtime ---\n")
        rt.append("declare void @__gc_enable()\n")
        rt.append("declare void @__gc_disable()\n")
        rt.append("declare void @__gc_collect()\n")
        rt.append("declare void @__gc_set_threshold(i64)\n")
        rt.append("declare i64 @__gc_stat_alloc_count()\n")
        rt.append("declare i64 @__gc_stat_total_bytes()\n")
        rt.append("declare i64 @__gc_stat_collections()\n")
        rt.append("declare i64 @__gc_stat_freed_bytes()\n")
        rt.append("declare i64 @__gc_stat_threshold()\n")
        rt.append("declare void @__gc_debug_stats()\n")
        rt.append("declare i64 @__gc_alloc(i64, i64)\n")
        rt.append("declare i64 @__gc_alloc_zeroed(i64, i64)\n")
        rt.append("declare i64 @__gc_realloc(i64, i64, i64)\n")
        rt.append("declare void @__gc_push_root(i64)\n")
        rt.append("declare void @__gc_pop_roots(i64)\n")
        rt.append("declare i64 @__gc_shadow_stack_depth()\n")
        rt.append("declare i64 @__gc_list_new()\n")
        rt.append("declare void @__gc_list_push(i64, i64)\n")
        rt.append("declare i64 @__gc_map_new()\n")
        rt.append("declare i64 @__gc_stringbuilder_new()\n")
        rt.append("declare i64 @__gc_string_alloc(i64)\n")
        rt.append("declare i64 @__gc_closure_new(i64, i64)\n")
        rt.append("declare i64 @__gc_env_alloc(i64)\n")
        rt.append("declare i64 @__gc_instance_alloc(i64)\n")
        rt.append("declare i64 @__gc_get_type_tag(i64)\n")
        // Memory-cap-aware malloc. Codegen emits @__sf_malloc rather than
        // @malloc so --max-memory / SAFFRON_MAX_MEMORY also covers the
        // allocations codegen makes directly (string concat, closure envs,
        // enum payloads, coroutine frames).
        rt.append("declare i8* @__sf_malloc(i64)\n")
        // Scheduler extern functions (always needed when @async or @scheduler imported)
        rt.append("\n; --- Scheduler runtime ---\n")
        rt.append("declare double @sf_time_now()\n")
        rt.append("declare i64 @sf_tcp_poll(i64, i64, i64)\n")
        rt.append("declare void @__sched_coro_resume(i64)\n")
        rt.append("declare i64 @__sched_coro_done(i64)\n")
        rt.append("declare void @__sched_coro_destroy(i64)\n")
        rt.append("declare i64 @__sched_get_yield_reason()\n")
        rt.append("declare i64 @__sched_get_yield_arg()\n")
        rt.append("declare i64 @__sched_get_task_result()\n")
        rt.append("declare void @__sched_reset_yield()\n")
        rt.append("declare void @__sched_store_result(i64, i64)\n")
        rt.append("declare i64 @__sched_get_stored_result(i64)\n")
        rt.append("declare i64 @__sched_has_stored_result(i64)\n")
        // Mark scheduler functions as known to prevent duplicate declares
        this.known_functions.push("sf_time_now")
        this.known_functions.push("sf_tcp_poll")
        this.known_functions.push("__sched_coro_resume")
        this.known_functions.push("__sched_coro_done")
        this.known_functions.push("__sched_coro_destroy")
        this.known_functions.push("__sched_get_yield_reason")
        this.known_functions.push("__sched_get_yield_arg")
        this.known_functions.push("__sched_get_task_result")
        this.known_functions.push("__sched_reset_yield")
        this.known_functions.push("__sched_store_result")
        this.known_functions.push("__sched_get_stored_result")
        this.known_functions.push("__sched_has_stored_result")
        // Coroutine intrinsics
        if (this.coroutine_funcs.length() > 0) {
            rt.append("\n; --- Coroutine intrinsics ---\n")
            rt.append("declare token @llvm.coro.id(i32, ptr, ptr, ptr)\n")
            rt.append("declare i64 @llvm.coro.size.i64()\n")
            rt.append("declare ptr @llvm.coro.begin(token, ptr)\n")
            rt.append("declare token @llvm.coro.save(ptr)\n")
            rt.append("declare i8 @llvm.coro.suspend(token, i1)\n")
            rt.append("declare ptr @llvm.coro.free(token, ptr)\n")
            rt.append("declare i1 @llvm.coro.end(ptr, i1)\n")
            rt.append("declare void @llvm.coro.resume(ptr)\n")
            rt.append("declare i1 @llvm.coro.done(ptr)\n")
            rt.append("declare void @llvm.coro.destroy(ptr)\n")
            rt.append("\n@__yield_reason = external global i64\n")
            rt.append("@__yield_arg = external global i64\n")
            rt.append("@__task_result = external global i64\n")
            rt.append("@__coro_escape_sink = external global ptr\n")
        }
        return rt.to_string()
    }

    // Determine if a type requires GC root tracking.
    // Heap types: String, List, Map, StringBuilder, Any, class instances, closures.
    // Value types: Int, Float, Bool, Nil, Number — no tracking needed.
    fun is_gc_root_type(type_str: String): Bool {
        if (type_str == "Int" or type_str == "Float" or type_str == "Bool" or type_str == "Nil" or type_str == "Number" or type_str == "void") {
            return false
        }
        if (type_str.length() == 0) {
            return false
        }
        // Everything else (String, List, Map, Any, class types, etc.) is heap-allocated
        return true
    }

    fun find_enum_for_variant(variant: String): String {
        var keys: List<String> = this.enum_variant_tags.keys()
        var i: Float = 0
        while (i < keys.length()) {
            var key: String = keys[i]
            if (key.ends_with("." + variant)) {
                return key.split(".")[0]
            }
            i = i + 1
        }
        return "Unknown"
    }

    fun emit_debug_location(context: String) {
        var loc: String = this.current_function_name + ": " + context
        var const_name: String = this.add_string_constant(loc)
        var slen: Float = loc.length() + 1
        var gep: String = this.fresh_local()
        this.emit_indent(gep + " = getelementptr [" + slen.to_string() + " x i8], [" + slen.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
        this.emit_indent("store i8* " + gep + ", i8** @__debug_location")
    }

    fun resolve_callee(expr: AST.Expr): String {
        return match (expr) {
            Variable(n) => n
            Ref(rk, rn, rs) => rn
            MemberAccess(obj, field) => this.resolve_callee(obj) + "." + field
            x => ""
        }
    }

    fun gen_logical(left: AST.Expr, op: String, right: AST.Expr): String {
        var lhs_raw: String = this.gen_arg_value(left)
        var lhs: String = this.to_i1(lhs_raw)
        var current_block: String = this.fresh_label("logic.entry")
        var rhs_label: String = this.fresh_label("rhs")
        var end_label: String = this.fresh_label("end")

        // We need a label for the current block for phi
        this.emit_terminator("br label %" + current_block)
        this.start_block(current_block)

        if (op == "or") {
            this.emit_terminator("br i1 " + lhs + ", label %" + end_label + ", label %" + rhs_label)
        } else {
            this.emit_terminator("br i1 " + lhs + ", label %" + rhs_label + ", label %" + end_label)
        }

        this.start_block(rhs_label)
        var rhs_raw: String = this.gen_arg_value(right)
        var rhs: String = this.to_i1(rhs_raw)
        // The phi predecessor must be the block control actually leaves from, not
        // rhs_label. When `right` is itself a logical op (or anything else that
        // opens new blocks — a match, a nested short-circuit), gen_arg_value above
        // has already left rhs_label behind, so naming rhs_label in the phi
        // produced "PHI node entries do not match predecessors". Funnel every
        // path through one join block whose identity is known here; -O2 folds it
        // away.
        var rhs_reaches_end: Bool = !this.block_terminated
        var rhs_exit: String = this.fresh_label("rhs.exit")
        if (rhs_reaches_end) {
            this.emit_terminator("br label %" + rhs_exit)
            this.start_block(rhs_exit)
            this.emit_terminator("br label %" + end_label)
        }

        this.start_block(end_label)
        var phi_result: String = this.fresh_local()
        if (rhs_reaches_end) {
            this.emit_indent(phi_result + " = phi i1 [" + lhs + ", %" + current_block + "], [" + rhs + ", %" + rhs_exit + "]")
        } else {
            // The RHS ended in its own terminator (e.g. a throw), so end_label has
            // exactly one predecessor. A single-entry phi is still valid IR.
            this.emit_indent(phi_result + " = phi i1 [" + lhs + ", %" + current_block + "]")
        }
        // Extend back to i64 for uniform value type
        var raw: String = this.fresh_local()
        this.emit_indent(raw + " = zext i1 " + phi_result + " to i64")
        // Tag as bool so the value is a proper NaN-boxed bool when stored
        var result: String = this.emit_tag_bool(raw)
        this.last_type = AST.Type.BoolType
        return result
    }

    // --- Variable collection (for hoisting allocas to entry block) ---

    fun collect_vars(stmts: List<AST.Stmt>, names: List<String>, types: List<String>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.collect_vars_stmt(stmts[i], names, types)
            i = i + 1
        }
    }

    fun add_var_unique(names: List<String>, types: List<String>, name: String, typ: String) {
        var exists: Bool = false
        var avi: Float = 0
        while (avi < names.length()) {
            if (names[avi] == name) { exists = true }
            avi = avi + 1
        }
        if (!exists) {
            names.push(name)
            types.push(typ)
        }
    }

    fun collect_vars_stmt(stmt: AST.Stmt, names: List<String>, types: List<String>) {
        var sk: String = this.classify_stmt(stmt)
        if (sk == "let_pattern") {
            var lp_pat: AST.Pattern = match (stmt) { LetPattern(p, v) => p   _ => AST.Pattern.VariantPattern("", []) }
            var lp_val: AST.Expr = match (stmt) { LetPattern(p, v) => v   _ => AST.Expr.NilLit }
            var lp_vname: String = match (lp_pat) { VariantPattern(v, b) => v   ArrayPattern(e, r) => "__array:" + r   _ => "" }
            var lp_bindings: List<String> = match (lp_pat) { VariantPattern(v, b) => b   ArrayPattern(e, r) => e   _ => [] }
            var lpi: Float = 0
            while (lpi < lp_bindings.length()) {
                this.add_var_unique(names, types, lp_bindings[lpi], "Any")
                lpi = lpi + 1
            }
            if (lp_vname.starts_with("__array:")) {
                var lp_rest: String = lp_vname.slice(8, lp_vname.length())
                if (lp_rest.length() > 0) {
                    this.add_var_unique(names, types, lp_rest, "Any")
                }
            }
            this.collect_vars_expr(lp_val, names, types)
            return
        }
        match (stmt) {
            VarDecl(name, type_ann, init, doc, v_vis) => {
                this.add_var_unique(names, types, name, type_ann)
                this.collect_vars_expr(init, names, types)
            }
            If(cond, then_branch, else_branch) => {
                this.collect_vars(then_branch, names, types)
                this.collect_vars(else_branch, names, types)
            }
            While(cond, body) => {
                this.collect_vars(body, names, types)
            }
            Block(stmts) => {
                this.collect_vars(stmts, names, types)
            }
            ExprStmt(expr) => {
                this.collect_vars_expr(expr, names, types)
            }
            Return(value) => {
                this.collect_vars_expr(value, names, types)
            }
            FunDecl(n, p, r, b, d, f_vis) => {}
            EnumDecl(n, v, d, e_vis) => {}
            ClassDecl(n, __tps, ps, f, m, d, c_vis) => {}
            Break => {}
            Continue => {}
            TryCatch(try_body, catch_name, catch_body, finally_body) => {
                this.collect_vars(try_body, names, types)
                this.add_var_unique(names, types, catch_name, "String")
                this.collect_vars(catch_body, names, types)
                this.collect_vars(finally_body, names, types)
            }
            Throw(value) => {
                this.collect_vars_expr(value, names, types)
            }
            LetPattern(pattern, value) => {
            }
            TypeAlias(ta_n, ta_t, ta_vis) => {}
        }
    }

    fun collect_vars_expr(expr: AST.Expr, names: List<String>, types: List<String>) {
        var ek: String = this.classify_expr(expr)
        if (ek == "if_expr") {
            var ie_cond: AST.Expr = match (expr) { IfExpr(c, tb, tv, eb, ev) => c   _ => AST.Expr.NilLit }
            var ie_tb: List<AST.Stmt> = match (expr) { IfExpr(c, tb, tv, eb, ev) => tb   _ => [] }
            var ie_tv: AST.Expr = match (expr) { IfExpr(c, tb, tv, eb, ev) => tv   _ => AST.Expr.NilLit }
            var ie_eb: List<AST.Stmt> = match (expr) { IfExpr(c, tb, tv, eb, ev) => eb   _ => [] }
            var ie_ev: AST.Expr = match (expr) { IfExpr(c, tb, tv, eb, ev) => ev   _ => AST.Expr.NilLit }
            this.collect_vars_expr(ie_cond, names, types)
            this.collect_vars(ie_tb, names, types)
            this.collect_vars_expr(ie_tv, names, types)
            this.collect_vars(ie_eb, names, types)
            this.collect_vars_expr(ie_ev, names, types)
            return
        }
        if (ek == "try_expr") {
            var te_tb: List<AST.Stmt> = match (expr) { TryExpr(tb, tv, cn, cb, cv) => tb   _ => [] }
            var te_tv: AST.Expr = match (expr) { TryExpr(tb, tv, cn, cb, cv) => tv   _ => AST.Expr.NilLit }
            var te_cn: String = match (expr) { TryExpr(tb, tv, cn, cb, cv) => cn   _ => "" }
            var te_cb: List<AST.Stmt> = match (expr) { TryExpr(tb, tv, cn, cb, cv) => cb   _ => [] }
            var te_cv: AST.Expr = match (expr) { TryExpr(tb, tv, cn, cb, cv) => cv   _ => AST.Expr.NilLit }
            this.collect_vars(te_tb, names, types)
            this.collect_vars_expr(te_tv, names, types)
            if (te_cn.length() > 0) {
                this.add_var_unique(names, types, te_cn, "String")
            }
            this.collect_vars(te_cb, names, types)
            this.collect_vars_expr(te_cv, names, types)
            return
        }
        match (expr) {
            Match(s, a) => { this.collect_vars_match(expr, names, types) }
            BlockExpr(stmts, value) => {
                this.collect_vars(stmts, names, types)
                this.collect_vars_expr(value, names, types)
            }
            Binary(left, op, right) => {
                this.collect_vars_expr(left, names, types)
                this.collect_vars_expr(right, names, types)
            }
            Logical(left, op, right) => {
                this.collect_vars_expr(left, names, types)
                this.collect_vars_expr(right, names, types)
            }
            Unary(op, right) => { this.collect_vars_expr(right, names, types) }
            Assign(name, value) => { this.collect_vars_expr(value, names, types) }
            Call(callee, args) => {
                this.collect_vars_expr(callee, names, types)
                var ci: Float = 0
                while (ci < args.length()) {
                    this.collect_vars_expr(args[ci], names, types)
                    ci = ci + 1
                }
            }
            MethodCall(obj, method, args) => {
                this.collect_vars_expr(obj, names, types)
                var mi: Float = 0
                while (mi < args.length()) {
                    this.collect_vars_expr(args[mi], names, types)
                    mi = mi + 1
                }
            }
            SetField(obj, field, value) => {
                this.collect_vars_expr(obj, names, types)
                this.collect_vars_expr(value, names, types)
            }
            GetField(obj, field) => { this.collect_vars_expr(obj, names, types) }
            IndexGet(obj, idx) => {
                this.collect_vars_expr(obj, names, types)
                this.collect_vars_expr(idx, names, types)
            }
            IndexSet(obj, idx, value) => {
                this.collect_vars_expr(obj, names, types)
                this.collect_vars_expr(idx, names, types)
                this.collect_vars_expr(value, names, types)
            }
            MemberAccess(obj, field) => { this.collect_vars_expr(obj, names, types) }
            IntLit(v) => {}
            FloatLit(v) => {}
            BoolLit(v) => {}
            StringLit(s) => {}
            NilLit => {}
            Variable(n) => {}
            Ref(rk, rn, rs) => {}
            This => {}
            MapLit => {}
            // A container literal's ELEMENTS can declare variables, because the
            // parser desugars a map literal into a BlockExpr with a `__map_N`
            // VarDecl. Not descending here meant `[{"a": 1}]` emitted a store to
            // %__map_1 with no alloca — invalid IR, "use of undefined value".
            // Same hazard for a tuple and for enum-construction arguments.
            ListLit(e) => {
                var lli: Float = 0
                while (lli < e.length()) {
                    this.collect_vars_expr(e[lli], names, types)
                    lli = lli + 1
                }
            }
            EnumConstruct(e, v, a) => {
                var eci: Float = 0
                while (eci < a.length()) {
                    this.collect_vars_expr(a[eci], names, types)
                    eci = eci + 1
                }
            }
            // Lambda is deliberately NOT visited: gen_function hoists allocas per
            // function, so a nested body's locals belong to that body, not this one.
            Lambda(p, r, b) => {}
            IsCheck(val, t) => { this.collect_vars_expr(val, names, types) }
            IfExpr(c, tb, tv, eb, ev) => {}
            TryExpr(tb, tv, cn, cb, cv) => {}
            Yield(v) => { this.collect_vars_expr(v, names, types) }
            TupleLit(e) => {
                var tli: Float = 0
                while (tli < e.length()) {
                    this.collect_vars_expr(e[tli], names, types)
                    tli = tli + 1
                }
            }
        }
    }

    fun is_wildcard_in_enum(pattern: AST.Pattern, enum_name: String): Bool {
        // A NamedWildcard is unconditionally a catch-all. It already answered
        // true by accident — its name came out "" here, which is never a
        // registered tag — but saying so directly is what the code means.
        var is_named_wc: Bool = match (pattern) { NamedWildcard(n) => true   _ => false }
        if (is_named_wc) return true
        var name: String = match (pattern) { VariantPattern(v, b) => v
            _ => ""
        }
        return !this.enum_variant_tags.has(enum_name + "." + name)
    }

    fun get_arm_pattern(arm: AST.MatchArm): AST.Pattern {
        // Arm is MatchArm's only variant, so the default is unreachable — but it
        // returned a String from a function declared to return AST.Pattern, which
        // nothing rejected until the checker began walking method bodies.
        return match (arm) { Arm(p, b) => p
            _ => AST.Pattern.WildcardPattern
        }
    }

    fun get_arm_body(arm: AST.MatchArm): AST.Expr {
        return match (arm) { Arm(p, b) => b
            _ => AST.Expr.NilLit
        }
    }

    fun get_pattern_bindings(pattern: AST.Pattern): List<String> {
        return match (pattern) { VariantPattern(v, b) => b
            // A NamedWildcard binds one name, and it is the pattern's binding —
            // omitting it here is why `x => ...` had no `x` in scope.
            NamedWildcard(n) => [n]
            _ => []
        }
    }

    fun collect_vars_match(expr: AST.Expr, names: List<String>, types: List<String>) {
        var arms: List<AST.MatchArm> = this.get_match_arms(expr)
        var i: Float = 0
        while (i < arms.length()) {
            var arm: AST.MatchArm = arms[i]
            var bindings: List<String> = this.get_pattern_bindings(this.get_arm_pattern(arm))
            var j: Float = 0
            while (j < bindings.length()) {
                this.add_var_unique(names, types, bindings[j], "Int")
                j = j + 1
            }
            this.collect_vars_expr(this.get_arm_body(arm), names, types)
            i = i + 1
        }
    }

    fun is_match_expr(expr: AST.Expr): Bool {
        var kind: Any = match (expr) {
            Match(s, a) => "match"
            IntLit(v) => "other"
            FloatLit(v) => "other"
            BoolLit(v) => "other"
            StringLit(s) => "other"
            NilLit => "other"
            Variable(n) => "other"
            Ref(rk, rn, rs) => "other"
            Binary(l, o, r) => "other"
            Unary(o, r) => "other"
            Call(c, a) => "other"
            Assign(n, v) => "other"
            Logical(l, o, r) => "other"
            MemberAccess(o, f) => "other"
            EnumConstruct(e, v, a) => "other"
            Lambda(p, r, b) => "other"
            GetField(o, f) => "other"
            SetField(o, f, v) => "other"
            This => "other"
            ListLit(e) => "other"
            IndexGet(o, i) => "other"
            IndexSet(o, i, v) => "other"
            MethodCall(o, m, a) => "other"
            MapLit => "other"
            BlockExpr(s, v) => "other"
            IsCheck(val, t) => "other"
            IfExpr(c, tb, tv, eb, ev) => "other"
            TryExpr(tb, tv, cn, cb, cv) => "other"
            Yield(v) => "other"
            TupleLit(e) => "other"
        }
        return kind == "match"
    }

    fun get_match_arms(expr: AST.Expr): List<AST.MatchArm> {
        return match (expr) { Match(s, a) => a
            _ => ""
        }
    }

    // --- Coroutine detection ---

    fun expr_has_yield(expr: AST.Expr): Bool {
        return match (expr) {
            Yield(v) => true
            Binary(l, o, r) => this.expr_has_yield(l) or this.expr_has_yield(r)
            Unary(o, r) => this.expr_has_yield(r)
            Call(c, a) => this.call_is_suspend(c) or this.exprs_have_yield(a)
            Assign(n, v) => this.expr_has_yield(v)
            Logical(l, o, r) => this.expr_has_yield(l) or this.expr_has_yield(r)
            MethodCall(o, m, a) => m == "await" or this.expr_has_yield(o) or this.exprs_have_yield(a)
            ListLit(e) => this.exprs_have_yield(e)
            IndexGet(o, i) => this.expr_has_yield(o) or this.expr_has_yield(i)
            IndexSet(o, i, v) => this.expr_has_yield(o) or this.expr_has_yield(i) or this.expr_has_yield(v)
            SetField(o, f, v) => this.expr_has_yield(o) or this.expr_has_yield(v)
            GetField(o, f) => this.expr_has_yield(o)
            MemberAccess(o, f) => this.expr_has_yield(o)
            EnumConstruct(e, v, a) => this.exprs_have_yield(a)
            Match(s, a) => this.expr_has_yield(s)
            BlockExpr(s, v) => this.stmts_have_yield(s) or this.expr_has_yield(v)
            IfExpr(c, tb, tv, eb, ev) => this.expr_has_yield(c) or this.stmts_have_yield(tb) or this.expr_has_yield(tv) or this.stmts_have_yield(eb) or this.expr_has_yield(ev)
            IsCheck(v, t) => this.expr_has_yield(v)
            TryExpr(tb, tv, cn, cb, cv) => this.stmts_have_yield(tb) or this.expr_has_yield(tv) or this.stmts_have_yield(cb) or this.expr_has_yield(cv)
            TupleLit(e) => this.exprs_have_yield(e)
            _ => false
        }
    }

    fun call_is_suspend(callee: AST.Expr): Bool {
        var name: String = this.get_variable_name(callee)
        return name == "__suspend" or name.ends_with("__suspend")
    }

    fun exprs_have_yield(exprs: List<AST.Expr>): Bool {
        var i: Float = 0
        while (i < exprs.length()) {
            if (this.expr_has_yield(exprs[i])) { return true }
            i = i + 1
        }
        return false
    }

    fun stmts_have_yield(stmts: List<AST.Stmt>): Bool {
        var i: Float = 0
        while (i < stmts.length()) {
            if (this.stmt_has_yield(stmts[i])) { return true }
            i = i + 1
        }
        return false
    }

    fun stmt_has_yield(stmt: AST.Stmt): Bool {
        return match (stmt) {
            ExprStmt(e) => this.expr_has_yield(e)
            VarDecl(n, t, init, d, v_vis) => this.expr_has_yield(init)
            Return(v) => this.expr_has_yield(v)
            If(c, tb, eb) => this.expr_has_yield(c) or this.stmts_have_yield(tb) or this.stmts_have_yield(eb)
            While(c, b) => this.expr_has_yield(c) or this.stmts_have_yield(b)
            Block(s) => this.stmts_have_yield(s)
            TryCatch(t, n, c, f) => this.stmts_have_yield(t) or this.stmts_have_yield(c) or this.stmts_have_yield(f)
            Throw(v) => this.expr_has_yield(v)
            FunDecl(n, p, r, b, d, f_vis) => false
            _ => false
        }
    }

    fun collect_calls_from_expr(expr: AST.Expr, calls: List<String>) {
        match (expr) {
            Call(callee, args) => {
                var name: String = this.get_variable_name(callee)
                if (name.length() > 0) { calls.push(name) }
                this.collect_calls_from_exprs(args, calls)
            }
            MethodCall(o, m, a) => {
                // Extract module-qualified call: Async.sleep → stdlib_async_sleep
                var obj_name: String = this.get_variable_name(o)
                if (obj_name.length() > 0 and this.module_prefixes.has(obj_name)) {
                    var prefix: String = this.module_prefixes.get(obj_name)
                    calls.push(prefix + m)
                }
                calls.push(m)
                this.collect_calls_from_expr(o, calls)
                this.collect_calls_from_exprs(a, calls)
            }
            Binary(l, o, r) => {
                this.collect_calls_from_expr(l, calls)
                this.collect_calls_from_expr(r, calls)
            }
            Assign(n, v) => { this.collect_calls_from_expr(v, calls) }
            Logical(l, o, r) => {
                this.collect_calls_from_expr(l, calls)
                this.collect_calls_from_expr(r, calls)
            }
            Unary(o, r) => { this.collect_calls_from_expr(r, calls) }
            ListLit(e) => { this.collect_calls_from_exprs(e, calls) }
            IndexGet(o, i) => {
                this.collect_calls_from_expr(o, calls)
                this.collect_calls_from_expr(i, calls)
            }
            IndexSet(o, i, v) => {
                this.collect_calls_from_expr(o, calls)
                this.collect_calls_from_expr(i, calls)
                this.collect_calls_from_expr(v, calls)
            }
            SetField(o, f, v) => {
                this.collect_calls_from_expr(o, calls)
                this.collect_calls_from_expr(v, calls)
            }
            GetField(o, f) => { this.collect_calls_from_expr(o, calls) }
            MemberAccess(o, f) => { this.collect_calls_from_expr(o, calls) }
            BlockExpr(s, v) => {
                this.collect_calls_from_stmts(s, calls)
                this.collect_calls_from_expr(v, calls)
            }
            IfExpr(c, tb, tv, eb, ev) => {
                this.collect_calls_from_expr(c, calls)
                this.collect_calls_from_stmts(tb, calls)
                this.collect_calls_from_expr(tv, calls)
                this.collect_calls_from_stmts(eb, calls)
                this.collect_calls_from_expr(ev, calls)
            }
            // These five used to be missing, so a call sited inside a match arm,
            // a try/catch value, an enum payload, a lambda body or a yield was
            // invisible to the caller that decides whether a function is a
            // transitive coroutine (output_body.sf gen_function). expr_has_yield
            // above already walks all of them; keep the two in step.
            Match(subject, match_arms) => {
                this.collect_calls_from_expr(subject, calls)
                var mai: Float = 0
                while (mai < match_arms.length()) {
                    var arm: AST.MatchArm = match_arms[mai]
                    var arm_body: AST.Expr = match (arm) { Arm(p, b) => b }
                    this.collect_calls_from_expr(arm_body, calls)
                    mai = mai + 1
                }
            }
            TryExpr(tb, tv, cn, cb, cv) => {
                this.collect_calls_from_stmts(tb, calls)
                this.collect_calls_from_expr(tv, calls)
                this.collect_calls_from_stmts(cb, calls)
                this.collect_calls_from_expr(cv, calls)
            }
            EnumConstruct(en, v, a) => { this.collect_calls_from_exprs(a, calls) }
            Lambda(p, r, b) => { this.collect_calls_from_stmts(b, calls) }
            Yield(v) => { this.collect_calls_from_expr(v, calls) }
            TupleLit(e) => { this.collect_calls_from_exprs(e, calls) }
            IsCheck(v, t) => { this.collect_calls_from_expr(v, calls) }
            // Leaves: no sub-expression can hold a call.
            _ => {}
        }
    }

    fun collect_calls_from_exprs(exprs: List<AST.Expr>, calls: List<String>) {
        var i: Float = 0
        while (i < exprs.length()) {
            this.collect_calls_from_expr(exprs[i], calls)
            i = i + 1
        }
    }

    fun collect_calls_from_stmts(stmts: List<AST.Stmt>, calls: List<String>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.collect_calls_from_stmt(stmts[i], calls)
            i = i + 1
        }
    }

    fun collect_calls_from_stmt(stmt: AST.Stmt, calls: List<String>) {
        match (stmt) {
            ExprStmt(e) => { this.collect_calls_from_expr(e, calls) }
            VarDecl(n, t, init, d, v_vis) => { this.collect_calls_from_expr(init, calls) }
            Return(v) => { this.collect_calls_from_expr(v, calls) }
            If(c, tb, eb) => {
                this.collect_calls_from_expr(c, calls)
                this.collect_calls_from_stmts(tb, calls)
                this.collect_calls_from_stmts(eb, calls)
            }
            While(c, b) => {
                this.collect_calls_from_expr(c, calls)
                this.collect_calls_from_stmts(b, calls)
            }
            Block(s) => { this.collect_calls_from_stmts(s, calls) }
            TryCatch(t, n, c, f) => {
                this.collect_calls_from_stmts(t, calls)
                this.collect_calls_from_stmts(c, calls)
                this.collect_calls_from_stmts(f, calls)
            }
            Throw(v) => { this.collect_calls_from_expr(v, calls) }
            // `let [a, b] = f()` holds a call in its value, and used to be
            // missed here for the same reason as the expression arms above.
            LetPattern(p, v) => { this.collect_calls_from_expr(v, calls) }
            // Break, Continue, TypeAlias hold no expression. A nested FunDecl /
            // EnumDecl / ClassDecl body is a *different* function's code, so its
            // calls deliberately do not count as the enclosing function's — see
            // mark_coroutines, which walks declarations itself.
            _ => {}
        }
    }

    fun mark_coroutines(program: List<AST.Stmt>) {
        // Pass 1: find functions that directly contain yield
        var func_names: List<String> = []
        var func_bodies: List<List<AST.Stmt>> = []
        var i: Float = 0
        while (i < program.length()) {
            var kind: String = this.classify_stmt(program[i])
            if (kind == "fun") {
                var name: String = this.get_fun_name(program[i])
                var body: List<AST.Stmt> = this.get_fun_body(program[i])
                var full_name: String = this.current_prefix + name
                func_names.push(full_name)
                func_bodies.push(body)
                if (this.stmts_have_yield(body)) {
                    this.coroutine_funcs.push(full_name)
                    if (name != full_name) {
                        this.coroutine_funcs.push(name)
                    }
                    // Also push all possible module-prefixed forms
                    var mp_keys: List<String> = this.module_prefixes.keys()
                    var mpi: Float = 0
                    while (mpi < mp_keys.length()) {
                        var mp_prefix: String = this.module_prefixes.get(mp_keys[mpi])
                        var mp_name: String = mp_prefix + name
                        if (!this.str_in_list(this.coroutine_funcs,mp_name)) {
                            this.coroutine_funcs.push(mp_name)
                        }
                        mpi = mpi + 1
                    }
                }
            } else if (kind == "class") {
                // Also scan class methods for yield / coroutine calls
                var cls_name: String = ""
                var cls_methods: List<AST.Stmt> = []
                match (program[i]) {
                    ClassDecl(cn, __tps, cps, cf, cm, cd, c_vis) => {
                        cls_name = cn
                        cls_methods = cm
                    }
                    _ => {}
                }
                var cmi: Float = 0
                while (cmi < cls_methods.length()) {
                    var mname: String = this.get_fun_name(cls_methods[cmi])
                    var mbody: List<AST.Stmt> = this.get_fun_body(cls_methods[cmi])
                    if (mname.length() > 0) {
                        var mfull: String = this.current_prefix + cls_name + "__" + mname
                        func_names.push(mfull)
                        func_bodies.push(mbody)
                        if (this.stmts_have_yield(mbody)) {
                            this.coroutine_funcs.push(mfull)
                            // Also push bare method name for cross-module matching
                            if (!this.str_in_list(this.coroutine_funcs, mname)) {
                                this.coroutine_funcs.push(mname)
                            }
                            // Push ClassName__method without prefix
                            var unprefixed: String = cls_name + "__" + mname
                            if (!this.str_in_list(this.coroutine_funcs, unprefixed)) {
                                this.coroutine_funcs.push(unprefixed)
                            }
                        }
                    }
                    cmi = cmi + 1
                }
            }
            i = i + 1
        }

        // Pass 2: transitive coloring — if A calls B and B is a coroutine, A is too
        var changed: Bool = true
        while (changed) {
            changed = false
            var fi: Float = 0
            while (fi < func_names.length()) {
                var fn_name: String = func_names[fi]
                if (!this.str_in_list(this.coroutine_funcs,fn_name)) {
                    var calls: List<String> = []
                    this.collect_calls_from_stmts(func_bodies[fi], calls)
                    var ci: Float = 0
                    while (ci < calls.length()) {
                        var callee: String = calls[ci]
                        // Check both bare name and prefixed name (no coro_method_match —
                        // bare suffix matching causes false positives across unrelated classes)
                        if (this.str_in_list(this.coroutine_funcs,callee) or this.str_in_list(this.coroutine_funcs,this.current_prefix + callee)) {
                            this.coroutine_funcs.push(fn_name)
                            changed = true
                            ci = calls.length()
                        }
                        ci = ci + 1
                    }
                }
                fi = fi + 1
            }
        }
    }

    fun coro_method_match(callee: String): Bool {
        // Check if any known coroutine function ends with __callee
        // This handles bare method names like "read" matching "stdlib_net_TcpConnection__read"
        var suffix: String = "__" + callee
        var k: Float = 0
        while (k < this.coroutine_funcs.length()) {
            if (this.coroutine_funcs[k].ends_with(suffix)) {
                return true
            }
            k = k + 1
        }
        return false
    }

    fun str_in_list(lst: List<String>, needle: String): Bool {
        var __sil_i: Float = 0
        while (__sil_i < lst.length()) {
            if (lst[__sil_i] == needle) { return true }
            __sil_i = __sil_i + 1
        }
        return false
    }

    fun is_known_name(name: String): Bool {
        if (name == "self" or name == "this" or name == "super") { return true }
        if (name == "IO" or name == "OS" or name == "GC" or name == "Task" or name == "Reflect") { return true }
        if (this.typed_vars.has(name)) { return true }
        if (this.module_globals.has(this.current_prefix + name)) { return true }
        if (this.module_globals.has(name)) { return true }
        if (this.str_in_list(this.known_functions, name)) { return true }
        if (this.str_in_list(this.known_functions, this.current_prefix + name)) { return true }
        if (this.module_prefixes.has(name)) { return true }
        if (this.enum_defs.has(name)) { return true }
        if (this.class_fields.has(name)) { return true }
        if (this.named_imports.has(name)) { return true }
        return false
    }

    // --- LLVM library dual-emit verification ---

    fun verify_binary_op(op_name: String, result_name: String, lhs_name: String, rhs_name: String) {
        // Construct the same instruction via the @llvm library and compare
        var lhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(lhs_name, LLVMTypes.Type.I64)
        var rhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(rhs_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)

        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Add(result_val, lhs_val, rhs_val)
        if (op_name == "sub") {
            inst = LLVMInst.Instruction.Sub(result_val, lhs_val, rhs_val)
        } else if (op_name == "mul") {
            inst = LLVMInst.Instruction.Mul(result_val, lhs_val, rhs_val)
        } else if (op_name == "sdiv") {
            inst = LLVMInst.Instruction.SDiv(result_val, lhs_val, rhs_val)
        } else if (op_name == "srem") {
            inst = LLVMInst.Instruction.SRem(result_val, lhs_val, rhs_val)
        } else if (op_name == "and") {
            inst = LLVMInst.Instruction.And(result_val, lhs_val, rhs_val)
        } else if (op_name == "or") {
            inst = LLVMInst.Instruction.Or(result_val, lhs_val, rhs_val)
        } else if (op_name == "xor") {
            inst = LLVMInst.Instruction.Xor(result_val, lhs_val, rhs_val)
        } else if (op_name == "shl") {
            inst = LLVMInst.Instruction.Shl(result_val, lhs_val, rhs_val)
        } else if (op_name == "ashr") {
            inst = LLVMInst.Instruction.AShr(result_val, lhs_val, rhs_val)
        }

        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = " + op_name + " i64 " + lhs_name + ", " + rhs_name
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for " + op_name + ":")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_icmp_op(pred_name: String, result_name: String, lhs_name: String, rhs_name: String) {
        // Construct an icmp instruction via the @llvm library and compare
        var lhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(lhs_name, LLVMTypes.Type.I64)
        var rhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(rhs_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I1)

        var pred: LLVMTypes.CmpPred = LLVMTypes.CmpPred.Eq
        if (pred_name == "ne") { pred = LLVMTypes.CmpPred.Ne }
        else if (pred_name == "slt") { pred = LLVMTypes.CmpPred.Slt }
        else if (pred_name == "sle") { pred = LLVMTypes.CmpPred.Sle }
        else if (pred_name == "sgt") { pred = LLVMTypes.CmpPred.Sgt }
        else if (pred_name == "sge") { pred = LLVMTypes.CmpPred.Sge }

        var inst: LLVMInst.Instruction = LLVMInst.Instruction.ICmp(result_val, pred, lhs_val, rhs_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = icmp " + pred_name + " i64 " + lhs_name + ", " + rhs_name
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for icmp " + pred_name + ":")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_zext_op(result_name: String, src_name: String) {
        // Verify zext i1 %src to i64
        var src_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(src_name, LLVMTypes.Type.I1)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.ZExt(result_val, src_val, LLVMTypes.Type.I64)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = zext i1 " + src_name + " to i64"
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for zext:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    // --- Memory operation verification ---

    fun verify_alloca(result_name: String, type_str: String) {
        // Construct: Instruction.Alloca(result, type, name)
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Alloca(result_val, ty, "")
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = alloca " + type_str
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for alloca:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_load(result_name: String, type_str: String, ptr_name: String) {
        // Library uses opaque pointers: "load i64, ptr %x"
        // Codegen uses typed pointers: "load i64, i64* %x"
        // Verify library output format only (opaque pointer mode)
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var ptr_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(ptr_name, LLVMTypes.Type.Ptr)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Load(result_val, ty, ptr_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, false)
        // Library format: "  %r = load i64, ptr %ptr"
        // Codegen format: "  %r = load i64, i64* %ptr"
        // These differ in pointer syntax — just verify library is self-consistent
        var lib_expected: String = "  " + result_name + " = load " + type_str + ", ptr " + ptr_name
        if (lib_ir != lib_expected) {
            IO.println("[llvm-verify] MISMATCH for load (library format):")
            IO.println("  expected: " + lib_expected)
            IO.println("  library:  " + lib_ir)
        }
    }

    fun verify_store(val_name: String, type_str: String, ptr_name: String) {
        // Library uses opaque pointers: "store i64 %v, ptr %p"
        // Codegen uses typed pointers: "store i64 %v, i64* %p"
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, ty)
        var ptr_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(ptr_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Store(val_v, ptr_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, false)
        var lib_expected: String = "  store " + type_str + " " + val_name + ", ptr " + ptr_name
        if (lib_ir != lib_expected) {
            IO.println("[llvm-verify] MISMATCH for store (library format):")
            IO.println("  expected: " + lib_expected)
            IO.println("  library:  " + lib_ir)
        }
    }

    // --- Function call verification ---

    fun verify_call(result_name: String, ret_type: String, fn_name: String, args_str: String) {
        // Codegen format: "  %r = call i64 @fn(i64 %a, i64 %b)"
        // Library format: "  %r = call i64 @fn(i64 %a, i64 %b)"
        // These should match when all args are i64
        var ret_ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (ret_type == "void") { ret_ty = LLVMTypes.Type.Void }
        else if (ret_type == "i1") { ret_ty = LLVMTypes.Type.I1 }
        else if (ret_type == "i32") { ret_ty = LLVMTypes.Type.I32 }
        else if (ret_type == "ptr") { ret_ty = LLVMTypes.Type.Ptr }
        // Parse args_str into Value list (args_str is like "i64 %a, i64 %b")
        var arg_vals: List<LLVMTypes.Value> = []
        if (args_str.length() > 0) {
            var arg_parts: List<String> = args_str.split(", ")
            var ai: Float = 0
            while (ai < arg_parts.length()) {
                var part: String = arg_parts[ai]
                var space_idx: Float = part.index_of(" ")
                if (space_idx > 0) {
                    var arg_name: String = part.slice(space_idx + 1, part.length())
                    arg_vals.push(LLVMTypes.Value.Instruction(arg_name, LLVMTypes.Type.I64))
                }
                ai = ai + 1
            }
        }
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, ret_ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Call(result_val, fn_name, ret_ty, arg_vals)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = call " + ret_type + " @" + fn_name + "(" + args_str + ")"
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for call @" + fn_name + ":")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    // --- Conversion verification ---

    fun verify_ptrtoint(result_name: String, val_name: String) {
        // Codegen: "  %r = ptrtoint ptr %v to i64"
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, LLVMTypes.Type.Ptr)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.PtrToInt(result_val, val_v, LLVMTypes.Type.I64)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = ptrtoint ptr " + val_name + " to i64"
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for ptrtoint:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_inttoptr(result_name: String, val_name: String) {
        // Codegen: "  %r = inttoptr i64 %v to ptr"
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.IntToPtr(result_val, val_v, LLVMTypes.Type.Ptr)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = inttoptr i64 " + val_name + " to ptr"
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for inttoptr:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_trunc(result_name: String, val_name: String, from_type: String, to_type: String) {
        // Codegen: "  %r = trunc i64 %v to i1"
        var from_ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (from_type == "i32") { from_ty = LLVMTypes.Type.I32 }
        var to_ty: LLVMTypes.Type = LLVMTypes.Type.I1
        if (to_type == "i32") { to_ty = LLVMTypes.Type.I32 }
        else if (to_type == "i8") { to_ty = LLVMTypes.Type.I8 }
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, from_ty)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, to_ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Trunc(result_val, val_v, to_ty)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = trunc " + from_type + " " + val_name + " to " + to_type
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for trunc:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    // --- Control flow verification ---

    fun verify_br(target_label: String) {
        // Codegen: "  br label %target"
        var term: LLVMInst.Terminator = LLVMInst.Terminator.Br(target_label)
        var lib_ir: String = LLVMInst.format_terminator(term)
        var expected: String = "  br label %" + target_label
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for br:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_cond_br(cond_name: String, then_label: String, else_label: String) {
        // Codegen: "  br i1 %cond, label %then, label %else"
        var cond_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(cond_name, LLVMTypes.Type.I1)
        var term: LLVMInst.Terminator = LLVMInst.Terminator.CondBr(cond_val, then_label, else_label)
        var lib_ir: String = LLVMInst.format_terminator(term)
        var expected: String = "  br i1 " + cond_name + ", label %" + then_label + ", label %" + else_label
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for cond_br:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    // --- LLVM library emission methods ---
    // These construct instructions via the @llvm library and return
    // the formatted instruction string (without leading indent).

    fun lib_binary_op(op_name: String, result_name: String, lhs_name: String, rhs_name: String): String {
        var lhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(lhs_name, LLVMTypes.Type.I64)
        var rhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(rhs_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)

        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Add(result_val, lhs_val, rhs_val)
        if (op_name == "sub") {
            inst = LLVMInst.Instruction.Sub(result_val, lhs_val, rhs_val)
        } else if (op_name == "mul") {
            inst = LLVMInst.Instruction.Mul(result_val, lhs_val, rhs_val)
        } else if (op_name == "sdiv") {
            inst = LLVMInst.Instruction.SDiv(result_val, lhs_val, rhs_val)
        } else if (op_name == "srem") {
            inst = LLVMInst.Instruction.SRem(result_val, lhs_val, rhs_val)
        } else if (op_name == "and") {
            inst = LLVMInst.Instruction.And(result_val, lhs_val, rhs_val)
        } else if (op_name == "or") {
            inst = LLVMInst.Instruction.Or(result_val, lhs_val, rhs_val)
        } else if (op_name == "xor") {
            inst = LLVMInst.Instruction.Xor(result_val, lhs_val, rhs_val)
        } else if (op_name == "shl") {
            inst = LLVMInst.Instruction.Shl(result_val, lhs_val, rhs_val)
        } else if (op_name == "ashr") {
            inst = LLVMInst.Instruction.AShr(result_val, lhs_val, rhs_val)
        }

        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_icmp_op(pred_name: String, result_name: String, lhs_name: String, rhs_name: String): String {
        var lhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(lhs_name, LLVMTypes.Type.I64)
        var rhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(rhs_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I1)

        var pred: LLVMTypes.CmpPred = LLVMTypes.CmpPred.Eq
        if (pred_name == "ne") { pred = LLVMTypes.CmpPred.Ne }
        else if (pred_name == "slt") { pred = LLVMTypes.CmpPred.Slt }
        else if (pred_name == "sle") { pred = LLVMTypes.CmpPred.Sle }
        else if (pred_name == "sgt") { pred = LLVMTypes.CmpPred.Sgt }
        else if (pred_name == "sge") { pred = LLVMTypes.CmpPred.Sge }

        var inst: LLVMInst.Instruction = LLVMInst.Instruction.ICmp(result_val, pred, lhs_val, rhs_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_zext_op(result_name: String, src_name: String): String {
        var src_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(src_name, LLVMTypes.Type.I1)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.ZExt(result_val, src_val, LLVMTypes.Type.I64)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_trunc(result_name: String, val_name: String, from_type: String, to_type: String): String {
        var from_ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (from_type == "i32") { from_ty = LLVMTypes.Type.I32 }
        var to_ty: LLVMTypes.Type = LLVMTypes.Type.I1
        if (to_type == "i32") { to_ty = LLVMTypes.Type.I32 }
        else if (to_type == "i8") { to_ty = LLVMTypes.Type.I8 }
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, from_ty)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, to_ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Trunc(result_val, val_v, to_ty)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_br(target_label: String): String {
        var term: LLVMInst.Terminator = LLVMInst.Terminator.Br(target_label)
        var lib_ir: String = LLVMInst.format_terminator(term)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_cond_br(cond_name: String, then_label: String, else_label: String): String {
        var cond_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(cond_name, LLVMTypes.Type.I1)
        var term: LLVMInst.Terminator = LLVMInst.Terminator.CondBr(cond_val, then_label, else_label)
        var lib_ir: String = LLVMInst.format_terminator(term)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_call(result_name: String, ret_type: String, fn_name: String, args_str: String): String {
        var ret_ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (ret_type == "void") { ret_ty = LLVMTypes.Type.Void }
        else if (ret_type == "i1") { ret_ty = LLVMTypes.Type.I1 }
        else if (ret_type == "i32") { ret_ty = LLVMTypes.Type.I32 }
        else if (ret_type == "ptr") { ret_ty = LLVMTypes.Type.Ptr }
        var arg_vals: List<LLVMTypes.Value> = []
        if (args_str.length() > 0) {
            var arg_parts: List<String> = args_str.split(", ")
            var ai: Float = 0
            while (ai < arg_parts.length()) {
                var part: String = arg_parts[ai]
                var space_idx: Float = part.index_of(" ")
                if (space_idx > 0) {
                    var arg_name: String = part.slice(space_idx + 1, part.length())
                    arg_vals.push(LLVMTypes.Value.Instruction(arg_name, LLVMTypes.Type.I64))
                }
                ai = ai + 1
            }
        }
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, ret_ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Call(result_val, fn_name, ret_ty, arg_vals)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_ptrtoint(result_name: String, val_name: String): String {
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, LLVMTypes.Type.Ptr)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.PtrToInt(result_val, val_v, LLVMTypes.Type.I64)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_inttoptr(result_name: String, val_name: String): String {
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.IntToPtr(result_val, val_v, LLVMTypes.Type.Ptr)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_alloca(result_name: String, type_str: String): String {
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Alloca(result_val, ty, "")
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_load(result_name: String, type_str: String, ptr_name: String): String {
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var ptr_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(ptr_name, LLVMTypes.Type.Ptr)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Load(result_val, ty, ptr_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_store(val_name: String, type_str: String, ptr_name: String): String {
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, ty)
        var ptr_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(ptr_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Store(val_v, ptr_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    /// Extract the register name from an arg string like "i64 %1" -> "%1"
    fun extract_arg_reg(arg_str: String): String {
        // arg_str is e.g. "i64 %3" or "i64 0"
        var space_idx: Float = arg_str.index_of(" ")
        if (space_idx >= 0) {
            return arg_str.slice(space_idx + 1, arg_str.length())
        }
        return arg_str
    }

    /// Pre-register one function declaration's signature: defaults, param count,
    /// param names and RETURN TYPE.
    ///
    /// This is the single implementation of the declaration pre-scan. It used to
    /// be copy-pasted into `generate_with_modules` and both `..._flat_opts`
    /// variants, plus a fourth, *divergent* copy for the main program's own
    /// declarations. BUGS #33 and #36 each had to be applied to every copy, and
    /// #33's first attempt got two of them wrong — the build caught it. Worse,
    /// the main-program copy never registered `func_ret_types` at all, so #33
    /// was still live for top-level functions: a caller declared above its
    /// callee inferred `Int` for the result and every method on it silently
    /// fell through (#37).
    ///
    /// `prefix` is "" for the main program and the module prefix otherwise.
    fun prescan_fun_decl(stmt: AST.Stmt, prefix: String) {
        var name: String = this.get_fun_name(stmt)
        if (name.length() == 0) return nil
        var doc: String = this.get_fun_doc(stmt)
        // @intrinsic declarations are dispatched by other machinery and must not
        // be registered as ordinary callables.
        if (doc.starts_with("@intrinsic")) return nil
        // An @extern, however, MUST be pre-registered here, or a call compiled
        // before the extern's own decl is lowered finds extern_sigs empty, falls
        // through to the generic call branch, and emits `call i64 @<name>` — an
        // i64 signature against a C function that is really `declare double
        // @sqrt(double)`, which the linker or the IR verifier then rejects
        // (BUGS #55). The lowering-time writes at stmts_body.sf:64-69 are
        // idempotent with these — same key, same value. Registered here rather
        // than in gen_function's pass because Codegen.generate never calls a
        // separate extern pre-scan; this prescan is the only one the single-file
        // path runs.
        if (doc.starts_with("@extern:")) {
            var c_sig: String = doc.slice(8, doc.length())
            var xemit: String = prefix + name
            this.known_functions.push(xemit)
            this.extern_sigs.set(xemit, c_sig)
            this.extern_param_types.set(xemit, this.param_types_csv(this.get_fun_params(stmt)))
            var xret: String = this.get_fun_ret(stmt)
            if (xret.length() > 0) { this.func_ret_types.set(xemit, this.str_to_type(xret)) }
            return nil
        }

        var emit_name: String = prefix + name
        var params: List<AST.Param> = this.get_fun_params(stmt)
        var defaults: List<AST.Expr> = []
        var pnames: List<String> = []
        var pi: Float = 0
        while (pi < params.length()) {
            var p: AST.Param = params[pi]
            defaults.push(match (p) { Param(n, t, d, p_vis) => d })
            pnames.push(match (p) { Param(n, t, d, p_vis) => n })
            pi = pi + 1
        }
        this.func_defaults.set(emit_name, defaults)
        this.func_param_count.set(emit_name, params.length())
        this.func_param_names.set(emit_name, pnames)

        // Return type too, or a call compiled before the callee's own
        // gen_function runs falls back to Int and misdispatches every method on
        // the result (BUGS #33). gen_function still sets this, but only when it
        // reaches the declaration — too late for a caller appearing earlier.
        var ret: String = this.get_fun_ret(stmt)
        if (ret.length() > 0) {
            this.func_ret_types.set(emit_name, this.str_to_type(ret))
            if (prefix.length() > 0) {
                this.func_ret_types.set(name, this.str_to_type(ret))
            }
        }
    }

    /// Pre-register every method of a class declaration. Methods take an implicit
    /// leading `self`, registered under both the bare `Class__method` name and
    /// the prefixed one.
    fun prescan_class_decl(stmt: AST.Stmt, prefix: String) {
        var cname: String = match (stmt) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
            _ => ""
        }
        var methods: List<AST.Stmt> = match (stmt) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
            _ => []
        }
        var mi: Float = 0
        while (mi < methods.length()) {
            var mname: String = this.get_fun_name(methods[mi])
            if (mname.length() > 0) {
                var mparams: List<AST.Param> = this.get_fun_params(methods[mi])
                var mdefs: List<AST.Expr> = []
                var mpnames: List<String> = []
                mpnames.push("self")
                mdefs.push(AST.Expr.NilLit)
                var mpi: Float = 0
                while (mpi < mparams.length()) {
                    var mp: AST.Param = mparams[mpi]
                    mdefs.push(match (mp) { Param(n, t, d, p_vis) => d })
                    mpnames.push(match (mp) { Param(n, t, d, p_vis) => n })
                    mpi = mpi + 1
                }
                var full: String = cname + "__" + mname
                this.func_defaults.set(full, mdefs)
                this.func_param_count.set(full, mpnames.length())
                this.func_param_names.set(full, mpnames)
                if (prefix.length() > 0) {
                    var pfull: String = prefix + full
                    this.func_defaults.set(pfull, mdefs)
                    this.func_param_count.set(pfull, mpnames.length())
                    this.func_param_names.set(pfull, mpnames)
                }
            }
            mi = mi + 1
        }
    }

    /// Pre-scan a contiguous run of statements, registering every function and
    /// class declaration. One call site per corpus — modules and main program
    /// alike — so the four copies cannot drift again.
    fun prescan_decls(stmts: List<AST.Stmt>, start: Float, end: Float, prefix: String) {
        var si: Float = start
        while (si < end) {
            var kind: String = this.classify_stmt(stmts[si])
            if (kind == "fun") {
                this.prescan_fun_decl(stmts[si], prefix)
            } else if (kind == "class") {
                this.prescan_class_decl(stmts[si], prefix)
            }
            si = si + 1
        }
    }

    // --- Statement codegen ---

    // @codegen-split: output
    fun gen_function(name: String, params: String, ret_type: String, body: List<AST.Stmt>) {
        var emit_name: String = this.current_prefix + name
        // Only the ENTRY module's `main` becomes __saffron_main. An imported
        // module is free to define a function called `main` (turmeric/prelude.sf
        // does — it is the <main> element builder), and renaming that one too
        // made both collapse onto the same symbol: the entry point silently
        // called the library's `main` instead of the user's, with no diagnostic.
        // current_prefix is empty only for the module being compiled.
        if (name == "main" and this.current_prefix.length() == 0) {
            emit_name = "__saffron_main"
            this.known_functions.push("main")
        } else if (name.contains("__lambda")) {
            emit_name = name
        }
        this.known_functions.push(emit_name)
        this.func_ret_types.set(emit_name, this.str_to_type(ret_type))
        if (this.current_prefix.length() > 0) {
            this.func_ret_types.set(name, this.str_to_type(ret_type))
            this.func_prefix_map.set(name, emit_name)
        }
        this.current_function_name = name
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,emit_name)) {
            if (this.current_prefix.length() == 0 and !emit_name.contains("__lambda")) {


            }
            return
        }
        this.defined_funcs.push(emit_name)
        var is_nested: Bool = this.in_function

        // For nested functions: hoist as regular function with captures as extra params
        if (is_nested) {
            var param_names: List<String> = []
            if (params.length() > 0) {
                var pl: List<String> = this.split_respecting_generics(params, ",")
                var pi2: Float = 0
                while (pi2 < pl.length()) {
                    var pp: List<String> = pl[pi2].split(":")
                    param_names.push(pp[0])
                    pi2 = pi2 + 1
                }
            }
            var captures_raw: List<String> = []
            this.find_free_vars_stmts(body, param_names, captures_raw)
            // Deduplicate captures (find_free_vars may report the same var multiple times)
            var captures: List<String> = []
            var cdi: Float = 0
            while (cdi < captures_raw.length()) {
                var already: Bool = false
                var cdj: Float = 0
                while (cdj < captures.length()) {
                    if (captures[cdj] == captures_raw[cdi]) {
                        already = true
                    }
                    cdj = cdj + 1
                }
                // Also skip if it's already a declared parameter
                var is_param: Bool = false
                var cdp: Float = 0
                while (cdp < param_names.length()) {
                    if (param_names[cdp] == captures_raw[cdi]) { is_param = true }
                    cdp = cdp + 1
                }
                if (!already and !is_param) {
                    captures.push(captures_raw[cdi])
                }
                cdi = cdi + 1
            }

            // Build extended params: captures (with actual types from parent) + original params
            var full_params: String = ""
            var ci2: Float = 0
            while (ci2 < captures.length()) {
                if (full_params.length() > 0) { full_params = full_params + "," }
                var cap_type: String = this.get_var_type_str(captures[ci2])
                if (cap_type.length() == 0) {
                    cap_type = "Int"
                }
                full_params = full_params + captures[ci2] + ":" + cap_type
                ci2 = ci2 + 1
            }
            if (params.length() > 0) {
                if (full_params.length() > 0) { full_params = full_params + "," }
                full_params = full_params + params
            }

            // Record capture info for call sites
            this.called_function_arity.set("__captures_" + emit_name, captures.length())
            this.func_prefix_map.set("__caps_" + emit_name, captures.join(","))

            // Save state and emit hoisted function
            var saved_sb2: StringBuilder = this.sb
            var saved_terminated2: Bool = this.block_terminated
            var saved_counter2: Float = this.local_counter
            var saved_typed_vars2: Map<String, AST.Type> = this.typed_vars
            var saved_gc_root_count2: Float = this.gc_root_count

            this.sb = StringBuilder()
            this.in_function = true
            this.typed_vars = {}
            this.string_vars = []
            this.gc_root_count = 0
            this.reset_locals()
            var ret_llvm2: String = this.llvm_type(ret_type)
            var all_params: List<String> = []
            if (full_params.length() > 0) {
                all_params = this.split_respecting_generics(full_params, ",")
            }
            var param_strs2: List<String> = []
            var pi3: Float = 0
            while (pi3 < all_params.length()) {
                var pp2: List<String> = all_params[pi3].split(":")
                param_strs2.push("i64 %" + this.sanitize_name(pp2[0]) + ".arg")
                pi3 = pi3 + 1
            }
            var linkage2: String = "define"
            if (this.current_prefix.length() > 0 and this.target != "wasm" and this.target != "wasm64" and this.target != "wasm32") { linkage2 = "define linkonce_odr" }
            this.emit("")
            this.emit(linkage2 + " " + ret_llvm2 + " @" + emit_name + "(" + param_strs2.join(", ") + ") {")
            this.emit("entry:")
            this.block_terminated = false
            pi3 = 0
            while (pi3 < all_params.length()) {
                var pp2: List<String> = all_params[pi3].split(":")
                if (pi3 < captures.length()) {
                    // Capture params are POINTERS — reconstruct via inttoptr
                    if (this.target == "wasm32" or this.target == "wasm") {
                        var __cap_i32: String = this.fresh_local()
                        this.emit_indent(__cap_i32 + " = trunc i64 %" + this.sanitize_name(pp2[0]) + ".arg to i32")
                        this.emit_indent("%" + this.sanitize_name(pp2[0]) + " = inttoptr i32 " + __cap_i32 + " to i64*")
                    } else {
                        this.emit_indent("%" + this.sanitize_name(pp2[0]) + " = inttoptr i64 %" + this.sanitize_name(pp2[0]) + ".arg to i64*")
                    }
                } else {
                    // Regular params — alloca and store
                    this.emit_indent("%" + this.sanitize_name(pp2[0]) + " = alloca i64")
                    this.emit_indent("store i64 %" + this.sanitize_name(pp2[0]) + ".arg, i64* %" + this.sanitize_name(pp2[0]))
                }
                this.typed_vars.set(pp2[0], this.str_to_type(pp2[1]))
                pi3 = pi3 + 1
            }
            var var_names2: List<String> = []
            var var_types2: List<String> = []
            this.collect_vars(body, var_names2, var_types2)
            // Same as the non-nested path: a nested body's own locals shadow a
            // like-named module global at the store site (BUGS #59). The alloca
            // below is already unconditional, so without this the store would
            // target @__g_ while the load reads the local slot.
            var saved_fn_locals2: Map<String, Bool> = this.current_fn_locals
            this.current_fn_locals = {}
            var cfl2_i: Float = 0
            while (cfl2_i < var_names2.length()) {
                this.current_fn_locals.set(var_names2[cfl2_i], true)
                cfl2_i = cfl2_i + 1
            }
            // Track which names already have allocas (from params above)
            var allocated: List<String> = []
            var aai: Float = 0
            while (aai < all_params.length()) {
                var aap: List<String> = all_params[aai].split(":")
                allocated.push(aap[0])
                aai = aai + 1
            }
            // Same heap-cell treatment as the non-nested path below (BUGS #51
            // defect B), and clearing the map is load-bearing even where nothing
            // gets boxed: `boxed_locals` still holds the *enclosing* function's set
            // while this body is emitted, so a lambda in here capturing a name that
            // merely coincides with an outer boxed local would be handed a snapshot
            // as though it were a cell pointer. Saved and restored like
            // current_fn_locals above.
            var saved_boxed2: Map<String, Bool> = this.boxed_locals
            this.boxed_locals = {}
            var boxed_names2: List<String> = []
            if (!this.identity_mode) {
                var assigned2: List<String> = []
                this.collect_lambda_assigned_stmts(body, assigned2, false)
                var bl2_i: Float = 0
                while (bl2_i < var_names2.length()) {
                    var bl2_n: String = var_names2[bl2_i]
                    if (this.str_in_list(assigned2, bl2_n) and bl2_n != "self") {
                        boxed_names2.push(bl2_n)
                        this.boxed_locals.set(bl2_n, true)
                    }
                    bl2_i = bl2_i + 1
                }
            }
            pi3 = 0
            while (pi3 < var_names2.length()) {
                var vn2: String = var_names2[pi3]
                var already_alloc: Bool = false
                var aaj: Float = 0
                while (aaj < allocated.length()) {
                    if (allocated[aaj] == vn2) { already_alloc = true }
                    aaj = aaj + 1
                }
                if (!already_alloc) {
                    if (this.str_in_list(boxed_names2, vn2)) {
                        var cell_raw2: String = this.fresh_local()
                        this.emit_indent(cell_raw2 + " = call i8* @__sf_malloc(i64 8)")
                        this.emit_indent("%" + this.sanitize_name(vn2) + " = bitcast i8* " + cell_raw2 + " to i64*")
                        this.emit_indent("store i64 0, i64* %" + this.sanitize_name(vn2))
                    } else {
                        this.emit_indent("%" + this.sanitize_name(vn2) + " = alloca i64")
                    }
                    allocated.push(vn2)
                }
                pi3 = pi3 + 1
            }
            this.gen_stmts(body)
            if (!this.block_terminated) { this.emit_indent("ret i64 0") }
            this.emit("}")
            this.block_terminated = false

            var nested_ir: String = this.sb.to_string()
            this.sb = saved_sb2
            this.block_terminated = saved_terminated2
            this.local_counter = saved_counter2
            this.typed_vars = saved_typed_vars2
            this.gc_root_count = saved_gc_root_count2
            this.current_fn_locals = saved_fn_locals2
            this.boxed_locals = saved_boxed2
            this.globals.push(nested_ir)
            return
        }

        this.in_function = true
        var saved_tv: Map<String, AST.Type> = this.typed_vars
        var saved_is_coro: Bool = this.is_coroutine
        this.reset_locals()
        this.string_vars = []
        this.typed_vars = {}
        var ret_llvm: String = this.llvm_type(ret_type)

        // Parse params string "name:type,name:type"
        var param_list: List<String> = []
        if (params.length() > 0) {
            param_list = this.split_respecting_generics(params, ",")
        }

        var param_strs: List<String> = []
        var i: Float = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            param_strs.push(this.llvm_type(ptype) + " %" + this.sanitize_name(pname) + ".arg")
            i = i + 1
        }
        // Register param names for named argument dispatch
        var pnames_list: List<String> = []
        var pni: Float = 0
        while (pni < param_list.length()) {
            var pnparts: List<String> = param_list[pni].split(":")
            pnames_list.push(pnparts[0])
            pni = pni + 1
        }
        this.func_param_names.set(emit_name, pnames_list)

        // --- LLVM lib: create FunctionBuilder in parallel ---
        // Build a parallel LLVM Module representation alongside string emission.
        // We create the FunctionBuilder + BlockBuilder so that gen_expr can record
        // LLVM instructions in parallel with string emission.
        // At the end of generate(), llvm_module.emit_ir() validates the structure.
        if (this.use_llvm_lib and !this.identity_mode) {
            var llvm_params: List<LLVMFunc.Param> = []
            var lpi: Float = 0
            while (lpi < param_list.length()) {
                var lp_parts: List<String> = param_list[lpi].split(":")
                var lp_name: String = "%" + this.sanitize_name(lp_parts[0]) + ".arg"
                var lp: LLVMFunc.Param = LLVMFunc.Param(lp_name, LLVMTypes.Type.I64)
                // Workaround: gen2 doesn't emit init calls for cross-module constructors
                lp.init(lp_name, LLVMTypes.Type.I64)
                llvm_params.push(lp)
                lpi = lpi + 1
            }
            this.llvm_func_builder = this.llvm_module.add_function(emit_name, LLVMTypes.Type.I64, llvm_params)
            var llvm_entry: LLVMFunc.BasicBlock = this.llvm_func_builder.entry_block()
            this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_entry)
            this.llvm_block_builder.init(this.llvm_func_builder, llvm_entry)
        }

        // Check if this function is a coroutine (direct or transitive)
        var is_coro: Bool = this.str_in_list(this.coroutine_funcs,emit_name)
        if (!is_coro) { is_coro = this.stmts_have_yield(body) }
        if (!is_coro) {
            // Check if body calls any known coroutine (transitive)
            var body_calls: List<String> = []
            this.collect_calls_from_stmts(body, body_calls)
            var bci: Float = 0
            while (bci < body_calls.length()) {
                var bc: String = body_calls[bci]
                if (this.str_in_list(this.coroutine_funcs,bc) or this.str_in_list(this.coroutine_funcs,this.current_prefix + bc)) {
                    is_coro = true
                    bci = body_calls.length()
                }
                bci = bci + 1
            }
        }
        if (is_coro and !this.str_in_list(this.coroutine_funcs,emit_name)) {
            this.coroutine_funcs.push(emit_name)
        }
        this.is_coroutine = is_coro

        this.emit("")
        var linkage: String = "define"
        if (this.current_prefix.length() > 0) {
            // On WASM targets, linkonce_odr breaks indirect calls through function table
            // index mismatch after linker deduplication. Use plain define with module-prefixed
            // names to ensure each function has a stable table entry.
            if (this.target != "wasm" and this.target != "wasm64" and this.target != "wasm32") {
                linkage = "define linkonce_odr"
            }
        }
        var coro_attr: String = ""
        if (is_coro) { coro_attr = " presplitcoroutine" }
        var inline_attr: String = ""
        if (!is_coro and this.str_in_list(this.inline_funcs, emit_name)) {
            inline_attr = " alwaysinline"
        }
        var ret_type_ll: String = ret_llvm
        if (is_coro) { ret_type_ll = "ptr" }
        this.emit(linkage + " " + ret_type_ll + " @" + emit_name + "(" + param_strs.join(", ") + ")" + coro_attr + inline_attr + " {")
        this.emit("entry:")
        this.block_terminated = false

        // Coroutine preamble
        if (is_coro) {
            this.emit_indent("%__coro_id = call token @llvm.coro.id(i32 0, ptr null, ptr null, ptr null)")
            this.emit_indent("%__coro_size = call i64 @llvm.coro.size.i64()")
            this.emit_indent("%__coro_mem = call ptr @__sf_malloc(i64 %__coro_size)")
            this.emit_indent("%__coro_hdl = call ptr @llvm.coro.begin(token %__coro_id, ptr %__coro_mem)")
        }

        // Collect all local variable declarations from body
        var var_names: List<String> = []
        var var_types: List<String> = []
        this.collect_vars(body, var_names, var_types)

        // Record this body's locals so the alloca and store sites below treat a
        // name as local even when a module global shares it (BUGS #59).
        // collect_vars does not descend into nested FunDecls, so this set is
        // exactly the current function's own bindings. Saved/restored around the
        // body since gen_function is re-entrant for nested functions.
        var saved_fn_locals: Map<String, Bool> = this.current_fn_locals
        this.current_fn_locals = {}
        var cfl_i: Float = 0
        while (cfl_i < var_names.length()) {
            this.current_fn_locals.set(var_names[cfl_i], true)
            cfl_i = cfl_i + 1
        }

        // Locals a nested lambda both captures and writes to must live in a heap
        // cell rather than an alloca, so the closure's env can point *at* the same
        // storage the enclosing frame reads (BUGS #51 defect B). Without this the
        // variable has two homes — the frame's alloca and the env's snapshot — and
        // a write inside the closure never reaches the enclosing scope: `count`
        // read 0 after two `bump()` calls that each returned a correctly
        // incremented value.
        //
        // Deliberately narrow. `%<name>` is an `i64*` either way, so every load and
        // store site downstream is untouched; only how the pointer is produced
        // changes. A capture that is merely read keeps its alloca (the env snapshot
        // is already correct for it), and so does every local no lambda mentions —
        // which is nearly all of them, and matters because this is the hottest
        // path in codegen.
        var boxed_locals: List<String> = []
        if (!this.identity_mode) {
            var assigned_in_lambda: List<String> = []
            this.collect_lambda_assigned_stmts(body, assigned_in_lambda, false)
            var bl_i: Float = 0
            while (bl_i < var_names.length()) {
                var bl_n: String = var_names[bl_i]
                if (this.str_in_list(assigned_in_lambda, bl_n) and bl_n != "self") {
                    if (this.current_fn_locals.has(bl_n) or !this.module_globals.has(this.current_prefix + bl_n)) {
                        boxed_locals.push(bl_n)
                    }
                }
                bl_i = bl_i + 1
            }
        }
        // Identity mode (the bootstrap) is excluded: there is no GC and no boxing
        // there, and the compiler's own source contains no capturing lambda that
        // writes to a capture, so the analysis would only add risk to the one build
        // that cannot exercise it. That is the identity-mode blind spot — the
        // coverage for this has to come from user-program tests.

        // Emit all allocas in entry block (params + locals)
        i = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            this.emit_indent("%" + this.sanitize_name(pname) + " = alloca " + this.llvm_type(ptype))
            i = i + 1
        }
        i = 0
        while (i < var_names.length()) {
            var vn: String = var_names[i]
            // A local shadowing a module global still needs its own alloca
            // (BUGS #59). current_fn_locals holds this body's own bindings, so
            // prefer it over module_globals here.
            if ((this.current_fn_locals.has(vn) or !this.module_globals.has(this.current_prefix + vn)) and vn != "self") {
                if (this.str_in_list(boxed_locals, vn)) {
                    // Heap cell instead of an alloca. Zeroed unconditionally, not
                    // just for GC root types: malloc'd memory is uninitialized, and
                    // a `var` read before its first store would otherwise surface
                    // whatever was in the heap rather than the 0 an alloca'd slot
                    // gets from the store below.
                    var cell_raw: String = this.fresh_local()
                    this.emit_indent(cell_raw + " = call i8* @__sf_malloc(i64 8)")
                    this.emit_indent("%" + this.sanitize_name(vn) + " = bitcast i8* " + cell_raw + " to i64*")
                    this.emit_indent("store i64 0, i64* %" + this.sanitize_name(vn))
                } else {
                    this.emit_indent("%" + this.sanitize_name(vn) + " = alloca " + this.llvm_type(var_types[i]))
                    // Zero-initialize allocas for heap-typed locals before they become GC roots.
                    // This prevents the GC from reading uninitialized memory if it triggers
                    // between push_root and the first real store to this variable.
                    if (!this.identity_mode and this.is_gc_root_type(var_types[i])) {
                        this.emit_indent("store i64 0, i64* %" + this.sanitize_name(vn))
                    }
                }
            }
            i = i + 1
        }
        // The env must hold the cell POINTER, not a snapshot of its contents, for
        // any local boxed above. gen_lambda reads this to decide which of the two
        // it stores; cleared after the body so a sibling function does not inherit
        // this one's set.
        //
        // Two consequences of the cell being `__sf_malloc` (plain malloc) rather
        // than GC memory, both deliberate. It is never swept, so the GC root pushed
        // for it below stays a valid address for the whole process — which is what
        // makes rooting a heap cell safe at all. And it is never freed, so a boxed
        // local costs 8 leaked bytes per call to the enclosing function. Closures
        // already leak their env array and closure pair the same way (gen_lambda),
        // so this adds no new class of leak, only another instance of it.
        //
        // Not addressed here: a closure outliving its enclosing frame keeps the cell
        // alive but not *rooted* — the frame pops its roots on return, so a heap
        // value reachable only through the cell can be swept. That is exactly the
        // pre-existing hole for the env array's own snapshots, so boxing neither
        // creates nor widens it.
        var saved_boxed: Map<String, Bool> = this.boxed_locals
        this.boxed_locals = {}
        var sb_i: Float = 0
        while (sb_i < boxed_locals.length()) {
            this.boxed_locals.set(boxed_locals[sb_i], true)
            sb_i = sb_i + 1
        }

        // Store params into their allocas and track types
        i = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            this.typed_vars.set(pname, this.str_to_type(ptype))
            if (ptype == "String") {
                this.string_vars.push(pname)
            }
            this.emit_indent("store i64 %" + this.sanitize_name(pname) + ".arg, i64* %" + this.sanitize_name(pname))
            i = i + 1
        }

        // GC root tracking: push alloca addresses for heap-typed locals
        // Only emit when not in identity mode (bootstrap doesn't need GC)
        var gc_root_count: Float = 0
        if (!this.identity_mode) {
            // Coroutines tear down at __coro_final, by which time other tasks may
            // have pushed roots on top of ours — the shadow stack is a single
            // global LIFO but coroutine lifetimes are not nested. Record the depth
            // *before* pushing this frame's roots so the epilogue can tell whether
            // our roots are still the top of the stack and therefore safe to pop.
            // Placed after llvm.coro.begin so CoroSplit promotes it into the frame,
            // which is what lets it survive an arbitrary number of suspends.
            if (is_coro) {
                this.emit_indent("%__coro_ss_base = alloca i64")
                this.emit_indent("%__coro_ss_base_v = call i64 @__gc_shadow_stack_depth()")
                this.emit_indent("store i64 %__coro_ss_base_v, i64* %__coro_ss_base")
            }
            // Track params that are heap types
            i = 0
            while (i < param_list.length()) {
                var parts: List<String> = param_list[i].split(":")
                var pname: String = parts[0]
                var ptype: String = parts[1]
                if (this.is_gc_root_type(ptype)) {
                    var alloca_as_int: String = this.typed_ptr_to_val("%" + this.sanitize_name(pname), "i64*")
                    this.emit_indent("call void @__gc_push_root(i64 " + alloca_as_int + ")")
                    gc_root_count = gc_root_count + 1
                }
                i = i + 1
            }
            // Track locals that are heap types
            i = 0
            while (i < var_names.length()) {
                var vn: String = var_names[i]
                var vt: String = var_types[i]
                // Mirror the alloca guard above: a shadowing local has its own
                // slot and must be rooted like any other local (BUGS #59).
                if ((this.current_fn_locals.has(vn) or !this.module_globals.has(this.current_prefix + vn)) and vn != "self" and this.is_gc_root_type(vt)) {
                    var loc_as_int: String = this.typed_ptr_to_val("%" + this.sanitize_name(vn), "i64*")
                    this.emit_indent("call void @__gc_push_root(i64 " + loc_as_int + ")")
                    gc_root_count = gc_root_count + 1
                }
                i = i + 1
            }
        }
        this.gc_root_count = gc_root_count

        // Generate body statements, treating last ExprStmt as implicit return
        if (body.length() > 0 and ret_type != "Nil" and ret_type != "void") {
            var last_stmt: AST.Stmt = body[body.length() - 1]
            var last_kind: String = this.classify_stmt(last_stmt)
            if (last_kind == "expr") {
                var bi: Float = 0
                while (bi < body.length() - 1) {
                    this.gen_stmt(body[bi])
                    bi = bi + 1
                }
                var last_expr: AST.Expr = match (last_stmt) { ExprStmt(e) => e
                    _ => AST.Expr.NilLit
                }
                var last_val: String = this.gen_arg_value(last_expr)
                if (!this.block_terminated) {
                    if (is_coro) {
                        this.emit_terminator("br label %__coro_final")
                    } else {
                        if (gc_root_count > 0) {
                            this.emit_indent("call void @__gc_pop_roots(i64 " + gc_root_count.floor().to_string() + ")")
                        }
                        this.emit_terminator("ret i64 " + last_val)
                    }
                }
            } else {
                this.gen_stmts(body)
            }
        } else {
            this.gen_stmts(body)
        }

        // Non-coro: ensure block has a terminator
        if (!is_coro) {
            if (!this.block_terminated) {
                if (gc_root_count > 0) {
                    this.emit_indent("call void @__gc_pop_roots(i64 " + gc_root_count.floor().to_string() + ")")
                }
                if (ret_llvm == "void") {
                    this.emit_terminator("ret void")
                } else {
                    this.emit_terminator("ret i64 0")
                }
            }
        }

        // Coroutine epilogue: final suspend + cleanup
        if (is_coro) {
            if (!this.block_terminated) {
                this.emit_terminator("br label %__coro_final")
            }

            this.emit("__coro_final:")
            this.block_terminated = false
            // Release this frame's GC roots. Every coroutine return path funnels
            // through __coro_final (gen_return branches here rather than popping
            // itself), and the final suspend never resumes back into the body —
            // resume traps, destroy goes to __coro_cleanup — so this runs exactly
            // once per frame no matter how many times the coroutine suspended.
            //
            // The pop is guarded because the shadow stack is one global LIFO while
            // coroutine lifetimes are not nested: a task that started later can
            // still be live, with its roots stacked above ours, when we finish.
            // Popping a fixed count there would discard *its* roots and collect
            // objects that are still in use. So pop only when our region is
            // provably still the top of the stack; otherwise leave it, since
            // leaking a root is recoverable and freeing a live one is not.
            if (gc_root_count > 0) {
                this.emit_indent("%__coro_ss_now = call i64 @__gc_shadow_stack_depth()")
                this.emit_indent("%__coro_ss_b = load i64, i64* %__coro_ss_base")
                this.emit_indent("%__coro_ss_exp = add i64 %__coro_ss_b, " + gc_root_count.floor().to_string())
                this.emit_indent("%__coro_ss_is_top = icmp eq i64 %__coro_ss_now, %__coro_ss_exp")
                this.emit_terminator("br i1 %__coro_ss_is_top, label %__coro_ss_pop, label %__coro_ss_done")
                this.emit("__coro_ss_pop:")
                this.block_terminated = false
                this.emit_indent("call void @__gc_pop_roots(i64 " + gc_root_count.floor().to_string() + ")")
                this.emit_terminator("br label %__coro_ss_done")
                this.emit("__coro_ss_done:")
                this.block_terminated = false
            }
            this.emit_indent("%__coro_fs_tok = call token @llvm.coro.save(ptr %__coro_hdl)")
            this.emit_indent("%__coro_fs = call i8 @llvm.coro.suspend(token %__coro_fs_tok, i1 true)")
            this.emit_indent("switch i8 %__coro_fs, label %__coro_suspend [i8 0, label %__coro_trap i8 1, label %__coro_cleanup]")

            this.emit("__coro_trap:")
            this.block_terminated = false
            this.emit_terminator("unreachable")

            this.emit("__coro_cleanup:")
            this.block_terminated = false
            this.emit_indent("%__coro_free = call ptr @llvm.coro.free(token %__coro_id, ptr %__coro_hdl)")
            this.emit_indent("call void @free(ptr %__coro_free)")
            this.emit_terminator("br label %__coro_suspend")

            this.emit("__coro_suspend:")
            this.block_terminated = false
            this.emit_indent("call i1 @llvm.coro.end(ptr %__coro_hdl, i1 false)")
            this.emit_terminator("ret ptr %__coro_hdl")
        }

        this.emit("}")
        this.block_terminated = false
        this.typed_vars = saved_tv
        this.in_function = false
        this.current_fn_locals = saved_fn_locals
        this.boxed_locals = saved_boxed
        this.is_coroutine = saved_is_coro
    }

    // --- Top-level ---

    fun is_nil_expr(e: AST.Expr): Bool {
        var k: String = this.classify_expr(e)
        return k == "nil"
    }

    fun is_nil_expr_stmt(stmt: AST.Stmt): Bool {
        var sk: String = this.classify_stmt(stmt)
        if (sk != "expr") { return false }
        var e: AST.Expr = match (stmt) { ExprStmt(ex) => ex
            _ => AST.Expr.IntLit(1)
        }
        return this.is_nil_expr(e)
    }

    fun is_decl(stmt: AST.Stmt): Bool {
        return match (stmt) {
            FunDecl(n, p, r, b, d, f_vis) => true
            EnumDecl(n, v, d, e_vis) => true
            ClassDecl(n, __tps, ps, f, m, d, c_vis) => true
            ExprStmt(e) => this.is_nil_expr(e)
            VarDecl(n, t, i, d, v_vis) => d.starts_with("@import:")
            Return(v) => false
            If(c, t, e) => false
            While(c, b) => false
            Block(s) => false
            Break => false
            Continue => false
            TryCatch(t, n, c, f) => false
            Throw(v) => false
            LetPattern(p, v) => false
            TypeAlias(ta_n, ta_t, ta_vis) => false
        }
    }

    fun generate(program: List<AST.Stmt>): String {
        // Register runtime functions (defined in runtime.ll, declared via runtime_declares())
        this.known_functions.push("StringBuilder")
        this.known_functions.push("__list_new")
        this.known_functions.push("__list_push")
        this.known_functions.push("__list_get")
        this.known_functions.push("__list_set")
        this.known_functions.push("__list_length")
        this.known_functions.push("__list_pop")
        this.known_functions.push("__sb_append")
        this.known_functions.push("__sb_to_string")
        this.known_functions.push("__safe_strcmp")
        this.known_functions.push("__map_new")
        this.known_functions.push("__map_set")
        this.known_functions.push("__map_get")
        this.known_functions.push("__map_has")
        this.known_functions.push("__map_keys")
        this.known_functions.push("__str_ends_with")
        this.known_functions.push("__str_get")
        this.known_functions.push("__str_split")
        this.known_functions.push("__str_replace")
        this.known_functions.push("__int_to_string")
        this.known_functions.push("__list_join")
        this.known_functions.push("__join_append")
        this.known_functions.push("__list_contains")
        // __io_println / __io_print are handled by a special case in the *call*
        // path (methods_body.sf and expr_body.sf both intercept them before
        // generic dispatch), so they were never registered here — unlike every
        // other `IO.*` entry below. That made them the only builtins invisible to
        // the module-prefixed function-reference branch in gen_expr's
        // MemberAccess handler, so `IO.println` in value position fell through to
        // a load from the nonexistent local `%IO` (BUGS #30). Registering them
        // costs nothing on the call path — the special cases run first — and
        // makes the reference path resolve them like `IO.read_file` already does.
        this.known_functions.push("__io_println")
        this.known_functions.push("__io_print")
        this.known_functions.push("__io_read_file")
        this.known_functions.push("__io_write_file")
        this.known_functions.push("__io_file_exists")
        this.known_functions.push("__io_mkdir")
        this.known_functions.push("__io_walk_dir")
        this.known_functions.push("__io_append_file")
        // See codegen.sf: these two are runtime-defined but absent from the
        // known-function set, so the bare-call path mangled them (BUGS #85).
        this.known_functions.push("__io_file_size")
        this.known_functions.push("__io_read_binary")
        this.known_functions.push("__io_is_dir")
        this.known_functions.push("__io_rename")
        this.known_functions.push("__io_delete_file")
        this.known_functions.push("__os_set_env")
        this.known_functions.push("__os_home")
        this.known_functions.push("__os_exec")
        this.known_functions.push("__os_args")
        this.known_functions.push("__os_cwd")
        this.known_functions.push("__os_path_sep")
        this.known_functions.push("__os_platform")
        this.known_functions.push("__os_env")
        this.known_functions.push("__os_system")
        this.known_functions.push("__runtime_error")
        this.known_functions.push("__runtime_error_fatal")
        this.known_functions.push("__null_pointer_error")
        this.known_functions.push("__division_error")
        // NaN-boxing helpers (declared in runtime_declares, defined in base*.ll)
        this.known_functions.push("__val_tag_int")
        this.known_functions.push("__val_untag_int")
        this.known_functions.push("__val_tag_ptr")
        this.known_functions.push("__val_tag_ptr_nullable")
        this.known_functions.push("__val_untag_ptr")
        this.known_functions.push("__val_tag_float")
        this.known_functions.push("__val_untag_float")
        this.known_functions.push("__val_tag_bool")
        this.known_functions.push("__val_untag_bool")
        this.known_functions.push("__rt_tag_ptr")
        // GC runtime functions
        this.known_functions.push("__gc_enable")
        this.known_functions.push("__gc_disable")
        this.known_functions.push("__gc_collect")
        this.known_functions.push("__gc_set_threshold")
        this.known_functions.push("__gc_stat_alloc_count")
        this.known_functions.push("__gc_stat_total_bytes")
        this.known_functions.push("__gc_stat_collections")
        this.known_functions.push("__gc_stat_freed_bytes")
        this.known_functions.push("__gc_stat_threshold")
        this.known_functions.push("__gc_debug_stats")
        this.known_functions.push("__gc_alloc")
        this.known_functions.push("__gc_alloc_zeroed")
        this.known_functions.push("__gc_realloc")
        this.known_functions.push("__gc_push_root")
        this.known_functions.push("__gc_pop_roots")
        this.known_functions.push("__gc_shadow_stack_depth")
        this.known_functions.push("__gc_list_new")
        this.known_functions.push("__gc_list_push")
        this.known_functions.push("__gc_map_new")
        this.known_functions.push("__gc_stringbuilder_new")
        this.known_functions.push("__gc_string_alloc")
        this.known_functions.push("__gc_closure_new")
        this.known_functions.push("__gc_env_alloc")
        this.known_functions.push("__gc_instance_alloc")
        this.func_ret_types.set("StringBuilder", this.str_to_type("StringBuilder"))
        // Arity for the two IO builtins reachable as values (BUGS #30). gen_func_ref
        // reads func_param_count to size the trampoline's parameter list; without an
        // entry it assumes 0 and emits `call i64 @__io_println()`, which fails to
        // verify against the 1-param declaration.
        this.func_param_count.set("__io_println", 1)
        this.func_param_count.set("__io_print", 1)

        // Pre-scan: register extension methods before compilation
        var ei: Float = 0
        while (ei < program.length()) {
            var edoc: String = this.get_fun_doc(program[ei])
            if (edoc.starts_with("@extend:")) {
                var ename: String = this.get_fun_name(program[ei])
                var ecls: String = edoc.slice(8, edoc.length())
                this.extend_map.set(this.current_prefix + ename, ecls)
            }
            ei = ei + 1
        }
        // ...and their emitted symbols, so a call lowered before the `extend fun`
        // itself resolves to the right name instead of guessing (BUGS #103).
        // Idempotent with the module-path calls in generate_with_modules_flat_opts3:
        // same key, same value, because extend_class_prefix is the single source of
        // the prefix for both.
        this.prescan_extend_symbols(program, 0, program.length(), this.current_prefix)

        // Pre-registration pass: add all declaration names to known_functions
        // BEFORE compiling any bodies, so forward references don't trigger warnings
        var pri: Float = 0
        while (pri < program.length()) {
            var pr_stmt: AST.Stmt = program[pri]
            match (pr_stmt) {
                FunDecl(pr_name, pr_params, pr_ret, pr_body, pr_doc, f_vis) => {
                    if (pr_name.length() > 0) {
                        var pr_emit: String = this.current_prefix + pr_name
                        if (!this.str_in_list(this.known_functions,pr_emit)) {
                            this.known_functions.push(pr_emit)
                        }
                        if (this.current_prefix.length() > 0 and !this.str_in_list(this.known_functions,pr_name)) {
                            this.known_functions.push(pr_name)
                        }
                        // An @extern must have its C signature registered here,
                        // not only when its own decl is lowered below. A call
                        // reached earlier in the body pass finds extern_sigs empty
                        // otherwise and emits an i64 call against, e.g., `declare
                        // double @sqrt(double)` — the BUGS #55 symbol mismatch.
                        // Codegen.generate runs this pass, not prescan_fun_decl,
                        // so the single-file path depends on this write. Idempotent
                        // with stmts_body.sf:64-69: same key, same value.
                        if (pr_doc.starts_with("@extern:")) {
                            this.extern_sigs.set(pr_emit, pr_doc.slice(8, pr_doc.length()))
                            this.extern_param_types.set(pr_emit, this.param_types_csv(pr_params))
                            if (pr_ret.length() > 0) {
                                this.func_ret_types.set(pr_emit, this.str_to_type(pr_ret))
                            }
                        }
                    }
                }
                ClassDecl(pr_cname, __tps, pr_parents, pr_fields, pr_methods, pr_doc, c_vis) => {
                    // Register the class constructor name
                    var pr_type_name: String = pr_cname
                    if (this.current_prefix.length() > 0) {
                        pr_type_name = this.current_prefix + pr_cname
                    }
                    // Assign the type tag and record the parent here, not only in
                    // gen_class_constructor / gen_class_decl_with_parents. Bodies
                    // are lowered in the pass below, in source order, so `x is Dog`
                    // inside a function declared above `class Dog` would otherwise
                    // find no tag and fall back to the always-false warning —
                    // exactly the ordering hazard that produced BUGS #33/#36/#37.
                    // Both writes are idempotent with the lowering-time ones: same
                    // key, same value.
                    if (!this.class_type_ids.has(pr_type_name)) {
                        this.class_type_ids.set(pr_type_name, this.next_class_type_id)
                        this.next_class_type_id = this.next_class_type_id + 1
                    }
                    if (pr_parents.length() > 0) {
                        // The parent's own struct name is known if it was already
                        // lowered (an imported base class); otherwise it is in this
                        // module and carries this module's prefix.
                        var pr_pstructs: String = ""
                        var pr_pall: List<String> = []
                        var pr_ppi: Float = 0
                        while (pr_ppi < pr_parents.length()) {
                            var pr_one: String = this.current_prefix + pr_parents[pr_ppi]
                            if (this.class_struct_names.has(pr_parents[pr_ppi])) {
                                pr_one = this.class_struct_names.get(pr_parents[pr_ppi])
                            }
                            pr_pall.push(pr_one)
                            if (pr_ppi == 0) { pr_pstructs = pr_one }
                            pr_ppi = pr_ppi + 1
                        }
                        // Primary base keeps its own single-valued table (field
                        // layout, `super`, __class_parent_tag); the full set is
                        // what __class_is_a and the BUGS #50 descendant search
                        // read, since neither can follow one link per class.
                        this.class_parent_of.set(pr_type_name, pr_pstructs)
                        this.class_parents_of.set(pr_type_name, pr_pall)
                    }
                    if (!this.str_in_list(this.known_functions,pr_type_name)) {
                        this.known_functions.push(pr_type_name)
                    }
                    if (!this.str_in_list(this.known_functions,pr_cname)) {
                        this.known_functions.push(pr_cname)
                    }
                    // Record the bare name for this struct and the methods it
                    // declares itself (BUGS #50 virtual dispatch), before any
                    // forwarder mixing. A bodyless method is abstract — it has no
                    // own symbol to dispatch to — so it does not count as "own".
                    this.class_bare_of.set(pr_type_name, pr_cname)
                    var pr_own: List<String> = []
                    // Register all method names as ClassName__method
                    var pr_mi: Float = 0
                    while (pr_mi < pr_methods.length()) {
                        var pr_mname: String = this.get_fun_name(pr_methods[pr_mi])
                        if (pr_mname.length() > 0) {
                            if (this.get_fun_body(pr_methods[pr_mi]).length() > 0) {
                                pr_own.push(pr_mname)
                            }
                            var pr_full: String = pr_cname + "__" + pr_mname
                            var pr_prefixed: String = this.current_prefix + pr_full
                            if (!this.str_in_list(this.known_functions,pr_full)) {
                                this.known_functions.push(pr_full)
                            }
                            if (!this.str_in_list(this.known_functions,pr_prefixed)) {
                                this.known_functions.push(pr_prefixed)
                            }
                        }
                        pr_mi = pr_mi + 1
                    }
                    this.class_own_methods.set(pr_type_name, pr_own)
                }
                EnumDecl(pr_ename, pr_variants, pr_edoc, e_vis) => {
                    // Register enum variant constructor names AND variant tags
                    // so that match expressions work regardless of declaration order
                    var pr_vnames: List<String> = []
                    var pr_vi: Float = 0
                    while (pr_vi < pr_variants.length()) {
                        var pr_vname: String = this.get_variant_name(pr_variants[pr_vi])
                        var pr_vfields: String = this.get_variant_fields(pr_variants[pr_vi])
                        if (pr_vname.length() > 0) {
                            if (!this.str_in_list(this.known_functions,pr_vname)) {
                                this.known_functions.push(pr_vname)
                            }
                            pr_vnames.push(pr_vname)
                            this.enum_variant_tags.set(pr_ename + "." + pr_vname, pr_vi)
                            this.enum_variant_fields.set(pr_ename + "." + pr_vname, pr_vfields)
                        }
                        pr_vi = pr_vi + 1
                    }
                    this.enum_defs.set(pr_ename, pr_vnames)
                }
                VarDecl(n, t, init, d, v_vis) => {}
                ExprStmt(e) => {}
                Return(v) => {}
                If(c, t, e) => {}
                While(c, b) => {}
                Block(s) => {}
                Break => {}
                Continue => {}
                TryCatch(t, n, c, f) => {}
                Throw(v) => {}
                LetPattern(p, v) => {}
                TypeAlias(ta_n, ta_t, ta_vis) => {}
            }
            pri = pri + 1
        }

        // Coroutine detection: mark functions containing yield (direct or transitive)
        this.mark_coroutines(program)

        // First pass: emit all declarations (functions, enums, classes)
        var i: Float = 0
        while (i < program.length()) {
            var stmt: AST.Stmt = program[i]
            if (this.is_decl(stmt)) {
                // Set pending_extend_class from pre-scanned map before gen_stmt
                var fn_name: String = this.get_fun_name(stmt)
                if (fn_name.length() > 0 and this.extend_map.has(this.current_prefix + fn_name)) {
                    this.pending_extend_class = this.extend_map.get(this.current_prefix + fn_name)
                } else {
                    this.pending_extend_class = ""
                }
                this.gen_stmt(stmt)
            }
            i = i + 1
        }

        // Emit reflect helper functions (only in non-identity mode)
        if (!this.identity_mode) {
            this.emit_reflect_helpers()
            // Same guard, same reason: identity mode allocates instances with
            // __sf_malloc and no GC header, so there is no tag to read and
            // __gc_get_type_tag is not even linked. gen_is_check keeps the
            // compile-time fold there. Consequence worth naming: the bootstrap
            // never exercises the runtime path, so this must be tested with a
            // user program compiled by gen3, not by ./bootstrap.sh passing.
            this.emit_class_hierarchy_helpers()
        }

        // Second pass: wrap top-level statements in __saffron_entry
        var has_top_level: Bool = false
        i = 0
        while (i < program.length()) {
            if (!this.is_decl(program[i])) {
                has_top_level = true
            }
            i = i + 1
        }
        if (has_top_level) {
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            i = 0
            while (i < program.length()) {
                if (!this.is_decl(program[i])) {
                    var stmts: List<AST.Stmt> = []
                    stmts.push(program[i])
                    this.collect_vars(stmts, top_vars, top_var_types)
                }
                i = i + 1
            }
            // Only make entry a coroutine if the top-level statements actually
            // call a coroutine function or contain yield. Merely importing a module
            // that defines coroutines (e.g. @async) should NOT force the entry to be
            // a coroutine — that causes scheduler_run() to hang when there's nothing
            // to schedule.
            var entry_is_coro: Bool = false
            var entry_stmts: List<AST.Stmt> = []
            var es_i: Float = 0
            while (es_i < program.length()) {
                if (!this.is_decl(program[es_i])) {
                    entry_stmts.push(program[es_i])
                }
                es_i = es_i + 1
            }
            if (this.stmts_have_yield(entry_stmts)) {
                entry_is_coro = true
            }
            if (!entry_is_coro) {
                var entry_calls: List<String> = []
                this.collect_calls_from_stmts(entry_stmts, entry_calls)
                var ec_i: Float = 0
                while (ec_i < entry_calls.length()) {
                    var ec: String = entry_calls[ec_i]
                    if (this.str_in_list(this.coroutine_funcs, ec) or this.str_in_list(this.coroutine_funcs, this.current_prefix + ec)) {
                        entry_is_coro = true
                        ec_i = entry_calls.length()
                    }
                    ec_i = ec_i + 1
                }
            }
            this.emit("")
            if (entry_is_coro) {
                this.is_coroutine = true
                this.emit("define ptr @__saffron_entry() optnone noinline presplitcoroutine {")
            } else {
                this.emit("define i64 @__saffron_entry() {")
            }
            this.emit("entry:")
            this.block_terminated = false
            this.reset_locals()
            this.in_function = true
            // LLVM lib: create FunctionBuilder for __saffron_entry
            if (this.use_llvm_lib and !this.identity_mode) {
                var llvm_entry_params: List<LLVMFunc.Param> = []
                this.llvm_func_builder = this.llvm_module.add_function("__saffron_entry", LLVMTypes.Type.I64, llvm_entry_params)
                var llvm_entry_bb: LLVMFunc.BasicBlock = this.llvm_func_builder.entry_block()
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_entry_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_entry_bb)
            }
            if (entry_is_coro) {
                this.emit_indent("%__coro_id = call token @llvm.coro.id(i32 0, ptr null, ptr null, ptr null)")
                this.emit_indent("%__coro_size = call i64 @llvm.coro.size.i64()")
                this.emit_indent("%__coro_mem = call ptr @__sf_malloc(i64 %__coro_size)")
                this.emit_indent("%__coro_hdl = call ptr @llvm.coro.begin(token %__coro_id, ptr %__coro_mem)")
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                if (!this.module_globals.has(this.current_prefix + top_vars[vi]) and !this.module_globals.has(top_vars[vi])) {
                    this.emit_indent("%" + this.sanitize_name(top_vars[vi]) + " = alloca i64")
                }
                vi = vi + 1
            }
            if (!this.identity_mode) {
                this.emit_indent("call void @__gc_enable()")
                vi = 0
                while (vi < top_vars.length()) {
                    var tv_type: String = top_var_types[vi]
                    if (this.is_gc_root_type(tv_type)) {
                        var tv_name: String = top_vars[vi]
                        var tv_as_int: String = ""
                        if (this.module_globals.has(this.current_prefix + tv_name)) {
                            tv_as_int = this.typed_ptr_to_val("@__g_" + this.current_prefix + this.sanitize_name(tv_name), "i64*")
                        } else {
                            tv_as_int = this.typed_ptr_to_val("%" + this.sanitize_name(tv_name), "i64*")
                        }
                        this.emit_indent("call void @__gc_push_root(i64 " + tv_as_int + ")")
                    }
                    vi = vi + 1
                }
            }
            // Call module init functions before user code
            var mi2: Float = 0
            while (mi2 < this.module_init_names.length()) {
                this.emit_indent("call i64 @" + this.module_init_names[mi2] + "()")
                mi2 = mi2 + 1
            }
            i = 0
            while (i < program.length()) {
                if (!this.is_decl(program[i])) {
                    this.gen_stmt(program[i])
                }
                i = i + 1
            }
            // Epilogue
            if (entry_is_coro) {
                if (!this.block_terminated) {
                    this.emit_terminator("br label %__coro_final")
                }
                this.emit("__coro_final:")
                this.block_terminated = false
                this.emit_indent("%__coro_fs_tok = call token @llvm.coro.save(ptr %__coro_hdl)")
                this.emit_indent("%__coro_fs = call i8 @llvm.coro.suspend(token %__coro_fs_tok, i1 true)")
                this.emit_indent("switch i8 %__coro_fs, label %__coro_suspend [i8 0, label %__coro_trap i8 1, label %__coro_cleanup]")
                this.emit("__coro_trap:")
                this.block_terminated = false
                this.emit_terminator("unreachable")
                this.emit("__coro_cleanup:")
                this.block_terminated = false
                this.emit_indent("%__coro_free = call ptr @llvm.coro.free(token %__coro_id, ptr %__coro_hdl)")
                this.emit_indent("call void @free(ptr %__coro_free)")
                this.emit_terminator("br label %__coro_suspend")
                this.emit("__coro_suspend:")
                this.block_terminated = false
                this.emit_indent("call i1 @llvm.coro.end(ptr %__coro_hdl, i1 false)")
                this.emit_terminator("ret ptr %__coro_hdl")
                this.is_coroutine = false
            } else {
                if (!this.block_terminated) {
                    this.emit_terminator("ret i64 0")
                }
            }
            this.emit("}")
            this.block_terminated = false
            this.in_function = false
        }

        // Build final output with proper ordering
        var out: StringBuilder = StringBuilder()
        out.append("; Generated by Saffron LLVM compiler\n")
        if (this.target == "wasm32" or this.target == "wasm") {
            out.append("target triple = \"wasm32-unknown-unknown\"\n")
            out.append("target datalayout = \"e-m:e-p:32:32-i64:64-n32:64-S128\"\n\n")
        } else if (this.target == "wasm64") {
            out.append("target triple = \"wasm64-unknown-unknown\"\n")
            out.append("target datalayout = \"e-m:e-p:64:64-i64:64-n32:64-S128-ni:1:10:20\"\n\n")
        } else {
            out.append("target triple = \"arm64-apple-macosx15.0.0\"\n\n")
        }

        // String constants
        var j: Float = 0
        while (j < this.string_constants.length()) {
            var s: String = this.string_constants[j]
            var name: String = "@.str." + j.floor().to_string()
            var len: Float = s.length() + 1
            out.append(name + " = private unnamed_addr constant [" + len.to_string() + " x i8] c\"" + this.escape_llvm_string(s) + "\\00\"\n")
            j = j + 1
        }
        if (this.string_constants.length() > 0) {
            out.append("\n")
        }

        // Type definitions (enums as tagged unions)
        var td: String = this.type_defs.to_string()
        if (td.length() > 0) {
            out.append(td)
            out.append("\n")
        }

        // External declarations
        out.append("declare i32 @puts(i8*)\n")
        out.append("declare i32 @printf(i8*, ...)\n")
        out.append("declare i32 @snprintf(i8*, i64, i8*, ...)\n")
        out.append("declare i8* @malloc(i64)\n")
        out.append("declare i8* @realloc(i8*, i64)\n")
        out.append("declare void @free(i8*)\n")
        out.append("declare i64 @strlen(i8*)\n")
        out.append("declare i8* @strcpy(i8*, i8*)\n")
        out.append("declare i8* @strcat(i8*, i8*)\n")
        out.append("declare i8* @strstr(i8*, i8*)\n")
        out.append("declare i32 @strcmp(i8*, i8*)\n")
        out.append("declare i32 @strncmp(i8*, i8*, i64)\n")
        out.append("declare i64 @atol(i8*)\n")
        out.append("declare void @exit(i32)\n")
        out.append("declare i8* @fopen(i8*, i8*)\n")
        out.append("declare i64 @fread(i8*, i64, i64, i8*)\n")
        out.append("declare i64 @fwrite(i8*, i64, i64, i8*)\n")
        out.append("declare i32 @fclose(i8*)\n")
        out.append("declare i32 @fseek(i8*, i64, i32)\n")
        out.append("declare i64 @ftell(i8*)\n")
        out.append("declare i8* @strtok(i8*, i8*)\n")
        out.append("declare i32 @pclose(i8*)\n")
        out.append("declare i8* @popen(i8*, i8*)\n")
        out.append("declare i8* @fgets(i8*, i32, i8*)\n")
        out.append("declare void @llvm.memcpy.p0i8.p0i8.i64(i8*, i8*, i64, i1)\n")
        out.append("declare i32 @setjmp(i8*) returns_twice\n")
        out.append("declare void @longjmp(i8*, i32) noreturn\n")
        out.append("declare void @__io_println_str(i64)\n")
        out.append("declare void @__io_println_int(i64)\n")
        out.append("declare void @__io_println_bool(i64)\n")
        out.append("declare void @__io_println_nil()\n")
        out.append("declare void @__io_println_any(i64)\n")
        out.append("declare void @__io_print_str(i64)\n")
        out.append("declare void @__io_print_int(i64)\n")
        out.append("declare i64 @__any_to_string(i64)\n")
        out.append("declare i64 @__bool_to_string(i64)\n")
        out.append("declare i64 @__nil_to_string()\n\n")
        out.append("declare i64 @__float_to_string(i64)\n")
        out.append("declare i64 @__string_eq(i64, i64)\n")
        out.append("declare i64 @__string_ne(i64, i64)\n")
        out.append("declare i64 @__any_eq(i64, i64)\n")
        out.append("declare i64 @__any_ne(i64, i64)\n")
        out.append("declare i64 @__string_intern(i64)\n")
        if (!this.identity_mode) {
            out.append("; --- NaN-boxing value helpers ---\n")
            out.append("declare i64 @__val_tag_int(i64)\n")
            out.append("declare i64 @__val_untag_int(i64)\n")
            out.append("declare i64 @__val_tag_ptr(i8*)\n")
            out.append("declare i64 @__val_tag_ptr_nullable(i8*)\n")
            out.append("declare i8* @__val_untag_ptr(i64)\n")
            out.append("declare i64 @__val_tag_float(double)\n")
            out.append("declare double @__val_untag_float(i64)\n")
            out.append("declare i64 @__val_tag_bool(i64)\n")
            out.append("declare i64 @__val_untag_bool(i64)\n")
        }
        // Always declared, even in identity mode. The tag/untag helpers above
        // are no-ops there and so are elided, but __rt_tag_ptr is the explicit
        // boundary out of identity mode: runtime.sf is compiled with
        // --identity-mode and calls it to hand tagged values back to value
        // space. Omitting the declare left gen4 unable to link.
        out.append("declare i64 @__rt_tag_ptr(i64)\n")
        out.append("declare double @strtod(i8*, i8*)\n")
        out.append("declare double @llvm.floor.f64(double)\n\n")

        // Runtime error helpers (bodies in runtime.ll)
        if (!this.str_in_list(this.defined_funcs,"__runtime_error")) {
            out.append("declare i64 @__division_error()\n")
            out.append("declare i64 @__null_pointer_error()\n")
            out.append("declare i64 @__runtime_error(i64)\n")
            out.append("declare i64 @__runtime_error_fatal(i64)\n\n")
        }

        // Runtime string constants (linkonce_odr for multi-file linking)
        out.append("@.fmt.ld = linkonce_odr unnamed_addr constant [4 x i8] c\"%ld\\00\"\n")
        out.append("@.str.empty = linkonce_odr unnamed_addr constant [1 x i8] c\"\\00\"\n")
        out.append("@.str.rb = linkonce_odr unnamed_addr constant [2 x i8] c\"r\\00\"\n")
        out.append("@.str.wb = linkonce_odr unnamed_addr constant [2 x i8] c\"w\\00\"\n")
        out.append("@.str.r = linkonce_odr unnamed_addr constant [2 x i8] c\"r\\00\"\n")

        // Global argc/argv (set by main) — weak linkage for multi-file
        out.append("@__argc = weak global i32 0\n")
        out.append("@__argv = weak global i8** null\n")
        // Exception handling globals
        out.append("@__exception_value = weak global i64 0\n")
        out.append("@__jmp_buf_current = weak global i8* null\n\n")

        // Struct types + runtime function declarations (bodies in runtime.ll)
        out.append("; List = { count, capacity, data* }\n")
        out.append("%List = type { i64, i64, i64* }\n")
        out.append("; Map = { count, capacity, keys*, values* }\n")
        out.append("%Map = type { i64, i64, i64*, i64* }\n\n")
        out.append(this.runtime_declares())
        var ext_keys: List<String> = this.extern_sigs.keys()
        var ei: Float = 0
        var out_so_far: String = out.to_string()
        var extern_c_names: List<String> = []
        while (ei < ext_keys.length()) {
            var decl: String = this.emit_extern_declare(this.extern_sigs.get(ext_keys[ei]))
            var parsed_ext: List<String> = this.parse_extern_sig(this.extern_sigs.get(ext_keys[ei]))
            var c_fn_name: String = parsed_ext[0]
            extern_c_names.push(c_fn_name)
            if (!out_so_far.contains("@" + c_fn_name + "(")) {
                out.append(decl + "\n")
            }
            ei = ei + 1
        }

        // Lambda functions
        var k: Float = 0
        while (k < this.globals.length()) {
            out.append(this.globals[k])
            k = k + 1
        }

        // Function bodies
        out.append(this.sb.to_string())

        // Emit declares for external functions (called but not defined in this file)
        var declared: List<String> = []
        var ci: Float = 0
        while (ci < this.called_functions.length()) {
            var cfname: String = this.called_functions[ci]
            if (!this.str_in_list(this.known_functions,cfname) and !this.str_in_list(declared,cfname) and !this.str_in_list(this.defined_funcs,cfname) and !this.str_in_list(extern_c_names,cfname)) {
                var arity: Float = 1
                if (this.called_function_arity.has(cfname)) {
                    arity = this.called_function_arity.get(cfname)
                }
                var param_str: String = ""
                var pi: Float = 0
                while (pi < arity) {
                    if (pi > 0) { param_str = param_str + ", " }
                    param_str = param_str + "i64"
                    pi = pi + 1
                }
                out.append("declare i64 @" + cfname + "(" + param_str + ")\n")
                declared.push(cfname)
            }
            ci = ci + 1
        }
        if (declared.length() > 0) {
            out.append("\n")
        }

        // On WASM, `_start` lives in wasm_base*.ll and calls `i64 @__saffron_entry()`.
        // That signature is wrong as soon as the program uses async: an entry point
        // containing a suspend point is emitted as `ptr @__saffron_entry()
        // presharedcoroutine`, returning a coroutine frame rather than a value. The
        // mismatch links (wasm-ld only warns) and then traps at the call.
        //
        // So emit a boot shim with the name `_start` expects, which starts the entry
        // coroutine and hands its frame to the scheduler instead of treating it as a
        // result. The browser cannot then block in `scheduler_run`, so this only
        // enqueues; the JS glue drives progress by calling the exported
        // `__sched_pump` from the host event loop. This is the async-in-the-browser
        // handoff point.
        // `__saffron_boot` is emitted for every WASM build, coroutine entry or not, so
        // `_start` has exactly one definition to call and the base needs no
        // weak-linkage fallback whose body would carry the wrong signature anyway.
        //
        // The guard must match the native `main` wrapper's below, i.e. it must
        // include the `__saffron_main`-but-no-top-level case. It did not, and the
        // consequence was total silence rather than a link error: a file whose
        // whole contents are `fun main() { ... }` has no top-level statements, so
        // no shim was emitted, and `--import-undefined` (tools/saffron's wasm32
        // link line) turned `_start`'s call to the now-missing `@__saffron_boot`
        // into a no-op HOST IMPORT. The module built, ran, and did nothing —
        // BUGS #110. The two branches are one screen apart and had drifted.
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            if (this.str_in_list(this.defined_funcs,"__saffron_main") or has_top_level) {
                out.append("\ndefine i64 @__saffron_boot() {\n")
                out.append("entry:\n")
                if (has_top_level) {
                    // entry_is_coro is only assigned inside the has_top_level
                    // block above, so it may only be READ under this same guard.
                    if (entry_is_coro) {
                        out.append("  %__entry_hdl = call ptr @__saffron_entry()\n")
                        out.append("  %__entry_i64 = ptrtoint ptr %__entry_hdl to i64\n")
                        out.append("  %__entry_done = call i64 @__sched_coro_done(i64 %__entry_i64)\n")
                        out.append("  %__entry_is_done = icmp eq i64 %__entry_done, 1\n")
                        out.append("  br i1 %__entry_is_done, label %__entry_skip, label %__entry_run\n")
                        out.append("__entry_run:\n")
                        out.append("  call i64 @stdlib_scheduler_enqueue(i64 %__entry_i64)\n")
                        out.append("  br label %__entry_skip\n")
                        out.append("__entry_skip:\n")
                        out.append("  ret i64 0\n")
                    } else {
                        out.append("  %__entry_ret = call i64 @__saffron_entry()\n")
                        out.append("  ret i64 %__entry_ret\n")
                    }
                } else {
                    // `main` with no top-level code. There is NO __saffron_entry
                    // in this module at all (it is only emitted under
                    // has_top_level), so the shim must call __saffron_main —
                    // calling __saffron_entry here would reintroduce exactly the
                    // undefined-symbol-becomes-silent-import failure this fixes.
                    //
                    // Module inits are emitted here for the same reason the
                    // native wrapper emits them in this case: when has_top_level
                    // they run inside __saffron_entry, and with no entry there is
                    // nowhere else for them to run.
                    var mi4: Float = 0
                    while (mi4 < this.module_init_names.length()) {
                        out.append("  call i64 @" + this.module_init_names[mi4] + "()\n")
                        mi4 = mi4 + 1
                    }
                    if (this.str_in_list(this.coroutine_funcs,"__saffron_main")) {
                        // async main: __saffron_main is `ptr ()
                        // presplitcoroutine`, so it must be called through a ptr
                        // signature and its frame handed to the scheduler, never
                        // treated as an i64 result.
                        //
                        // Enqueue only, no scheduler_run — same as the wasm
                        // top-level coroutine arm above and deliberately unlike
                        // native: the host event loop cannot be blocked, so the
                        // JS glue drives progress via the exported __sched_pump.
                        out.append("  %__main_hdl = call ptr @__saffron_main()\n")
                        out.append("  %__main_i64 = ptrtoint ptr %__main_hdl to i64\n")
                        out.append("  %__main_done = call i64 @__sched_coro_done(i64 %__main_i64)\n")
                        out.append("  %__main_is_done = icmp eq i64 %__main_done, 1\n")
                        out.append("  br i1 %__main_is_done, label %__main_skip, label %__main_run\n")
                        out.append("__main_run:\n")
                        out.append("  call i64 @stdlib_scheduler_enqueue(i64 %__main_i64)\n")
                        out.append("  br label %__main_skip\n")
                        out.append("__main_skip:\n")
                        out.append("  ret i64 0\n")
                    } else {
                        out.append("  %__main_ret = call i64 @__saffron_main()\n")
                        out.append("  ret i64 %__main_ret\n")
                    }
                }
                out.append("}\n")
            }
        }

        // Only emit C main wrapper for native targets (not WASM).
        // For WASM, _start is provided by wasm_base.ll / wasm_base_32.ll and calls __saffron_entry.
        if (this.target != "wasm" and this.target != "wasm64" and this.target != "wasm32") {
            if (this.str_in_list(this.defined_funcs,"__saffron_main") or has_top_level) {
                out.append("\ndefine i32 @main(i32 %argc, i8** %argv) {\n")
                out.append("entry:\n")
                out.append("  store i32 %argc, i32* @__argc\n")
                out.append("  store i8** %argv, i8*** @__argv\n")
                if (has_top_level and entry_is_coro) {
                    // Async main: entry is a coroutine — enqueue and run scheduler
                    var enqueue_fn: String = "stdlib_scheduler_enqueue"
                    if (this.str_in_list(this.known_functions,"stdlib_scheduler_enqueue")) {
                        enqueue_fn = "stdlib_scheduler_enqueue"
                    }
                    var sched_fn: String = "stdlib_scheduler_scheduler_run"
                    if (this.str_in_list(this.known_functions,"stdlib_scheduler_scheduler_run")) {
                        sched_fn = "stdlib_scheduler_scheduler_run"
                    }
                    out.append("  %__entry_hdl = call ptr @__saffron_entry()\n")
                    out.append("  %__entry_i64 = ptrtoint ptr %__entry_hdl to i64\n")
                    out.append("  %__entry_done = call i64 @__sched_coro_done(i64 %__entry_i64)\n")
                    out.append("  %__entry_is_done = icmp eq i64 %__entry_done, 1\n")
                    out.append("  br i1 %__entry_is_done, label %__entry_skip, label %__entry_run\n")
                    out.append("__entry_run:\n")
                    out.append("  call i64 @" + enqueue_fn + "(i64 %__entry_i64)\n")
                    out.append("  call i64 @" + sched_fn + "()\n")
                    out.append("  br label %__entry_skip\n")
                    out.append("__entry_skip:\n")
                    out.append("  ret i32 0\n")
                } else if (has_top_level) {
                    out.append("  call i64 @__saffron_entry()\n")
                    out.append("  ret i32 0\n")
                } else {
                    // Call module init functions before __saffron_main
                    // (when has_top_level is true, inits are called inside __saffron_entry)
                    var mi3: Float = 0
                    while (mi3 < this.module_init_names.length()) {
                        out.append("  call i64 @" + this.module_init_names[mi3] + "()\n")
                        mi3 = mi3 + 1
                    }
                    if (this.str_in_list(this.coroutine_funcs,"__saffron_main")) {
                        // Async main: __saffron_main is a coroutine — enqueue and run scheduler
                        var enqueue_fn2: String = "stdlib_scheduler_enqueue"
                        if (this.str_in_list(this.known_functions,"stdlib_scheduler_enqueue")) {
                            enqueue_fn2 = "stdlib_scheduler_enqueue"
                        }
                        var sched_fn2: String = "stdlib_scheduler_scheduler_run"
                        if (this.str_in_list(this.known_functions,"stdlib_scheduler_scheduler_run")) {
                            sched_fn2 = "stdlib_scheduler_scheduler_run"
                        }
                        out.append("  %__main_hdl = call ptr @__saffron_main()\n")
                        out.append("  %__main_i64 = ptrtoint ptr %__main_hdl to i64\n")
                        out.append("  call i64 @" + enqueue_fn2 + "(i64 %__main_i64)\n")
                        out.append("  call i64 @" + sched_fn2 + "()\n")
                        out.append("  ret i32 0\n")
                    } else {
                        out.append("  %main_ret = call i64 @__saffron_main()\n")
                        out.append("  %exit_code = trunc i64 %main_ret to i32\n")
                        out.append("  ret i32 %exit_code\n")
                    }
                }
                out.append("}\n")
            }
        }

        // --- LLVM lib output ---
        // When emit_llvm_lib is set, return the LLVM Module IR instead of string emission.
        // This is activated by --emit-llvm-lib and produces structured IR from the
        // parallel LLVM Module that was built alongside string emission.
        if (this.emit_llvm_lib and this.use_llvm_lib and !this.identity_mode) {
            return this.llvm_module.emit_ir()
        }

        // --- LLVM lib verification (when not emitting as primary) ---
        // LLVM lib parallel validation (disabled — was causing pantry build to fail
        // because stdout output made Process.run think there was an error)
        // if (this.use_llvm_lib and !this.identity_mode and !this.emit_llvm_lib) {
        //     var llvm_ir_check: String = this.llvm_module.emit_ir()
        // }

        return out.to_string()
    }

    // @codegen-split: methods

    // @codegen-split: methods
    fun find_class_for_method(method: String): String {
    var keys: List<String> = this.class_methods.keys()
    var i: Float = 0
    var interface_fallback: String = ""
    while (i < keys.length()) {
        var class_name: String = keys[i]
        var methods: List = this.class_methods.get(class_name)
        if (methods.contains(method)) {
            // Skip built-in types (String, List, Map, etc.) that are registered
            // in class_methods but not in class_fields. Their methods are handled
            // by builtin method dispatch, not class method dispatch.
            if (!this.class_fields.has(class_name)) {
                i = i + 1
                continue
            }
            // Skip interfaces (classes with no fields) — prefer concrete classes.
            // Interfaces have empty class_fields and register stub methods.
            var cf: String = this.class_fields.get(class_name)
            if (cf.length() == 0) {
                // Could be an interface — save as fallback, keep searching
                if (interface_fallback.length() == 0) {
                    interface_fallback = class_name
                }
            } else {
                return class_name
            }
        }
        i = i + 1
    }
    return interface_fallback
    }

    fun get_method_ret(class_name: String, method: String): String {
    // All functions return i64 (no void) to avoid call type mismatches
    return "i64"
    }

    fun classify_expr(expr: AST.Expr): String {
    return match (expr) {
        MethodCall(o, m, a) => "method_call"
        ListLit(e) => "list_lit"
        IndexGet(o, i) => "index_get"
        IndexSet(o, i, v) => "index_set"
        MapLit => "map_lit"
        StringLit(s) => "string"
        IntLit(v) => "int"
        FloatLit(v) => "float"
        BoolLit(v) => "bool"
        Variable(n) => "variable"
        Ref(rk, rn, rs) => "variable"
        Binary(l, o, r) => "binary"
        Unary(o, r) => "unary"
        Call(c, a) => "call"
        Assign(n, v) => "assign"
        Logical(l, o, r) => "logical"
        MemberAccess(o, f) => "member"
        NilLit => "nil"
        Match(s, a) => "match_expr"
        EnumConstruct(e, v, a) => "enum"
        Lambda(p, r, b) => "lambda"
        GetField(o, f) => "get_field"
        SetField(o, f, v) => "set_field"
        This => "this"
        BlockExpr(s, v) => "block_expr"
        IsCheck(val, t) => "is_check"
        IfExpr(c, tb, tv, eb, ev) => "if_expr"
        TryExpr(tb, tv, cn, cb, cv) => "try_expr"
        Yield(v) => "yield"\
        TupleLit(e) => "tuple_lit"
    }
    }

    fun get_variable_name(expr: AST.Expr): String {
    // The 28 arms that used to follow, all returning "", are the `_` arm: only a
    // name-shaped expression has a name. Written out by hand they were also
    // wrong — the closing brace sat on the same line as the last arm, and the
    // result was bound as `Any`, so the declared String return type was never
    // actually checked (BUGS #76).
    return match (expr) {
        Variable(n) => n
        Ref(rk, rn, rs) => rn
        _ => ""
    }
    }

    fun get_string_literal(expr: AST.Expr): String {
        return match (expr) {
            StringLit(s) => s
            _ => ""
        }
    }

    fun get_expr_type(expr: AST.Expr): String {
    var ek: String = this.classify_expr(expr)
    if (ek == "variable") {
        var vname: String = this.get_variable_name(expr)
        if (vname.length() > 0 and this.typed_vars.has(vname)) {
            var vt: String = this.type_to_string(this.typed_vars.get(vname))
            // In identity mode, Float and Int are both i64 — treat Float as Int
            if (this.identity_mode and vt == "Float") { return "Int" }
            return vt
        }
        return "Any"
    }
    if (ek == "string") return "String"
    if (ek == "int") return "Int"
    if (ek == "float") {
        if (this.identity_mode) { return "Int" }
        return "Float"
    }
    if (ek == "bool") return "Bool"
    if (ek == "nil") return "Nil"
    if (ek == "list_lit") {
        var list_elems: List<AST.Expr> = match (expr) { ListLit(e) => e   _ => [] }
        if (list_elems.length() > 0) {
            var first_type: String = this.get_expr_type(list_elems[0])
            if (first_type == "String") return "List<String>"
            if (first_type == "Int" or first_type == "Float") return "List<Int>"
        }
        return "List<Any>"
    }
    if (ek == "tuple_lit") {
        var tuple_elems: List<AST.Expr> = match (expr) { TupleLit(e) => e   _ => [] }
        var tuple_str: String = "Tuple<"
        var ti: Float = 0
        while (ti < tuple_elems.length()) {
            if (ti > 0) { tuple_str = tuple_str + "," }
            tuple_str = tuple_str + this.get_expr_type(tuple_elems[ti])
            ti = ti + 1
        }
        tuple_str = tuple_str + ">"
        return tuple_str
    }
    if (ek == "map_lit") return "Map<String,String>"
    if (ek == "this") return this.current_class
    if (ek == "get_field" or ek == "member") {
        var gf_inner_obj: AST.Expr = match (expr) {
            GetField(o, f) => o
            MemberAccess(o, f) => o
            _ => AST.Expr.NilLit
        }
        var gf_field: String = match (expr) {
            GetField(o, f) => f
            MemberAccess(o, f) => f
            _ => ""
        }
        var gf_obj_name: String = this.get_variable_name(gf_inner_obj)
        var gf_class: String = ""
        if (this.classify_expr(gf_inner_obj) == "this") {
            gf_class = this.current_class
        } else if (gf_obj_name.length() > 0) {
            gf_class = this.get_var_type_str(gf_obj_name)
        }
        // Tuple field access: t._0, t._1 etc.
        if (gf_class.starts_with("Tuple<") and gf_field.starts_with("_")) {
            return this.get_field_type(gf_class, gf_field)
        }
        var gf_resolved: String = this.resolve_class_type(gf_class)
        if (gf_resolved.length() > 0) {
            return this.get_field_type(gf_resolved, gf_field)
        }
    }
    if (ek == "method_call") {
        var mc_method: String = match (expr) {
            MethodCall(o, m, a) => m
            _ => ""
        }
        var mc_obj: AST.Expr = match (expr) {
            MethodCall(o, m, a) => o
            _ => AST.Expr.NilLit
        }
        // Check if method call is on a user class (resolve obj type)
        var mc_obj_name: String = this.get_variable_name(mc_obj)
        var mc_obj_type: String = ""
        if (mc_obj_name.length() > 0) {
            mc_obj_type = this.get_var_type_str(mc_obj_name)
        }
        // Fallback: if receiver is a complex expression (e.g. another method call),
        // recursively infer its type
        if (mc_obj_type.length() == 0 and mc_obj_name.length() == 0) {
            var mc_obj_kind: String = this.classify_expr(mc_obj)
            if (mc_obj_kind == "method_call" or mc_obj_kind == "call" or mc_obj_kind == "index_get") {
                mc_obj_type = this.get_expr_type(mc_obj)
            }
        }
        if (mc_obj_type.length() == 0 and this.classify_expr(mc_obj) == "this") {
            mc_obj_type = this.current_class
        } else if (this.classify_expr(mc_obj) == "get_field" or this.classify_expr(mc_obj) == "member") {
            // Handle chained field access: this.field.method()
            var inner_obj: AST.Expr = match (mc_obj) {
                GetField(o, f) => o
                MemberAccess(o, f) => o
                _ => AST.Expr.NilLit
            }
            var inner_field: String = match (mc_obj) {
                GetField(o, f) => f
                MemberAccess(o, f) => f
                _ => ""
            }
            var inner_class: String = ""
            if (this.classify_expr(inner_obj) == "this") {
                inner_class = this.current_class
            } else {
                var in_name: String = this.get_variable_name(inner_obj)
                if (in_name.length() > 0) {
                    inner_class = this.get_var_type_str(in_name)
                }
            }
            var inner_resolved: String = this.resolve_class_type(inner_class)
            if (inner_resolved.length() > 0) {
                mc_obj_type = this.get_field_type(inner_resolved, inner_field)
            }
        }
        // If object is a user class, look up method return type
        var mc_resolved: String = this.resolve_class_type(mc_obj_type)
        if (mc_resolved.length() > 0) {
            var full_mc: String = mc_resolved + "__" + mc_method
            if (this.func_ret_types.has(full_mc)) {
                return this.type_to_string(this.func_ret_types.get(full_mc))
            }
        }
        // Also check with prefix for user class methods
        if (mc_obj_type.length() > 0) {
            var prefixed_mc: String = this.current_prefix + mc_obj_type + "__" + mc_method
            if (this.func_ret_types.has(prefixed_mc)) {
                return this.type_to_string(this.func_ret_types.get(prefixed_mc))
            }
        }
        if (mc_method == "length" or mc_method == "index_of" or mc_method == "to_number") return "Int"
        if (mc_method == "slice") {
            if (mc_obj_type.starts_with("List")) { return mc_obj_type }
            if (mc_obj_type == "String") { return "String" }
            // Unknown receiver: don't claim String. `slice` is defined on both
            // List and String, so on an unannotated value we cannot say which.
            // Claiming String let a sliced list be handed to string-typed code.
            return "Any"
        }
        if (mc_method == "to_string" or mc_method == "join" or mc_method == "trim" or mc_method == "to_upper" or mc_method == "to_lower" or mc_method == "repeat" or mc_method == "replace" or mc_method == "char_at") return "String"
        if (mc_method == "split") return "List<String>"
        // Map.keys()/values() element type comes from the Map<K, V> annotation.
        // Hardcoding List<String> made `for (v in m.values())` on a
        // Map<String,Int> treat every Int as a string pointer and SEGFAULT.
        if (mc_method == "keys") {
            if (mc_obj_type.starts_with("Map<")) {
                return "List<" + this.get_map_key_type(mc_obj_type) + ">"
            }
            return "List<Any>"
        }
        if (mc_method == "values") {
            if (mc_obj_type.starts_with("Map<")) {
                return "List<" + this.get_map_value_type(mc_obj_type) + ">"
            }
            return "List<Any>"
        }
        if (mc_method == "has" or mc_method == "contains" or mc_method == "starts_with" or mc_method == "ends_with" or mc_method == "is_upper" or mc_method == "is_lower") return "Bool"
        if (mc_method == "get") {
            // Infer return type from Map<K, V> annotation rather than always "String"
            var mc_map_type: String = mc_obj_type
            if (mc_map_type.starts_with("Map<")) {
                return this.get_map_value_type(mc_map_type)
            }
            // Unannotated map: Any, not String (BUGS #37). Claiming String made
            // `var arr = m.get(k)` then `arr.push(x)` fall through to a silent
            // return "0" emitting no call. See the matching site in the runtime
            // dispatch arm of gen_method_call. Annotated Map<K, V> still narrows
            // to V above, so this only widens what was already unknown.
            return "Any"
        }
        if (mc_method == "pop") {
            // Infer return type from List<T> element type
            if (mc_obj_type.starts_with("List<") and mc_obj_type.ends_with(">")) {
                var pop_inner: String = mc_obj_type.slice(5, mc_obj_type.length() - 1)
                return pop_inner
            }
            return "Int"
        }
        // reverse/copy/sort return the same list type as the receiver
        if (mc_method == "reverse" or mc_method == "copy" or mc_method == "sort") {
            if (mc_obj_type.starts_with("List")) { return mc_obj_type }
            return "List<Any>"
        }
    }
    if (ek == "call") {
        var call_callee: AST.Expr = match (expr) {
            Call(c, a) => c
            x => AST.Expr.NilLit
        }
        var callee_name: String = this.resolve_callee(call_callee)
        if (this.func_ret_types.has(callee_name)) {
            return this.type_to_string(this.func_ret_types.get(callee_name))
        }
        if (callee_name.contains(".")) {
            var cp: List<String> = callee_name.split(".")
            if (cp.length() >= 2 and this.module_prefixes.has(cp[0])) {
                var resolved_name: String = this.module_prefixes.get(cp[0]) + cp[1]
                if (this.func_ret_types.has(resolved_name)) {
                    return this.type_to_string(this.func_ret_types.get(resolved_name))
                }
            }
        }
    }
    if (ek == "is_check") return "Bool"
    if (ek == "binary") {
        var bin_op: String = match (expr) { Binary(l, o, r) => o   _ => "" }
        if (bin_op == "<" or bin_op == ">" or bin_op == "<=" or bin_op == ">=" or bin_op == "==" or bin_op == "!=") return "Bool"
        if (bin_op == "and" or bin_op == "or") return "Bool"
        if (bin_op == "&" or bin_op == "|" or bin_op == "^" or bin_op == "<<" or bin_op == ">>") return "Int"
        var bin_left: AST.Expr = match (expr) { Binary(l, o, r) => l   _ => AST.Expr.NilLit }
        var bin_right: AST.Expr = match (expr) { Binary(l, o, r) => r   _ => AST.Expr.NilLit }
        var left_t: String = this.get_expr_type(bin_left)
        var right_t: String = this.get_expr_type(bin_right)
        if (bin_op == "+" and (left_t == "String" or right_t == "String")) return "String"
        if (left_t == "Float" or right_t == "Float") return "Float"
        return "Int"
    }
    if (ek == "logical") return "Bool"
    if (ek == "unary") {
        var unary_op: String = match (expr) { Unary(o, r) => o   _ => "" }
        if (unary_op == "!") return "Bool"
        var unary_inner: AST.Expr = match (expr) { Unary(o, r) => r   _ => AST.Expr.NilLit }
        return this.get_expr_type(unary_inner)
    }
    if (ek == "assign") return "Any"
    if (ek == "lambda") return "Fun"
    if (ek == "enum") return "Any"
    if (ek == "match_expr") {
        var match_arms: List<AST.MatchArm> = match (expr) { Match(s, a) => a   _ => [] }
        if (match_arms.length() > 0) {
            var first_arm: AST.MatchArm = match_arms[0]
            var arm_body: AST.Expr = match (first_arm) { Arm(p, b) => b   _ => AST.Expr.NilLit }
            return this.get_expr_type(arm_body)
        }
        return "Any"
    }
    if (ek == "block_expr") {
        var block_value: AST.Expr = match (expr) { BlockExpr(s, v) => v   _ => AST.Expr.NilLit }
        return this.get_expr_type(block_value)
    }
    if (ek == "index_get") {
        var ig_obj: AST.Expr = match (expr) { IndexGet(o, i) => o   _ => AST.Expr.NilLit }
        var ig_obj_name: String = this.get_variable_name(ig_obj)
        if (ig_obj_name.length() > 0 and this.typed_vars.has(ig_obj_name)) {
            var ig_list_type: AST.Type = this.typed_vars.get(ig_obj_name)
            var ig_elem: AST.Type = this.get_list_element_type(ig_list_type)
            if (this.type_to_string(ig_elem) != "Any") {
                return this.type_to_string(ig_elem)
            }
            // Fallback: parse type string for List<X> pattern
            var ig_vtype: String = this.type_to_string(ig_list_type)
            if (ig_vtype.starts_with("List<") and ig_vtype.ends_with(">")) {
                return ig_vtype.slice(5, ig_vtype.length() - 1)
            }
        }
        return "Any"
    }
    if (ek == "index_set") return "Any"
    if (ek == "set_field") return "Any"
    return "Any"
    }

    fun gen_list_lit(elements: List<AST.Expr>): String {
    var list_val: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(list_val, "i64", "__list_new", ""))
    } else {
        this.emit_indent(list_val + " = call i64 @__list_new()")
    }
    var elem_type: AST.Type = AST.Type.AnyType
    var i: Float = 0
    while (i < elements.length()) {
        if (i == 0) {
            var ft: String = this.get_expr_type(elements[0])
            if (ft == "String") { elem_type = AST.Type.StringType }
            else if (ft == "Int" or ft == "Float") { elem_type = AST.Type.IntType }
        }
        var elem: String = this.gen_arg_value(elements[i])
        var discard_lp: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(discard_lp, "i64", "__list_push", "i64 " + list_val + ", i64 " + elem))
        } else {
            this.emit_indent(discard_lp + " = call i64 @__list_push(i64 " + list_val + ", i64 " + elem + ")")
        }
        i = i + 1
    }
    this.last_type = this.make_generic_type("List", [elem_type])
    return list_val
    }

    fun gen_index_get(object: AST.Expr, index: AST.Expr): String {
    var obj_name: String = this.get_variable_name(object)
    // Block tuple indexing: must use ._0, ._1 etc.
    if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
        var ig_ttype: String = this.type_to_string(this.typed_vars.get(obj_name))
        if (ig_ttype.starts_with("Tuple<")) {
            IO.println("[codegen] Error: use ._0, ._1 etc. to access tuple fields (not indexing)")
        }
    }
    // Map indexing: map["key"] → __map_get(map, key)
    if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
        var ig_otype: String = this.type_to_string(this.typed_vars.get(obj_name))
        if (ig_otype.starts_with("Map")) {
            var map_obj: String = this.gen_arg_value(object)
            // Key passed through NaN-boxed, NOT untagged — see Map.set. The
            // runtime's __map_key_cmp reads the tag to tell string keys from
            // numeric ones; untagging here destroyed that discriminator.
            var key_raw: String = this.gen_arg_value(index)
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__map_get(i64 " + map_obj + ", i64 " + key_raw + ")")
            if (ig_otype.starts_with("Map<")) {
                var val_type_str: String = this.get_map_value_type(ig_otype)
                this.last_type = this.str_to_type(val_type_str)
            } else {
                this.last_type = AST.Type.AnyType
            }
            return local
        }
    }
    // Subscript overloading: obj[key] → obj.getItem(key) when the receiver is a
    // user class declaring `getItem`. `Indexable` in src/lib/prelude.sf has
    // specified this protocol all along, but nothing ever implemented it: the
    // arms above handle Map and String and everything else fell through to the
    // list path below, which calls __list_length on the instance pointer and
    // reads a class struct as a list header — SIGSEGV. That is what crashed
    // test/pass/getitem_overload.sf (BUGS #94).
    //
    // Resolved before `gen_arg_value(object)` runs: emitting the receiver first
    // and deciding dispatch after is the preamble hazard that BUGS #70 is about.
    // Class resolution mirrors gen_binary's operator-overload path, including
    // its fallback for a non-variable receiver (a constructor call, `this.f`, a
    // method result), and it likewise accepts get_expr_type's answer only when
    // it names a declared class.
    //
    // The lookup goes through generic_base_name: class_fields, class_methods and
    // the ClassName__method symbols are all keyed by the *bare* name, while a
    // variable's declared type carries its arguments. Testing
    // `class_fields.has("Box<String>")` is always false, so before this every
    // generic receiver skipped this arm and fell straight into the list path
    // that segfaults (BUGS #95).
    // `gi_recv_type` keeps the full spelling ("Box<String>") because that is what
    // resolves the method's type parameters; `gi_class` is the bare name used for
    // every table and symbol lookup.
    var gi_recv_type: String = ""
    if (obj_name.length() > 0) {
        gi_recv_type = this.get_var_type_str(obj_name)
    }
    var gi_class: String = this.generic_base_name(gi_recv_type)
    if (!this.class_fields.has(gi_class)) {
        var gi_inferred_full: String = this.get_expr_type(object)
        var gi_inferred: String = this.generic_base_name(gi_inferred_full)
        if (this.class_fields.has(gi_inferred)) {
            gi_class = gi_inferred
            gi_recv_type = gi_inferred_full
        } else {
            gi_class = ""
            gi_recv_type = ""
        }
    }
    if (gi_class.length() > 0 and this.class_methods.has(gi_class)) {
        var gi_methods: List = this.class_methods.get(gi_class)
        if (gi_methods.contains("getItem")) {
            var gi_recv: String = this.gen_arg_value(object)
            var gi_key: String = this.gen_arg_value(index)
            var gi_target: String = gi_class + "__getItem"
            if (this.func_prefix_map.has(gi_target)) {
                gi_target = this.func_prefix_map.get(gi_target)
            } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions, this.current_prefix + gi_target)) {
                gi_target = this.current_prefix + gi_target
            }
            this.called_functions.push(gi_target)
            var gi_local: String = this.fresh_local()
            this.emit_indent(gi_local + " = call i64 @" + gi_target + "(i64 " + gi_recv + ", i64 " + gi_key + ")")
            // The declared return type, when known, with the receiver's class
            // type arguments substituted in: `class Box<T>` declaring
            // `fun getItem(k: Int): T` returns a String for a `Box<String>`.
            // Without that step last_type would be the bare "T", which names no
            // representation and makes every downstream dispatch miss.
            //
            // Falling back to Any rather than to the receiver's class: getItem
            // returns an *element*, and claiming the container type would
            // misroute the next dispatch.
            if (this.func_ret_types.has(gi_target)) {
                var gi_ret: AST.Type = this.func_ret_types.get(gi_target)
                var gi_ret_str: String = this.type_to_string(gi_ret)
                var gi_subst: String = this.substitute_class_type_params(gi_ret_str, gi_recv_type)
                if (gi_subst != gi_ret_str) {
                    this.last_type = this.str_to_type(gi_subst)
                } else {
                    this.last_type = gi_ret
                }
            } else {
                this.last_type = AST.Type.AnyType
            }
            return gi_local
        }
    }
    var obj: String = this.gen_arg_value(object)
    var obj_type: AST.Type = this.last_type
    // String indexing: s[i] → __str_get(s, i), a one-character String.
    // Without this the list path runs against a char*, reading a character as
    // if it were a list header (BUGS #29). It also blocked `for (c in "ab")`,
    // since the for-in desugaring is index-based. __str_get does its own
    // bounds check and negative-index adjustment, so the length/select dance
    // below is skipped entirely.
    if (this.type_to_string(obj_type) == "String") {
        var sg_idx_tagged: String = this.gen_arg_value(index)
        var sg_idx: String = this.emit_untag_index(sg_idx_tagged, this.last_type)
        var sg_local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(sg_local, "i64", "__str_get", "i64 " + obj + ", i64 " + sg_idx))
        } else {
            this.emit_indent(sg_local + " = call i64 @__str_get(i64 " + obj + ", i64 " + sg_idx + ")")
        }
        this.called_functions.push("__str_get")
        this.last_type = AST.Type.StringType
        return sg_local
    }
    var idx_tagged: String = this.gen_arg_value(index)
    // Untag the index for arithmetic and runtime call. A Float index is
    // converted, not bit-reinterpreted (BUGS #52).
    var idx: String = this.emit_untag_index(idx_tagged, this.last_type)
    // Negative indexing: if idx < 0, use length + idx
    var is_neg: String = this.fresh_local()
    this.emit_indent(is_neg + " = icmp slt i64 " + idx + ", 0")
    var len: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(len, "i64", "__list_length", "i64 " + obj))
    } else {
        this.emit_indent(len + " = call i64 @__list_length(i64 " + obj + ")")
    }
    var adjusted: String = this.fresh_local()
    this.emit_indent(adjusted + " = add i64 " + len + ", " + idx)
    var final_idx: String = this.fresh_local()
    this.emit_indent(final_idx + " = select i1 " + is_neg + ", i64 " + adjusted + ", i64 " + idx)
    var local: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(local, "i64", "__list_get", "i64 " + obj + ", i64 " + final_idx))
        // LLVM lib parallel path: track index_get result
        if (!this.identity_mode) {
            var ig_res: LLVMTypes.Value = this.llvm_block_builder.call("__list_get", LLVMTypes.Type.I64, [])
            this.llvm_values.set(local, ig_res)
        }
    } else {
        this.emit_indent(local + " = call i64 @__list_get(i64 " + obj + ", i64 " + final_idx + ")")
    }
    // Extract element type from the list's generic type
    var idx_elem_type: AST.Type = this.get_list_element_type(obj_type)
    if (this.type_to_string(idx_elem_type) == "Any" and obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
        idx_elem_type = this.get_list_element_type(this.typed_vars.get(obj_name))
        if (this.type_to_string(idx_elem_type) == "Any") {
            var vtype: String = this.type_to_string(this.typed_vars.get(obj_name))
            if (vtype.starts_with("List<") and vtype.ends_with(">")) {
                var inner: String = vtype.slice(5, vtype.length() - 1)
                idx_elem_type = this.str_to_type(inner)
            }
        }
    }
    if (this.type_to_string(idx_elem_type) != "Any") {
        this.last_type = idx_elem_type
    } else {
        this.last_type = AST.Type.AnyType
    }
    // Tuple type: extract Nth element type from Tuple<T1,T2,...>
    var obj_type_str: String = this.type_to_string(obj_type)
    if (obj_type_str.starts_with("Tuple") or (obj_name.length() > 0 and this.typed_vars.has(obj_name) and this.type_to_string(this.typed_vars.get(obj_name)).starts_with("Tuple<"))) {
        var full_type: String = obj_type_str
        if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
            full_type = this.type_to_string(this.typed_vars.get(obj_name))
        }
        if (full_type.starts_with("Tuple<") and full_type.ends_with(">")) {
            var tuple_inner: String = full_type.slice(6, full_type.length() - 1)
            var tuple_args: List<String> = this.split_type_args(tuple_inner)
            var ct_idx: Float = -1
            var idx_ek: String = this.classify_expr(index)
            if (idx_ek == "int") {
                ct_idx = match (index) { IntLit(v) => v   _ => -1 }
            }
            if (ct_idx >= 0 and ct_idx < tuple_args.length()) {
                this.last_type = this.str_to_type(tuple_args[ct_idx])
            }
        }
    }
    return local
    }

    fun gen_index_set(object: AST.Expr, index: AST.Expr, value: AST.Expr): String {
    var obj: String = this.gen_arg_value(object)
    var idx_tagged: String = this.gen_arg_value(index)
    // A Float index is converted, not bit-reinterpreted (BUGS #52).
    var idx: String = this.emit_untag_index(idx_tagged, this.last_type)
    var val: String = this.gen_arg_value(value)
    var discard_ls: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(discard_ls, "i64", "__list_set", "i64 " + obj + ", i64 " + idx + ", i64 " + val))
    } else {
        this.emit_indent(discard_ls + " = call i64 @__list_set(i64 " + obj + ", i64 " + idx + ", i64 " + val + ")")
    }
    return val
    }

    /// The module prefix an extension method's symbol must carry: the prefix of
    /// the class being EXTENDED, not of the file the `extend fun` is written in.
    /// `extend fun Ctx.ay()` in other.sf, with Ctx declared in core.sf, emits
    /// @core_Ctx__ay.
    ///
    /// Factored out because two callers must agree exactly: this and the
    /// pre-registration loop in generate_with_modules_flat_opts3. If they
    /// disagreed, the pre-registered symbol would name a function that is never
    /// defined — trading BUGS #103's link error for a different one.
    ///
    /// The two lookups are ordered so both callers land on the same answer even
    /// though they run at different times. At pre-scan time no class has been
    /// lowered, so func_prefix_map is empty and class_struct_names (filled by the
    /// class pre-registration loop) answers. At lowering time func_prefix_map has
    /// the entry and answers first. Both are `<module prefix> + <class name>` for
    /// the same class, so the two agree by construction.
    fun extend_class_prefix(ext_class: String, fallback: String): String {
        var init_key: String = ext_class + "__init"
        if (this.func_prefix_map.has(init_key)) {
            var mapped: String = this.func_prefix_map.get(init_key)
            return mapped.slice(0, mapped.length() - init_key.length())
        }
        // A class with no `init` at all has no entry above. Without this second
        // lookup such a class fell back to the *source file's* prefix, so an
        // extension method on it emitted under the wrong module.
        if (this.class_struct_names.has(ext_class)) {
            var struct_name: String = this.class_struct_names.get(ext_class)
            if (struct_name.ends_with(ext_class)) {
                return struct_name.slice(0, struct_name.length() - ext_class.length())
            }
        }
        return fallback
    }

    /// Register the SYMBOL of every `extend fun` in stmts[start..end) before any
    /// body is lowered (BUGS #103).
    ///
    /// gen_extend_method below registers `Ctx__bx -> core_Ctx__bx` in
    /// func_prefix_map only as it lowers that method, so a call generated BEFORE
    /// the callee was lowered found nothing and resolve_method_symbol fell through
    /// to an unprefixed guess — `@Ctx__bx` against a definition actually named
    /// `@core_Ctx__bx`. That passes codegen and dies at link time. Two `extend
    /// fun`s in different modules calling each other hit it in BOTH import orders,
    /// each order naming the other direction's symbol, so no ordering fixed it.
    ///
    /// Invisible in a single file because there the prefix is "" and the guess is
    /// accidentally right. It only breaks once the code lives in a module.
    ///
    /// Must run after class pre-registration: extend_class_prefix reads
    /// class_struct_names to find the extended class's module.
    fun prescan_extend_symbols(stmts: List<AST.Stmt>, start: Float, end: Float, prefix: String) {
        var xi: Float = start
        while (xi < end) {
            var xdoc: String = this.get_fun_doc(stmts[xi])
            if (xdoc.starts_with("@extend:")) {
                var xname: String = this.get_fun_name(stmts[xi])
                var xcls: String = xdoc.slice(8, xdoc.length())
                if (xname.length() > 0 and xcls.length() > 0) {
                    var xfull: String = xcls + "__" + xname
                    var xprefixed: String = this.extend_class_prefix(xcls, prefix) + xfull
                    this.func_prefix_map.set(xfull, xprefixed)
                    if (!this.str_in_list(this.known_functions, xprefixed)) {
                        this.known_functions.push(xprefixed)
                    }
                    if (!this.str_in_list(this.known_functions, xfull)) {
                        this.known_functions.push(xfull)
                    }
                    // The receiver's method list too, or gen_method_call's
                    // "type 'X' has no method 'y'" check rejects a call compiled
                    // before the extend fun is lowered.
                    if (this.class_methods.has(xcls)) {
                        var xmethods: List<String> = this.class_methods.get(xcls)
                        if (!this.str_in_list(xmethods, xname)) { xmethods.push(xname) }
                    }
                    var xret: String = this.get_fun_ret(stmts[xi])
                    if (xret.length() > 0) {
                        this.func_ret_types.set(xprefixed, this.str_to_type(xret))
                        this.func_ret_types.set(xfull, this.str_to_type(xret))
                    }
                }
            }
            xi = xi + 1
        }
    }

    fun gen_extend_method(ext_class: String, name: String, params: List<AST.Param>, ret_type: String, body: List<AST.Stmt>) {
    var full_name: String = ext_class + "__" + name
    // Use target class's prefix (not source file's prefix)
    var class_prefix: String = this.extend_class_prefix(ext_class, this.current_prefix)
    var prefixed: String = class_prefix + full_name
    this.known_functions.push(prefixed)
    this.known_functions.push(full_name)
    this.func_ret_types.set(prefixed, this.str_to_type(ret_type))
    this.func_ret_types.set(full_name, this.str_to_type(ret_type))
    this.func_prefix_map.set(full_name, prefixed)
    if (this.class_methods.has(ext_class)) {
        var methods: List = this.class_methods.get(ext_class)
        methods.push(name)
    }
    var params_str: String = this.params_to_string(params)
    var full_params: String = "self:Int"
    if (params_str.length() > 0) { full_params = full_params + "," + params_str }
    var saved_class: String = this.current_class
    var saved_prefix: String = this.current_prefix
    this.current_class = ext_class
    this.current_prefix = class_prefix
    this.gen_function(full_name, full_params, ret_type, body)
    this.current_class = saved_class
    this.current_prefix = saved_prefix
    }

    fun set_result_type(result_type: String) {
    if (result_type == "Nil") { this.last_type = AST.Type.NilType }
    else if (result_type == "Int") { this.last_type = AST.Type.IntType }
    else if (result_type == "Bool") { this.last_type = AST.Type.BoolType }
    else if (result_type == "String") { this.last_type = AST.Type.StringType }
    else if (result_type == "List") { this.last_type = this.make_list_type() }
    else if (result_type == "ListStr") { this.last_type = this.make_list_str_type() }
    }

    fun tag_builtin_result(raw: String, result_type: String): String {
    if (result_type == "String") {
        var ptr: String = this.fresh_local()
        this.emit_indent(ptr + " = inttoptr i64 " + raw + " to i8*")
        return this.emit_tag_ptr(ptr)
    }
    if (result_type == "Bool") {
        return this.emit_tag_bool(raw)
    }
    if (result_type == "Int") {
        return this.emit_tag_int(raw)
    }
    return raw
    }

    fun emit_builtin_dispatch(obj: String, method: String, args: List<AST.Expr>): String {
    var desc: String = this.builtin_methods.get(method)
    var parts: List<String> = desc.split("|")
    var pattern: String = parts[0]
    var func_name: String = parts[1]
    var result_type: String = parts[2]
    var needs_push: String = parts[3]
    if (needs_push == "1") { this.called_functions.push(func_name) }
    if (pattern == "v2") {
        var val: String = this.gen_arg_value(args[0])
        var discard: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(discard, "i64", func_name, "i64 " + obj + ", i64 " + val))
        } else {
            this.emit_indent(discard + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + val + ")")
        }
        this.set_result_type(result_type)
        return "0"
    }
    if (pattern == "v3") {
        var a1: String = this.gen_arg_value(args[0])
        var a2: String = this.gen_arg_value(args[1])
        var discard: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(discard, "i64", func_name, "i64 " + obj + ", i64 " + a1 + ", i64 " + a2))
        } else {
            this.emit_indent(discard + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ", i64 " + a2 + ")")
        }
        this.set_result_type(result_type)
        return "0"
    }
    if (pattern == "r1") {
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "r2") {
        var val: String = this.gen_arg_value(args[0])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + val))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + val + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "p1") {
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "p2") {
        var a1: String = this.gen_arg_value(args[0])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + a1))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "p3") {
        var a1: String = this.gen_arg_value(args[0])
        var a2: String = this.gen_arg_value(args[1])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + a1 + ", i64 " + a2))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ", i64 " + a2 + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "m2") {
        var a1: String = this.gen_arg_value(args[0])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + a1))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    this.set_result_type(result_type)
    return "0"
    }

    // Resolve a class method symbol the way gen_namespace_call does inline
    // (func_prefix_map, then module prefix, then a known_functions suffix match).
    // Factored out so gen_virtual_dispatch forms each subclass arm's callee the
    // same way the static default is formed.
    fun resolve_method_symbol(bare_class: String, method: String): String {
        var full: String = bare_class + "__" + method
        if (this.func_prefix_map.has(full)) { return this.func_prefix_map.get(full) }
        if (this.current_prefix.length() > 0 and this.known_functions.contains(this.current_prefix + full)) {
            return this.current_prefix + full
        }
        if (this.known_functions.contains(full)) { return full }
        var kfi: Float = 0
        while (kfi < this.known_functions.length()) {
            if (this.known_functions[kfi].ends_with(full)) { return this.known_functions[kfi] }
            kfi = kfi + 1
        }
        // Nothing matched. This used to `return full` — the unprefixed guess. That
        // guess is right only when the symbol carries no module prefix, so in a
        // module it named a function that does not exist, passed codegen, and died
        // at link time with "use of undefined value" (BUGS #103).
        //
        // The guess was load-bearing until extension methods were pre-registered:
        // before prescan_extend_symbols, an `extend fun` not yet lowered was absent
        // from all four lookups above, and the guess accidentally saved the
        // single-file case. With pre-registration every method — declared in a class
        // body or added by `extend fun`, in any module or the main program — is in
        // func_prefix_map or known_functions before any body is lowered, so reaching
        // here means the method genuinely does not exist. Report it instead of
        // emitting a call to a name that was never defined.
        IO.println("[codegen] Error: no symbol for method '" + method + "' on class '" + bare_class + "' — expected '" + full + "' or a module-prefixed form, found neither.")
        this.has_errors = true
        return full
    }

    // The struct name that actually implements `method` for the class whose
    // struct name is `struct_c` — the nearest class at or above it that declares
    // the method itself (class_own_methods). "" if none does.
    //
    // Searches every base, not one chain, so a method supplied by the 2nd or 3rd
    // interface of `extends A, B, C` has an owner. Bases are visited in
    // declaration order at each level (all_ancestor_structs is breadth-first),
    // matching the first-wins rule the forwarder emission uses.
    fun effective_method_owner(struct_c: String, method: String): String {
        if (this.class_own_methods.has(struct_c)) {
            var own0: List<String> = this.class_own_methods.get(struct_c)
            if (own0.contains(method)) { return struct_c }
        }
        var anc: List<String> = this.all_ancestor_structs(struct_c)
        var ai: Float = 0
        while (ai < anc.length()) {
            if (this.class_own_methods.has(anc[ai])) {
                var own: List<String> = this.class_own_methods.get(anc[ai])
                if (own.contains(method)) { return anc[ai] }
            }
            ai = ai + 1
        }
        return ""
    }

    // BUGS #50. A call statically bound to <ns>__<method> is only right when the
    // receiver is exactly ns; a subclass in an ns-typed slot (or `this` inside an
    // inherited method) needs its own override. Emit a switch on the receiver's
    // runtime class tag with an arm for each descendant of ns whose effective
    // implementation differs from ns's, calling that subclass's own symbol
    // (a real override or the forwarder codegen already emits). Returns "" when
    // nothing overrides — the caller then emits the plain static call, so the
    // common no-inheritance case pays nothing. Also "" in identity mode, where
    // there is no tag and __val_class_tag is not linked (the bootstrap keeps the
    // old static behaviour for the compiler's own source).
    fun gen_virtual_dispatch(ns: String, method: String, obj: String, full_method: String, arg_strs: List<String>, canonical: String): String {
        if (this.identity_mode) { return "" }
        // Resolve ns to a struct name (the key domain of class_parent_of /
        // class_type_ids / class_own_methods).
        var struct_ns: String = ns
        if (this.class_struct_names.has(ns)) { struct_ns = this.class_struct_names.get(ns) }
        if (!this.class_type_ids.has(struct_ns)) { return "" }
        var ns_owner: String = this.effective_method_owner(struct_ns, method)
        if (ns_owner.length() == 0) { return "" }
        // Collect descendant structs whose effective owner differs from ns's.
        var arm_tags: List<String> = []
        var arm_syms: List<String> = []
        var keys: List<String> = this.class_type_ids.keys()
        var ki: Float = 0
        while (ki < keys.length()) {
            var sc: String = keys[ki]
            if (sc != struct_ns) {
                // Is sc a descendant of struct_ns, through any of its bases? The
                // single-chain walk this replaces missed a class whose relation to
                // struct_ns runs through its 2nd or 3rd base, so a call typed at
                // the interface did not dispatch to that implementor.
                var is_desc: Bool = this.str_in_list(this.all_ancestor_structs(sc), struct_ns)
                if (is_desc) {
                    var sc_owner: String = this.effective_method_owner(sc, method)
                    if (sc_owner.length() > 0 and sc_owner != ns_owner) {
                        var bare: String = sc
                        if (this.class_bare_of.has(sc)) { bare = this.class_bare_of.get(sc) }
                        var tag: Float = this.class_type_ids.get(sc)
                        arm_tags.push(tag.floor().to_string())
                        arm_syms.push(this.resolve_method_symbol(bare, method))
                    }
                }
            }
            ki = ki + 1
        }
        if (arm_tags.length() == 0) { return "" }
        // Emit: read tag, switch, one arm per overriding descendant, default is
        // the static symbol. obj is already evaluated by the caller.
        var vd_result: String = this.fresh_local()
        this.emit_indent(vd_result + " = alloca i64")
        var vd_tag: String = this.fresh_local()
        this.emit_indent(vd_tag + " = call i64 @__val_class_tag(i64 " + obj + ")")
        // __val_class_tag is declared in runtime_declares(); pushing it to
        // called_functions would trigger a second, conflicting auto-declare.
        var vd_default: String = this.fresh_label("vd.default")
        var vd_end: String = this.fresh_label("vd.end")
        var arm_labels: List<String> = []
        var ai: Float = 0
        while (ai < arm_tags.length()) {
            arm_labels.push(this.fresh_label("vd.arm"))
            ai = ai + 1
        }
        var cases: String = ""
        ai = 0
        while (ai < arm_tags.length()) {
            cases = cases + " i64 " + arm_tags[ai] + ", label %" + arm_labels[ai.floor()]
            ai = ai + 1
        }
        this.emit_terminator("switch i64 " + vd_tag + ", label %" + vd_default + " [" + cases + " ]")
        var args_joined: String = arg_strs.join(", ")
        ai = 0
        while (ai < arm_tags.length()) {
            this.start_block(arm_labels[ai.floor()])
            var ar: String = this.fresh_local()
            this.emit_indent(ar + " = call i64 @" + arm_syms[ai.floor()] + "(" + args_joined + ")")
            this.called_functions.push(arm_syms[ai.floor()])
            this.emit_indent("store i64 " + ar + ", i64* " + vd_result)
            this.emit_terminator("br label %" + vd_end)
            ai = ai + 1
        }
        this.start_block(vd_default)
        var dr: String = this.fresh_local()
        this.emit_indent(dr + " = call i64 @" + full_method + "(" + args_joined + ")")
        this.called_functions.push(full_method)
        this.emit_indent("store i64 " + dr + ", i64* " + vd_result)
        this.emit_terminator("br label %" + vd_end)
        this.start_block(vd_end)
        var vd_local: String = this.fresh_local()
        this.emit_indent(vd_local + " = load i64, i64* " + vd_result)
        if (this.func_ret_types.has(full_method)) {
            this.last_type = this.func_ret_types.get(full_method)
        } else if (this.func_ret_types.has(canonical)) {
            this.last_type = this.func_ret_types.get(canonical)
        } else {
            this.last_type = AST.Type.IntType
        }
        if (!this.identity_mode) {
            var vdr: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
            this.llvm_values.set(vd_local, vdr)
        }
        return vd_local
    }

    fun gen_namespace_call(ns: String, method: String, obj: String, args: List<AST.Expr>, has_self: Bool): String {
    // Check if 'method' is actually a function-type field (not a real method).
    // e.g. this.compute() where compute is `var compute: () => T`
    //
    // Every spelling of a function type has to be listed here, because the three
    // of them reach this point as three unrelated strings:
    //
    //   `(A, B) => R`   parses to FuncType, and func_type_string renders it
    //                   "Fun(A,B):R"          → starts_with("Fun(")
    //   `Fun<A, B, R>`  parses to GenericType("Fun", ...), and
    //                   generic_type_string renders it "Fun<A,B,R>"
    //   bare `Fun`      parses to ClassType("Fun") — NOT a FuncType — so
    //                   type_to_string returns it via the ClassType(n) arm as
    //                   the plain string "Fun", with no bracket of any kind
    //
    // Only the first was tested, so a `var f: Fun` field fell through to the
    // ordinary method path below and emitted a call to the symbol `Ns__f`, which
    // no definition exists for: the program failed to LINK rather than
    // miscompiling. Copying the field to a local first worked around it because
    // a local goes through gen_call's indirect path, which never consults a
    // field type at all. Bare `Fun` is the spelling `src/lib/heap.sf` uses for
    // its comparator, which is why that stdlib module could not link.
    if (has_self and this.class_fields.has(ns)) {
        var ft: String = this.get_field_type(ns, method)
        var is_fn_type: Bool = ft.starts_with("Fun(") or ft.starts_with("Fun<") or ft == "Fun" or ft.starts_with("(") and ft.contains("=>") or ft.starts_with("() =>")
        if (is_fn_type) {
            // Check there's no actual method with this name
            var full_check: String = ns + "__" + method
            var has_method: Bool = this.known_functions.contains(full_check)
            if (!has_method and this.current_prefix.length() > 0) {
                has_method = this.known_functions.contains(this.current_prefix + full_check)
            }
            if (!has_method) {
                // Load the field value (a closure pair) and call it indirectly
                var struct_name: String = ns
                if (this.class_struct_names.has(ns)) {
                    struct_name = this.class_struct_names.get(ns)
                }
                var field_idx: Float = this.get_field_index(ns, method)
                var obj_ptr: String = this.val_to_typed_ptr(obj, "%" + struct_name + "*")
                var field_ptr: String = this.fresh_local()
                this.emit_indent(field_ptr + " = getelementptr %" + struct_name + ", %" + struct_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
                var field_val: String = this.fresh_local()
                this.emit_indent(field_val + " = load i64, i64* " + field_ptr)
                return this.gen_indirect_call(field_val, args)
            }
        }
    }

    var arg_strs: List<String> = []
    if (has_self) { arg_strs.push("i64 " + obj) }
    var i: Float = 0
    while (i < args.length()) {
        var val: String = this.gen_arg_value(args[i])
        arg_strs.push("i64 " + val)
        i = i + 1
    }
    var full_method: String = ns + "__" + method
    var canonical: String = full_method
    if (this.func_prefix_map.has(full_method)) {
        full_method = this.func_prefix_map.get(full_method)
    } else if (this.current_prefix.length() > 0 and this.known_functions.contains(this.current_prefix + full_method)) {
        full_method = this.current_prefix + full_method
    } else if (!this.known_functions.contains(full_method)) {
        var kfi: Float = 0
        while (kfi < this.known_functions.length()) {
            if (this.known_functions[kfi].ends_with(full_method)) {
                full_method = this.known_functions[kfi]
                kfi = this.known_functions.length()
            }
            kfi = kfi + 1
        }
    }
    this.called_functions.push(full_method)

    // Coroutine-aware method call: if this function is a coroutine and the
    // callee is also a coroutine, emit the await pattern instead of plain call.
    if (this.is_coroutine and this.str_in_list(this.coroutine_funcs, full_method)) {
        var mc_hdl: String = this.fresh_local()
        this.emit_indent(mc_hdl + " = call ptr @" + full_method + "(" + arg_strs.join(", ") + ")")
        var mc_hdl_i64: String = this.fresh_local()
        this.emit_indent(mc_hdl_i64 + " = ptrtoint ptr " + mc_hdl + " to i64")
        var mc_await_loop: String = this.fresh_label("await.loop")
        var mc_await_yield: String = this.fresh_label("await.yield")
        var mc_await_cleanup: String = this.fresh_label("await.cleanup")
        var mc_await_done: String = this.fresh_label("await.done")
        var mc_await_check: String = this.fresh_label("await.check")
        this.emit_terminator("br label %" + mc_await_check)
        this.start_block(mc_await_check)
        var mc_done: String = this.fresh_local()
        this.emit_indent(mc_done + " = call i64 @__sched_coro_done(i64 " + mc_hdl_i64 + ")")
        var mc_done_cmp: String = this.fresh_local()
        this.emit_indent(mc_done_cmp + " = icmp eq i64 " + mc_done + ", 1")
        this.emit_terminator("br i1 " + mc_done_cmp + ", label %" + mc_await_done + ", label %" + mc_await_yield)
        this.start_block(mc_await_yield)
        var mc_save: String = this.fresh_local()
        this.emit_indent(mc_save + " = call token @llvm.coro.save(ptr %__coro_hdl)")
        var mc_susp: String = this.fresh_local()
        this.emit_indent(mc_susp + " = call i8 @llvm.coro.suspend(token " + mc_save + ", i1 false)")
        this.emit_terminator("switch i8 " + mc_susp + ", label %__coro_suspend [i8 0, label %" + mc_await_loop + " i8 1, label %" + mc_await_cleanup + "]")
        this.start_block(mc_await_cleanup)
        this.emit_terminator("br label %__coro_cleanup")
        this.start_block(mc_await_loop)
        this.emit_indent("call void @__sched_coro_resume(i64 " + mc_hdl_i64 + ")")
        this.emit_terminator("br label %" + mc_await_check)
        this.start_block(mc_await_done)
        var mc_result: String = this.fresh_local()
        this.emit_indent(mc_result + " = load i64, i64* @__task_result")
        if (this.func_ret_types.has(full_method)) {
            this.last_type = this.func_ret_types.get(full_method)
        } else if (this.func_ret_types.has(canonical)) {
            this.last_type = this.func_ret_types.get(canonical)
        } else {
            this.last_type = AST.Type.IntType
        }
        return mc_result
    }

    // Sync-calls-coro for method calls: non-coroutine calling a coroutine method
    if (!this.is_coroutine and this.str_in_list(this.coroutine_funcs, full_method)) {
        var sc_hdl: String = this.fresh_local()
        this.emit_indent(sc_hdl + " = call ptr @" + full_method + "(" + arg_strs.join(", ") + ")")
        var sc_i64: String = this.fresh_local()
        this.emit_indent(sc_i64 + " = ptrtoint ptr " + sc_hdl + " to i64")
        var sc_check: String = this.fresh_label("sync.check")
        var sc_loop: String = this.fresh_label("sync.loop")
        var sc_done: String = this.fresh_label("sync.done")
        this.emit_terminator("br label %" + sc_check)
        this.start_block(sc_check)
        var sc_d: String = this.fresh_local()
        this.emit_indent(sc_d + " = call i64 @__sched_coro_done(i64 " + sc_i64 + ")")
        var sc_cmp: String = this.fresh_local()
        this.emit_indent(sc_cmp + " = icmp eq i64 " + sc_d + ", 1")
        this.emit_terminator("br i1 " + sc_cmp + ", label %" + sc_done + ", label %" + sc_loop)
        this.start_block(sc_loop)
        this.emit_indent("call void @__sched_coro_resume(i64 " + sc_i64 + ")")
        this.emit_terminator("br label %" + sc_check)
        this.start_block(sc_done)
        var sc_result: String = this.fresh_local()
        this.emit_indent(sc_result + " = load i64, i64* @__task_result")
        if (this.func_ret_types.has(full_method)) {
            this.last_type = this.func_ret_types.get(full_method)
        } else if (this.func_ret_types.has(canonical)) {
            this.last_type = this.func_ret_types.get(canonical)
        } else {
            this.last_type = AST.Type.IntType
        }
        return sc_result
    }

    // Virtual dispatch (BUGS #50): if this call resolves statically to
    // <ns>__<method> but some subclass of ns overrides method, the receiver may
    // actually be that subclass — a Dog held in an Animal-typed slot, or `this`
    // inside an inherited Animal method that is really a Dog. Switch on the
    // receiver's runtime class tag and call the subclass's own symbol. Correct
    // by construction: every class in the subtree already has a C__method symbol
    // (a real override or a forwarder), so an arm per overriding descendant plus
    // a default of the static symbol covers every case. Only plain sync methods
    // reach here — coroutine/actor dispatch returned above — which is exactly
    // #50's shape. obj is already evaluated, so this does not re-enter the
    // receiver expression (the #70 preamble hazard).
    if (has_self) {
        var vd: String = this.gen_virtual_dispatch(ns, method, obj, full_method, arg_strs, canonical)
        if (vd.length() > 0) { return vd }
    }

    var local: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(local, "i64", full_method, arg_strs.join(", ")))
        // LLVM lib parallel path: track method call result as a call instruction
        if (!this.identity_mode) {
            var mc_arg_vals: List<LLVMTypes.Value> = []
            var mc_ai: Float = 0
            while (mc_ai < arg_strs.length()) {
                var mc_part: String = arg_strs[mc_ai]
                var mc_sp: Float = mc_part.index_of(" ")
                if (mc_sp > 0) {
                    var mc_reg: String = mc_part.slice(mc_sp + 1, mc_part.length())
                    mc_arg_vals.push(LLVMTypes.Value.Instruction(mc_reg, LLVMTypes.Type.I64))
                }
                mc_ai = mc_ai + 1
            }
            var mc_result2: LLVMTypes.Value = this.llvm_block_builder.call(full_method, LLVMTypes.Type.I64, mc_arg_vals)
            this.llvm_values.set(local, mc_result2)
        }
    } else {
        this.emit_indent(local + " = call i64 @" + full_method + "(" + arg_strs.join(", ") + ")")
    }
    if (this.func_ret_types.has(full_method)) {
        this.last_type = this.func_ret_types.get(full_method)
    } else if (this.func_ret_types.has(canonical)) {
        this.last_type = this.func_ret_types.get(canonical)
    } else {
        this.last_type = AST.Type.IntType
    }
    return local
    }

    /// Emit a call to the coroutine `target` and drive it to completion, returning
    /// the local holding its result. A coroutine is emitted `define ptr ...
    /// presplitcoroutine` and returns a *frame handle*, not a value, so a plain
    /// `call i64` against it reads the handle as the result AND never runs the
    /// suspension the callee asked for — that is BUGS #38 in both its symptoms
    /// (`Async.gather` returning `2,8`, and `Async.sleep` not sleeping: nothing
    /// reads __yield_reason, so reason 1 never reaches the scheduler's
    /// sleep_queue).
    ///
    /// Two shapes, picked by whether the *caller* is itself a coroutine:
    ///   - coro-calls-coro: suspend the caller between resumes, so the scheduler
    ///     stays in control and a sibling task can run.
    ///   - sync-calls-coro: spin the resume loop inline; there is no frame to
    ///     suspend.
    ///
    /// Callers set last_type themselves — the return-type key differs per arm
    /// (prefixed name, bare method, named-import target).
    fun gen_coro_call(target: String, arg_strs: List<String>): String {
        var hdl: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(hdl, "ptr", target, arg_strs.join(", ")))
        } else {
            this.emit_indent(hdl + " = call ptr @" + target + "(" + arg_strs.join(", ") + ")")
        }
        var hdl_i64: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_ptrtoint(hdl_i64, hdl))
        } else {
            this.emit_indent(hdl_i64 + " = ptrtoint ptr " + hdl + " to i64")
        }
        var check: String = this.fresh_label("await.check")
        var loop: String = this.fresh_label("await.loop")
        var done: String = this.fresh_label("await.done")
        this.emit_terminator("br label %" + check)
        this.start_block(check)
        var d: String = this.fresh_local()
        this.emit_indent(d + " = call i64 @__sched_coro_done(i64 " + hdl_i64 + ")")
        var cmp: String = this.fresh_local()
        this.emit_indent(cmp + " = icmp eq i64 " + d + ", 1")
        if (this.is_coroutine) {
            var yld: String = this.fresh_label("await.yield")
            var cleanup: String = this.fresh_label("await.cleanup")
            this.emit_terminator("br i1 " + cmp + ", label %" + done + ", label %" + yld)
            this.start_block(yld)
            // Suspend without touching __yield_reason/__yield_arg: the callee
            // already set them, and the scheduler must see the child's reason
            // (sleep, io, await) rather than a reason invented here.
            var save: String = this.fresh_local()
            this.emit_indent(save + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var susp: String = this.fresh_local()
            this.emit_indent(susp + " = call i8 @llvm.coro.suspend(token " + save + ", i1 false)")
            this.emit_terminator("switch i8 " + susp + ", label %__coro_suspend [i8 0, label %" + loop + " i8 1, label %" + cleanup + "]")
            this.start_block(cleanup)
            this.emit_terminator("br label %__coro_cleanup")
        } else {
            this.emit_terminator("br i1 " + cmp + ", label %" + done + ", label %" + loop)
        }
        this.start_block(loop)
        this.emit_indent("call void @__sched_coro_resume(i64 " + hdl_i64 + ")")
        this.emit_terminator("br label %" + check)
        this.start_block(done)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = load i64, i64* @__task_result")
        return result
    }

    // The boxing discipline for a runtime `__io_*`/`__os_*` symbol reached
    // through builtin-namespace dispatch (`IO.foo(...)` mangles straight to
    // `@__io_foo` and never enters the wrapper in src/lib/io.sf, so the wrapper's
    // return annotation is not consulted).
    //
    // Returns one of "string", "bool", "int", "list", "void", or "" for
    // not-a-runtime-symbol. This used to be three hardcoded `or` chains at the
    // call site, and the failure mode of that shape is that a symbol absent from
    // all three chains silently keeps `last_type = IntType`: `IO.readln()` and
    // `IO.read_line()` are aliases of `__io_readline`, which IS listed, but the
    // aliases were not, so both printed a raw heap address (`[5360378368]`)
    // instead of the line. The value itself was correct and correctly TAG_PTR'd
    // by the runtime — only codegen's *static* type was wrong, which is why
    // `.length()` on the same value returned 5 while interpolating it printed an
    // address. That asymmetry is the tell for this class of bug.
    //
    // Note this classifies the STATIC TYPE, and the tagging that follows is
    // idempotent: __io_read_file already returns __rt_tag_ptr'd memory and is
    // tagged again here, which is harmless because __val_tag_ptr masks the low 48
    // bits and re-ors TAG_PTR. Doubling an UNTAG is the unsafe direction (BUGS
    // #77) — do not read this as licence to double up in general.
    fun runtime_ret_discipline(fn: String): String {
        if (fn == "__io_read_file" or fn == "__io_readline" or fn == "__io_readln" or fn == "__io_read_line" or fn == "__io_read_stdin") { return "string" }
        if (fn == "__os_exec" or fn == "__os_env" or fn == "__os_cwd" or fn == "__os_path_sep" or fn == "__os_platform" or fn == "__os_home") { return "string" }
        if (fn == "__io_file_exists" or fn == "__os_file_exists" or fn == "__io_is_dir" or fn == "__io_rename" or fn == "__io_delete_file" or fn == "__os_set_env") { return "bool" }
        if (fn == "__io_file_size" or fn == "__io_read_binary" or fn == "__os_system") { return "int" }
        // Lists travel deliberately UNTAGGED. Tagging the returned list pointer
        // here segfaults: __gc_is_heap_ptr (gc.ll:615) rejects any NaN-tagged
        // value as a heap pointer, so a tagged __list_new() result stops being
        // traced and is swept while live. That is the caveat in BUGS #23, and it
        // is why "list" is a discipline of its own rather than an omission.
        // `__str_split` is the precedent and is also untagged at its call site.
        if (fn == "__io_walk_dir" or fn == "__io_list_dir" or fn == "__os_list_dir" or fn == "__os_args") { return "list" }
        if (fn == "__io_write_file" or fn == "__io_append_file" or fn == "__io_mkdir" or fn == "__os_mkdir") { return "void" }
        // Intercepted before generic dispatch, but listed so they are never
        // reported as unclassified.
        if (fn == "__io_println" or fn == "__io_print") { return "void" }
        return ""
    }

    fun resolve_namespace(obj_name: String, object: AST.Expr): String {
    if (obj_name == "this" or this.classify_expr(object) == "this") {
        return this.current_class
    }
    if (this.module_prefixes.has(obj_name)) { return obj_name }
    if (this.class_fields.has(obj_name)) { return obj_name }
    if (obj_name.length() > 0) {
        var vtype: String = this.get_var_type_str(obj_name)
        var resolved: String = this.resolve_class_type(vtype)
        if (resolved.length() > 0) { return resolved }
    }
    return ""
    }

    fun gen_method_call(object: AST.Expr, method: String, args: List<AST.Expr>): String {
    var obj_name: String = this.get_variable_name(object)

    // `__iter_get` — the for-in desugaring's element read (BUGS #62). Nothing
    // stops a user from spelling the name (there is no reserved-identifier rule
    // in the lexer), which is why __any_iter_get is total: it discriminates on
    // the receiver's GC type tag and falls through to a bounds-checked
    // __str_get, rather than trusting that the receiver is a collection.
    //
    // Decided HERE, above every arm that emits IR. `Alias.method()` dispatch
    // further down runs an unconditional gen_arg_value on the receiver before it
    // has decided anything, so an arm added below it emits a stray load for a
    // slot no prologue allocates — the same preamble hazard that made `super`
    // fail LLVM verification (BUGS #70).
    //
    // Static Map receivers could emit __map_* directly, but there is no reason
    // to: __any_iter_get discriminates by GC type tag, which also covers the
    // Any-typed and generic receivers where no static type is available — the
    // case that made the bug reachable through iter.sf's map/filter/reduce.
    if (method == "__iter_get" and args.length() == 1) {
        var __ig_obj: String = this.gen_arg_value(object)
        var __ig_idx_tagged: String = this.gen_arg_value(args[0])
        var __ig_idx: String = this.emit_untag_index(__ig_idx_tagged, this.last_type)
        this.called_functions.push("__any_iter_get")
        var __ig_res: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(__ig_res, "i64", "__any_iter_get", "i64 " + __ig_obj + ", i64 " + __ig_idx))
        } else {
            this.emit_indent(__ig_res + " = call i64 @__any_iter_get(i64 " + __ig_obj + ", i64 " + __ig_idx + ")")
        }
        // The element's type is whatever the collection holds: T for a List<T>,
        // String for a String, List<Any> for a Map, and Any when the receiver is
        // the desugaring's untyped temporary.
        this.last_type = this.iter_element_type(object)
        return __ig_res
    }

    // Self method calls: this.method(args)
    var obj_kind_early: String = this.classify_expr(object)
    if (obj_kind_early == "this" and this.current_class.length() > 0) {
        var self_val: String = this.fresh_local()
        this.emit_indent(self_val + " = load i64, i64* %self")
        return this.gen_namespace_call(this.current_class, method, self_val, args, true)
    }

    // super.method(args) — must be decided HERE, above the builtin-dispatch
    // preamble further down, which does an unconditional gen_arg_value(object).
    // `super` parses as an ordinary Variable node (parser.sf), so that preamble
    // emits `load i64, i64* %super` for a slot no prologue allocates, and the
    // module fails LLVM verification even though the call below is correct
    // (BUGS #70). Same reason the `this` receiver is handled just above.
    if (obj_name == "super" and this.current_parent.length() > 0) {
        var super_self: String = this.fresh_local()
        this.emit_indent(super_self + " = load i64, i64* %self")
        var super_args: List<String> = []
        super_args.push("i64 " + super_self)
        var super_i: Float = 0
        while (super_i < args.length()) {
            var super_arg: String = this.gen_arg_value(args[super_i])
            super_args.push("i64 " + super_arg)
            super_i = super_i + 1
        }
        var parent_method: String = this.current_parent + "__" + method
        this.called_functions.push(parent_method)
        var super_result: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(super_result, "i64", parent_method, super_args.join(", ")))
        } else {
            this.emit_indent(super_result + " = call i64 @" + parent_method + "(" + super_args.join(", ") + ")")
        }
        if (this.func_ret_types.has(parent_method)) {
            this.last_type = this.func_ret_types.get(parent_method)
        } else {
            this.last_type = AST.Type.StringType
        }
        return super_result
    }

    // Actor fire-and-forget: actor.send("method_name", args...)
    if (method == "send" and args.length() >= 1 and obj_name.length() > 0) {
        var send_obj_type: String = this.get_var_type_str(obj_name)
        var send_class: String = send_obj_type
        if (this.class_fields.has(send_obj_type) and this.actor_classes.has(send_obj_type)) {
            var send_method_name: String = this.get_string_literal(args[0])
            if (send_method_name.length() > 0) {
                var send_args = []
                var sai: Float = 1
                while (sai < args.length()) {
                    send_args.push(args[sai])
                    sai = sai + 1
                }
                var send_obj: String = this.gen_arg_value(object)
                return this.gen_namespace_call(send_class, send_method_name, send_obj, send_args, true)
            }
        }
    }

    // Package namespace dispatch: check named_imports for "Alias.method" pattern.
    // This handles package re-exports where Parsley.router → router_router.
    if (obj_name.length() > 0 and this.named_imports.has(obj_name + "." + method)) {
        var __pe_target: String = this.named_imports.get(obj_name + "." + method)
        this.called_functions.push(__pe_target)
        this.called_function_arity.set(__pe_target, args.length())

        // Check if this is a class constructor
        var __pe_is_ctor: Bool = false
        if (this.class_fields.has(method) or this.class_fields.has(__pe_target)) {
            __pe_is_ctor = true
        }

        if (__pe_is_ctor) {
            var __pe_instance: String = this.fresh_local()
            this.emit_indent(__pe_instance + " = call i64 @" + __pe_target + "()")
            var __pe_init: String = __pe_target + "__init"
            if (this.str_in_list(this.known_functions, __pe_init)) {
                var __pe_init_args: List<String> = []
                __pe_init_args.push("i64 " + __pe_instance)
                var __pei: Float = 0
                while (__pei < args.length()) {
                    __pe_init_args.push("i64 " + this.gen_arg_value(args[__pei]))
                    __pei = __pei + 1
                }
                var __pe_discard: String = this.fresh_local()
                this.emit_indent(__pe_discard + " = call i64 @" + __pe_init + "(" + __pe_init_args.join(", ") + ")")
            }
            this.last_type = this.str_to_type(method)
            return __pe_instance
        }

        // Regular function call
        var __pe_args: List<String> = []
        var __peai: Float = 0
        while (__peai < args.length()) {
            __pe_args.push("i64 " + this.gen_arg_value(args[__peai]))
            __peai = __peai + 1
        }
        // Same coroutine hazard as the module-prefix arm below (BUGS #38): a
        // re-exported or named-imported coroutine needs its frame driven, not a
        // bare `call i64`. `import { sleep } from "@async"` reaches here.
        if (this.str_in_list(this.coroutine_funcs, __pe_target)) {
            var __pe_coro: String = this.gen_coro_call(__pe_target, __pe_args)
            if (this.func_ret_types.has(__pe_target)) {
                this.last_type = this.func_ret_types.get(__pe_target)
            }
            return __pe_coro
        }
        var __pe_result: String = this.fresh_local()
        this.emit_indent(__pe_result + " = call i64 @" + __pe_target + "(" + __pe_args.join(", ") + ")")
        // Set return type from func_ret_types if available
        if (this.func_ret_types.has(__pe_target)) {
            this.last_type = this.func_ret_types.get(__pe_target)
        }
        return __pe_result
    }

    // Universal module dispatch: route through module prefix when the module
    // was properly imported (has a real prefix like "stdlib_os_").
    // Builtins with empty prefix (IO/OS/GC registered as "") fall through
    // to their hardcoded blocks below.
    if (obj_name.length() > 0 and this.module_prefixes.has(obj_name)) {
        var __mp: String = this.module_prefixes.get(obj_name)
        if (__mp.length() > 0) {
            var __mp_func: String = __mp + method
            // Method name remapping for GC functions that conflict with gc.ll globals.
            // Use ends_with on __mp_func to avoid identity-mode pointer comparison issues.
            if (__mp_func.starts_with("__gc_")) {
                if (__mp_func.ends_with("_stats")) { __mp_func = "__gc_debug_stats" }
                else if (__mp_func.ends_with("_alloc_count")) { __mp_func = "__gc_stat_alloc_count" }
                else if (__mp_func.ends_with("_total_bytes")) { __mp_func = "__gc_stat_total_bytes" }
                else if (__mp_func.ends_with("_threshold") and !__mp_func.ends_with("_set_threshold")) { __mp_func = "__gc_stat_threshold" }
                // Memory cap lives in the __mem_ namespace, not __gc_.
                // Check _set_max_memory before _max_memory: the former also
                // ends with the latter.
                else if (__mp_func.ends_with("_set_max_memory")) { __mp_func = "__mem_set_limit" }
                else if (__mp_func.ends_with("_max_memory")) { __mp_func = "__mem_get_limit" }
                else if (__mp_func.ends_with("_live_bytes")) { __mp_func = "__mem_live_bytes" }
            }
            // An @extern or @intrinsic must be recognised HERE, not only in the
            // module-prefix arm further down at :1630 — this arm intercepts
            // every alias with a non-empty prefix, so that arm never sees one.
            // Falling through emitted `call i64 @stdlib_scheduler_get_yield_reason`:
            // the Saffron-level symbol, which has no definition and no `declare`,
            // so the IR failed verification with "use of undefined value". Same
            // shape as the coroutine defect in this arm (BUGS #91, #38).
            // Registered before called_functions.push so the extern's C symbol,
            // not this name, is what gets declared.
            if (this.str_in_list(this.intrinsic_funcs, __mp_func)) {
                return this.gen_intrinsic_call(__mp_func, args)
            }
            if (this.extern_sigs.has(__mp_func)) {
                return this.gen_extern_call(__mp_func, args)
            }
            this.called_functions.push(__mp_func)

            // Check if this is a class constructor: class_fields has the method name
            // or the prefixed name, meaning it's a class not a plain function
            var __mp_is_ctor: Bool = false
            if (this.class_fields.has(method) or this.class_fields.has(__mp_func)) {
                __mp_is_ctor = true
            }

            if (__mp_is_ctor) {
                // Constructor: alloc instance, then call __init with args
                var __mp_instance: String = this.fresh_local()
                this.emit_indent(__mp_instance + " = call i64 @" + __mp_func + "()")
                // Find and call __init
                var __mp_init: String = __mp_func + "__init"
                if (this.str_in_list(this.known_functions,__mp_init)) {
                    var __mp_init_args: List<String> = []
                    __mp_init_args.push("i64 " + __mp_instance)
                    var __mpi: Float = 0
                    while (__mpi < args.length()) {
                        __mp_init_args.push("i64 " + this.gen_arg_value(args[__mpi]))
                        __mpi = __mpi + 1
                    }
                    var __mp_discard: String = this.fresh_local()
                    this.emit_indent(__mp_discard + " = call i64 @" + __mp_init + "(" + __mp_init_args.join(", ") + ")")
                }
                this.last_type = this.str_to_type(method)
                return __mp_instance
            }

            // IO.println / IO.print: pass value directly to runtime dispatch.
            // __io_println / __io_print handle all NaN-boxed types at runtime.
            // In identity mode (bootstrap), only strings reach here so raw pointer is safe.
            if ((__mp_func.starts_with("__io_println") or __mp_func.starts_with("__io_print")) and args.length() > 0) {
                var __io_arg: String = this.gen_arg_value(args[0])
                // An enum value is NOT self-describing at runtime (BUGS #105).
                // A fieldless variant is the bare immediate `tag << 56`, which
                // carries no NaN-box tag at all, so __io_println concluded it was
                // an unboxed double and printed the raw bit pattern: `Color.Red`
                // (0 << 56) as "0" and `Color.Green` (1 << 56) as "7.29112e-304".
                // A payload variant is an untagged heap [tag, f0, ...] pointer,
                // which reads as a denormal and printed as "5.21502e-310".
                //
                // Convert here, through the enum's own generated to_string, rather
                // than teaching __io_println the `tag << 56` encoding: that would
                // put the encoding in a second place that must be kept in step with
                // gen_enum_construct and emit_enum_to_string. String interpolation
                // was already correct precisely because the lexer inserts an
                // explicit .to_string() call, so routing here makes println use the
                // one path interpolation already uses instead of a parallel one.
                //
                // gen_arg_value has just run, so last_type is the argument's type —
                // and gen_enum_construct sets it to EnumType(name) even though
                // get_expr_type reports a bare "Any" for the same expression.
                var __io_ty: String = this.type_to_string(this.last_type)
                if (this.enum_defs.has(__io_ty)) {
                    var __io_ts: String = this.fresh_local()
                    this.emit_indent(__io_ts + " = call i64 @" + __io_ty + "__to_string(i64 " + __io_arg + ")")
                    __io_arg = this.fresh_local()
                    this.emit_indent(__io_arg + " = call i64 @__rt_tag_ptr(i64 " + __io_ts + ")")
                }
                var __io_discard: String = this.fresh_local()
                this.emit_indent(__io_discard + " = call i64 @" + __mp_func + "(i64 " + __io_arg + ")")
                this.last_type = AST.Type.NilType
                return "0"
            }

            // Named arg reordering + trailing closure + default filling
            var __mp_reordered: List<AST.Expr> = args
            var __mp_has_named: Bool = false
            var __mp_tc_applied: Bool = false
            // Trailing closure: last arg is lambda and fewer args than params
            if (this.func_param_names.has(__mp_func) and args.length() > 0) {
                var __mp_pnames: List<String> = this.func_param_names.get(__mp_func)
                var __mp_tc_last: AST.Expr = args[args.length() - 1]
                if (this.classify_expr(__mp_tc_last) == "lambda" and args.length() < __mp_pnames.length()) {
                    var __mp_tc_args: List<AST.Expr> = []
                    var __mp_tci: Float = 0
                    while (__mp_tci < args.length() - 1) {
                        __mp_tc_args.push(args[__mp_tci])
                        __mp_tci = __mp_tci + 1
                    }
                    var __mp_tc_has_named: Bool = false
                    var __mp_tcni: Float = 0
                    while (__mp_tcni < __mp_tc_args.length()) {
                        if (this.classify_expr(__mp_tc_args[__mp_tcni]) == "assign") {
                            __mp_tc_has_named = true
                        }
                        __mp_tcni = __mp_tcni + 1
                    }
                    var __mp_tc_new: List<AST.Expr> = []
                    if (__mp_tc_has_named) {
                        var __mp_pos_idx: Float = 0
                        var __mp_pi: Float = 0
                        while (__mp_pi < __mp_pnames.length() - 1) {
                            var __mp_pn: String = __mp_pnames[__mp_pi]
                            var __mp_found: Bool = false
                            var __mp_si: Float = 0
                            while (__mp_si < __mp_tc_args.length()) {
                                if (this.classify_expr(__mp_tc_args[__mp_si]) == "assign") {
                                    var __mp_an: String = match (__mp_tc_args[__mp_si]) { Assign(n, v) => n
                                        _ => ""
                                    }
                                    if (__mp_an == __mp_pn) {
                                        var __mp_av: AST.Expr = match (__mp_tc_args[__mp_si]) { Assign(n, v) => v
                                            _ => AST.Expr.NilLit
                                        }
                                        __mp_tc_new.push(__mp_av)
                                        __mp_found = true
                                    }
                                }
                                __mp_si = __mp_si + 1
                            }
                            if (!__mp_found) {
                                var __mp_used_pos: Bool = false
                                while (__mp_pos_idx < __mp_tc_args.length() and !__mp_used_pos) {
                                    if (this.classify_expr(__mp_tc_args[__mp_pos_idx]) != "assign") {
                                        __mp_tc_new.push(__mp_tc_args[__mp_pos_idx])
                                        __mp_pos_idx = __mp_pos_idx + 1
                                        __mp_used_pos = true
                                    } else {
                                        __mp_pos_idx = __mp_pos_idx + 1
                                    }
                                }
                                if (!__mp_used_pos) {
                                    __mp_tc_new.push(AST.Expr.NilLit)
                                }
                            }
                            __mp_pi = __mp_pi + 1
                        }
                    } else {
                        __mp_tci = 0
                        while (__mp_tci < __mp_tc_args.length()) {
                            __mp_tc_new.push(__mp_tc_args[__mp_tci])
                            __mp_tci = __mp_tci + 1
                        }
                        while (__mp_tc_new.length() < __mp_pnames.length() - 1) {
                            __mp_tc_new.push(AST.Expr.NilLit)
                        }
                    }
                    __mp_tc_new.push(__mp_tc_last)
                    __mp_reordered = __mp_tc_new
                    __mp_has_named = true
                    __mp_tc_applied = true
                }
            }
            // Check for named args (non-trailing-closure case)
            var __mp_nai: Float = 0
            while (__mp_nai < args.length()) {
                if (this.classify_expr(args[__mp_nai]) == "assign") {
                    __mp_has_named = true
                }
                __mp_nai = __mp_nai + 1
            }
            if (__mp_has_named and this.func_param_names.has(__mp_func) and !__mp_tc_applied) {
                var __mp_pnames2: List<String> = this.func_param_names.get(__mp_func)
                var __mp_new_args: List<AST.Expr> = []
                var __mp_pos_idx2: Float = 0
                var __mp_pi2: Float = 0
                while (__mp_pi2 < __mp_pnames2.length()) {
                    var __mp_pn2: String = __mp_pnames2[__mp_pi2]
                    var __mp_found2: Bool = false
                    var __mp_si2: Float = 0
                    while (__mp_si2 < args.length()) {
                        if (this.classify_expr(args[__mp_si2]) == "assign") {
                            var __mp_an2: String = match (args[__mp_si2]) { Assign(n, v) => n
                                _ => ""
                            }
                            if (__mp_an2 == __mp_pn2) {
                                var __mp_av2: AST.Expr = match (args[__mp_si2]) { Assign(n, v) => v
                                    _ => AST.Expr.NilLit
                                }
                                __mp_new_args.push(__mp_av2)
                                __mp_found2 = true
                            }
                        }
                        __mp_si2 = __mp_si2 + 1
                    }
                    if (!__mp_found2) {
                        var __mp_used_pos2: Bool = false
                        while (__mp_pos_idx2 < args.length() and !__mp_used_pos2) {
                            if (this.classify_expr(args[__mp_pos_idx2]) != "assign") {
                                __mp_new_args.push(args[__mp_pos_idx2])
                                __mp_pos_idx2 = __mp_pos_idx2 + 1
                                __mp_used_pos2 = true
                            } else {
                                __mp_pos_idx2 = __mp_pos_idx2 + 1
                            }
                        }
                        if (!__mp_used_pos2) {
                            __mp_new_args.push(AST.Expr.NilLit)
                        }
                    }
                    __mp_pi2 = __mp_pi2 + 1
                }
                __mp_reordered = __mp_new_args
            }
            var __mp_args: List<String> = []
            var __mpi: Float = 0
            while (__mpi < __mp_reordered.length()) {
                var __mp_used_def: Bool = false
                if (__mp_has_named and this.classify_expr(__mp_reordered[__mpi]) == "nil" and this.func_defaults.has(__mp_func)) {
                    var __mp_defs: List<AST.Expr> = this.func_defaults.get(__mp_func)
                    if (__mpi < __mp_defs.length() and this.classify_expr(__mp_defs[__mpi]) != "nil") {
                        var __mp_def_val: String = this.gen_arg_value(__mp_defs[__mpi])
                        __mp_args.push("i64 " + __mp_def_val)
                        __mp_used_def = true
                    }
                }
                if (!__mp_used_def) {
                    __mp_args.push("i64 " + this.gen_arg_value(__mp_reordered[__mpi]))
                }
                __mpi = __mpi + 1
            }
            // Fill missing args with defaults
            if (this.func_defaults.has(__mp_func)) {
                var __mp_defaults: List<AST.Expr> = this.func_defaults.get(__mp_func)
                var __mp_param_count: Float = __mp_defaults.length()
                if (this.func_param_names.has(__mp_func)) {
                    var __mp_pc2: Float = this.func_param_names.get(__mp_func).length()
                    if (__mp_pc2 > __mp_param_count) { __mp_param_count = __mp_pc2 }
                }
                while (__mpi < __mp_param_count) {
                    if (__mpi < __mp_defaults.length()) {
                        var __mp_de: AST.Expr = __mp_defaults[__mpi]
                        if (this.classify_expr(__mp_de) != "nil") {
                            __mp_args.push("i64 " + this.gen_arg_value(__mp_de))
                        } else {
                            var __mp_nil_val: String = this.fresh_local()
                            this.emit_indent(__mp_nil_val + " = call i64 @__val_nil()")
                            __mp_args.push("i64 " + __mp_nil_val)
                        }
                    } else {
                        var __mp_nil_val: String = this.fresh_local()
                        this.emit_indent(__mp_nil_val + " = call i64 @__val_nil()")
                        __mp_args.push("i64 " + __mp_nil_val)
                    }
                    __mpi = __mpi + 1
                }
            } else if (this.func_param_names.has(__mp_func)) {
                var __mp_param_count: Float = this.func_param_names.get(__mp_func).length()
                while (__mp_args.length() < __mp_param_count) {
                    var __mp_nil_val: String = this.fresh_local()
                    this.emit_indent(__mp_nil_val + " = call i64 @__val_nil()")
                    __mp_args.push("i64 " + __mp_nil_val)
                }
            }
            // Coroutine target: drive the frame instead of emitting `call i64`
            // against a `ptr`-returning presplitcoroutine (BUGS #38). This arm
            // catches every alias with a non-empty prefix, so it reaches here
            // before the coro-aware arms further down at :1608/:1658 — those only
            // ever ran for empty-prefix builtins (IO/OS/GC), which is why
            // `Async.sleep` lowered to a bare call and never suspended.
            if (this.str_in_list(this.coroutine_funcs, __mp_func)) {
                var __mp_coro: String = this.gen_coro_call(__mp_func, __mp_args)
                if (this.func_ret_types.has(__mp_func)) {
                    this.last_type = this.func_ret_types.get(__mp_func)
                } else if (this.func_ret_types.has(method)) {
                    this.last_type = this.func_ret_types.get(method)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return __mp_coro
            }
            var __mp_local: String = this.fresh_local()
            this.emit_indent(__mp_local + " = call i64 @" + __mp_func + "(" + __mp_args.join(", ") + ")")
            if (this.func_ret_types.has(__mp_func)) {
                this.last_type = this.func_ret_types.get(__mp_func)
            } else {
                this.last_type = AST.Type.IntType
            }
            // Box the result of a builtin runtime symbol per its declared
            // discipline. See runtime_ret_discipline above for why this is one
            // table rather than three `or` chains, and for the alias omission
            // (`__io_readln`/`__io_read_line`) that shape hid.
            var __mp_disc: String = this.runtime_ret_discipline(__mp_func)
            if (__mp_disc == "string") {
                var __tag_ptr: String = this.fresh_local()
                this.emit_indent(__tag_ptr + " = inttoptr i64 " + __mp_local + " to i8*")
                var __tagged: String = this.emit_tag_ptr(__tag_ptr)
                this.last_type = AST.Type.StringType
                return __tagged
            }
            if (__mp_disc == "bool") {
                var __tagged: String = this.emit_tag_bool(__mp_local)
                this.last_type = AST.Type.BoolType
                return __tagged
            }
            if (__mp_disc == "int") {
                var __tagged: String = this.emit_tag_int(__mp_local)
                this.last_type = AST.Type.IntType
                return __tagged
            }
            // "list" and "void" fall through deliberately untagged — see the
            // __gc_is_heap_ptr caveat in runtime_ret_discipline.
            return __mp_local
        }
    }



    // Package namespace dispatch (fallback path): same as the early check above,
    // handles cases that reach here after failing earlier conditions.
    if (obj_name.length() > 0 and this.named_imports.has(obj_name + "." + method)) {
        var __pe2_target: String = this.named_imports.get(obj_name + "." + method)
        this.called_functions.push(__pe2_target)
        this.called_function_arity.set(__pe2_target, args.length())
        var __pe2_is_ctor: Bool = false
        if (this.class_fields.has(method) or this.class_fields.has(__pe2_target)) {
            __pe2_is_ctor = true
        }
        if (__pe2_is_ctor) {
            var __pe2_inst: String = this.fresh_local()
            this.emit_indent(__pe2_inst + " = call i64 @" + __pe2_target + "()")
            var __pe2_init: String = __pe2_target + "__init"
            if (this.str_in_list(this.known_functions, __pe2_init)) {
                var __pe2_iargs: List<String> = []
                __pe2_iargs.push("i64 " + __pe2_inst)
                var __pe2i: Float = 0
                while (__pe2i < args.length()) {
                    __pe2_iargs.push("i64 " + this.gen_arg_value(args[__pe2i]))
                    __pe2i = __pe2i + 1
                }
                var __pe2_d: String = this.fresh_local()
                this.emit_indent(__pe2_d + " = call i64 @" + __pe2_init + "(" + __pe2_iargs.join(", ") + ")")
            }
            this.last_type = this.str_to_type(method)
            return __pe2_inst
        }
        var __pe2_args: List<String> = []
        var __pe2ai: Float = 0
        while (__pe2ai < args.length()) {
            __pe2_args.push("i64 " + this.gen_arg_value(args[__pe2ai]))
            __pe2ai = __pe2ai + 1
        }
        // Coroutine target — see the __pe_target arm above (BUGS #38).
        if (this.str_in_list(this.coroutine_funcs, __pe2_target)) {
            var __pe2_coro: String = this.gen_coro_call(__pe2_target, __pe2_args)
            if (this.func_ret_types.has(__pe2_target)) {
                this.last_type = this.func_ret_types.get(__pe2_target)
            }
            return __pe2_coro
        }
        var __pe2_r: String = this.fresh_local()
        this.emit_indent(__pe2_r + " = call i64 @" + __pe2_target + "(" + __pe2_args.join(", ") + ")")
        if (this.func_ret_types.has(__pe2_target)) {
            this.last_type = this.func_ret_types.get(__pe2_target)
        }
        return __pe2_r
    }

    // Check for module-qualified function calls BEFORE loading the object.
    // This avoids emitting a spurious `load i64, i64* %ModuleName` for module aliases
    // (e.g. AST.type_to_string → would load %AST which is undefined as a value).
    if (obj_name.length() > 0 and this.module_prefixes.has(obj_name)) {
        var prefixed_name: String = this.module_prefixes.get(obj_name) + method
        // Intrinsic check: if the target is an intrinsic, emit inline IR instead of a call
        if (this.str_in_list(this.intrinsic_funcs, prefixed_name)) {
            return this.gen_intrinsic_call(prefixed_name, args)
        }
        // Extern check: if the target is an extern C function, emit the proper extern call
        if (this.extern_sigs.has(prefixed_name)) {
            return this.gen_extern_call(prefixed_name, args)
        }
        var arg_strs: List<String> = []
        var ai: Float = 0
        while (ai < args.length()) {
            var val: String = this.gen_arg_value(args[ai])
            arg_strs.push("i64 " + val)
            ai = ai + 1
        }
        this.called_functions.push(prefixed_name)
        this.called_function_arity.set(prefixed_name, args.length())
        // Coro-calls-coro: if this is a coroutine calling another coroutine,
        // emit the await loop pattern (call as ptr, suspend/resume until done)
        if (this.is_coroutine and this.str_in_list(this.coroutine_funcs, prefixed_name)) {
            var b_hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(b_hdl, "ptr", prefixed_name, arg_strs.join(", ")))
            } else {
                this.emit_indent(b_hdl + " = call ptr @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
            }
            var b_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(b_i64, b_hdl))
            } else {
                this.emit_indent(b_i64 + " = ptrtoint ptr " + b_hdl + " to i64")
            }
            var ac: String = this.fresh_label("await.check")
            var ay: String = this.fresh_label("await.yield")
            var al: String = this.fresh_label("await.loop")
            var acl: String = this.fresh_label("await.cleanup")
            var ad: String = this.fresh_label("await.done")
            this.emit_terminator("br label %" + ac)
            this.start_block(ac)
            var bd: String = this.fresh_local()
            this.emit_indent(bd + " = call i64 @__sched_coro_done(i64 " + b_i64 + ")")
            var bdc: String = this.fresh_local()
            this.emit_indent(bdc + " = icmp eq i64 " + bd + ", 1")
            this.emit_terminator("br i1 " + bdc + ", label %" + ad + ", label %" + ay)
            this.start_block(ay)
            // Propagate child's yield_reason/yield_arg — don't overwrite
            var st: String = this.fresh_local()
            this.emit_indent(st + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var sr: String = this.fresh_local()
            this.emit_indent(sr + " = call i8 @llvm.coro.suspend(token " + st + ", i1 false)")
            this.emit_terminator("switch i8 " + sr + ", label %__coro_suspend [i8 0, label %" + al + " i8 1, label %" + acl + "]")
            this.start_block(acl)
            this.emit_terminator("br label %__coro_cleanup")
            this.start_block(al)
            this.emit_indent("call void @__sched_coro_resume(i64 " + b_i64 + ")")
            this.emit_terminator("br label %" + ac)
            this.start_block(ad)
            var coro_result: String = this.fresh_local()
            this.emit_indent(coro_result + " = load i64, i64* @__task_result")
            if (this.func_ret_types.has(prefixed_name)) {
                this.last_type = this.func_ret_types.get(prefixed_name)
            } else if (this.func_ret_types.has(method)) {
                this.last_type = this.func_ret_types.get(method)
            } else {
                this.last_type = AST.Type.IntType
            }
            return coro_result
        }
        // Sync-calls-coro: non-coroutine calling a coroutine — drive to completion
        if (!this.is_coroutine and this.str_in_list(this.coroutine_funcs, prefixed_name)) {
            var s_hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(s_hdl, "ptr", prefixed_name, arg_strs.join(", ")))
            } else {
                this.emit_indent(s_hdl + " = call ptr @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
            }
            var s_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(s_i64, s_hdl))
            } else {
                this.emit_indent(s_i64 + " = ptrtoint ptr " + s_hdl + " to i64")
            }
            var sc: String = this.fresh_label("sync.check")
            var sl: String = this.fresh_label("sync.loop")
            var sd: String = this.fresh_label("sync.done")
            this.emit_terminator("br label %" + sc)
            this.start_block(sc)
            var s_done: String = this.fresh_local()
            this.emit_indent(s_done + " = call i64 @__sched_coro_done(i64 " + s_i64 + ")")
            var s_cmp: String = this.fresh_local()
            this.emit_indent(s_cmp + " = icmp eq i64 " + s_done + ", 1")
            this.emit_terminator("br i1 " + s_cmp + ", label %" + sd + ", label %" + sl)
            this.start_block(sl)
            this.emit_indent("call void @__sched_coro_resume(i64 " + s_i64 + ")")
            this.emit_terminator("br label %" + sc)
            this.start_block(sd)
            var s_result: String = this.fresh_local()
            this.emit_indent(s_result + " = load i64, i64* @__task_result")
            if (this.func_ret_types.has(prefixed_name)) {
                this.last_type = this.func_ret_types.get(prefixed_name)
            } else if (this.func_ret_types.has(method)) {
                this.last_type = this.func_ret_types.get(method)
            } else {
                this.last_type = AST.Type.IntType
            }
            return s_result
        }
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", prefixed_name, arg_strs.join(", ")))
        } else {
            this.emit_indent(local + " = call i64 @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
        }
        if (this.func_ret_types.has(prefixed_name)) {
            this.last_type = this.func_ret_types.get(prefixed_name)
        } else if (this.func_ret_types.has(method)) {
            this.last_type = this.func_ret_types.get(method)
        } else {
            this.last_type = AST.Type.IntType
        }
        return local
    }

    // Check for enum constructor: EnumName.Variant(args) — MUST come before builtin dispatch
    if (obj_name.length() > 0) {
        var enum_key: String = obj_name + "." + method
        if (this.enum_variant_tags.has(enum_key)) {
            return this.gen_enum_construct(obj_name, method, args)
        }
        // Fallback: check enum_defs in case enum_variant_tags lookup misses
        // (e.g. when enum name == variant name: enum Token { Token(...) })
        if (this.enum_defs.has(obj_name)) {
            var variants: List = this.enum_defs.get(obj_name)
            if (variants.contains(method)) {
                return this.gen_enum_construct(obj_name, method, args)
            }
        }
    }
    if (obj_name.length() == 0) {
        var obj_kind: String = this.classify_expr(object)
        if (obj_kind == "member") {
            var inner_field: String = match (object) { MemberAccess(o, f) => f
                _ => ""
            }
            var enum_key2: String = inner_field + "." + method
            if (this.enum_variant_tags.has(enum_key2)) {
                return this.gen_enum_construct(inner_field, method, args)
            }
        }
    }

    // --- Task.spawn(fn) ---
    if (method == "spawn" and obj_name == "Task") {
        // Infer the task's result type from the lambda's return type
        var task_result_type: String = "Int"
        var spawn_expr_kind: String = this.classify_expr(args[0])
        if (spawn_expr_kind == "lambda") {
            var lambda_ret: String = match (args[0]) { Lambda(p, r, b) => r   _ => "Int" }
            if (lambda_ret.length() > 0 and lambda_ret != "Any" and lambda_ret != "Int") {
                task_result_type = lambda_ret
            } else {
                // Infer from body: if body is [Return(Call(f, ...))] use f's return type
                var lambda_body: List<AST.Stmt> = match (args[0]) { Lambda(p, r, b) => b   _ => [] }
                if (lambda_body.length() == 1) {
                    var lb_kind: String = this.classify_stmt(lambda_body[0])
                    if (lb_kind == "return") {
                        var ret_expr: AST.Expr = match (lambda_body[0]) { Return(v) => v   _ => AST.Expr.NilLit }
                        var ret_ek: String = this.classify_expr(ret_expr)
                        if (ret_ek == "call") {
                            var ret_callee: AST.Expr = match (ret_expr) { Call(c, a) => c   _ => AST.Expr.NilLit }
                            var ret_callee_name: String = this.get_variable_name(ret_callee)
                            if (ret_callee_name.length() > 0) {
                                var prefixed_callee: String = this.current_prefix + ret_callee_name
                                if (this.func_ret_types.has(prefixed_callee)) {
                                    task_result_type = this.type_to_string(this.func_ret_types.get(prefixed_callee))
                                } else if (this.func_ret_types.has(ret_callee_name)) {
                                    task_result_type = this.type_to_string(this.func_ret_types.get(ret_callee_name))
                                }
                            }
                        } else if (ret_ek == "method_call") {
                            var mc_method_name: String = match (ret_expr) { MethodCall(o, m, a) => m   _ => "" }
                            var mc_obj_expr: AST.Expr = match (ret_expr) { MethodCall(o, m, a) => o   _ => AST.Expr.NilLit }
                            var mc_ns: String = this.get_variable_name(mc_obj_expr)
                            if (mc_ns.length() > 0 and this.module_prefixes.has(mc_ns)) {
                                var mc_full: String = this.module_prefixes.get(mc_ns) + mc_method_name
                                if (this.func_ret_types.has(mc_full)) {
                                    task_result_type = this.type_to_string(this.func_ret_types.get(mc_full))
                                }
                            }
                        }
                    }
                }
            }
        }
        // Get the lambda as a function pointer (i64)
        // Force the lambda to be a coroutine (Task.spawn expects a coro handle)
        this.force_next_lambda_coro = true
        this.check_spawn_sendable = true
        var spawn_arg: String = this.gen_arg_value(args[0])
        // Check if the lambda/function is a coroutine
        // Lambda names start with __lambda — check if in coroutine_funcs
        var spawn_fn_name: String = this.get_variable_name(args[0])
        var is_coro_spawn: Bool = false
        if (spawn_fn_name.length() > 0 and this.str_in_list(this.coroutine_funcs, spawn_fn_name)) {
            is_coro_spawn = true
        }
        // Also check the last-generated lambda
        if (!is_coro_spawn) {
            var li: Float = this.coroutine_funcs.length() - 1
            while (li >= 0) {
                var cf: String = this.coroutine_funcs[li]
                if (cf.starts_with("__lambda")) { is_coro_spawn = true; li = -1 }
                li = li - 1
            }
        }
        // spawn_arg is a closure: [fn_ptr, env_ptr] packed as [2 x i64]*
        var closure_ptr: String = this.val_to_typed_ptr(spawn_arg, "[2 x i64]*")
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        var fn_i64: String = this.fresh_local()
        this.emit_indent(fn_i64 + " = load i64, i64* " + fn_slot)
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        var env_i64: String = this.fresh_local()
        this.emit_indent(env_i64 + " = load i64, i64* " + env_slot)
        var fn_ptr: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_inttoptr(fn_ptr, fn_i64))
        } else {
            this.emit_indent(fn_ptr + " = inttoptr i64 " + fn_i64 + " to ptr")
        }
        var task_hdl: String = this.fresh_local()
        this.emit_indent(task_hdl + " = call ptr " + fn_ptr + "(i64 " + env_i64 + ")")
        var task_i64: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_ptrtoint(task_i64, task_hdl))
        } else {
            this.emit_indent(task_i64 + " = ptrtoint ptr " + task_hdl + " to i64")
        }
        // If the task completed synchronously (e.g. no real suspend points),
        // save its result immediately before another spawn could overwrite @__task_result.
        // Don't enqueue already-done tasks (the scheduler would read stale @__task_result).
        var spawn_done: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(spawn_done, "i64", "__sched_coro_done", "i64 " + task_i64))
        } else {
            this.emit_indent(spawn_done + " = call i64 @__sched_coro_done(i64 " + task_i64 + ")")
        }
        var spawn_done_cmp: String = this.fresh_local()
        this.emit_indent(spawn_done_cmp + " = icmp eq i64 " + spawn_done + ", 1")
        var spawn_save_label: String = this.fresh_label("spawn.save")
        var spawn_enqueue_label: String = this.fresh_label("spawn.enqueue")
        var spawn_cont_label: String = this.fresh_label("spawn.cont")
        this.emit_terminator("br i1 " + spawn_done_cmp + ", label %" + spawn_save_label + ", label %" + spawn_enqueue_label)
        this.start_block(spawn_save_label)
        var spawn_res: String = this.fresh_local()
        this.emit_indent(spawn_res + " = load i64, i64* @__task_result")
        this.emit_indent("call void @__sched_store_result(i64 " + task_i64 + ", i64 " + spawn_res + ")")
        this.called_functions.push("__sched_store_result")
        this.emit_terminator("br label %" + spawn_cont_label)
        this.start_block(spawn_enqueue_label)
        // Only enqueue tasks that haven't completed yet
        var enqueue_name: String = "enqueue"
        if (this.known_functions.contains("stdlib_scheduler_enqueue")) {
            enqueue_name = "stdlib_scheduler_enqueue"
        }
        this.emit_indent("call i64 @" + enqueue_name + "(i64 " + task_i64 + ")")
        this.called_functions.push(enqueue_name)
        this.emit_terminator("br label %" + spawn_cont_label)
        this.start_block(spawn_cont_label)
        this.last_type = this.str_to_type(task_result_type)
        return task_i64
    }

    // --- Task methods: isReady() and getResult() ---
    if (method == "isReady") {
        var task_val: String = this.gen_arg_value(object)
        var task_ptr: String = this.fresh_local()
        this.emit_indent(task_ptr + " = inttoptr i64 " + task_val + " to ptr")
        var done_i1: String = this.fresh_local()
        this.emit_indent(done_i1 + " = call i1 @llvm.coro.done(ptr " + task_ptr + ")")
        var done_i64: String = this.fresh_local()
        this.emit_indent(done_i64 + " = zext i1 " + done_i1 + " to i64")
        this.last_type = AST.Type.BoolType
        return done_i64
    }
    if (method == "getResult") {
        var gr_obj_name: String = this.get_variable_name(object)
        // Unknown, not Int (BUGS #32). get_variable_name only answers for a bare
        // Variable, so `tasks[i].getResult()` yields "" and we learn nothing about
        // the result type. Any routes such values through the runtime-dispatching
        // helpers (__any_length etc.); Int sent a String straight to __list_length.
        var gr_result_type: AST.Type = AST.Type.AnyType
        if (gr_obj_name.length() > 0 and this.typed_vars.has(gr_obj_name)) {
            gr_result_type = this.typed_vars.get(gr_obj_name)
        }
        var task_val: String = this.gen_arg_value(object)
        var result_val: String = this.fresh_local()
        this.emit_indent(result_val + " = call i64 @__sched_get_stored_result(i64 " + task_val + ")")
        this.called_functions.push("__sched_get_stored_result")
        this.last_type = gr_result_type
        return result_val
    }
    // task.await() — from top-level: run scheduler then read result
    if (method == "await" and !this.is_coroutine) {
        // Determine the task's result type from the task variable's stored type
        var await_obj_name: String = this.get_variable_name(object)
        // Falls back to Any, not Int — see the note on getResult above (BUGS #32).
        var await_result_type: AST.Type = AST.Type.AnyType
        if (await_obj_name.length() > 0 and this.typed_vars.has(await_obj_name)) {
            await_result_type = this.typed_vars.get(await_obj_name)
        }
        var task_val: String = this.gen_arg_value(object)
        var sched_run_name: String = "scheduler_run"
        if (this.known_functions.contains("stdlib_scheduler_scheduler_run")) {
            sched_run_name = "stdlib_scheduler_scheduler_run"
        }
        this.emit_indent("call i64 @" + sched_run_name + "()")
        this.called_functions.push(sched_run_name)
        // Use the C-level per-task result storage (handles multi-task races)
        var result_val: String = this.fresh_local()
        this.emit_indent(result_val + " = call i64 @__sched_get_stored_result(i64 " + task_val + ")")
        this.called_functions.push("__sched_get_stored_result")
        this.last_type = await_result_type
        return result_val
    }
    // task.await() — from coroutine: loop suspend/resume until task is done
    if (method == "await" and this.is_coroutine) {
        // Determine the task's result type from the task variable's stored type
        var await_obj_name: String = this.get_variable_name(object)
        // Falls back to Any, not Int — see the note on getResult above (BUGS #32).
        var await_result_type: AST.Type = AST.Type.AnyType
        if (await_obj_name.length() > 0 and this.typed_vars.has(await_obj_name)) {
            await_result_type = this.typed_vars.get(await_obj_name)
        }
        var task_val: String = this.gen_arg_value(object)
        // Loop: check if task is done, if not suspend and retry
        var await_check: String = this.fresh_label("task.await.check")
        var await_suspend: String = this.fresh_label("task.await.suspend")
        var await_loop: String = this.fresh_label("task.await.loop")
        var await_cleanup: String = this.fresh_label("task.await.cleanup")
        var await_done: String = this.fresh_label("task.await.done")
        this.emit_terminator("br label %" + await_check)
        this.start_block(await_check)
        var done_val: String = this.fresh_local()
        this.emit_indent(done_val + " = call i64 @__sched_coro_done(i64 " + task_val + ")")
        var done_cmp: String = this.fresh_local()
        this.emit_indent(done_cmp + " = icmp eq i64 " + done_val + ", 1")
        this.emit_terminator("br i1 " + done_cmp + ", label %" + await_done + ", label %" + await_suspend)
        this.start_block(await_suspend)
        this.emit_indent("store i64 3, i64* @__yield_reason")
        this.emit_indent("store i64 " + task_val + ", i64* @__yield_arg")
        var save_tok: String = this.fresh_local()
        this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
        var susp: String = this.fresh_local()
        this.emit_indent(susp + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")
        this.emit_terminator("switch i8 " + susp + ", label %__coro_suspend [i8 0, label %" + await_loop + " i8 1, label %" + await_cleanup + "]")
        this.start_block(await_cleanup)
        this.emit_terminator("br label %__coro_cleanup")
        this.start_block(await_loop)
        this.emit_terminator("br label %" + await_check)
        this.start_block(await_done)
        // Task is done — read its stored result
        var result_val: String = this.fresh_local()
        this.emit_indent(result_val + " = call i64 @__sched_get_stored_result(i64 " + task_val + ")")
        this.called_functions.push("__sched_get_stored_result")
        this.last_type = await_result_type
        return result_val
    }

    // --- Builtin dispatch (only for non-class objects) ---
    var obj: String = this.gen_arg_value(object)
    var is_user_class: Bool = false
    if (obj_name.length() > 0) {
        var uc_type: String = this.get_var_type_str(obj_name)
        var uc_resolved: String = this.resolve_class_type(uc_type)
        if (uc_resolved.length() > 0) {
            is_user_class = true
        }
    }
    // Also check last_type after evaluation (handles chained field access like this.field.method())
    if (!is_user_class) {
        var eval_type: String = this.type_to_string(this.last_type)
        var eval_resolved: String = this.resolve_class_type(eval_type)
        if (eval_resolved.length() > 0) {
            is_user_class = true
        }
    }
    // Fallback: if type resolution failed but a user class defines this method,
    // treat as user class dispatch. Skip known builtin methods (length, push, etc.)
    // to avoid hijacking built-in container dispatch.
    var __uc_is_builtin_method: Bool = method == "keys" or method == "values" or method == "has" or method == "get" or method == "set" or method == "length" or method == "push" or method == "pop" or method == "contains" or method == "split" or method == "join" or method == "slice" or method == "reverse" or method == "sort" or method == "copy" or method == "trim" or method == "replace" or method == "index_of" or method == "starts_with" or method == "ends_with" or method == "to_upper" or method == "to_lower" or method == "repeat" or method == "char_at" or method == "to_number" or method == "to_string" or method == "to_float" or method == "abs" or method == "floor" or method == "ceil"
    if (!is_user_class and !__uc_is_builtin_method and args.length() == 0) {
        var __uc_fcm: String = this.find_class_for_method(method)
        if (__uc_fcm.length() > 0 and __uc_fcm != "String" and __uc_fcm != "List" and __uc_fcm != "Map" and __uc_fcm != "Int" and __uc_fcm != "Float" and __uc_fcm != "Bool") {
            is_user_class = true
        }
    }

    // --- List method dispatch (type-aware, replaces builtin_methods for List) ---
    if (!is_user_class) {
        var __list_obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        var __list_is_any: Bool = __list_obj_type == "Any"
        var __list_any_skip: Bool = false
        if (__list_is_any) {
            var __fcm: String = this.find_class_for_method(method)
            if (__fcm.length() > 0 and __fcm != "String" and __fcm != "List" and __fcm != "Map" and __fcm != "Int" and __fcm != "Float" and __fcm != "Bool") {
                __list_any_skip = true
            }
        }
        var __list_type_match: Bool = __list_obj_type.starts_with("List") or __list_is_any
        var __list_meth_match: Bool = method == "push" or method == "pop" or method == "remove" or method == "reverse" or method == "copy" or method == "sort" or method == "join"
        if (!__list_any_skip and __list_type_match and __list_meth_match) {
            var __list_saved_type: AST.Type = this.last_type
            if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
                __list_saved_type = this.typed_vars.get(obj_name)
            }
            if (method == "push") {
                var __lp_val: String = this.gen_arg_value(args[0])
                var __lp_discard: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lp_discard, "i64", "__list_push", "i64 " + obj + ", i64 " + __lp_val))
                } else {
                    this.emit_indent(__lp_discard + " = call i64 @__list_push(i64 " + obj + ", i64 " + __lp_val + ")")
                }
                this.last_type = AST.Type.NilType
                return "0"
            }
            if (method == "pop") {
                var __lpop_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lpop_local, "i64", "__list_pop", "i64 " + obj))
                } else {
                    this.emit_indent(__lpop_local + " = call i64 @__list_pop(i64 " + obj + ")")
                }
                var __pop_elem: AST.Type = this.get_list_element_type(__list_saved_type)
                if (this.type_to_string(__pop_elem) != "Any") {
                    this.last_type = __pop_elem
                } else {
                    this.last_type = AST.Type.IntType
                }
                return __lpop_local
            }
            if (method == "remove") {
                // @__list_remove takes a RAW i64 index; gen_arg_value returns tagged.
                var __lrm_tagged: String = this.gen_arg_value(args[0])
                var __lrm_val: String = this.emit_untag_int(__lrm_tagged)
                var __lrm_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lrm_local, "i64", "__list_remove", "i64 " + obj + ", i64 " + __lrm_val))
                } else {
                    this.emit_indent(__lrm_local + " = call i64 @__list_remove(i64 " + obj + ", i64 " + __lrm_val + ")")
                }
                var __rm_elem: AST.Type = this.get_list_element_type(__list_saved_type)
                if (this.type_to_string(__rm_elem) != "Any") {
                    this.last_type = __rm_elem
                } else {
                    this.last_type = AST.Type.IntType
                }
                return __lrm_local
            }
            if (method == "reverse") {
                this.called_functions.push("rt_list_reverse")
                var __lrev_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lrev_local, "i64", "rt_list_reverse", "i64 " + obj))
                } else {
                    this.emit_indent(__lrev_local + " = call i64 @rt_list_reverse(i64 " + obj + ")")
                }
                this.last_type = __list_saved_type
                return __lrev_local
            }
            if (method == "copy") {
                this.called_functions.push("rt_list_copy")
                var __lcopy_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lcopy_local, "i64", "rt_list_copy", "i64 " + obj))
                } else {
                    this.emit_indent(__lcopy_local + " = call i64 @rt_list_copy(i64 " + obj + ")")
                }
                this.last_type = __list_saved_type
                return __lcopy_local
            }
            if (method == "sort") {
                this.called_functions.push("rt_list_sort")
                var __lsort_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lsort_local, "i64", "rt_list_sort", "i64 " + obj))
                } else {
                    this.emit_indent(__lsort_local + " = call i64 @rt_list_sort(i64 " + obj + ")")
                }
                this.last_type = __list_saved_type
                return __lsort_local
            }
            if (method == "join") {
                var __ljoin_val: String = this.gen_arg_value(args[0])
                var __ljoin_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__ljoin_local, "i64", "__list_join", "i64 " + obj + ", i64 " + __ljoin_val))
                } else {
                    this.emit_indent(__ljoin_local + " = call i64 @__list_join(i64 " + obj + ", i64 " + __ljoin_val + ")")
                }
                this.last_type = AST.Type.StringType
                return __ljoin_local
            }
        }
    }

    // --- Map method dispatch (type-aware, replaces builtin_methods for Map) ---
    if (!is_user_class) {
        var __map_obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        var __map_type_match: Bool = __map_obj_type.starts_with("Map") or __map_obj_type == "Any"
        if (__map_type_match and method == "keys") {
            var __mk_local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(__mk_local, "i64", "__map_keys", "i64 " + obj))
            } else {
                this.emit_indent(__mk_local + " = call i64 @__map_keys(i64 " + obj + ")")
            }
            // The element type is K, not String. Hardcoding List<String> here
            // made `for (k in m.keys())` on a Map<Int,String> hand each raw Int
            // to string-typed consumers and SEGFAULT. Unannotated maps stay Any.
            this.last_type = this.make_generic_type("List", [this.str_to_type(this.get_map_key_type(__map_obj_type))])
            return __mk_local
        }
        if (__map_type_match and method == "values") {
            this.called_functions.push("__map_values")
            var __mv_local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(__mv_local, "i64", "__map_values", "i64 " + obj))
            } else {
                this.emit_indent(__mv_local + " = call i64 @__map_values(i64 " + obj + ")")
            }
            // Element type is V — see the keys() note above.
            this.last_type = this.make_generic_type("List", [this.str_to_type(this.get_map_value_type(__map_obj_type))])
            return __mv_local
        }
    }

    // --- String method dispatch (type-aware, replaces builtin_methods for String) ---
    if (!is_user_class) {
        var __str_obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        var __str_is_any: Bool = __str_obj_type == "Any"
        var __str_any_skip: Bool = false
        if (__str_is_any) {
            var __sfcm: String = this.find_class_for_method(method)
            if (__sfcm.length() > 0 and __sfcm != "String" and __sfcm != "List" and __sfcm != "Map" and __sfcm != "Int" and __sfcm != "Float" and __sfcm != "Bool") {
                __str_any_skip = true
            }
        }
        var __str_type_match: Bool = __str_obj_type == "String" or __str_is_any
        var __str_meth_match: Bool = method == "trim" or method == "to_upper" or method == "to_lower" or method == "index_of" or method == "repeat" or method == "split" or method == "ends_with" or method == "replace"
        if (!__str_any_skip and __str_type_match and __str_meth_match) {
            if (method == "trim") {
                this.called_functions.push("rt_str_trim")
                var __st_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__st_local, "i64", "rt_str_trim", "i64 " + obj))
                } else {
                    this.emit_indent(__st_local + " = call i64 @rt_str_trim(i64 " + obj + ")")
                }
                var __st_ptr: String = this.fresh_local()
                this.emit_indent(__st_ptr + " = inttoptr i64 " + __st_local + " to i8*")
                var __st_tagged: String = this.emit_tag_ptr(__st_ptr)
                this.last_type = AST.Type.StringType
                return __st_tagged
            }
            if (method == "to_upper") {
                this.called_functions.push("rt_str_to_upper")
                var __su_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__su_local, "i64", "rt_str_to_upper", "i64 " + obj))
                } else {
                    this.emit_indent(__su_local + " = call i64 @rt_str_to_upper(i64 " + obj + ")")
                }
                var __su_ptr: String = this.fresh_local()
                this.emit_indent(__su_ptr + " = inttoptr i64 " + __su_local + " to i8*")
                var __su_tagged: String = this.emit_tag_ptr(__su_ptr)
                this.last_type = AST.Type.StringType
                return __su_tagged
            }
            if (method == "to_lower") {
                this.called_functions.push("rt_str_to_lower")
                var __sl_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__sl_local, "i64", "rt_str_to_lower", "i64 " + obj))
                } else {
                    this.emit_indent(__sl_local + " = call i64 @rt_str_to_lower(i64 " + obj + ")")
                }
                var __sl_ptr: String = this.fresh_local()
                this.emit_indent(__sl_ptr + " = inttoptr i64 " + __sl_local + " to i8*")
                var __sl_tagged: String = this.emit_tag_ptr(__sl_ptr)
                this.last_type = AST.Type.StringType
                return __sl_tagged
            }
            if (method == "index_of") {
                this.called_functions.push("rt_str_index_of")
                this.called_function_arity.set("rt_str_index_of", 2)
                var __si_arg: String = this.gen_arg_value(args[0])
                var __si_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__si_local, "i64", "rt_str_index_of", "i64 " + obj + ", i64 " + __si_arg))
                } else {
                    this.emit_indent(__si_local + " = call i64 @rt_str_index_of(i64 " + obj + ", i64 " + __si_arg + ")")
                }
                var __si_tagged: String = this.emit_tag_int(__si_local)
                this.last_type = AST.Type.IntType
                return __si_tagged
            }
            if (method == "repeat") {
                this.called_functions.push("rt_str_repeat")
                this.called_function_arity.set("rt_str_repeat", 2)
                var __sr_arg: String = this.gen_arg_value(args[0])
                var __sr_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__sr_local, "i64", "rt_str_repeat", "i64 " + obj + ", i64 " + __sr_arg))
                } else {
                    this.emit_indent(__sr_local + " = call i64 @rt_str_repeat(i64 " + obj + ", i64 " + __sr_arg + ")")
                }
                var __sr_ptr: String = this.fresh_local()
                this.emit_indent(__sr_ptr + " = inttoptr i64 " + __sr_local + " to i8*")
                var __sr_tagged: String = this.emit_tag_ptr(__sr_ptr)
                this.last_type = AST.Type.StringType
                return __sr_tagged
            }
            if (method == "split") {
                var __ss_arg: String = this.gen_arg_value(args[0])
                var __ss_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__ss_local, "i64", "__str_split", "i64 " + obj + ", i64 " + __ss_arg))
                } else {
                    this.emit_indent(__ss_local + " = call i64 @__str_split(i64 " + obj + ", i64 " + __ss_arg + ")")
                }
                this.last_type = this.make_list_str_type()
                return __ss_local
            }
            if (method == "ends_with") {
                var __se_arg: String = this.gen_arg_value(args[0])
                var __se_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__se_local, "i64", "__str_ends_with", "i64 " + obj + ", i64 " + __se_arg))
                } else {
                    this.emit_indent(__se_local + " = call i64 @__str_ends_with(i64 " + obj + ", i64 " + __se_arg + ")")
                }
                var __se_tagged: String = this.emit_tag_bool(__se_local)
                this.last_type = AST.Type.BoolType
                return __se_tagged
            }
            if (method == "replace") {
                var __sre_arg1: String = this.gen_arg_value(args[0])
                var __sre_arg2: String = this.gen_arg_value(args[1])
                var __sre_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__sre_local, "i64", "__str_replace", "i64 " + obj + ", i64 " + __sre_arg1 + ", i64 " + __sre_arg2))
                } else {
                    this.emit_indent(__sre_local + " = call i64 @__str_replace(i64 " + obj + ", i64 " + __sre_arg1 + ", i64 " + __sre_arg2 + ")")
                }
                var __sre_ptr: String = this.fresh_local()
                this.emit_indent(__sre_ptr + " = inttoptr i64 " + __sre_local + " to i8*")
                var __sre_tagged: String = this.emit_tag_ptr(__sre_ptr)
                this.last_type = AST.Type.StringType
                return __sre_tagged
            }
        }
    }

    // If receiver type is unknown ("Any") but a user class defines this method,
    // skip builtin dispatch and fall through to class method resolution.
    // Exclude built-in type classes (String/List/Map/Int/Float/Bool) — these
    // are registered for documentation/future dispatch but shouldn't override
    // the inline builtin_methods emission.
    if (!is_user_class and this.builtin_methods.has(method)) {
        var bd_obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        if (bd_obj_type == "Any") {
            var fcm_class: String = this.find_class_for_method(method)
            if (fcm_class.length() > 0 and fcm_class != "String" and fcm_class != "List" and fcm_class != "Map" and fcm_class != "Int" and fcm_class != "Float" and fcm_class != "Bool") {
                is_user_class = true
            }
        }
    }
    if (!is_user_class and this.builtin_methods.has(method)) {
        // Warn when dispatching on untyped value
        var bd_obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        if (bd_obj_type == "Any") {
            IO.println("[codegen] Warning: dispatching '" + method + "' on untyped value (type inference failed)")
        }
        // Save receiver type before builtin dispatch clobbers last_type
        var pre_dispatch_type: AST.Type = this.last_type
        var bd_result: String = this.emit_builtin_dispatch(obj, method, args)
        // Override result type for reverse/copy/sort: preserve receiver list type
        if (method == "reverse" or method == "copy" or method == "sort") {
            var recv_type: AST.Type = pre_dispatch_type
            if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
                recv_type = this.typed_vars.get(obj_name)
            }
            if (this.type_to_string(recv_type) != "Any") {
                this.last_type = recv_type
            }
        }
        return bd_result
    }
    if (!is_user_class and method == "append" and args.length() > 0) {
        var str_tagged: String = this.gen_arg_value(args[0])
        var str_ptr: String = this.emit_untag_ptr(str_tagged)
        var str_raw: String = this.ptr_to_val(str_ptr)
        var discard: String = this.fresh_local()
        this.emit_indent(discard + " = call i64 @__sb_append(i64 " + obj + ", i64 " + str_raw + ")")
        this.last_type = AST.Type.NilType
        return "0"
    }
    if (!is_user_class and method == "set" and args.length() == 2) {
        // Determine if object is a List or Map to dispatch correctly
        var set_obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        if (set_obj_type == "Any") {
            IO.println("[codegen] Warning: dispatching 'set' on untyped value (type inference failed)")
        }
        if (set_obj_type == "List" or set_obj_type.starts_with("List<")) {
            // List.set(index, value) -> __list_set
            var idx_tagged: String = this.gen_arg_value(args[0])
            var idx: String = this.emit_untag_int(idx_tagged)
            var val: String = this.gen_arg_value(args[1])
            var discard: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(discard, "i64", "__list_set", "i64 " + obj + ", i64 " + idx + ", i64 " + val))
            } else {
                this.emit_indent(discard + " = call i64 @__list_set(i64 " + obj + ", i64 " + idx + ", i64 " + val + ")")
            }
            this.last_type = AST.Type.NilType
            return "0"
        }
        // Map.set(key, value) -> __map_set
        //
        // The key is passed through NaN-boxed, NOT untagged. Untagging threw
        // away the only thing that distinguishes a string key from a numeric
        // one, and the runtime then compared every stored key with strcmp — so
        // a second `set()` on a Map<Int, _> dereferenced the number itself and
        // segfaulted. __map_key_cmp reads the tag; it needs the tag intact.
        var key_raw_s: String = this.gen_arg_value(args[0])
        var key_entry_type: String = this.type_to_string(this.last_type)
        var val: String = this.gen_arg_value(args[1])
        var val_entry_type: String = this.type_to_string(this.last_type)
        var discard: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(discard, "i64", "__map_set", "i64 " + obj + ", i64 " + key_raw_s + ", i64 " + val))
        } else {
            this.emit_indent(discard + " = call i64 @__map_set(i64 " + obj + ", i64 " + key_raw_s + ", i64 " + val + ")")
        }
        // Recover the K and V of a map *literal* from the entries themselves.
        //
        // The parser desugars {"a": 1} into a VarDecl of a temporary annotated
        // just "Map", plus one .set() per entry. Nothing ever looked at the
        // entries, so every literal came out Map<String, Any> — the value type
        // erased to Any even when every entry agreed. gen_var_decl_with_name
        // re-reads last_type after the initializer runs, so tightening
        // typed_vars here is what reaches the enclosing `var`.
        //
        // Widen to Any on disagreement rather than guessing from entry 0 (the
        // mistake gen_list_lit still makes).
        if (obj_name.length() > 0) {
            this.refine_map_entry_type(obj_name, key_entry_type, val_entry_type)
        }
        this.last_type = AST.Type.NilType
        return "0"
    }
    if (!is_user_class and method == "has" and args.length() > 0) {
        var has_obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        if (has_obj_type == "Any") {
            IO.println("[codegen] Warning: dispatching 'has' on untyped value (type inference failed)")
        }
        // Key passed through NaN-boxed, NOT untagged — see Map.set. __map_has
        // now calls __map_key_cmp, which reads the tag to distinguish string
        // keys from numeric ones; untagging here destroyed that discriminator.
        var key_raw: String = this.gen_arg_value(args[0])
        var raw: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(raw, "i64", "__map_has", "i64 " + obj + ", i64 " + key_raw))
        } else {
            this.emit_indent(raw + " = call i64 @__map_has(i64 " + obj + ", i64 " + key_raw + ")")
        }
        var local: String = this.emit_tag_bool(raw)
        this.last_type = AST.Type.BoolType
        return local
    }
    if (!is_user_class and method == "get" and args.length() > 0) {
        var get_recv_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        if (get_recv_type == "Any") {
            IO.println("[codegen] Warning: dispatching 'get' on untyped value (type inference failed)")
        }
        // Key passed through NaN-boxed, NOT untagged — see Map.set. __map_get
        // now calls __map_key_cmp, which reads the tag to distinguish string
        // keys from numeric ones; untagging here destroyed that discriminator.
        var key_raw_g: String = this.gen_arg_value(args[0])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", "__map_get", "i64 " + obj + ", i64 " + key_raw_g))
        } else {
            this.emit_indent(local + " = call i64 @__map_get(i64 " + obj + ", i64 " + key_raw_g + ")")
        }
        // Infer value type from variable type annotation
        var obj_type_for_get: String = ""
        if (obj_name.length() > 0) {
            obj_type_for_get = this.get_var_type_str(obj_name)
        }
        if (obj_type_for_get.length() == 0) {
            obj_type_for_get = this.get_expr_type(object)
        }
        if (obj_type_for_get == "Any") {
            obj_type_for_get = this.type_to_string(this.last_type)
        }
        if (obj_type_for_get.starts_with("Map<")) {
            var val_type_str: String = this.get_map_value_type(obj_type_for_get)
            this.last_type = this.str_to_type(val_type_str)
        } else {
            // Unknown value type, so Any — not String (BUGS #37). An untyped or
            // Any-typed map tells us nothing about what get() returns; claiming
            // String made `arr = m.get(k)` followed by `arr.push(x)` fall through
            // to a silent return "0" that emits no call at all. Any routes such
            // values through the runtime-dispatching helpers instead. Annotated
            // Map<K, V> still narrows to V above.
            this.last_type = AST.Type.AnyType
        }
        return local
    }
    if (!is_user_class and method == "starts_with" and args.length() > 0) {
        var str_ptr: String = this.emit_untag_ptr(obj)
        var prefix: String = this.gen_arg_value(args[0])
        var prefix_ptr: String = this.emit_untag_ptr(prefix)
        var plen: String = this.fresh_local()
        this.emit_indent(plen + " = call i64 @strlen(i8* " + prefix_ptr + ")")
        var cmp: String = this.fresh_local()
        this.emit_indent(cmp + " = call i32 @strncmp(i8* " + str_ptr + ", i8* " + prefix_ptr + ", i64 " + plen + ")")
        var is_eq: String = this.fresh_local()
        this.emit_indent(is_eq + " = icmp eq i32 " + cmp + ", 0")
        var raw: String = this.fresh_local()
        this.emit_indent(raw + " = zext i1 " + is_eq + " to i64")
        var result: String = this.emit_tag_bool(raw)
        this.last_type = AST.Type.BoolType
        return result
    }
    if (!is_user_class and method == "char_at" and args.length() > 0) {
        var str_ptr: String = this.emit_untag_ptr(obj)
        var idx_tagged: String = this.gen_arg_value(args[0])
        var idx: String = this.emit_untag_int(idx_tagged)
        var char_ptr: String = this.fresh_local()
        this.emit_indent(char_ptr + " = getelementptr i8, i8* " + str_ptr + ", i64 " + idx)
        var buf: String = this.fresh_local()
        this.emit_indent(buf + " = call i8* @__sf_malloc(i64 2)")
        var ch: String = this.fresh_local()
        this.emit_indent(ch + " = load i8, i8* " + char_ptr)
        this.emit_indent("store i8 " + ch + ", i8* " + buf)
        var null_ptr: String = this.fresh_local()
        this.emit_indent(null_ptr + " = getelementptr i8, i8* " + buf + ", i64 1")
        this.emit_indent("store i8 0, i8* " + null_ptr)
        var local: String = this.emit_tag_ptr(buf)
        this.last_type = AST.Type.StringType
        return local
    }
    if (!is_user_class and method == "is_upper") {
        var str_ptr: String = this.emit_untag_ptr(obj)
        var ch: String = this.fresh_local()
        this.emit_indent(ch + " = load i8, i8* " + str_ptr)
        var ge_a: String = this.fresh_local()
        this.emit_indent(ge_a + " = icmp uge i8 " + ch + ", 65")
        var le_z: String = this.fresh_local()
        this.emit_indent(le_z + " = icmp ule i8 " + ch + ", 90")
        var both: String = this.fresh_local()
        this.emit_indent(both + " = and i1 " + ge_a + ", " + le_z)
        var local: String = this.fresh_local()
        this.emit_indent(local + " = zext i1 " + both + " to i64")
        this.last_type = AST.Type.BoolType
        return local
    }
    if (!is_user_class and method == "is_lower") {
        var str_ptr: String = this.emit_untag_ptr(obj)
        var ch: String = this.fresh_local()
        this.emit_indent(ch + " = load i8, i8* " + str_ptr)
        var ge_a: String = this.fresh_local()
        this.emit_indent(ge_a + " = icmp uge i8 " + ch + ", 97")
        var le_z: String = this.fresh_local()
        this.emit_indent(le_z + " = icmp ule i8 " + ch + ", 122")
        var both: String = this.fresh_local()
        this.emit_indent(both + " = and i1 " + ge_a + ", " + le_z)
        var local: String = this.fresh_local()
        this.emit_indent(local + " = zext i1 " + both + " to i64")
        this.last_type = AST.Type.BoolType
        return local
    }
    if (!is_user_class and method == "slice" and args.length() > 0) {
        var slice_obj_type: String = this.type_to_string(this.last_type)
        var slice_saved_type: AST.Type = this.last_type
        // Prefer typed_vars for more precise element type
        if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
            slice_saved_type = this.typed_vars.get(obj_name)
            slice_obj_type = this.type_to_string(slice_saved_type)
        }
        // `slice_saved_type` is kept as the AST node so a List's element type
        // survives to `last_type` below; only the *dispatch* spelling needs Nil
        // dropped. A "String|Nil" receiver used to miss both the List and the
        // String arm and take the Any path, which defaults to a list slice on a
        // string pointer (BUGS #93).
        slice_obj_type = this.strip_nil_type_str(slice_obj_type)
        if (slice_obj_type == "Any") {
            IO.println("[codegen] Warning: dispatching 'slice' on untyped value (type inference failed)")
        }
        if (slice_obj_type.starts_with("List") or slice_obj_type == "Any") {
            // For Any type, default to list slice (safer than string slice which dereferences a pointer)
            // @__list_slice takes RAW i64 indices; gen_arg_value returns tagged values.
            var sl_start_tagged: String = this.gen_arg_value(args[0])
            var sl_start: String = this.emit_untag_int(sl_start_tagged)
            var sl_end_tagged: String = this.gen_arg_value(args[1])
            var sl_end: String = this.emit_untag_int(sl_end_tagged)
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__list_slice(i64 " + obj + ", i64 " + sl_start + ", i64 " + sl_end + ")")
            // Preserve element type from the receiver list
            this.last_type = slice_saved_type
            return local
        }
        var str_ptr: String = this.emit_untag_ptr(obj)
        var start_tagged: String = this.gen_arg_value(args[0])
        var start: String = this.emit_untag_int(start_tagged)
        var end_tagged: String = this.gen_arg_value(args[1])
        var end: String = this.emit_untag_int(end_tagged)
        var slice_len: String = this.fresh_local()
        this.emit_indent(slice_len + " = sub i64 " + end + ", " + start)
        var buf_size: String = this.fresh_local()
        this.emit_indent(buf_size + " = add i64 " + slice_len + ", 1")
        var buf: String = this.fresh_local()
        this.emit_indent(buf + " = call i8* @__sf_malloc(i64 " + buf_size + ")")
        var src: String = this.fresh_local()
        this.emit_indent(src + " = getelementptr i8, i8* " + str_ptr + ", i64 " + start)
        this.emit_indent("call void @llvm.memcpy.p0i8.p0i8.i64(i8* " + buf + ", i8* " + src + ", i64 " + slice_len + ", i1 false)")
        var null_pos: String = this.fresh_local()
        this.emit_indent(null_pos + " = getelementptr i8, i8* " + buf + ", i64 " + slice_len)
        this.emit_indent("store i8 0, i8* " + null_pos)
        var local: String = this.emit_tag_ptr(buf)
        this.last_type = AST.Type.StringType
        return local
    }
    // --- Ambiguous builtin dispatch (needs obj_type from last_type) ---
    // Prefer typed_vars annotation over last_type (source of truth for variable types).
    var obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)

    if (!is_user_class and method == "length") {
        // A receiver that is neither Any, String, List nor Map is *unresolved*,
        // not a list. The old `else` sent every such spelling to
        // `__list_length`, which does `inttoptr` on the value as given — fine
        // for a List (stored untagged), a segfault for a NaN-tagged String. That
        // is how a "String|Nil" receiver crashed (BUGS #93). `__any_length`
        // reads the GC type tag and picks list/map/strlen at runtime, so an
        // unresolved receiver is exactly its job; route it there and keep the
        // static call for the types we actually know.
        var length_unresolved: Bool = obj_type != "Any" and obj_type != "String" and !obj_type.starts_with("List") and !obj_type.starts_with("Map")
        if (obj_type == "Any" or length_unresolved) {
            if (obj_type == "Any") {
                IO.println("[codegen] Warning: dispatching 'length' on untyped value (type inference failed)")
            } else {
                IO.println("[codegen] Warning: dispatching 'length' on unresolved receiver type '" + obj_type + "' (runtime dispatch)")
            }
            // Use runtime dispatch (__any_length) for unknown types
            this.called_functions.push("__any_length")
            var raw: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(raw, "i64", "__any_length", "i64 " + obj))
            } else {
                this.emit_indent(raw + " = call i64 @__any_length(i64 " + obj + ")")
            }
            var local: String = this.emit_tag_int(raw)
            this.last_type = AST.Type.IntType
            return local
        }
        if (obj_type == "String") {
            var str_ptr: String = this.emit_untag_ptr(obj)
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = call i64 @strlen(i8* " + str_ptr + ")")
            var local: String = this.emit_tag_int(raw)
            this.last_type = AST.Type.IntType
            return local
        } else {
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = call i64 @__list_length(i64 " + obj + ")")
            var local: String = this.emit_tag_int(raw)
            this.last_type = AST.Type.IntType
            return local
        }
    }
    if (!is_user_class and method == "contains" and args.length() > 0) {
        if (obj_type == "Any") {
            IO.println("[codegen] Warning: dispatching 'contains' on untyped value (type inference failed)")
        }
        var contains_arg_type: String = this.get_expr_type(args[0])
        // Check for List/Map FIRST to avoid gen3 string-comparison misrouting
        if (obj_type.starts_with("List") or obj_type.starts_with("Map")) {
            var val: String = this.gen_arg_value(args[0])
            var list_ptr: String = obj
            var list_len: String = this.fresh_local()
            this.emit_indent(list_len + " = call i64 @__list_length(i64 " + list_ptr + ")")
            var idx_alloca: String = this.fresh_local()
            this.emit_indent(idx_alloca + " = alloca i64")
            this.emit_indent("store i64 0, i64* " + idx_alloca)
            var loop_lbl: String = this.fresh_label("contains.loop")
            var body_lbl: String = this.fresh_label("contains.body")
            var found_lbl: String = this.fresh_label("contains.found")
            var next_lbl: String = this.fresh_label("contains.next")
            var done_lbl: String = this.fresh_label("contains.done")
            this.emit_terminator("br label %" + loop_lbl)
            this.start_block(loop_lbl)
            var idx_val: String = this.fresh_local()
            this.emit_indent(idx_val + " = load i64, i64* " + idx_alloca)
            var cmp_cond: String = this.fresh_local()
            this.emit_indent(cmp_cond + " = icmp slt i64 " + idx_val + ", " + list_len)
            this.emit_terminator("br i1 " + cmp_cond + ", label %" + body_lbl + ", label %" + done_lbl)
            this.start_block(body_lbl)
            var elem: String = this.fresh_local()
            this.emit_indent(elem + " = call i64 @__list_get(i64 " + list_ptr + ", i64 " + idx_val + ")")
            var eq_result: String = this.fresh_local()
            var list_elem_type: String = "Any"
            if (obj_type.starts_with("List<") and obj_type.ends_with(">")) {
                list_elem_type = obj_type.slice(5, obj_type.length() - 1)
            }
            if (list_elem_type == "String" or contains_arg_type == "String") {
                this.emit_indent(eq_result + " = call i64 @__string_eq(i64 " + elem + ", i64 " + val + ")")
            } else {
                var icmp_eq: String = this.fresh_local()
                this.emit_indent(icmp_eq + " = icmp eq i64 " + elem + ", " + val)
                this.emit_indent(eq_result + " = zext i1 " + icmp_eq + " to i64")
            }
            var is_found: String = this.fresh_local()
            this.emit_indent(is_found + " = icmp ne i64 " + eq_result + ", 0")
            this.emit_terminator("br i1 " + is_found + ", label %" + found_lbl + ", label %" + next_lbl)
            this.start_block(next_lbl)
            var next_idx: String = this.fresh_local()
            this.emit_indent(next_idx + " = add i64 " + idx_val + ", 1")
            this.emit_indent("store i64 " + next_idx + ", i64* " + idx_alloca)
            this.emit_terminator("br label %" + loop_lbl)
            this.start_block(found_lbl)
            this.emit_terminator("br label %" + done_lbl)
            this.start_block(done_lbl)
            var phi_val: String = this.fresh_local()
            this.emit_indent(phi_val + " = phi i64 [1, %" + found_lbl + "], [0, %" + loop_lbl + "]")
            var result: String = this.emit_tag_bool(phi_val)
            this.last_type = AST.Type.BoolType
            return result
        } else if (obj_type == "String" or (obj_type == "Any" and contains_arg_type == "String")) {
            var str_ptr: String = this.fresh_local()
            var str_ptr: String = this.emit_untag_ptr(obj)
            var needle: String = this.gen_arg_value(args[0])
            var needle_ptr: String = this.emit_untag_ptr(needle)
            var found: String = this.fresh_local()
            this.emit_indent(found + " = call i8* @strstr(i8* " + str_ptr + ", i8* " + needle_ptr + ")")
            var local: String = this.fresh_local()
            this.emit_indent(local + " = icmp ne i8* " + found + ", null")
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = zext i1 " + local + " to i64")
            var result: String = this.emit_tag_bool(raw)
            this.last_type = AST.Type.BoolType
            return result
        } else {
            var val: String = this.gen_arg_value(args[0])
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__list_contains(i64 " + obj + ", i64 " + val + ")")
            this.last_type = AST.Type.BoolType
            return local
        }
    }
    if (!is_user_class and method == "to_number") {
        if (obj_type == "Any") {
            IO.println("[codegen] Warning: dispatching 'to_number' on untyped value (type inference failed)")
        }
        var str_ptr: String = this.emit_untag_ptr(obj)
        var raw: String = this.fresh_local()
        this.emit_indent(raw + " = call i64 @atol(i8* " + str_ptr + ")")
        var local: String = this.emit_tag_int(raw)
        this.last_type = AST.Type.IntType
        return local
    }
    if (!is_user_class and method == "to_float") {
        // Parse string as float using strtod, return tagged float value
        var str_ptr: String = this.emit_untag_ptr(obj)
        var dbl: String = this.fresh_local()
        this.emit_indent(dbl + " = call double @strtod(i8* " + str_ptr + ", i8* null)")
        var local: String = this.emit_tag_float(dbl)
        this.last_type = AST.Type.FloatType
        return local
    }
    if (!is_user_class and method == "to_string") {
        if (obj_type == "Any") {
            IO.println("[codegen] Warning: dispatching 'to_string' on untyped value (type inference failed)")
        }
        if (obj_type == "StringBuilder" or obj_type == "SB") {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__sb_to_string(i64 " + obj + ")")
            var tagged: String = this.fresh_local()
            this.emit_indent(tagged + " = call i64 @__rt_tag_ptr(i64 " + local + ")")
            this.last_type = AST.Type.StringType
            return tagged
        } else if (obj_type == "String") {
            this.last_type = AST.Type.StringType
            return obj
        } else if (obj_type == "Float") {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__float_to_string(i64 " + obj + ")")
            var tagged: String = this.fresh_local()
            this.emit_indent(tagged + " = call i64 @__rt_tag_ptr(i64 " + local + ")")
            this.last_type = AST.Type.StringType
            return tagged
        } else if (obj_type == "Bool") {
            var raw: String = this.emit_untag_bool(obj)
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__bool_to_string(i64 " + raw + ")")
            var tagged: String = this.fresh_local()
            this.emit_indent(tagged + " = call i64 @__rt_tag_ptr(i64 " + local + ")")
            this.last_type = AST.Type.StringType
            return tagged
        } else if (this.enum_defs.has(obj_type)) {
            var ts_func: String = obj_type + "__to_string"
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @" + ts_func + "(i64 " + obj + ")")
            var tagged: String = this.fresh_local()
            this.emit_indent(tagged + " = call i64 @__rt_tag_ptr(i64 " + local + ")")
            this.last_type = AST.Type.StringType
            return tagged
        } else if (obj_type.starts_with("List")) {
            this.called_functions.push("__list_to_string")
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__list_to_string(i64 " + obj + ")")
            var tagged: String = this.fresh_local()
            this.emit_indent(tagged + " = call i64 @__rt_tag_ptr(i64 " + local + ")")
            this.last_type = AST.Type.StringType
            return tagged
        } else if (obj_type.starts_with("Map")) {
            this.called_functions.push("__map_to_string")
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__map_to_string(i64 " + obj + ")")
            var tagged: String = this.fresh_local()
            this.emit_indent(tagged + " = call i64 @__rt_tag_ptr(i64 " + local + ")")
            this.last_type = AST.Type.StringType
            return tagged
        } else if (obj_type == "Any") {
            // Unknown type at compile time: dispatch via __any_to_string which
            // does runtime NaN-box tag inspection to choose the right converter.
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = call i64 @__any_to_string(i64 " + obj + ")")
            if (this.identity_mode) {
                // Identity mode: raw pointer IS the value
                this.last_type = AST.Type.StringType
                return raw
            }
            // NaN-box mode: tag the raw char* as a Saffron string ptr
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__rt_tag_ptr(i64 " + raw + ")")
            this.last_type = AST.Type.StringType
            return local
        } else {
            var raw: String = this.emit_untag_int(obj)
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__int_to_string(i64 " + raw + ")")
            var tagged: String = this.fresh_local()
            this.emit_indent(tagged + " = call i64 @__rt_tag_ptr(i64 " + local + ")")
            this.last_type = AST.Type.StringType
            return tagged
        }
    }
    if (!is_user_class and method == "floor") {
        if (obj_type == "Any") {
            IO.println("[codegen] Warning: dispatching 'floor' on untyped value (type inference failed)")
        }
        if (obj_type == "Float") {
            // Actual float: untag as double, floor, convert to int, retag
            var dbl: String = this.emit_untag_float(obj)
            var floored: String = this.fresh_local()
            this.emit_indent(floored + " = call double @llvm.floor.f64(double " + dbl + ")")
            var as_int: String = this.fresh_local()
            this.emit_indent(as_int + " = fptosi double " + floored + " to i64")
            var local: String = this.emit_tag_int(as_int)
            this.last_type = AST.Type.IntType
            return local
        }
        this.last_type = AST.Type.IntType
        return obj
    }
    if (!is_user_class and method == "ceil") {
        if (obj_type == "Float") {
            var dbl: String = this.emit_untag_float(obj)
            var ceiled: String = this.fresh_local()
            this.emit_indent(ceiled + " = call double @llvm.ceil.f64(double " + dbl + ")")
            var as_int: String = this.fresh_local()
            this.emit_indent(as_int + " = fptosi double " + ceiled + " to i64")
            var local: String = this.emit_tag_int(as_int)
            this.last_type = AST.Type.IntType
            return local
        }
        this.last_type = AST.Type.IntType
        return obj
    }
    if (!is_user_class and method == "abs") {
        if (obj_type == "Float") {
            var dbl: String = this.emit_untag_float(obj)
            var abs_val: String = this.fresh_local()
            this.emit_indent(abs_val + " = call double @llvm.fabs.f64(double " + dbl + ")")
            var local: String = this.emit_tag_float(abs_val)
            this.last_type = AST.Type.FloatType
            return local
        }
        if (obj_type == "Int") {
            var raw: String = this.emit_untag_int(obj)
            var neg: String = this.fresh_local()
            this.emit_indent(neg + " = sub i64 0, " + raw)
            var is_neg: String = this.fresh_local()
            this.emit_indent(is_neg + " = icmp slt i64 " + raw + ", 0")
            var abs_val: String = this.fresh_local()
            this.emit_indent(abs_val + " = select i1 " + is_neg + ", i64 " + neg + ", i64 " + raw)
            var local: String = this.emit_tag_int(abs_val)
            this.last_type = AST.Type.IntType
            return local
        }
        this.last_type = AST.Type.IntType
        return obj
    }
    if (!is_user_class and method == "round") {
        if (obj_type == "Float") {
            var dbl: String = this.emit_untag_float(obj)
            var rounded: String = this.fresh_local()
            this.emit_indent(rounded + " = call double @llvm.round.f64(double " + dbl + ")")
            var as_int: String = this.fresh_local()
            this.emit_indent(as_int + " = fptosi double " + rounded + " to i64")
            var local: String = this.emit_tag_int(as_int)
            this.last_type = AST.Type.IntType
            return local
        }
        this.last_type = AST.Type.IntType
        return obj
    }

    // (enum check moved above builtin dispatch)

    // Check for imported module function calls (module alias or unknown name)
    // Also skip global variables (they should dispatch via class method resolution below)
    if (obj_name.length() > 0 and (this.module_prefixes.has(obj_name) or (obj_name != "super" and !this.class_fields.has(obj_name) and !this.typed_vars.has(obj_name) and !this.global_var_types.has(obj_name) and !this.module_globals.has(obj_name) and !this.module_globals.has(this.current_prefix + obj_name)))) {
        var prefixed_name: String = method
        // Package namespace: check named_imports for "Alias.method" first
        if (this.named_imports.has(obj_name + "." + method)) {
            prefixed_name = this.named_imports.get(obj_name + "." + method)
        } else if (this.module_prefixes.has(obj_name)) {
            prefixed_name = this.module_prefixes.get(obj_name) + method
        } else if (this.func_prefix_map.has(method)) {
            prefixed_name = this.func_prefix_map.get(method)
        } else {
            var guessed: String = obj_name.to_lower() + "_" + method
            if (this.known_functions.contains(guessed)) {
                prefixed_name = guessed
            }
        }
        // Intrinsic check: if the target is an intrinsic, emit inline IR instead of a call
        if (this.intrinsic_funcs.contains(prefixed_name)) {
            return this.gen_intrinsic_call(prefixed_name, args)
        }
        // Extern check: if the target is an extern C function, emit the proper extern call
        if (this.extern_sigs.has(prefixed_name)) {
            return this.gen_extern_call(prefixed_name, args)
        }
        var arg_strs: List<String> = []
        var ai: Float = 0
        while (ai < args.length()) {
            var val: String = this.gen_arg_value(args[ai])
            arg_strs.push("i64 " + val)
            ai = ai + 1
        }
        this.called_functions.push(prefixed_name)
        this.called_function_arity.set(prefixed_name, args.length())
        // Coro-calls-coro: if this is a coroutine calling another, emit await loop
        var is_coro_callee: Bool = this.str_in_list(this.coroutine_funcs, prefixed_name)
        if (!is_coro_callee) {
            is_coro_callee = this.str_in_list(this.coroutine_funcs, method)
        }
        // Definitive check: if the function is already defined and is in coroutine_funcs
        if (!is_coro_callee) {
            is_coro_callee = this.str_in_list(this.coroutine_funcs, prefixed_name) or this.str_in_list(this.coroutine_funcs, method)
        }
        if (this.is_coroutine and is_coro_callee) {
            var b_hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(b_hdl, "ptr", prefixed_name, arg_strs.join(", ")))
            } else {
                this.emit_indent(b_hdl + " = call ptr @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
            }
            var b_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(b_i64, b_hdl))
            } else {
                this.emit_indent(b_i64 + " = ptrtoint ptr " + b_hdl + " to i64")
            }
            var ac: String = this.fresh_label("await.check")
            var ay: String = this.fresh_label("await.yield")
            var al: String = this.fresh_label("await.loop")
            var acl: String = this.fresh_label("await.cleanup")
            var ad: String = this.fresh_label("await.done")
            this.emit_terminator("br label %" + ac)
            this.start_block(ac)
            var bd: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(bd, "i64", "__sched_coro_done", "i64 " + b_i64))
            } else {
                this.emit_indent(bd + " = call i64 @__sched_coro_done(i64 " + b_i64 + ")")
            }
            var bdc: String = this.fresh_local()
            this.emit_indent(bdc + " = icmp eq i64 " + bd + ", 1")
            this.emit_terminator("br i1 " + bdc + ", label %" + ad + ", label %" + ay)
            this.start_block(ay)
            // Propagate child's yield_reason/yield_arg — don't overwrite
            var st: String = this.fresh_local()
            this.emit_indent(st + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var sr: String = this.fresh_local()
            this.emit_indent(sr + " = call i8 @llvm.coro.suspend(token " + st + ", i1 false)")
            this.emit_terminator("switch i8 " + sr + ", label %__coro_suspend [i8 0, label %" + al + " i8 1, label %" + acl + "]")
            this.start_block(acl)
            this.emit_terminator("br label %__coro_cleanup")
            this.start_block(al)
            this.emit_indent("call void @__sched_coro_resume(i64 " + b_i64 + ")")
            this.emit_terminator("br label %" + ac)
            this.start_block(ad)
            // Read the child coroutine's return value from @__task_result
            var coro_result: String = this.fresh_local()
            this.emit_indent(coro_result + " = load i64, i64* @__task_result")
            // Use the callee's return type (same as the non-coro path below)
            if (this.func_ret_types.has(prefixed_name)) {
                this.last_type = this.func_ret_types.get(prefixed_name)
            } else if (this.func_ret_types.has(method)) {
                this.last_type = this.func_ret_types.get(method)
            } else {
                this.last_type = AST.Type.IntType
            }
            return coro_result
        }
        // Sync-calls-coro: non-coroutine calling a coroutine — drive to completion
        if (!this.is_coroutine and is_coro_callee) {
            var s_hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(s_hdl, "ptr", prefixed_name, arg_strs.join(", ")))
            } else {
                this.emit_indent(s_hdl + " = call ptr @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
            }
            var s_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(s_i64, s_hdl))
            } else {
                this.emit_indent(s_i64 + " = ptrtoint ptr " + s_hdl + " to i64")
            }
            var sc: String = this.fresh_label("sync.check")
            var sl: String = this.fresh_label("sync.loop")
            var sd: String = this.fresh_label("sync.done")
            this.emit_terminator("br label %" + sc)
            this.start_block(sc)
            var s_done: String = this.fresh_local()
            this.emit_indent(s_done + " = call i64 @__sched_coro_done(i64 " + s_i64 + ")")
            var s_cmp: String = this.fresh_local()
            this.emit_indent(s_cmp + " = icmp eq i64 " + s_done + ", 1")
            this.emit_terminator("br i1 " + s_cmp + ", label %" + sd + ", label %" + sl)
            this.start_block(sl)
            this.emit_indent("call void @__sched_coro_resume(i64 " + s_i64 + ")")
            this.emit_terminator("br label %" + sc)
            this.start_block(sd)
            var s_result: String = this.fresh_local()
            this.emit_indent(s_result + " = load i64, i64* @__task_result")
            if (this.func_ret_types.has(prefixed_name)) {
                this.last_type = this.func_ret_types.get(prefixed_name)
            } else if (this.func_ret_types.has(method)) {
                this.last_type = this.func_ret_types.get(method)
            } else {
                this.last_type = AST.Type.IntType
            }
            return s_result
        }
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", prefixed_name, arg_strs.join(", ")))
        } else {
            this.emit_indent(local + " = call i64 @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
        }
        if (this.func_ret_types.has(prefixed_name)) {
            this.last_type = this.func_ret_types.get(prefixed_name)
        } else if (this.func_ret_types.has(method)) {
            this.last_type = this.func_ret_types.get(method)
        } else {
            this.last_type = AST.Type.IntType
        }
        return local
    }

    // Fall back to class method call (inside or outside class)
    // (must come BEFORE universal methods so class .to_string() is found)
    // typed_vars is the single source of truth for variable types.
    var class_name: String = ""
    var cn_resolved: String = this.resolve_class_type(obj_type)
    if (cn_resolved.length() > 0) {
        class_name = cn_resolved
    } else if (obj_name.length() > 0) {
        var cn_type: String = this.get_var_type_str(obj_name)
        var cn_type_resolved: String = this.resolve_class_type(cn_type)
        if (cn_type_resolved.length() > 0) {
            class_name = cn_type_resolved
        }
    }
    // Don't use find_class_for_method for builtin container/primitive methods —
    // these should dispatch to runtime builtins (Map/List/String/Int/Float) not user classes.
    // Includes type-class methods (to_string, abs, floor, ceil, to_float) that are
    // handled by inline codegen above for known primitive types.
    var is_builtin_method: Bool = method == "keys" or method == "values" or method == "has" or method == "get" or method == "set" or method == "length" or method == "push" or method == "pop" or method == "contains" or method == "split" or method == "join" or method == "slice" or method == "reverse" or method == "sort" or method == "copy" or method == "trim" or method == "replace" or method == "index_of" or method == "starts_with" or method == "ends_with" or method == "to_upper" or method == "to_lower" or method == "repeat" or method == "char_at" or method == "to_number" or method == "to_string" or method == "to_float" or method == "abs" or method == "floor" or method == "ceil"
    if (class_name.length() == 0 and this.current_class.length() > 0 and !is_builtin_method) {
        class_name = this.find_class_for_method(method)
    }
    if (class_name.length() == 0 and !is_builtin_method) {
        class_name = this.find_class_for_method(method)
    }
    // Fallback: if class_name is still empty, try find_class_for_method even for
    // builtin method names. User classes (e.g. Signal) can have .set()/.get()
    // with different arities than Map/List builtins.
    if (class_name.length() == 0 and is_builtin_method) {
        // Builtin .set() requires 2 args (Map.set(k,v) or List.set(i,v)).
        // Builtin .get() requires 1 arg (Map.get(k)).
        // If arity doesn't match builtins, it must be a user class method.
        var builtin_arity_mismatch: Bool = false
        if (method == "set" and args.length() != 2) { builtin_arity_mismatch = true }
        if (method == "get" and args.length() != 1) { builtin_arity_mismatch = true }
        // Also fallback for module globals whose type is unknown
        if (builtin_arity_mismatch or (obj_name.length() > 0 and (this.module_globals.has(obj_name) or this.module_globals.has(this.current_prefix + obj_name)))) {
            class_name = this.find_class_for_method(method)
        }
    }
    if (class_name.length() > 0) {
        // Error check: verify method actually exists on the class
        var __method_exists: Bool = false
        var __full_method_name: String = class_name + "__" + method
        if (this.known_functions.contains(__full_method_name)) { __method_exists = true }
        if (this.current_prefix.length() > 0 and this.known_functions.contains(this.current_prefix + __full_method_name)) { __method_exists = true }
        if (this.func_prefix_map.has(__full_method_name)) { __method_exists = true }
        if (this.class_methods.has(class_name)) {
            var __cm: List = this.class_methods.get(class_name)
            if (__cm.contains(method)) { __method_exists = true }
        }
        // Cross-module: class_methods is keyed by bare name (e.g. "TomlTable") but
        // class_name may be the prefixed struct name (e.g. "stdlib_toml_TomlTable").
        // Reverse-lookup via class_struct_names to find the bare name.
        if (!__method_exists) {
            var __cm_keys: List<String> = this.class_methods.keys()
            var __cmi: Float = 0
            while (__cmi < __cm_keys.length()) {
                var __cmk: String = __cm_keys[__cmi]
                if (this.class_struct_names.has(__cmk)) {
                    if (this.class_struct_names.get(__cmk) == class_name) {
                        var __cm3: List = this.class_methods.get(__cmk)
                        if (__cm3.contains(method)) { __method_exists = true }
                    }
                }
                __cmi = __cmi + 1
            }
        }
        // Also check func_prefix_map with bare class name
        if (!__method_exists) {
            var __cm_keys2: List<String> = this.class_methods.keys()
            var __cmi2: Float = 0
            while (__cmi2 < __cm_keys2.length()) {
                var __cmk2: String = __cm_keys2[__cmi2]
                if (this.class_struct_names.has(__cmk2)) {
                    if (this.class_struct_names.get(__cmk2) == class_name) {
                        var __bare_fn: String = __cmk2 + "__" + method
                        if (this.known_functions.contains(__bare_fn)) { __method_exists = true }
                        if (this.func_prefix_map.has(__bare_fn)) { __method_exists = true }
                    }
                }
                __cmi2 = __cmi2 + 1
            }
        }
        // Also allow callable fields (function-typed fields)
        if (!__method_exists and this.class_fields.has(class_name)) {
            var __ft: String = this.get_field_type(class_name, method)
            if (__ft.starts_with("Fun(") or __ft.contains("=>")) { __method_exists = true }
            var __fields_str: String = this.class_fields.get(class_name)
            if (__fields_str.contains(method + ":")) { __method_exists = true }
        }
        if (!__method_exists) {
            IO.println("[codegen] Error: type '" + class_name + "' has no method '" + method + "'")
            this.has_errors = true
            this.last_type = AST.Type.IntType
            return "0"
        }
        // Actor dispatch: serialize access with busy-check
        if (this.actor_classes.has(class_name) and this.is_coroutine and method != "init") {
            var actor_check: String = this.fresh_label("actor.check")
            var actor_suspend: String = this.fresh_label("actor.suspend")
            var actor_loop: String = this.fresh_label("actor.loop")
            var actor_cleanup: String = this.fresh_label("actor.cleanup")
            var actor_run: String = this.fresh_label("actor.run")
            var actor_done: String = this.fresh_label("actor.done")
            this.emit_terminator("br label %" + actor_check)
            this.start_block(actor_check)
            var busy_ptr: String = this.fresh_local()
            this.emit_indent(busy_ptr + " = inttoptr i64 " + obj + " to i64*")
            var busy_val: String = this.fresh_local()
            this.emit_indent(busy_val + " = load i64, i64* " + busy_ptr)
            var busy_cmp: String = this.fresh_local()
            this.emit_indent(busy_cmp + " = icmp ne i64 " + busy_val + ", 0")
            this.emit_terminator("br i1 " + busy_cmp + ", label %" + actor_suspend + ", label %" + actor_run)
            this.start_block(actor_suspend)
            this.emit_indent("store i64 5, i64* @__yield_reason")
            this.emit_indent("store i64 " + obj + ", i64* @__yield_arg")
            var save_tok: String = this.fresh_local()
            this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var susp: String = this.fresh_local()
            this.emit_indent(susp + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")
            this.emit_terminator("switch i8 " + susp + ", label %__coro_suspend [i8 0, label %" + actor_loop + " i8 1, label %" + actor_cleanup + "]")
            this.start_block(actor_cleanup)
            this.emit_terminator("br label %__coro_cleanup")
            this.start_block(actor_loop)
            this.emit_terminator("br label %" + actor_check)
            this.start_block(actor_run)
            this.emit_indent("store i64 1, i64* " + busy_ptr)
            var ns_result: String = this.gen_namespace_call(class_name, method, obj, args, true)
            this.emit_indent("store i64 0, i64* " + busy_ptr)
            var wake_name: String = "scheduler__wake_actor_waiters"
            if (this.known_functions.contains("stdlib_scheduler_wake_actor_waiters")) {
                wake_name = "stdlib_scheduler_wake_actor_waiters"
            }
            var wake_discard: String = this.fresh_local()
            this.emit_indent(wake_discard + " = call i64 @" + wake_name + "(i64 " + obj + ")")
            this.called_functions.push(wake_name)
            this.resolve_generic_method_ret(obj_name)
            return ns_result
        }
        var ns_result: String = this.gen_namespace_call(class_name, method, obj, args, true)
        this.resolve_generic_method_ret(obj_name)
        return ns_result
    }


    // Universal methods (last resort, after class methods checked)
    if (method == "floor") {
        this.last_type = AST.Type.IntType
        return obj
    }
    if (method == "to_string") {
        if (obj_type == "String") {
            this.last_type = AST.Type.StringType
            return obj
        }
        if (obj_type == "Any") {
            var ts_local: String = this.fresh_local()
            this.emit_indent(ts_local + " = call i64 @__any_to_string(i64 " + obj + ")")
            var ts_tagged: String = this.fresh_local()
            this.emit_indent(ts_tagged + " = call i64 @__rt_tag_ptr(i64 " + ts_local + ")")
            this.last_type = AST.Type.StringType
            return ts_tagged
        }
        if (this.enum_defs.has(obj_type)) {
            var ts_func: String = obj_type + "__to_string"
            var ts_local: String = this.fresh_local()
            this.emit_indent(ts_local + " = call i64 @" + ts_func + "(i64 " + obj + ")")
            var ts_tagged_e: String = this.fresh_local()
            this.emit_indent(ts_tagged_e + " = call i64 @__rt_tag_ptr(i64 " + ts_local + ")")
            this.last_type = AST.Type.StringType
            return ts_tagged_e
        }
        var ts_raw: String = this.emit_untag_int(obj)
        var ts_local: String = this.fresh_local()
        this.emit_indent(ts_local + " = call i64 @__int_to_string(i64 " + ts_raw + ")")
        var ts_tagged: String = this.fresh_local()
        this.emit_indent(ts_tagged + " = call i64 @__rt_tag_ptr(i64 " + ts_local + ")")
        this.last_type = AST.Type.StringType
        return ts_tagged
    }
    // The terminal fall-through of gen_method_call: no arm above matched, so no
    // call has been emitted. Reaching here means the method call in the user's
    // program has been SILENTLY DROPPED — the expression evaluates to int-tagged
    // 0 and the program runs to completion with a wrong answer and no
    // diagnostic. That is BUGS #37.
    //
    // Until now only ONE of the three ways to get here reported anything: a
    // method missing from a class that codegen has fields for. The other two —
    // a builtin/`Any` receiver, and a receiver whose type came out empty — fell
    // straight through to `return "0"`. Measured over the tree (258 files that
    // actually reach codegen: test/, test/pass/, src/lib/, turmeric, parsley,
    // basil, pantry, examples), that unreported path fires twice, and both are
    // real bugs: `manifest.dependencies.delete(name)` on a `Map<String,Any>` in
    // pantry/src/commands/remove.sf and its transitive use from
    // pantry/src/main.sf. `pantry remove <pkg>` compiles clean, emits no call at
    // all (zero `__map_*` instructions for it), and removes nothing.
    //
    // So all three ways out are diagnostics now. The blast radius of that is
    // exactly those two files; nothing else in the tree relies on a dropped
    // call. The message names the category, because the three causes have
    // different fixes: a missing runtime method needs one written (Map has no
    // `delete` — there is no `__map_delete` in src/runtime/runtime.sf at all),
    // whereas an `Any` receiver needs a type annotation at the definition site.
    var is_builtin_type: Bool = false
    if (obj_type == "Any" or obj_type == "Int" or obj_type == "Float" or obj_type == "Bool" or obj_type == "String" or obj_type == "Nil") { is_builtin_type = true }
    if (obj_type.starts_with("List") or obj_type.starts_with("Map") or obj_type.starts_with("Tuple")) { is_builtin_type = true }
    if (obj_type == "StringBuilder" or obj_type == "SB") { is_builtin_type = true }
    if (!is_builtin_type and obj_type.length() > 0 and this.class_fields.has(obj_type)) {
        // Before erroring, check if the method exists via cross-module resolution
        var __ft_exists: Bool = false
        if (this.class_methods.has(obj_type)) {
            var __ftm: List = this.class_methods.get(obj_type)
            if (__ftm.contains(method)) { __ft_exists = true }
        }
        if (!__ft_exists) {
            var __ftk: List<String> = this.class_methods.keys()
            var __fti: Float = 0
            while (__fti < __ftk.length()) {
                var __ftkey: String = __ftk[__fti]
                if (this.class_struct_names.has(__ftkey)) {
                    if (this.class_struct_names.get(__ftkey) == obj_type) {
                        var __ftm2: List = this.class_methods.get(__ftkey)
                        if (__ftm2.contains(method)) { __ft_exists = true }
                    }
                }
                __fti = __fti + 1
            }
        }
        if (!__ft_exists) {
            IO.println("[codegen] Error: type '" + obj_type + "' has no method '" + method + "'")
            this.has_errors = true
        }
    } else if (is_builtin_type) {
        // A builtin or `Any` receiver with no matching arm above. `Any` is the
        // common shape and deserves the annotation hint; a concrete builtin
        // means the method genuinely does not exist on that type.
        if (obj_type == "Any") {
            IO.println("[codegen] Error: cannot dispatch '" + method + "' on an untyped ('Any') receiver — the call would be dropped. Annotate the value with the concrete type that defines '" + method + "'.")
        } else {
            IO.println("[codegen] Error: type '" + obj_type + "' has no method '" + method + "'")
        }
        this.has_errors = true
    } else {
        // Receiver type unknown to codegen entirely: an empty type string, or a
        // named type with no registered fields. Either way there is nothing to
        // dispatch to, and silently returning 0 is what BUGS #37 is.
        IO.println("[codegen] Error: cannot dispatch '" + method + "' on unresolved receiver type '" + obj_type + "' — the call would be dropped.")
        this.has_errors = true
    }
    this.last_type = AST.Type.IntType
    return "0"
    }

    fun is_this_expr(expr: AST.Expr): Bool {
    // The 28 arms that used to follow, each naming a variant and returning
    // "other", were a `_ => false` written the long way — and being hand-written
    // the list went stale: ListLit, IndexGet, IndexSet, MethodCall and MapLit
    // were never added, so those five yielded an indeterminate value rather
    // than false (BUGS #76).
    return match (expr) {
        This => true
        _ => false
    }
    }

    fun gen_get_field(object: AST.Expr, field: String): String {
    var obj_val: String = this.gen_arg_value(object)
    var class_name: String = this.type_to_string(this.last_type)
    // The receiver's full spelling ("Box<String>") is what binds the class's type
    // parameters, so it is kept for the substitution at the bottom of this
    // function; `class_name` itself has to be the bare name, since class_fields,
    // class_struct_names and get_field_index are all keyed that way. Without the
    // strip, a `Box<String>` receiver missed class_fields, fell back to
    // current_class, and read a field index off the wrong class (BUGS #95).
    var gf_recv_type: String = class_name
    if (class_name.contains("<") and !this.class_fields.has(class_name)) {
        var gf_bare: String = this.generic_base_name(class_name)
        if (this.class_fields.has(gf_bare)) { class_name = gf_bare }
    }
    if (class_name == "Int" or class_name == "Any" or !this.class_fields.has(class_name)) {
        // Try resolve_class_type to handle module-qualified types (e.g. "Func.BasicBlock")
        var resolved: String = this.resolve_class_type(class_name)
        if (resolved.length() > 0 and this.class_fields.has(resolved)) {
            class_name = resolved
        } else {
            class_name = this.current_class
        }
    }
    // Resolve to struct type name for GEP
    var struct_name: String = class_name
    if (this.class_struct_names.has(class_name)) {
        struct_name = this.class_struct_names.get(class_name)
    }
    var field_idx: Float = this.get_field_index(class_name, field)
    var obj_ptr: String = this.val_to_typed_ptr(obj_val, "%" + struct_name + "*")
    var field_ptr: String = this.fresh_local()
    this.emit_indent(field_ptr + " = getelementptr %" + struct_name + ", %" + struct_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
    var result: String = this.fresh_local()
    this.emit_indent(result + " = load volatile i64, i64* " + field_ptr)
    // LLVM lib parallel path: track field load result as opaque call (GEP+load)
    if (this.use_llvm_lib and !this.identity_mode) {
        var gf_arg_vals: List<LLVMTypes.Value> = []
        gf_arg_vals.push(LLVMTypes.Value.Instruction(obj_val, LLVMTypes.Type.I64))
        var gf_result: LLVMTypes.Value = this.llvm_block_builder.call("__field_load", LLVMTypes.Type.I64, gf_arg_vals)
        this.llvm_values.set(result, gf_result)
    }
    // Infer field type from class declaration, substituting the receiver's type
    // arguments: `var v: T` on a `Box<String>` loads a String, and dispatch on
    // the result needs to know that (BUGS #95).
    var gf_ftype: String = this.get_field_type(class_name, field)
    this.last_type = this.str_to_type(this.substitute_class_type_params(gf_ftype, gf_recv_type))
    return result
    }

    fun get_field_type(class_name: String, field: String): String {
    // Tuple field access: Tuple<T0,T1,...> with _0, _1, ...
    if (class_name.starts_with("Tuple<") and field.starts_with("_") and field.length() >= 2) {
        var gft_rest: String = field.slice(1, field.length())
        var gft_idx: Float = gft_rest.to_number()
        var gft_inner: String = class_name.slice(6, class_name.length() - 1)
        var gft_args: List<String> = this.split_type_args(gft_inner)
        if (gft_idx >= 0 and gft_idx < gft_args.length()) {
            return gft_args[gft_idx]
        }
    }
    var __gft_lookup: String = class_name
    if (!this.class_fields.has(class_name)) {
        // Cross-module: try bare name via reverse lookup
        var __gft_keys: List<String> = this.class_struct_names.keys()
        var __gft_i: Float = 0
        while (__gft_i < __gft_keys.length()) {
            if (this.class_struct_names.get(__gft_keys[__gft_i]) == class_name) {
                if (this.class_fields.has(__gft_keys[__gft_i])) {
                    __gft_lookup = __gft_keys[__gft_i]
                    __gft_i = __gft_keys.length()
                }
            }
            __gft_i = __gft_i + 1
        }
        // Also try stripping current_prefix
        if (!this.class_fields.has(__gft_lookup) and this.current_prefix.length() > 0 and class_name.starts_with(this.current_prefix)) {
            var __bare: String = class_name.slice(this.current_prefix.length(), class_name.length())
            if (this.class_fields.has(__bare)) { __gft_lookup = __bare }
        }
    }
    // `.get()` is typed String|Nil, and the has() checks above are inside the
    // `if` block rather than immediately before this line, so no narrowing
    // reaches here — a class with no registered fields yielded nil and then had
    // .length() called on it. Spell the miss out instead.
    var fields: String = ""
    if (this.class_fields.has(__gft_lookup)) { fields = this.class_fields.get(__gft_lookup) }
    if (fields.length() == 0) return "Int"
    var parts: List<String> = this.split_respecting_generics(fields, ",")
    var i: Float = 0
    while (i < parts.length()) {
        var fp: List<String> = parts[i].split(":")
        if (fp[0] == field) {
            var ft: String = fp[1]
            // In identity mode, Float and Int are both i64 — treat Float as Int
            if (this.identity_mode and ft == "Float") { return "Int" }
            return ft
        }
        i = i + 1
    }
    return "Int"
    }

    fun gen_set_field(object: AST.Expr, field: String, value: AST.Expr): String {
    // Check for module global write: ModuleAlias._field = value
    var sf_obj_name: String = this.get_variable_name(object)
    if (sf_obj_name.length() > 0 and this.module_prefixes.has(sf_obj_name)) {
        var sf_mp_resolved: String = this.module_prefixes.get(sf_obj_name) + field
        if (this.module_globals.has(sf_mp_resolved)) {
            var sf_val: String = this.gen_arg_value(value)
            this.emit_indent("store i64 " + sf_val + ", i64* @__g_" + this.sanitize_name(sf_mp_resolved))
            return sf_val
        }
    }
    var obj_val: String = this.gen_arg_value(object)
    var class_name: String = this.type_to_string(this.last_type)
    if (class_name == "Int" or class_name == "Any" or !this.class_fields.has(class_name)) {
        // Try resolve_class_type to handle module-qualified types (e.g. "Func.BasicBlock")
        var resolved: String = this.resolve_class_type(class_name)
        if (resolved.length() > 0 and this.class_fields.has(resolved)) {
            class_name = resolved
        } else {
            class_name = this.current_class
        }
    }
    // Resolve to struct type name for GEP
    var struct_name: String = class_name
    if (this.class_struct_names.has(class_name)) {
        struct_name = this.class_struct_names.get(class_name)
    }
    var val: String = this.gen_arg_value(value)
    var field_idx: Float = this.get_field_index(class_name, field)
    var obj_ptr: String = this.val_to_typed_ptr(obj_val, "%" + struct_name + "*")
    var field_ptr: String = this.fresh_local()
    this.emit_indent(field_ptr + " = getelementptr %" + struct_name + ", %" + struct_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
    this.emit_indent("store volatile i64 " + val + ", i64* " + field_ptr)
    return val
    }

    fun get_field_index(class_name: String, field: String): Float {
    // Unguarded `.get()` on a Map is String|Nil; the reverse lookup below is the
    // recovery path for a miss, so the miss has to produce "" rather than nil.
    var fields: String = ""
    if (this.class_fields.has(class_name)) { fields = this.class_fields.get(class_name) }
    // Cross-module: if prefixed name not found, try bare name via reverse lookup
    if (fields.length() == 0) {
        var __fkeys: List<String> = this.class_struct_names.keys()
        var __fki: Float = 0
        while (__fki < __fkeys.length()) {
            if (this.class_struct_names.get(__fkeys[__fki]) == class_name) {
                // The key came from class_struct_names, which does not imply a
                // class_fields entry — the .get() was unguarded and nullable.
                if (this.class_fields.has(__fkeys[__fki])) {
                    fields = this.class_fields.get(__fkeys[__fki])
                }
                if (fields.length() > 0) { __fki = __fkeys.length() }
            }
            __fki = __fki + 1
        }
    }
    // Also try: strip current_prefix from class_name to get bare name
    if (fields.length() == 0 and this.current_prefix.length() > 0 and class_name.starts_with(this.current_prefix)) {
        var bare: String = class_name.slice(this.current_prefix.length(), class_name.length())
        if (this.class_fields.has(bare)) { fields = this.class_fields.get(bare) }
    }
    if (fields.length() == 0) return 0
    var parts: List<String> = this.split_respecting_generics(fields, ",")
    var i: Float = 0
    while (i < parts.length()) {
        var fp: List<String> = parts[i].split(":")
        if (fp[0] == field) return i
        i = i + 1
    }
    // Field not found on known class — but suppress if it's actually a method
    var is_method: Bool = false
    if (this.class_methods.has(class_name)) {
        var __methods: List = this.class_methods.get(class_name)
        if (__methods.contains(field)) { is_method = true }
    }
    // Cross-module: also check bare class name via class_struct_names reverse lookup
    if (!is_method) {
        var __fk: List<String> = this.class_methods.keys()
        var __fi: Float = 0
        while (__fi < __fk.length()) {
            var __fkey: String = __fk[__fi]
            if (this.class_struct_names.has(__fkey)) {
                if (this.class_struct_names.get(__fkey) == class_name) {
                    var __fm: List = this.class_methods.get(__fkey)
                    if (__fm.contains(field)) { is_method = true }
                }
            }
            __fi = __fi + 1
        }
    }
    return 0
}

    /// Replace a class type parameter in `last_type` with what the receiver's
    /// declared type says it is: on a `Box<String>`, a method registered as
    /// returning "T" actually returns a String.
    ///
    /// This used to guess: it treated any return type of one or two uppercase
    /// characters (excluding "IO"/"OS") as a type parameter, and substituted the
    /// *entire* contents of the receiver's angle brackets. That was wrong twice
    /// over — it missed a spelled-out parameter like `Element`, and on a
    /// `Pair<Int,String>` it set last_type to the string "Int,String", which
    /// names nothing. Now the declared parameter list decides which names are
    /// parameters and positional matching decides what each one binds to
    /// (BUGS #95).
    fun resolve_generic_method_ret(obj_name: String) {
        if (obj_name.length() == 0) { return }
        var recv_type: String = this.get_var_type_str(obj_name)
        if (!recv_type.contains("<")) { return }
        var ret_str: String = this.type_to_string(this.last_type)
        var subst: String = this.substitute_class_type_params(ret_str, recv_type)
        if (subst != ret_str) {
            this.last_type = this.str_to_type(subst)
        }
    }
}

fun generate(program: List<AST.Stmt>): String {
    var gen: Codegen = Codegen()
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_target(program: List<AST.Stmt>, target: String): String {
    var gen: Codegen = Codegen()
    gen.target = target
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_target_opts(program: List<AST.Stmt>, target: String, identity_mode: Bool): String {
    var gen: Codegen = Codegen()
    gen.target = target
    gen.identity_mode = identity_mode
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_imports(program: List<AST.Stmt>, imports: List<AST.Stmt>): String {
    // Merge imports and program into a single compilation unit
    var all_stmts: List<AST.Stmt> = []
    var i: Float = 0
    while (i < imports.length()) {
        all_stmts.push(imports[i])
        i = i + 1
    }
    i = 0
    while (i < program.length()) {
        all_stmts.push(program[i])
        i = i + 1
    }
    var gen: Codegen = Codegen()
    var result: String = gen.generate(all_stmts)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_modules(program: List<AST.Stmt>, module_stmts: List<List<AST.Stmt>>, module_prefixes_list: List<String>, alias_map: Map<String, String>): String {
    // Merge all module code + main program into one compilation unit
    // Each module's functions get prefixed via current_prefix during gen_stmt
    var gen: Codegen = Codegen()
    gen.module_prefixes = alias_map
    // `IO` keeps a hard-wired prefix because it is implicit: a file with no
    // imports at all can still call IO.println, so there is no import statement
    // to derive an alias from. But the hard-wiring must not overwrite one that
    // IS there. `import "@io" as IO` used to be clobbered back to "__io_" here,
    // which sent every call to a runtime symbol — so `IO.open(p, m)` became
    // `@__io_open`, a function that does not exist, and the program failed at
    // link time with an undefined symbol and no diagnostic. The same held for
    // `bytes_alloc`, `bytes_from_string`, `read_file_bytes` and
    // `write_file_bytes`: all four are written in Saffron in src/lib/io.sf and
    // no runtime symbol backs them. Deferring to alias_map lets an explicit
    // import reach the module, exactly as any other alias does.
    if (!alias_map.has("IO")) {
        gen.module_prefixes.set("IO", "__io_")
    }
    // No hard-wired "OS" prefix. src/lib/os.sf is an ordinary stdlib module, so
    // its alias comes from alias_map like every other import; wiring OS here made
    // it a reserved name and shadowed the module's own Saffron functions.
    // Same deferral as IO/OS above (BUGS #88). Hard-wiring GC to the runtime
    // prefix routed `GC.set_threshold(4096)` straight at @__gc_set_threshold
    // with the argument still NaN-boxed, so 4096 arrived as ~9.2e18; the
    // matching getter re-masked it and read back 4096, hiding the corruption
    // (BUGS #74). src/lib/gc.sf's wrappers untag properly, and deferring to
    // alias_map is what reaches them.
    if (!alias_map.has("GC")) {
        gen.module_prefixes.set("GC", "__gc_")
    }
    // Task is handled by dedicated dispatch (Task.spawn, task.await, etc.)
    // and is NOT a real module prefix — don't register it here.
    gen.module_prefixes.set("Reflect", "stdlib_reflect_")

    // Register runtime functions first
    gen.known_functions.push("StringBuilder")
    gen.known_functions.push("__list_new")
    gen.known_functions.push("__list_push")
    gen.known_functions.push("__list_get")
    gen.known_functions.push("__list_set")
    gen.known_functions.push("__list_length")
    gen.known_functions.push("__list_pop")
    gen.known_functions.push("__sb_append")
    gen.known_functions.push("__sb_to_string")
    gen.known_functions.push("__safe_strcmp")
    gen.known_functions.push("__map_new")
    gen.known_functions.push("__map_set")
    gen.known_functions.push("__map_get")
    gen.known_functions.push("__map_has")
    gen.known_functions.push("__map_keys")
    gen.known_functions.push("__str_ends_with")
    gen.known_functions.push("__str_split")
    gen.known_functions.push("__str_replace")
    gen.known_functions.push("__int_to_string")
    gen.known_functions.push("__list_join")
    gen.known_functions.push("__join_append")
    gen.known_functions.push("__list_contains")
    gen.known_functions.push("__io_read_file")
    gen.known_functions.push("__io_write_file")
    gen.known_functions.push("__io_file_exists")
    gen.known_functions.push("__io_mkdir")
    gen.known_functions.push("__io_walk_dir")
    gen.known_functions.push("__io_append_file")
    // Without these two the bare-call path prefixes them with the module name
    // (stdlib_io___io_file_size), so the stdlib wrappers in src/lib/io.sf that
    // call them link against an undefined symbol. Both are defined in the
    // runtime (runtime.sf __io_file_size / __io_read_binary) — BUGS #85.
    gen.known_functions.push("__io_file_size")
    gen.known_functions.push("__io_read_binary")
    gen.known_functions.push("__io_is_dir")
    gen.known_functions.push("__io_rename")
    gen.known_functions.push("__io_delete_file")
    gen.known_functions.push("__os_set_env")
    gen.known_functions.push("__os_home")
    gen.known_functions.push("__io_read_stdin")
    gen.known_functions.push("__io_readline")
    gen.known_functions.push("__os_exec")
    gen.known_functions.push("__os_args")
    gen.known_functions.push("__os_cwd")
    gen.known_functions.push("__os_path_sep")
    gen.known_functions.push("__os_platform")
    gen.known_functions.push("__os_env")
    gen.known_functions.push("__os_system")
    // The io.sf wrappers `println`/`print` call these by bare name (they cannot
    // use an extern: an i64 extern param is untagged, which destroys the NaN-box
    // tag `__io_println_any` dispatches on). Without them here the bare-call path
    // prefixes them with the module name (stdlib_io___io_println) and the wrapper
    // links against an undefined symbol — the same shape as BUGS #85. Both are
    // already in runtime_declares().
    gen.known_functions.push("__io_println")
    gen.known_functions.push("__io_print")
    // The for-in element read (BUGS #62). Needed here for the same reason as the
    // two above: without it the auto-declare loop in output_body.sf emits a
    // `declare i64 @__any_iter_get(i64)` at its default arity of 1, which
    // redefines the two-argument declare runtime_declares() already emitted, and
    // the module fails to link. Same shape as BUGS #85. It IS in
    // runtime_declares(), so nothing is lost by suppressing the auto-declare.
    gen.known_functions.push("__any_iter_get")
    gen.func_ret_types.set("StringBuilder", gen.str_to_type("StringBuilder"))

    // Pre-scan: register module-level VarDecls as globals
    var mi2: Float = 0
    while (mi2 < module_stmts.length()) {
        var stmts: List<AST.Stmt> = module_stmts[mi2]
        var prefix: String = module_prefixes_list[mi2]
        var si2: Float = 0
        while (si2 < stmts.length()) {
            if (!gen.is_decl(stmts[si2])) {
                var stmt_kind: String = gen.classify_stmt(stmts[si2])
                if (stmt_kind == "var") {
                    var vname: String = gen.get_var_name(stmts[si2])
                    var vdoc2: String = gen.get_var_doc(stmts[si2])
                    if (!vdoc2.starts_with("@import:")) {
                        gen.module_globals.set(prefix + vname, true)
                        gen.globals.push("@__g_" + prefix + gen.sanitize_name(vname) + " = global i64 0\n")
                        // Pre-register global variable type so functions compiled
                        // before the module init can resolve list/map/string dispatch
                        var vtype2: String = gen.get_var_type(stmts[si2])
                        // Infer from the initializer when unannotated (BUGS #36).
                        // `var _items = []` otherwise stays untyped and every
                        // `_items.push(...)` falls through to a return "0" that emits
                        // no call — the push silently vanishes. This pre-scan runs
                        // before function return types register, so only literal
                        // shapes (list/map/string) resolve reliably here; that is
                        // exactly the case that bites.
                        if (vtype2.length() == 0 or vtype2 == "Any") {
                            var vinit2: String = gen.get_expr_type(gen.get_var_init(stmts[si2]))
                            if (vinit2.starts_with("List") or vinit2.starts_with("Map") or vinit2 == "String") {
                                vtype2 = vinit2
                            }
                        }
                        if (vtype2.length() > 0 and vtype2 != "Any") {
                            gen.global_var_types.set(vname, vtype2)
                            gen.global_var_types.set(prefix + vname, vtype2)
                        }
                    }
                }
            }
            si2 = si2 + 1
        }
        mi2 = mi2 + 1
    }

    // Pre-scan: register extension methods from all modules
    mi2 = 0
    while (mi2 < module_stmts.length()) {
        var stmts: List<AST.Stmt> = module_stmts[mi2]
        var prefix: String = module_prefixes_list[mi2]
        var si2: Float = 0
        while (si2 < stmts.length()) {
            var fdoc: String = gen.get_fun_doc(stmts[si2])
            if (fdoc.starts_with("@extend:")) {
                var fname: String = gen.get_fun_name(stmts[si2])
                var ext_cls: String = fdoc.slice(8, fdoc.length())
                gen.extend_map.set(prefix + fname, ext_cls)
            }
            si2 = si2 + 1
        }
        mi2 = mi2 + 1
    }

    // Pre-register class declarations from all modules so extend funs
    // can reference class fields without null map lookups.
    mi2 = 0
    while (mi2 < module_stmts.length()) {
        var stmts3: List<AST.Stmt> = module_stmts[mi2]
        var prefix3: String = module_prefixes_list[mi2]
        var si3: Float = 0
        while (si3 < stmts3.length()) {
            var sk3: String = gen.classify_stmt(stmts3[si3])
            if (sk3 == "class") {
                var cn3: String = match (stmts3[si3]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                    _ => ""
                }
                // Only the primary base contributes fields — see the layout rule in
                // gen_class_decl_with_parents. parents[0] is that base.
                var cp3_all: List<String> = match (stmts3[si3]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => ps
                    _ => []
                }
                var cp3: String = ""
                if (cp3_all.length() > 0) { cp3 = cp3_all[0] }
                var cf3: List<AST.Param> = match (stmts3[si3]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => f
                    _ => []
                }
                var cm3: List<AST.Stmt> = match (stmts3[si3]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                    _ => []
                }
                var cd3: String = match (stmts3[si3]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => d
                    _ => ""
                }
                if (cd3.starts_with("@actor")) {
                    gen.actor_classes.set(cn3, true)
                    if (prefix3.length() > 0) { gen.actor_classes.set(prefix3 + cn3, true) }
                }
                if (cn3.length() > 0 and !gen.class_fields.has(cn3)) {
                    var cf3_str: String = gen.params_to_string(cf3)
                    var cf3_all: String = cf3_str
                    if (cp3.length() > 0 and gen.class_fields.has(cp3)) {
                        var cpf3: String = gen.class_fields.get(cp3)
                        if (cpf3.length() > 0) {
                            if (cf3_all.length() > 0) {
                                cf3_all = cpf3 + "," + cf3_all
                            } else {
                                cf3_all = cpf3
                            }
                        }
                    }
                    if (gen.actor_classes.has(cn3)) {
                        if (cf3_all.length() > 0) {
                            cf3_all = "__actor_busy:Int,__actor_queue:Int," + cf3_all
                        } else {
                            cf3_all = "__actor_busy:Int,__actor_queue:Int"
                        }
                    }
                    gen.class_fields.set(cn3, cf3_all)
                    gen.class_fields.set(prefix3 + cn3, cf3_all)
                    // Register struct names so resolve_class_type uses prefixed name
                    var sn3: String = cn3
                    if (prefix3.length() > 0) { sn3 = prefix3 + cn3 }
                    gen.class_struct_names.set(cn3, sn3)
                    if (prefix3.length() > 0) {
                        gen.class_struct_names.set(prefix3 + cn3, sn3)
                    }
                    var cm3_names: List<String> = []
                    var cm3i: Float = 0
                    while (cm3i < cm3.length()) {
                        var mn3: String = gen.get_fun_name(cm3[cm3i])
                        if (mn3.length() > 0) { cm3_names.push(mn3) }
                        cm3i = cm3i + 1
                    }
                    gen.class_methods.set(cn3, cm3_names)
                    // Declared generic parameter names, kept alongside the method list
                    // so a method returning a class type parameter can be typed at a
                    // call site: `Box<String>` states that `T` is `String` (BUGS #95).
                    var tp3_names: List<String> = match (stmts3[si3]) { ClassDecl(n, tps, ps, f, m, d, c_vis) => tps
                        _ => []
                    }
                    if (tp3_names.length() > 0) {
                        gen.class_type_params.set(cn3, tp3_names)
                        if (prefix3.length() > 0) {
                            gen.class_type_params.set(prefix3 + cn3, tp3_names)
                        }
                    }
                }
            }
            si3 = si3 + 1
        }
        mi2 = mi2 + 1
    }

    // Coroutine detection across all modules
    var cmi: Float = 0
    while (cmi < module_stmts.length()) {
        gen.current_prefix = module_prefixes_list[cmi]
        gen.mark_coroutines(module_stmts[cmi])
        cmi = cmi + 1
    }
    gen.current_prefix = ""
    gen.mark_coroutines(program)

    // Pre-registration pass: add all declaration names to known_functions
    // BEFORE compiling any bodies, so forward references don't trigger warnings
    var pr_mi: Float = 0
    while (pr_mi < module_stmts.length()) {
        var pr_prefix: String = module_prefixes_list[pr_mi]
        var pr_stmts: List<AST.Stmt> = module_stmts[pr_mi]
        var pr_si: Float = 0
        while (pr_si < pr_stmts.length()) {
            var pr_kind: String = gen.classify_stmt(pr_stmts[pr_si])
            if (pr_kind == "fun") {
                var pr_fname: String = gen.get_fun_name(pr_stmts[pr_si])
                if (pr_fname.length() > 0) {
                    var pr_emit: String = pr_prefix + pr_fname
                    if (!gen.str_in_list(gen.known_functions,pr_emit)) {
                        gen.known_functions.push(pr_emit)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname)) {
                        gen.known_functions.push(pr_fname)
                    }
                }
            } else if (pr_kind == "class") {
                var pr_cname: String = match (pr_stmts[pr_si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                    _ => ""
                }
                if (pr_cname.length() > 0) {
                    var pr_type_name: String = pr_cname
                    if (pr_prefix.length() > 0) {
                        pr_type_name = pr_prefix + pr_cname
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_type_name)) {
                        gen.known_functions.push(pr_type_name)
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_cname)) {
                        gen.known_functions.push(pr_cname)
                    }
                    var pr_methods: List<AST.Stmt> = match (pr_stmts[pr_si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                        _ => []
                    }
                    var pr_mj: Float = 0
                    while (pr_mj < pr_methods.length()) {
                        var pr_mname: String = gen.get_fun_name(pr_methods[pr_mj])
                        if (pr_mname.length() > 0) {
                            var pr_full: String = pr_cname + "__" + pr_mname
                            var pr_prefixed: String = pr_prefix + pr_full
                            if (!gen.str_in_list(gen.known_functions,pr_full)) {
                                gen.known_functions.push(pr_full)
                            }
                            if (!gen.str_in_list(gen.known_functions,pr_prefixed)) {
                                gen.known_functions.push(pr_prefixed)
                            }
                        }
                        pr_mj = pr_mj + 1
                    }
                }
            } else if (pr_kind == "enum") {
                var pr_ename: String = match (pr_stmts[pr_si]) { EnumDecl(n, v, d, e_vis) => n
                    _ => ""
                }
                var pr_variants: List<AST.Variant> = match (pr_stmts[pr_si]) { EnumDecl(n, v, d, e_vis) => v
                    _ => []
                }
                if (pr_ename.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_ename)) {
                        gen.known_functions.push(pr_ename)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_prefix + pr_ename)) {
                        gen.known_functions.push(pr_prefix + pr_ename)
                    }
                }
                var pr_vi: Float = 0
                while (pr_vi < pr_variants.length()) {
                    var pr_vname: String = gen.get_variant_name(pr_variants[pr_vi])
                    if (pr_vname.length() > 0 and !gen.str_in_list(gen.known_functions,pr_vname)) {
                        gen.known_functions.push(pr_vname)
                    }
                    pr_vi = pr_vi + 1
                }
            }
            pr_si = pr_si + 1
        }
        pr_mi = pr_mi + 1
    }
    // Also pre-register main program's declarations
    var pr_pi: Float = 0
    while (pr_pi < program.length()) {
        var pr_pk: String = gen.classify_stmt(program[pr_pi])
        if (pr_pk == "fun") {
            var pr_fname2: String = gen.get_fun_name(program[pr_pi])
            if (pr_fname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname2)) {
                gen.known_functions.push(pr_fname2)
            }
        } else if (pr_pk == "class") {
            var pr_cname2: String = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                _ => ""
            }
            var pr_cdoc2: String = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => d
                _ => ""
            }
            if (pr_cdoc2.starts_with("@actor") and pr_cname2.length() > 0) {
                gen.actor_classes.set(pr_cname2, true)
            }
            if (pr_cname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_cname2)) {
                gen.known_functions.push(pr_cname2)
            }
            var pr_methods2: List<AST.Stmt> = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                _ => []
            }
            var pr_mj2: Float = 0
            while (pr_mj2 < pr_methods2.length()) {
                var pr_mname2: String = gen.get_fun_name(pr_methods2[pr_mj2])
                if (pr_mname2.length() > 0) {
                    var pr_full2: String = pr_cname2 + "__" + pr_mname2
                    if (!gen.str_in_list(gen.known_functions,pr_full2)) {
                        gen.known_functions.push(pr_full2)
                    }
                }
                pr_mj2 = pr_mj2 + 1
            }
        } else if (pr_pk == "enum") {
            var pr_ename2: String = match (program[pr_pi]) { EnumDecl(n, v, d, e_vis) => n
                _ => ""
            }
            var pr_variants2: List<AST.Variant> = match (program[pr_pi]) { EnumDecl(n, v, d, e_vis) => v
                _ => []
            }
            if (pr_ename2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_ename2)) {
                gen.known_functions.push(pr_ename2)
            }
            var pr_vnames2: List<String> = []
            var pr_vi2: Float = 0
            while (pr_vi2 < pr_variants2.length()) {
                var pr_vname2: String = gen.get_variant_name(pr_variants2[pr_vi2])
                var pr_vfields2: String = gen.get_variant_fields(pr_variants2[pr_vi2])
                if (pr_vname2.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_vname2)) {
                        gen.known_functions.push(pr_vname2)
                    }
                    pr_vnames2.push(pr_vname2)
                    gen.enum_variant_tags.set(pr_ename2 + "." + pr_vname2, pr_vi2)
                    gen.enum_variant_fields.set(pr_ename2 + "." + pr_vname2, pr_vfields2)
                }
                pr_vi2 = pr_vi2 + 1
            }
            gen.enum_defs.set(pr_ename2, pr_vnames2)
        }
        pr_pi = pr_pi + 1
    }

    // Pre-scan: register every module declaration's signature (defaults, param
    // names AND return type) BEFORE any IR generation, so a call compiled before
    // its callee's declaration still resolves. One shared implementation —
    // see Codegen.prescan_decls (BUGS #33/#36 had to patch four copies).
    var df_mi: Float = 0
    while (df_mi < module_stmts.length()) {
        var df_stmts: List<AST.Stmt> = module_stmts[df_mi]
        gen.prescan_decls(df_stmts, 0, df_stmts.length(), module_prefixes_list[df_mi])
        df_mi = df_mi + 1
    }

    // Compile each module's declarations with its prefix (in dependency order)
    var module_init_names: List<String> = []
    gen.register_only = false
    var mi: Float = 0
    while (mi < module_stmts.length()) {
        var stmts: List<AST.Stmt> = module_stmts[mi]
        var prefix: String = module_prefixes_list[mi]
        gen.current_prefix = prefix

        // Compile declarations (functions, classes, enums) — use classify_stmt
        // for reliable detection since is_decl can misfire for VarDecl
        var si: Float = 0
        while (si < stmts.length()) {
            var sk: String = gen.classify_stmt(stmts[si])
            if (sk == "fun" or sk == "enum" or sk == "class") {
                // Set pending_extend_class from pre-scanned map before gen_stmt
                var fn_name: String = gen.get_fun_name(stmts[si])
                if (fn_name.length() > 0 and gen.extend_map.has(prefix + fn_name)) {
                    gen.pending_extend_class = gen.extend_map.get(prefix + fn_name)
                } else {
                    gen.pending_extend_class = ""
                }
                gen.gen_stmt(stmts[si])
            }
            si = si + 1
        }

        // Check if module has top-level code (VarDecl, ExprStmt, etc.)
        var has_top: Bool = false
        si = 0
        while (si < stmts.length()) {
            var sk2: String = gen.classify_stmt(stmts[si])
            if (sk2 == "var" or sk2 == "let_pattern") {
                has_top = true
            } else if (sk2 == "expr") {
                if (!gen.is_nil_expr_stmt(stmts[si])) {
                    has_top = true
                }
            } else if (sk2 != "fun" and sk2 != "enum" and sk2 != "class") {
                has_top = true
            }
            si = si + 1
        }

        // Wrap module's top-level code in an init function
        if (has_top) {
            var init_suffix: String = "prelude_" + mi.to_string()
            if (prefix.length() > 0) {
                init_suffix = prefix.slice(0, prefix.length() - 1)
            }
            var init_name: String = "__mod_init_" + init_suffix
            gen.known_functions.push(init_name)
            module_init_names.push(init_name)
            gen.emit("")
            gen.emit("define i64 @" + init_name + "() {")
            gen.emit("entry:")
            gen.block_terminated = false
            gen.reset_locals()
            // Alloca vars for module-level VarDecls
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            si = 0
            while (si < stmts.length()) {
                var sk3: String = gen.classify_stmt(stmts[si])
                if (sk3 == "var" or sk3 == "let_pattern" or (sk3 == "expr" and !gen.is_nil_expr_stmt(stmts[si])) or (sk3 != "fun" and sk3 != "enum" and sk3 != "class" and sk3 != "expr")) {
                    var single_list: List<AST.Stmt> = []
                    single_list.push(stmts[si])
                    gen.collect_vars(single_list, top_vars, top_var_types)
                }
                si = si + 1
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                var vn: String = top_vars[vi]
                if (!gen.module_globals.has(prefix + vn)) {
                    gen.emit_indent("%" + gen.sanitize_name(vn) + " = alloca i64")
                }
                vi = vi + 1
            }
            si = 0
            while (si < stmts.length()) {
                var sk4: String = gen.classify_stmt(stmts[si])
                if (sk4 == "var" or sk4 == "let_pattern" or (sk4 == "expr" and !gen.is_nil_expr_stmt(stmts[si])) or (sk4 != "fun" and sk4 != "enum" and sk4 != "class" and sk4 != "expr")) {
                    gen.gen_stmt(stmts[si])
                }
                si = si + 1
            }
            // Register module globals as permanent GC roots (never popped).
            // This prevents heap objects stored in module globals from being
            // prematurely collected after this init function returns.
            if (!gen.identity_mode and !gen.block_terminated) {
                vi = 0
                while (vi < top_vars.length()) {
                    var gv_name: String = top_vars[vi]
                    var gv_type: String = top_var_types[vi]
                    if (gen.module_globals.has(prefix + gv_name) and gen.is_gc_root_type(gv_type)) {
                        var gv_int: String = gen.typed_ptr_to_val("@__g_" + prefix + gen.sanitize_name(gv_name), "i64*")
                        gen.emit_indent("call void @__gc_push_root(i64 " + gv_int + ")")
                    }
                    vi = vi + 1
                }
            }
            if (!gen.block_terminated) {
                gen.emit_indent("ret i64 0")
            }
            gen.emit("}")
            gen.block_terminated = false
        }

        mi = mi + 1
    }

    // Then compile the main program without prefix
    gen.current_prefix = ""
    gen.module_init_names = module_init_names
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_modules_flat(program: List<AST.Stmt>, all_stmts: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, alias_map: Map<String, String>, target: String, named_imports: Map<String, String>): String {
    return generate_with_modules_flat_opts(program, all_stmts, boundaries, prefixes_joined, alias_map, target, named_imports, false)
}

fun generate_with_modules_flat_opts(program: List<AST.Stmt>, all_stmts: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, alias_map: Map<String, String>, target: String, named_imports: Map<String, String>, identity_mode: Bool): String {
    var gen: Codegen = Codegen()
    gen.target = target
    gen.identity_mode = identity_mode
    // Reflect runtime functions (generated at end of compilation)
    gen.known_functions.push("__reflect_get_fields")
    gen.known_functions.push("__reflect_class_name")
    gen.known_functions.push("__reflect_is_class")
    gen.known_functions.push("__reflect_construct_from_map")
    gen.known_functions.push("__reflect_number_to_string")
    gen.known_functions.push("__gc_get_type_tag")
    gen.module_prefixes = alias_map
    // `IO` keeps a hard-wired prefix because it is implicit: a file with no
    // imports at all can still call IO.println, so there is no import statement
    // to derive an alias from. But the hard-wiring must not overwrite one that
    // IS there. `import "@io" as IO` used to be clobbered back to "__io_" here,
    // which sent every call to a runtime symbol — so `IO.open(p, m)` became
    // `@__io_open`, a function that does not exist, and the program failed at
    // link time with an undefined symbol and no diagnostic. The same held for
    // `bytes_alloc`, `bytes_from_string`, `read_file_bytes` and
    // `write_file_bytes`: all four are written in Saffron in src/lib/io.sf and
    // no runtime symbol backs them. Deferring to alias_map lets an explicit
    // import reach the module, exactly as any other alias does.
    if (!alias_map.has("IO")) {
        gen.module_prefixes.set("IO", "__io_")
    }
    // No hard-wired "OS" prefix. src/lib/os.sf is an ordinary stdlib module, so
    // its alias comes from alias_map like every other import; wiring OS here made
    // it a reserved name and shadowed the module's own Saffron functions.
    // Same deferral as IO/OS above (BUGS #88). Hard-wiring GC to the runtime
    // prefix routed `GC.set_threshold(4096)` straight at @__gc_set_threshold
    // with the argument still NaN-boxed, so 4096 arrived as ~9.2e18; the
    // matching getter re-masked it and read back 4096, hiding the corruption
    // (BUGS #74). src/lib/gc.sf's wrappers untag properly, and deferring to
    // alias_map is what reaches them.
    if (!alias_map.has("GC")) {
        gen.module_prefixes.set("GC", "__gc_")
    }
    // Task is handled by dedicated dispatch (Task.spawn, task.await, etc.)
    // and is NOT a real module prefix — don't register it here.
    gen.module_prefixes.set("Reflect", "stdlib_reflect_")
    gen.named_imports = named_imports
    gen.register_only = false
    var prefixes: List<String> = prefixes_joined.split("|")
    var dbgi: Float = 0
    while (dbgi < prefixes.length()) {
        dbgi = dbgi + 1
    }

    // Register runtime functions
    gen.known_functions.push("StringBuilder")
    gen.known_functions.push("__list_new")
    gen.known_functions.push("__list_push")
    gen.known_functions.push("__list_get")
    gen.known_functions.push("__list_set")
    gen.known_functions.push("__list_length")
    gen.known_functions.push("__list_pop")
    gen.known_functions.push("__sb_append")
    gen.known_functions.push("__sb_to_string")
    gen.known_functions.push("__safe_strcmp")
    gen.known_functions.push("__map_new")
    gen.known_functions.push("__map_set")
    gen.known_functions.push("__map_get")
    gen.known_functions.push("__map_has")
    gen.known_functions.push("__map_keys")
    gen.known_functions.push("__str_ends_with")
    gen.known_functions.push("__str_split")
    gen.known_functions.push("__str_replace")
    gen.known_functions.push("__int_to_string")
    gen.known_functions.push("__list_join")
    gen.known_functions.push("__join_append")
    gen.known_functions.push("__list_contains")
    gen.known_functions.push("__io_read_file")
    gen.known_functions.push("__io_write_file")
    gen.known_functions.push("__io_file_exists")
    gen.known_functions.push("__io_mkdir")
    gen.known_functions.push("__io_walk_dir")
    gen.known_functions.push("__io_append_file")
    // Without these two the bare-call path prefixes them with the module name
    // (stdlib_io___io_file_size), so the stdlib wrappers in src/lib/io.sf that
    // call them link against an undefined symbol. Both are defined in the
    // runtime (runtime.sf __io_file_size / __io_read_binary) — BUGS #85.
    gen.known_functions.push("__io_file_size")
    gen.known_functions.push("__io_read_binary")
    gen.known_functions.push("__io_is_dir")
    gen.known_functions.push("__io_rename")
    gen.known_functions.push("__io_delete_file")
    gen.known_functions.push("__os_set_env")
    gen.known_functions.push("__os_home")
    gen.known_functions.push("__io_read_stdin")
    gen.known_functions.push("__io_readline")
    gen.known_functions.push("__os_exec")
    gen.known_functions.push("__os_args")
    gen.known_functions.push("__os_cwd")
    gen.known_functions.push("__os_path_sep")
    gen.known_functions.push("__os_platform")
    gen.known_functions.push("__os_env")
    gen.known_functions.push("__os_system")
    // The io.sf wrappers `println`/`print` call these by bare name (they cannot
    // use an extern: an i64 extern param is untagged, which destroys the NaN-box
    // tag `__io_println_any` dispatches on). Without them here the bare-call path
    // prefixes them with the module name (stdlib_io___io_println) and the wrapper
    // links against an undefined symbol — the same shape as BUGS #85. Both are
    // already in runtime_declares().
    gen.known_functions.push("__io_println")
    gen.known_functions.push("__io_print")
    // The for-in element read (BUGS #62). Needed here for the same reason as the
    // two above: without it the auto-declare loop in output_body.sf emits a
    // `declare i64 @__any_iter_get(i64)` at its default arity of 1, which
    // redefines the two-argument declare runtime_declares() already emitted, and
    // the module fails to link. Same shape as BUGS #85. It IS in
    // runtime_declares(), so nothing is lost by suppressing the auto-declare.
    gen.known_functions.push("__any_iter_get")
    gen.func_ret_types.set("StringBuilder", gen.str_to_type("StringBuilder"))

    // Pre-scan: register module-level VarDecls as globals
    var mi: Float = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        var si: Float = start
        while (si < end) {
            if (!gen.is_decl(all_stmts[si])) {
                var stmt_kind: String = gen.classify_stmt(all_stmts[si])
                if (stmt_kind == "var") {
                    var vname: String = match (all_stmts[si]) { VarDecl(n, t, i, d, v_vis) => n
                        _ => ""
                    }
                    var vdoc3: String = gen.get_var_doc(all_stmts[si])
                    if (!vdoc3.starts_with("@import:")) {
                        gen.module_globals.set(prefix + vname, true)
                        gen.globals.push("@__g_" + prefix + gen.sanitize_name(vname) + " = global i64 0\n")
                        // Pre-register global variable type so functions compiled
                        // before the module init can resolve list/map/string dispatch
                        var vtype3: String = gen.get_var_type(all_stmts[si])
                        // Infer from the initializer when unannotated (BUGS #36) —
                        // see the note at the first module-global pre-scan.
                        if (vtype3.length() == 0 or vtype3 == "Any") {
                            var vinit3: String = gen.get_expr_type(gen.get_var_init(all_stmts[si]))
                            if (vinit3.starts_with("List") or vinit3.starts_with("Map") or vinit3 == "String") {
                                vtype3 = vinit3
                            }
                        }
                        if (vtype3.length() > 0 and vtype3 != "Any") {
                            gen.global_var_types.set(vname, vtype3)
                            gen.global_var_types.set(prefix + vname, vtype3)
                        }
                    }
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-scan: register extension methods from all modules
    // This reads FunDecl doc fields early before potential memory issues
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var fdoc: String = gen.get_fun_doc(all_stmts[si])
            if (fdoc.starts_with("@extend:")) {
                var fname: String = gen.get_fun_name(all_stmts[si])
                var ext_cls: String = fdoc.slice(8, fdoc.length())
                gen.extend_map.set(prefix + fname, ext_cls)
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-register class declarations from ALL modules so extend funs in
    // imported modules can reference class fields without null map lookups.
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var mod_kind: String = gen.classify_stmt(all_stmts[si])
            if (mod_kind == "class") {
                var mod_name: String = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                    _ => ""
                }
                // Only the primary base contributes fields — see the layout rule in
                // gen_class_decl_with_parents. parents[0] is that base.
                var mod_parent_all: List<String> = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => ps
                    _ => []
                }
                var mod_parent: String = ""
                if (mod_parent_all.length() > 0) { mod_parent = mod_parent_all[0] }
                var mod_fields: List<AST.Param> = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => f
                    _ => []
                }
                var mod_methods: List<AST.Stmt> = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                    _ => []
                }
                if (mod_name.length() > 0) {
                    var mod_fields_str: String = gen.params_to_string(mod_fields)
                    var mod_all_fields: String = mod_fields_str
                    if (mod_parent.length() > 0 and gen.class_fields.has(mod_parent)) {
                        var mod_parent_fields: String = gen.class_fields.get(mod_parent)
                        if (mod_parent_fields.length() > 0) {
                            if (mod_all_fields.length() > 0) {
                                mod_all_fields = mod_parent_fields + "," + mod_all_fields
                            } else {
                                mod_all_fields = mod_parent_fields
                            }
                        }
                    }
                    gen.class_fields.set(mod_name, mod_all_fields)
                    // Also register with module prefix for cross-module disambiguation
                    gen.class_fields.set(prefix + mod_name, mod_all_fields)
                    // Register struct names so resolve_class_type uses prefixed name
                    var mod_sn: String = mod_name
                    if (prefix.length() > 0) { mod_sn = prefix + mod_name }
                    gen.class_struct_names.set(mod_name, mod_sn)
                    if (prefix.length() > 0) {
                        gen.class_struct_names.set(prefix + mod_name, mod_sn)
                    }
                    // Register class methods list
                    var mod_method_names: List<String> = []
                    var mod_mi2: Float = 0
                    while (mod_mi2 < mod_methods.length()) {
                        var mname: String = gen.get_fun_name(mod_methods[mod_mi2])
                        if (mname.length() > 0) {
                            mod_method_names.push(mname)
                        }
                        mod_mi2 = mod_mi2 + 1
                    }
                    gen.class_methods.set(mod_name, mod_method_names)
                    // Declared generic parameter names, kept alongside the method list
                    // so a method returning a class type parameter can be typed at a
                    // call site: `Box<String>` states that `T` is `String` (BUGS #95).
                    var tpm_names: List<String> = match (all_stmts[si]) { ClassDecl(n, tps, ps, f, m, d, c_vis) => tps
                        _ => []
                    }
                    if (tpm_names.length() > 0) {
                        gen.class_type_params.set(mod_name, tpm_names)
                    }
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-scan: register main program top-level VarDecls as globals
    var gvi: Float = 0
    while (gvi < program.length()) {
        var gvk: String = gen.classify_stmt(program[gvi])
        if (gvk == "var") {
            var gvname: String = match (program[gvi]) { VarDecl(n, t, ii, d, v_vis) => n
                _ => ""
            }
            if (gvname.length() > 0) {
                gen.module_globals.set(gvname, true)
                gen.globals.push("@__g_" + gen.sanitize_name(gvname) + " = global i64 0\n")
                // Pre-register global variable type for method dispatch
                var gvtype: String = gen.get_var_type(program[gvi])
                // Infer from the initializer when unannotated, exactly as the
                // module-level pre-scan does (BUGS #36). This copy only ever read
                // the annotation, so `var _order = "abc"` in the main program
                // stayed untyped and every method on it misdispatched (#37).
                if (gvtype.length() == 0 or gvtype == "Any") {
                    var gvinit: String = gen.get_expr_type(gen.get_var_init(program[gvi]))
                    if (gvinit.starts_with("List") or gvinit.starts_with("Map") or gvinit == "String") {
                        gvtype = gvinit
                    }
                }
                if (gvtype.length() > 0 and gvtype != "Any") {
                    gen.global_var_types.set(gvname, gvtype)
                }
            }
        }
        gvi = gvi + 1
    }

    // Pre-register main program's class declarations so imported modules'
    // extend funs can reference class fields without crashing on null map lookups.
    var pri: Float = 0
    while (pri < program.length()) {
        var pr_kind: String = gen.classify_stmt(program[pri])
        if (pr_kind == "class") {
            var pr_name: String = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                _ => ""
            }
            // Only the primary base contributes fields — see the layout rule in
            // gen_class_decl_with_parents. parents[0] is that base.
            var pr_parent_all: List<String> = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => ps
                _ => []
            }
            var pr_parent: String = ""
            if (pr_parent_all.length() > 0) { pr_parent = pr_parent_all[0] }
            var pr_fields: List<AST.Param> = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => f
                _ => []
            }
            var pr_methods: List<AST.Stmt> = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                _ => []
            }
            var pr_doc: String = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => d
                _ => ""
            }
            if (pr_doc.starts_with("@actor")) {
                gen.actor_classes.set(pr_name, true)
            }
            if (pr_name.length() > 0) {
                var pr_fields_str: String = gen.params_to_string(pr_fields)
                var pr_all_fields: String = pr_fields_str
                if (pr_parent.length() > 0 and gen.class_fields.has(pr_parent)) {
                    var pr_parent_fields: String = gen.class_fields.get(pr_parent)
                    if (pr_parent_fields.length() > 0) {
                        if (pr_all_fields.length() > 0) {
                            pr_all_fields = pr_parent_fields + "," + pr_all_fields
                        } else {
                            pr_all_fields = pr_parent_fields
                        }
                    }
                }
                if (gen.actor_classes.has(pr_name)) {
                    if (pr_all_fields.length() > 0) {
                        pr_all_fields = "__actor_busy:Int,__actor_queue:Int," + pr_all_fields
                    } else {
                        pr_all_fields = "__actor_busy:Int,__actor_queue:Int"
                    }
                }
                gen.class_fields.set(pr_name, pr_all_fields)
                gen.class_struct_names.set(pr_name, pr_name)
                // Register class methods list
                var pr_method_names: List<String> = []
                var pr_mi2: Float = 0
                while (pr_mi2 < pr_methods.length()) {
                    var mname: String = gen.get_fun_name(pr_methods[pr_mi2])
                    if (mname.length() > 0) {
                        pr_method_names.push(mname)
                    }
                    pr_mi2 = pr_mi2 + 1
                }
                gen.class_methods.set(pr_name, pr_method_names)
                // Declared generic parameter names, kept alongside the method list
                // so a method returning a class type parameter can be typed at a
                // call site: `Box<String>` states that `T` is `String` (BUGS #95).
                var tpp_names: List<String> = match (program[pri]) { ClassDecl(n, tps, ps, f, m, d, c_vis) => tps
                    _ => []
                }
                if (tpp_names.length() > 0) {
                    gen.class_type_params.set(pr_name, tpp_names)
                }
            }
        }
        pri = pri + 1
    }

    // Coroutine detection: scan each module's stmts with correct prefix
    var cmi: Float = 0
    while (cmi < prefixes.length()) {
        gen.current_prefix = prefixes[cmi]
        var cmi_start: Float = boundaries[cmi]
        var cmi_end: Float = boundaries[cmi + 1]
        var cmi_stmts: List<AST.Stmt> = []
        var cmi_si: Float = cmi_start
        while (cmi_si < cmi_end) {
            cmi_stmts.push(all_stmts[cmi_si])
            cmi_si = cmi_si + 1
        }
        gen.mark_coroutines(cmi_stmts)
        cmi = cmi + 1
    }
    gen.current_prefix = ""
    gen.mark_coroutines(program)

    // Pre-registration pass: add all declaration names to known_functions
    // BEFORE compiling any bodies, so forward references don't trigger warnings
    var pr_mi: Float = 0
    while (pr_mi < prefixes.length()) {
        var pr_prefix: String = prefixes[pr_mi]
        var pr_start: Float = boundaries[pr_mi]
        var pr_end: Float = boundaries[pr_mi + 1]
        var pr_si: Float = pr_start
        while (pr_si < pr_end) {
            var pr_kind: String = gen.classify_stmt(all_stmts[pr_si])
            if (pr_kind == "fun") {
                var pr_fname: String = gen.get_fun_name(all_stmts[pr_si])
                if (pr_fname.length() > 0) {
                    var pr_emit: String = pr_prefix + pr_fname
                    if (!gen.str_in_list(gen.known_functions,pr_emit)) {
                        gen.known_functions.push(pr_emit)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname)) {
                        gen.known_functions.push(pr_fname)
                    }
                }
            } else if (pr_kind == "class") {
                var pr_cname: String = match (all_stmts[pr_si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                    _ => ""
                }
                if (pr_cname.length() > 0) {
                    var pr_type_name: String = pr_cname
                    if (pr_prefix.length() > 0) {
                        pr_type_name = pr_prefix + pr_cname
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_type_name)) {
                        gen.known_functions.push(pr_type_name)
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_cname)) {
                        gen.known_functions.push(pr_cname)
                    }
                    // Register all method names as ClassName__method
                    var pr_methods: List<AST.Stmt> = match (all_stmts[pr_si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                        _ => []
                    }
                    var pr_mj: Float = 0
                    while (pr_mj < pr_methods.length()) {
                        var pr_mname: String = gen.get_fun_name(pr_methods[pr_mj])
                        if (pr_mname.length() > 0) {
                            var pr_full: String = pr_cname + "__" + pr_mname
                            var pr_prefixed: String = pr_prefix + pr_full
                            if (!gen.str_in_list(gen.known_functions,pr_full)) {
                                gen.known_functions.push(pr_full)
                            }
                            if (!gen.str_in_list(gen.known_functions,pr_prefixed)) {
                                gen.known_functions.push(pr_prefixed)
                            }
                        }
                        pr_mj = pr_mj + 1
                    }
                }
            } else if (pr_kind == "enum") {
                var pr_ename: String = match (all_stmts[pr_si]) { EnumDecl(n, v, d, e_vis) => n
                    _ => ""
                }
                var pr_variants: List<AST.Variant> = match (all_stmts[pr_si]) { EnumDecl(n, v, d, e_vis) => v
                    _ => []
                }
                if (pr_ename.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_ename)) {
                        gen.known_functions.push(pr_ename)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_prefix + pr_ename)) {
                        gen.known_functions.push(pr_prefix + pr_ename)
                    }
                }
                var pr_vnames: List<String> = []
                var pr_vi: Float = 0
                while (pr_vi < pr_variants.length()) {
                    var pr_vname: String = gen.get_variant_name(pr_variants[pr_vi])
                    var pr_vfields: String = gen.get_variant_fields(pr_variants[pr_vi])
                    if (pr_vname.length() > 0) {
                        if (!gen.str_in_list(gen.known_functions,pr_vname)) {
                            gen.known_functions.push(pr_vname)
                        }
                        pr_vnames.push(pr_vname)
                        gen.enum_variant_tags.set(pr_ename + "." + pr_vname, pr_vi)
                        gen.enum_variant_fields.set(pr_ename + "." + pr_vname, pr_vfields)
                    }
                    pr_vi = pr_vi + 1
                }
                gen.enum_defs.set(pr_ename, pr_vnames)
            }
            pr_si = pr_si + 1
        }
        pr_mi = pr_mi + 1
    }
    // Also pre-register main program's declarations
    var pr_pi: Float = 0
    while (pr_pi < program.length()) {
        var pr_pk: String = gen.classify_stmt(program[pr_pi])
        if (pr_pk == "fun") {
            var pr_fname2: String = gen.get_fun_name(program[pr_pi])
            if (pr_fname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname2)) {
                gen.known_functions.push(pr_fname2)
            }
        } else if (pr_pk == "class") {
            var pr_cname2: String = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                _ => ""
            }
            var pr_cdoc2: String = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => d
                _ => ""
            }
            if (pr_cdoc2.starts_with("@actor") and pr_cname2.length() > 0) {
                gen.actor_classes.set(pr_cname2, true)
            }
            if (pr_cname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_cname2)) {
                gen.known_functions.push(pr_cname2)
            }
            var pr_methods2: List<AST.Stmt> = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                _ => []
            }
            var pr_mj2: Float = 0
            while (pr_mj2 < pr_methods2.length()) {
                var pr_mname2: String = gen.get_fun_name(pr_methods2[pr_mj2])
                if (pr_mname2.length() > 0) {
                    var pr_full2: String = pr_cname2 + "__" + pr_mname2
                    if (!gen.str_in_list(gen.known_functions,pr_full2)) {
                        gen.known_functions.push(pr_full2)
                    }
                }
                pr_mj2 = pr_mj2 + 1
            }
        } else if (pr_pk == "enum") {
            var pr_ename2: String = match (program[pr_pi]) { EnumDecl(n, v, d, e_vis) => n
                _ => ""
            }
            var pr_variants2: List<AST.Variant> = match (program[pr_pi]) { EnumDecl(n, v, d, e_vis) => v
                _ => []
            }
            if (pr_ename2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_ename2)) {
                gen.known_functions.push(pr_ename2)
            }
            var pr_vnames2: List<String> = []
            var pr_vi2: Float = 0
            while (pr_vi2 < pr_variants2.length()) {
                var pr_vname2: String = gen.get_variant_name(pr_variants2[pr_vi2])
                var pr_vfields2: String = gen.get_variant_fields(pr_variants2[pr_vi2])
                if (pr_vname2.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_vname2)) {
                        gen.known_functions.push(pr_vname2)
                    }
                    pr_vnames2.push(pr_vname2)
                    gen.enum_variant_tags.set(pr_ename2 + "." + pr_vname2, pr_vi2)
                    gen.enum_variant_fields.set(pr_ename2 + "." + pr_vname2, pr_vfields2)
                }
                pr_vi2 = pr_vi2 + 1
            }
            gen.enum_defs.set(pr_ename2, pr_vnames2)
        }
        pr_pi = pr_pi + 1
    }

    // Pre-scan: register every module declaration's signature (defaults, param
    // names AND return type) BEFORE any IR generation. One shared implementation
    // — see Codegen.prescan_decls (BUGS #33/#36 had to patch four copies).
    var pre_mi: Float = 0
    while (pre_mi < prefixes.length()) {
        gen.prescan_decls(all_stmts, boundaries[pre_mi], boundaries[pre_mi + 1], prefixes[pre_mi])
        pre_mi = pre_mi + 1
    }
    // Pre-scan the main program's own declarations through the same path.
    // This copy previously omitted func_ret_types entirely, leaving BUGS #33
    // live for top-level functions: a caller declared above its callee inferred
    // Int for the result and every method on it silently fell through (#37).
    gen.prescan_decls(program, 0, program.length(), "")

    // Compile each module's declarations
    var module_init_names: List<String> = []
    mi = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        gen.current_prefix = prefix

        var si: Float = start
        while (si < end) {
            // Use classify_stmt for reliable declaration detection —
            // is_decl can misfire for VarDecl due to cross-module enum matching issues
            var sk: String = gen.classify_stmt(all_stmts[si])
            if (sk == "fun" or sk == "enum" or sk == "class") {
                // Set pending_extend_class from pre-scanned map before gen_stmt
                var fn_name: String = gen.get_fun_name(all_stmts[si])
                if (fn_name.length() > 0 and gen.extend_map.has(prefix + fn_name)) {
                    gen.pending_extend_class = gen.extend_map.get(prefix + fn_name)
                } else {
                    gen.pending_extend_class = ""
                }
                gen.gen_stmt(all_stmts[si])
            }
            si = si + 1
        }

        // Module top-level code — use classify_stmt for reliable VarDecl detection
        var has_top: Bool = false
        si = start
        while (si < end) {
            var sk2: String = gen.classify_stmt(all_stmts[si])
            if (sk2 == "var" or sk2 == "let_pattern") {
                has_top = true
            } else if (sk2 == "expr") {
                if (!gen.is_nil_expr_stmt(all_stmts[si])) {
                    has_top = true
                }
            } else if (sk2 != "fun" and sk2 != "enum" and sk2 != "class") {
                has_top = true
            }
            si = si + 1
        }
        if (has_top) {
            var init_suffix2: String = "prelude_" + mi.to_string()
            if (prefix.length() > 0) {
                init_suffix2 = prefix.slice(0, prefix.length() - 1)
            }
            var init_name: String = "__mod_init_" + init_suffix2
            gen.known_functions.push(init_name)
            module_init_names.push(init_name)
            gen.emit("")
            gen.emit("define i64 @" + init_name + "() {")
            gen.emit("entry:")
            gen.block_terminated = false
            gen.reset_locals()
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            si = start
            while (si < end) {
                var sk3: String = gen.classify_stmt(all_stmts[si])
                if (sk3 == "var" or sk3 == "let_pattern" or (sk3 == "expr" and !gen.is_nil_expr_stmt(all_stmts[si])) or (sk3 != "fun" and sk3 != "enum" and sk3 != "class" and sk3 != "expr")) {
                    var single_list: List<AST.Stmt> = []
                    single_list.push(all_stmts[si])
                    gen.collect_vars(single_list, top_vars, top_var_types)
                }
                si = si + 1
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                var vn: String = top_vars[vi]
                if (!gen.module_globals.has(prefix + vn)) {
                    gen.emit_indent("%" + gen.sanitize_name(vn) + " = alloca i64")
                }
                vi = vi + 1
            }
            si = start
            while (si < end) {
                var sk4: String = gen.classify_stmt(all_stmts[si])
                if (sk4 == "var" or sk4 == "let_pattern") {
                    gen.gen_stmt(all_stmts[si])
                } else if (sk4 == "expr" and !gen.is_nil_expr_stmt(all_stmts[si])) {
                    gen.gen_stmt(all_stmts[si])
                }
                si = si + 1
            }
            // Register module globals as permanent GC roots (never popped).
            if (!gen.identity_mode and !gen.block_terminated) {
                vi = 0
                while (vi < top_vars.length()) {
                    var gv_name: String = top_vars[vi]
                    var gv_type: String = top_var_types[vi]
                    if (gen.module_globals.has(prefix + gv_name) and gen.is_gc_root_type(gv_type)) {
                        var gv_int: String = gen.typed_ptr_to_val("@__g_" + prefix + gen.sanitize_name(gv_name), "i64*")
                        gen.emit_indent("call void @__gc_push_root(i64 " + gv_int + ")")
                    }
                    vi = vi + 1
                }
            }
            if (!gen.block_terminated) {
                gen.emit_indent("ret i64 0")
            }
            gen.emit("}")
            gen.block_terminated = false
        }

        mi = mi + 1
    }

    gen.current_prefix = ""
    gen.module_init_names = module_init_names
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}



fun generate_with_target_opts2(program: List<AST.Stmt>, target: String, identity_mode: Bool, use_llvm_lib: Bool): String {
    return generate_with_target_opts3(program, target, identity_mode, use_llvm_lib, false)
}

fun generate_with_target_opts3(program: List<AST.Stmt>, target: String, identity_mode: Bool, use_llvm_lib: Bool, emit_llvm_lib: Bool): String {
    var gen: Codegen = Codegen()
    gen.target = target
    gen.identity_mode = identity_mode
    gen.use_llvm_lib = use_llvm_lib
    gen.emit_llvm_lib = emit_llvm_lib
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_modules_flat_opts2(program: List<AST.Stmt>, all_stmts: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, alias_map: Map<String, String>, target: String, named_imports: Map<String, String>, identity_mode: Bool, use_llvm_lib: Bool): String {
    return generate_with_modules_flat_opts3(program, all_stmts, boundaries, prefixes_joined, alias_map, target, named_imports, identity_mode, use_llvm_lib, false)
}

fun generate_with_modules_flat_opts3(program: List<AST.Stmt>, all_stmts: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, alias_map: Map<String, String>, target: String, named_imports: Map<String, String>, identity_mode: Bool, use_llvm_lib: Bool, emit_llvm_lib: Bool): String {
    var gen: Codegen = Codegen()
    gen.target = target
    gen.identity_mode = identity_mode
    gen.use_llvm_lib = use_llvm_lib
    gen.emit_llvm_lib = emit_llvm_lib
    // Reflect runtime functions (generated at end of compilation)
    gen.known_functions.push("__reflect_get_fields")
    gen.known_functions.push("__reflect_class_name")
    gen.known_functions.push("__reflect_is_class")
    gen.known_functions.push("__reflect_construct_from_map")
    gen.known_functions.push("__reflect_number_to_string")
    gen.known_functions.push("__gc_get_type_tag")
    gen.module_prefixes = alias_map
    // `IO` keeps a hard-wired prefix because it is implicit: a file with no
    // imports at all can still call IO.println, so there is no import statement
    // to derive an alias from. But the hard-wiring must not overwrite one that
    // IS there. `import "@io" as IO` used to be clobbered back to "__io_" here,
    // which sent every call to a runtime symbol — so `IO.open(p, m)` became
    // `@__io_open`, a function that does not exist, and the program failed at
    // link time with an undefined symbol and no diagnostic. The same held for
    // `bytes_alloc`, `bytes_from_string`, `read_file_bytes` and
    // `write_file_bytes`: all four are written in Saffron in src/lib/io.sf and
    // no runtime symbol backs them. Deferring to alias_map lets an explicit
    // import reach the module, exactly as any other alias does.
    if (!alias_map.has("IO")) {
        gen.module_prefixes.set("IO", "__io_")
    }
    // No hard-wired "OS" prefix. src/lib/os.sf is an ordinary stdlib module, so
    // its alias comes from alias_map like every other import; wiring OS here made
    // it a reserved name and shadowed the module's own Saffron functions.
    // Same deferral as IO/OS above (BUGS #88). Hard-wiring GC to the runtime
    // prefix routed `GC.set_threshold(4096)` straight at @__gc_set_threshold
    // with the argument still NaN-boxed, so 4096 arrived as ~9.2e18; the
    // matching getter re-masked it and read back 4096, hiding the corruption
    // (BUGS #74). src/lib/gc.sf's wrappers untag properly, and deferring to
    // alias_map is what reaches them.
    if (!alias_map.has("GC")) {
        gen.module_prefixes.set("GC", "__gc_")
    }
    // Task is handled by dedicated dispatch (Task.spawn, task.await, etc.)
    // and is NOT a real module prefix — don't register it here.
    gen.module_prefixes.set("Reflect", "stdlib_reflect_")
    gen.named_imports = named_imports
    gen.register_only = false
    var prefixes: List<String> = prefixes_joined.split("|")
    var dbgi: Float = 0
    while (dbgi < prefixes.length()) {
        dbgi = dbgi + 1
    }

    // Register runtime functions
    gen.known_functions.push("StringBuilder")
    gen.known_functions.push("__list_new")
    gen.known_functions.push("__list_push")
    gen.known_functions.push("__list_get")
    gen.known_functions.push("__list_set")
    gen.known_functions.push("__list_length")
    gen.known_functions.push("__list_pop")
    gen.known_functions.push("__sb_append")
    gen.known_functions.push("__sb_to_string")
    gen.known_functions.push("__safe_strcmp")
    gen.known_functions.push("__map_new")
    gen.known_functions.push("__map_set")
    gen.known_functions.push("__map_get")
    gen.known_functions.push("__map_has")
    gen.known_functions.push("__map_keys")
    gen.known_functions.push("__str_ends_with")
    gen.known_functions.push("__str_split")
    gen.known_functions.push("__str_replace")
    gen.known_functions.push("__int_to_string")
    gen.known_functions.push("__list_join")
    gen.known_functions.push("__join_append")
    gen.known_functions.push("__list_contains")
    gen.known_functions.push("__io_read_file")
    gen.known_functions.push("__io_write_file")
    gen.known_functions.push("__io_file_exists")
    gen.known_functions.push("__io_mkdir")
    gen.known_functions.push("__io_walk_dir")
    gen.known_functions.push("__io_append_file")
    // Without these two the bare-call path prefixes them with the module name
    // (stdlib_io___io_file_size), so the stdlib wrappers in src/lib/io.sf that
    // call them link against an undefined symbol. Both are defined in the
    // runtime (runtime.sf __io_file_size / __io_read_binary) — BUGS #85.
    gen.known_functions.push("__io_file_size")
    gen.known_functions.push("__io_read_binary")
    gen.known_functions.push("__io_is_dir")
    gen.known_functions.push("__io_rename")
    gen.known_functions.push("__io_delete_file")
    gen.known_functions.push("__os_set_env")
    gen.known_functions.push("__os_home")
    gen.known_functions.push("__io_read_stdin")
    gen.known_functions.push("__io_readline")
    gen.known_functions.push("__os_exec")
    gen.known_functions.push("__os_args")
    gen.known_functions.push("__os_cwd")
    gen.known_functions.push("__os_path_sep")
    gen.known_functions.push("__os_platform")
    gen.known_functions.push("__os_env")
    gen.known_functions.push("__os_system")
    // The io.sf wrappers `println`/`print` call these by bare name (they cannot
    // use an extern: an i64 extern param is untagged, which destroys the NaN-box
    // tag `__io_println_any` dispatches on). Without them here the bare-call path
    // prefixes them with the module name (stdlib_io___io_println) and the wrapper
    // links against an undefined symbol — the same shape as BUGS #85. Both are
    // already in runtime_declares().
    gen.known_functions.push("__io_println")
    gen.known_functions.push("__io_print")
    // The for-in element read (BUGS #62). Needed here for the same reason as the
    // two above: without it the auto-declare loop in output_body.sf emits a
    // `declare i64 @__any_iter_get(i64)` at its default arity of 1, which
    // redefines the two-argument declare runtime_declares() already emitted, and
    // the module fails to link. Same shape as BUGS #85. It IS in
    // runtime_declares(), so nothing is lost by suppressing the auto-declare.
    gen.known_functions.push("__any_iter_get")
    gen.func_ret_types.set("StringBuilder", gen.str_to_type("StringBuilder"))

    // Pre-scan: register module-level VarDecls as globals
    var mi: Float = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        var si: Float = start
        while (si < end) {
            if (!gen.is_decl(all_stmts[si])) {
                var stmt_kind: String = gen.classify_stmt(all_stmts[si])
                if (stmt_kind == "var") {
                    var vname: String = match (all_stmts[si]) { VarDecl(n, t, i, d, v_vis) => n
                        _ => ""
                    }
                    var vdoc3: String = gen.get_var_doc(all_stmts[si])
                    if (!vdoc3.starts_with("@import:")) {
                        gen.module_globals.set(prefix + vname, true)
                        gen.globals.push("@__g_" + prefix + gen.sanitize_name(vname) + " = global i64 0\n")
                        // Pre-register global variable type so functions compiled
                        // before the module init can resolve list/map/string dispatch
                        var vtype3: String = gen.get_var_type(all_stmts[si])
                        // Infer from the initializer when unannotated (BUGS #36) —
                        // see the note at the first module-global pre-scan.
                        if (vtype3.length() == 0 or vtype3 == "Any") {
                            var vinit3: String = gen.get_expr_type(gen.get_var_init(all_stmts[si]))
                            if (vinit3.starts_with("List") or vinit3.starts_with("Map") or vinit3 == "String") {
                                vtype3 = vinit3
                            }
                        }
                        if (vtype3.length() > 0 and vtype3 != "Any") {
                            gen.global_var_types.set(vname, vtype3)
                            gen.global_var_types.set(prefix + vname, vtype3)
                        }
                    }
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-scan: register extension methods from all modules
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var fdoc: String = gen.get_fun_doc(all_stmts[si])
            if (fdoc.starts_with("@extend:")) {
                var fname: String = gen.get_fun_name(all_stmts[si])
                var ext_cls: String = fdoc.slice(8, fdoc.length())
                gen.extend_map.set(prefix + fname, ext_cls)
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-register class declarations from ALL modules
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var mod_kind: String = gen.classify_stmt(all_stmts[si])
            if (mod_kind == "class") {
                var mod_name: String = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                    _ => ""
                }
                // Only the primary base contributes fields — see the layout rule in
                // gen_class_decl_with_parents. parents[0] is that base.
                var mod_parent_all: List<String> = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => ps
                    _ => []
                }
                var mod_parent: String = ""
                if (mod_parent_all.length() > 0) { mod_parent = mod_parent_all[0] }
                var mod_fields: List<AST.Param> = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => f
                    _ => []
                }
                var mod_methods: List<AST.Stmt> = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                    _ => []
                }
                if (mod_name.length() > 0) {
                    var mod_fields_str: String = gen.params_to_string(mod_fields)
                    var mod_all_fields: String = mod_fields_str
                    if (mod_parent.length() > 0 and gen.class_fields.has(mod_parent)) {
                        var mod_parent_fields: String = gen.class_fields.get(mod_parent)
                        if (mod_parent_fields.length() > 0) {
                            if (mod_all_fields.length() > 0) {
                                mod_all_fields = mod_parent_fields + "," + mod_all_fields
                            } else {
                                mod_all_fields = mod_parent_fields
                            }
                        }
                    }
                    gen.class_fields.set(mod_name, mod_all_fields)
                    gen.class_fields.set(prefix + mod_name, mod_all_fields)
                    var mod_sn: String = mod_name
                    if (prefix.length() > 0) { mod_sn = prefix + mod_name }
                    gen.class_struct_names.set(mod_name, mod_sn)
                    if (prefix.length() > 0) {
                        gen.class_struct_names.set(prefix + mod_name, mod_sn)
                    }
                    var mod_method_names: List<String> = []
                    var mod_mi2: Float = 0
                    while (mod_mi2 < mod_methods.length()) {
                        var mname: String = gen.get_fun_name(mod_methods[mod_mi2])
                        if (mname.length() > 0) {
                            mod_method_names.push(mname)
                        }
                        mod_mi2 = mod_mi2 + 1
                    }
                    gen.class_methods.set(mod_name, mod_method_names)
                    // Declared generic parameter names, kept alongside the method list
                    // so a method returning a class type parameter can be typed at a
                    // call site: `Box<String>` states that `T` is `String` (BUGS #95).
                    var tpm_names: List<String> = match (all_stmts[si]) { ClassDecl(n, tps, ps, f, m, d, c_vis) => tps
                        _ => []
                    }
                    if (tpm_names.length() > 0) {
                        gen.class_type_params.set(mod_name, tpm_names)
                    }
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-register every imported module's extension-method SYMBOLS (BUGS #103).
    // See Codegen.prescan_extend_symbols for why. Runs AFTER the class
    // pre-registration loop above and not merged into the extend_map pre-scan
    // further up, because extend_class_prefix reads class_struct_names and that
    // loop is what fills it.
    //
    // The main program's own `extend fun`s are registered further down, after its
    // class pre-registration loop — main-program classes are not in
    // class_struct_names yet at this point.
    mi = 0
    while (mi < prefixes.length()) {
        gen.prescan_extend_symbols(all_stmts, boundaries[mi], boundaries[mi + 1], prefixes[mi])
        mi = mi + 1
    }

    // Pre-scan: register main program top-level VarDecls as globals
    var gvi: Float = 0
    while (gvi < program.length()) {
        var gvk: String = gen.classify_stmt(program[gvi])
        if (gvk == "var") {
            var gvname: String = match (program[gvi]) { VarDecl(n, t, ii, d, v_vis) => n
                _ => ""
            }
            if (gvname.length() > 0) {
                gen.module_globals.set(gvname, true)
                gen.globals.push("@__g_" + gen.sanitize_name(gvname) + " = global i64 0\n")
                // Pre-register global variable type for method dispatch
                var gvtype: String = gen.get_var_type(program[gvi])
                // Infer from the initializer when unannotated, exactly as the
                // module-level pre-scan does (BUGS #36). This copy only ever read
                // the annotation, so `var _order = "abc"` in the main program
                // stayed untyped and every method on it misdispatched (#37).
                if (gvtype.length() == 0 or gvtype == "Any") {
                    var gvinit: String = gen.get_expr_type(gen.get_var_init(program[gvi]))
                    if (gvinit.starts_with("List") or gvinit.starts_with("Map") or gvinit == "String") {
                        gvtype = gvinit
                    }
                }
                if (gvtype.length() > 0 and gvtype != "Any") {
                    gen.global_var_types.set(gvname, gvtype)
                }
            }
        }
        gvi = gvi + 1
    }

    // Pre-register main program's class declarations
    var pri: Float = 0
    while (pri < program.length()) {
        var pr_kind: String = gen.classify_stmt(program[pri])
        if (pr_kind == "class") {
            var pr_name: String = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                _ => ""
            }
            // Only the primary base contributes fields — see the layout rule in
            // gen_class_decl_with_parents. parents[0] is that base.
            var pr_parent_all: List<String> = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => ps
                _ => []
            }
            var pr_parent: String = ""
            if (pr_parent_all.length() > 0) { pr_parent = pr_parent_all[0] }
            var pr_fields: List<AST.Param> = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => f
                _ => []
            }
            var pr_methods: List<AST.Stmt> = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                _ => []
            }
            if (pr_name.length() > 0) {
                var pr_fields_str: String = gen.params_to_string(pr_fields)
                var pr_all_fields: String = pr_fields_str
                if (pr_parent.length() > 0 and gen.class_fields.has(pr_parent)) {
                    var pr_parent_fields: String = gen.class_fields.get(pr_parent)
                    if (pr_parent_fields.length() > 0) {
                        if (pr_all_fields.length() > 0) {
                            pr_all_fields = pr_parent_fields + "," + pr_all_fields
                        } else {
                            pr_all_fields = pr_parent_fields
                        }
                    }
                }
                gen.class_fields.set(pr_name, pr_all_fields)
                gen.class_struct_names.set(pr_name, pr_name)
                var pr_method_names: List<String> = []
                var pr_mi2: Float = 0
                while (pr_mi2 < pr_methods.length()) {
                    var mname: String = gen.get_fun_name(pr_methods[pr_mi2])
                    if (mname.length() > 0) {
                        pr_method_names.push(mname)
                    }
                    pr_mi2 = pr_mi2 + 1
                }
                gen.class_methods.set(pr_name, pr_method_names)
                // Declared generic parameter names, kept alongside the method list
                // so a method returning a class type parameter can be typed at a
                // call site: `Box<String>` states that `T` is `String` (BUGS #95).
                var tpp_names: List<String> = match (program[pri]) { ClassDecl(n, tps, ps, f, m, d, c_vis) => tps
                    _ => []
                }
                if (tpp_names.length() > 0) {
                    gen.class_type_params.set(pr_name, tpp_names)
                }
            }
        }
        pri = pri + 1
    }

    // The main program's own extension methods (BUGS #103), now that its classes
    // are in class_struct_names. Prefix "" — main program symbols are unprefixed —
    // but the class being extended may live in an imported module, in which case
    // extend_class_prefix returns that module's prefix rather than "". That is the
    // case `extend fun Ctx2.cz()` written in main.sf against a `Ctx2` from
    // core2.sf, which linked against @Ctx2__cz while the definition was
    // @core2_Ctx2__cz.
    gen.prescan_extend_symbols(program, 0, program.length(), "")

    // Coroutine detection
    var cmi: Float = 0
    while (cmi < prefixes.length()) {
        gen.current_prefix = prefixes[cmi]
        var cmi_start: Float = boundaries[cmi]
        var cmi_end: Float = boundaries[cmi + 1]
        var cmi_stmts: List<AST.Stmt> = []
        var cmi_si: Float = cmi_start
        while (cmi_si < cmi_end) {
            cmi_stmts.push(all_stmts[cmi_si])
            cmi_si = cmi_si + 1
        }
        gen.mark_coroutines(cmi_stmts)
        cmi = cmi + 1
    }
    gen.current_prefix = ""
    gen.mark_coroutines(program)

    // Pre-registration pass
    var pr_mi: Float = 0
    while (pr_mi < prefixes.length()) {
        var pr_prefix: String = prefixes[pr_mi]
        var pr_start: Float = boundaries[pr_mi]
        var pr_end: Float = boundaries[pr_mi + 1]
        var pr_si: Float = pr_start
        while (pr_si < pr_end) {
            var pr_kind2: String = gen.classify_stmt(all_stmts[pr_si])
            if (pr_kind2 == "fun") {
                var pr_fname: String = gen.get_fun_name(all_stmts[pr_si])
                if (pr_fname.length() > 0) {
                    var pr_emit: String = pr_prefix + pr_fname
                    if (!gen.str_in_list(gen.known_functions,pr_emit)) {
                        gen.known_functions.push(pr_emit)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname)) {
                        gen.known_functions.push(pr_fname)
                    }
                }
            } else if (pr_kind2 == "class") {
                var pr_cname: String = match (all_stmts[pr_si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                    _ => ""
                }
                if (pr_cname.length() > 0) {
                    var pr_type_name: String = pr_cname
                    if (pr_prefix.length() > 0) {
                        pr_type_name = pr_prefix + pr_cname
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_type_name)) {
                        gen.known_functions.push(pr_type_name)
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_cname)) {
                        gen.known_functions.push(pr_cname)
                    }
                    var pr_methods: List<AST.Stmt> = match (all_stmts[pr_si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                        _ => []
                    }
                    var pr_mj: Float = 0
                    while (pr_mj < pr_methods.length()) {
                        var pr_mname: String = gen.get_fun_name(pr_methods[pr_mj])
                        if (pr_mname.length() > 0) {
                            var pr_full: String = pr_cname + "__" + pr_mname
                            var pr_prefixed: String = pr_prefix + pr_full
                            if (!gen.str_in_list(gen.known_functions,pr_full)) {
                                gen.known_functions.push(pr_full)
                            }
                            if (!gen.str_in_list(gen.known_functions,pr_prefixed)) {
                                gen.known_functions.push(pr_prefixed)
                            }
                        }
                        pr_mj = pr_mj + 1
                    }
                }
            } else if (pr_kind2 == "enum") {
                var pr_ename: String = match (all_stmts[pr_si]) { EnumDecl(n, v, d, e_vis) => n
                    _ => ""
                }
                var pr_variants: List<AST.Variant> = match (all_stmts[pr_si]) { EnumDecl(n, v, d, e_vis) => v
                    _ => []
                }
                if (pr_ename.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_ename)) {
                        gen.known_functions.push(pr_ename)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_prefix + pr_ename)) {
                        gen.known_functions.push(pr_prefix + pr_ename)
                    }
                }
                var pr_vi: Float = 0
                while (pr_vi < pr_variants.length()) {
                    var pr_vname: String = gen.get_variant_name(pr_variants[pr_vi])
                    if (pr_vname.length() > 0 and !gen.str_in_list(gen.known_functions,pr_vname)) {
                        gen.known_functions.push(pr_vname)
                    }
                    pr_vi = pr_vi + 1
                }
            }
            pr_si = pr_si + 1
        }
        pr_mi = pr_mi + 1
    }
    // Also pre-register main program's declarations
    var pr_pi: Float = 0
    while (pr_pi < program.length()) {
        var pr_pk: String = gen.classify_stmt(program[pr_pi])
        if (pr_pk == "fun") {
            var pr_fname2: String = gen.get_fun_name(program[pr_pi])
            if (pr_fname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname2)) {
                gen.known_functions.push(pr_fname2)
            }
        } else if (pr_pk == "class") {
            var pr_cname2: String = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => n
                _ => ""
            }
            var pr_cdoc2: String = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => d
                _ => ""
            }
            if (pr_cdoc2.starts_with("@actor") and pr_cname2.length() > 0) {
                gen.actor_classes.set(pr_cname2, true)
            }
            if (pr_cname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_cname2)) {
                gen.known_functions.push(pr_cname2)
            }
            var pr_methods2: List<AST.Stmt> = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis) => m
                _ => []
            }
            var pr_mj2: Float = 0
            while (pr_mj2 < pr_methods2.length()) {
                var pr_mname2: String = gen.get_fun_name(pr_methods2[pr_mj2])
                if (pr_mname2.length() > 0) {
                    var pr_full2: String = pr_cname2 + "__" + pr_mname2
                    if (!gen.str_in_list(gen.known_functions,pr_full2)) {
                        gen.known_functions.push(pr_full2)
                    }
                }
                pr_mj2 = pr_mj2 + 1
            }
        } else if (pr_pk == "enum") {
            var pr_ename2: String = match (program[pr_pi]) { EnumDecl(n, v, d, e_vis) => n
                _ => ""
            }
            var pr_variants2: List<AST.Variant> = match (program[pr_pi]) { EnumDecl(n, v, d, e_vis) => v
                _ => []
            }
            if (pr_ename2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_ename2)) {
                gen.known_functions.push(pr_ename2)
            }
            var pr_vnames2: List<String> = []
            var pr_vi2: Float = 0
            while (pr_vi2 < pr_variants2.length()) {
                var pr_vname2: String = gen.get_variant_name(pr_variants2[pr_vi2])
                var pr_vfields2: String = gen.get_variant_fields(pr_variants2[pr_vi2])
                if (pr_vname2.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_vname2)) {
                        gen.known_functions.push(pr_vname2)
                    }
                    pr_vnames2.push(pr_vname2)
                    gen.enum_variant_tags.set(pr_ename2 + "." + pr_vname2, pr_vi2)
                    gen.enum_variant_fields.set(pr_ename2 + "." + pr_vname2, pr_vfields2)
                }
                pr_vi2 = pr_vi2 + 1
            }
            gen.enum_defs.set(pr_ename2, pr_vnames2)
        }
        pr_pi = pr_pi + 1
    }

    // Pre-scan: register every module declaration's signature (defaults, param
    // names AND return type) BEFORE any IR generation. One shared implementation
    // — see Codegen.prescan_decls (BUGS #33/#36 had to patch four copies).
    var pre_mi: Float = 0
    while (pre_mi < prefixes.length()) {
        gen.prescan_decls(all_stmts, boundaries[pre_mi], boundaries[pre_mi + 1], prefixes[pre_mi])
        pre_mi = pre_mi + 1
    }
    // Pre-scan the main program's own declarations through the same path.
    // This copy previously omitted func_ret_types entirely, leaving BUGS #33
    // live for top-level functions: a caller declared above its callee inferred
    // Int for the result and every method on it silently fell through (#37).
    gen.prescan_decls(program, 0, program.length(), "")

    // Compile each module's declarations
    var module_init_names: List<String> = []
    mi = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        gen.current_prefix = prefix

        var si: Float = start
        while (si < end) {
            var sk: String = gen.classify_stmt(all_stmts[si])
            if (sk == "fun" or sk == "enum" or sk == "class") {
                var fn_name: String = gen.get_fun_name(all_stmts[si])
                if (fn_name.length() > 0 and gen.extend_map.has(prefix + fn_name)) {
                    gen.pending_extend_class = gen.extend_map.get(prefix + fn_name)
                } else {
                    gen.pending_extend_class = ""
                }
                gen.gen_stmt(all_stmts[si])
            }
            si = si + 1
        }

        // Module top-level code
        var has_top: Bool = false
        si = start
        while (si < end) {
            var sk2: String = gen.classify_stmt(all_stmts[si])
            if (sk2 == "var" or sk2 == "let_pattern") {
                has_top = true
            } else if (sk2 == "expr") {
                if (!gen.is_nil_expr_stmt(all_stmts[si])) {
                    has_top = true
                }
            } else if (sk2 != "fun" and sk2 != "enum" and sk2 != "class") {
                has_top = true
            }
            si = si + 1
        }
        if (has_top) {
            var init_suffix2: String = "prelude_" + mi.to_string()
            if (prefix.length() > 0) {
                init_suffix2 = prefix.slice(0, prefix.length() - 1)
            }
            var init_name: String = "__mod_init_" + init_suffix2
            gen.known_functions.push(init_name)
            module_init_names.push(init_name)
            gen.emit("")
            gen.emit("define i64 @" + init_name + "() {")
            gen.emit("entry:")
            gen.block_terminated = false
            gen.reset_locals()
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            si = start
            while (si < end) {
                var sk3: String = gen.classify_stmt(all_stmts[si])
                if (sk3 == "var" or sk3 == "let_pattern" or (sk3 == "expr" and !gen.is_nil_expr_stmt(all_stmts[si])) or (sk3 != "fun" and sk3 != "enum" and sk3 != "class" and sk3 != "expr")) {
                    var single_list: List<AST.Stmt> = []
                    single_list.push(all_stmts[si])
                    gen.collect_vars(single_list, top_vars, top_var_types)
                }
                si = si + 1
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                var vn: String = top_vars[vi]
                if (!gen.module_globals.has(prefix + vn)) {
                    gen.emit_indent("%" + gen.sanitize_name(vn) + " = alloca i64")
                }
                vi = vi + 1
            }
            si = start
            while (si < end) {
                var sk4: String = gen.classify_stmt(all_stmts[si])
                if (sk4 == "var" or sk4 == "let_pattern") {
                    gen.gen_stmt(all_stmts[si])
                } else if (sk4 == "expr" and !gen.is_nil_expr_stmt(all_stmts[si])) {
                    gen.gen_stmt(all_stmts[si])
                }
                si = si + 1
            }
            // Register module globals as permanent GC roots
            if (!gen.identity_mode and !gen.block_terminated) {
                vi = 0
                while (vi < top_vars.length()) {
                    var gv_name: String = top_vars[vi]
                    var gv_type: String = top_var_types[vi]
                    if (gen.module_globals.has(prefix + gv_name) and gen.is_gc_root_type(gv_type)) {
                        var gv_int: String = gen.typed_ptr_to_val("@__g_" + prefix + gen.sanitize_name(gv_name), "i64*")
                        gen.emit_indent("call void @__gc_push_root(i64 " + gv_int + ")")
                    }
                    vi = vi + 1
                }
            }
            if (!gen.block_terminated) {
                gen.emit_indent("ret i64 0")
            }
            gen.emit("}")
            gen.block_terminated = false
        }

        mi = mi + 1
    }

    gen.current_prefix = ""
    gen.module_init_names = module_init_names
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun had_error(): Bool {
    return __codegen_errors
}
