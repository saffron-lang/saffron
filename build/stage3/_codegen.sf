            this.called_functions.push("__any_length")
            var raw: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(raw, "i64", "__any_length", "i64 " + obj))
            } else {
                this.emit_indent(raw + " = call i64 @__any_length(i64 " + obj + ")")
