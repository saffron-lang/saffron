    fun is_nil_type(t: AST.Type): Bool {
        return match (t) {
            NilType => true
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
