            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @" + ts_func + "(i64 " + obj + ")")
            var tagged: String = this.fresh_local()
            this.emit_indent(tagged + " = call i64 @__rt_tag_ptr(i64 " + local + ")")
            this.last_type = AST.Type.StringType
            return tagged
        } else if (obj_type.starts_with("List")) {
