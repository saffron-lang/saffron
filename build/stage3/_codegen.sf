    fun is_class_type(t: AST.Type, name: String): Bool {
        return match (t) {
            ClassType(n) => n == name
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    // Extract the value type string from a Map<K, V> type annotation.
    // e.g. "Map<String,AST.Type>" → "AST.Type"
    //      "Map<String,String>"   → "String"
    //      "Map" or unknown       → "Any"
    fun get_map_value_type(map_type: String): String {
        if (!map_type.starts_with("Map<")) return "Any"
        // Strip "Map<" prefix and trailing ">"
        var inner: String = map_type.slice(4, map_type.length() - 1)
        // Split on first comma respecting nested generics
        var parts: List<String> = this.split_respecting_generics(inner, ",")
        if (parts.length() < 2) return "Any"
        return parts[1]
    }

    // Get the type string for a variable from typed_vars (the single source of truth).
    // Returns "" if the variable is not registered.
    fun get_var_type_str(name: String): String {
        var result: String = ""
        if (this.typed_vars.has(name)) {
            result = this.type_to_string(this.typed_vars.get(name))
        } else if (this.global_var_types.has(name)) {
            result = this.global_var_types.get(name)
        } else if (this.current_prefix.length() > 0 and this.global_var_types.has(this.current_prefix + name)) {
            result = this.global_var_types.get(this.current_prefix + name)
        }
        // In identity mode, Float and Int are both i64 — treat Float as Int
        if (this.identity_mode and result == "Float") { return "Int" }
        return result
    }

    // Resolve a type string to the class name registered in class_fields.
    // Handles module-prefixed types like "Mod.Thing" by stripping the prefix
    // when class_fields only has "Thing".
    fun resolve_class_type(vtype: String): String {
        // Try module-prefixed version first to get correct struct type
        if (this.current_prefix.length() > 0) {
            var prefixed: String = this.current_prefix + vtype
            if (this.class_fields.has(prefixed)) {
                return prefixed
            }
        }
        if (this.class_fields.has(vtype)) {
            // Return the actual struct type name (may be prefixed)
            if (this.class_struct_names.has(vtype)) {
                return this.class_struct_names.get(vtype)
            }
            return vtype
        }
        // Strip module prefix: "Mod.Thing" -> "Thing"
        if (vtype.contains(".")) {
            var dot_idx: Float = vtype.index_of(".")
            var bare: String = vtype.slice(dot_idx + 1, vtype.length())
            // Try current module prefix on the bare name
            if (this.current_prefix.length() > 0) {
                var prefixed_bare: String = this.current_prefix + bare
                if (this.class_fields.has(prefixed_bare)) {
                    return prefixed_bare
                }
            }
            if (this.class_fields.has(bare)) {
                if (this.class_struct_names.has(bare)) {
                    return this.class_struct_names.get(bare)
                }
                return bare
            }
        }
        // Strip generic params then try: "Mod.Thing<X>" -> "Thing"
        if (vtype.contains("<")) {
            var base: String = vtype.slice(0, vtype.index_of("<"))
            if (this.current_prefix.length() > 0) {
                var prefixed_base: String = this.current_prefix + base
                if (this.class_fields.has(prefixed_base)) {
                    return prefixed_base
                }
            }
            if (this.class_fields.has(base)) {
                if (this.class_struct_names.has(base)) {
                    return this.class_struct_names.get(base)
                }
                return base
            }
            if (base.contains(".")) {
                var dot_idx2: Float = base.index_of(".")
                var bare2: String = base.slice(dot_idx2 + 1, base.length())
                if (this.current_prefix.length() > 0) {
                    var prefixed_bare2: String = this.current_prefix + bare2
                    if (this.class_fields.has(prefixed_bare2)) {
                        return prefixed_bare2
                    }
                }
                if (this.class_fields.has(bare2)) {
                    if (this.class_struct_names.has(bare2)) {
                        return this.class_struct_names.get(bare2)
                    }
                    return bare2
                }
            }
        }
        return ""
    }

    // --- Identity-mode tag/untag helpers ---
    // In identity mode, these are no-ops (values are raw i64).
    // In normal mode, they emit __val_tag/untag calls for NaN-boxing.

    fun emit_tag_int(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_int(i64 " + val + ")")
        return local
    }

    fun emit_untag_int(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_untag_int(i64 " + val + ")")
        return local
    }

    fun emit_tag_ptr(ptr: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = ptrtoint i8* " + ptr + " to i64")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_ptr(i8* " + ptr + ")")
        return local
    }

    fun emit_untag_ptr(val: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = inttoptr i64 " + val + " to i8*")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i8* @__val_untag_ptr(i64 " + val + ")")
        return local
    }

    fun emit_tag_bool(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_bool(i64 " + val + ")")
        return local
    }

    fun emit_untag_bool(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_untag_bool(i64 " + val + ")")
        return local
    }

    fun emit_tag_float(val: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = bitcast double " + val + " to i64")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_float(double " + val + ")")
        return local
    }

    fun emit_untag_float(val: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = bitcast i64 " + val + " to double")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call double @__val_untag_float(i64 " + val + ")")
        return local
    }

    // @codegen-split: expr
    fun gen_expr(expr: AST.Expr): String {
        return match (expr) {
            IntLit(v) => {
                this.last_type = AST.Type.IntType
                var raw: String = this.fresh_local()
                this.emit_indent(raw + " = add i64 0, " + v.floor().to_string())
                // LLVM lib parallel path — builds IntLit in the LLVM Module alongside string emission
                if (this.use_llvm_lib and !this.identity_mode) {
                    var llvm_zero: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(0, 64))
                    var llvm_val: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(v.floor(), 64))
                    var llvm_result: LLVMTypes.Value = this.llvm_block_builder.add(llvm_zero, llvm_val)
                    this.llvm_values.set(raw, llvm_result)
                }
                var local: String = this.emit_tag_int(raw)
                local
            }
            FloatLit(v) => {
                this.last_type = AST.Type.FloatType
                // v is the float literal text (e.g. "3.14").
                var local: String = this.emit_tag_float(v)
                local
            }
            BoolLit(v) => {
                this.last_type = AST.Type.BoolType
                var raw: String = this.fresh_local()
                var val_str: String = "0"
                if (v) { val_str = "1" }
                this.emit_indent(raw + " = add i64 0, " + val_str)
                // LLVM lib parallel path — builds BoolLit in the LLVM Module alongside string emission
                if (this.use_llvm_lib and !this.identity_mode) {
                    var bool_int: Float = 0
                    if (v) { bool_int = 1 }
                    var llvm_zero: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(0, 64))
                    var llvm_val: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(bool_int, 64))
                    var llvm_result: LLVMTypes.Value = this.llvm_block_builder.add(llvm_zero, llvm_val)
                    this.llvm_values.set(raw, llvm_result)
                }
                var local: String = this.emit_tag_bool(raw)
                local
            }
            StringLit(s) => {
                this.last_type = AST.Type.StringType
                var const_name: String = this.add_string_constant(s)
                var gep: String = this.fresh_local()
                var len: Float = s.length() + 1
                this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
                var local: String = this.emit_tag_ptr(gep)
                // LLVM lib parallel path — string literal ptrtoint
                // Full path needs Module.add_global_string() + GEP + ptrtoint;
                // deferred until the LLVM lib gains global string constant support
                if (this.use_llvm_lib and !this.identity_mode) {
                    // placeholder: string constants need Module.add_global_string()
                }
                local
            }
            NilLit => {
                this.last_type = AST.Type.NilType
                if (this.identity_mode or !this.in_function) {
                    "0"
                } else {
                    var local: String = this.fresh_local()
                    this.emit_indent(local + " = call i64 @__val_nil()")
                    local
                }
            }
            Variable(name) => {
                if (this.typed_vars.has(name)) {
                    this.last_type = this.typed_vars.get(name)
                } else {
                    this.last_type = AST.Type.IntType
                }
                // Error check: undefined variable
                // Skip check for module aliases and enum names (they are valid in expressions)
                if (!this.typed_vars.has(name) and !this.module_globals.has(this.current_prefix + name) and !this.module_globals.has(name) and !this.str_in_list(this.known_functions,name) and !this.str_in_list(this.known_functions,this.current_prefix + name) and name != "self" and name != "this" and name != "super" and name != "IO" and name != "OS" and name != "GC" and name != "Task" and !this.module_prefixes.has(name) and !this.enum_defs.has(name) and !this.class_fields.has(name)) {
                    IO.println("[codegen] Warning: undefined variable '" + name + "'")
                }
                // Function reference as first-class value: ptrtoint (check BEFORE load)
                // Skip for named imports — they should go through gen_call for direct dispatch
                if (this.str_in_list(this.known_functions,name)) {
                    if (!this.typed_vars.has(name)) {
                        if (!this.module_globals.has(this.current_prefix + name) and !this.module_globals.has(name)) {
                            if (!this.named_imports.has(name)) {
                                return this.gen_func_ref(name)
                            }
                        }
                    }
                }
                if (this.str_in_list(this.known_functions,this.current_prefix + name)) {
                    if (!this.typed_vars.has(name)) {
                        if (!this.module_globals.has(this.current_prefix + name) and !this.module_globals.has(name)) {
                            if (!this.named_imports.has(name)) {
                                return this.gen_func_ref(this.current_prefix + name)
                            }
                        }
                    }
                }
                var local: String = this.fresh_local()
                var var_ref: String = "%" + this.sanitize_name(name)
                if (this.module_globals.has(this.current_prefix + name)) {
                    var_ref = "@__g_" + this.current_prefix + this.sanitize_name(name)
                } else if (this.module_globals.has(name)) {
                    var_ref = "@__g_" + this.sanitize_name(name)
                }
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_load(local, "i64", var_ref))
                    // LLVM lib parallel path: propagate stored Value for this variable
                    if (!this.identity_mode and this.llvm_values.has(var_ref)) {
                        this.llvm_values.set(local, this.llvm_values.get(var_ref))
                    }
                } else {
                    this.emit_indent(local + " = load i64, i64* " + var_ref)
                    this.verify_load(local, "i64", var_ref)
                }
                local
            }
            Binary(left, op, right) => {
                this.gen_binary(left, op, right)
            }
            Unary(op, right) => {
                this.gen_unary(op, right)
            }
            Call(callee, args) => {
                this.gen_call(callee, args)
            }
            Assign(name, value) => {
                var val: String = this.gen_arg_value(value)
                if (this.typed_vars.has(name) or this.module_globals.has(this.current_prefix + name) or this.module_globals.has(name)) {
                    var var_ref: String = "%" + this.sanitize_name(name)
                    if (this.module_globals.has(this.current_prefix + name)) {
                        var_ref = "@__g_" + this.current_prefix + this.sanitize_name(name)
                    } else if (this.module_globals.has(name)) {
                        var_ref = "@__g_" + this.sanitize_name(name)
                    }
                    if (this.use_llvm_lib) {
                        this.emit_indent(this.lib_store(val, "i64", var_ref))
                    } else {
                        this.emit_indent("store i64 " + val + ", i64* " + var_ref)
                        this.verify_store(val, "i64", var_ref)
                    }
                }
                val
            }









            Logical(left, op, right) => {
                this.gen_logical(left, op, right)
            }
            MemberAccess(object, field) => {
                // Check if object is This -> field access
                if (this.is_this_expr(object)) {
                    return this.gen_get_field(object, field)
                }
                // Check if object is a variable of class type -> field access
                var obj_name: String = this.get_variable_name(object)
                // Tuple field access: t._0, t._1, etc.
                if (obj_name.length() > 0 and field.starts_with("_") and field.length() >= 2) {
                    var tf_vtype: String = this.get_var_type_str(obj_name)
                    if (tf_vtype.starts_with("Tuple<")) {
                        var tf_rest: String = field.slice(1, field.length())
                        var tf_idx: Float = tf_rest.to_number()
                        var tf_obj: String = this.gen_arg_value(object)
                        var tf_idx_val: String = this.fresh_local()
                        this.emit_indent(tf_idx_val + " = add i64 0, " + tf_idx.floor().to_string())
                        var tf_result: String = this.fresh_local()
                        this.emit_indent(tf_result + " = call i64 @__list_get(i64 " + tf_obj + ", i64 " + tf_idx_val + ")")
                        var tf_inner: String = tf_vtype.slice(6, tf_vtype.length() - 1)
                        var tf_args: List<String> = this.split_type_args(tf_inner)
                        if (tf_idx >= 0 and tf_idx < tf_args.length()) {
                            this.last_type = this.str_to_type(tf_args[tf_idx])
                        } else {
                            this.last_type = AST.Type.AnyType
                        }
                        return tf_result
                    }
                }
                if (obj_name.length() > 0) {
                    // Check enum first
                    var key: String = obj_name + "." + field
                    if (this.enum_variant_tags.has(key)) {
                        return this.gen_enum_construct(obj_name, field, [])
                    }
                    // Check if variable holds a class instance
                    var vtype: String = this.get_var_type_str(obj_name)
                    var resolved_type: String = this.resolve_class_type(vtype)
                    if (resolved_type.length() > 0) {
                        // It's a class instance — do field access
                        var obj_val: String = this.gen_arg_value(object)
                        var saved_class: String = this.current_class
                        this.current_class = resolved_type
                        var field_idx: Float = this.get_field_index(resolved_type, field)
                        var obj_ptr: String = this.val_to_typed_ptr(obj_val, "%" + resolved_type + "*")
                        var field_ptr: String = this.fresh_local()
                        this.emit_indent(field_ptr + " = getelementptr %" + resolved_type + ", %" + resolved_type + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
                        var result: String = this.fresh_local()
                        this.emit_indent(result + " = load i64, i64* " + field_ptr)
                        this.last_type = this.str_to_type(this.get_field_type(resolved_type, field))
                        this.current_class = saved_class
                        return result
                    }
                    // Package namespace: check named_imports for "Alias.field" first
                    if (this.named_imports.has(obj_name + "." + field)) {
                        var pe_ref: String = this.named_imports.get(obj_name + "." + field)
                        if (this.str_in_list(this.known_functions, pe_ref)) {
                            return this.gen_func_ref(pe_ref)
                        }
                    }
                    // Module-prefixed function reference: e.g. Routes.list_packages used as value
                    if (this.module_prefixes.has(obj_name)) {
                        var mp_resolved: String = this.module_prefixes.get(obj_name) + field
                        if (this.str_in_list(this.known_functions, mp_resolved)) {
                            return this.gen_func_ref(mp_resolved)
                        }
                        // Module-prefixed global variable: e.g. Cache.store
                        if (this.module_globals.has(mp_resolved)) {
                            var mg_local: String = this.fresh_local()
                            var mg_ref: String = "@__g_" + this.sanitize_name(mp_resolved)
                            this.emit_indent(mg_local + " = load i64, i64* " + mg_ref)
                            return mg_local
                        }
                    }
                }
                // Fallback: evaluate object, check last_type for class (handles chained expr like list[i].field)
                var ma_obj_val: String = this.gen_arg_value(object)
                var ma_type_str: String = this.type_to_string(this.last_type)
                var ma_resolved: String = this.resolve_class_type(ma_type_str)
                if (ma_resolved.length() > 0 and this.class_fields.has(ma_resolved)) {
                    var saved_class: String = this.current_class
                    this.current_class = ma_resolved
                    var struct_name: String = ma_resolved
                    if (this.class_struct_names.has(ma_resolved)) {
                        struct_name = this.class_struct_names.get(ma_resolved)
                    }
                    var field_idx: Float = this.get_field_index(ma_resolved, field)
                    var obj_ptr: String = this.val_to_typed_ptr(ma_obj_val, "%" + struct_name + "*")
                    var field_ptr: String = this.fresh_local()
                    this.emit_indent(field_ptr + " = getelementptr %" + struct_name + ", %" + struct_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
                    var result: String = this.fresh_local()
                    this.emit_indent(result + " = load i64, i64* " + field_ptr)
                    this.last_type = this.str_to_type(this.get_field_type(ma_resolved, field))
                    this.current_class = saved_class
                    return result
                }
                "0"
            }
            EnumConstruct(enum_name, variant, args) => {
                this.gen_enum_construct(enum_name, variant, args)
            }
            Match(subject, arms) => {
                this.gen_match(subject, arms)
            }
            Lambda(params, ret_type, body) => {
                this.gen_lambda(params, ret_type, body)
            }
            This => {
                this.last_type = this.str_to_type(this.current_class)
                var local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_load(local, "i64", "%self"))
                } else {
                    this.emit_indent(local + " = load i64, i64* %self")
                }
                local
            }
            GetField(object, field) => {
                this.gen_get_field(object, field)
            }
            SetField(object, field, value) => {
                this.gen_set_field(object, field, value)
            }
            ListLit(elements) => {
                this.gen_list_lit(elements)
            }
            IndexGet(object, index) => {
                this.gen_index_get(object, index)
            }
            IndexSet(object, index, value) => {
                this.gen_index_set(object, index, value)
            }
            MethodCall(object, method, args) => {
                this.gen_method_call(object, method, args)
            }
            MapLit => {
                this.last_type = this.make_map_type()
                var local: String = this.fresh_local()
                this.emit_indent(local + " = call i64 @__map_new()")
                local
            }
            BlockExpr(stmts, value) => {
                this.gen_stmts(stmts)
                this.gen_arg_value(value)
            }
            IsCheck(value, type_name) => {
                this.gen_is_check(value, type_name)
            }
            IfExpr(cond, then_stmts, then_val, else_stmts, else_val) => {
                this.gen_if_expr(cond, then_stmts, then_val, else_stmts, else_val)
            }
            TryExpr(try_stmts, try_val, catch_name, catch_stmts, catch_val) => {
                this.gen_try_expr(try_stmts, try_val, catch_name, catch_stmts, catch_val)
            }
            Yield(value) => {
                this.gen_yield(value)
            }
            TupleLit(elements) => {
                var result: String = this.gen_list_lit(elements)
                var tuple_type_str: String = "Tuple<"
                var tti: Float = 0
                while (tti < elements.length()) {
                    if (tti > 0) { tuple_type_str = tuple_type_str + "," }
                    var elem_type: String = this.get_expr_type(elements[tti])
                    tuple_type_str = tuple_type_str + elem_type
                    tti = tti + 1
                }
                tuple_type_str = tuple_type_str + ">"
                this.last_type = this.str_to_type(tuple_type_str)
                result
            }
        }
    }

    fun gen_yield(value: AST.Expr): String {
        // Detect yield [reason, arg] pattern for sleep/IO
        var is_list: String = match (value) { ListLit(elems) => "yes" _ => "no" }
        if (is_list == "yes") {
            var elems: List<AST.Expr> = match (value) { ListLit(e) => e }
            if (elems.length() >= 1) {
                var reason: String = this.gen_arg_value(elems[0])
                this.emit_indent("store i64 " + reason + ", i64* @__yield_reason")
                if (elems.length() >= 2) {
                    var arg: String = this.gen_arg_value(elems[1])
                    this.emit_indent("store i64 " + arg + ", i64* @__yield_arg")
                }
            }
        }

        // Coroutine suspend sequence
        var save_tok: String = this.fresh_local()
        this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
        var susp_result: String = this.fresh_local()
        this.emit_indent(susp_result + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")

        var resume_label: String = this.fresh_label("yield.resume")
        var cleanup_label: String = this.fresh_label("yield.cleanup")

        // Default (suspend) case branches to the shared __coro_suspend block.
        // CoroSplit requires all suspend points to share a single suspend/ret block;
        // per-yield suspend blocks become unreachable in the .resume function.
        this.emit_terminator("switch i8 " + susp_result + ", label %__coro_suspend [i8 0, label %" + resume_label + " i8 1, label %" + cleanup_label + "]")

        // Cleanup path (coroutine destroyed while suspended)
        this.emit(cleanup_label + ":")
        this.block_terminated = false
        this.emit_terminator("br label %__coro_cleanup")

        // Resume path — read resume value from promise slot
        this.emit(resume_label + ":")
        this.block_terminated = false
        var resume_val: String = "0"

        this.last_type = AST.Type.IntType
        return resume_val
    }

    fun gen_is_check(value: AST.Expr, type_name: String): String {
        var val: String = this.gen_arg_value(value)
        var val_type: AST.Type = this.last_type
        this.last_type = AST.Type.BoolType

        // When the compile-time type is Any, emit a runtime NaN-boxing tag check
        var val_type_str: String = this.type_to_string(val_type)
        if (val_type_str == "Any") {
            var rt_func: String = ""
            if (type_name == "Int" or type_name == "Number") {
                rt_func = "__val_is_int"
            } else if (type_name == "Float") {
                rt_func = "__val_is_float"
            } else if (type_name == "String") {
                rt_func = "__val_is_string"
            } else if (type_name == "Bool") {
                rt_func = "__val_is_bool"
            } else if (type_name == "Nil") {
                rt_func = "__val_is_nil"
            } else if (type_name == "List") {
                rt_func = "__val_is_list"
            } else if (type_name == "Map") {
                rt_func = "__val_is_map"
            }
            if (rt_func.length() > 0) {
                var check_result: String = this.fresh_local()
                this.emit_indent(check_result + " = call i1 @" + rt_func + "(i64 " + val + ")")
                var local: String = this.fresh_local()
                this.emit_indent(local + " = zext i1 " + check_result + " to i64")
                return local
            }
            // Unknown class type with Any — cannot resolve at runtime yet, return false
            var local: String = this.fresh_local()
            this.emit_indent(local + " = add i64 0, 0")
            return local
        }

        // Compile-time resolution when type is statically known
        var matches: String = "0"
        if (type_name == "Int" or type_name == "Number" or type_name == "Float") {
            if (this.is_int_type(val_type)) { matches = "1" }
        } else if (type_name == "String") {
            if (this.is_string_type(val_type)) { matches = "1" }
        } else if (type_name == "Bool") {
            if (this.is_bool_type(val_type)) { matches = "1" }
        } else if (type_name == "Nil") {
            if (this.is_nil_type(val_type)) { matches = "1" }
        } else if (type_name == "List") {
            if (this.is_list_type(val_type)) { matches = "1" }
        } else if (type_name == "Map") {
            if (this.is_map_type(val_type)) { matches = "1" }
        } else {
            if (this.is_class_type(val_type, type_name)) { matches = "1" }
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = add i64 0, " + matches)
        return local
    }

    fun gen_if_expr(cond: AST.Expr, then_stmts: List<AST.Stmt>, then_val: AST.Expr, else_stmts: List<AST.Stmt>, else_val: AST.Expr): String {
        var result_ptr: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_alloca(result_ptr, "i64"))
        } else {
            this.emit_indent(result_ptr + " = alloca i64")
            this.verify_alloca(result_ptr, "i64")
        }

        var cond_val: String = this.to_i1(this.gen_arg_value(cond))
        var then_label: String = this.fresh_label("ifexpr.then")
        var else_label: String = this.fresh_label("ifexpr.else")
        var end_label: String = this.fresh_label("ifexpr.end")

        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_cond_br(cond_val, then_label, else_label))
        } else {
            this.emit_terminator("br i1 " + cond_val + ", label %" + then_label + ", label %" + else_label)
            this.verify_cond_br(cond_val, then_label, else_label)
        }

        this.start_block(then_label)
        this.gen_stmts(then_stmts)
        var then_result: String = this.gen_arg_value(then_val)
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_store(then_result, "i64", result_ptr))
        } else {
            this.emit_indent("store i64 " + then_result + ", i64* " + result_ptr)
            this.verify_store(then_result, "i64", result_ptr)
        }
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(end_label))
        } else {
            this.emit_terminator("br label %" + end_label)
            this.verify_br(end_label)
        }

        this.start_block(else_label)
        this.gen_stmts(else_stmts)
        var else_result: String = this.gen_arg_value(else_val)
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_store(else_result, "i64", result_ptr))
        } else {
            this.emit_indent("store i64 " + else_result + ", i64* " + result_ptr)
            this.verify_store(else_result, "i64", result_ptr)
        }
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(end_label))
        } else {
            this.emit_terminator("br label %" + end_label)
            this.verify_br(end_label)
        }

        this.start_block(end_label)
        var result: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_load(result, "i64", result_ptr))
        } else {
            this.emit_indent(result + " = load i64, i64* " + result_ptr)
            this.verify_load(result, "i64", result_ptr)
        }
        return result
    }

    fun gen_try_expr(try_stmts: List<AST.Stmt>, try_val: AST.Expr, catch_name: String, catch_stmts: List<AST.Stmt>, catch_val: AST.Expr): String {
        var result_ptr: String = this.fresh_local()
        this.emit_indent(result_ptr + " = alloca i64")

        var try_label: String = this.fresh_label("tryexpr.try")
        var catch_label: String = this.fresh_label("tryexpr.catch")
        var end_label: String = this.fresh_label("tryexpr.end")

        // Allocate a local jmp_buf on the stack
        var jmp_buf: String = this.fresh_local()
        this.emit_indent(jmp_buf + " = alloca [512 x i8], align 16")
        var jmp_buf_ptr: String = this.fresh_local()
        this.emit_indent(jmp_buf_ptr + " = getelementptr [512 x i8], [512 x i8]* " + jmp_buf + ", i64 0, i64 0")

        // Save previous jmp_buf
        var saved_jmp: String = this.fresh_local()
        this.emit_indent(saved_jmp + " = load i8*, i8** @__jmp_buf_current")
        this.emit_indent("store i8* " + jmp_buf_ptr + ", i8** @__jmp_buf_current")

        // Save shadow stack depth for restoration on catch
        var saved_ss_depth: String = this.fresh_local()
        this.emit_indent(saved_ss_depth + " = call i64 @__gc_shadow_stack_depth()")

        // setjmp
        var setjmp_result: String = this.fresh_local()
        this.emit_indent(setjmp_result + " = call i32 @setjmp(i8* " + jmp_buf_ptr + ")")
        var is_throw: String = this.fresh_local()
        this.emit_indent(is_throw + " = icmp ne i32 " + setjmp_result + ", 0")
        this.emit_terminator("br i1 " + is_throw + ", label %" + catch_label + ", label %" + try_label)

        // Try body
        this.start_block(try_label)
        this.gen_stmts(try_stmts)
        var try_result: String = this.gen_arg_value(try_val)
        this.emit_indent("store i64 " + try_result + ", i64* " + result_ptr)
        this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
        this.emit_terminator("br label %" + end_label)

        // Catch body
        this.start_block(catch_label)
        this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
        // Restore shadow stack depth (longjmp skipped pop_roots)
        var cur_ss_depth: String = this.fresh_local()
        this.emit_indent(cur_ss_depth + " = call i64 @__gc_shadow_stack_depth()")
        var ss_pop_n: String = this.fresh_local()
        this.emit_indent(ss_pop_n + " = sub i64 " + cur_ss_depth + ", " + saved_ss_depth)
        this.emit_indent("call void @__gc_pop_roots(i64 " + ss_pop_n + ")")
        var exc_val: String = this.fresh_local()
        this.emit_indent(exc_val + " = load i64, i64* @__exception_value")
        this.emit_indent("store i64 " + exc_val + ", i64* %" + this.sanitize_name(catch_name))
        this.gen_stmts(catch_stmts)
        var catch_result: String = this.gen_arg_value(catch_val)
        this.emit_indent("store i64 " + catch_result + ", i64* " + result_ptr)
        this.emit_terminator("br label %" + end_label)

        this.start_block(end_label)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = load i64, i64* " + result_ptr)
        return result
    }

    fun op_to_method(op: String): String {
        if (op == "+") { return "add" }
        if (op == "-") { return "sub" }
        if (op == "*") { return "mul" }
        if (op == "/") { return "div" }
        if (op == "%") { return "mod" }
        if (op == "<") { return "lt" }
        if (op == ">") { return "gt" }
        if (op == "==") { return "eq" }
        return ""
    }

    fun gen_binary(left: AST.Expr, op: String, right: AST.Expr): String {
        // Operator overloading: check if left operand is a class with the method
        var method_name: String = this.op_to_method(op)
        if (method_name.length() > 0) {
            var left_name: String = this.get_variable_name(left)
            var left_class: String = ""
            if (left_name.length() > 0) {
                left_class = this.get_var_type_str(left_name)
            }
            if (left_class.length() > 0) {
                if (this.class_methods.has(left_class)) {
                    var methods: List = this.class_methods.get(left_class)
                    if (methods.contains(method_name)) {
                        // Dispatch: left.method(right)
                        var lhs: String = this.gen_arg_value(left)
                        var rhs: String = this.gen_arg_value(right)
                        var full_method: String = left_class + "__" + method_name
                        if (this.func_prefix_map.has(full_method)) {
                            full_method = this.func_prefix_map.get(full_method)
                        } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions,this.current_prefix + full_method)) {
                            full_method = this.current_prefix + full_method
                        }
                        this.called_functions.push(full_method)
                        var local: String = this.fresh_local()
                        this.emit_indent(local + " = call i64 @" + full_method + "(i64 " + lhs + ", i64 " + rhs + ")")
                        if (this.func_ret_types.has(full_method)) {
                            this.last_type = this.func_ret_types.get(full_method)
                        } else {
                            this.last_type = this.str_to_type(left_class)
                        }
                        return local
                    }
                }
            }
        }

        // String equality comparison
        if (op == "==" or op == "!=") {
            var left_type: String = this.get_expr_type(left)
            var right_type: String = this.get_expr_type(right)
            var lhs: String = this.gen_arg_value(left)
            if (left_type == "Any") { left_type = this.type_to_string(this.last_type) }
            var rhs: String = this.gen_arg_value(right)
            if (right_type == "Any") { right_type = this.type_to_string(this.last_type) }

            // Nil comparison: use __val_is_nil in NaN-boxing mode
            // Must come before string comparison to handle cases like:
            // map.get("missing") == nil where get returns "String" type but actual value is nil
            if (!this.identity_mode) {
                var is_nil_cmp: Bool = false
                if (left_type == "Nil") { is_nil_cmp = true }
                if (right_type == "Nil") { is_nil_cmp = true }
                if (is_nil_cmp) {
                    var check_val: String = lhs
                    if (left_type == "Nil") { check_val = rhs }
                    var is_nil_raw: String = this.fresh_local()
                    this.emit_indent(is_nil_raw + " = call i1 @__val_is_nil(i64 " + check_val + ")")
                    var nil_bool: String = is_nil_raw
                    if (op == "!=") {
                        nil_bool = this.fresh_local()
                        this.emit_indent(nil_bool + " = xor i1 " + is_nil_raw + ", true")
                    }
                    var raw_bool: String = this.fresh_local()
                    this.emit_indent(raw_bool + " = zext i1 " + nil_bool + " to i64")
                    this.last_type = AST.Type.BoolType
                    var local: String = this.emit_tag_bool(raw_bool)
                    return local
                }
            }

            if (left_type == "String" or right_type == "String") {
                var raw_bool: String = this.fresh_local()
                if (op == "==") {
                    this.emit_indent(raw_bool + " = call i64 @__string_eq(i64 " + lhs + ", i64 " + rhs + ")")
                } else {
                    this.emit_indent(raw_bool + " = call i64 @__string_ne(i64 " + lhs + ", i64 " + rhs + ")")
                }
                this.last_type = AST.Type.BoolType
                var local: String = this.emit_tag_bool(raw_bool)
                return local
            }

            // Any-typed equality: use __any_eq/__any_ne for deep comparison
            // (handles strings with different pointers but same content)
            if (left_type == "Any" or right_type == "Any") {
                var raw_bool: String = this.fresh_local()
                if (op == "==") {
                    this.emit_indent(raw_bool + " = call i64 @__any_eq(i64 " + lhs + ", i64 " + rhs + ")")
                } else {
                    this.emit_indent(raw_bool + " = call i64 @__any_ne(i64 " + lhs + ", i64 " + rhs + ")")
                }
                this.last_type = AST.Type.BoolType
                var local: String = this.emit_tag_bool(raw_bool)
                return local
            }

            // Float equality: untag both sides as float and compare at double level.
            // Raw icmp eq fails when one value is int-tagged (0x7FF9...) and the
            // other is float-tagged (after arithmetic), even if semantically equal.
            if (left_type == "Float" or right_type == "Float") {
                var lf: String = this.fresh_local()
                this.emit_indent(lf + " = call double @__val_untag_float(i64 " + lhs + ")")
                var rf: String = this.fresh_local()
                this.emit_indent(rf + " = call double @__val_untag_float(i64 " + rhs + ")")
                var cmp_local: String = this.fresh_local()
                if (op == "==") { this.emit_indent(cmp_local + " = fcmp oeq double " + lf + ", " + rf) }
                else { this.emit_indent(cmp_local + " = fcmp une double " + lf + ", " + rf) }
                var raw_bool: String = this.fresh_local()
                this.emit_indent(raw_bool + " = zext i1 " + cmp_local + " to i64")
                this.last_type = AST.Type.BoolType
                var local: String = this.emit_tag_bool(raw_bool)
                return local
            }

            // Integer comparison (tagged values compare equal correctly)
            var cmp_local: String = this.fresh_local()
            if (op == "==") { this.emit_indent(cmp_local + " = icmp eq i64 " + lhs + ", " + rhs) }
            else { this.emit_indent(cmp_local + " = icmp ne i64 " + lhs + ", " + rhs) }
            var raw_bool: String = this.fresh_local()
            this.emit_indent(raw_bool + " = zext i1 " + cmp_local + " to i64")
            // LLVM lib parallel path: track Value for == / != integer comparison
            if (this.use_llvm_lib and !this.identity_mode and this.llvm_values.has(lhs) and this.llvm_values.has(rhs)) {
                var lhs_v: Any = this.llvm_values.get(lhs)
                var rhs_v: Any = this.llvm_values.get(rhs)
                var cmp_v: Any = lhs_v
                if (op == "==") { cmp_v = this.llvm_block_builder.icmp_eq(lhs_v, rhs_v) }
                else { cmp_v = this.llvm_block_builder.icmp_ne(lhs_v, rhs_v) }
                var zext_v: Any = this.llvm_block_builder.zext(cmp_v, LLVMTypes.Type.I64)
                this.llvm_values.set(raw_bool, zext_v)
            }
            this.last_type = AST.Type.BoolType
            var local: String = this.emit_tag_bool(raw_bool)
            return local
        }

        if (op == "+") {
            // Type-directed: check types before generating code
            var left_type: String = this.get_expr_type(left)
            var right_type: String = this.get_expr_type(right)
            var lhs: String = this.gen_arg_value(left)
            if (left_type == "Any") { left_type = this.type_to_string(this.last_type) }
            var rhs: String = this.gen_arg_value(right)
            if (right_type == "Any") { right_type = this.type_to_string(this.last_type) }

            if (left_type == "String" or right_type == "String") {
                // String concatenation
                this.last_type = AST.Type.StringType
                var lptr: String = this.emit_untag_ptr(lhs)
                var rptr: String = this.emit_untag_ptr(rhs)
                var llen: String = this.fresh_local()
                this.emit_indent(llen + " = call i64 @strlen(i8* " + lptr + ")")
                var rlen: String = this.fresh_local()
                this.emit_indent(rlen + " = call i64 @strlen(i8* " + rptr + ")")
                var total: String = this.fresh_local()
                this.emit_indent(total + " = add i64 " + llen + ", " + rlen)
                var total1: String = this.fresh_local()
                this.emit_indent(total1 + " = add i64 " + total + ", 1")
                var buf: String = this.fresh_local()
                this.emit_indent(buf + " = call i8* @malloc(" + this.malloc_size_type() + " " + this.malloc_size_arg(total1) + ")")
                this.emit_indent("call i8* @strcpy(i8* " + buf + ", i8* " + lptr + ")")
                this.emit_indent("call i8* @strcat(i8* " + buf + ", i8* " + rptr + ")")
                var raw_result: String = this.ptr_to_val(buf)
                var result: String = this.fresh_local()
                this.emit_indent(result + " = call i64 @__string_intern(i64 " + raw_result + ")")
                // Tag the interned pointer for NaN-boxing
                var intern_ptr: String = this.fresh_local()
                this.emit_indent(intern_ptr + " = inttoptr i64 " + result + " to i8*")
                var tagged_result: String = this.emit_tag_ptr(intern_ptr)
                // LLVM lib parallel path: track string concatenation result
                if (!this.identity_mode) {
                    var sc_res: LLVMTypes.Value = this.llvm_block_builder.call("__string_concat", LLVMTypes.Type.I64, [])
                    this.llvm_values.set(tagged_result, sc_res)
                }
                return tagged_result
            }

            if (left_type == "Float" or right_type == "Float") {
                this.last_type = AST.Type.FloatType
                var ld: String = this.emit_untag_float(lhs)
                var rd: String = this.emit_untag_float(rhs)
                var fd: String = this.fresh_local()
                this.emit_indent(fd + " = fadd double " + ld + ", " + rd)
                return this.emit_tag_float(fd)
            }

            // Integer addition
            this.last_type = AST.Type.IntType
            var lhs_raw: String = this.emit_untag_int(lhs)
            var rhs_raw: String = this.emit_untag_int(rhs)
            var add_result: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("add", add_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for add
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.add(lhs_v, rhs_v)
                    this.llvm_values.set(add_result, res_v)
                }
            } else {
                this.emit_indent(add_result + " = add i64 " + lhs_raw + ", " + rhs_raw)
            }
            var local: String = this.emit_tag_int(add_result)
            return local
        }

        var left_type2: String = this.get_expr_type(left)
        var lhs: String = this.gen_arg_value(left)
        if (left_type2 == "Any") { left_type2 = this.type_to_string(this.last_type) }
        var right_type2: String = this.get_expr_type(right)
        var rhs: String = this.gen_arg_value(right)
        if (right_type2 == "Any") { right_type2 = this.type_to_string(this.last_type) }

        var __is_float_l: Bool = left_type2 == "Float"
        var __is_float_r: Bool = right_type2 == "Float"
        var __either_float: Bool = __is_float_l or __is_float_r
        var __is_sub: Bool = op == "-"
        var __is_mul: Bool = op == "*"
        var __is_div: Bool = op == "/"
        var __is_mod: Bool = op == "%"
        var __any_arith_op: Bool = __is_sub or __is_mul or __is_div or __is_mod
        var __take_float_path: Bool = __either_float and __any_arith_op

        if (__take_float_path) {
            this.last_type = AST.Type.FloatType
            var ld: String = this.emit_untag_float(lhs)
            var rd: String = this.emit_untag_float(rhs)
            var fd: String = this.fresh_local()
            if (op == "-") {
                this.emit_indent(fd + " = fsub double " + ld + ", " + rd)
            } else if (op == "*") {
                this.emit_indent(fd + " = fmul double " + ld + ", " + rd)
            } else if (op == "/") {
                this.emit_indent(fd + " = fdiv double " + ld + ", " + rd)
            } else {
                this.emit_indent(fd + " = frem double " + ld + ", " + rd)
            }
            return this.emit_tag_float(fd)
        }

        // Untag integer operands for arithmetic/comparison
        var lhs_raw: String = this.emit_untag_int(lhs)
        var rhs_raw: String = this.emit_untag_int(rhs)

        // Guard against division/modulo by zero
        if (op == "/" or op == "%") {
            var is_zero: String = this.fresh_local()
            this.emit_indent(is_zero + " = icmp eq i64 " + rhs_raw + ", 0")
            var lbl_err: String = this.fresh_label("div_err")
            var lbl_ok: String = this.fresh_label("div_ok")
            this.emit_terminator("br i1 " + is_zero + ", label %" + lbl_err + ", label %" + lbl_ok)
            this.start_block(lbl_err)
            this.emit_indent("call i64 @__division_error()")
            this.emit_terminator("unreachable")
            this.start_block(lbl_ok)
        }
        var op_result: String = this.fresh_local()
        this.last_type = AST.Type.IntType

        if (op == "-") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("sub", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for sub
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.sub(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = sub i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "*") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("mul", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for mul
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.mul(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = mul i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "/") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("sdiv", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for sdiv
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.sdiv(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = sdiv i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "%") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("srem", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for srem
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.srem(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = srem i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "&") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("and", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = and i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "|") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("or", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = or i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "^") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("xor", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = xor i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "<<") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("shl", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = shl i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == ">>") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("ashr", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = ashr i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=") {
            this.last_type = AST.Type.BoolType
            var cmp_local: String = this.fresh_local()
            if ((left_type2 == "String" or right_type2 == "String") and (op == "<" or op == "<=" or op == ">" or op == ">=")) {
                var strcmp_result: String = this.fresh_local()
                this.emit_indent(strcmp_result + " = call i64 @__safe_strcmp(i64 " + lhs + ", i64 " + rhs + ")")
                if (op == "<") { this.emit_indent(cmp_local + " = icmp slt i64 " + strcmp_result + ", 0") }
                else if (op == "<=") { this.emit_indent(cmp_local + " = icmp sle i64 " + strcmp_result + ", 0") }
                else if (op == ">") { this.emit_indent(cmp_local + " = icmp sgt i64 " + strcmp_result + ", 0") }
                else { this.emit_indent(cmp_local + " = icmp sge i64 " + strcmp_result + ", 0") }
            } else if (left_type2 == "Float" or right_type2 == "Float") {
                var cld: String = this.emit_untag_float(lhs)
                var crd: String = this.emit_untag_float(rhs)
                if (op == "==") { this.emit_indent(cmp_local + " = fcmp oeq double " + cld + ", " + crd) }
                else if (op == "!=") { this.emit_indent(cmp_local + " = fcmp one double " + cld + ", " + crd) }
                else if (op == "<") { this.emit_indent(cmp_local + " = fcmp olt double " + cld + ", " + crd) }
                else if (op == "<=") { this.emit_indent(cmp_local + " = fcmp ole double " + cld + ", " + crd) }
                else if (op == ">") { this.emit_indent(cmp_local + " = fcmp ogt double " + cld + ", " + crd) }
                else if (op == ">=") { this.emit_indent(cmp_local + " = fcmp oge double " + cld + ", " + crd) }
            } else if (op == "==") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("eq", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_eq value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_eq(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp eq i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == "!=") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("ne", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_ne value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_ne(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp ne i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == "<") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("slt", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_slt value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_slt(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp slt i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == "<=") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("sle", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_sle value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_sle(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp sle i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == ">") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("sgt", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_sgt value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_sgt(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp sgt i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == ">=") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("sge", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_sge value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_sge(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp sge i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_zext_op(op_result, cmp_local))
                // LLVM lib parallel path: track zext value
                if (!this.identity_mode and this.llvm_values.has(cmp_local)) {
                    var cmp_v: Any = this.llvm_values.get(cmp_local)
                    var ext_v: Any = this.llvm_block_builder.zext(cmp_v, LLVMTypes.Type.I64)
                    this.llvm_values.set(op_result, ext_v)
                }
            } else {
                this.emit_indent(op_result + " = zext i1 " + cmp_local + " to i64")
            }
        }

        // Tag the result: int for arithmetic/bitwise, bool for comparisons
        var local: String = op_result
        if (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=") {
            local = this.emit_tag_bool(op_result)
        } else {
            local = this.emit_tag_int(op_result)
        }
        return local
    }

    fun gen_string_concat(left: AST.Expr, right: AST.Expr): String {
        // Flatten string concat at compile time
        var combined: String = this.flatten_string_expr(left) + this.flatten_string_expr(right)
        var const_name: String = this.add_string_constant(combined)
        var gep: String = this.fresh_local()
        var len: Float = combined.length() + 1
        this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
        var local: String = this.emit_tag_ptr(gep)
        return local
    }

    fun flatten_string_expr(expr: AST.Expr): String {
        var kind: Any = match (expr) {
            StringLit(s) => s
            Binary(l, o, r) => this.flatten_string_expr(l) + this.flatten_string_expr(r)
        }
        return kind
    }

    fun gen_func_ref(fn_name: String): String {
        this.last_type = AST.Type.IntType
        var nparams: Float = 0
        if (this.func_param_count.has(fn_name)) {
            nparams = this.func_param_count.get(fn_name)
        }

        // Check if this function has captures (nested function with free variables).
        // If so, we must build a closure that packs the captured variable addresses
        // into an environment, and generate a trampoline that unpacks them.
        var has_captures: Bool = this.called_function_arity.has("__captures_" + fn_name)
        var cap_names: List<String> = []
        if (has_captures) {
            var caps_str: String = this.func_prefix_map.get("__caps_" + fn_name)
            if (caps_str.length() > 0) {
                cap_names = caps_str.split(",")
            } else {
                has_captures = false
            }
        }

        if (has_captures and cap_names.length() > 0) {
            // --- Nested function with captures: build a proper closure ---
            // The real function signature is: (cap0_ptr, cap1_ptr, ..., user_arg0, ...)
            // We create:
            //   1. An environment array holding the capture pointer values
            //   2. A trampoline that takes (env, user_args...), unpacks captures from
            //      env, and calls the real function with (caps..., user_args...)

            var num_caps: Float = cap_names.length()

            // Allocate environment: array of i64, one slot per capture
            var env_bytes: Float = num_caps * 8
            var env_raw: String = this.fresh_local()
            this.emit_indent(env_raw + " = call i8* @malloc(i64 " + env_bytes.floor().to_string() + ")")
            var env_ptr: String = this.fresh_local()
            this.emit_indent(env_ptr + " = bitcast i8* " + env_raw + " to [" + num_caps.floor().to_string() + " x i64]*")

            // Store capture pointer values into the environment
            var ci: Float = 0
            while (ci < num_caps) {
                var cap_val: String = this.typed_ptr_to_val("%" + this.sanitize_name(cap_names[ci]), "i64*")
                var slot: String = this.fresh_local()
                this.emit_indent(slot + " = getelementptr [" + num_caps.floor().to_string() + " x i64], [" + num_caps.floor().to_string() + " x i64]* " + env_ptr + ", i64 0, i64 " + ci.floor().to_string())
                this.emit_indent("store i64 " + cap_val + ", i64* " + slot)
                ci = ci + 1
            }

            // Generate trampoline: takes (i64 env, user_args...) and calls real function
            this.label_counter = this.label_counter + 1
            var wrap_name: String = "__wrap_" + this.label_counter.floor().to_string() + "_" + this.sanitize_name(fn_name)

            var wrap_params: List<String> = []
            wrap_params.push("i64 %__env.arg")
            var pi: Float = 0
            while (pi < nparams) {
                wrap_params.push("i64 %__a" + pi.floor().to_string() + ".arg")
                pi = pi + 1
            }

            var wrap_linkage: String = "define linkonce_odr"
            if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
                wrap_linkage = "define"
            }

            // Trampoline body: unpack captures from env, then call real function
            var wrap_ir: String = "\n" + wrap_linkage + " i64 @" + wrap_name + "(" + wrap_params.join(", ") + ") {\nentry:\n"

            // Cast env to typed array pointer
            if (this.target == "wasm32") {
                wrap_ir = wrap_ir + "  %__env_i32 = trunc i64 %__env.arg to i32\n"
                wrap_ir = wrap_ir + "  %__env_ptr = inttoptr i32 %__env_i32 to [" + num_caps.floor().to_string() + " x i64]*\n"
            } else {
                wrap_ir = wrap_ir + "  %__env_ptr = inttoptr i64 %__env.arg to [" + num_caps.floor().to_string() + " x i64]*\n"
            }

            // Extract each capture from env
            var fwd_args: List<String> = []
            ci = 0
            while (ci < num_caps) {
                var slot_name: String = "%__cap_slot_" + ci.floor().to_string()
                var val_name: String = "%__cap_" + ci.floor().to_string()
                wrap_ir = wrap_ir + "  " + slot_name + " = getelementptr [" + num_caps.floor().to_string() + " x i64], [" + num_caps.floor().to_string() + " x i64]* %__env_ptr, i64 0, i64 " + ci.floor().to_string() + "\n"
                wrap_ir = wrap_ir + "  " + val_name + " = load i64, i64* " + slot_name + "\n"
                fwd_args.push("i64 " + val_name)
                ci = ci + 1
            }

            // Add user args
            pi = 0
            while (pi < nparams) {
                fwd_args.push("i64 %__a" + pi.floor().to_string() + ".arg")
                pi = pi + 1
            }

            // Call the real function
            wrap_ir = wrap_ir + "  %r = call i64 @" + fn_name + "(" + fwd_args.join(", ") + ")\n"
            wrap_ir = wrap_ir + "  ret i64 %r\n}\n"
            this.globals.push(wrap_ir)

            // Build closure pair [trampoline_fn_ptr, env_ptr]
            var num_total_params: Float = nparams + 1
            var fn_type_str: String = "i64 ("
            var tti: Float = 0
            while (tti < num_total_params) {
                if (tti > 0) { fn_type_str = fn_type_str + ", " }
                fn_type_str = fn_type_str + "i64"
                tti = tti + 1
            }
            fn_type_str = fn_type_str + ")*"

            var closure_raw: String = this.fresh_local()
            this.emit_indent(closure_raw + " = call i8* @malloc(i64 16)")
            var closure_ptr: String = this.fresh_local()
            this.emit_indent(closure_ptr + " = bitcast i8* " + closure_raw + " to [2 x i64]*")
            var fn_as_int: String = this.fn_ptr_to_val(fn_type_str, "@" + wrap_name)
            var fn_slot: String = this.fresh_local()
            this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
            var env_as_int: String = this.typed_ptr_to_val(env_ptr, "[" + num_caps.floor().to_string() + " x i64]*")
            var env_slot: String = this.fresh_local()
            this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
            this.emit_indent("store i64 " + env_as_int + ", i64* " + env_slot)
            var result: String = this.typed_ptr_to_val(closure_ptr, "[2 x i64]*")
            return result
        }

        // --- No captures: plain function reference ---
        // Generate a trampoline wrapper that accepts (i64 env, <original params>)
        // and forwards to the real function (dropping env). This ensures the closure
        // calling convention (env first) works for plain function references.
        this.label_counter = this.label_counter + 1
        var wrap_name: String = "__wrap_" + this.label_counter.floor().to_string() + "_" + this.sanitize_name(fn_name)

        // Build trampoline param list: env + original params
        var wrap_params: List<String> = []
        wrap_params.push("i64 %__env.arg")
        var fwd_args: List<String> = []
        var pi: Float = 0
        while (pi < nparams) {
            var pname: String = "%__a" + pi.floor().to_string() + ".arg"
            wrap_params.push("i64 " + pname)
            fwd_args.push("i64 " + pname)
            pi = pi + 1
        }

        // Build the trampoline function IR
        // On WASM targets, use plain define to avoid function table index mismatch
        var wrap_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            wrap_linkage = "define"
        }
        var wrap_ir: String = "\n" + wrap_linkage + " i64 @" + wrap_name + "(" + wrap_params.join(", ") + ") {\nentry:\n"
        if (nparams == 0) {
            wrap_ir = wrap_ir + "  %r = call i64 @" + fn_name + "()\n"
        } else {
            wrap_ir = wrap_ir + "  %r = call i64 @" + fn_name + "(" + fwd_args.join(", ") + ")\n"
        }
        wrap_ir = wrap_ir + "  ret i64 %r\n}\n"
        this.globals.push(wrap_ir)

        // Build closure pair [trampoline_fn_ptr, 0] on the heap
        var num_total_params: Float = nparams + 1
        var fn_type_str: String = "i64 ("
        var tti: Float = 0
        while (tti < num_total_params) {
            if (tti > 0) { fn_type_str = fn_type_str + ", " }
            fn_type_str = fn_type_str + "i64"
            tti = tti + 1
        }
        fn_type_str = fn_type_str + ")*"

        var closure_raw: String = this.fresh_local()
        this.emit_indent(closure_raw + " = call i8* @malloc(i64 16)")
        var closure_ptr: String = this.fresh_local()
        this.emit_indent(closure_ptr + " = bitcast i8* " + closure_raw + " to [2 x i64]*")
        var fn_as_int: String = this.fn_ptr_to_val(fn_type_str, "@" + wrap_name)
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        this.emit_indent("store i64 0, i64* " + env_slot)
        var result: String = this.typed_ptr_to_val(closure_ptr, "[2 x i64]*")
        return result
    }

    fun gen_arg_value(expr: AST.Expr): String {
        // Handle function references as values (e.g. passing HomePage to Router.Route)
        var expr_kind: String = this.classify_expr(expr)
        if (expr_kind == "variable") {
            var __vn: String = match (expr) { Variable(n) => n
                _ => ""
            }
            if (this.str_in_list(this.known_functions,__vn)) {
                if (!this.typed_vars.has(__vn)) {
                    if (!this.module_globals.has(this.current_prefix + __vn)) {
                        if (!this.named_imports.has(__vn)) {
                            return this.gen_func_ref(__vn)
                        }
                    }
                }
            }
            if (this.str_in_list(this.known_functions,this.current_prefix + __vn)) {
                if (!this.typed_vars.has(__vn)) {
                    if (!this.module_globals.has(this.current_prefix + __vn)) {
                        if (!this.named_imports.has(__vn)) {
                            return this.gen_func_ref(this.current_prefix + __vn)
                        }
                    }
                }
            }
        }
        if (expr_kind == "method_call") {
            var mc_obj: AST.Expr = match (expr) { MethodCall(o, m, a) => o
                _ => AST.Expr.NilLit
            }
            var mc_method: String = match (expr) { MethodCall(o, m, a) => m
                _ => ""
            }
            var mc_args: List<AST.Expr> = match (expr) { MethodCall(o, m, a) => a
                _ => []
            }
            return this.gen_method_call(mc_obj, mc_method, mc_args)
        }
        if (expr_kind == "list_lit") {
            var elems: List<AST.Expr> = match (expr) { ListLit(e) => e
                _ => []
            }
            return this.gen_list_lit(elems)
        }
        if (expr_kind == "tuple_lit") {
            var elems: List<AST.Expr> = match (expr) { TupleLit(e) => e
                _ => []
            }
            var result: String = this.gen_list_lit(elems)
            var tuple_type_str: String = "Tuple<"
            var tti: Float = 0
            while (tti < elems.length()) {
                if (tti > 0) { tuple_type_str = tuple_type_str + "," }
                var elem_type: String = this.get_expr_type(elems[tti])
                tuple_type_str = tuple_type_str + elem_type
                tti = tti + 1
            }
            tuple_type_str = tuple_type_str + ">"
            this.last_type = this.str_to_type(tuple_type_str)
            return result
        }
        if (expr_kind == "index_get") {
            var ig_obj: AST.Expr = match (expr) { IndexGet(o, i) => o
                _ => AST.Expr.NilLit
            }
            var ig_idx: AST.Expr = match (expr) { IndexGet(o, i) => i
                _ => AST.Expr.NilLit
            }
            return this.gen_index_get(ig_obj, ig_idx)
        }
        if (expr_kind == "map_lit") {
            this.last_type = this.make_map_type()
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__map_new()")
            return local
        }
        if (expr_kind == "match_expr") {
            // Fall through to gen_expr which handles Match(subject, arms) directly
            return this.gen_expr(expr)
        }
        if (expr_kind == "if_expr") {
            return this.gen_expr(expr)
        }
        if (expr_kind == "try_expr") {
            return this.gen_expr(expr)
        }
        if (expr_kind == "block_expr") {
            var be_stmts: List<AST.Stmt> = match (expr) { BlockExpr(s, v) => s
                _ => []
            }
            var be_value: AST.Expr = match (expr) { BlockExpr(s, v) => v
                _ => AST.Expr.NilLit
            }
            this.gen_stmts(be_stmts)
            return this.gen_arg_value(be_value)
        }
        if (expr_kind == "get_field") {
            var gf_obj: AST.Expr = match (expr) { GetField(o, f) => o
                _ => AST.Expr.NilLit
            }
            var gf_field: String = match (expr) { GetField(o, f) => f
                _ => ""
            }
            return this.gen_get_field(gf_obj, gf_field)
        }
        if (expr_kind == "this") {
            this.last_type = this.str_to_type(this.current_class)
            var local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_load(local, "i64", "%self"))
            } else {
                this.emit_indent(local + " = load i64, i64* %self")
            }
            return local
        }
        if (expr_kind == "set_field") {
            var sf_obj: AST.Expr = match (expr) { SetField(o, f, v) => o
                _ => AST.Expr.NilLit
            }
            var sf_field: String = match (expr) { SetField(o, f, v) => f
                _ => ""
            }
            var sf_val: AST.Expr = match (expr) { SetField(o, f, v) => v
                _ => AST.Expr.NilLit
            }
            return this.gen_set_field(sf_obj, sf_field, sf_val)
        }
        if (expr_kind == "binary") {
            var b_left: AST.Expr = match (expr) { Binary(l, o, r) => l
                _ => AST.Expr.NilLit
            }
            var b_op: String = match (expr) { Binary(l, o, r) => o
                _ => ""
            }
            var b_right: AST.Expr = match (expr) { Binary(l, o, r) => r
                _ => AST.Expr.NilLit
            }
            return this.gen_binary(b_left, b_op, b_right)
        }
        if (expr_kind == "variable") {
            var vname: String = match (expr) { Variable(n) => n
                _ => ""
            }
            if (this.typed_vars.has(vname)) {
                this.last_type = this.typed_vars.get(vname)
            } else if (this.global_var_types.has(vname)) {
                this.last_type = this.str_to_type(this.global_var_types.get(vname))
            } else if (this.current_prefix.length() > 0 and this.global_var_types.has(this.current_prefix + vname)) {
                this.last_type = this.str_to_type(this.global_var_types.get(this.current_prefix + vname))
            } else {
                this.last_type = AST.Type.IntType
            }
            // Undefined variable check (warning only — false positives in multi-module context)
            if (!this.typed_vars.has(vname) and !this.module_globals.has(this.current_prefix + vname) and !this.module_globals.has(vname) and !this.str_in_list(this.known_functions,vname) and !this.str_in_list(this.known_functions,this.current_prefix + vname) and vname != "self" and vname != "this" and vname != "super" and vname != "IO" and vname != "OS" and vname != "GC" and vname != "Task" and !this.module_prefixes.has(vname) and !this.enum_defs.has(vname) and !this.class_fields.has(vname)) {
                IO.println("[codegen] Warning: undefined variable '" + vname + "'")
            }
            var local: String = this.fresh_local()
            var var_ref: String = "%" + this.sanitize_name(vname)
            if (this.module_globals.has(this.current_prefix + vname)) {
                var_ref = "@__g_" + this.current_prefix + this.sanitize_name(vname)
            } else if (this.module_globals.has(vname)) {
                var_ref = "@__g_" + this.sanitize_name(vname)
            }
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_load(local, "i64", var_ref))
                // LLVM lib parallel path: propagate stored Value for this variable
                if (!this.identity_mode and this.llvm_values.has(var_ref)) {
                    this.llvm_values.set(local, this.llvm_values.get(var_ref))
                }
            } else {
                this.emit_indent(local + " = load i64, i64* " + var_ref)
                this.verify_load(local, "i64", var_ref)
            }
            return local
        }
        if (expr_kind == "member") {
            var m_obj: Any = match (expr) { MemberAccess(o, f) => o
                _ => ""
            }
            var m_field: String = match (expr) { MemberAccess(o, f) => f
                _ => ""
            }
            // Check if object is This → field access
            var obj_kind: String = this.classify_expr(m_obj)
            if (obj_kind == "this") {
                return this.gen_get_field(m_obj, m_field)
            }
            // Tuple field access: t._0, t._1, etc.
            var mn: String = this.get_variable_name(m_obj)
            if (mn.length() > 0 and m_field.starts_with("_") and m_field.length() >= 2) {
                var tf_vtype2: String = this.get_var_type_str(mn)
                if (tf_vtype2.starts_with("Tuple<")) {
                    var tf_rest2: String = m_field.slice(1, m_field.length())
                    var tf_idx2: Float = tf_rest2.to_number()
                    var tf_obj2: String = this.gen_arg_value(m_obj)
                    var tf_idx_val2: String = this.fresh_local()
                    this.emit_indent(tf_idx_val2 + " = add i64 0, " + tf_idx2.floor().to_string())
                    var tf_result2: String = this.fresh_local()
                    this.emit_indent(tf_result2 + " = call i64 @__list_get(i64 " + tf_obj2 + ", i64 " + tf_idx_val2 + ")")
                    var tf_inner2: String = tf_vtype2.slice(6, tf_vtype2.length() - 1)
                    var tf_args2: List<String> = this.split_type_args(tf_inner2)
                    if (tf_idx2 >= 0 and tf_idx2 < tf_args2.length()) {
                        this.last_type = this.str_to_type(tf_args2[tf_idx2])
                    } else {
                        this.last_type = AST.Type.AnyType
                    }
                    return tf_result2
                }
            }
            // Handle as field access on class instance or enum
            var vt: String = ""
            if (mn.length() > 0) {
                vt = this.get_var_type_str(mn)
            }
            var vt_resolved: String = this.resolve_class_type(vt)
            if (vt_resolved.length() > 0) {
                    var ov: String = this.gen_arg_value(m_obj)
                    var fi: Float = this.get_field_index(vt_resolved, m_field)
                    var op: String = this.val_to_typed_ptr(ov, "%" + vt_resolved + "*")
                    var fp: String = this.fresh_local()
                    this.emit_indent(fp + " = getelementptr %" + vt_resolved + ", %" + vt_resolved + "* " + op + ", i32 0, i32 " + fi.floor().to_string())
                    var result: String = this.fresh_local()
                    this.emit_indent(result + " = load volatile i64, i64* " + fp)
                    this.last_type = this.str_to_type(this.get_field_type(vt_resolved, m_field))
                    return result
            }
            if (mn.length() > 0 and this.enum_variant_tags.has(mn + "." + m_field)) {
                return this.gen_enum_construct(mn, m_field, [])
            }
            // Package namespace: check named_imports for "Alias.field" first
            if (mn.length() > 0 and this.named_imports.has(mn + "." + m_field)) {
                var pe_ref2: String = this.named_imports.get(mn + "." + m_field)
                if (this.str_in_list(this.known_functions, pe_ref2)) {
                    return this.gen_func_ref(pe_ref2)
                }
            }
            // Module-prefixed function reference: e.g. Routes.list_packages used as value
            if (mn.length() > 0 and this.module_prefixes.has(mn)) {
                var mp_resolved: String = this.module_prefixes.get(mn) + m_field
                if (this.str_in_list(this.known_functions, mp_resolved)) {
                    return this.gen_func_ref(mp_resolved)
                }
                // Module-prefixed global variable: e.g. Cache.store
                if (this.module_globals.has(mp_resolved)) {
                    var mg_local: String = this.fresh_local()
                    var mg_ref: String = "@__g_" + this.sanitize_name(mp_resolved)
                    this.emit_indent(mg_local + " = load i64, i64* " + mg_ref)
                    return mg_local
                }
            }
            // Module-qualified zero-arg enum: AST.Expr.This → try Expr.This
            if (mn.length() == 0) {
                var obj_kind2: String = this.classify_expr(m_obj)
                if (obj_kind2 == "member") {
                    var inner_field: String = match (m_obj) { MemberAccess(o, f) => f
                        _ => ""
                    }
                    var key: String = inner_field + "." + m_field
                    if (this.enum_variant_tags.has(key)) {
                        return this.gen_enum_construct(inner_field, m_field, [])
                    }
                    // Fallback: maybe the inner MemberAccess root is a module alias
                    // e.g. AST.Type.IntType where AST is module, Type is enum, IntType is variant
                    var inner_obj: AST.Expr = match (m_obj) { MemberAccess(o, f) => o
                        _ => AST.Expr.NilLit
                    }
                    var root_name: String = this.get_variable_name(inner_obj)
                    if (root_name.length() > 0 and !this.typed_vars.has(root_name)) {
                        if (this.enum_variant_tags.has(inner_field + "." + m_field)) {
                            return this.gen_enum_construct(inner_field, m_field, [])
                        }
                    }
                }
                // Nested field access: obj.field1.field2
                if (obj_kind2 == "get_field" or obj_kind2 == "member" or obj_kind2 == "this") {
                    var inner_val: String = this.gen_arg_value(m_obj)
                    var inner_type: String = this.type_to_string(this.last_type)
                    if (this.class_fields.has(inner_type)) {
                        // Resolve struct name via class_struct_names for module-prefixed types
                        var inner_struct: String = inner_type
                        if (this.class_struct_names.has(inner_type)) {
                            inner_struct = this.class_struct_names.get(inner_type)
                        }
                        var fi: Float = this.get_field_index(inner_type, m_field)
                        var op: String = this.val_to_typed_ptr(inner_val, "%" + inner_struct + "*")
                        var fp: String = this.fresh_local()
                        this.emit_indent(fp + " = getelementptr %" + inner_struct + ", %" + inner_struct + "* " + op + ", i32 0, i32 " + fi.floor().to_string())
                        var result: String = this.fresh_local()
                        this.emit_indent(result + " = load i64, i64* " + fp)
                        this.last_type = this.str_to_type(this.get_field_type(inner_type, m_field))
                        return result
                    }
                }
            }
            // General fallback: evaluate the object expression (e.g. IndexGet) and use last_type
            var fb_val: String = this.gen_arg_value(m_obj)
            var fb_type_str: String = this.type_to_string(this.last_type)
            var fb_resolved: String = this.resolve_class_type(fb_type_str)
            if (fb_resolved.length() > 0 and this.class_fields.has(fb_resolved)) {
                var fb_struct: String = fb_resolved
                if (this.class_struct_names.has(fb_resolved)) {
                    fb_struct = this.class_struct_names.get(fb_resolved)
                }
                var fi: Float = this.get_field_index(fb_resolved, m_field)
                var op: String = this.val_to_typed_ptr(fb_val, "%" + fb_struct + "*")
                var fp: String = this.fresh_local()
                this.emit_indent(fp + " = getelementptr %" + fb_struct + ", %" + fb_struct + "* " + op + ", i32 0, i32 " + fi.floor().to_string())
                var result: String = this.fresh_local()
                this.emit_indent(result + " = load i64, i64* " + fp)
                this.last_type = this.str_to_type(this.get_field_type(fb_resolved, m_field))
                return result
            }
            return "0"
        }

        // Handle string literals directly
        if (this.is_string_expr(expr)) {
            this.last_type = AST.Type.StringType
            var str_val: String = this.flatten_string_expr(expr)
            var const_name: String = this.add_string_constant(str_val)
            var gep: String = this.fresh_local()
            var slen: Float = str_val.length() + 1
            this.emit_indent(gep + " = getelementptr [" + slen.to_string() + " x i8], [" + slen.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
            var local: String = this.emit_tag_ptr(gep)
            return local
        }
        return this.gen_expr(expr)
    }

    fun gen_string_ptr(expr: AST.Expr): String {
        if (this.is_string_expr(expr)) {
            // String literal: get pointer directly
            var str_val: String = this.flatten_string_expr(expr)
            var const_name: String = this.add_string_constant(str_val)
            var ptr: String = this.fresh_local()
            var slen: Float = str_val.length() + 1
            this.emit_indent(ptr + " = getelementptr [" + slen.to_string() + " x i8], [" + slen.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
            return ptr
        }
        // Variable or expression: gen_expr gives i64 (possibly tagged), convert to i8*
        var val: String = this.gen_arg_value(expr)
        var ptr: String = this.emit_untag_ptr(val)
        return ptr
    }

    fun gen_runtime_string_concat(left: AST.Expr, right: AST.Expr): String {
        var lptr: String = this.gen_string_ptr(left)
        var rptr: String = this.gen_string_ptr(right)
        // Get lengths
        var llen: String = this.fresh_local()
        this.emit_indent(llen + " = call i64 @strlen(i8* " + lptr + ")")
        var rlen: String = this.fresh_local()
        this.emit_indent(rlen + " = call i64 @strlen(i8* " + rptr + ")")
        // Total = llen + rlen + 1
        var total: String = this.fresh_local()
        this.emit_indent(total + " = add i64 " + llen + ", " + rlen)
        var total1: String = this.fresh_local()
        this.emit_indent(total1 + " = add i64 " + total + ", 1")
        // Malloc
        var buf: String = this.fresh_local()
        this.emit_indent(buf + " = call i8* @malloc(" + this.malloc_size_type() + " " + this.malloc_size_arg(total1) + ")")
        // strcpy + strcat
        this.emit_indent("call i8* @strcpy(i8* " + buf + ", i8* " + lptr + ")")
        this.emit_indent("call i8* @strcat(i8* " + buf + ", i8* " + rptr + ")")
        // Intern the result for O(1) equality
        var raw_result: String = this.ptr_to_val(buf)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = call i64 @__string_intern(i64 " + raw_result + ")")
        return result
    }

    fun gen_unary(op: String, right: AST.Expr): String {
        var right_type: String = this.get_expr_type(right)
        var rhs: String = this.gen_arg_value(right)

        if (op == "-") {
            if (right_type == "Float") {
                // Float negation: untag as double, fsub from 0.0, retag
                var raw_f: String = this.emit_untag_float(rhs)
                var negated: String = this.fresh_local()
                this.emit_indent(negated + " = fsub double 0.0, " + raw_f)
                var local: String = this.emit_tag_float(negated)
                this.last_type = AST.Type.FloatType
                return local
            }
            // NaN-boxed integer negation: untag → negate → retag
            var raw: String = this.emit_untag_int(rhs)
            var negated: String = this.fresh_local()
            this.emit_indent(negated + " = sub i64 0, " + raw)
            var local: String = this.emit_tag_int(negated)
            this.last_type = AST.Type.IntType
            return local
        }
        if (op == "!") {
            // Logical not: untag bool, flip, retag as bool
            var raw: String = this.emit_untag_bool(rhs)
            var flipped: String = this.fresh_local()
            this.emit_indent(flipped + " = xor i64 " + raw + ", 1")
            var local: String = this.emit_tag_bool(flipped)
            this.last_type = AST.Type.BoolType
            return local
        }
        if (op == "~") {
            // Bitwise not: untag int, flip all bits, retag
            var raw: String = this.emit_untag_int(rhs)
            var flipped: String = this.fresh_local()
            this.emit_indent(flipped + " = xor i64 " + raw + ", -1")
            var local: String = this.emit_tag_int(flipped)
            this.last_type = AST.Type.IntType
            return local
        }

        return rhs
    }

    fun gen_call(callee: AST.Expr, args: List<AST.Expr>): String {
        var callee_name: String = this.resolve_callee(callee)

        // Check if this is an enum constructor
        if (callee_name.contains(".")) {
            var parts: List<String> = callee_name.split(".")
            if (parts.length() >= 2) {
                var key: String = parts[0] + "." + parts[1]
                if (this.enum_variant_tags.has(key)) {
                    return this.gen_enum_construct(parts[0], parts[1], args)
                }
            }
            // Module-qualified enum: AST.Stmt.FunDecl → try Stmt.FunDecl
            if (parts.length() >= 3) {
                var key2: String = parts[1] + "." + parts[2]
                if (this.enum_variant_tags.has(key2)) {
                    return this.gen_enum_construct(parts[1], parts[2], args)
                }
            }
        }

        // Task.spawn(fn) — call the coroutine function to get a handle, enqueue it
        if (callee_name == "Task.spawn") {
            var spawn_arg: String = this.gen_arg_value(args[0])
            var hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_inttoptr(hdl, spawn_arg))
            } else {
                this.emit_indent(hdl + " = inttoptr i64 " + spawn_arg + " to ptr")
                this.verify_inttoptr(hdl, spawn_arg)
            }
            var task_hdl: String = this.fresh_local()
            this.emit_indent(task_hdl + " = call ptr " + hdl + "()")
            var task_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(task_i64, task_hdl))
            } else {
                this.emit_indent(task_i64 + " = ptrtoint ptr " + task_hdl + " to i64")
                this.verify_ptrtoint(task_i64, task_hdl)
            }
            this.emit_indent("call i64 @enqueue(i64 " + task_i64 + ")")
            this.called_functions.push("enqueue")
            this.last_type = AST.Type.IntType
            return task_i64
        }

        // Check if it's a method call on a class instance: obj.method(args)
        if (callee_name.contains(".") and !callee_name.starts_with("IO")) {
            var parts: List<String> = callee_name.split(".")
            if (parts.length() >= 2) {
                var obj_name: String = parts[0]
                var method_name: String = parts[1]
                // Check if any class has this method
                var class_name: String = this.find_class_for_method(method_name)
                if (class_name.length() > 0) {
                    var obj_val: String = this.fresh_local()
                    this.emit_indent(obj_val + " = load i64, i64* %" + this.sanitize_name(obj_name))
                    var arg_strs: List<String> = []
                    arg_strs.push("i64 " + obj_val)
                    var ai: Float = 0
                    while (ai < args.length()) {
                        var val: String = this.gen_arg_value(args[ai])
                        arg_strs.push("i64 " + val)
                        ai = ai + 1
                    }
                    var full_method: String = class_name + "__" + method_name
                    if (this.func_prefix_map.has(full_method)) {
                        full_method = this.func_prefix_map.get(full_method)
                    } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions,this.current_prefix + full_method)) {
                        full_method = this.current_prefix + full_method
                    }
                    this.called_functions.push(full_method)
                    var local: String = this.fresh_local()
                    this.emit_indent(local + " = call i64 @" + full_method + "(" + arg_strs.join(", ") + ")")
                    if (this.func_ret_types.has(full_method)) {
                        this.last_type = this.func_ret_types.get(full_method)
                    } else {
                        this.last_type = AST.Type.IntType
                    }
                    return local
                }
            }
        }

        if (callee_name == "IO.println") {
            var arg: String = this.gen_arg_value(args[0])
            var arg_type: String = this.type_to_string(this.last_type)
            if (this.identity_mode and arg_type == "String") {
                // Identity mode: strings are raw pointers, use __io_println_str directly
                this.emit_indent("call void @__io_println_str(i64 " + arg + ")")
            } else {
                // Runtime dispatch: pass tagged value directly to __io_println_any
                this.emit_indent("call void @__io_println_any(i64 " + arg + ")")
            }
            this.last_type = AST.Type.NilType
            var nil_val: String = this.fresh_local()
            this.emit_indent(nil_val + " = call i64 @__val_nil()")
            return nil_val
        }
        if (callee_name == "IO.print") {
            var arg: String = this.gen_arg_value(args[0])
            var arg_type: String = this.type_to_string(this.last_type)
            if (this.identity_mode and arg_type == "String") {
                // Identity mode: strings are raw pointers, use __io_print_str directly
                this.emit_indent("call void @__io_print_str(i64 " + arg + ")")
            } else {
                // Runtime dispatch: __io_print_any handles all NaN-boxed types
                this.emit_indent("call void @__io_print_any(i64 " + arg + ")")
            }
            this.last_type = AST.Type.NilType
            var nil_val: String = this.fresh_local()
            this.emit_indent(nil_val + " = call i64 @__val_nil()")
            return nil_val
        }

        // Task.spawn(fn) — call the coroutine function to get a handle, enqueue it
        if (callee_name == "Task.spawn") {
            // The argument is a lambda or function reference that is a coroutine
            var spawn_arg: String = this.gen_arg_value(args[0])
            // The lambda was compiled as a coroutine returning ptr.
            // Call it to get the handle, then enqueue to scheduler.
            // For now: the lambda is an indirect call via function pointer.
            // The spawned function returns a ptr handle immediately (at first suspend).
            var hdl: String = this.fresh_local()
            this.emit_indent(hdl + " = inttoptr i64 " + spawn_arg + " to ptr")
            var task_hdl: String = this.fresh_local()
            this.emit_indent(task_hdl + " = call ptr " + hdl + "()")
            // Enqueue to scheduler (convert ptr to i64 for scheduler's List<Int>)
            var task_i64: String = this.fresh_local()
            this.emit_indent(task_i64 + " = ptrtoint ptr " + task_hdl + " to i64")
            this.emit_indent("call i64 @enqueue(i64 " + task_i64 + ")")
            this.called_functions.push("enqueue")
            this.last_type = AST.Type.IntType
            return task_i64
        }

        // Check if it's a known direct function or an indirect call through a variable
        // Check for same-name enum variant: Token(kind, line, col) where enum Token { Token(...) }
        if (this.enum_defs.has(callee_name)) {
            var variants: List = this.enum_defs.get(callee_name)
            if (variants.contains(callee_name)) {
                return this.gen_enum_construct(callee_name, callee_name, args)
            }
        }

        var resolved_callee: String = callee_name
        // Named imports take highest priority: explicit user directive
        if (this.named_imports.has(callee_name)) {
            var ni_target: String = this.named_imports.get(callee_name)
            if (this.str_in_list(this.known_functions,ni_target)) {
                resolved_callee = ni_target
            } else {
                // Trust the named import even if target not yet in known_functions
                resolved_callee = ni_target
            }
        } else if (this.current_prefix.length() > 0) {
            if (this.str_in_list(this.known_functions,this.current_prefix + callee_name)) {
                resolved_callee = this.current_prefix + callee_name
            }
        }
        // Resolve module-qualified names (e.g. "Async.gather" → "stdlib_async_gather")
        // before intrinsic/extern/coroutine checks
        if (resolved_callee.contains(".")) {
            // Package namespace: check named_imports for dotted key first
            if (this.named_imports.has(resolved_callee)) {
                resolved_callee = this.named_imports.get(resolved_callee)
            } else {
                var dot_parts: List<String> = resolved_callee.split(".")
                if (dot_parts.length() >= 2 and this.module_prefixes.has(dot_parts[0])) {
                    resolved_callee = this.module_prefixes.get(dot_parts[0]) + dot_parts[1]
                } else if (this.func_prefix_map.has(resolved_callee)) {
                    resolved_callee = this.func_prefix_map.get(resolved_callee)
                }
            }
        }
        if (this.str_in_list(this.intrinsic_funcs,resolved_callee)) {
            return this.gen_intrinsic_call(resolved_callee, args)
        }
        if (this.extern_sigs.has(resolved_callee)) {
            return this.gen_extern_call(resolved_callee, args)
        }

        // Coroutine-calls-coroutine: emit await forwarding pattern
        if (this.is_coroutine) {
            var is_coro_callee: Bool = this.str_in_list(this.coroutine_funcs,resolved_callee)
            if (!is_coro_callee and this.str_in_list(this.coroutine_funcs,this.current_prefix + resolved_callee)) {
                is_coro_callee = true
                resolved_callee = this.current_prefix + resolved_callee
            }
            if (is_coro_callee) {
                this.called_functions.push(resolved_callee)
                // Generate arguments
                var coro_arg_strs: List<String> = []
                var cai: Float = 0
                while (cai < args.length()) {
                    var val: String = this.gen_arg_value(args[cai])
                    coro_arg_strs.push("i64 " + val)
                    cai = cai + 1
                }
                // Call the coroutine — returns a handle (ptr)
                var b_hdl: String = this.fresh_local()
                this.emit_indent(b_hdl + " = call ptr @" + resolved_callee + "(" + coro_arg_strs.join(", ") + ")")

                // Await loop: resume child until done, yielding ourselves each iteration
                var await_loop: String = this.fresh_label("await.loop")
                var await_yield: String = this.fresh_label("await.yield")
                var await_cleanup: String = this.fresh_label("await.cleanup")
                var await_done: String = this.fresh_label("await.done")

                // Await pattern using opaque calls (defeats CoroElide):
                // check done → yield → resume child → loop
                // Use __sched_coro_* functions (opaque to LLVM) instead of intrinsics
                var b_hdl_i64: String = this.fresh_local()
                this.emit_indent(b_hdl_i64 + " = ptrtoint ptr " + b_hdl + " to i64")
                var await_check: String = this.fresh_label("await.check")
                this.emit_terminator("br label %" + await_check)

                this.start_block(await_check)
                var b_done: String = this.fresh_local()
                this.emit_indent(b_done + " = call i64 @__sched_coro_done(i64 " + b_hdl_i64 + ")")
                var b_done_cmp: String = this.fresh_local()
                this.emit_indent(b_done_cmp + " = icmp eq i64 " + b_done + ", 1")
                this.emit_terminator("br i1 " + b_done_cmp + ", label %" + await_done + ", label %" + await_yield)

                this.start_block(await_yield)
                var save_tok: String = this.fresh_local()
                this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
                var susp_result: String = this.fresh_local()
                this.emit_indent(susp_result + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")
                this.emit_terminator("switch i8 " + susp_result + ", label %__coro_suspend [i8 0, label %" + await_loop + " i8 1, label %" + await_cleanup + "]")

                this.start_block(await_cleanup)
                this.emit_terminator("br label %__coro_cleanup")

                this.start_block(await_loop)
                this.emit_indent("call void @__sched_coro_resume(i64 " + b_hdl_i64 + ")")
                this.emit_terminator("br label %" + await_check)

                this.start_block(await_done)
                // Read the child coroutine's return value from @__task_result
                var coro_result: String = this.fresh_local()
                this.emit_indent(coro_result + " = load i64, i64* @__task_result")
                // Use the callee's return type
                if (this.func_ret_types.has(resolved_callee)) {
                    this.last_type = this.func_ret_types.get(resolved_callee)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return coro_result
            }
        }

        // Sync-calls-coro: non-coroutine calling a coroutine directly — drive to completion
        if (!this.is_coroutine) {
            var is_sync_coro_callee: Bool = this.str_in_list(this.coroutine_funcs,resolved_callee)
            if (!is_sync_coro_callee and this.str_in_list(this.coroutine_funcs,this.current_prefix + resolved_callee)) {
                is_sync_coro_callee = true
                resolved_callee = this.current_prefix + resolved_callee
            }
            if (is_sync_coro_callee) {
                this.called_functions.push(resolved_callee)
                var sync_arg_strs: List<String> = []
                var sai: Float = 0
                while (sai < args.length()) {
                    var val: String = this.gen_arg_value(args[sai])
                    sync_arg_strs.push("i64 " + val)
                    sai = sai + 1
                }
                var s_hdl: String = this.fresh_local()
                this.emit_indent(s_hdl + " = call ptr @" + resolved_callee + "(" + sync_arg_strs.join(", ") + ")")
                var s_i64: String = this.fresh_local()
                this.emit_indent(s_i64 + " = ptrtoint ptr " + s_hdl + " to i64")
                var sc: String = this.fresh_label("sync.check")
                var sl: String = this.fresh_label("sync.loop")
                var sd: String = this.fresh_label("sync.done")
                this.emit_terminator("br label %" + sc)
                this.start_block(sc)
                var s_done: String = this.fresh_local()
                this.emit_indent(s_done + " = call i64 @__sched_coro_done(i64 " + s_i64 + ")")
                var s_cmp: String = this.fresh_local()
                this.emit_indent(s_cmp + " = icmp eq i64 " + s_done + ", 1")
                this.emit_terminator("br i1 " + s_cmp + ", label %" + sd + ", label %" + sl)
                this.start_block(sl)
                this.emit_indent("call void @__sched_coro_resume(i64 " + s_i64 + ")")
                this.emit_terminator("br label %" + sc)
                this.start_block(sd)
                var s_result: String = this.fresh_local()
                this.emit_indent(s_result + " = load i64, i64* @__task_result")
                if (this.func_ret_types.has(resolved_callee)) {
                    this.last_type = this.func_ret_types.get(resolved_callee)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return s_result
            }
        }

        // Error check: argument count validation (skip if named args present)
        var has_named_check: Bool = false
        var nac: Float = 0
        while (nac < args.length()) {
            if (this.classify_expr(args[nac]) == "assign") { has_named_check = true }
            nac = nac + 1
        }
        if (!has_named_check) {
            var has_real_defs: Bool = false
            if (this.func_defaults.has(resolved_callee)) {
                var __defs: List<AST.Expr> = this.func_defaults.get(resolved_callee)
                var __di: Float = 0
                while (__di < __defs.length()) {
                    if (this.classify_expr(__defs[__di]) != "nil") { has_real_defs = true }
                    __di = __di + 1
                }
            }
            // Only error on arity for functions defined in same compilation unit
            // (not imported via named imports), to avoid false positives from pipe |>
            var is_named_import: Bool = this.named_imports.has(callee_name)
            if (!is_named_import) {
                if (this.called_function_arity.has(resolved_callee)) {
                    var expected: Float = this.called_function_arity.get(resolved_callee)
                    if (args.length() != expected and expected > 0 and !has_real_defs) {
                        IO.println("[codegen] Error: '" + callee_name + "' expects " + expected.floor().to_string() + " arguments, got " + args.length().floor().to_string())
                        this.has_errors = true
                    }
                } else if (this.func_param_count.has(resolved_callee)) {
                    var expected: Float = this.func_param_count.get(resolved_callee)
                    if (args.length() != expected and expected > 0 and !has_real_defs) {
                        IO.println("[codegen] Error: '" + callee_name + "' expects " + expected.floor().to_string() + " arguments, got " + args.length().floor().to_string())
                        this.has_errors = true
                    }
                }
            }
        }

        if (this.str_in_list(this.known_functions,resolved_callee) and !this.typed_vars.has(callee_name)) {
            // Direct call to known function (only when callee is NOT a local variable/param)
            var call_target: String = resolved_callee
            if (callee_name == "main" and this.str_in_list(this.defined_funcs,"__saffron_main")) {
                call_target = "__saffron_main"
            }
            this.called_functions.push(resolved_callee)

            // Check if this is a class constructor call with args
            // Pattern: ClassName(args) → call @ClassName() + call @ClassName__init(instance, args)
            var is_constructor: Bool = false
            // Extract the simple class name from module-qualified callee (e.g. "Func.BasicBlock" → "BasicBlock")
            var simple_callee: String = callee_name
            if (callee_name.contains(".")) {
                var sc_parts: List<String> = callee_name.split(".")
                simple_callee = sc_parts[sc_parts.length() - 1]
            }
            if (this.func_ret_types.has(resolved_callee)) {
                var ret_type_node: AST.Type = this.func_ret_types.get(resolved_callee)
                var ret_type_val: String = this.type_to_string(ret_type_node)
                if (ret_type_val == callee_name or ret_type_val == simple_callee) {
                    is_constructor = true
                }
                if (!is_constructor and ret_type_val == resolved_callee) {
                    if (this.class_fields.has(callee_name) or this.class_fields.has(simple_callee)) {
                        is_constructor = true
                    }
                }
            }

            if (is_constructor) {
                // Constructor: allocate instance, then call init
                var instance: String = this.fresh_local()
                this.emit_indent(instance + " = call i64 @" + resolved_callee + "()")
                // Call init for user-defined classes (not runtime builtins)
                var init_name: String = resolved_callee + "__init"
                if (!this.str_in_list(this.known_functions,init_name)) {
                    init_name = callee_name + "__init"
                }
                // Resolve via func_prefix_map (class methods are emitted with module prefix)
                if (this.func_prefix_map.has(init_name)) {
                    init_name = this.func_prefix_map.get(init_name)
                } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions,this.current_prefix + init_name)) {
                    init_name = this.current_prefix + init_name
                }
                if (this.str_in_list(this.known_functions,init_name)) {
                    var init_args: List<String> = []
                    init_args.push("i64 " + instance)
                    var i: Float = 0
                    while (i < args.length()) {
                        var val: String = this.gen_arg_value(args[i])
                        init_args.push("i64 " + val)
                        i = i + 1
                    }
                    this.called_functions.push(init_name)
                    var discard_init: String = this.fresh_local()
                    this.emit_indent(discard_init + " = call i64 @" + init_name + "(" + init_args.join(", ") + ")")
                }
                this.last_type = this.str_to_type(simple_callee)
                return instance
            }

            var arg_strs: List<String> = []
            // If this is a nested function with captures, prepend capture POINTERS as args
            if (this.called_function_arity.has("__captures_" + resolved_callee)) {
                var caps_str: String = this.func_prefix_map.get("__caps_" + resolved_callee)
                if (caps_str.length() > 0) {
                    var cap_names: List<String> = caps_str.split(",")
                    var ci3: Float = 0
                    while (ci3 < cap_names.length()) {
                        var cap_val: String = this.typed_ptr_to_val("%" + this.sanitize_name(cap_names[ci3]), "i64*")
                        arg_strs.push("i64 " + cap_val)
                        ci3 = ci3 + 1
                    }
                }
            }
            // Named argument reordering: if any arg is an Assign node (named arg),
            // reorder args to match parameter order instead of source order
            var reordered_args: List<AST.Expr> = args
            var has_named_args: Bool = false
            var trailing_closure_applied: Bool = false
            // Trailing closure: if last arg is a lambda and fewer args than params,
            // place it at the last param position (Kotlin-style trailing closure)
            if (this.func_param_names.has(resolved_callee) and args.length() > 0) {
                var tc_pnames: List<String> = this.func_param_names.get(resolved_callee)
                var tc_last: AST.Expr = args[args.length() - 1]
                if (this.classify_expr(tc_last) == "lambda" and args.length() < tc_pnames.length()) {
                    // Separate non-trailing args from the trailing closure
                    var tc_args: List<AST.Expr> = []
                    var tc_i: Float = 0
                    while (tc_i < args.length() - 1) {
                        tc_args.push(args[tc_i])
                        tc_i = tc_i + 1
                    }
                    // Check if non-trailing args have named args
                    var tc_has_named: Bool = false
                    var tc_ni: Float = 0
                    while (tc_ni < tc_args.length()) {
                        if (this.classify_expr(tc_args[tc_ni]) == "assign") {
                            tc_has_named = true
                        }
                        tc_ni = tc_ni + 1
                    }
                    // Build reordered args: handle named args among non-trailing args
                    var tc_new: List<AST.Expr> = []
                    if (tc_has_named) {
                        // Named arg reordering for params before the last one
                        var positional_idx: Float = 0
                        var pi: Float = 0
                        while (pi < tc_pnames.length() - 1) {
                            var pname: String = tc_pnames[pi]
                            var found: Bool = false
                            var si: Float = 0
                            while (si < tc_args.length()) {
                                if (this.classify_expr(tc_args[si]) == "assign") {
                                    var arg_name: String = match (tc_args[si]) { Assign(n, v) => n
                                        _ => ""
                                    }
                                    if (arg_name == pname) {
                                        var arg_value: AST.Expr = match (tc_args[si]) { Assign(n, v) => v
                                            _ => AST.Expr.NilLit
                                        }
                                        tc_new.push(arg_value)
                                        found = true
                                    }
                                }
                                si = si + 1
                            }
                            if (!found) {
                                var used_pos: Bool = false
                                while (positional_idx < tc_args.length() and !used_pos) {
                                    if (this.classify_expr(tc_args[positional_idx]) != "assign") {
                                        tc_new.push(tc_args[positional_idx])
                                        positional_idx = positional_idx + 1
                                        used_pos = true
                                    } else {
                                        positional_idx = positional_idx + 1
                                    }
                                }
                                if (!used_pos) {
                                    tc_new.push(AST.Expr.NilLit)
                                }
                            }
                            pi = pi + 1
                        }
                    } else {
                        // No named args, just copy positional args and fill gaps
                        tc_i = 0
                        while (tc_i < tc_args.length()) {
                            tc_new.push(tc_args[tc_i])
                            tc_i = tc_i + 1
                        }
                        while (tc_new.length() < tc_pnames.length() - 1) {
                            tc_new.push(AST.Expr.NilLit)
                        }
                    }
                    // Place trailing closure at the end
                    tc_new.push(tc_last)
                    reordered_args = tc_new
                    has_named_args = true
                    trailing_closure_applied = true
                }
            }
            var nai: Float = 0
            while (nai < args.length()) {
                if (this.classify_expr(args[nai]) == "assign") {
                    has_named_args = true
                }
                nai = nai + 1
            }
            if (has_named_args and this.func_param_names.has(resolved_callee) and !trailing_closure_applied) {
                var param_names: List<String> = this.func_param_names.get(resolved_callee)
                var new_args: List<AST.Expr> = []
                var positional_idx: Float = 0
                var pi: Float = 0
                while (pi < param_names.length()) {
                    var pname: String = param_names[pi]
                    // Search for a named arg matching this param
                    var found: Bool = false
                    var si: Float = 0
                    while (si < args.length()) {
                        if (this.classify_expr(args[si]) == "assign") {
                            var arg_name: String = match (args[si]) { Assign(n, v) => n
                                _ => ""
                            }
                            if (arg_name == pname) {
                                var arg_value: AST.Expr = match (args[si]) { Assign(n, v) => v
                                    _ => AST.Expr.NilLit
                                }
                                new_args.push(arg_value)
                                found = true
                            }
                        }
                        si = si + 1
                    }
                    if (!found) {
                        // Use positional arg (skip over named args in positional counting)
                        var used_positional: Bool = false
                        while (positional_idx < args.length() and !used_positional) {
                            if (this.classify_expr(args[positional_idx]) != "assign") {
                                new_args.push(args[positional_idx])
                                positional_idx = positional_idx + 1
                                used_positional = true
                            } else {
                                positional_idx = positional_idx + 1
                            }
                        }
                        if (!used_positional) {
                            // No positional arg available — use default (will be filled below)
                            // Push a nil placeholder to signal "use default"
                            new_args.push(AST.Expr.NilLit)
                        }
                    }
                    pi = pi + 1
                }
                reordered_args = new_args
            }
            var i: Float = 0
            while (i < reordered_args.length()) {
                // Skip nil placeholders that signal "use default"
                var used_default: Bool = false
                if (has_named_args and this.classify_expr(reordered_args[i]) == "nil" and this.func_defaults.has(resolved_callee)) {
                    var defs: List<AST.Expr> = this.func_defaults.get(resolved_callee)
                    if (i < defs.length() and this.classify_expr(defs[i]) != "nil") {
                        var def_val: String = this.gen_arg_value(defs[i])
                        arg_strs.push("i64 " + def_val)
                        used_default = true
                    }
                }
                if (!used_default) {
                    var val: String = this.gen_arg_value(reordered_args[i])
                    arg_strs.push("i64 " + val)
                }
                i = i + 1
            }
            // Fill missing args with default values
            if (this.func_defaults.has(resolved_callee)) {
                var defaults: List<AST.Expr> = this.func_defaults.get(resolved_callee)
                var param_count: Float = defaults.length()
                if (this.func_param_names.has(resolved_callee)) {
                    var pc2: Float = this.func_param_names.get(resolved_callee).length()
                    if (pc2 > param_count) { param_count = pc2 }
                }
                while (i < param_count) {
                    if (i < defaults.length()) {
                        var def_expr: AST.Expr = defaults[i]
                        var is_nil: Bool = this.classify_expr(def_expr) == "nil"
                        if (!is_nil) {
                            var def_val: String = this.gen_arg_value(def_expr)
                            arg_strs.push("i64 " + def_val)
                        } else {
                            var __nil_fill: String = this.fresh_local()
                            this.emit_indent(__nil_fill + " = call i64 @__val_nil()")
                            arg_strs.push("i64 " + __nil_fill)
                        }
                    } else {
                        var __nil_fill: String = this.fresh_local()
                        this.emit_indent(__nil_fill + " = call i64 @__val_nil()")
                        arg_strs.push("i64 " + __nil_fill)
                    }
                    i = i + 1
                }
            } else if (this.func_param_names.has(resolved_callee)) {
                var param_count: Float = this.func_param_names.get(resolved_callee).length()
                while (arg_strs.length() < param_count) {
                    var __nil_fill: String = this.fresh_local()
                    this.emit_indent(__nil_fill + " = call i64 @__val_nil()")
                    arg_strs.push("i64 " + __nil_fill)
                }
            }
            var local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(local, "i64", call_target, arg_strs.join(", ")))
            } else {
                this.emit_indent(local + " = call i64 @" + call_target + "(" + arg_strs.join(", ") + ")")
                this.verify_call(local, "i64", call_target, arg_strs.join(", "))
            }
            if (this.func_ret_types.has(resolved_callee)) {
                this.last_type = this.func_ret_types.get(resolved_callee)
            } else if (this.func_ret_types.has(callee_name)) {
                this.last_type = this.func_ret_types.get(callee_name)
            } else {
                this.last_type = AST.Type.IntType
            }
            return local
        }

        // Check if it looks like a direct function call (not a local variable)
        if (!this.typed_vars.has(callee_name) and callee_name.length() > 0) {
            // Runtime builtin constructors
            if (callee_name == "Map") {
                var local: String = this.fresh_local()
                this.emit_indent(local + " = call i64 @__map_new()")
                this.last_type = this.make_map_type()
                return local
            }
            var emit_callee: String = this.current_prefix + callee_name
            // Named imports take priority over all other resolution
            if (this.named_imports.has(callee_name)) {
                emit_callee = this.named_imports.get(callee_name)
            } else if (!this.str_in_list(this.known_functions,emit_callee)) {
                if (this.str_in_list(this.known_functions,callee_name)) {
                    emit_callee = callee_name
                } else if (this.func_prefix_map.has(callee_name)) {
                    emit_callee = this.func_prefix_map.get(callee_name)
                } else {
                    // Warning: calling undefined function
                    // Suppress if it's a known class method (ClassName__method pattern)
                    var is_known_method: Bool = false
                    var kfi: Float = 0
                    while (kfi < this.known_functions.length()) {
                        if (this.known_functions[kfi].ends_with("__" + callee_name)) {
                            is_known_method = true
                            kfi = this.known_functions.length()
                        }
                        kfi = kfi + 1
                    }
                    if (!is_known_method) {
                        IO.println("[codegen] Warning: calling undefined function '" + callee_name + "'")
                    }

                }
            }
            this.called_functions.push(emit_callee)
            // Named argument reordering for fallback path
            var reordered_args2: List<AST.Expr> = args
            var has_named2: Bool = false
            var tc_applied2: Bool = false
            // Trailing closure for fallback path
            if (this.func_param_names.has(emit_callee) and args.length() > 0) {
                var tc_pnames2: List<String> = this.func_param_names.get(emit_callee)
                var tc_last2: AST.Expr = args[args.length() - 1]
                if (this.classify_expr(tc_last2) == "lambda" and args.length() < tc_pnames2.length()) {
                    var tc_args2: List<AST.Expr> = []
                    var tc_i2: Float = 0
                    while (tc_i2 < args.length() - 1) {
                        tc_args2.push(args[tc_i2])
                        tc_i2 = tc_i2 + 1
                    }
                    var tc_has_named2: Bool = false
                    var tc_ni2: Float = 0
                    while (tc_ni2 < tc_args2.length()) {
                        if (this.classify_expr(tc_args2[tc_ni2]) == "assign") {
                            tc_has_named2 = true
                        }
                        tc_ni2 = tc_ni2 + 1
                    }
                    var tc_new2: List<AST.Expr> = []
                    if (tc_has_named2) {
                        var positional_idx2: Float = 0
                        var pi2: Float = 0
                        while (pi2 < tc_pnames2.length() - 1) {
                            var pname2: String = tc_pnames2[pi2]
                            var found2: Bool = false
                            var si2: Float = 0
                            while (si2 < tc_args2.length()) {
                                if (this.classify_expr(tc_args2[si2]) == "assign") {
                                    var arg_name2: String = match (tc_args2[si2]) { Assign(n, v) => n
                                        _ => ""
                                    }
                                    if (arg_name2 == pname2) {
                                        var arg_value2: AST.Expr = match (tc_args2[si2]) { Assign(n, v) => v
                                            _ => AST.Expr.NilLit
                                        }
                                        tc_new2.push(arg_value2)
                                        found2 = true
                                    }
                                }
                                si2 = si2 + 1
                            }
                            if (!found2) {
                                var used_pos2: Bool = false
                                while (positional_idx2 < tc_args2.length() and !used_pos2) {
                                    if (this.classify_expr(tc_args2[positional_idx2]) != "assign") {
                                        tc_new2.push(tc_args2[positional_idx2])
                                        positional_idx2 = positional_idx2 + 1
                                        used_pos2 = true
                                    } else {
                                        positional_idx2 = positional_idx2 + 1
                                    }
                                }
                                if (!used_pos2) {
                                    tc_new2.push(AST.Expr.NilLit)
                                }
                            }
                            pi2 = pi2 + 1
                        }
                    } else {
                        tc_i2 = 0
                        while (tc_i2 < tc_args2.length()) {
                            tc_new2.push(tc_args2[tc_i2])
                            tc_i2 = tc_i2 + 1
                        }
                        while (tc_new2.length() < tc_pnames2.length() - 1) {
                            tc_new2.push(AST.Expr.NilLit)
                        }
                    }
                    tc_new2.push(tc_last2)
                    reordered_args2 = tc_new2
                    has_named2 = true
                    tc_applied2 = true
                }
            }
            var nai2: Float = 0
            while (nai2 < args.length()) {
                if (this.classify_expr(args[nai2]) == "assign") {
                    has_named2 = true
                }
                nai2 = nai2 + 1
            }
            if (has_named2 and this.func_param_names.has(emit_callee) and !tc_applied2) {
                var param_names2: List<String> = this.func_param_names.get(emit_callee)
                var new_args2: List<AST.Expr> = []
                var positional_idx2: Float = 0
                var pi2: Float = 0
                while (pi2 < param_names2.length()) {
                    var pname2: String = param_names2[pi2]
                    var found2: Bool = false
                    var si2: Float = 0
                    while (si2 < args.length()) {
                        if (this.classify_expr(args[si2]) == "assign") {
                            var arg_name2: String = match (args[si2]) { Assign(n, v) => n
                                _ => ""
                            }
                            if (arg_name2 == pname2) {
                                var arg_value2: AST.Expr = match (args[si2]) { Assign(n, v) => v
                                    _ => AST.Expr.NilLit
                                }
                                new_args2.push(arg_value2)
                                found2 = true
                            }
                        }
                        si2 = si2 + 1
                    }
                    if (!found2) {
                        var used_pos2: Bool = false
                        while (positional_idx2 < args.length() and !used_pos2) {
                            if (this.classify_expr(args[positional_idx2]) != "assign") {
                                new_args2.push(args[positional_idx2])
                                positional_idx2 = positional_idx2 + 1
                                used_pos2 = true
                            } else {
                                positional_idx2 = positional_idx2 + 1
                            }
                        }
                        if (!used_pos2) {
                            new_args2.push(AST.Expr.NilLit)
                        }
                    }
                    pi2 = pi2 + 1
                }
                reordered_args2 = new_args2
            }
            var arg_strs: List<String> = []
            var i: Float = 0
            while (i < reordered_args2.length()) {
                var used_default2: Bool = false
                if (has_named2 and this.classify_expr(reordered_args2[i]) == "nil" and this.func_defaults.has(emit_callee)) {
                    var defs2: List<AST.Expr> = this.func_defaults.get(emit_callee)
                    if (i < defs2.length() and this.classify_expr(defs2[i]) != "nil") {
                        var def_val2: String = this.gen_arg_value(defs2[i])
                        arg_strs.push("i64 " + def_val2)
                        used_default2 = true
                    }
                }
                if (!used_default2) {
                    var val: String = this.gen_arg_value(reordered_args2[i])
                    arg_strs.push("i64 " + val)
                }
                i = i + 1
            }
            // Fill missing args with default values
            if (this.func_defaults.has(emit_callee)) {
                var defaults2: List<AST.Expr> = this.func_defaults.get(emit_callee)
                var param_count2: Float = defaults2.length()
                if (this.func_param_names.has(emit_callee)) {
                    var pc2b: Float = this.func_param_names.get(emit_callee).length()
                    if (pc2b > param_count2) { param_count2 = pc2b }
                }
                while (i < param_count2) {
                    if (i < defaults2.length()) {
                        var def_expr2: AST.Expr = defaults2[i]
                        var is_nil2: Bool = this.classify_expr(def_expr2) == "nil"
                        if (!is_nil2) {
                            var def_val2b: String = this.gen_arg_value(def_expr2)
                            arg_strs.push("i64 " + def_val2b)
                        } else {
                            var __nil_fill2: String = this.fresh_local()
                            this.emit_indent(__nil_fill2 + " = call i64 @__val_nil()")
                            arg_strs.push("i64 " + __nil_fill2)
                        }
                    } else {
                        var __nil_fill2: String = this.fresh_local()
                        this.emit_indent(__nil_fill2 + " = call i64 @__val_nil()")
                        arg_strs.push("i64 " + __nil_fill2)
                    }
                    i = i + 1
                }
            } else if (this.func_param_names.has(emit_callee)) {
                var param_count2: Float = this.func_param_names.get(emit_callee).length()
                while (arg_strs.length() < param_count2) {
                    var __nil_fill2: String = this.fresh_local()
                    this.emit_indent(__nil_fill2 + " = call i64 @__val_nil()")
                    arg_strs.push("i64 " + __nil_fill2)
                }
            }
            var local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(local, "i64", emit_callee, arg_strs.join(", ")))
            } else {
                this.emit_indent(local + " = call i64 @" + emit_callee + "(" + arg_strs.join(", ") + ")")
                this.verify_call(local, "i64", emit_callee, arg_strs.join(", "))
            }
            if (this.func_ret_types.has(emit_callee)) {
                this.last_type = this.func_ret_types.get(emit_callee)
            } else {
                this.last_type = AST.Type.IntType
            }
            return local
        }

        // Indirect call: callee is a variable or expression holding a function pointer
        var ptr_val: String = ""
        if (callee_name.length() == 0) {
            ptr_val = this.gen_arg_value(callee)
        } else {
            ptr_val = this.fresh_local()
            var var_ref: String = "%" + this.sanitize_name(callee_name)
            if (this.module_globals.has(this.current_prefix + callee_name)) {
                var_ref = "@__g_" + this.current_prefix + this.sanitize_name(callee_name)
            }
            this.emit_indent(ptr_val + " = load i64, i64* " + var_ref)
        }
        return this.gen_indirect_call(ptr_val, args)
    }

    fun gen_indirect_call(ptr_val: String, args: List<AST.Expr>): String {
        // ptr_val could be either:
        // 1. A plain function pointer (non-capturing lambda)
        // 2. A closure pair pointer: [fn_ptr, env_ptr]
        // We use the closure calling convention for all indirect calls:
        // Unpack [fn_ptr, env_ptr], call fn(env, args...)
        var closure_ptr: String = this.val_to_typed_ptr(ptr_val, "[2 x i64]*")

        // Load fn_ptr from slot 0
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        var fn_int: String = this.fresh_local()
        this.emit_indent(fn_int + " = load i64, i64* " + fn_slot)

        // Load env_ptr from slot 1
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        var env_int: String = this.fresh_local()
        this.emit_indent(env_int + " = load i64, i64* " + env_slot)

        // Build args: env first, then user args
        var arg_strs: List<String> = []
        arg_strs.push("i64 " + env_int)
        var i: Float = 0
        while (i < args.length()) {
            var val: String = this.gen_arg_value(args[i])
            arg_strs.push("i64 " + val)
            i = i + 1
        }

        // Build function type: i64 (i64 env, i64 arg1, ...)
        var num_args: Float = args.length() + 1
        var type_parts: List<String> = []
        var ti: Float = 0
        while (ti < num_args) {
            type_parts.push("i64")
            ti = ti + 1
        }
        var fn_type: String = "i64 (" + type_parts.join(", ") + ")*"

        // Cast and call
        var fn_ptr: String = this.val_to_fn_ptr(fn_int, fn_type)
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 " + fn_ptr + "(" + arg_strs.join(", ") + ")")
        // LLVM lib parallel path: track indirect call result as opaque placeholder
        if (!this.identity_mode) {
            var ic_res: LLVMTypes.Value = this.llvm_block_builder.call("__indirect_call", LLVMTypes.Type.I64, [])
            this.llvm_values.set(local, ic_res)
        }
        return local
    }

    fun has_string_literal(left: AST.Expr, right: AST.Expr): Bool {
        return this.is_string_expr(left) or this.is_string_expr(right) or this.contains_string_lit(left) or this.contains_string_lit(right) or this.is_string_variable(left) or this.is_string_variable(right)
    }

    fun contains_string_lit(expr: AST.Expr): Bool {
        var kind: Any = match (expr) {
            StringLit(s) => "yes"
            Binary(l, o, r) => {
                if (this.contains_string_lit(l) or this.contains_string_lit(r)) { "yes" } else { "no" }
            }
            IntLit(v) => "no"
            FloatLit(v) => "no"
            BoolLit(v) => "no"
            Variable(n) => "no"
            Unary(o, r) => "no"
            Call(c, a) => "no"
            Assign(n, v) => "no"
            Logical(l, o, r) => "no"
            MemberAccess(o, f) => "no"
            NilLit => "no"
            Match(s, a) => "no"
            EnumConstruct(e, v, a) => "no"
            Lambda(p, r, b) => "no"
            GetField(o, f) => "no"
            SetField(o, f, v) => "no"
            This => "no"
            BlockExpr(s, v) => "no"
            IsCheck(val, t) => "no"
            IfExpr(c, tb, tv, eb, ev) => "no"
            TryExpr(tb, tv, cn, cb, cv) => "no"
            Yield(v) => "no"
            TupleLit(e) => "no"
        }
        return kind == "yes"
    }

    fun is_string_variable(expr: AST.Expr): Bool {
        var name: Any = match (expr) {
            Variable(n) => n
            GetField(o, f) => f
            IntLit(v) => ""
            FloatLit(v) => ""
            BoolLit(v) => ""
            StringLit(s) => ""
            NilLit => ""
            Binary(l, o, r) => ""
            Unary(o, r) => ""
            Call(c, a) => ""
            Assign(n, v) => ""
            Logical(l, o, r) => ""
            MemberAccess(o, f) => ""
            Match(s, a) => ""
            EnumConstruct(e, v, a) => ""
            Lambda(p, r, b) => ""
            SetField(o, f, v) => ""
            This => ""
            BlockExpr(s, v) => ""
            IsCheck(val, t) => ""
            IfExpr(c, tb, tv, eb, ev) => ""
            TryExpr(tb, tv, cn, cb, cv) => ""
            Yield(v) => ""
            TupleLit(e) => ""
        }
        if (name.length() > 0) {
            if (this.string_vars.contains(name)) return true
            // Check class fields
            if (this.current_class.length() > 0 and this.class_fields.has(this.current_class)) {
                var fields: String = this.class_fields.get(this.current_class)
                if (fields.contains(name + ":String")) return true
            }
        }
        return false
    }

    fun get_string_lit_value(expr: AST.Expr): String {
        return match (expr) { StringLit(s) => s
            _ => ""
        }
    }

    fun is_string_expr(expr: AST.Expr): Bool {
        var kind: Any = match (expr) {
            StringLit(s) => "string"
            Binary(l, o, r) => {
                if (o == "+") {
                    if (this.is_string_expr(l) and this.is_string_expr(r)) { "string" } else { "binary" }
                } else { "binary" }
            }
            IntLit(v) => "int"
            FloatLit(v) => "float"
            BoolLit(v) => "bool"
            Variable(n) => "var"
            Unary(o, r) => "unary"
            Call(c, a) => "call"
            Assign(n, v) => "assign"
            Logical(l, o, r) => "logical"
            MemberAccess(o, f) => "member"
            NilLit => "nil"
            Match(s, a) => "match"
            EnumConstruct(e, v, a) => "enum"
            Lambda(p, r, b) => "lambda"
            GetField(o, f) => "get_field"
            SetField(o, f, v) => "set_field"
            This => "this"
            ListLit(e) => "list"
            IndexGet(o, i) => "index"
            IndexSet(o, i, v) => "index"
            MethodCall(o, m, a) => "method"
            BlockExpr(s, v) => "block"
            IsCheck(val, t) => "is"
            IfExpr(c, tb, tv, eb, ev) => "other"
            TryExpr(tb, tv, cn, cb, cv) => "other"
            Yield(v) => "other"
            TupleLit(e) => "other"
        }
        return kind == "string"
    }

    fun get_format_ptr(fmt: String): String {
        var name: String = this.add_string_constant(fmt)
        var len: Float = fmt.length() + 1
        var local: String = this.fresh_local()
        this.emit_indent(local + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + name + ", i64 0, i64 0")
        return local
    }

    fun gen_enum_construct(enum_name: String, variant: String, args: List<AST.Expr>): String {
        var key: String = enum_name + "." + variant
        var tag: Float = this.enum_variant_tags.get(key)

        // Check if this enum uses simple encoding (no fields) or array encoding
        var max_fields: Float = this.get_max_fields(enum_name)

        if (max_fields == 0) {
            // Simple encoding for enums with no data fields at all: tag << 56
            if (args.length() == 0) {
                var local: String = this.fresh_local()
                this.emit_indent(local + " = shl i64 " + tag.floor().to_string() + ", 56")
                this.last_type = AST.Type.EnumType(enum_name); return local
            }
            // Shouldn't happen (max_fields==0 but args>0), fall through to array encoding
        }

        // Array encoding for enums with multi-field variants: [tag, f0, f1, ...]
        if (args.length() == 0) {
            // No-field variant in a multi-field enum: heap-allocate to outlive function
            var arr_raw: String = this.fresh_local()
            this.emit_indent(arr_raw + " = call i8* @malloc(i64 8)")
            var arr_ptr: String = this.fresh_local()
            this.emit_indent(arr_ptr + " = bitcast i8* " + arr_raw + " to [1 x i64]*")
            var tag_slot: String = this.fresh_local()
            this.emit_indent(tag_slot + " = getelementptr [1 x i64], [1 x i64]* " + arr_ptr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + tag_slot)
            var as_int: String = this.typed_ptr_to_val(arr_ptr, "[1 x i64]*")
            this.last_type = AST.Type.EnumType(enum_name); return as_int
        }

        // Multi-field: heap-allocate array [tag, field0, field1, ...]
        // Must be heap (not stack) since enum values may outlive the creating function
        var num_slots: Float = args.length() + 1
        var arr_bytes: Float = num_slots * 8
        var arr_raw: String = this.fresh_local()
        this.emit_indent(arr_raw + " = call i8* @malloc(i64 " + arr_bytes.floor().to_string() + ")")
        var arr_ptr: String = this.fresh_local()
        this.emit_indent(arr_ptr + " = bitcast i8* " + arr_raw + " to [" + num_slots.to_string() + " x i64]*")
        // Store tag at index 0
        var tag_slot: String = this.fresh_local()
        this.emit_indent(tag_slot + " = getelementptr [" + num_slots.to_string() + " x i64], [" + num_slots.to_string() + " x i64]* " + arr_ptr + ", i64 0, i64 0")
        this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + tag_slot)
        // Store fields at indices 1, 2, ...
        var i: Float = 0
        while (i < args.length()) {
            var val: String = this.gen_arg_value(args[i])
            var field_idx: Float = i + 1
            var field_slot: String = this.fresh_local()
            this.emit_indent(field_slot + " = getelementptr [" + num_slots.to_string() + " x i64], [" + num_slots.to_string() + " x i64]* " + arr_ptr + ", i64 0, i64 " + field_idx.to_string())
            this.emit_indent("store i64 " + val + ", i64* " + field_slot)
            i = i + 1
        }
        // Cast pointer to i64 for storage
        var as_int: String = this.typed_ptr_to_val(arr_ptr, "[" + num_slots.to_string() + " x i64]*")
        this.last_type = AST.Type.EnumType(enum_name); return as_int
    }

    // @codegen-split: match
    fun gen_match(subject: AST.Expr, arms: List<AST.MatchArm>): String {
        var subj: String = this.gen_arg_value(subject)
        var result_ptr: String = this.fresh_local()
        this.emit_indent(result_ptr + " = alloca i64")

        // Determine which enum from first arm's pattern
        var first_arm: AST.MatchArm = arms[0]
        var first_pattern: AST.Pattern = match (first_arm) { Arm(p, b) => p
            _ => AST.Pattern.VariantPattern("", [])
        }
        var first_variant: String = match (first_pattern) { VariantPattern(v, b) => v
            _ => ""
        }

        // Check if this is a string literal match (prefix "__strpat:")
        if (first_variant.starts_with("__strpat:")) {
            // String literal match — generate if/else chain with __string_eq
            var end_label: String = this.fresh_label("match.end")
            var match_result_type: AST.Type = AST.Type.StringType
            var i: Float = 0
            while (i < arms.length()) {
                var arm: AST.MatchArm = arms[i]
                var arm_pattern: AST.Pattern = match (arm) { Arm(p, b) => p
                    _ => AST.Pattern.VariantPattern("", [])
                }
                var arm_body: AST.Expr = match (arm) { Arm(p, b) => b
                    _ => AST.Expr.NilLit
                }
                var arm_vname: String = match (arm_pattern) { VariantPattern(v, b) => v
                    _ => ""
                }

                if (arm_vname == "_") {
                    // Default/wildcard arm — just generate body
                    var val: String = this.gen_arg_value(arm_body)
                    if (i == 0) { match_result_type = this.last_type }
                    this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
                    this.emit_terminator("br label %" + end_label)
                } else if (arm_vname.starts_with("__strpat:")) {
                    // String pattern arm — compare with __string_eq
                    var str_val: String = arm_vname.slice(9, arm_vname.length())
                    var const_name: String = this.add_string_constant(str_val)
                    var len: Float = str_val.length() + 1
                    var gep: String = this.fresh_local()
                    this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
                    var pattern_val: String = this.ptr_to_val(gep)
                    var eq_result: String = this.fresh_local()
                    this.emit_indent(eq_result + " = call i64 @__string_eq(i64 " + subj + ", i64 " + pattern_val + ")")
                    var cmp: String = this.fresh_local()
                    this.emit_indent(cmp + " = trunc i64 " + eq_result + " to i1")
                    var then_label: String = this.fresh_label("match.arm")
                    var next_label: String = this.fresh_label("match.next")
                    this.emit_terminator("br i1 " + cmp + ", label %" + then_label + ", label %" + next_label)
                    // Arm body
                    this.start_block(then_label)
                    var val: String = this.gen_arg_value(arm_body)
                    if (i == 0) { match_result_type = this.last_type }
                    this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
                    this.emit_terminator("br label %" + end_label)
                    // Continue to next arm
                    this.start_block(next_label)
                }
                i = i + 1
            }
            // If no arm matched (no wildcard), store nil
            this.emit_indent("store i64 0, i64* " + result_ptr)
            this.emit_terminator("br label %" + end_label)
            this.start_block(end_label)
            var result: String = this.fresh_local()
            this.emit_indent(result + " = load i64, i64* " + result_ptr)
            this.last_type = match_result_type
            // LLVM lib parallel path: track string match result
            if (!this.identity_mode) {
                var smr: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
                this.llvm_values.set(result, smr)
            }
            return result
        }

        var enum_name: String = this.find_enum_for_variant(first_variant)

        // If enum not found, just generate the first arm's body as default
        if (enum_name == "Unknown") {
            // Unknown enum — extract bindings from subject using array encoding
            var first_bindings: List<String> = match (first_pattern) { VariantPattern(v, b) => b
                _ => []
            }
            if (first_bindings.length() >= 1) {
                // Array encoding: inttoptr → GEP for each binding
                var num_slots: Float = first_bindings.length() + 1
                var total_str: String = num_slots.floor().to_string()
                var arr_ptr: String = this.val_to_typed_ptr(subj, "[" + total_str + " x i64]*")
                var bi: Float = 0
                while (bi < first_bindings.length()) {
                    var bname: String = first_bindings[bi]
                    var field_idx: Float = bi + 1
                    var field_slot: String = this.fresh_local()
                    this.emit_indent(field_slot + " = getelementptr [" + total_str + " x i64], [" + total_str + " x i64]* " + arr_ptr + ", i64 0, i64 " + field_idx.floor().to_string())
                    var extracted: String = this.fresh_local()
                    this.emit_indent(extracted + " = load i64, i64* " + field_slot)
                    this.emit_indent("store i64 " + extracted + ", i64* %" + this.sanitize_name(bname))
                    bi = bi + 1
                }
            }
            var body_expr: AST.Expr = match (first_arm) { Arm(p, b) => b
                _ => AST.Expr.NilLit
            }
            var val: String = this.gen_arg_value(body_expr)
            this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
            var result: String = this.fresh_local()
            this.emit_indent(result + " = load i64, i64* " + result_ptr)
            // LLVM lib parallel path: track unknown-enum match result
            if (!this.identity_mode) {
                var umr: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
                this.llvm_values.set(result, umr)
            }
            return result
        }

        // Determine max fields across variants to pick encoding
        var max_fields: Float = this.get_max_fields(enum_name)

        // Extract tag based on encoding
        var tag_val: String = this.fresh_local()
        if (max_fields == 0) {
            // No-data enum: tag << 56 encoding
            var tag_shifted: String = this.fresh_local()
            this.emit_indent(tag_shifted + " = lshr i64 " + subj + ", 56")
            this.emit_indent(tag_val + " = trunc i64 " + tag_shifted + " to i8")
        } else {
            // Enum with data: heap-allocated array encoding, tag at array[0]
            var arr_ptr: String = this.val_to_typed_ptr(subj, "i64*")
            var tag_i64: String = this.fresh_local()
            this.emit_indent(tag_i64 + " = load i64, i64* " + arr_ptr)
            this.emit_indent(tag_val + " = trunc i64 " + tag_i64 + " to i8")
        }

        // Build switch
        var end_label: String = this.fresh_label("match.end")
        var arm_labels: List<String> = []
        var i: Float = 0
        while (i < arms.length()) {
            arm_labels.push(this.fresh_label("match.arm"))
            i = i + 1
        }

        var default_label: String = end_label
        var switch_cases: String = ""
        i = 0
        while (i < arms.length()) {
            var arm: AST.MatchArm = arms[i]
            var pattern: AST.Pattern = match (arm) { Arm(p, b) => p
                _ => AST.Pattern.VariantPattern("", [])
            }
            if (this.is_wildcard_in_enum(pattern, enum_name)) {
                default_label = arm_labels[i]
            } else {
                var variant_name: String = match (pattern) { VariantPattern(v, b) => v
                    _ => ""
                }
                var lookup_key: String = enum_name + "." + variant_name
                if (this.enum_variant_tags.has(lookup_key)) {
                    var tag_idx: Float = this.enum_variant_tags.get(lookup_key)
                    switch_cases = switch_cases + " i8 " + tag_idx.floor().to_string() + ", label %" + arm_labels[i]
                }
            }
            i = i + 1
        }
        this.emit_terminator("switch i8 " + tag_val + ", label %" + default_label + " [" + switch_cases + " ]")

        // Generate each arm
        var match_result_type: AST.Type = AST.Type.IntType
        i = 0
        while (i < arms.length()) {
            this.start_block(arm_labels[i])
            var arm: AST.MatchArm = arms[i]
            var pattern: AST.Pattern = match (arm) { Arm(p, b) => p
                _ => AST.Pattern.VariantPattern("", [])
            }
            var body_expr: AST.Expr = match (arm) { Arm(p, b) => b
                _ => AST.Expr.NilLit
            }

            // Extract bindings from payload and set their types
            var arm_variant: String = match (pattern) { VariantPattern(v, b) => v
                _ => ""
            }
            var bindings: List<String> = match (pattern) { VariantPattern(v, b) => b
                _ => []
            }
            var bind_count: Float = bindings.length()
            if (bind_count > 0) {
                this.extract_arm_bindings(bindings, subj, max_fields)
                var bi: Float = 0
                while (bi < bind_count) {
                    var btype: String = this.get_variant_field_type(enum_name, arm_variant, bi)
                    this.typed_vars.set(bindings[bi], this.str_to_type(btype))
                    if (btype == "String") {
                        this.string_vars.push(bindings[bi])
                    }
                    bi = bi + 1
                }
            }
            var val: String = this.gen_arg_value(body_expr)
            if (i == 0) {
                match_result_type = this.last_type
            }
            this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
            this.emit_terminator("br label %" + end_label)
            i = i + 1
        }

        this.start_block(end_label)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = load i64, i64* " + result_ptr)
        this.last_type = match_result_type
        // LLVM lib parallel path: track match result as opaque call placeholder
        if (!this.identity_mode) {
            var match_res: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
            this.llvm_values.set(result, match_res)
        }
        return result
    }

    fun extract_arm_bindings(bindings: List<String>, subj: String, max_fields: Float) {
        var bind_count: Float = bindings.length()
        // Always use array encoding: inttoptr and GEP to extract fields
        // (max_fields >= 1 means heap-allocated [tag, field0, field1, ...])
        var total: Float = bind_count + 1
        var total_str: String = total.floor().to_string()
        var arr_ptr: String = this.val_to_typed_ptr(subj, "[" + total_str + " x i64]*")
        // Extract each field individually to avoid VM loop variable bug
        if (bind_count >= 1) { this.extract_one_field(bindings[0], arr_ptr, total_str, 1) }
        if (bind_count >= 2) { this.extract_one_field(bindings[1], arr_ptr, total_str, 2) }
        if (bind_count >= 3) { this.extract_one_field(bindings[2], arr_ptr, total_str, 3) }
        if (bind_count >= 4) { this.extract_one_field(bindings[3], arr_ptr, total_str, 4) }
        if (bind_count >= 5) { this.extract_one_field(bindings[4], arr_ptr, total_str, 5) }
    }

    fun extract_one_field(bname: String, arr_ptr: String, total_str: String, idx: Float) {
        var field_slot: String = this.fresh_local()
        this.emit_indent(field_slot + " = getelementptr [" + total_str + " x i64], [" + total_str + " x i64]* " + arr_ptr + ", i64 0, i64 " + idx.floor().to_string())
        var extracted: String = this.fresh_local()
        this.emit_indent(extracted + " = load i64, i64* " + field_slot)
        this.emit_indent("store i64 " + extracted + ", i64* %" + this.sanitize_name(bname))
    }

    fun get_variant_field_type(enum_name: String, variant_name: String, field_idx: Float): String {
        var key: String = enum_name + "." + variant_name
        if (!this.enum_variant_fields.has(key)) return "Int"
        var fields: String = this.enum_variant_fields.get(key)
        if (fields.length() == 0) return "Int"
        var parts: List<String> = this.split_respecting_generics(fields, ",")
        if (field_idx >= parts.length()) return "Int"
        var field_def: String = parts[field_idx.floor()]
        var name_type: List<String> = field_def.split(":")
        if (name_type.length() < 2) return "Int"
        var ftype: String = name_type[1]
        if (ftype == "String") return "String"
        if (ftype == "Float" or ftype == "Number") return "Int"
        if (ftype == "Bool") return "Int"
        if (ftype.starts_with("List")) return "List<String>"
        return "Int"
    }

    fun get_max_fields(enum_name: String): Float {
        var max_f: Float = 0
        if (!this.enum_defs.has(enum_name)) return 0
        var variants: List = this.enum_defs.get(enum_name)
        var i: Float = 0
        while (i < variants.length()) {
            var vname: String = variants[i]
            var key: String = enum_name + "." + vname
            if (this.enum_variant_fields.has(key)) {
                var fields: String = this.enum_variant_fields.get(key)
                if (fields.length() > 0) {
                    var parts: List<String> = this.split_respecting_generics(fields, ",")
                    // Each part is "name:Type", count them
                    var field_count: Float = parts.length()
                    if (field_count > max_f) {
                        max_f = field_count
                    }
                }
            }
            i = i + 1
        }
        return max_f
    }


    // @codegen-split: closures
    fun gen_lambda(params: List<AST.Param>, ret_type: String, body: List<AST.Stmt>): String {
        // Find captured variables (free variables in body not in params)
        var param_names: List<String> = []
        var pi: Float = 0
        while (pi < params.length()) {
            var p: AST.Param = params[pi]
            var pname: String = match (p) { Param(n, t, d) => n }
            param_names.push(pname)
            pi = pi + 1
        }
        var captures: List<String> = []
        this.find_free_vars_stmts(body, param_names, captures)

        // Sendable check: warn if Task.spawn captures non-Sendable variables
        if (this.check_spawn_sendable) {
            this.check_spawn_sendable = false
            var sci: Float = 0
            while (sci < captures.length()) {
                var cap_name: String = captures[sci]
                var cap_type: String = this.get_var_type_str(cap_name)
                if (cap_type.length() > 0 and cap_type != "Any" and cap_type != "Int" and cap_type != "Float" and cap_type != "Bool" and cap_type != "String" and cap_type != "Number") {
                    if (!this.actor_classes.has(cap_type) and !this.enum_defs.has(cap_type)) {
                        IO.println("[checker] Warning: Task.spawn closure captures non-Sendable variable '" + cap_name + "' (type " + cap_type + ")")
                    }
                }
                sci = sci + 1
            }
        }

        // Generate a unique name for this lambda (module-prefixed for global uniqueness)
        this.label_counter = this.label_counter + 1
        var lambda_name: String = this.current_prefix + "__lambda_" + this.label_counter.floor().to_string()

        // Check if this lambda is a coroutine (contains yield or calls a coroutine)
        if (this.force_next_lambda_coro) {
            this.coroutine_funcs.push(lambda_name)
            this.force_next_lambda_coro = false
        } else if (this.stmts_have_yield(body)) {
            this.coroutine_funcs.push(lambda_name)
        } else {
            var lambda_calls: List<String> = []
            this.collect_calls_from_stmts(body, lambda_calls)
            var lci: Float = 0
            while (lci < lambda_calls.length()) {
                if (this.str_in_list(this.coroutine_funcs,lambda_calls[lci]) or this.str_in_list(this.coroutine_funcs,this.current_prefix + lambda_calls[lci]) or this.coro_method_match(lambda_calls[lci])) {
                    this.coroutine_funcs.push(lambda_name)
                    lci = lambda_calls.length()
                }
                lci = lci + 1
            }
        }

        // Build the lambda's params: env pointer (if captures) + original params
        var params_str: String = this.params_to_string(params)
        var lambda_params: String = ""
        if (captures.length() > 0) {
            lambda_params = "__env:Int"
            if (params_str.length() > 0) {
                lambda_params = lambda_params + "," + params_str
            }
        } else {
            lambda_params = params_str
        }

        // Save current state
        var saved_sb: StringBuilder = this.sb
        var saved_terminated: Bool = this.block_terminated
        var saved_counter: Float = this.local_counter
        var saved_typed_vars: Map<String, AST.Type> = this.typed_vars
        var saved_is_coro: Bool = this.is_coroutine

        // Generate the lambda function (disable nested detection to avoid interception)
        var saved_in_fn: Bool = this.in_function
        this.in_function = false
        this.sb = StringBuilder()
        if (captures.length() > 0) {
            // Custom gen: emit function header, extract captures from env, then body
            this.gen_closure_function(lambda_name, lambda_params, ret_type, body, captures)
        } else {
            this.gen_function(lambda_name, params_str, ret_type, body)
        }
        this.in_function = saved_in_fn
        var lambda_ir: String = this.sb.to_string()

        // Restore state
        this.sb = saved_sb
        this.block_terminated = saved_terminated
        this.local_counter = saved_counter
        this.typed_vars = saved_typed_vars
        this.is_coroutine = saved_is_coro
        this.globals.push(lambda_ir)

        if (captures.length() > 0) {
            // Heap-allocate environment: [cap0, cap1, ...]
            var env_size: Float = captures.length()
            var env_bytes: Float = env_size * 8
            var env_raw: String = this.fresh_local()
            this.emit_indent(env_raw + " = call i8* @malloc(i64 " + env_bytes.floor().to_string() + ")")
            var env_ptr: String = this.fresh_local()
            this.emit_indent(env_ptr + " = bitcast i8* " + env_raw + " to [" + env_size.floor().to_string() + " x i64]*")
            // Store VALUES of captured variables in env (copy semantics).
            // This allows closures to escape the enclosing stack frame safely.
            var ci: Float = 0
            while (ci < captures.length()) {
                var cap_val: String = this.fresh_local()
                this.emit_indent(cap_val + " = load i64, i64* %" + this.sanitize_name(captures[ci]))
                var slot: String = this.fresh_local()
                this.emit_indent(slot + " = getelementptr [" + env_size.floor().to_string() + " x i64], [" + env_size.floor().to_string() + " x i64]* " + env_ptr + ", i64 0, i64 " + ci.floor().to_string())
                this.emit_indent("store i64 " + cap_val + ", i64* " + slot)
                ci = ci + 1
            }
            // Heap-allocate closure pair: [fn_ptr, env_ptr]
            var closure_raw: String = this.fresh_local()
            this.emit_indent(closure_raw + " = call i8* @malloc(i64 16)")
            var closure_ptr: String = this.fresh_local()
            this.emit_indent(closure_ptr + " = bitcast i8* " + closure_raw + " to [2 x i64]*")
            // Store fn ptr
            var num_params: Float = param_names.length() + 1
            var ret_ty: String = "i64"
            if (this.str_in_list(this.coroutine_funcs,lambda_name)) { ret_ty = "ptr" }
            var fn_type_str: String = ret_ty + " ("
            var ti: Float = 0
            while (ti < num_params) {
                if (ti > 0) { fn_type_str = fn_type_str + ", " }
                fn_type_str = fn_type_str + "i64"
                ti = ti + 1
            }
            fn_type_str = fn_type_str + ")*"
            var fn_as_int: String = this.fn_ptr_to_val(fn_type_str, "@" + lambda_name)
            var fn_slot: String = this.fresh_local()
            this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
            // Store env ptr
            var env_as_int: String = this.typed_ptr_to_val(env_ptr, "[" + env_size.floor().to_string() + " x i64]*")
            var env_slot: String = this.fresh_local()
            this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
            this.emit_indent("store i64 " + env_as_int + ", i64* " + env_slot)
            // Return closure pointer as i64
            var result: String = this.typed_ptr_to_val(closure_ptr, "[2 x i64]*")
            // LLVM lib parallel path: track lambda/closure result as opaque value
            if (this.use_llvm_lib and !this.identity_mode) {
                this.llvm_values.set(result, LLVMTypes.Value.Constant(LLVMTypes.Const.Int(0, 64)))
            }
            return result
        }

        // No captures: create closure pair with env=0
        // Lambda needs env param too for uniform calling convention
        // Re-generate with env param
        this.globals.pop() // remove the one we just generated
        // Remove from defined_funcs so re-generation isn't skipped
        // Build a new list excluding the lambda_name (avoids List.set which
        // the bootstrap compiler mis-compiles as __map_set)
        var new_defined: List<String> = []
        var df_idx: Float = 0
        while (df_idx < this.defined_funcs.length()) {
            if (this.defined_funcs[df_idx] != lambda_name) {
                new_defined.push(this.defined_funcs[df_idx])
            }
            df_idx = df_idx + 1
        }
        this.defined_funcs = new_defined
        var saved_sb2: StringBuilder = this.sb
        var saved_terminated2: Bool = this.block_terminated
        var saved_counter2: Float = this.local_counter
        var saved_typed_vars2b: Map<String, AST.Type> = this.typed_vars
        var saved_in_fn2: Bool = this.in_function
        this.in_function = false
        this.sb = StringBuilder()
        var full_params: String = "__env:Int"
        if (params_str.length() > 0) {
            full_params = full_params + "," + params_str
        }
        this.gen_function(lambda_name, full_params, ret_type, body)
        this.globals.push(this.sb.to_string())
        this.in_function = saved_in_fn2
        this.sb = saved_sb2
        this.block_terminated = saved_terminated2
        this.local_counter = saved_counter2
        this.typed_vars = saved_typed_vars2b

        // Heap-allocate closure pair: [fn_ptr, 0]
        var closure_raw: String = this.fresh_local()
        this.emit_indent(closure_raw + " = call i8* @malloc(i64 16)")
        var closure_ptr: String = this.fresh_local()
        this.emit_indent(closure_ptr + " = bitcast i8* " + closure_raw + " to [2 x i64]*")
        var num_total_params: Float = param_names.length() + 1
        var nocap_ret_ty: String = "i64"
        if (this.str_in_list(this.coroutine_funcs,lambda_name)) { nocap_ret_ty = "ptr" }
        var fn_type_str: String = nocap_ret_ty + " ("
        var tti: Float = 0
        while (tti < num_total_params) {
            if (tti > 0) { fn_type_str = fn_type_str + ", " }
            fn_type_str = fn_type_str + "i64"
            tti = tti + 1
        }
        fn_type_str = fn_type_str + ")*"
        var fn_as_int: String = this.fn_ptr_to_val(fn_type_str, "@" + lambda_name)
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        this.emit_indent("store i64 0, i64* " + env_slot)
        var result: String = this.typed_ptr_to_val(closure_ptr, "[2 x i64]*")
        // LLVM lib parallel path: track lambda/closure result as opaque value
        if (this.use_llvm_lib and !this.identity_mode) {
            this.llvm_values.set(result, LLVMTypes.Value.Constant(LLVMTypes.Const.Int(0, 64)))
        }
        return result
    }

    fun gen_closure_function(name: String, params: String, ret_type: String, body: List<AST.Stmt>, captures: List<String>) {
        this.known_functions.push(name)
        // Save outer-scope types for captured variables before resetting
        var outer_typed_vars: Map<String, AST.Type> = {}
        var oci: Float = 0
        while (oci < captures.length()) {
            var ocn: String = captures[oci]
            if (this.typed_vars.has(ocn)) {
                outer_typed_vars.set(ocn, this.typed_vars.get(ocn))
            }
            oci = oci + 1
        }
        this.reset_locals()
        this.typed_vars = {}
        this.string_vars = []
        var ret_llvm: String = this.llvm_type(ret_type)
        this.current_ret_type = ret_llvm

        // Check if this closure is a coroutine
        var is_coro: Bool = this.str_in_list(this.coroutine_funcs,name)
        this.is_coroutine = is_coro

        var param_list: List<String> = []
        if (params.length() > 0) {
            param_list = this.split_respecting_generics(params, ",")
        }

        var param_strs: List<String> = []
        var i: Float = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            param_strs.push(this.llvm_type(ptype) + " %" + this.sanitize_name(pname) + ".arg")
            i = i + 1
        }

        this.emit("")
        var closure_linkage: String = "define"
        if (this.current_prefix.length() > 0) {
            // On WASM targets, linkonce_odr breaks indirect calls (function table index
            // mismatch after linker deduplication). Use plain define with unique names.
            if (this.target != "wasm" and this.target != "wasm64" and this.target != "wasm32") {
                closure_linkage = "define linkonce_odr"
            }
        }
        var coro_attr: String = ""
        var ret_type_ll: String = ret_llvm
        if (is_coro) {
            coro_attr = " noinline optnone presplitcoroutine"
            ret_type_ll = "ptr"
        }
        this.emit(closure_linkage + " " + ret_type_ll + " @" + name + "(" + param_strs.join(", ") + ")" + coro_attr + " {")
        this.emit("entry:")
        this.block_terminated = false

        // Coroutine preamble
        if (is_coro) {
            this.emit_indent("%__coro_id = call token @llvm.coro.id(i32 0, ptr null, ptr null, ptr null)")
            this.emit_indent("%__coro_size = call i64 @llvm.coro.size.i64()")
            this.emit_indent("%__coro_mem = call ptr @malloc(i64 %__coro_size)")
            this.emit_indent("%__coro_hdl = call ptr @llvm.coro.begin(token %__coro_id, ptr %__coro_mem)")
        }

        // Alloca all params and register in typed_vars
        i = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            this.emit_indent("%" + this.sanitize_name(pname) + " = alloca " + this.llvm_type(ptype))
            this.emit_indent("store " + this.llvm_type(ptype) + " %" + this.sanitize_name(pname) + ".arg, " + this.llvm_type(ptype) + "* %" + this.sanitize_name(pname))
            this.typed_vars.set(pname, this.str_to_type(ptype))
            i = i + 1
        }

        // Extract capture POINTERS from __env (reference semantics)
        // Env stores the actual i64 values of captured variables — we point directly
        // at the env slots so mutations persist between closure calls.
        var env_size: Float = captures.length()
        var env_int: String = this.fresh_local()
        this.emit_indent(env_int + " = load i64, i64* %__env")
        var env_ptr: String = this.val_to_typed_ptr(env_int, "[" + env_size.floor().to_string() + " x i64]*")
        var ci: Float = 0
        while (ci < captures.length()) {
            var cap_name: String = captures[ci]
            // Point directly at the env slot — no alloca, no copy
            this.emit_indent("%" + this.sanitize_name(cap_name) + " = getelementptr [" + env_size.floor().to_string() + " x i64], [" + env_size.floor().to_string() + " x i64]* " + env_ptr + ", i64 0, i64 " + ci.floor().to_string())
            // Register captured variable in typed_vars
            // Use the outer scope's type if available (preserves generic class types)
            if (outer_typed_vars.has(cap_name)) {
                this.typed_vars.set(cap_name, outer_typed_vars.get(cap_name))
            } else {
                this.typed_vars.set(cap_name, this.str_to_type("Int"))
            }
            ci = ci + 1
        }

        // Collect and emit remaining var allocas
        var var_names: List<String> = []
        var var_types: List<String> = []
        this.collect_vars(body, var_names, var_types)
        i = 0
        while (i < var_names.length()) {
            var vname: String = var_names[i]
            if (!this.str_in_list(captures,vname)) {
                this.emit_indent("%" + this.sanitize_name(vname) + " = alloca " + this.llvm_type(var_types[i]))
            }
            i = i + 1
        }

        this.gen_stmts(body)

        // Coroutine epilogue
        if (is_coro) {
            if (!this.block_terminated) {
                this.emit_terminator("br label %__coro_final")
            }

            this.emit("__coro_final:")
            this.block_terminated = false
            this.emit_indent("%__coro_fs_tok = call token @llvm.coro.save(ptr %__coro_hdl)")
            this.emit_indent("%__coro_fs = call i8 @llvm.coro.suspend(token %__coro_fs_tok, i1 true)")
            this.emit_indent("switch i8 %__coro_fs, label %__coro_suspend [i8 0, label %__coro_trap i8 1, label %__coro_cleanup]")

            this.emit("__coro_trap:")
            this.block_terminated = false
            this.emit_terminator("unreachable")

            this.emit("__coro_cleanup:")
            this.block_terminated = false
            this.emit_indent("%__coro_free = call ptr @llvm.coro.free(token %__coro_id, ptr %__coro_hdl)")
            this.emit_indent("call void @free(ptr %__coro_free)")
            this.emit_terminator("br label %__coro_suspend")

            this.emit("__coro_suspend:")
            this.block_terminated = false
            this.emit_indent("call i1 @llvm.coro.end(ptr %__coro_hdl, i1 false)")
            this.emit_terminator("ret ptr %__coro_hdl")
        } else {
            if (!this.block_terminated) {
                if (ret_llvm == "void") {
                    this.emit_terminator("ret void")
                } else {
                    this.emit_terminator("ret i64 0")
                }
            }
        }
        this.emit("}")
        this.block_terminated = false
        this.is_coroutine = false
    }


    fun find_free_vars_stmts(stmts: List<AST.Stmt>, bound: List<String>, free: List<String>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.find_free_vars_stmt(stmts[i], bound, free)
            i = i + 1
        }
    }

    fun find_free_vars_stmt(stmt: AST.Stmt, bound: List<String>, free: List<String>) {
        match (stmt) {
            VarDecl(name, typ, init) => {
                this.find_free_vars_expr(init, bound, free)
                bound.push(name)
            }
            ExprStmt(expr) => { this.find_free_vars_expr(expr, bound, free) }
            Return(value) => { this.find_free_vars_expr(value, bound, free) }
            If(cond, then_b, else_b) => {
                this.find_free_vars_expr(cond, bound, free)
                this.find_free_vars_stmts(then_b, bound, free)
                this.find_free_vars_stmts(else_b, bound, free)
            }
            While(cond, body) => {
                this.find_free_vars_expr(cond, bound, free)
                this.find_free_vars_stmts(body, bound, free)
            }
            Block(stmts) => { this.find_free_vars_stmts(stmts, bound, free) }
            FunDecl(n, p, r, b, d) => {}
            EnumDecl(n, v, d) => {}
            ClassDecl(n, p, f, m, d) => {}
            Break => {}
            Continue => {}
            TryCatch(try_body, catch_name, catch_body, finally_body) => {
                this.find_free_vars_stmts(try_body, bound, free)
                bound.push(catch_name)
                this.find_free_vars_stmts(catch_body, bound, free)
                this.find_free_vars_stmts(finally_body, bound, free)
            }
            Throw(value) => { this.find_free_vars_expr(value, bound, free) }
            LetPattern(pattern, value) => {
            }
        }
    }

    fun find_free_vars_expr(expr: AST.Expr, bound: List<String>, free: List<String>) {
        match (expr) {
            Variable(name) => {
                if (this.str_in_list(bound,name) or this.str_in_list(free,name)) {
                    // Already bound or already free — skip
                } else if (this.typed_vars.has(name) and !this.module_globals.has(name) and !this.module_globals.has(this.current_prefix + name)) {
                    // Local variable in enclosing scope shadows any function of same name
                    free.push(name)
                } else {
                    var is_known: Bool = this.str_in_list(this.known_functions,name) or this.str_in_list(this.known_functions,this.current_prefix + name) or this.func_prefix_map.has(name) or this.func_ret_types.has(name) or this.class_fields.has(name) or this.enum_defs.has(name) or this.enum_variant_tags.has(name) or this.module_prefixes.has(name) or this.named_imports.has(name) or this.module_globals.has(name) or this.module_globals.has(this.current_prefix + name)
                    if (!is_known and name.length() > 0) {
                        var upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                        if (upper.index_of(name.char_at(0)) >= 0) {
                            is_known = true
                        }
                    }
                    if (!is_known) {
                        free.push(name)
                    }
                }
            }
            Binary(l, o, r) => {
                this.find_free_vars_expr(l, bound, free)
                this.find_free_vars_expr(r, bound, free)
            }
            Unary(o, r) => { this.find_free_vars_expr(r, bound, free) }
            Call(c, args) => {
                this.find_free_vars_expr(c, bound, free)
                var i: Float = 0
                while (i < args.length()) {
                    this.find_free_vars_expr(args[i], bound, free)
                    i = i + 1
                }
                // If calling a closure function, add its captures to our free vars
                var call_name: String = match (c) { Variable(n) => n
                    _ => ""
                }
                if (call_name.length() > 0) {
                    var caps_key: String = "__caps_" + this.current_prefix + call_name
                    if (this.func_prefix_map.has(caps_key)) {
                        var caps_str: String = this.func_prefix_map.get(caps_key)
                        if (caps_str.length() > 0) {
                            var cap_list: List<String> = caps_str.split(",")
                            var ci4: Float = 0
                            while (ci4 < cap_list.length()) {
                                var cn: String = cap_list[ci4]
                                if (!this.str_in_list(bound,cn) and !this.str_in_list(free,cn)) {
                                    free.push(cn)
                                }
                                ci4 = ci4 + 1
                            }
                        }
                    }
                }
            }
            Assign(name, value) => {
                this.find_free_vars_expr(value, bound, free)
                if (!this.str_in_list(bound,name) and !this.str_in_list(free,name) and (this.typed_vars.has(name) or this.module_globals.has(this.current_prefix + name))) {
                    free.push(name)
                }
            }
            Logical(l, o, r) => {
                this.find_free_vars_expr(l, bound, free)
                this.find_free_vars_expr(r, bound, free)
            }
            IntLit(v) => {}
            FloatLit(v) => {}
            BoolLit(v) => {}
            StringLit(s) => {}
            NilLit => {}
            MemberAccess(o, f) => { this.find_free_vars_expr(o, bound, free) }
            MethodCall(o, m, a) => {
                this.find_free_vars_expr(o, bound, free)
                var mi: Float = 0
                while (mi < a.length()) {
                    this.find_free_vars_expr(a[mi], bound, free)
                    mi = mi + 1
                }
            }
            GetField(o, f) => { this.find_free_vars_expr(o, bound, free) }
            SetField(o, f, v) => {
                this.find_free_vars_expr(o, bound, free)
                this.find_free_vars_expr(v, bound, free)
            }
            IndexGet(o, idx) => {
                this.find_free_vars_expr(o, bound, free)
                this.find_free_vars_expr(idx, bound, free)
            }
            IndexSet(o, idx, v) => {
                this.find_free_vars_expr(o, bound, free)
                this.find_free_vars_expr(idx, bound, free)
                this.find_free_vars_expr(v, bound, free)
            }
            Match(s, a) => {
                this.find_free_vars_expr(s, bound, free)
                var mi: Float = 0
                while (mi < a.length()) {
                    var arm: AST.MatchArm = a[mi]
                    var arm_pattern: AST.Pattern = match (arm) { Arm(p, b) => p }
                    var arm_body: AST.Expr = match (arm) { Arm(p, b) => b }
                    var arm_bindings: List<String> = match (arm_pattern) {
                        VariantPattern(v, binds) => binds
                        _ => []
                    }
                    // Pattern bindings are local to the arm body
                    var arm_bound: List<String> = []
                    var bi2: Float = 0
                    while (bi2 < bound.length()) {
                        arm_bound.push(bound[bi2])
                        bi2 = bi2 + 1
                    }
                    var bi3: Float = 0
                    while (bi3 < arm_bindings.length()) {
                        arm_bound.push(arm_bindings[bi3])
                        bi3 = bi3 + 1
                    }
                    this.find_free_vars_expr(arm_body, arm_bound, free)
                    mi = mi + 1
                }
            }
            EnumConstruct(e, v, a) => {
                var ei: Float = 0
                while (ei < a.length()) {
                    this.find_free_vars_expr(a[ei], bound, free)
                    ei = ei + 1
                }
            }
            ListLit(elements) => {
                var li: Float = 0
                while (li < elements.length()) {
                    this.find_free_vars_expr(elements[li], bound, free)
                    li = li + 1
                }
            }
            Lambda(p, r, b) => {
                // Scan nested lambda body for free vars that propagate to this scope
                var inner_bound: List<String> = []
                var pi2: Float = 0
                while (pi2 < p.length()) {
                    var pn: String = match (p[pi2]) { Param(n, t, d) => n }
                    inner_bound.push(pn)
                    pi2 = pi2 + 1
                }
                var inner_free: List<String> = []
                this.find_free_vars_stmts(b, inner_bound, inner_free)
                var fi: Float = 0
                while (fi < inner_free.length()) {
                    var fv: String = inner_free[fi]
                    // Skip module globals — they are accessed via @__g_ not local capture
                    if (!this.str_in_list(bound,fv) and !this.str_in_list(free,fv) and !this.str_in_list(inner_bound,fv) and !this.module_globals.has(fv) and !this.module_globals.has(this.current_prefix + fv)) {
                        free.push(fv)
                    }
                    fi = fi + 1
                }
            }
            BlockExpr(stmts, value) => {
                this.find_free_vars_stmts(stmts, bound, free)
                this.find_free_vars_expr(value, bound, free)
            }
            IsCheck(val, t) => {
                this.find_free_vars_expr(val, bound, free)
            }
            Yield(v) => {
                this.find_free_vars_expr(v, bound, free)
            }
            TupleLit(elements) => {
                var tli: Float = 0
                while (tli < elements.length()) {
                    this.find_free_vars_expr(elements[tli], bound, free)
                    tli = tli + 1
                }
            }
            This => {
                if (!this.str_in_list(bound,"self") and !this.str_in_list(free,"self")) {
                    free.push("self")
                }
            }
            MapLit => {}
            IfExpr(c, tb, tv, eb, ev) => {
                this.find_free_vars_expr(c, bound, free)
                this.find_free_vars_stmts(tb, bound, free)
                this.find_free_vars_expr(tv, bound, free)
                this.find_free_vars_stmts(eb, bound, free)
                this.find_free_vars_expr(ev, bound, free)
            }
            TryExpr(tb, tv, cn, cb, cv) => {
                this.find_free_vars_stmts(tb, bound, free)
                this.find_free_vars_expr(tv, bound, free)
                if (cn.length() > 0) {
                    bound.push(cn)
                }
                this.find_free_vars_stmts(cb, bound, free)
                this.find_free_vars_expr(cv, bound, free)
            }
        }
    }

    // @codegen-split: intrinsics
    // @codegen-split: intrinsics
    fun gen_intrinsic_call(name: String, args: List<AST.Expr>): String {
        if (name.ends_with("load64")) {
            var addr: String = this.gen_arg_value(args[0])
            var ptr: String = this.val_to_typed_ptr(addr, "i64*")
            var val: String = this.fresh_local()
            this.emit_indent(val + " = load i64, i64* " + ptr)
            this.last_type = AST.Type.IntType
            return val
        }
        if (name.ends_with("store64")) {
            var addr: String = this.gen_arg_value(args[0])
            var val: String = this.gen_arg_value(args[1])
            var ptr: String = this.val_to_typed_ptr(addr, "i64*")
            this.emit_indent("store i64 " + val + ", i64* " + ptr)
            this.last_type = AST.Type.NilType
            return "0"
        }
        if (name.ends_with("load8")) {
            var addr: String = this.gen_arg_value(args[0])
            var ptr: String = this.emit_untag_ptr(addr)
            var byte_val: String = this.fresh_local()
            this.emit_indent(byte_val + " = load i8, i8* " + ptr)
            var result: String = this.fresh_local()
            this.emit_indent(result + " = zext i8 " + byte_val + " to i64")
            this.last_type = AST.Type.IntType
            return result
        }
        if (name.ends_with("store8")) {
            var addr: String = this.gen_arg_value(args[0])
            var val: String = this.gen_arg_value(args[1])
            var truncated: String = this.fresh_local()
            this.emit_indent(truncated + " = trunc i64 " + val + " to i8")
            var ptr: String = this.emit_untag_ptr(addr)
            this.emit_indent("store i8 " + truncated + ", i8* " + ptr)
            this.last_type = AST.Type.NilType
            return "0"
        }
        if (name.ends_with("load_argc")) {
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = load i32, i32* @__argc")
            var result: String = this.fresh_local()
            this.emit_indent(result + " = sext i32 " + raw + " to i64")
            this.last_type = AST.Type.IntType
            return result
        }
        if (name.ends_with("load_argv")) {
            var argv: String = this.fresh_local()
            this.emit_indent(argv + " = load i8**, i8*** @__argv")
            var result: String = this.typed_ptr_to_val(argv, "i8**")
            this.last_type = AST.Type.IntType
            return result
        }
        if (name.ends_with("tag_ptr")) {
            var ptr_val: String = this.gen_arg_value(args[0])
            var as_ptr: String = this.val_to_ptr(ptr_val)
            var result: String = this.emit_tag_ptr(as_ptr)
            this.last_type = AST.Type.StringType
            return result
        }
        if (name.ends_with("untag_ptr")) {
            var val: String = this.gen_arg_value(args[0])
            var ptr: String = this.emit_untag_ptr(val)
            var result: String = this.ptr_to_val(ptr)
            this.last_type = AST.Type.IntType
            return result
        }
        // call_void_ptr(fn_ptr, arg) — indirect call with signature void(*)(ptr)
        if (name.ends_with("call_void_ptr")) {
            var fn_val: String = this.gen_arg_value(args[0])
            var arg_val: String = this.gen_arg_value(args[1])
            var fn_ptr: String = this.fresh_local()
            this.emit_indent(fn_ptr + " = inttoptr i64 " + fn_val + " to ptr")
            var arg_ptr: String = this.fresh_local()
            this.emit_indent(arg_ptr + " = inttoptr i64 " + arg_val + " to ptr")
            this.emit_indent("call void " + fn_ptr + "(ptr " + arg_ptr + ")")
            this.last_type = AST.Type.NilType
            return "0"
        }
        // __suspend(reason, arg) — async suspend point
        // Emits coro.save/coro.suspend/switch. Makes containing function a coroutine.
        if (name.ends_with("__suspend")) {
            var reason: String = this.gen_arg_value(args[0])
            this.emit_indent("store i64 " + reason + ", i64* @__yield_reason")
            if (args.length() >= 2) {
                var arg: String = this.gen_arg_value(args[1])
                this.emit_indent("store i64 " + arg + ", i64* @__yield_arg")
            }
            var save_tok: String = this.fresh_local()
            this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var susp_result: String = this.fresh_local()
            this.emit_indent(susp_result + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")
            var resume_label: String = this.fresh_label("suspend.resume")
            var cleanup_label: String = this.fresh_label("suspend.cleanup")
            // Default (suspend) case branches to the shared __coro_suspend block.
            // CoroSplit requires all suspend points to share a single suspend/ret block.
            this.emit_terminator("switch i8 " + susp_result + ", label %__coro_suspend [i8 0, label %" + resume_label + " i8 1, label %" + cleanup_label + "]")
            this.emit(cleanup_label + ":")
            this.block_terminated = false
            this.emit_terminator("br label %__coro_cleanup")
            this.emit(resume_label + ":")
            this.block_terminated = false
            this.last_type = AST.Type.NilType
            return "0"
        }
        return "0"
    }

    fun parse_extern_sig(sig: String): List<String> {
        var paren_idx: Float = sig.index_of("(")
        var left: String = sig.slice(0, paren_idx)
        var params_str: String = sig.slice(paren_idx + 1, sig.length() - 1)
        var space_idx: Float = left.index_of(" ")
        var ret_type: String = left.slice(0, space_idx)
        var c_name: String = left.slice(space_idx + 1, left.length())
        var result: List<String> = []
        result.push(c_name)
        result.push(ret_type)
        if (params_str.length() > 0) {
            var params: List<String> = params_str.split(", ")
            var i: Float = 0
            while (i < params.length()) {
                result.push(params[i].trim())
                i = i + 1
            }
        }
        return result
    }

    fun normalize_c_type(t: String): String {
        if (t == "void*") { return "i8*" }
        if (t == "void**") { return "i8**" }
        return t
    }

    fun emit_extern_declare(sig: String): String {
        var parsed: List<String> = this.parse_extern_sig(sig)
        var c_name: String = parsed[0]
        var ret_type: String = this.normalize_c_type(parsed[1])
        var sb: StringBuilder = StringBuilder()
        sb.append("declare " + ret_type + " @" + c_name + "(")
        var i: Float = 2
        while (i < parsed.length()) {
            if (i > 2) { sb.append(", ") }
            var ptype: String = this.normalize_c_type(parsed[i])
            if (ptype == "...") {
                sb.append("...")
            } else {
                sb.append(ptype)
            }
            i = i + 1
        }
        sb.append(")")
        return sb.to_string()
    }

    fun gen_extern_call(name: String, args: List<AST.Expr>): String {
        var sig: String = this.extern_sigs.get(name)
        var parsed: List<String> = this.parse_extern_sig(sig)
        var c_name: String = parsed[0]
        var ret_c: String = parsed[1]
        var llvm_ret: String = this.normalize_c_type(ret_c)
        var call_args: List<String> = []
        var i: Float = 0
        while (i < args.length()) {
            var val: String = this.gen_arg_value(args[i])
            var ptype: String = "i64"
            if (i + 2 < parsed.length()) {
                ptype = parsed[i + 2]
            }
            var norm: String = this.normalize_c_type(ptype)
            if (norm == "i8*") {
                var ptr: String = this.emit_untag_ptr(val)
                call_args.push("i8* " + ptr)
            } else if (norm == "i8**") {
                var ptr: String = this.val_to_typed_ptr(val, "i8**")
                call_args.push("i8** " + ptr)
            } else if (norm == "i32") {
                var untagged: String = this.emit_untag_int(val)
                var trunc_val: String = this.fresh_local()
                this.emit_indent(trunc_val + " = trunc i64 " + untagged + " to i32")
                call_args.push("i32 " + trunc_val)
            } else if (norm == "double") {
                var dbl: String = this.emit_untag_float(val)
                call_args.push("double " + dbl)
            } else {
                // Pass i64 values directly — no untagging needed.
                // Saffron uses identity mode for pointer-as-int values (coro handles, etc.)
                call_args.push("i64 " + val)
            }
            i = i + 1
        }
        if (llvm_ret == "void") {
            this.emit_indent("call void @" + c_name + "(" + call_args.join(", ") + ")")
            this.last_type = AST.Type.NilType
            return "0"
        }
        var raw: String = this.fresh_local()
        if (sig.contains("...")) {
            this.emit_indent(raw + " = call " + llvm_ret + " (" + this.extern_param_types(parsed) + ") @" + c_name + "(" + call_args.join(", ") + ")")
        } else {
            this.emit_indent(raw + " = call " + llvm_ret + " @" + c_name + "(" + call_args.join(", ") + ")")
        }
        // Look up the Saffron return type annotation for proper boxing
        var saffron_ret_str: String = "Int"
        if (this.func_ret_types.has(name)) {
            saffron_ret_str = this.type_to_string(this.func_ret_types.get(name))
        }
        if (llvm_ret == "i8*") {
            var as_int: String = this.emit_tag_ptr(raw)
            this.last_type = AST.Type.StringType
            return as_int
        }
        if (llvm_ret == "i32") {
            var ext: String = this.fresh_local()
            this.emit_indent(ext + " = sext i32 " + raw + " to i64")
            if (saffron_ret_str == "Any") {
                this.last_type = AST.Type.IntType
                return ext
            }
            if (saffron_ret_str == "Bool") {
                var tagged: String = this.emit_tag_bool(ext)
                this.last_type = AST.Type.BoolType
                return tagged
            }
            var tagged: String = this.emit_tag_int(ext)
            this.last_type = AST.Type.IntType
            return tagged
        }
        if (llvm_ret == "double") {
            var as_int: String = this.emit_tag_float(raw)
            this.last_type = AST.Type.FloatType
            return as_int
        }
        // Default i64 return: box based on Saffron type annotation
        if (saffron_ret_str == "Any") {
            this.last_type = AST.Type.IntType
            return raw
        }
        if (saffron_ret_str == "String") {
            var ptr: String = this.fresh_local()
            this.emit_indent(ptr + " = inttoptr i64 " + raw + " to i8*")
            var tagged: String = this.emit_tag_ptr(ptr)
            this.last_type = AST.Type.StringType
            return tagged
        }
        if (saffron_ret_str == "Bool") {
            var tagged: String = this.emit_tag_bool(raw)
            this.last_type = AST.Type.BoolType
            return tagged
        }
        var tagged: String = this.emit_tag_int(raw)
        this.last_type = AST.Type.IntType
        return tagged
    }

    fun extern_param_types(parsed: List<String>): String {
        var sb: StringBuilder = StringBuilder()
        var i: Float = 2
        while (i < parsed.length()) {
            if (i > 2) { sb.append(", ") }
            var ptype: String = this.normalize_c_type(parsed[i])
            if (ptype == "...") {
                sb.append("...")
            } else {
                sb.append(ptype)
            }
            i = i + 1
        }
        return sb.to_string()
    }

    // @codegen-split: stmts
    fun gen_stmt(stmt: AST.Stmt) {
        match (stmt) {
            ExprStmt(expr) => { this.gen_arg_value(expr) }
            VarDecl(name, type_ann, init, doc) => {
                if (!doc.starts_with("@import:")) {
                    this.gen_var_decl(stmt)
                }
            }
            Return(value) => { this.gen_return(stmt) }
            If(cond, then_branch, else_branch) => {
                this.gen_if(cond, then_branch, else_branch)
            }
            While(cond, body) => { this.gen_while(cond, body) }
            Block(stmts) => { this.gen_stmts(stmts) }
            Break => {
                if (this.loop_break_label.length() > 0) {
                    this.emit_terminator("br label %" + this.loop_break_label)
                }
            }
            Continue => {
                if (this.loop_continue_label.length() > 0) {
                    this.emit_terminator("br label %" + this.loop_continue_label)
                }
            }
            TryCatch(try_body, catch_name, catch_body, finally_body) => {
                this.gen_try_catch(try_body, catch_name, catch_body, finally_body)
            }
            Throw(value) => {
                this.gen_throw(value)
            }
            LetPattern(pattern, value) => {
                this.gen_let_pattern(pattern, value)
            }
            FunDecl(name, params, ret_type, body, doc) => {
                // Capture and clear pending_extend_class to prevent stale state
                // in nested gen_stmt calls
                var saved_extend: String = this.pending_extend_class
                this.pending_extend_class = ""
                if (doc.starts_with("@intrinsic")) {
                    var emit_name: String = this.current_prefix + name
                    this.known_functions.push(emit_name)
                    this.func_ret_types.set(emit_name, this.str_to_type(ret_type))
                    this.intrinsic_funcs.push(emit_name)
                } else if (doc.starts_with("@inline")) {
                    // Mark function for alwaysinline attribute, then process normally
                    var emit_name: String = this.current_prefix + name
                    this.inline_funcs.push(emit_name)
                    var params_str: String = this.params_to_string(params)
                    var defaults: List<AST.Expr> = []
                    var param_names: List<String> = []
                    var pi: Float = 0
                    while (pi < params.length()) {
                        var p: AST.Param = params[pi]
                        var dval: AST.Expr = match (p) { Param(n, t, d) => d }
                        var pname: String = match (p) { Param(n, t, d) => n }
                        defaults.push(dval)
                        param_names.push(pname)
                        pi = pi + 1
                    }
                    this.func_defaults.set(emit_name, defaults)
                    this.func_param_count.set(emit_name, params.length())
                    this.func_param_names.set(emit_name, param_names)
                    this.gen_function(name, params_str, ret_type, body)
                } else if (doc.starts_with("@extern:")) {
                    var c_sig: String = doc.slice(8, doc.length())
                    var emit_name: String = this.current_prefix + name
                    this.known_functions.push(emit_name)
                    this.func_ret_types.set(emit_name, this.str_to_type(ret_type))
                    this.extern_sigs.set(emit_name, c_sig)
                } else if (doc.starts_with("@extend:")) {
                    var ext_class: String = doc.slice(8, doc.length())
                    this.gen_extend_method(ext_class, name, params, ret_type, body)
                } else if (saved_extend.length() > 0) {
                    // Fallback: doc field was unreadable for cross-module FunDecl
                    // but pre-scan identified this as an extension method
                    this.gen_extend_method(saved_extend, name, params, ret_type, body)
                } else {
                    var params_str: String = this.params_to_string(params)
                    // Register default values for optional params
                    var emit_name: String = this.current_prefix + name
                    var defaults: List<AST.Expr> = []
                    var param_names: List<String> = []
                    var pi: Float = 0
                    while (pi < params.length()) {
                        var p: AST.Param = params[pi]
                        var dval: AST.Expr = match (p) { Param(n, t, d) => d }
                        var pname: String = match (p) { Param(n, t, d) => n }
                        defaults.push(dval)
                        param_names.push(pname)
                        pi = pi + 1
                    }
                    this.func_defaults.set(emit_name, defaults)
                    this.func_param_count.set(emit_name, params.length())
                    this.func_param_names.set(emit_name, param_names)
                    this.gen_function(name, params_str, ret_type, body)
                }
            }
            EnumDecl(name, variants, doc) => {
                this.gen_enum_decl(name, variants)
            }
            ClassDecl(name, parent, fields, methods, doc) => {
                this.gen_class_decl_with_parent(name, parent, fields, methods)
            }
        }
    }

    fun get_var_name(stmt: AST.Stmt): String {
        return match (stmt) { VarDecl(n, t, i, d) => n
            _ => ""
        }
    }

    fun get_var_type(stmt: AST.Stmt): String {
        return match (stmt) { VarDecl(n, t, i, d) => t
            _ => ""
        }
    }

    fun get_var_init(stmt: AST.Stmt): AST.Expr {
        return match (stmt) { VarDecl(n, t, i, d) => i
            _ => ""
        }
    }

    fun get_var_doc(stmt: AST.Stmt): String {
        return match (stmt) { VarDecl(n, t, i, d) => d
            _ => ""
        }
    }

    fun get_fun_doc(stmt: AST.Stmt): String {
        return match (stmt) { FunDecl(n, p, r, b, d) => d
            _ => ""
        }
    }

    fun gen_var_decl(stmt: AST.Stmt) {
        var name: String = this.get_var_name(stmt)
        this.gen_var_decl_with_name(name, this.get_var_type(stmt), this.get_var_init(stmt))
    }

    fun gen_var_decl_with_name(name: String, type_ann: String, init: AST.Expr) {
        var vtype: String = type_ann
        if (vtype == "Any") {
            vtype = this.get_expr_type(init)
        }
        var val: String = this.gen_arg_value(init)
        // After gen_arg_value, last_type reflects the actual compiled expression type.
        // Always use last_type when type_ann was "Any" (inference), since get_expr_type
        // may fail for complex expressions involving variables not yet in typed_vars.
        if (type_ann == "Any") {
            var post_type: String = this.type_to_string(this.last_type)
            if (post_type != "Any") {
                vtype = post_type
            }
        }
        // Resolve generic type parameters from lambda argument return types.
        // e.g. var x = computed(fun (): String => ...) infers Computed<String> not Computed<T>
        if (vtype.contains("<") and vtype.contains(">")) {
            var gt_start: Float = vtype.index_of("<")
            var gt_inner: String = vtype.slice(gt_start + 1, vtype.length() - 1)
            // Only resolve if the generic arg is a single-letter type param (T, E, K, V)
            if (gt_inner.length() <= 2 and gt_inner.length() > 0 and gt_inner == gt_inner.to_upper()) {
                // Try to infer from init expression's lambda return type
                var inferred: String = this.infer_generic_from_init(init)
                if (inferred.length() > 0 and inferred != "Any" and inferred != "Int") {
                    var gt_base: String = vtype.slice(0, gt_start)
                    vtype = gt_base + "<" + inferred + ">"
                }
            }
        }
        this.typed_vars.set(name, this.str_to_type(vtype))
        if (vtype == "String") {
            this.string_vars.push(name)
        }
        var var_ref: String = "%" + this.sanitize_name(name)
        if (this.module_globals.has(this.current_prefix + name)) {
            var_ref = "@__g_" + this.current_prefix + this.sanitize_name(name)
            this.global_var_types.set(name, vtype)
            this.global_var_types.set(this.current_prefix + name, vtype)
        } else if (this.module_globals.has(name)) {
            var_ref = "@__g_" + this.sanitize_name(name)
            this.global_var_types.set(name, vtype)
        }
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_store(val, "i64", var_ref))
            // LLVM lib parallel path: associate the variable's alloca with the stored Value
            if (!this.identity_mode and this.llvm_values.has(val)) {
                this.llvm_values.set(var_ref, this.llvm_values.get(val))
            }
        } else {
            this.emit_indent("store i64 " + val + ", i64* " + var_ref)
            this.verify_store(val, "i64", var_ref)
        }
    }

    fun infer_generic_from_init(init: AST.Expr): String {
        // If init is a Call(callee, args), try to infer generic type from args:
        // 1. Lambda args with explicit return type
        // 2. String literal args → String
        // 3. Number literal args → Float
        // 4. Typed variable args → that variable's type
        var ek: String = this.classify_expr(init)
        if (ek == "call") {
            var call_args: List<AST.Expr> = match (init) { Call(c, a) => a   _ => [] }
            var ai: Float = 0
            while (ai < call_args.length()) {
                var arg_kind: String = this.classify_expr(call_args[ai])
                if (arg_kind == "lambda") {
                    var lam_ret: String = match (call_args[ai]) { Lambda(p, r, b) => r   _ => "" }
                    if (lam_ret.length() > 0 and lam_ret != "Int" and lam_ret != "Any") {
                        return lam_ret
                    }
                }
                if (arg_kind == "string") {
                    return "String"
                }
                if (arg_kind == "number") {
                    return "Float"
                }
                if (arg_kind == "bool") {
                    return "Bool"
                }
                if (arg_kind == "ident") {
                    var arg_type: String = this.get_expr_type(call_args[ai])
                    if (arg_type.length() > 0 and arg_type != "Any" and arg_type != "Int") {
                        return arg_type
                    }
                }
                ai = ai + 1
            }
        }
        return ""
    }

    fun gen_return(stmt: AST.Stmt) {
        var value: AST.Expr = match (stmt) { Return(v) => v
            _ => AST.Expr.NilLit
        }
        if (this.is_coroutine) {
            var val: String = this.gen_arg_value(value)
            this.emit_indent("store i64 " + val + ", i64* @__task_result")
            this.emit_terminator("br label %__coro_final")
        } else if (this.current_ret_type == "void") {
            // Pop GC roots before returning
            if (this.gc_root_count > 0) {
                this.emit_indent("call void @__gc_pop_roots(i64 " + this.gc_root_count.floor().to_string() + ")")
            }
            this.emit_terminator("ret void")
        } else {
            var val: String = this.gen_arg_value(value)
            // Pop GC roots before returning
            if (this.gc_root_count > 0) {
                this.emit_indent("call void @__gc_pop_roots(i64 " + this.gc_root_count.floor().to_string() + ")")
            }
            this.emit_terminator("ret i64 " + val)
            // LLVM lib parallel path: ret
            // NOTE: Cannot call bb.ret(val_v) directly — it writes to
            // block.terminator_str and block.is_terminated through nested
            // cross-module field access, which triggers a gen2 segfault.
            // Workaround: call ret_set() which delegates to block.set_terminator_text()
            // (method dispatch works), avoiding direct field assignment.
            if (!this.identity_mode and this.use_llvm_lib and this.llvm_values.has(val)) {
                var ret_val_v: Any = this.llvm_values.get(val)
                this.llvm_block_builder.ret_set(ret_val_v)
            }
        }
    }

    fun gen_class_decl_with_parent(name: String, parent: String, fields: List<AST.Param>, methods: List<AST.Stmt>) {
        // Convert fields to string format for internal use
        var fields_str: String = this.params_to_string(fields)
        // Inherit parent fields (prepend parent fields before child's own)
        var all_fields: String = fields_str
        if (parent.length() > 0 and this.class_fields.has(parent)) {
            var parent_fields: String = this.class_fields.get(parent)
            if (parent_fields.length() > 0) {
                if (all_fields.length() > 0) {
                    all_fields = parent_fields + "," + all_fields
                } else {
                    all_fields = parent_fields
                }
            }
        }
        // For actors, prepend hidden fields: __actor_busy (Int), __actor_queue (Int)
        if (this.actor_classes.has(name)) {
            if (all_fields.length() > 0) {
                all_fields = "__actor_busy:Int,__actor_queue:Int," + all_fields
            } else {
                all_fields = "__actor_busy:Int,__actor_queue:Int"
            }
        }
        // Generate the class with inherited fields
        this.current_parent = parent
        this.gen_class_decl(name, all_fields, methods)
        this.current_parent = ""
        // Register inherited methods: if child doesn't define a method, map it to parent's
        if (parent.length() > 0 and this.class_methods.has(parent)) {
            var parent_methods: List = this.class_methods.get(parent)
            var child_methods: List = this.class_methods.get(name)
            var i: Int = 0
            while (i < parent_methods.length()) {
                var mname: String = parent_methods[i]
                if (!this.str_in_list(child_methods,mname) and mname != "init") {
                    // Register parent method as callable on child
                    child_methods.push(mname)
                    // Map ChildClass__method to ParentClass__method
                    var child_full: String = name + "__" + mname
                    var parent_full: String = parent + "__" + mname
                    if (this.func_ret_types.has(parent_full)) {
                        this.func_ret_types.set(child_full, this.func_ret_types.get(parent_full))
                    } else {
                        this.func_ret_types.set(child_full, this.str_to_type("Int"))
                    }
                    this.known_functions.push(child_full)
                    // Emit a thin forwarder with proper parameter forwarding
                    var fwd_params_def: String = "i64 %self"
                    var fwd_params_call: String = "i64 %self"
                    var arity_key: String = this.current_prefix + parent_full
                    if (this.called_function_arity.has(arity_key)) {
                        var arity: Float = this.called_function_arity.get(arity_key)
                        var pi2: Float = 1
                        while (pi2 < arity) {
                            fwd_params_def = fwd_params_def + ", i64 %p" + pi2.floor().to_string()
                            fwd_params_call = fwd_params_call + ", i64 %p" + pi2.floor().to_string()
                            pi2 = pi2 + 1
                        }
                    }
                    this.emit("")
                    this.emit("define i64 @" + child_full + "(" + fwd_params_def + ") {")
                    this.emit("entry:")
                    this.emit("  %r = call i64 @" + parent_full + "(" + fwd_params_call + ")")
                    this.emit("  ret i64 %r")
                    this.emit("}")
                }
                i = i + 1
            }
            // Interface conformance: if parent has no fields, check all methods are implemented
            var parent_fields_str: String = this.class_fields.get(parent)
            if (parent_fields_str.length() == 0) {
                // This is an interface — check conformance
                var pi: Int = 0
                while (pi < parent_methods.length()) {
                    var required: String = parent_methods[pi]
                    if (required != "init" and !this.str_in_list(child_methods,required)) {
                        IO.println("Error: class " + name + " does not implement " + parent + "." + required + "()")
                    }
                    pi = pi + 1
                }
            }
        }
    }

    fun gen_class_decl(name: String, fields: String, methods: List<AST.Stmt>) {
        // Use module-prefixed type name to avoid cross-module class name collisions
        var type_name: String = name
        if (this.current_prefix.length() > 0) {
            type_name = this.current_prefix + name
        }
        this.class_fields.set(name, fields)
        this.class_struct_names.set(name, type_name)
        if (this.current_prefix.length() > 0) {
            this.class_fields.set(type_name, fields)
            this.class_struct_names.set(type_name, type_name)
        }

        // Parse field names for struct layout
        var field_list: List<String> = []
        var field_entries: List<String> = []
        var i: Float = 0
        if (fields.length() > 0) {
            var parts: List<String> = this.split_respecting_generics(fields, ",")
            while (i < parts.length()) {
                var fp: List<String> = parts[i].split(":")
                field_list.push(fp[0])
                field_entries.push(parts[i])
                i = i + 1
            }
        }
        // Store structured field list (each entry is "name:type")
        this.class_field_list.set(name, field_entries)
        if (this.current_prefix.length() > 0) {
            this.class_field_list.set(type_name, field_entries)
        }

        // Emit struct type: { i64 field0, i64 field1, ... }
        var num_fields: Float = field_list.length()
        if (!this.register_only and !this.str_in_list(this.known_functions,"__type_" + type_name)) {
            this.known_functions.push("__type_" + type_name)
            var field_types_str: String = ""
            var fi: Float = 0
            while (fi < num_fields) {
                if (fi > 0) { field_types_str = field_types_str + ", " }
                field_types_str = field_types_str + "i64"
                fi = fi + 1
            }
            this.type_defs.append("%" + type_name + " = type { " + field_types_str + " }\n")
        }

        // Register method names
        var method_names: List<String> = []
        i = 0
        while (i < methods.length()) {
            method_names.push(this.get_fun_name(methods[i]))
            i = i + 1
        }
        this.class_methods.set(name, method_names)

        // Pre-register all method return types so forward references resolve correctly
        i = 0
        while (i < methods.length()) {
            var mname: String = this.get_fun_name(methods[i])
            var mret: String = this.get_fun_ret(methods[i])
            var full_name: String = name + "__" + mname
            var prefixed_full: String = this.current_prefix + full_name
            this.func_ret_types.set(prefixed_full, this.str_to_type(mret))
            this.func_ret_types.set(full_name, this.str_to_type(mret))
            this.known_functions.push(prefixed_full)
            this.known_functions.push(full_name)
            this.func_prefix_map.set(full_name, prefixed_full)
            i = i + 1
        }

        // Pre-register constructor so methods can call ClassName(args)
        this.known_functions.push(type_name)
        if (this.current_prefix.length() > 0) {
            this.known_functions.push(name)
        }
        this.func_ret_types.set(type_name, this.str_to_type(name))
        this.func_ret_types.set(name, this.str_to_type(name))

        // Generate methods as functions with name prefix: ClassName__method
        // Methods get 'self' (i64 pointer to instance) as first param
        this.current_class = type_name
        i = 0
        while (i < methods.length()) {
            this.gen_class_method(name, methods[i])
            i = i + 1
        }

        // Generate constructor function: ClassName(args...) -> instance ptr
        this.gen_class_constructor(type_name, fields, field_list)
    }

    fun get_fun_name(stmt: AST.Stmt): String {
        return match (stmt) { FunDecl(n, p, r, b, d) => n
            _ => ""
        }
    }

    fun get_fun_params(stmt: AST.Stmt): List<AST.Param> {
        return match (stmt) { FunDecl(n, p, r, b, d) => p
            _ => []
        }
    }

    fun get_fun_ret(stmt: AST.Stmt): String {
        return match (stmt) { FunDecl(n, p, r, b, d) => r
            _ => ""
        }
    }

    fun get_fun_body(stmt: AST.Stmt): List<AST.Stmt> {
        return match (stmt) { FunDecl(n, p, r, b, d) => b
            _ => ""
        }
    }

    fun gen_class_method(class_name: String, method: AST.Stmt) {
        var mname: String = this.get_fun_name(method)
        var mparams: List<AST.Param> = this.get_fun_params(method)
        var mret: String = this.get_fun_ret(method)
        var mbody: List<AST.Stmt> = this.get_fun_body(method)
        var mdoc: String = this.get_fun_doc(method)
        var full_name: String = class_name + "__" + mname
        // Mark method for alwaysinline if annotated with @inline
        if (mdoc.starts_with("@inline")) {
            var inline_emit: String = this.current_prefix + full_name
            this.inline_funcs.push(inline_emit)
            this.inline_funcs.push(full_name)
        }
        var mparams_str: String = this.params_to_string(mparams)
        var full_params: String = "self:Int"
        if (mparams_str.length() > 0) {
            full_params = full_params + "," + mparams_str
        }
        var param_count: Float = 1
        if (mparams_str.length() > 0) {
            param_count = this.split_respecting_generics(mparams_str, ",").length() + 1
        }
        this.called_function_arity.set(full_name, param_count)
        if (this.current_prefix.length() > 0) {
            this.called_function_arity.set(this.current_prefix + full_name, param_count)
        }
        // Register param names for named arg dispatch (self + method params)
        var method_param_names: List<String> = []
        method_param_names.push("self")
        var mpi: Float = 0
        while (mpi < mparams.length()) {
            var mp: AST.Param = mparams[mpi]
            var mpn: String = match (mp) { Param(n, t, d) => n }
            method_param_names.push(mpn)
            mpi = mpi + 1
        }
        this.func_param_names.set(full_name, method_param_names)
        if (this.current_prefix.length() > 0) {
            this.func_param_names.set(this.current_prefix + full_name, method_param_names)
        }
        // Register defaults for class methods
        var method_defaults: List<AST.Expr> = []
        method_defaults.push(AST.Expr.NilLit)
        mpi = 0
        while (mpi < mparams.length()) {
            var mp: AST.Param = mparams[mpi]
            var mdval: AST.Expr = match (mp) { Param(n, t, d) => d }
            method_defaults.push(mdval)
            mpi = mpi + 1
        }
        this.func_defaults.set(full_name, method_defaults)
        if (this.current_prefix.length() > 0) {
            this.func_defaults.set(this.current_prefix + full_name, method_defaults)
        }
        this.func_param_count.set(full_name, param_count)
        if (this.current_prefix.length() > 0) {
            this.func_param_count.set(this.current_prefix + full_name, param_count)
        }
        this.gen_function(full_name, full_params, mret, mbody)
    }

    fun gen_class_constructor(type_name: String, fields: String, field_list: List<String>) {
        var num_fields: Float = field_list.length()
        var struct_size: Float = num_fields * 8
        this.known_functions.push(type_name)
        this.func_ret_types.set(type_name, this.str_to_type(type_name))
        // Assign a unique type ID for reflection (tags >= 10 are per-class)
        if (!this.class_type_ids.has(type_name)) {
            this.class_type_ids.set(type_name, this.next_class_type_id)
            this.next_class_type_id = this.next_class_type_id + 1
        }
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,type_name)) { return }
        this.defined_funcs.push(type_name)
        this.emit("")
        var ctor_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            ctor_linkage = "define"
        }
        this.emit(ctor_linkage + " i64 @" + type_name + "() {")
        this.emit("entry:")
        this.block_terminated = false
        // Allocate instance on GC-tracked heap with per-class type tag
        var class_tag: Float = this.class_type_ids.get(type_name)
        var raw: String = this.fresh_local()
        if (this.identity_mode) {
            this.emit_indent(raw + " = call i8* @malloc(i64 " + struct_size.floor().to_string() + ")")
        } else {
            this.emit_indent(raw + " = call i64 @__gc_alloc(i64 " + struct_size.floor().to_string() + ", i64 " + class_tag.floor().to_string() + ")")
        }
        var ptr: String = ""
        if (this.identity_mode) {
            ptr = this.fresh_local()
            this.emit_indent(ptr + " = bitcast i8* " + raw + " to %" + type_name + "*")
        } else {
            ptr = this.fresh_local()
            this.emit_indent(ptr + " = inttoptr i64 " + raw + " to %" + type_name + "*")
        }
        // Zero-initialize fields
        var i: Float = 0
        while (i < num_fields) {
            var field_ptr: String = this.fresh_local()
            this.emit_indent(field_ptr + " = getelementptr %" + type_name + ", %" + type_name + "* " + ptr + ", i32 0, i32 " + i.floor().to_string())
            this.emit_indent("store i64 0, i64* " + field_ptr)
            i = i + 1
        }
        // Return as i64
        var result: String = this.typed_ptr_to_val(ptr, "%" + type_name + "*")
        this.emit_terminator("ret i64 " + result)
        this.emit("}")
        this.block_terminated = false
    }

    fun get_variant_name(v: AST.Variant): String {
        return match (v) { Variant(n, f) => n
            _ => ""
        }
    }

    fun get_variant_fields(v: AST.Variant): String {
        return match (v) { Variant(n, f) => f
            _ => ""
        }
    }

    fun register_variant(name: String, variant_names: List<String>, v: AST.Variant, idx: Float) {
        var vname: String = this.get_variant_name(v)
        var vfields: String = this.get_variant_fields(v)
        variant_names.push(vname)
        this.enum_variant_tags.set(name + "." + vname, idx)
        this.enum_variant_fields.set(name + "." + vname, vfields)
    }

    fun gen_enum_decl(name: String, variants: List<AST.Variant>) {
        var variant_names: List<String> = []
        var i: Float = 0
        while (i < variants.length()) {
            this.register_variant(name, variant_names, variants[i], i)
            i = i + 1
        }
        this.enum_defs.set(name, variant_names)
        if (!this.register_only and !this.str_in_list(this.known_functions,"__type_" + name)) {
            this.known_functions.push("__type_" + name)
            this.type_defs.append("%" + name + " = type { i8, [16 x i8] }\n")
        }

        // Emit constructor functions for variants with fields
        var max_fields: Float = this.get_max_fields(name)
        i = 0
        while (i < variants.length()) {
            var v: AST.Variant = variants[i]
            var vname: String = match (v) { Variant(n, f) => n
                _ => ""
            }
            var vfields: String = match (v) { Variant(n, f) => f
                _ => ""
            }
            if (vfields.length() > 0) {
                this.emit_enum_constructor(vname, i, vfields, max_fields)
            }
            i = i + 1
        }

        // Emit to_string function for this enum
        this.emit_enum_to_string(name, variants)
    }

    fun emit_enum_to_string(name: String, variants: List<AST.Variant>) {
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,name + "__to_string")) { return }
        this.defined_funcs.push(name + "__to_string")
        var max_fields: Float = this.get_max_fields(name)
        var func_name: String = name + "__to_string"

        this.emit("")
        var ts_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            ts_linkage = "define"
        }
        this.emit(ts_linkage + " i64 @" + func_name + "(i64 %self) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()

        // Extract tag based on encoding
        var tag_val: String = ""
        if (max_fields <= 1) {
            tag_val = this.fresh_local()
            this.emit_indent(tag_val + " = lshr i64 %self, 56")
        } else {
            var arr_ptr: String = this.val_to_typed_ptr("%self", "i64*")
            tag_val = this.fresh_local()
            this.emit_indent(tag_val + " = load i64, i64* " + arr_ptr)
        }

        // Build switch on tag
        var end_label: String = this.fresh_label("ets.end")
        var arm_labels: List<String> = []
        var i: Float = 0
        while (i < variants.length()) {
            arm_labels.push(this.fresh_label("ets.v"))
            i = i + 1
        }

        var switch_cases: String = ""
        i = 0
        while (i < variants.length()) {
            switch_cases = switch_cases + " i64 " + i.floor().to_string() + ", label %" + arm_labels[i]
            i = i + 1
        }
        this.emit_indent("switch i64 " + tag_val + ", label %" + end_label + " [" + switch_cases + " ]")
        this.block_terminated = true

        // Emit each variant arm
        i = 0
        while (i < variants.length()) {
            var v: AST.Variant = variants[i]
            var vname: String = this.get_variant_name(v)
            var vfields: String = this.get_variant_fields(v)

            this.start_block(arm_labels[i])

            if (vfields.length() == 0) {
                // No fields: just return "VariantName"
                var const_name: String = this.add_string_constant(vname)
                var str_len: Float = vname.length() + 1
                var gep: String = this.fresh_local()
                this.emit_indent(gep + " = getelementptr [" + str_len.to_string() + " x i8], [" + str_len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
                var as_i64: String = this.ptr_to_val(gep)
                this.emit_terminator("ret i64 " + as_i64)
            } else {
                // Has fields: build "VariantName(field0, field1, ...)"
                var parts: List<String> = this.split_respecting_generics(vfields, ",")
                var num_fields: Float = parts.length()

                // Allocate StringBuilder via malloc + manual concat
                // Start with "VariantName("
                var prefix_str: String = vname + "("
                var prefix_const: String = this.add_string_constant(prefix_str)
                var prefix_len: Float = prefix_str.length() + 1
                var prefix_gep: String = this.fresh_local()
                this.emit_indent(prefix_gep + " = getelementptr [" + prefix_len.to_string() + " x i8], [" + prefix_len.to_string() + " x i8]* " + prefix_const + ", i64 0, i64 0")
                var prefix_i64: String = this.ptr_to_val(prefix_gep)

                // Create a StringBuilder, append prefix
                var sb: String = this.fresh_local()
                this.emit_indent(sb + " = call i64 @StringBuilder()")
                this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + prefix_i64 + ")")

                // For each field, extract, convert to string, append
                var fi: Float = 0
                while (fi < num_fields) {
                    // Extract field value
                    var field_val: String = ""
                    if (max_fields <= 1) {
                        // Simple encoding: value = self & 0x00FFFFFFFFFFFFFF
                        field_val = this.fresh_local()
                        this.emit_indent(field_val + " = and i64 %self, 72057594037927935")
                    } else {
                        // Array encoding: fields start at index 1
                        var num_slots: Float = num_fields + 1
                        var total_str: String = num_slots.floor().to_string()
                        var f_arr: String = this.val_to_typed_ptr("%self", "[" + total_str + " x i64]*")
                        var field_idx: Float = fi + 1
                        var f_slot: String = this.fresh_local()
                        this.emit_indent(f_slot + " = getelementptr [" + total_str + " x i64], [" + total_str + " x i64]* " + f_arr + ", i64 0, i64 " + field_idx.floor().to_string())
                        field_val = this.fresh_local()
                        this.emit_indent(field_val + " = load i64, i64* " + f_slot)
                    }

                    // Determine field type and convert to string
                    var field_part: String = parts[fi]
                    var field_type: String = "Int"
                    if (field_part.contains(":")) {
                        var ft_parts: List<String> = field_part.split(":")
                        if (ft_parts.length() > 1) {
                            field_type = ft_parts[1]
                        }
                    }

                    var field_str: String = ""
                    if (field_type == "String") {
                        field_str = field_val
                    } else if (field_type == "Bool") {
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__bool_to_string(i64 " + field_val + ")")
                    } else {
                        var field_raw: String = this.emit_untag_int(field_val)
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__int_to_string(i64 " + field_raw + ")")
                    }

                    this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + field_str + ")")

                    // Append ", " between fields
                    if (fi < num_fields - 1) {
                        var comma_const: String = this.add_string_constant(", ")
                        var comma_len: Float = 3
                        var comma_gep: String = this.fresh_local()
                        this.emit_indent(comma_gep + " = getelementptr [" + comma_len.to_string() + " x i8], [" + comma_len.to_string() + " x i8]* " + comma_const + ", i64 0, i64 0")
                        var comma_i64: String = this.ptr_to_val(comma_gep)
                        this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + comma_i64 + ")")
                    }

                    fi = fi + 1
                }

                // Append closing ")"
                var close_const: String = this.add_string_constant(")")
                var close_len: Float = 2
                var close_gep: String = this.fresh_local()
                this.emit_indent(close_gep + " = getelementptr [" + close_len.to_string() + " x i8], [" + close_len.to_string() + " x i8]* " + close_const + ", i64 0, i64 0")
                var close_i64: String = this.ptr_to_val(close_gep)
                this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + close_i64 + ")")

                // Finalize
                var result: String = this.fresh_local()
                this.emit_indent(result + " = call i64 @__sb_to_string(i64 " + sb + ")")
                this.emit_terminator("ret i64 " + result)
            }

            i = i + 1
        }

        // Default case (unreachable but needed)
        this.start_block(end_label)
        var empty_const: String = this.add_string_constant("Unknown")
        var empty_len: Float = 8
        var empty_gep: String = this.fresh_local()
        this.emit_indent(empty_gep + " = getelementptr [" + empty_len.to_string() + " x i8], [" + empty_len.to_string() + " x i8]* " + empty_const + ", i64 0, i64 0")
        var empty_i64: String = this.ptr_to_val(empty_gep)
        this.emit_terminator("ret i64 " + empty_i64)

        this.emit("}")
        this.block_terminated = false
        this.known_functions.push(func_name)
        this.func_ret_types.set(func_name, this.str_to_type("String"))
    }

    fun emit_enum_constructor(vname: String, tag: Float, fields_str: String, max_fields: Float) {
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,vname)) { return }
        this.defined_funcs.push(vname)
        var parts: List<String> = this.split_respecting_generics(fields_str, ",")
        var num_fields: Float = parts.length()

        // Build param list: (i64 %f0, i64 %f1, ...)
        var params: String = ""
        var pi: Float = 0
        while (pi < num_fields) {
            if (pi > 0) { params = params + ", " }
            params = params + "i64 %f" + pi.floor().to_string()
            pi = pi + 1
        }

        this.emit("")
        var ev_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            ev_linkage = "define"
        }
        this.emit(ev_linkage + " i64 @" + vname + "(" + params + ") {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()

        if (max_fields <= 1) {
            // Simple encoding: (tag << 56) | value
            var t: String = this.fresh_local()
            this.emit_indent(t + " = shl i64 " + tag.floor().to_string() + ", 56")
            var r: String = this.fresh_local()
            this.emit_indent(r + " = or i64 " + t + ", %f0")
            this.emit_terminator("ret i64 " + r)
        } else {
            // Array encoding: malloc [tag, f0, f1, ...]
            var num_slots: Float = num_fields + 1
            var arr_bytes: Float = num_slots * 8
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = call i8* @malloc(i64 " + arr_bytes.floor().to_string() + ")")
            var arr: String = this.fresh_local()
            this.emit_indent(arr + " = bitcast i8* " + raw + " to [" + num_slots.floor().to_string() + " x i64]*")
            // Store tag
            var ts: String = this.fresh_local()
            this.emit_indent(ts + " = getelementptr [" + num_slots.floor().to_string() + " x i64], [" + num_slots.floor().to_string() + " x i64]* " + arr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + ts)
            // Store fields
            var fi: Float = 0
            while (fi < num_fields) {
                var slot: String = this.fresh_local()
                var slot_idx: Float = fi + 1
                this.emit_indent(slot + " = getelementptr [" + num_slots.floor().to_string() + " x i64], [" + num_slots.floor().to_string() + " x i64]* " + arr + ", i64 0, i64 " + slot_idx.floor().to_string())
                this.emit_indent("store i64 %f" + fi.floor().to_string() + ", i64* " + slot)
                fi = fi + 1
            }
            var result: String = this.typed_ptr_to_val(arr, "[" + num_slots.floor().to_string() + " x i64]*")
            this.emit_terminator("ret i64 " + result)
        }

        this.emit("}")
        this.block_terminated = false
        this.known_functions.push(vname)
    }

    fun get_enum_decl_name(stmt: AST.Stmt): String {
        return match (stmt) { EnumDecl(n, v, d) => n
            _ => ""
        }
    }

    fun get_enum_decl_variants(stmt: AST.Stmt): List<AST.Variant> {
        return match (stmt) { EnumDecl(n, v, d) => v
            _ => ""
        }
    }

    fun register_external_enums(decls: List<AST.Stmt>) {
        var i: Float = 0
        while (i < decls.length()) {
            this.try_register_enum(decls[i])
            i = i + 1
        }
    }

    fun try_register_enum(decl: AST.Stmt) {
        match (decl) {
            EnumDecl(name, variants, doc) => {
                this.register_enum_variants(name, variants)
            }
            VarDecl(n, t, i, d) => {}
            FunDecl(n, p, r, b, d) => {}
            ClassDecl(n, p, f, m, d) => {}
            If(c, t, e) => {}
            While(c, b) => {}
            Block(s) => {}
            ExprStmt(e) => {}
            Return(v) => {}
            Break => {}
            Continue => {}
            TryCatch(t, n, c, f) => {}
            Throw(v) => {}
            LetPattern(p, v) => {}
        }
    }

    fun register_enum_variants(name: String, variants: List<AST.Variant>) {
        var variant_names: List<String> = []
        var j: Float = 0
        while (j < variants.length()) {
            this.register_variant(name, variant_names, variants[j], j)
            j = j + 1
        }
        this.enum_defs.set(name, variant_names)
    }

    fun emit_block_alloca_for(stmt: AST.Stmt) {
        var vname: String = match (stmt) { VarDecl(n, t, init, d) => n
            _ => ""
        }
        var vdoc: String = match (stmt) { VarDecl(n, t, init, d) => d
            _ => ""
        }
        if (vdoc.starts_with("@import:")) { return }
        if (!this.typed_vars.has(vname) and !this.str_in_list(this.known_functions,"__alloc_" + vname)) {
            this.known_functions.push("__alloc_" + vname)
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_alloca("%" + this.sanitize_name(vname), "i64"))
            } else {
                this.emit_indent("%" + this.sanitize_name(vname) + " = alloca i64")
                this.verify_alloca("%" + this.sanitize_name(vname), "i64")
            }
        }
    }

    fun emit_block_allocas(stmts: List<AST.Stmt>) {
        var i: Float = 0
        while (i < stmts.length()) {
            var kind: String = this.classify_stmt(stmts[i])
            if (kind == "var") {
                this.emit_block_alloca_for(stmts[i])
            }
            i = i + 1
        }
    }

    fun gen_stmts(stmts: List<AST.Stmt>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.gen_stmt(stmts[i])
            i = i + 1
        }
    }

    fun to_i1(val: String): String {
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_trunc(local, val, "i64", "i1"))
            // LLVM lib parallel path: track trunc value
            if (!this.identity_mode and this.llvm_values.has(val)) {
                var val_v: Any = this.llvm_values.get(val)
                var tr_v: Any = this.llvm_block_builder.trunc(val_v, LLVMTypes.Type.I1)
                this.llvm_values.set(local, tr_v)
            }
        } else {
            this.emit_indent(local + " = trunc i64 " + val + " to i1")
            this.verify_trunc(local, val, "i64", "i1")
        }
        return local
    }

    fun gen_if(cond: AST.Expr, then_branch: List<AST.Stmt>, else_branch: List<AST.Stmt>) {
        var end_label: String = this.fresh_label("endif")
        var current_cond: AST.Expr = cond
        var current_then: List<AST.Stmt> = then_branch
        var current_else: List<AST.Stmt> = else_branch

        // LLVM lib parallel path: create end block upfront
        var llvm_end_bb: Any = nil
        if (!this.identity_mode and this.use_llvm_lib) {
            llvm_end_bb = this.llvm_func_builder.new_block(end_label)
        }

        // Iterative else-if chain to avoid deep C stack recursion
        while (true) {
            var cond_val: String = this.to_i1(this.gen_arg_value(current_cond))
            var then_label: String = this.fresh_label("then")
            var else_label: String = this.fresh_label("else")

            if (this.use_llvm_lib) {
                this.emit_terminator(this.lib_cond_br(cond_val, then_label, else_label))
                // LLVM lib parallel path: emit conditional branch and switch to then block
                if (!this.identity_mode and this.llvm_values.has(cond_val)) {
                    var cond_v: Any = this.llvm_values.get(cond_val)
                    this.llvm_block_builder.cond_br_labels_set(cond_v, then_label, else_label)
                    var llvm_then_bb: Any = this.llvm_func_builder.new_block(then_label)
                    this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_then_bb)
                    this.llvm_block_builder.init(this.llvm_func_builder, llvm_then_bb)
                }
            } else {
                this.emit_terminator("br i1 " + cond_val + ", label %" + then_label + ", label %" + else_label)
                this.verify_cond_br(cond_val, then_label, else_label)
            }

            this.start_block(then_label)
            this.gen_stmts(current_then)
            if (this.use_llvm_lib) {
                this.emit_terminator(this.lib_br(end_label))
                // LLVM lib parallel path: terminate then block, switch to else block
                if (!this.identity_mode) {
                    this.llvm_block_builder.br_label_set(end_label)
                    var llvm_else_bb: Any = this.llvm_func_builder.new_block(else_label)
                    this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_else_bb)
                    this.llvm_block_builder.init(this.llvm_func_builder, llvm_else_bb)
                }
            } else {
                this.emit_terminator("br label %" + end_label)
                this.verify_br(end_label)
            }

            this.start_block(else_label)

            // Check if else is a single If (else-if chain)
            var is_elseif: Bool = false
            if (current_else.length() == 1) {
                if (this.classify_stmt(current_else[0]) == "if") {
                    is_elseif = true
                }
            }
            if (is_elseif) {
                var nested: Any = current_else[0]
                current_cond = match (nested) { If(c, t, e) => c }
                current_then = match (nested) { If(c, t, e) => t }
                current_else = match (nested) { If(c, t, e) => e }
                // Continue loop instead of recursing
            } else {
                // Final else or no else
                if (current_else.length() > 0) {
                    this.gen_stmts(current_else)
                }
                this.emit_terminator("br label %" + end_label)
                // LLVM lib parallel path: terminate else block, switch to end block
                if (!this.identity_mode and this.use_llvm_lib) {
                    this.llvm_block_builder.br_label_set(end_label)
                    this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_end_bb)
                    this.llvm_block_builder.init(this.llvm_func_builder, llvm_end_bb)
                }
                break
            }
        }

        this.start_block(end_label)
    }

        fun classify_stmt(stmt: AST.Stmt): String {
        return match (stmt) {
            If(c, t, e) => "if"
            ExprStmt(expr) => "expr"
            VarDecl(n, t, i, d) => "var"
            FunDecl(n, p, r, b, d) => "fun"
            EnumDecl(n, v, d) => "enum"
            ClassDecl(n, p, f, m, d) => "class"
            Return(v) => "return"
            While(c, b) => "while"
            Block(s) => "block"
            Break => "break"
            Continue => "continue"
            TryCatch(t, n, c, f) => "try"
            Throw(v) => "throw"
            LetPattern(p, v) => "let_pattern"
        }
    }

    fun is_if_stmt(stmt: AST.Stmt): Bool {
        var kind: Any = match (stmt) {
            If(c, t, e) => "if"
            ExprStmt(expr) => "other"
            VarDecl(n, t, i, d) => "other"
            FunDecl(n, p, r, b, d) => "other"
            EnumDecl(n, v, d) => "other"
            ClassDecl(n, p, f, m, d) => "other"
            Return(v) => "other"
            While(c, b) => "other"
            Block(s) => "other"
            Break => "other"
            Continue => "other"
            TryCatch(t, n, c, f) => "other"
            Throw(v) => "other"
            LetPattern(p, v) => "other"
        }
        return kind == "if"
    }

    fun gen_let_pattern(pattern: AST.Pattern, value: AST.Expr) {
        var variant_name: String = match (pattern) {
            VariantPattern(v, b) => v
            ArrayPattern(e, r) => "__array:" + r
            _ => ""
        }
        var bindings: List<String> = match (pattern) {
            VariantPattern(v, b) => b
            ArrayPattern(e, r) => e
            _ => []
        }
        var val: String = this.gen_arg_value(value)
        var val_type: AST.Type = this.last_type
        if (variant_name.starts_with("__array:")) {
            this.gen_let_array_pattern(bindings, variant_name, val, val_type)
            return
        }
        // For variant patterns, extract fields from the tagged value
        if (bindings.length() > 0) {
            // Determine the enum name from the variant
            var enum_name: String = this.find_enum_for_variant(variant_name)
            var max_fields: Float = 0
            if (enum_name != "Unknown") {
                max_fields = this.get_max_fields(enum_name)
            }
            // Use extract_arm_bindings which handles both encodings
            this.extract_arm_bindings(bindings, val, max_fields)
            // Set type information for each binding
            var bi: Float = 0
            while (bi < bindings.length()) {
                var btype: String = "Int"
                if (enum_name != "Unknown") {
                    btype = this.get_variant_field_type(enum_name, variant_name, bi)
                }
                this.typed_vars.set(bindings[bi], this.str_to_type(btype))
                if (btype == "String") {
                    this.string_vars.push(bindings[bi])
                }
                bi = bi + 1
            }
        }
    }

    fun gen_let_array_pattern(elements: List<String>, variant_name: String, val: String, val_type: AST.Type) {
        var rest: String = variant_name.slice(8, variant_name.length())
        // Infer element type from list type
        var elem_type_str: String = "Int"
        var list_type_str: String = this.type_to_string(val_type)
        if (list_type_str.starts_with("List<") and list_type_str.ends_with(">")) {
            elem_type_str = list_type_str.slice(5, list_type_str.length() - 1)
        }
        var elem_type: AST.Type = this.str_to_type(elem_type_str)
        var i: Float = 0
        while (i < elements.length()) {
            var elem_val: String = this.fresh_local()
            this.emit_indent(elem_val + " = call i64 @__list_get(i64 " + val + ", i64 " + i.floor().to_string() + ")")
            this.emit_indent("store i64 " + elem_val + ", i64* %" + this.sanitize_name(elements[i]))
            this.typed_vars.set(elements[i], elem_type)
            if (elem_type_str == "String") {
                this.string_vars.push(elements[i])
            }
            i = i + 1
        }
        if (rest.length() > 0) {
            var len_val: String = this.fresh_local()
            this.emit_indent(len_val + " = call i64 @__list_length(i64 " + val + ")")
            var rest_val: String = this.fresh_local()
            this.emit_indent(rest_val + " = call i64 @__list_slice(i64 " + val + ", i64 " + elements.length().floor().to_string() + ", i64 " + len_val + ")")
            this.emit_indent("store i64 " + rest_val + ", i64* %" + this.sanitize_name(rest))
            this.typed_vars.set(rest, val_type)
        }
    }

    fun gen_throw(value: AST.Expr) {
        var val: String = this.gen_arg_value(value)
        this.emit_indent("store i64 " + val + ", i64* @__exception_value")
        // Load the current jmp_buf pointer and check for null (uncaught exception)
        var jmp_ptr: String = this.fresh_local()
        this.emit_indent(jmp_ptr + " = load i8*, i8** @__jmp_buf_current")
        var is_null: String = this.fresh_local()
        this.emit_indent(is_null + " = icmp eq i8* " + jmp_ptr + ", null")
        var uncaught_label: String = this.fresh_label("uncaught")
        var do_throw_label: String = this.fresh_label("do_throw")
        this.emit_terminator("br i1 " + is_null + ", label %" + uncaught_label + ", label %" + do_throw_label)
        // Uncaught exception: convert to string, print fatal error, and exit
        this.start_block(uncaught_label)
        var msg_str: String = this.fresh_local()
        this.emit_indent(msg_str + " = call i64 @__any_to_string(i64 " + val + ")")
        this.emit_indent("call i64 @__runtime_error_fatal(i64 " + msg_str + ")")
        this.emit_indent("call void @exit(i32 1)")
        this.emit_terminator("unreachable")
        // Normal throw: longjmp to handler
        this.start_block(do_throw_label)
        this.emit_indent("call void @longjmp(i8* " + jmp_ptr + ", i32 1)")
        this.emit_terminator("unreachable")
    }

    fun gen_try_catch(try_body: List<AST.Stmt>, catch_name: String, catch_body: List<AST.Stmt>, finally_body: List<AST.Stmt>) {
        var try_label: String = this.fresh_label("try")
        var catch_label: String = this.fresh_label("catch")
        var finally_label: String = this.fresh_label("finally")
        var end_label: String = this.fresh_label("tryend")

        var has_finally: Float = finally_body.length() > 0

        // Allocate a local jmp_buf on the stack (512 bytes, enough for any platform)
        var jmp_buf: String = this.fresh_local()
        this.emit_indent(jmp_buf + " = alloca [512 x i8], align 16")
        var jmp_buf_ptr: String = this.fresh_local()
        this.emit_indent(jmp_buf_ptr + " = getelementptr [512 x i8], [512 x i8]* " + jmp_buf + ", i64 0, i64 0")

        // Save the previous jmp_buf pointer (for nested try/catch)
        var saved_jmp: String = this.fresh_local()
        this.emit_indent(saved_jmp + " = load i8*, i8** @__jmp_buf_current")
        // Set current jmp_buf to our local buffer
        this.emit_indent("store i8* " + jmp_buf_ptr + ", i8** @__jmp_buf_current")

        // Save shadow stack depth so we can restore it on catch (longjmp skips pop_roots)
        var saved_ss_depth: String = this.fresh_local()
        this.emit_indent(saved_ss_depth + " = call i64 @__gc_shadow_stack_depth()")

        // setjmp returns 0 on first call, non-zero on longjmp
        var setjmp_result: String = this.fresh_local()
        this.emit_indent(setjmp_result + " = call i32 @setjmp(i8* " + jmp_buf_ptr + ")")
        var is_throw: String = this.fresh_local()
        this.emit_indent(is_throw + " = icmp ne i32 " + setjmp_result + ", 0")
        this.emit_terminator("br i1 " + is_throw + ", label %" + catch_label + ", label %" + try_label)

        // Try body
        this.start_block(try_label)
        this.gen_stmts(try_body)
        if (!this.block_terminated) {
            // Restore previous jmp_buf before leaving try
            this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
            if (has_finally) {
                this.emit_terminator("br label %" + finally_label)
            } else {
                this.emit_terminator("br label %" + end_label)
            }
        }

        // Catch body
        this.start_block(catch_label)
        // Restore previous jmp_buf before running catch (so re-throws use outer handler)
        this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
        // Restore shadow stack depth (longjmp skipped pop_roots in unwound frames)
        var cur_ss_depth: String = this.fresh_local()
        this.emit_indent(cur_ss_depth + " = call i64 @__gc_shadow_stack_depth()")
        var ss_pop_n: String = this.fresh_local()
        this.emit_indent(ss_pop_n + " = sub i64 " + cur_ss_depth + ", " + saved_ss_depth)
        this.emit_indent("call void @__gc_pop_roots(i64 " + ss_pop_n + ")")
        // Load exception value into catch variable
        var exc_val: String = this.fresh_local()
        this.emit_indent(exc_val + " = load i64, i64* @__exception_value")
        this.emit_indent("store i64 " + exc_val + ", i64* %" + this.sanitize_name(catch_name))
        this.typed_vars.set(catch_name, AST.Type.StringType)
        this.gen_stmts(catch_body)
        if (!this.block_terminated) {
            if (has_finally) {
                this.emit_terminator("br label %" + finally_label)
            } else {
                this.emit_terminator("br label %" + end_label)
            }
        }

        // Finally body (runs after both try and catch paths)
        if (has_finally) {
            this.start_block(finally_label)
            this.gen_stmts(finally_body)
            if (!this.block_terminated) {
                this.emit_terminator("br label %" + end_label)
            }
        }

        this.start_block(end_label)
    }

    fun gen_while(cond: AST.Expr, body: List<AST.Stmt>) {
        var cond_label: String = this.fresh_label("while.cond")
        var body_label: String = this.fresh_label("while.body")
        var end_label: String = this.fresh_label("while.end")

        var saved_loop_end: String = this.loop_end_label
        var saved_break: String = this.loop_break_label
        var saved_continue: String = this.loop_continue_label
        this.loop_end_label = end_label + ":" + cond_label
        this.loop_break_label = end_label
        this.loop_continue_label = cond_label

        // LLVM lib parallel path: create blocks for while structure
        var llvm_cond_bb: Any = nil
        var llvm_body_bb: Any = nil
        var llvm_end_bb: Any = nil
        if (!this.identity_mode and this.use_llvm_lib) {
            llvm_cond_bb = this.llvm_func_builder.new_block(cond_label)
            llvm_body_bb = this.llvm_func_builder.new_block(body_label)
            llvm_end_bb = this.llvm_func_builder.new_block(end_label)
        }

        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(cond_label))
            // LLVM lib parallel path: br to cond block, switch builder
            if (!this.identity_mode) {
                this.llvm_block_builder.br_label_set(cond_label)
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_cond_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_cond_bb)
            }
        } else {
            this.emit_terminator("br label %" + cond_label)
            this.verify_br(cond_label)
        }

        this.start_block(cond_label)
        var cond_val: String = this.to_i1(this.gen_arg_value(cond))
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_cond_br(cond_val, body_label, end_label))
            // LLVM lib parallel path: cond_br, switch to body block
            if (!this.identity_mode and this.llvm_values.has(cond_val)) {
                var cond_v: Any = this.llvm_values.get(cond_val)
                this.llvm_block_builder.cond_br_labels_set(cond_v, body_label, end_label)
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_body_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_body_bb)
            }
        } else {
            this.emit_terminator("br i1 " + cond_val + ", label %" + body_label + ", label %" + end_label)
            this.verify_cond_br(cond_val, body_label, end_label)
        }

        this.start_block(body_label)
        this.gen_stmts(body)
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(cond_label))
            // LLVM lib parallel path: loop back to cond, switch to end block
            if (!this.identity_mode) {
                this.llvm_block_builder.br_label_set(cond_label)
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_end_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_end_bb)
            }
        } else {
            this.emit_terminator("br label %" + cond_label)
            this.verify_br(cond_label)
        }

        this.loop_end_label = saved_loop_end
        this.loop_break_label = saved_break
        this.loop_continue_label = saved_continue

        this.start_block(end_label)
    }

    fun emit_reflect_helpers() {
        var class_names: List<String> = this.class_type_ids.keys()
        if (class_names.length() == 0) { return }
        this.emit("")
        this.emit("define i64 @__reflect_class_name(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var tag_r: String = this.fresh_local()
        this.emit_indent(tag_r + " = call i64 @__gc_get_type_tag(i64 %val)")
        var end_lbl: String = this.fresh_label("rcn.end")
        var switch_str: String = ""
        var arm_labels: List<String> = []
        var ci: Float = 0
        while (ci < class_names.length()) {
            var lbl: String = this.fresh_label("rcn.c")
            arm_labels.push(lbl)
            var tid: Float = this.class_type_ids.get(class_names[ci])
            switch_str = switch_str + " i64 " + tid.floor().to_string() + ", label %" + lbl
            ci = ci + 1
        }
        this.emit_indent("switch i64 " + tag_r + ", label %" + end_lbl + " [" + switch_str + " ]")
        this.block_terminated = true
        ci = 0
        while (ci < class_names.length()) {
            this.start_block(arm_labels[ci])
            var cname: String = class_names[ci]
            var str_const: String = this.add_string_constant(cname)
            var str_len: Float = cname.length() + 1
            var gep: String = this.fresh_local()
            this.emit_indent(gep + " = getelementptr [" + str_len.to_string() + " x i8], [" + str_len.to_string() + " x i8]* " + str_const + ", i64 0, i64 0")
            var as_i64: String = this.ptr_to_val(gep)
            this.emit_terminator("ret i64 " + as_i64)
            ci = ci + 1
        }
        this.start_block(end_lbl)
        var unk_const: String = this.add_string_constant("Unknown")
        var unk_gep: String = this.fresh_local()
        this.emit_indent(unk_gep + " = getelementptr [8 x i8], [8 x i8]* " + unk_const + ", i64 0, i64 0")
        var unk_i64: String = this.ptr_to_val(unk_gep)
        this.emit_terminator("ret i64 " + unk_i64)
        this.emit("}")
        this.block_terminated = false

        this.emit("")
        this.emit("define i64 @__reflect_is_class(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var is_tag: String = this.fresh_local()
        this.emit_indent(is_tag + " = call i64 @__gc_get_type_tag(i64 %val)")
        var cmp: String = this.fresh_local()
        this.emit_indent(cmp + " = icmp uge i64 " + is_tag + ", 10")
        var result: String = this.fresh_local()
        this.emit_indent(result + " = zext i1 " + cmp + " to i64")
        this.emit_terminator("ret i64 " + result)
        this.emit("}")
        this.block_terminated = false

        this.emit("")
        this.emit("define i64 @__reflect_number_to_string(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var untagged: String = this.fresh_local()
        this.emit_indent(untagged + " = call i64 @__val_untag_int(i64 %val)")
        var ns_result: String = this.fresh_local()
        this.emit_indent(ns_result + " = call i64 @__int_to_string(i64 " + untagged + ")")
        var ns_ptr: String = this.fresh_local()
        this.emit_indent(ns_ptr + " = inttoptr i64 " + ns_result + " to i8*")
        var ns_tagged: String = this.fresh_local()
        this.emit_indent(ns_tagged + " = call i64 @__val_tag_ptr(i8* " + ns_ptr + ")")
        this.emit_terminator("ret i64 " + ns_tagged)
        this.emit("}")
        this.block_terminated = false

        // __reflect_get_fields: returns a Map of field_name -> field_value for an instance
        this.emit("")
        this.emit("define i64 @__reflect_get_fields(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var gf_tag: String = this.fresh_local()
        this.emit_indent(gf_tag + " = call i64 @__gc_get_type_tag(i64 %val)")
        var gf_end: String = this.fresh_label("rgf.end")
        var gf_switch: String = ""
        var gf_arms: List<String> = []
        ci = 0
        while (ci < class_names.length()) {
            var gf_lbl: String = this.fresh_label("rgf.c")
            gf_arms.push(gf_lbl)
            var gf_tid: Float = this.class_type_ids.get(class_names[ci])
            gf_switch = gf_switch + " i64 " + gf_tid.floor().to_string() + ", label %" + gf_lbl
            ci = ci + 1
        }
        this.emit_indent("switch i64 " + gf_tag + ", label %" + gf_end + " [" + gf_switch + " ]")
        this.block_terminated = true
        ci = 0
        while (ci < class_names.length()) {
            this.start_block(gf_arms[ci])
            var cname2: String = class_names[ci]
            var fld_entries: List<String> = []
            if (this.class_field_list.has(cname2)) { fld_entries = this.class_field_list.get(cname2) }
            var map_val: String = this.fresh_local()
            this.emit_indent(map_val + " = call i64 @__map_new()")
            var fi: Float = 0
            while (fi < fld_entries.length()) {
                var fp: List<String> = fld_entries[fi].split(":")
                var fname: String = fp[0]
                var fname_const: String = this.add_string_constant(fname)
                var fname_len: Float = fname.length() + 1
                var fname_gep: String = this.fresh_local()
                this.emit_indent(fname_gep + " = getelementptr [" + fname_len.to_string() + " x i8], [" + fname_len.to_string() + " x i8]* " + fname_const + ", i64 0, i64 0")
                var fname_i64: String = this.emit_tag_ptr(fname_gep)
                var inst_ptr: String = this.fresh_local()
                this.emit_indent(inst_ptr + " = inttoptr i64 %val to %" + cname2 + "*")
                var field_ptr: String = this.fresh_local()
                this.emit_indent(field_ptr + " = getelementptr %" + cname2 + ", %" + cname2 + "* " + inst_ptr + ", i32 0, i32 " + fi.floor().to_string())
                var field_val: String = this.fresh_local()
                this.emit_indent(field_val + " = load i64, i64* " + field_ptr)
                this.emit_indent("call i64 @__map_set(i64 " + map_val + ", i64 " + fname_i64 + ", i64 " + field_val + ")")
                fi = fi + 1
            }
            this.emit_terminator("ret i64 " + map_val)
            ci = ci + 1
        }
        this.start_block(gf_end)
        var empty_map: String = this.fresh_local()
        this.emit_indent(empty_map + " = call i64 @__map_new()")
        this.emit_terminator("ret i64 " + empty_map)
        this.emit("}")
        this.block_terminated = false

        // __reflect_construct_from_map: given a class constructor ptr and a map, construct instance
        this.emit("")
        this.emit("define i64 @__reflect_construct_from_map(i64 %klass, i64 %map) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var rc_end: String = this.fresh_label("rcon.end")
        ci = 0
        while (ci < class_names.length()) {
            var cname3: String = class_names[ci]
            var fn_ptr_val: String = this.fresh_local()
            this.emit_indent(fn_ptr_val + " = ptrtoint i64 (...)* bitcast (i64 ()* @" + cname3 + " to i64 (...)*) to i64")
            var cmp_r: String = this.fresh_local()
            this.emit_indent(cmp_r + " = icmp eq i64 %klass, " + fn_ptr_val)
            var rc_arm: String = this.fresh_label("rcon.hit")
            var rc_next: String = this.fresh_label("rcon.next")
            if (ci < class_names.length() - 1) {
                this.emit_terminator("br i1 " + cmp_r + ", label %" + rc_arm + ", label %" + rc_next)
            } else {
                this.emit_terminator("br i1 " + cmp_r + ", label %" + rc_arm + ", label %" + rc_end)
            }
            this.start_block(rc_arm)
            var new_inst: String = this.fresh_local()
            this.emit_indent(new_inst + " = call i64 @" + cname3 + "()")
            var c_entries: List<String> = []
            if (this.class_field_list.has(cname3)) { c_entries = this.class_field_list.get(cname3) }
            if (c_entries.length() > 0) {
                var c_ptr: String = this.fresh_local()
                this.emit_indent(c_ptr + " = inttoptr i64 " + new_inst + " to %" + cname3 + "*")
                var cfi: Float = 0
                while (cfi < c_entries.length()) {
                    var cfp: List<String> = c_entries[cfi].split(":")
                    var cf_name: String = cfp[0]
                    var cf_key_const: String = this.add_string_constant(cf_name)
                    var cf_key_len: Float = cf_name.length() + 1
                    var cf_key_gep: String = this.fresh_local()
                    this.emit_indent(cf_key_gep + " = getelementptr [" + cf_key_len.to_string() + " x i8], [" + cf_key_len.to_string() + " x i8]* " + cf_key_const + ", i64 0, i64 0")
                    var cf_key_i64: String = this.ptr_to_val(cf_key_gep)
                    var cf_val: String = this.fresh_local()
                    this.emit_indent(cf_val + " = call i64 @__map_get(i64 %map, i64 " + cf_key_i64 + ")")
                    var cf_fld_ptr: String = this.fresh_local()
                    this.emit_indent(cf_fld_ptr + " = getelementptr %" + cname3 + ", %" + cname3 + "* " + c_ptr + ", i32 0, i32 " + cfi.floor().to_string())
                    this.emit_indent("store i64 " + cf_val + ", i64* " + cf_fld_ptr)
                    cfi = cfi + 1
                }
            }
            this.emit_terminator("ret i64 " + new_inst)
            if (ci < class_names.length() - 1) {
                this.start_block(rc_next)
            }
            ci = ci + 1
        }
        this.start_block(rc_end)
        this.emit_terminator("ret i64 0")
        this.emit("}")
        this.block_terminated = false
    }

    // @codegen-split: utils
    fun runtime_declares(): String {
        var rt: StringBuilder = StringBuilder()
        rt.append("; --- Runtime declarations ---\n")
        rt.append("%SB = type { i64, i64, i8* }\n\n")
        var names: List<String> = ["__list_new", "__list_push", "__list_get", "__list_set", "__list_length", "__list_pop", "__list_remove", "__list_slice", "StringBuilder", "__sb_append", "__sb_to_string", "__safe_strcmp", "__map_new", "__map_set", "__map_get", "__map_has", "__map_keys", "__str_ends_with", "__str_split", "__str_replace", "__int_to_string", "__list_join", "__join_append", "__list_contains", "__io_read_file", "__io_write_file", "__io_file_exists", "__io_mkdir", "__io_walk_dir", "__io_append_file", "__io_read_stdin", "__io_readline", "__os_exec", "__os_args", "__os_cwd", "__os_path_sep", "__os_platform", "__os_env"]
        var sigs: List<String> = ["i64 @__list_new()", "i64 @__list_push(i64, i64)", "i64 @__list_get(i64, i64)", "i64 @__list_set(i64, i64, i64)", "i64 @__list_length(i64)", "i64 @__list_pop(i64)", "i64 @__list_remove(i64, i64)", "i64 @__list_slice(i64, i64, i64)", "i64 @StringBuilder()", "i64 @__sb_append(i64, i64)", "i64 @__sb_to_string(i64)", "i64 @__safe_strcmp(i64, i64)", "i64 @__map_new()", "i64 @__map_set(i64, i64, i64)", "i64 @__map_get(i64, i64)", "i64 @__map_has(i64, i64)", "i64 @__map_keys(i64)", "i64 @__str_ends_with(i64, i64)", "i64 @__str_split(i64, i64)", "i64 @__str_replace(i64, i64, i64)", "i64 @__int_to_string(i64)", "i64 @__list_join(i64, i64)", "i64 @__join_append(i64, i64, i64, i64, i64)", "i64 @__list_contains(i64, i64)", "i64 @__io_read_file(i64)", "i64 @__io_write_file(i64, i64)", "i64 @__io_file_exists(i64)", "i64 @__io_mkdir(i64)", "i64 @__io_walk_dir(i64)", "i64 @__io_append_file(i64, i64)", "i64 @__io_read_stdin(i64)", "i64 @__io_readline()", "i64 @__os_exec(i64)", "i64 @__os_args()", "i64 @__os_cwd()", "i64 @__os_path_sep()", "i64 @__os_platform()", "i64 @__os_env(i64)"]
        var di: Float = 0
        while (di < names.length()) {
            if (!this.str_in_list(this.defined_funcs,names[di])) {
                rt.append("declare " + sigs[di] + "\n")
            }
            di = di + 1
        }
        // Debug location tracking
        rt.append("@__debug_location = external global i8*\n")
        // NaN-boxing value constructors
        rt.append("declare i64 @__val_nil()\n")
        // Runtime type-check functions (NaN-boxing tag inspection, return i1)
        rt.append("declare i1 @__val_is_int(i64)\n")
        rt.append("declare i1 @__val_is_float(i64)\n")
        rt.append("declare i1 @__val_is_string(i64)\n")
        rt.append("declare i1 @__val_is_bool(i64)\n")
        rt.append("declare i1 @__val_is_nil(i64)\n")
        rt.append("declare i1 @__val_is_list(i64)\n")
        rt.append("declare i1 @__val_is_map(i64)\n")
        // GC runtime declarations
        rt.append("\n; --- GC runtime ---\n")
        rt.append("declare void @__gc_enable()\n")
        rt.append("declare void @__gc_disable()\n")
        rt.append("declare void @__gc_collect()\n")
        rt.append("declare void @__gc_set_threshold(i64)\n")
        rt.append("declare i64 @__gc_stat_alloc_count()\n")
        rt.append("declare i64 @__gc_stat_total_bytes()\n")
        rt.append("declare i64 @__gc_stat_collections()\n")
        rt.append("declare i64 @__gc_stat_freed_bytes()\n")
        rt.append("declare i64 @__gc_stat_threshold()\n")
        rt.append("declare void @__gc_debug_stats()\n")
        rt.append("declare i64 @__gc_alloc(i64, i64)\n")
        rt.append("declare i64 @__gc_alloc_zeroed(i64, i64)\n")
        rt.append("declare i64 @__gc_realloc(i64, i64, i64)\n")
        rt.append("declare void @__gc_push_root(i64)\n")
        rt.append("declare void @__gc_pop_roots(i64)\n")
        rt.append("declare i64 @__gc_shadow_stack_depth()\n")
        rt.append("declare i64 @__gc_list_new()\n")
        rt.append("declare void @__gc_list_push(i64, i64)\n")
        rt.append("declare i64 @__gc_map_new()\n")
        rt.append("declare i64 @__gc_stringbuilder_new()\n")
        rt.append("declare i64 @__gc_string_alloc(i64)\n")
        rt.append("declare i64 @__gc_closure_new(i64, i64)\n")
        rt.append("declare i64 @__gc_env_alloc(i64)\n")
        rt.append("declare i64 @__gc_instance_alloc(i64)\n")
        rt.append("declare i64 @__gc_get_type_tag(i64)\n")
        // Scheduler extern functions (always needed when @async or @scheduler imported)
        rt.append("\n; --- Scheduler runtime ---\n")
        rt.append("declare double @sf_time_now()\n")
        rt.append("declare i64 @sf_tcp_poll(i64, i64, i64)\n")
        rt.append("declare void @__sched_coro_resume(i64)\n")
        rt.append("declare i64 @__sched_coro_done(i64)\n")
        rt.append("declare void @__sched_coro_destroy(i64)\n")
        rt.append("declare i64 @__sched_get_yield_reason()\n")
        rt.append("declare i64 @__sched_get_yield_arg()\n")
        rt.append("declare i64 @__sched_get_task_result()\n")
        rt.append("declare void @__sched_reset_yield()\n")
        rt.append("declare void @__sched_store_result(i64, i64)\n")
        rt.append("declare i64 @__sched_get_stored_result(i64)\n")
        rt.append("declare i64 @__sched_has_stored_result(i64)\n")
        // Mark scheduler functions as known to prevent duplicate declares
        this.known_functions.push("sf_time_now")
        this.known_functions.push("sf_tcp_poll")
        this.known_functions.push("__sched_coro_resume")
        this.known_functions.push("__sched_coro_done")
        this.known_functions.push("__sched_coro_destroy")
        this.known_functions.push("__sched_get_yield_reason")
        this.known_functions.push("__sched_get_yield_arg")
        this.known_functions.push("__sched_get_task_result")
        this.known_functions.push("__sched_reset_yield")
        this.known_functions.push("__sched_store_result")
        this.known_functions.push("__sched_get_stored_result")
        this.known_functions.push("__sched_has_stored_result")
        // Coroutine intrinsics
        if (this.coroutine_funcs.length() > 0) {
            rt.append("\n; --- Coroutine intrinsics ---\n")
            rt.append("declare token @llvm.coro.id(i32, ptr, ptr, ptr)\n")
            rt.append("declare i64 @llvm.coro.size.i64()\n")
            rt.append("declare ptr @llvm.coro.begin(token, ptr)\n")
            rt.append("declare token @llvm.coro.save(ptr)\n")
            rt.append("declare i8 @llvm.coro.suspend(token, i1)\n")
            rt.append("declare ptr @llvm.coro.free(token, ptr)\n")
            rt.append("declare i1 @llvm.coro.end(ptr, i1)\n")
            rt.append("declare void @llvm.coro.resume(ptr)\n")
            rt.append("declare i1 @llvm.coro.done(ptr)\n")
            rt.append("declare void @llvm.coro.destroy(ptr)\n")
            rt.append("\n@__yield_reason = external global i64\n")
            rt.append("@__yield_arg = external global i64\n")
            rt.append("@__task_result = external global i64\n")
            rt.append("@__coro_escape_sink = external global ptr\n")
        }
        return rt.to_string()
    }

    // Determine if a type requires GC root tracking.
    // Heap types: String, List, Map, StringBuilder, Any, class instances, closures.
    // Value types: Int, Float, Bool, Nil, Number — no tracking needed.
    fun is_gc_root_type(type_str: String): Bool {
        if (type_str == "Int" or type_str == "Float" or type_str == "Bool" or type_str == "Nil" or type_str == "Number" or type_str == "void") {
            return false
        }
        if (type_str.length() == 0) {
            return false
        }
        // Everything else (String, List, Map, Any, class types, etc.) is heap-allocated
        return true
    }

    fun find_enum_for_variant(variant: String): String {
        var keys: List<String> = this.enum_variant_tags.keys()
        var i: Float = 0
        while (i < keys.length()) {
            var key: String = keys[i]
            if (key.ends_with("." + variant)) {
                return key.split(".")[0]
            }
            i = i + 1
        }
        return "Unknown"
    }

    fun emit_debug_location(context: String) {
        var loc: String = this.current_function_name + ": " + context
        var const_name: String = this.add_string_constant(loc)
        var slen: Float = loc.length() + 1
        var gep: String = this.fresh_local()
        this.emit_indent(gep + " = getelementptr [" + slen.to_string() + " x i8], [" + slen.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
        this.emit_indent("store i8* " + gep + ", i8** @__debug_location")
    }

    fun resolve_callee(expr: AST.Expr): String {
        return match (expr) {
            Variable(n) => n
            MemberAccess(obj, field) => this.resolve_callee(obj) + "." + field
            x => ""
        }
    }

    fun gen_logical(left: AST.Expr, op: String, right: AST.Expr): String {
        var lhs_raw: String = this.gen_arg_value(left)
        var lhs: String = this.to_i1(lhs_raw)
        var current_block: String = this.fresh_label("logic.entry")
        var rhs_label: String = this.fresh_label("rhs")
        var end_label: String = this.fresh_label("end")

        // We need a label for the current block for phi
        this.emit_terminator("br label %" + current_block)
        this.start_block(current_block)

        if (op == "or") {
            this.emit_terminator("br i1 " + lhs + ", label %" + end_label + ", label %" + rhs_label)
        } else {
            this.emit_terminator("br i1 " + lhs + ", label %" + rhs_label + ", label %" + end_label)
        }

        this.start_block(rhs_label)
        var rhs_raw: String = this.gen_arg_value(right)
        var rhs: String = this.to_i1(rhs_raw)
        this.emit_terminator("br label %" + end_label)

        this.start_block(end_label)
        var phi_result: String = this.fresh_local()
        this.emit_indent(phi_result + " = phi i1 [" + lhs + ", %" + current_block + "], [" + rhs + ", %" + rhs_label + "]")
        // Extend back to i64 for uniform value type
        var raw: String = this.fresh_local()
        this.emit_indent(raw + " = zext i1 " + phi_result + " to i64")
        // Tag as bool so the value is a proper NaN-boxed bool when stored
        var result: String = this.emit_tag_bool(raw)
        this.last_type = AST.Type.BoolType
        return result
    }

    // --- Variable collection (for hoisting allocas to entry block) ---

    fun collect_vars(stmts: List<AST.Stmt>, names: List<String>, types: List<String>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.collect_vars_stmt(stmts[i], names, types)
            i = i + 1
        }
    }

    fun add_var_unique(names: List<String>, types: List<String>, name: String, typ: String) {
        var exists: Bool = false
        var avi: Float = 0
        while (avi < names.length()) {
            if (names[avi] == name) { exists = true }
            avi = avi + 1
        }
        if (!exists) {
            names.push(name)
            types.push(typ)
        }
    }

    fun collect_vars_stmt(stmt: AST.Stmt, names: List<String>, types: List<String>) {
        var sk: String = this.classify_stmt(stmt)
        if (sk == "let_pattern") {
            var lp_pat: AST.Pattern = match (stmt) { LetPattern(p, v) => p   _ => AST.Pattern.VariantPattern("", []) }
            var lp_val: AST.Expr = match (stmt) { LetPattern(p, v) => v   _ => AST.Expr.NilLit }
            var lp_vname: String = match (lp_pat) { VariantPattern(v, b) => v   ArrayPattern(e, r) => "__array:" + r   _ => "" }
            var lp_bindings: List<String> = match (lp_pat) { VariantPattern(v, b) => b   ArrayPattern(e, r) => e   _ => [] }
            var lpi: Float = 0
            while (lpi < lp_bindings.length()) {
                this.add_var_unique(names, types, lp_bindings[lpi], "Any")
                lpi = lpi + 1
            }
            if (lp_vname.starts_with("__array:")) {
                var lp_rest: String = lp_vname.slice(8, lp_vname.length())
                if (lp_rest.length() > 0) {
                    this.add_var_unique(names, types, lp_rest, "Any")
                }
            }
            this.collect_vars_expr(lp_val, names, types)
            return
        }
        match (stmt) {
            VarDecl(name, type_ann, init, doc) => {
                this.add_var_unique(names, types, name, type_ann)
                this.collect_vars_expr(init, names, types)
            }
            If(cond, then_branch, else_branch) => {
                this.collect_vars(then_branch, names, types)
                this.collect_vars(else_branch, names, types)
            }
            While(cond, body) => {
                this.collect_vars(body, names, types)
            }
            Block(stmts) => {
                this.collect_vars(stmts, names, types)
            }
            ExprStmt(expr) => {
                this.collect_vars_expr(expr, names, types)
            }
            Return(value) => {
                this.collect_vars_expr(value, names, types)
            }
            FunDecl(n, p, r, b, d) => {}
            EnumDecl(n, v, d) => {}
            ClassDecl(n, p, f, m, d) => {}
            Break => {}
            Continue => {}
            TryCatch(try_body, catch_name, catch_body, finally_body) => {
                this.collect_vars(try_body, names, types)
                this.add_var_unique(names, types, catch_name, "String")
                this.collect_vars(catch_body, names, types)
                this.collect_vars(finally_body, names, types)
            }
            Throw(value) => {
                this.collect_vars_expr(value, names, types)
            }
            LetPattern(pattern, value) => {
            }
        }
    }

    fun collect_vars_expr(expr: AST.Expr, names: List<String>, types: List<String>) {
        var ek: String = this.classify_expr(expr)
        if (ek == "if_expr") {
            var ie_cond: AST.Expr = match (expr) { IfExpr(c, tb, tv, eb, ev) => c   _ => AST.Expr.NilLit }
            var ie_tb: List<AST.Stmt> = match (expr) { IfExpr(c, tb, tv, eb, ev) => tb   _ => [] }
            var ie_tv: AST.Expr = match (expr) { IfExpr(c, tb, tv, eb, ev) => tv   _ => AST.Expr.NilLit }
            var ie_eb: List<AST.Stmt> = match (expr) { IfExpr(c, tb, tv, eb, ev) => eb   _ => [] }
            var ie_ev: AST.Expr = match (expr) { IfExpr(c, tb, tv, eb, ev) => ev   _ => AST.Expr.NilLit }
            this.collect_vars_expr(ie_cond, names, types)
            this.collect_vars(ie_tb, names, types)
            this.collect_vars_expr(ie_tv, names, types)
            this.collect_vars(ie_eb, names, types)
            this.collect_vars_expr(ie_ev, names, types)
            return
        }
        if (ek == "try_expr") {
            var te_tb: List<AST.Stmt> = match (expr) { TryExpr(tb, tv, cn, cb, cv) => tb   _ => [] }
            var te_tv: AST.Expr = match (expr) { TryExpr(tb, tv, cn, cb, cv) => tv   _ => AST.Expr.NilLit }
            var te_cn: String = match (expr) { TryExpr(tb, tv, cn, cb, cv) => cn   _ => "" }
            var te_cb: List<AST.Stmt> = match (expr) { TryExpr(tb, tv, cn, cb, cv) => cb   _ => [] }
            var te_cv: AST.Expr = match (expr) { TryExpr(tb, tv, cn, cb, cv) => cv   _ => AST.Expr.NilLit }
            this.collect_vars(te_tb, names, types)
            this.collect_vars_expr(te_tv, names, types)
            if (te_cn.length() > 0) {
                this.add_var_unique(names, types, te_cn, "String")
            }
            this.collect_vars(te_cb, names, types)
            this.collect_vars_expr(te_cv, names, types)
            return
        }
        match (expr) {
            Match(s, a) => { this.collect_vars_match(expr, names, types) }
            BlockExpr(stmts, value) => {
                this.collect_vars(stmts, names, types)
                this.collect_vars_expr(value, names, types)
            }
            Binary(left, op, right) => {
                this.collect_vars_expr(left, names, types)
                this.collect_vars_expr(right, names, types)
            }
            Logical(left, op, right) => {
                this.collect_vars_expr(left, names, types)
                this.collect_vars_expr(right, names, types)
            }
            Unary(op, right) => { this.collect_vars_expr(right, names, types) }
            Assign(name, value) => { this.collect_vars_expr(value, names, types) }
            Call(callee, args) => {
                this.collect_vars_expr(callee, names, types)
                var ci: Float = 0
                while (ci < args.length()) {
                    this.collect_vars_expr(args[ci], names, types)
                    ci = ci + 1
                }
            }
            MethodCall(obj, method, args) => {
                this.collect_vars_expr(obj, names, types)
                var mi: Float = 0
                while (mi < args.length()) {
                    this.collect_vars_expr(args[mi], names, types)
                    mi = mi + 1
                }
            }
            SetField(obj, field, value) => {
                this.collect_vars_expr(obj, names, types)
                this.collect_vars_expr(value, names, types)
            }
            GetField(obj, field) => { this.collect_vars_expr(obj, names, types) }
            IndexGet(obj, idx) => {
                this.collect_vars_expr(obj, names, types)
                this.collect_vars_expr(idx, names, types)
            }
            IndexSet(obj, idx, value) => {
                this.collect_vars_expr(obj, names, types)
                this.collect_vars_expr(idx, names, types)
                this.collect_vars_expr(value, names, types)
            }
            MemberAccess(obj, field) => { this.collect_vars_expr(obj, names, types) }
            IntLit(v) => {}
            FloatLit(v) => {}
            BoolLit(v) => {}
            StringLit(s) => {}
            NilLit => {}
            Variable(n) => {}
            This => {}
            MapLit => {}
            ListLit(e) => {}
            EnumConstruct(e, v, a) => {}
            Lambda(p, r, b) => {}
            IsCheck(val, t) => { this.collect_vars_expr(val, names, types) }
            IfExpr(c, tb, tv, eb, ev) => {}
            TryExpr(tb, tv, cn, cb, cv) => {}
            Yield(v) => { this.collect_vars_expr(v, names, types) }
            TupleLit(e) => {}
        }
    }

    fun is_wildcard_in_enum(pattern: AST.Pattern, enum_name: String): Bool {
        var name: String = match (pattern) { VariantPattern(v, b) => v
            _ => ""
        }
        return !this.enum_variant_tags.has(enum_name + "." + name)
    }

    fun get_arm_pattern(arm: AST.MatchArm): AST.Pattern {
        return match (arm) { Arm(p, b) => p
            _ => ""
        }
    }

    fun get_arm_body(arm: AST.MatchArm): AST.Expr {
        return match (arm) { Arm(p, b) => b
            _ => ""
        }
    }

    fun get_pattern_bindings(pattern: AST.Pattern): List<String> {
        return match (pattern) { VariantPattern(v, b) => b
            _ => ""
        }
    }

    fun collect_vars_match(expr: AST.Expr, names: List<String>, types: List<String>) {
        var arms: List<AST.MatchArm> = this.get_match_arms(expr)
        var i: Float = 0
        while (i < arms.length()) {
            var arm: AST.MatchArm = arms[i]
            var bindings: List<String> = this.get_pattern_bindings(this.get_arm_pattern(arm))
            var j: Float = 0
            while (j < bindings.length()) {
                this.add_var_unique(names, types, bindings[j], "Int")
                j = j + 1
            }
            this.collect_vars_expr(this.get_arm_body(arm), names, types)
            i = i + 1
        }
    }

    fun is_match_expr(expr: AST.Expr): Bool {
        var kind: Any = match (expr) {
            Match(s, a) => "match"
            IntLit(v) => "other"
            FloatLit(v) => "other"
            BoolLit(v) => "other"
            StringLit(s) => "other"
            NilLit => "other"
            Variable(n) => "other"
            Binary(l, o, r) => "other"
            Unary(o, r) => "other"
            Call(c, a) => "other"
            Assign(n, v) => "other"
            Logical(l, o, r) => "other"
            MemberAccess(o, f) => "other"
            EnumConstruct(e, v, a) => "other"
            Lambda(p, r, b) => "other"
            GetField(o, f) => "other"
            SetField(o, f, v) => "other"
            This => "other"
            ListLit(e) => "other"
            IndexGet(o, i) => "other"
            IndexSet(o, i, v) => "other"
            MethodCall(o, m, a) => "other"
            MapLit => "other"
            BlockExpr(s, v) => "other"
            IsCheck(val, t) => "other"
            IfExpr(c, tb, tv, eb, ev) => "other"
            TryExpr(tb, tv, cn, cb, cv) => "other"
            Yield(v) => "other"
            TupleLit(e) => "other"
        }
        return kind == "match"
    }

    fun get_match_arms(expr: AST.Expr): List<AST.MatchArm> {
        return match (expr) { Match(s, a) => a
            _ => ""
        }
    }

    // --- Coroutine detection ---

    fun expr_has_yield(expr: AST.Expr): Bool {
        return match (expr) {
            Yield(v) => true
            Binary(l, o, r) => this.expr_has_yield(l) or this.expr_has_yield(r)
            Unary(o, r) => this.expr_has_yield(r)
            Call(c, a) => this.call_is_suspend(c) or this.exprs_have_yield(a)
            Assign(n, v) => this.expr_has_yield(v)
            Logical(l, o, r) => this.expr_has_yield(l) or this.expr_has_yield(r)
            MethodCall(o, m, a) => m == "await" or this.expr_has_yield(o) or this.exprs_have_yield(a)
            ListLit(e) => this.exprs_have_yield(e)
            IndexGet(o, i) => this.expr_has_yield(o) or this.expr_has_yield(i)
            IndexSet(o, i, v) => this.expr_has_yield(o) or this.expr_has_yield(i) or this.expr_has_yield(v)
            SetField(o, f, v) => this.expr_has_yield(o) or this.expr_has_yield(v)
            GetField(o, f) => this.expr_has_yield(o)
            MemberAccess(o, f) => this.expr_has_yield(o)
            EnumConstruct(e, v, a) => this.exprs_have_yield(a)
            Match(s, a) => this.expr_has_yield(s)
            BlockExpr(s, v) => this.stmts_have_yield(s) or this.expr_has_yield(v)
            IfExpr(c, tb, tv, eb, ev) => this.expr_has_yield(c) or this.stmts_have_yield(tb) or this.expr_has_yield(tv) or this.stmts_have_yield(eb) or this.expr_has_yield(ev)
            IsCheck(v, t) => this.expr_has_yield(v)
            TryExpr(tb, tv, cn, cb, cv) => this.stmts_have_yield(tb) or this.expr_has_yield(tv) or this.stmts_have_yield(cb) or this.expr_has_yield(cv)
            TupleLit(e) => this.exprs_have_yield(e)
            _ => false
        }
    }

    fun call_is_suspend(callee: AST.Expr): Bool {
        var name: String = this.get_variable_name(callee)
        return name == "__suspend" or name.ends_with("__suspend")
    }

    fun exprs_have_yield(exprs: List<AST.Expr>): Bool {
        var i: Float = 0
        while (i < exprs.length()) {
            if (this.expr_has_yield(exprs[i])) { return true }
            i = i + 1
        }
        return false
    }

    fun stmts_have_yield(stmts: List<AST.Stmt>): Bool {
        var i: Float = 0
        while (i < stmts.length()) {
            if (this.stmt_has_yield(stmts[i])) { return true }
            i = i + 1
        }
        return false
    }

    fun stmt_has_yield(stmt: AST.Stmt): Bool {
        return match (stmt) {
            ExprStmt(e) => this.expr_has_yield(e)
            VarDecl(n, t, init, d) => this.expr_has_yield(init)
            Return(v) => this.expr_has_yield(v)
            If(c, tb, eb) => this.expr_has_yield(c) or this.stmts_have_yield(tb) or this.stmts_have_yield(eb)
            While(c, b) => this.expr_has_yield(c) or this.stmts_have_yield(b)
            Block(s) => this.stmts_have_yield(s)
            TryCatch(t, n, c, f) => this.stmts_have_yield(t) or this.stmts_have_yield(c) or this.stmts_have_yield(f)
            Throw(v) => this.expr_has_yield(v)
            FunDecl(n, p, r, b, d) => false
            _ => false
        }
    }

    fun collect_calls_from_expr(expr: AST.Expr, calls: List<String>) {
        match (expr) {
            Call(callee, args) => {
                var name: String = this.get_variable_name(callee)
                if (name.length() > 0) { calls.push(name) }
                this.collect_calls_from_exprs(args, calls)
            }
            MethodCall(o, m, a) => {
                // Extract module-qualified call: Async.sleep → stdlib_async_sleep
                var obj_name: String = this.get_variable_name(o)
                if (obj_name.length() > 0 and this.module_prefixes.has(obj_name)) {
                    var prefix: String = this.module_prefixes.get(obj_name)
                    calls.push(prefix + m)
                }
                calls.push(m)
                this.collect_calls_from_expr(o, calls)
                this.collect_calls_from_exprs(a, calls)
            }
            Binary(l, o, r) => {
                this.collect_calls_from_expr(l, calls)
                this.collect_calls_from_expr(r, calls)
            }
            Assign(n, v) => { this.collect_calls_from_expr(v, calls) }
            Logical(l, o, r) => {
                this.collect_calls_from_expr(l, calls)
                this.collect_calls_from_expr(r, calls)
            }
            Unary(o, r) => { this.collect_calls_from_expr(r, calls) }
            ListLit(e) => { this.collect_calls_from_exprs(e, calls) }
            IndexGet(o, i) => {
                this.collect_calls_from_expr(o, calls)
                this.collect_calls_from_expr(i, calls)
            }
            IndexSet(o, i, v) => {
                this.collect_calls_from_expr(o, calls)
                this.collect_calls_from_expr(i, calls)
                this.collect_calls_from_expr(v, calls)
            }
            SetField(o, f, v) => {
                this.collect_calls_from_expr(o, calls)
                this.collect_calls_from_expr(v, calls)
            }
            GetField(o, f) => { this.collect_calls_from_expr(o, calls) }
            MemberAccess(o, f) => { this.collect_calls_from_expr(o, calls) }
            BlockExpr(s, v) => {
                this.collect_calls_from_stmts(s, calls)
                this.collect_calls_from_expr(v, calls)
            }
            IfExpr(c, tb, tv, eb, ev) => {
                this.collect_calls_from_expr(c, calls)
                this.collect_calls_from_stmts(tb, calls)
                this.collect_calls_from_expr(tv, calls)
                this.collect_calls_from_stmts(eb, calls)
                this.collect_calls_from_expr(ev, calls)
            }
        }
    }

    fun collect_calls_from_exprs(exprs: List<AST.Expr>, calls: List<String>) {
        var i: Float = 0
        while (i < exprs.length()) {
            this.collect_calls_from_expr(exprs[i], calls)
            i = i + 1
        }
    }

    fun collect_calls_from_stmts(stmts: List<AST.Stmt>, calls: List<String>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.collect_calls_from_stmt(stmts[i], calls)
            i = i + 1
        }
    }

    fun collect_calls_from_stmt(stmt: AST.Stmt, calls: List<String>) {
        match (stmt) {
            ExprStmt(e) => { this.collect_calls_from_expr(e, calls) }
            VarDecl(n, t, init, d) => { this.collect_calls_from_expr(init, calls) }
            Return(v) => { this.collect_calls_from_expr(v, calls) }
            If(c, tb, eb) => {
                this.collect_calls_from_expr(c, calls)
                this.collect_calls_from_stmts(tb, calls)
                this.collect_calls_from_stmts(eb, calls)
            }
            While(c, b) => {
                this.collect_calls_from_expr(c, calls)
                this.collect_calls_from_stmts(b, calls)
            }
            Block(s) => { this.collect_calls_from_stmts(s, calls) }
            TryCatch(t, n, c, f) => {
                this.collect_calls_from_stmts(t, calls)
                this.collect_calls_from_stmts(c, calls)
                this.collect_calls_from_stmts(f, calls)
            }
            Throw(v) => { this.collect_calls_from_expr(v, calls) }
        }
    }

    fun mark_coroutines(program: List<AST.Stmt>) {
        // Pass 1: find functions that directly contain yield
        var func_names: List<String> = []
        var func_bodies: List<List<AST.Stmt>> = []
        var i: Float = 0
        while (i < program.length()) {
            var kind: String = this.classify_stmt(program[i])
            if (kind == "fun") {
                var name: String = this.get_fun_name(program[i])
                var body: List<AST.Stmt> = this.get_fun_body(program[i])
                var full_name: String = this.current_prefix + name
                func_names.push(full_name)
                func_bodies.push(body)
                if (this.stmts_have_yield(body)) {
                    this.coroutine_funcs.push(full_name)
                    if (name != full_name) {
                        this.coroutine_funcs.push(name)
                    }
                    // Also push all possible module-prefixed forms
                    var mp_keys: List<String> = this.module_prefixes.keys()
                    var mpi: Float = 0
                    while (mpi < mp_keys.length()) {
                        var mp_prefix: String = this.module_prefixes.get(mp_keys[mpi])
                        var mp_name: String = mp_prefix + name
                        if (!this.str_in_list(this.coroutine_funcs,mp_name)) {
                            this.coroutine_funcs.push(mp_name)
                        }
                        mpi = mpi + 1
                    }
                }
            } else if (kind == "class") {
                // Also scan class methods for yield / coroutine calls
                var cls_name: String = ""
                var cls_methods: List<AST.Stmt> = []
                match (program[i]) {
                    ClassDecl(cn, cp, cf, cm, cd) => {
                        cls_name = cn
                        cls_methods = cm
                    }
                }
                var cmi: Float = 0
                while (cmi < cls_methods.length()) {
                    var mname: String = this.get_fun_name(cls_methods[cmi])
                    var mbody: List<AST.Stmt> = this.get_fun_body(cls_methods[cmi])
                    if (mname.length() > 0) {
                        var mfull: String = this.current_prefix + cls_name + "__" + mname
                        func_names.push(mfull)
                        func_bodies.push(mbody)
                        if (this.stmts_have_yield(mbody)) {
                            this.coroutine_funcs.push(mfull)
                            // Also push bare method name for cross-module matching
                            if (!this.str_in_list(this.coroutine_funcs, mname)) {
                                this.coroutine_funcs.push(mname)
                            }
                            // Push ClassName__method without prefix
                            var unprefixed: String = cls_name + "__" + mname
                            if (!this.str_in_list(this.coroutine_funcs, unprefixed)) {
                                this.coroutine_funcs.push(unprefixed)
                            }
                        }
                    }
                    cmi = cmi + 1
                }
            }
            i = i + 1
        }

        // Pass 2: transitive coloring — if A calls B and B is a coroutine, A is too
        var changed: Bool = true
        while (changed) {
            changed = false
            var fi: Float = 0
            while (fi < func_names.length()) {
                var fn_name: String = func_names[fi]
                if (!this.str_in_list(this.coroutine_funcs,fn_name)) {
                    var calls: List<String> = []
                    this.collect_calls_from_stmts(func_bodies[fi], calls)
                    var ci: Float = 0
                    while (ci < calls.length()) {
                        var callee: String = calls[ci]
                        // Check both bare name and prefixed name (no coro_method_match —
                        // bare suffix matching causes false positives across unrelated classes)
                        if (this.str_in_list(this.coroutine_funcs,callee) or this.str_in_list(this.coroutine_funcs,this.current_prefix + callee)) {
                            this.coroutine_funcs.push(fn_name)
                            changed = true
                            ci = calls.length()
                        }
                        ci = ci + 1
                    }
                }
                fi = fi + 1
            }
        }
    }

    fun coro_method_match(callee: String): Bool {
        // Check if any known coroutine function ends with __callee
        // This handles bare method names like "read" matching "stdlib_net_TcpConnection__read"
        var suffix: String = "__" + callee
        var k: Float = 0
        while (k < this.coroutine_funcs.length()) {
            if (this.coroutine_funcs[k].ends_with(suffix)) {
                return true
            }
            k = k + 1
        }
        return false
    }

    fun str_in_list(lst: List<String>, needle: String): Bool {
        var __sil_i: Float = 0
        while (__sil_i < lst.length()) {
            if (lst[__sil_i] == needle) { return true }
            __sil_i = __sil_i + 1
        }
        return false
    }

    fun is_known_name(name: String): Bool {
        if (name == "self" or name == "this" or name == "super") { return true }
        if (name == "IO" or name == "OS" or name == "GC" or name == "Task" or name == "Reflect") { return true }
        if (this.typed_vars.has(name)) { return true }
        if (this.module_globals.has(this.current_prefix + name)) { return true }
        if (this.module_globals.has(name)) { return true }
        if (this.str_in_list(this.known_functions, name)) { return true }
        if (this.str_in_list(this.known_functions, this.current_prefix + name)) { return true }
        if (this.module_prefixes.has(name)) { return true }
        if (this.enum_defs.has(name)) { return true }
        if (this.class_fields.has(name)) { return true }
        if (this.named_imports.has(name)) { return true }
        return false
    }

    // --- LLVM library dual-emit verification ---

    fun verify_binary_op(op_name: String, result_name: String, lhs_name: String, rhs_name: String) {
        // Construct the same instruction via the @llvm library and compare
        var lhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(lhs_name, LLVMTypes.Type.I64)
        var rhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(rhs_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)

        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Add(result_val, lhs_val, rhs_val)
        if (op_name == "sub") {
            inst = LLVMInst.Instruction.Sub(result_val, lhs_val, rhs_val)
        } else if (op_name == "mul") {
            inst = LLVMInst.Instruction.Mul(result_val, lhs_val, rhs_val)
        } else if (op_name == "sdiv") {
            inst = LLVMInst.Instruction.SDiv(result_val, lhs_val, rhs_val)
        } else if (op_name == "srem") {
            inst = LLVMInst.Instruction.SRem(result_val, lhs_val, rhs_val)
        } else if (op_name == "and") {
            inst = LLVMInst.Instruction.And(result_val, lhs_val, rhs_val)
        } else if (op_name == "or") {
            inst = LLVMInst.Instruction.Or(result_val, lhs_val, rhs_val)
        } else if (op_name == "xor") {
            inst = LLVMInst.Instruction.Xor(result_val, lhs_val, rhs_val)
        } else if (op_name == "shl") {
            inst = LLVMInst.Instruction.Shl(result_val, lhs_val, rhs_val)
        } else if (op_name == "ashr") {
            inst = LLVMInst.Instruction.AShr(result_val, lhs_val, rhs_val)
        }

        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = " + op_name + " i64 " + lhs_name + ", " + rhs_name
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for " + op_name + ":")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_icmp_op(pred_name: String, result_name: String, lhs_name: String, rhs_name: String) {
        // Construct an icmp instruction via the @llvm library and compare
        var lhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(lhs_name, LLVMTypes.Type.I64)
        var rhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(rhs_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I1)

        var pred: LLVMTypes.CmpPred = LLVMTypes.CmpPred.Eq
        if (pred_name == "ne") { pred = LLVMTypes.CmpPred.Ne }
        else if (pred_name == "slt") { pred = LLVMTypes.CmpPred.Slt }
        else if (pred_name == "sle") { pred = LLVMTypes.CmpPred.Sle }
        else if (pred_name == "sgt") { pred = LLVMTypes.CmpPred.Sgt }
        else if (pred_name == "sge") { pred = LLVMTypes.CmpPred.Sge }

        var inst: LLVMInst.Instruction = LLVMInst.Instruction.ICmp(result_val, pred, lhs_val, rhs_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = icmp " + pred_name + " i64 " + lhs_name + ", " + rhs_name
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for icmp " + pred_name + ":")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_zext_op(result_name: String, src_name: String) {
        // Verify zext i1 %src to i64
        var src_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(src_name, LLVMTypes.Type.I1)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.ZExt(result_val, src_val, LLVMTypes.Type.I64)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = zext i1 " + src_name + " to i64"
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for zext:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    // --- Memory operation verification ---

    fun verify_alloca(result_name: String, type_str: String) {
        // Construct: Instruction.Alloca(result, type, name)
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Alloca(result_val, ty, "")
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = alloca " + type_str
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for alloca:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_load(result_name: String, type_str: String, ptr_name: String) {
        // Library uses opaque pointers: "load i64, ptr %x"
        // Codegen uses typed pointers: "load i64, i64* %x"
        // Verify library output format only (opaque pointer mode)
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var ptr_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(ptr_name, LLVMTypes.Type.Ptr)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Load(result_val, ty, ptr_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, false)
        // Library format: "  %r = load i64, ptr %ptr"
        // Codegen format: "  %r = load i64, i64* %ptr"
        // These differ in pointer syntax — just verify library is self-consistent
        var lib_expected: String = "  " + result_name + " = load " + type_str + ", ptr " + ptr_name
        if (lib_ir != lib_expected) {
            IO.println("[llvm-verify] MISMATCH for load (library format):")
            IO.println("  expected: " + lib_expected)
            IO.println("  library:  " + lib_ir)
        }
    }

    fun verify_store(val_name: String, type_str: String, ptr_name: String) {
        // Library uses opaque pointers: "store i64 %v, ptr %p"
        // Codegen uses typed pointers: "store i64 %v, i64* %p"
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, ty)
        var ptr_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(ptr_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Store(val_v, ptr_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, false)
        var lib_expected: String = "  store " + type_str + " " + val_name + ", ptr " + ptr_name
        if (lib_ir != lib_expected) {
            IO.println("[llvm-verify] MISMATCH for store (library format):")
            IO.println("  expected: " + lib_expected)
            IO.println("  library:  " + lib_ir)
        }
    }

    // --- Function call verification ---

    fun verify_call(result_name: String, ret_type: String, fn_name: String, args_str: String) {
        // Codegen format: "  %r = call i64 @fn(i64 %a, i64 %b)"
        // Library format: "  %r = call i64 @fn(i64 %a, i64 %b)"
        // These should match when all args are i64
        var ret_ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (ret_type == "void") { ret_ty = LLVMTypes.Type.Void }
        else if (ret_type == "i1") { ret_ty = LLVMTypes.Type.I1 }
        else if (ret_type == "i32") { ret_ty = LLVMTypes.Type.I32 }
        else if (ret_type == "ptr") { ret_ty = LLVMTypes.Type.Ptr }
        // Parse args_str into Value list (args_str is like "i64 %a, i64 %b")
        var arg_vals: List<LLVMTypes.Value> = []
        if (args_str.length() > 0) {
            var arg_parts: List<String> = args_str.split(", ")
            var ai: Float = 0
            while (ai < arg_parts.length()) {
                var part: String = arg_parts[ai]
                var space_idx: Float = part.index_of(" ")
                if (space_idx > 0) {
                    var arg_name: String = part.slice(space_idx + 1, part.length())
                    arg_vals.push(LLVMTypes.Value.Instruction(arg_name, LLVMTypes.Type.I64))
                }
                ai = ai + 1
            }
        }
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, ret_ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Call(result_val, fn_name, ret_ty, arg_vals)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = call " + ret_type + " @" + fn_name + "(" + args_str + ")"
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for call @" + fn_name + ":")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    // --- Conversion verification ---

    fun verify_ptrtoint(result_name: String, val_name: String) {
        // Codegen: "  %r = ptrtoint ptr %v to i64"
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, LLVMTypes.Type.Ptr)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.PtrToInt(result_val, val_v, LLVMTypes.Type.I64)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = ptrtoint ptr " + val_name + " to i64"
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for ptrtoint:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_inttoptr(result_name: String, val_name: String) {
        // Codegen: "  %r = inttoptr i64 %v to ptr"
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.IntToPtr(result_val, val_v, LLVMTypes.Type.Ptr)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = inttoptr i64 " + val_name + " to ptr"
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for inttoptr:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_trunc(result_name: String, val_name: String, from_type: String, to_type: String) {
        // Codegen: "  %r = trunc i64 %v to i1"
        var from_ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (from_type == "i32") { from_ty = LLVMTypes.Type.I32 }
        var to_ty: LLVMTypes.Type = LLVMTypes.Type.I1
        if (to_type == "i32") { to_ty = LLVMTypes.Type.I32 }
        else if (to_type == "i8") { to_ty = LLVMTypes.Type.I8 }
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, from_ty)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, to_ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Trunc(result_val, val_v, to_ty)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        var expected: String = "  " + result_name + " = trunc " + from_type + " " + val_name + " to " + to_type
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for trunc:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    // --- Control flow verification ---

    fun verify_br(target_label: String) {
        // Codegen: "  br label %target"
        var term: LLVMInst.Terminator = LLVMInst.Terminator.Br(target_label)
        var lib_ir: String = LLVMInst.format_terminator(term)
        var expected: String = "  br label %" + target_label
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for br:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    fun verify_cond_br(cond_name: String, then_label: String, else_label: String) {
        // Codegen: "  br i1 %cond, label %then, label %else"
        var cond_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(cond_name, LLVMTypes.Type.I1)
        var term: LLVMInst.Terminator = LLVMInst.Terminator.CondBr(cond_val, then_label, else_label)
        var lib_ir: String = LLVMInst.format_terminator(term)
        var expected: String = "  br i1 " + cond_name + ", label %" + then_label + ", label %" + else_label
        if (lib_ir != expected) {
            IO.println("[llvm-verify] MISMATCH for cond_br:")
            IO.println("  codegen: " + expected)
            IO.println("  library: " + lib_ir)
        }
    }

    // --- LLVM library emission methods ---
    // These construct instructions via the @llvm library and return
    // the formatted instruction string (without leading indent).

    fun lib_binary_op(op_name: String, result_name: String, lhs_name: String, rhs_name: String): String {
        var lhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(lhs_name, LLVMTypes.Type.I64)
        var rhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(rhs_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)

        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Add(result_val, lhs_val, rhs_val)
        if (op_name == "sub") {
            inst = LLVMInst.Instruction.Sub(result_val, lhs_val, rhs_val)
        } else if (op_name == "mul") {
            inst = LLVMInst.Instruction.Mul(result_val, lhs_val, rhs_val)
        } else if (op_name == "sdiv") {
            inst = LLVMInst.Instruction.SDiv(result_val, lhs_val, rhs_val)
        } else if (op_name == "srem") {
            inst = LLVMInst.Instruction.SRem(result_val, lhs_val, rhs_val)
        } else if (op_name == "and") {
            inst = LLVMInst.Instruction.And(result_val, lhs_val, rhs_val)
        } else if (op_name == "or") {
            inst = LLVMInst.Instruction.Or(result_val, lhs_val, rhs_val)
        } else if (op_name == "xor") {
            inst = LLVMInst.Instruction.Xor(result_val, lhs_val, rhs_val)
        } else if (op_name == "shl") {
            inst = LLVMInst.Instruction.Shl(result_val, lhs_val, rhs_val)
        } else if (op_name == "ashr") {
            inst = LLVMInst.Instruction.AShr(result_val, lhs_val, rhs_val)
        }

        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_icmp_op(pred_name: String, result_name: String, lhs_name: String, rhs_name: String): String {
        var lhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(lhs_name, LLVMTypes.Type.I64)
        var rhs_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(rhs_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I1)

        var pred: LLVMTypes.CmpPred = LLVMTypes.CmpPred.Eq
        if (pred_name == "ne") { pred = LLVMTypes.CmpPred.Ne }
        else if (pred_name == "slt") { pred = LLVMTypes.CmpPred.Slt }
        else if (pred_name == "sle") { pred = LLVMTypes.CmpPred.Sle }
        else if (pred_name == "sgt") { pred = LLVMTypes.CmpPred.Sgt }
        else if (pred_name == "sge") { pred = LLVMTypes.CmpPred.Sge }

        var inst: LLVMInst.Instruction = LLVMInst.Instruction.ICmp(result_val, pred, lhs_val, rhs_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_zext_op(result_name: String, src_name: String): String {
        var src_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(src_name, LLVMTypes.Type.I1)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.ZExt(result_val, src_val, LLVMTypes.Type.I64)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_trunc(result_name: String, val_name: String, from_type: String, to_type: String): String {
        var from_ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (from_type == "i32") { from_ty = LLVMTypes.Type.I32 }
        var to_ty: LLVMTypes.Type = LLVMTypes.Type.I1
        if (to_type == "i32") { to_ty = LLVMTypes.Type.I32 }
        else if (to_type == "i8") { to_ty = LLVMTypes.Type.I8 }
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, from_ty)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, to_ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Trunc(result_val, val_v, to_ty)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_br(target_label: String): String {
        var term: LLVMInst.Terminator = LLVMInst.Terminator.Br(target_label)
        var lib_ir: String = LLVMInst.format_terminator(term)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_cond_br(cond_name: String, then_label: String, else_label: String): String {
        var cond_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(cond_name, LLVMTypes.Type.I1)
        var term: LLVMInst.Terminator = LLVMInst.Terminator.CondBr(cond_val, then_label, else_label)
        var lib_ir: String = LLVMInst.format_terminator(term)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_call(result_name: String, ret_type: String, fn_name: String, args_str: String): String {
        var ret_ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (ret_type == "void") { ret_ty = LLVMTypes.Type.Void }
        else if (ret_type == "i1") { ret_ty = LLVMTypes.Type.I1 }
        else if (ret_type == "i32") { ret_ty = LLVMTypes.Type.I32 }
        else if (ret_type == "ptr") { ret_ty = LLVMTypes.Type.Ptr }
        var arg_vals: List<LLVMTypes.Value> = []
        if (args_str.length() > 0) {
            var arg_parts: List<String> = args_str.split(", ")
            var ai: Float = 0
            while (ai < arg_parts.length()) {
                var part: String = arg_parts[ai]
                var space_idx: Float = part.index_of(" ")
                if (space_idx > 0) {
                    var arg_name: String = part.slice(space_idx + 1, part.length())
                    arg_vals.push(LLVMTypes.Value.Instruction(arg_name, LLVMTypes.Type.I64))
                }
                ai = ai + 1
            }
        }
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, ret_ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Call(result_val, fn_name, ret_ty, arg_vals)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_ptrtoint(result_name: String, val_name: String): String {
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, LLVMTypes.Type.Ptr)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.I64)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.PtrToInt(result_val, val_v, LLVMTypes.Type.I64)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_inttoptr(result_name: String, val_name: String): String {
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, LLVMTypes.Type.I64)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.IntToPtr(result_val, val_v, LLVMTypes.Type.Ptr)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_alloca(result_name: String, type_str: String): String {
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Alloca(result_val, ty, "")
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_load(result_name: String, type_str: String, ptr_name: String): String {
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var ptr_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(ptr_name, LLVMTypes.Type.Ptr)
        var result_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(result_name, ty)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Load(result_val, ty, ptr_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    fun lib_store(val_name: String, type_str: String, ptr_name: String): String {
        var ty: LLVMTypes.Type = LLVMTypes.Type.I64
        if (type_str == "i1") { ty = LLVMTypes.Type.I1 }
        else if (type_str == "i8") { ty = LLVMTypes.Type.I8 }
        else if (type_str == "i32") { ty = LLVMTypes.Type.I32 }
        var val_v: LLVMTypes.Value = LLVMTypes.Value.Instruction(val_name, ty)
        var ptr_val: LLVMTypes.Value = LLVMTypes.Value.Instruction(ptr_name, LLVMTypes.Type.Ptr)
        var inst: LLVMInst.Instruction = LLVMInst.Instruction.Store(val_v, ptr_val)
        var lib_ir: String = LLVMInst.format_instruction(inst, true)
        return lib_ir.slice(2, lib_ir.length())
    }

    /// Extract the register name from an arg string like "i64 %1" -> "%1"
    fun extract_arg_reg(arg_str: String): String {
        // arg_str is e.g. "i64 %3" or "i64 0"
        var space_idx: Float = arg_str.index_of(" ")
        if (space_idx >= 0) {
            return arg_str.slice(space_idx + 1, arg_str.length())
        }
        return arg_str
    }

    // --- Statement codegen ---

    // @codegen-split: output
    fun gen_function(name: String, params: String, ret_type: String, body: List<AST.Stmt>) {
        var emit_name: String = this.current_prefix + name
        if (name == "main") {
            emit_name = "__saffron_main"
            this.known_functions.push("main")
        } else if (name.contains("__lambda")) {
            emit_name = name
        }
        this.known_functions.push(emit_name)
        this.func_ret_types.set(emit_name, this.str_to_type(ret_type))
        if (this.current_prefix.length() > 0) {
            this.func_ret_types.set(name, this.str_to_type(ret_type))
            this.func_prefix_map.set(name, emit_name)
        }
        this.current_function_name = name
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,emit_name)) {
            if (this.current_prefix.length() == 0 and !emit_name.contains("__lambda")) {


            }
            return
        }
        this.defined_funcs.push(emit_name)
        var is_nested: Bool = this.in_function

        // For nested functions: hoist as regular function with captures as extra params
        if (is_nested) {
            var param_names: List<String> = []
            if (params.length() > 0) {
                var pl: List<String> = this.split_respecting_generics(params, ",")
                var pi2: Float = 0
                while (pi2 < pl.length()) {
                    var pp: List<String> = pl[pi2].split(":")
                    param_names.push(pp[0])
                    pi2 = pi2 + 1
                }
            }
            var captures_raw: List<String> = []
            this.find_free_vars_stmts(body, param_names, captures_raw)
            // Deduplicate captures (find_free_vars may report the same var multiple times)
            var captures: List<String> = []
            var cdi: Float = 0
            while (cdi < captures_raw.length()) {
                var already: Bool = false
                var cdj: Float = 0
                while (cdj < captures.length()) {
                    if (captures[cdj] == captures_raw[cdi]) {
                        already = true
                    }
                    cdj = cdj + 1
                }
                // Also skip if it's already a declared parameter
                var is_param: Bool = false
                var cdp: Float = 0
                while (cdp < param_names.length()) {
                    if (param_names[cdp] == captures_raw[cdi]) { is_param = true }
                    cdp = cdp + 1
                }
                if (!already and !is_param) {
                    captures.push(captures_raw[cdi])
                }
                cdi = cdi + 1
            }

            // Build extended params: captures (with actual types from parent) + original params
            var full_params: String = ""
            var ci2: Float = 0
            while (ci2 < captures.length()) {
                if (full_params.length() > 0) { full_params = full_params + "," }
                var cap_type: String = this.get_var_type_str(captures[ci2])
                if (cap_type.length() == 0) {
                    cap_type = "Int"
                }
                full_params = full_params + captures[ci2] + ":" + cap_type
                ci2 = ci2 + 1
            }
            if (params.length() > 0) {
                if (full_params.length() > 0) { full_params = full_params + "," }
                full_params = full_params + params
            }

            // Record capture info for call sites
            this.called_function_arity.set("__captures_" + emit_name, captures.length())
            this.func_prefix_map.set("__caps_" + emit_name, captures.join(","))

            // Save state and emit hoisted function
            var saved_sb2: StringBuilder = this.sb
            var saved_terminated2: Bool = this.block_terminated
            var saved_counter2: Float = this.local_counter
            var saved_typed_vars2: Map<String, AST.Type> = this.typed_vars
            var saved_gc_root_count2: Float = this.gc_root_count

            this.sb = StringBuilder()
            this.in_function = true
            this.typed_vars = {}
            this.string_vars = []
            this.gc_root_count = 0
            this.reset_locals()
            var ret_llvm2: String = this.llvm_type(ret_type)
            var all_params: List<String> = []
            if (full_params.length() > 0) {
                all_params = this.split_respecting_generics(full_params, ",")
            }
            var param_strs2: List<String> = []
            var pi3: Float = 0
            while (pi3 < all_params.length()) {
                var pp2: List<String> = all_params[pi3].split(":")
                param_strs2.push("i64 %" + this.sanitize_name(pp2[0]) + ".arg")
                pi3 = pi3 + 1
            }
            var linkage2: String = "define"
            if (this.current_prefix.length() > 0 and this.target != "wasm" and this.target != "wasm64" and this.target != "wasm32") { linkage2 = "define linkonce_odr" }
            this.emit("")
            this.emit(linkage2 + " " + ret_llvm2 + " @" + emit_name + "(" + param_strs2.join(", ") + ") {")
            this.emit("entry:")
            this.block_terminated = false
            pi3 = 0
            while (pi3 < all_params.length()) {
                var pp2: List<String> = all_params[pi3].split(":")
                if (pi3 < captures.length()) {
                    // Capture params are POINTERS — reconstruct via inttoptr
                    if (this.target == "wasm32" or this.target == "wasm") {
                        var __cap_i32: String = this.fresh_local()
                        this.emit_indent(__cap_i32 + " = trunc i64 %" + this.sanitize_name(pp2[0]) + ".arg to i32")
                        this.emit_indent("%" + this.sanitize_name(pp2[0]) + " = inttoptr i32 " + __cap_i32 + " to i64*")
                    } else {
                        this.emit_indent("%" + this.sanitize_name(pp2[0]) + " = inttoptr i64 %" + this.sanitize_name(pp2[0]) + ".arg to i64*")
                    }
                } else {
                    // Regular params — alloca and store
                    this.emit_indent("%" + this.sanitize_name(pp2[0]) + " = alloca i64")
                    this.emit_indent("store i64 %" + this.sanitize_name(pp2[0]) + ".arg, i64* %" + this.sanitize_name(pp2[0]))
                }
                this.typed_vars.set(pp2[0], this.str_to_type(pp2[1]))
                pi3 = pi3 + 1
            }
            var var_names2: List<String> = []
            var var_types2: List<String> = []
            this.collect_vars(body, var_names2, var_types2)
            // Track which names already have allocas (from params above)
            var allocated: List<String> = []
            var aai: Float = 0
            while (aai < all_params.length()) {
                var aap: List<String> = all_params[aai].split(":")
                allocated.push(aap[0])
                aai = aai + 1
            }
            pi3 = 0
            while (pi3 < var_names2.length()) {
                var vn2: String = var_names2[pi3]
                var already_alloc: Bool = false
                var aaj: Float = 0
                while (aaj < allocated.length()) {
                    if (allocated[aaj] == vn2) { already_alloc = true }
                    aaj = aaj + 1
                }
                if (!already_alloc) {
                    this.emit_indent("%" + this.sanitize_name(vn2) + " = alloca i64")
                    allocated.push(vn2)
                }
                pi3 = pi3 + 1
            }
            this.gen_stmts(body)
            if (!this.block_terminated) { this.emit_indent("ret i64 0") }
            this.emit("}")
            this.block_terminated = false

            var nested_ir: String = this.sb.to_string()
            this.sb = saved_sb2
            this.block_terminated = saved_terminated2
            this.local_counter = saved_counter2
            this.typed_vars = saved_typed_vars2
            this.gc_root_count = saved_gc_root_count2
            this.globals.push(nested_ir)
            return
        }

        this.in_function = true
        var saved_tv: Map<String, AST.Type> = this.typed_vars
        var saved_is_coro: Bool = this.is_coroutine
        this.reset_locals()
        this.string_vars = []
        this.typed_vars = {}
        var ret_llvm: String = this.llvm_type(ret_type)

        // Parse params string "name:type,name:type"
        var param_list: List<String> = []
        if (params.length() > 0) {
            param_list = this.split_respecting_generics(params, ",")
        }

        var param_strs: List<String> = []
        var i: Float = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            param_strs.push(this.llvm_type(ptype) + " %" + this.sanitize_name(pname) + ".arg")
            i = i + 1
        }
        // Register param names for named argument dispatch
        var pnames_list: List<String> = []
        var pni: Float = 0
        while (pni < param_list.length()) {
            var pnparts: List<String> = param_list[pni].split(":")
            pnames_list.push(pnparts[0])
            pni = pni + 1
        }
        this.func_param_names.set(emit_name, pnames_list)

        // --- LLVM lib: create FunctionBuilder in parallel ---
        // Build a parallel LLVM Module representation alongside string emission.
        // We create the FunctionBuilder + BlockBuilder so that gen_expr can record
        // LLVM instructions in parallel with string emission.
        // At the end of generate(), llvm_module.emit_ir() validates the structure.
        if (this.use_llvm_lib and !this.identity_mode) {
            var llvm_params: List<LLVMFunc.Param> = []
            var lpi: Float = 0
            while (lpi < param_list.length()) {
                var lp_parts: List<String> = param_list[lpi].split(":")
                var lp_name: String = "%" + this.sanitize_name(lp_parts[0]) + ".arg"
                var lp: LLVMFunc.Param = LLVMFunc.Param(lp_name, LLVMTypes.Type.I64)
                // Workaround: gen2 doesn't emit init calls for cross-module constructors
                lp.init(lp_name, LLVMTypes.Type.I64)
                llvm_params.push(lp)
                lpi = lpi + 1
            }
            this.llvm_func_builder = this.llvm_module.add_function(emit_name, LLVMTypes.Type.I64, llvm_params)
            var llvm_entry: LLVMFunc.BasicBlock = this.llvm_func_builder.entry_block()
            this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_entry)
            this.llvm_block_builder.init(this.llvm_func_builder, llvm_entry)
        }

        // Check if this function is a coroutine (direct or transitive)
        var is_coro: Bool = this.str_in_list(this.coroutine_funcs,emit_name)
        if (!is_coro) { is_coro = this.stmts_have_yield(body) }
        if (!is_coro) {
            // Check if body calls any known coroutine (transitive)
            var body_calls: List<String> = []
            this.collect_calls_from_stmts(body, body_calls)
            var bci: Float = 0
            while (bci < body_calls.length()) {
                var bc: String = body_calls[bci]
                if (this.str_in_list(this.coroutine_funcs,bc) or this.str_in_list(this.coroutine_funcs,this.current_prefix + bc)) {
                    is_coro = true
                    bci = body_calls.length()
                }
                bci = bci + 1
            }
        }
        if (is_coro and !this.str_in_list(this.coroutine_funcs,emit_name)) {
            this.coroutine_funcs.push(emit_name)
        }
        this.is_coroutine = is_coro

        this.emit("")
        var linkage: String = "define"
        if (this.current_prefix.length() > 0) {
            // On WASM targets, linkonce_odr breaks indirect calls through function table
            // index mismatch after linker deduplication. Use plain define with module-prefixed
            // names to ensure each function has a stable table entry.
            if (this.target != "wasm" and this.target != "wasm64" and this.target != "wasm32") {
                linkage = "define linkonce_odr"
            }
        }
        var coro_attr: String = ""
        if (is_coro) { coro_attr = " presplitcoroutine" }
        var inline_attr: String = ""
        if (!is_coro and this.str_in_list(this.inline_funcs, emit_name)) {
            inline_attr = " alwaysinline"
        }
        var ret_type_ll: String = ret_llvm
        if (is_coro) { ret_type_ll = "ptr" }
        this.emit(linkage + " " + ret_type_ll + " @" + emit_name + "(" + param_strs.join(", ") + ")" + coro_attr + inline_attr + " {")
        this.emit("entry:")
        this.block_terminated = false

        // Coroutine preamble
        if (is_coro) {
            this.emit_indent("%__coro_id = call token @llvm.coro.id(i32 0, ptr null, ptr null, ptr null)")
            this.emit_indent("%__coro_size = call i64 @llvm.coro.size.i64()")
            this.emit_indent("%__coro_mem = call ptr @malloc(i64 %__coro_size)")
            this.emit_indent("%__coro_hdl = call ptr @llvm.coro.begin(token %__coro_id, ptr %__coro_mem)")
        }

        // Collect all local variable declarations from body
        var var_names: List<String> = []
        var var_types: List<String> = []
        this.collect_vars(body, var_names, var_types)

        // Emit all allocas in entry block (params + locals)
        i = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            this.emit_indent("%" + this.sanitize_name(pname) + " = alloca " + this.llvm_type(ptype))
            i = i + 1
        }
        i = 0
        while (i < var_names.length()) {
            var vn: String = var_names[i]
            if (!this.module_globals.has(this.current_prefix + vn) and vn != "self") {
                this.emit_indent("%" + this.sanitize_name(vn) + " = alloca " + this.llvm_type(var_types[i]))
                // Zero-initialize allocas for heap-typed locals before they become GC roots.
                // This prevents the GC from reading uninitialized memory if it triggers
                // between push_root and the first real store to this variable.
                if (!this.identity_mode and this.is_gc_root_type(var_types[i])) {
                    this.emit_indent("store i64 0, i64* %" + this.sanitize_name(vn))
                }
            }
            i = i + 1
        }

        // Store params into their allocas and track types
        i = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            this.typed_vars.set(pname, this.str_to_type(ptype))
            if (ptype == "String") {
                this.string_vars.push(pname)
            }
            this.emit_indent("store i64 %" + this.sanitize_name(pname) + ".arg, i64* %" + this.sanitize_name(pname))
            i = i + 1
        }

        // GC root tracking: push alloca addresses for heap-typed locals
        // Only emit when not in identity mode (bootstrap doesn't need GC)
        var gc_root_count: Float = 0
        if (!this.identity_mode) {
            // Track params that are heap types
            i = 0
            while (i < param_list.length()) {
                var parts: List<String> = param_list[i].split(":")
                var pname: String = parts[0]
                var ptype: String = parts[1]
                if (this.is_gc_root_type(ptype)) {
                    var alloca_as_int: String = this.typed_ptr_to_val("%" + this.sanitize_name(pname), "i64*")
                    this.emit_indent("call void @__gc_push_root(i64 " + alloca_as_int + ")")
                    gc_root_count = gc_root_count + 1
                }
                i = i + 1
            }
            // Track locals that are heap types
            i = 0
            while (i < var_names.length()) {
                var vn: String = var_names[i]
                var vt: String = var_types[i]
                if (!this.module_globals.has(this.current_prefix + vn) and vn != "self" and this.is_gc_root_type(vt)) {
                    var loc_as_int: String = this.typed_ptr_to_val("%" + this.sanitize_name(vn), "i64*")
                    this.emit_indent("call void @__gc_push_root(i64 " + loc_as_int + ")")
                    gc_root_count = gc_root_count + 1
                }
                i = i + 1
            }
        }
        this.gc_root_count = gc_root_count

        // Generate body statements, treating last ExprStmt as implicit return
        if (body.length() > 0 and ret_type != "Nil" and ret_type != "void") {
            var last_stmt: AST.Stmt = body[body.length() - 1]
            var last_kind: String = this.classify_stmt(last_stmt)
            if (last_kind == "expr") {
                var bi: Float = 0
                while (bi < body.length() - 1) {
                    this.gen_stmt(body[bi])
                    bi = bi + 1
                }
                var last_expr: AST.Expr = match (last_stmt) { ExprStmt(e) => e
                    _ => AST.Expr.NilLit
                }
                var last_val: String = this.gen_arg_value(last_expr)
                if (!this.block_terminated) {
                    if (is_coro) {
                        this.emit_terminator("br label %__coro_final")
                    } else {
                        if (gc_root_count > 0) {
                            this.emit_indent("call void @__gc_pop_roots(i64 " + gc_root_count.floor().to_string() + ")")
                        }
                        this.emit_terminator("ret i64 " + last_val)
                    }
                }
            } else {
                this.gen_stmts(body)
            }
        } else {
            this.gen_stmts(body)
        }

        // Non-coro: ensure block has a terminator
        if (!is_coro) {
            if (!this.block_terminated) {
                if (gc_root_count > 0) {
                    this.emit_indent("call void @__gc_pop_roots(i64 " + gc_root_count.floor().to_string() + ")")
                }
                if (ret_llvm == "void") {
                    this.emit_terminator("ret void")
                } else {
                    this.emit_terminator("ret i64 0")
                }
            }
        }

        // Coroutine epilogue: final suspend + cleanup
        if (is_coro) {
            if (!this.block_terminated) {
                this.emit_terminator("br label %__coro_final")
            }

            this.emit("__coro_final:")
            this.block_terminated = false
            this.emit_indent("%__coro_fs_tok = call token @llvm.coro.save(ptr %__coro_hdl)")
            this.emit_indent("%__coro_fs = call i8 @llvm.coro.suspend(token %__coro_fs_tok, i1 true)")
            this.emit_indent("switch i8 %__coro_fs, label %__coro_suspend [i8 0, label %__coro_trap i8 1, label %__coro_cleanup]")

            this.emit("__coro_trap:")
            this.block_terminated = false
            this.emit_terminator("unreachable")

            this.emit("__coro_cleanup:")
            this.block_terminated = false
            this.emit_indent("%__coro_free = call ptr @llvm.coro.free(token %__coro_id, ptr %__coro_hdl)")
            this.emit_indent("call void @free(ptr %__coro_free)")
            this.emit_terminator("br label %__coro_suspend")

            this.emit("__coro_suspend:")
            this.block_terminated = false
            this.emit_indent("call i1 @llvm.coro.end(ptr %__coro_hdl, i1 false)")
            this.emit_terminator("ret ptr %__coro_hdl")
        }

        this.emit("}")
        this.block_terminated = false
        this.typed_vars = saved_tv
        this.in_function = false
        this.is_coroutine = saved_is_coro
    }

    // --- Top-level ---

    fun is_nil_expr(e: AST.Expr): Bool {
        var k: String = this.classify_expr(e)
        return k == "nil"
    }

    fun is_nil_expr_stmt(stmt: AST.Stmt): Bool {
        var sk: String = this.classify_stmt(stmt)
        if (sk != "expr") { return false }
        var e: AST.Expr = match (stmt) { ExprStmt(ex) => ex
            _ => AST.Expr.IntLit(1)
        }
        return this.is_nil_expr(e)
    }

    fun is_decl(stmt: AST.Stmt): Bool {
        return match (stmt) {
            FunDecl(n, p, r, b, d) => true
            EnumDecl(n, v, d) => true
            ClassDecl(n, p, f, m, d) => true
            ExprStmt(e) => this.is_nil_expr(e)
            VarDecl(n, t, i, d) => d.starts_with("@import:")
            Return(v) => false
            If(c, t, e) => false
            While(c, b) => false
            Block(s) => false
            Break => false
            Continue => false
            TryCatch(t, n, c, f) => false
            Throw(v) => false
            LetPattern(p, v) => false
        }
    }

    fun generate(program: List<AST.Stmt>): String {
        // Register runtime functions (defined in runtime.ll, declared via runtime_declares())
        this.known_functions.push("StringBuilder")
        this.known_functions.push("__list_new")
        this.known_functions.push("__list_push")
        this.known_functions.push("__list_get")
        this.known_functions.push("__list_set")
        this.known_functions.push("__list_length")
        this.known_functions.push("__list_pop")
        this.known_functions.push("__sb_append")
        this.known_functions.push("__sb_to_string")
        this.known_functions.push("__safe_strcmp")
        this.known_functions.push("__map_new")
        this.known_functions.push("__map_set")
        this.known_functions.push("__map_get")
        this.known_functions.push("__map_has")
        this.known_functions.push("__map_keys")
        this.known_functions.push("__str_ends_with")
        this.known_functions.push("__str_split")
        this.known_functions.push("__str_replace")
        this.known_functions.push("__int_to_string")
        this.known_functions.push("__list_join")
        this.known_functions.push("__join_append")
        this.known_functions.push("__list_contains")
        this.known_functions.push("__io_read_file")
        this.known_functions.push("__io_write_file")
        this.known_functions.push("__io_file_exists")
        this.known_functions.push("__io_mkdir")
        this.known_functions.push("__io_walk_dir")
        this.known_functions.push("__io_append_file")
        this.known_functions.push("__os_exec")
        this.known_functions.push("__os_args")
        this.known_functions.push("__os_cwd")
        this.known_functions.push("__os_path_sep")
        this.known_functions.push("__os_platform")
        this.known_functions.push("__os_env")
        this.known_functions.push("__runtime_error")
        this.known_functions.push("__runtime_error_fatal")
        this.known_functions.push("__null_pointer_error")
        this.known_functions.push("__division_error")
        // NaN-boxing helpers (declared in runtime_declares, defined in base*.ll)
        this.known_functions.push("__val_tag_int")
        this.known_functions.push("__val_untag_int")
        this.known_functions.push("__val_tag_ptr")
        this.known_functions.push("__val_untag_ptr")
        this.known_functions.push("__val_tag_float")
        this.known_functions.push("__val_untag_float")
        this.known_functions.push("__val_tag_bool")
        this.known_functions.push("__val_untag_bool")
        this.known_functions.push("__rt_tag_ptr")
        // GC runtime functions
        this.known_functions.push("__gc_enable")
        this.known_functions.push("__gc_disable")
        this.known_functions.push("__gc_collect")
        this.known_functions.push("__gc_set_threshold")
        this.known_functions.push("__gc_stat_alloc_count")
        this.known_functions.push("__gc_stat_total_bytes")
        this.known_functions.push("__gc_stat_collections")
        this.known_functions.push("__gc_stat_freed_bytes")
        this.known_functions.push("__gc_stat_threshold")
        this.known_functions.push("__gc_debug_stats")
        this.known_functions.push("__gc_alloc")
        this.known_functions.push("__gc_alloc_zeroed")
        this.known_functions.push("__gc_realloc")
        this.known_functions.push("__gc_push_root")
        this.known_functions.push("__gc_pop_roots")
        this.known_functions.push("__gc_shadow_stack_depth")
        this.known_functions.push("__gc_list_new")
        this.known_functions.push("__gc_list_push")
        this.known_functions.push("__gc_map_new")
        this.known_functions.push("__gc_stringbuilder_new")
        this.known_functions.push("__gc_string_alloc")
        this.known_functions.push("__gc_closure_new")
        this.known_functions.push("__gc_env_alloc")
        this.known_functions.push("__gc_instance_alloc")
        this.func_ret_types.set("StringBuilder", this.str_to_type("StringBuilder"))

        // Pre-scan: register extension methods before compilation
        var ei: Float = 0
        while (ei < program.length()) {
            var edoc: String = this.get_fun_doc(program[ei])
            if (edoc.starts_with("@extend:")) {
                var ename: String = this.get_fun_name(program[ei])
                var ecls: String = edoc.slice(8, edoc.length())
                this.extend_map.set(this.current_prefix + ename, ecls)
            }
            ei = ei + 1
        }

        // Pre-registration pass: add all declaration names to known_functions
        // BEFORE compiling any bodies, so forward references don't trigger warnings
        var pri: Float = 0
        while (pri < program.length()) {
            var pr_stmt: AST.Stmt = program[pri]
            match (pr_stmt) {
                FunDecl(pr_name, pr_params, pr_ret, pr_body, pr_doc) => {
                    if (pr_name.length() > 0) {
                        var pr_emit: String = this.current_prefix + pr_name
                        if (!this.str_in_list(this.known_functions,pr_emit)) {
                            this.known_functions.push(pr_emit)
                        }
                        if (this.current_prefix.length() > 0 and !this.str_in_list(this.known_functions,pr_name)) {
                            this.known_functions.push(pr_name)
                        }
                    }
                }
                ClassDecl(pr_cname, pr_parent, pr_fields, pr_methods, pr_doc) => {
                    // Register the class constructor name
                    var pr_type_name: String = pr_cname
                    if (this.current_prefix.length() > 0) {
                        pr_type_name = this.current_prefix + pr_cname
                    }
                    if (!this.str_in_list(this.known_functions,pr_type_name)) {
                        this.known_functions.push(pr_type_name)
                    }
                    if (!this.str_in_list(this.known_functions,pr_cname)) {
                        this.known_functions.push(pr_cname)
                    }
                    // Register all method names as ClassName__method
                    var pr_mi: Float = 0
                    while (pr_mi < pr_methods.length()) {
                        var pr_mname: String = this.get_fun_name(pr_methods[pr_mi])
                        if (pr_mname.length() > 0) {
                            var pr_full: String = pr_cname + "__" + pr_mname
                            var pr_prefixed: String = this.current_prefix + pr_full
                            if (!this.str_in_list(this.known_functions,pr_full)) {
                                this.known_functions.push(pr_full)
                            }
                            if (!this.str_in_list(this.known_functions,pr_prefixed)) {
                                this.known_functions.push(pr_prefixed)
                            }
                        }
                        pr_mi = pr_mi + 1
                    }
                }
                EnumDecl(pr_ename, pr_variants, pr_edoc) => {
                    // Register enum variant constructor names AND variant tags
                    // so that match expressions work regardless of declaration order
                    var pr_vnames: List<String> = []
                    var pr_vi: Float = 0
                    while (pr_vi < pr_variants.length()) {
                        var pr_vname: String = this.get_variant_name(pr_variants[pr_vi])
                        var pr_vfields: String = this.get_variant_fields(pr_variants[pr_vi])
                        if (pr_vname.length() > 0) {
                            if (!this.str_in_list(this.known_functions,pr_vname)) {
                                this.known_functions.push(pr_vname)
                            }
                            pr_vnames.push(pr_vname)
                            this.enum_variant_tags.set(pr_ename + "." + pr_vname, pr_vi)
                            this.enum_variant_fields.set(pr_ename + "." + pr_vname, pr_vfields)
                        }
                        pr_vi = pr_vi + 1
                    }
                    this.enum_defs.set(pr_ename, pr_vnames)
                }
                VarDecl(n, t, init, d) => {}
                ExprStmt(e) => {}
                Return(v) => {}
                If(c, t, e) => {}
                While(c, b) => {}
                Block(s) => {}
                Break => {}
                Continue => {}
                TryCatch(t, n, c, f) => {}
                Throw(v) => {}
                LetPattern(p, v) => {}
            }
            pri = pri + 1
        }

        // Coroutine detection: mark functions containing yield (direct or transitive)
        this.mark_coroutines(program)

        // First pass: emit all declarations (functions, enums, classes)
        var i: Float = 0
        while (i < program.length()) {
            var stmt: AST.Stmt = program[i]
            if (this.is_decl(stmt)) {
                // Set pending_extend_class from pre-scanned map before gen_stmt
                var fn_name: String = this.get_fun_name(stmt)
                if (fn_name.length() > 0 and this.extend_map.has(this.current_prefix + fn_name)) {
                    this.pending_extend_class = this.extend_map.get(this.current_prefix + fn_name)
                } else {
                    this.pending_extend_class = ""
                }
                this.gen_stmt(stmt)
            }
            i = i + 1
        }

        // Emit reflect helper functions (only in non-identity mode)
        if (!this.identity_mode) {
            this.emit_reflect_helpers()
        }

        // Second pass: wrap top-level statements in __saffron_entry
        var has_top_level: Bool = false
        i = 0
        while (i < program.length()) {
            if (!this.is_decl(program[i])) {
                has_top_level = true
            }
            i = i + 1
        }
        if (has_top_level) {
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            i = 0
            while (i < program.length()) {
                if (!this.is_decl(program[i])) {
                    var stmts: List<AST.Stmt> = []
                    stmts.push(program[i])
                    this.collect_vars(stmts, top_vars, top_var_types)
                }
                i = i + 1
            }
            // Only make entry a coroutine if the top-level statements actually
            // call a coroutine function or contain yield. Merely importing a module
            // that defines coroutines (e.g. @async) should NOT force the entry to be
            // a coroutine — that causes scheduler_run() to hang when there's nothing
            // to schedule.
            var entry_is_coro: Bool = false
            var entry_stmts: List<AST.Stmt> = []
            var es_i: Float = 0
            while (es_i < program.length()) {
                if (!this.is_decl(program[es_i])) {
                    entry_stmts.push(program[es_i])
                }
                es_i = es_i + 1
            }
            if (this.stmts_have_yield(entry_stmts)) {
                entry_is_coro = true
            }
            if (!entry_is_coro) {
                var entry_calls: List<String> = []
                this.collect_calls_from_stmts(entry_stmts, entry_calls)
                var ec_i: Float = 0
                while (ec_i < entry_calls.length()) {
                    var ec: String = entry_calls[ec_i]
                    if (this.str_in_list(this.coroutine_funcs, ec) or this.str_in_list(this.coroutine_funcs, this.current_prefix + ec)) {
                        entry_is_coro = true
                        ec_i = entry_calls.length()
                    }
                    ec_i = ec_i + 1
                }
            }
            this.emit("")
            if (entry_is_coro) {
                this.is_coroutine = true
                this.emit("define ptr @__saffron_entry() optnone noinline presplitcoroutine {")
            } else {
                this.emit("define i64 @__saffron_entry() {")
            }
            this.emit("entry:")
            this.block_terminated = false
            this.reset_locals()
            this.in_function = true
            // LLVM lib: create FunctionBuilder for __saffron_entry
            if (this.use_llvm_lib and !this.identity_mode) {
                var llvm_entry_params: List<LLVMFunc.Param> = []
                this.llvm_func_builder = this.llvm_module.add_function("__saffron_entry", LLVMTypes.Type.I64, llvm_entry_params)
                var llvm_entry_bb: LLVMFunc.BasicBlock = this.llvm_func_builder.entry_block()
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_entry_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_entry_bb)
            }
            if (entry_is_coro) {
                this.emit_indent("%__coro_id = call token @llvm.coro.id(i32 0, ptr null, ptr null, ptr null)")
                this.emit_indent("%__coro_size = call i64 @llvm.coro.size.i64()")
                this.emit_indent("%__coro_mem = call ptr @malloc(i64 %__coro_size)")
                this.emit_indent("%__coro_hdl = call ptr @llvm.coro.begin(token %__coro_id, ptr %__coro_mem)")
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                if (!this.module_globals.has(this.current_prefix + top_vars[vi]) and !this.module_globals.has(top_vars[vi])) {
                    this.emit_indent("%" + this.sanitize_name(top_vars[vi]) + " = alloca i64")
                }
                vi = vi + 1
            }
            if (!this.identity_mode) {
                this.emit_indent("call void @__gc_enable()")
                vi = 0
                while (vi < top_vars.length()) {
                    var tv_type: String = top_var_types[vi]
                    if (this.is_gc_root_type(tv_type)) {
                        var tv_name: String = top_vars[vi]
                        var tv_as_int: String = ""
                        if (this.module_globals.has(this.current_prefix + tv_name)) {
                            tv_as_int = this.typed_ptr_to_val("@__g_" + this.current_prefix + this.sanitize_name(tv_name), "i64*")
                        } else {
                            tv_as_int = this.typed_ptr_to_val("%" + this.sanitize_name(tv_name), "i64*")
                        }
                        this.emit_indent("call void @__gc_push_root(i64 " + tv_as_int + ")")
                    }
                    vi = vi + 1
                }
            }
            // Call module init functions before user code
            var mi2: Float = 0
            while (mi2 < this.module_init_names.length()) {
                this.emit_indent("call i64 @" + this.module_init_names[mi2] + "()")
                mi2 = mi2 + 1
            }
            i = 0
            while (i < program.length()) {
                if (!this.is_decl(program[i])) {
                    this.gen_stmt(program[i])
                }
                i = i + 1
            }
            // Epilogue
            if (entry_is_coro) {
                if (!this.block_terminated) {
                    this.emit_terminator("br label %__coro_final")
                }
                this.emit("__coro_final:")
                this.block_terminated = false
                this.emit_indent("%__coro_fs_tok = call token @llvm.coro.save(ptr %__coro_hdl)")
                this.emit_indent("%__coro_fs = call i8 @llvm.coro.suspend(token %__coro_fs_tok, i1 true)")
                this.emit_indent("switch i8 %__coro_fs, label %__coro_suspend [i8 0, label %__coro_trap i8 1, label %__coro_cleanup]")
                this.emit("__coro_trap:")
                this.block_terminated = false
                this.emit_terminator("unreachable")
                this.emit("__coro_cleanup:")
                this.block_terminated = false
                this.emit_indent("%__coro_free = call ptr @llvm.coro.free(token %__coro_id, ptr %__coro_hdl)")
                this.emit_indent("call void @free(ptr %__coro_free)")
                this.emit_terminator("br label %__coro_suspend")
                this.emit("__coro_suspend:")
                this.block_terminated = false
                this.emit_indent("call i1 @llvm.coro.end(ptr %__coro_hdl, i1 false)")
                this.emit_terminator("ret ptr %__coro_hdl")
                this.is_coroutine = false
            } else {
                if (!this.block_terminated) {
                    this.emit_terminator("ret i64 0")
                }
            }
            this.emit("}")
            this.block_terminated = false
            this.in_function = false
        }

        // Build final output with proper ordering
        var out: StringBuilder = StringBuilder()
        out.append("; Generated by Saffron LLVM compiler\n")
        if (this.target == "wasm32" or this.target == "wasm") {
            out.append("target triple = \"wasm32-unknown-unknown\"\n")
            out.append("target datalayout = \"e-m:e-p:32:32-i64:64-n32:64-S128\"\n\n")
        } else if (this.target == "wasm64") {
            out.append("target triple = \"wasm64-unknown-unknown\"\n")
            out.append("target datalayout = \"e-m:e-p:64:64-i64:64-n32:64-S128-ni:1:10:20\"\n\n")
        } else {
            out.append("target triple = \"arm64-apple-macosx15.0.0\"\n\n")
        }

        // String constants
        var j: Float = 0
        while (j < this.string_constants.length()) {
            var s: String = this.string_constants[j]
            var name: String = "@.str." + j.floor().to_string()
            var len: Float = s.length() + 1
            out.append(name + " = private unnamed_addr constant [" + len.to_string() + " x i8] c\"" + this.escape_llvm_string(s) + "\\00\"\n")
            j = j + 1
        }
        if (this.string_constants.length() > 0) {
            out.append("\n")
        }

        // Type definitions (enums as tagged unions)
        var td: String = this.type_defs.to_string()
        if (td.length() > 0) {
            out.append(td)
            out.append("\n")
        }

        // External declarations
        out.append("declare i32 @puts(i8*)\n")
        out.append("declare i32 @printf(i8*, ...)\n")
        out.append("declare i32 @snprintf(i8*, i64, i8*, ...)\n")
        out.append("declare i8* @malloc(i64)\n")
        out.append("declare i8* @realloc(i8*, i64)\n")
        out.append("declare void @free(i8*)\n")
        out.append("declare i64 @strlen(i8*)\n")
        out.append("declare i8* @strcpy(i8*, i8*)\n")
        out.append("declare i8* @strcat(i8*, i8*)\n")
        out.append("declare i8* @strstr(i8*, i8*)\n")
        out.append("declare i32 @strcmp(i8*, i8*)\n")
        out.append("declare i32 @strncmp(i8*, i8*, i64)\n")
        out.append("declare i64 @atol(i8*)\n")
        out.append("declare void @exit(i32)\n")
        out.append("declare i8* @fopen(i8*, i8*)\n")
        out.append("declare i64 @fread(i8*, i64, i64, i8*)\n")
        out.append("declare i64 @fwrite(i8*, i64, i64, i8*)\n")
        out.append("declare i32 @fclose(i8*)\n")
        out.append("declare i32 @fseek(i8*, i64, i32)\n")
        out.append("declare i64 @ftell(i8*)\n")
        out.append("declare i8* @strtok(i8*, i8*)\n")
        out.append("declare i32 @pclose(i8*)\n")
        out.append("declare i8* @popen(i8*, i8*)\n")
        out.append("declare i8* @fgets(i8*, i32, i8*)\n")
        out.append("declare void @llvm.memcpy.p0i8.p0i8.i64(i8*, i8*, i64, i1)\n")
        out.append("declare i32 @setjmp(i8*) returns_twice\n")
        out.append("declare void @longjmp(i8*, i32) noreturn\n")
        out.append("declare void @__io_println_str(i64)\n")
        out.append("declare void @__io_println_int(i64)\n")
        out.append("declare void @__io_println_bool(i64)\n")
        out.append("declare void @__io_println_nil()\n")
        out.append("declare void @__io_println_any(i64)\n")
        out.append("declare void @__io_print_str(i64)\n")
        out.append("declare void @__io_print_int(i64)\n")
        out.append("declare i64 @__any_to_string(i64)\n")
        out.append("declare i64 @__bool_to_string(i64)\n")
        out.append("declare i64 @__nil_to_string()\n\n")
        out.append("declare i64 @__float_to_string(i64)\n")
        out.append("declare i64 @__string_eq(i64, i64)\n")
        out.append("declare i64 @__string_ne(i64, i64)\n")
        out.append("declare i64 @__any_eq(i64, i64)\n")
        out.append("declare i64 @__any_ne(i64, i64)\n")
        out.append("declare i64 @__string_intern(i64)\n")
        if (!this.identity_mode) {
            out.append("; --- NaN-boxing value helpers ---\n")
            out.append("declare i64 @__val_tag_int(i64)\n")
            out.append("declare i64 @__val_untag_int(i64)\n")
            out.append("declare i64 @__val_tag_ptr(i8*)\n")
            out.append("declare i8* @__val_untag_ptr(i64)\n")
            out.append("declare i64 @__val_tag_float(double)\n")
            out.append("declare double @__val_untag_float(i64)\n")
            out.append("declare i64 @__val_tag_bool(i64)\n")
            out.append("declare i64 @__val_untag_bool(i64)\n")
            out.append("declare i64 @__rt_tag_ptr(i64)\n")
        }
        out.append("declare double @strtod(i8*, i8*)\n")
        out.append("declare double @llvm.floor.f64(double)\n\n")

        // Runtime error helpers (bodies in runtime.ll)
        if (!this.str_in_list(this.defined_funcs,"__runtime_error")) {
            out.append("declare i64 @__division_error()\n")
            out.append("declare i64 @__null_pointer_error()\n")
            out.append("declare i64 @__runtime_error(i64)\n")
            out.append("declare i64 @__runtime_error_fatal(i64)\n\n")
        }

        // Runtime string constants (linkonce_odr for multi-file linking)
        out.append("@.fmt.ld = linkonce_odr unnamed_addr constant [4 x i8] c\"%ld\\00\"\n")
        out.append("@.str.empty = linkonce_odr unnamed_addr constant [1 x i8] c\"\\00\"\n")
        out.append("@.str.rb = linkonce_odr unnamed_addr constant [2 x i8] c\"r\\00\"\n")
        out.append("@.str.wb = linkonce_odr unnamed_addr constant [2 x i8] c\"w\\00\"\n")
        out.append("@.str.r = linkonce_odr unnamed_addr constant [2 x i8] c\"r\\00\"\n")

        // Global argc/argv (set by main) — weak linkage for multi-file
        out.append("@__argc = weak global i32 0\n")
        out.append("@__argv = weak global i8** null\n")
        // Exception handling globals
        out.append("@__exception_value = weak global i64 0\n")
        out.append("@__jmp_buf_current = weak global i8* null\n\n")

        // Struct types + runtime function declarations (bodies in runtime.ll)
        out.append("; List = { count, capacity, data* }\n")
        out.append("%List = type { i64, i64, i64* }\n")
        out.append("; Map = { count, capacity, keys*, values* }\n")
        out.append("%Map = type { i64, i64, i64*, i64* }\n\n")
        out.append(this.runtime_declares())
        var ext_keys: List<String> = this.extern_sigs.keys()
        var ei: Float = 0
        var out_so_far: String = out.to_string()
        var extern_c_names: List<String> = []
        while (ei < ext_keys.length()) {
            var decl: String = this.emit_extern_declare(this.extern_sigs.get(ext_keys[ei]))
            var parsed_ext: List<String> = this.parse_extern_sig(this.extern_sigs.get(ext_keys[ei]))
            var c_fn_name: String = parsed_ext[0]
            extern_c_names.push(c_fn_name)
            if (!out_so_far.contains("@" + c_fn_name + "(")) {
                out.append(decl + "\n")
            }
            ei = ei + 1
        }

        // Lambda functions
        var k: Float = 0
        while (k < this.globals.length()) {
            out.append(this.globals[k])
            k = k + 1
        }

        // Function bodies
        out.append(this.sb.to_string())

        // Emit declares for external functions (called but not defined in this file)
        var declared: List<String> = []
        var ci: Float = 0
        while (ci < this.called_functions.length()) {
            var cfname: String = this.called_functions[ci]
            if (!this.str_in_list(this.known_functions,cfname) and !this.str_in_list(declared,cfname) and !this.str_in_list(this.defined_funcs,cfname) and !this.str_in_list(extern_c_names,cfname)) {
                var arity: Float = 1
                if (this.called_function_arity.has(cfname)) {
                    arity = this.called_function_arity.get(cfname)
                }
                var param_str: String = ""
                var pi: Float = 0
                while (pi < arity) {
                    if (pi > 0) { param_str = param_str + ", " }
                    param_str = param_str + "i64"
                    pi = pi + 1
                }
                out.append("declare i64 @" + cfname + "(" + param_str + ")\n")
                declared.push(cfname)
            }
            ci = ci + 1
        }
        if (declared.length() > 0) {
            out.append("\n")
        }

        // Only emit C main wrapper for native targets (not WASM).
        // For WASM, _start is provided by wasm_base.ll / wasm_base_32.ll and calls __saffron_entry.
        if (this.target != "wasm" and this.target != "wasm64" and this.target != "wasm32") {
            if (this.str_in_list(this.defined_funcs,"__saffron_main") or has_top_level) {
                out.append("\ndefine i32 @main(i32 %argc, i8** %argv) {\n")
                out.append("entry:\n")
                out.append("  store i32 %argc, i32* @__argc\n")
                out.append("  store i8** %argv, i8*** @__argv\n")
                if (has_top_level and entry_is_coro) {
                    // Async main: entry is a coroutine — enqueue and run scheduler
                    var enqueue_fn: String = "stdlib_scheduler_enqueue"
                    if (this.str_in_list(this.known_functions,"stdlib_scheduler_enqueue")) {
                        enqueue_fn = "stdlib_scheduler_enqueue"
                    }
                    var sched_fn: String = "stdlib_scheduler_scheduler_run"
                    if (this.str_in_list(this.known_functions,"stdlib_scheduler_scheduler_run")) {
                        sched_fn = "stdlib_scheduler_scheduler_run"
                    }
                    out.append("  %__entry_hdl = call ptr @__saffron_entry()\n")
                    out.append("  %__entry_i64 = ptrtoint ptr %__entry_hdl to i64\n")
                    out.append("  %__entry_done = call i64 @__sched_coro_done(i64 %__entry_i64)\n")
                    out.append("  %__entry_is_done = icmp eq i64 %__entry_done, 1\n")
                    out.append("  br i1 %__entry_is_done, label %__entry_skip, label %__entry_run\n")
                    out.append("__entry_run:\n")
                    out.append("  call i64 @" + enqueue_fn + "(i64 %__entry_i64)\n")
                    out.append("  call i64 @" + sched_fn + "()\n")
                    out.append("  br label %__entry_skip\n")
                    out.append("__entry_skip:\n")
                    out.append("  ret i32 0\n")
                } else if (has_top_level) {
                    out.append("  call i64 @__saffron_entry()\n")
                    out.append("  ret i32 0\n")
                } else {
                    // Call module init functions before __saffron_main
                    // (when has_top_level is true, inits are called inside __saffron_entry)
                    var mi3: Float = 0
                    while (mi3 < this.module_init_names.length()) {
                        out.append("  call i64 @" + this.module_init_names[mi3] + "()\n")
                        mi3 = mi3 + 1
                    }
                    if (this.str_in_list(this.coroutine_funcs,"__saffron_main")) {
                        // Async main: __saffron_main is a coroutine — enqueue and run scheduler
                        var enqueue_fn2: String = "stdlib_scheduler_enqueue"
                        if (this.str_in_list(this.known_functions,"stdlib_scheduler_enqueue")) {
                            enqueue_fn2 = "stdlib_scheduler_enqueue"
                        }
                        var sched_fn2: String = "stdlib_scheduler_scheduler_run"
                        if (this.str_in_list(this.known_functions,"stdlib_scheduler_scheduler_run")) {
                            sched_fn2 = "stdlib_scheduler_scheduler_run"
                        }
                        out.append("  %__main_hdl = call ptr @__saffron_main()\n")
                        out.append("  %__main_i64 = ptrtoint ptr %__main_hdl to i64\n")
                        out.append("  call i64 @" + enqueue_fn2 + "(i64 %__main_i64)\n")
                        out.append("  call i64 @" + sched_fn2 + "()\n")
                        out.append("  ret i32 0\n")
                    } else {
                        out.append("  %main_ret = call i64 @__saffron_main()\n")
                        out.append("  %exit_code = trunc i64 %main_ret to i32\n")
                        out.append("  ret i32 %exit_code\n")
                    }
                }
                out.append("}\n")
            }
        }

        // --- LLVM lib output ---
        // When emit_llvm_lib is set, return the LLVM Module IR instead of string emission.
        // This is activated by --emit-llvm-lib and produces structured IR from the
        // parallel LLVM Module that was built alongside string emission.
        if (this.emit_llvm_lib and this.use_llvm_lib and !this.identity_mode) {
            return this.llvm_module.emit_ir()
        }

        // --- LLVM lib verification (when not emitting as primary) ---
        // LLVM lib parallel validation (disabled — was causing pantry build to fail
        // because stdout output made Process.run think there was an error)
        // if (this.use_llvm_lib and !this.identity_mode and !this.emit_llvm_lib) {
        //     var llvm_ir_check: String = this.llvm_module.emit_ir()
        // }

        return out.to_string()
    }

    // @codegen-split: methods

    // @codegen-split: methods
    fun find_class_for_method(method: String): String {
    var keys: List<String> = this.class_methods.keys()
    var i: Float = 0
    var interface_fallback: String = ""
    while (i < keys.length()) {
        var class_name: String = keys[i]
        var methods: List = this.class_methods.get(class_name)
        if (methods.contains(method)) {
            // Skip built-in types (String, List, Map, etc.) that are registered
            // in class_methods but not in class_fields. Their methods are handled
            // by builtin method dispatch, not class method dispatch.
            if (!this.class_fields.has(class_name)) {
                i = i + 1
                continue
            }
            // Skip interfaces (classes with no fields) — prefer concrete classes.
            // Interfaces have empty class_fields and register stub methods.
            var cf: String = this.class_fields.get(class_name)
            if (cf.length() == 0) {
                // Could be an interface — save as fallback, keep searching
                if (interface_fallback.length() == 0) {
                    interface_fallback = class_name
                }
            } else {
                return class_name
            }
        }
        i = i + 1
    }
    return interface_fallback
    }

    fun get_method_ret(class_name: String, method: String): String {
    // All functions return i64 (no void) to avoid call type mismatches
    return "i64"
    }

    fun classify_expr(expr: AST.Expr): String {
    return match (expr) {
        MethodCall(o, m, a) => "method_call"
        ListLit(e) => "list_lit"
        IndexGet(o, i) => "index_get"
        IndexSet(o, i, v) => "index_set"
        MapLit => "map_lit"
        StringLit(s) => "string"
        IntLit(v) => "int"
        FloatLit(v) => "float"
        BoolLit(v) => "bool"
        Variable(n) => "variable"
        Binary(l, o, r) => "binary"
        Unary(o, r) => "unary"
        Call(c, a) => "call"
        Assign(n, v) => "assign"
        Logical(l, o, r) => "logical"
        MemberAccess(o, f) => "member"
        NilLit => "nil"
        Match(s, a) => "match_expr"
        EnumConstruct(e, v, a) => "enum"
        Lambda(p, r, b) => "lambda"
        GetField(o, f) => "get_field"
        SetField(o, f, v) => "set_field"
        This => "this"
        BlockExpr(s, v) => "block_expr"
        IsCheck(val, t) => "is_check"
        IfExpr(c, tb, tv, eb, ev) => "if_expr"
        TryExpr(tb, tv, cn, cb, cv) => "try_expr"
        Yield(v) => "yield"\
        TupleLit(e) => "tuple_lit"
    }
    }

    fun get_variable_name(expr: AST.Expr): String {
    var name: Any = match (expr) {
        Variable(n) => n
        IntLit(v) => ""
        FloatLit(v) => ""
        BoolLit(v) => ""
        StringLit(s) => ""
        NilLit => ""
        Binary(l, o, r) => ""
        Unary(o, r) => ""
        Call(c, a) => ""
        Assign(n, v) => ""
        Logical(l, o, r) => ""
        MemberAccess(o, f) => ""
        Match(s, a) => ""
        EnumConstruct(e, v, a) => ""
        Lambda(p, r, b) => ""
        GetField(o, f) => ""
        SetField(o, f, v) => ""
        This => ""
        ListLit(e) => ""
        IndexGet(o, i) => ""
        IndexSet(o, i, v) => ""
        MethodCall(o, m, a) => ""
        MapLit => ""
        BlockExpr(s, v) => ""
        IsCheck(val, t) => ""
        IfExpr(c, tb, tv, eb, ev) => ""
        TryExpr(tb, tv, cn, cb, cv) => ""
        Yield(v) => ""
        TupleLit(e) => ""    }
    return name
    }

    fun get_string_literal(expr: AST.Expr): String {
        return match (expr) {
            StringLit(s) => s
            _ => ""
        }
    }

    fun get_expr_type(expr: AST.Expr): String {
    var ek: String = this.classify_expr(expr)
    if (ek == "variable") {
        var vname: String = this.get_variable_name(expr)
        if (vname.length() > 0 and this.typed_vars.has(vname)) {
            var vt: String = this.type_to_string(this.typed_vars.get(vname))
            // In identity mode, Float and Int are both i64 — treat Float as Int
            if (this.identity_mode and vt == "Float") { return "Int" }
            return vt
        }
        return "Any"
    }
    if (ek == "string") return "String"
    if (ek == "int") return "Int"
    if (ek == "float") {
        if (this.identity_mode) { return "Int" }
        return "Float"
    }
    if (ek == "bool") return "Bool"
    if (ek == "nil") return "Nil"
    if (ek == "list_lit") {
        var list_elems: List<AST.Expr> = match (expr) { ListLit(e) => e   _ => [] }
        if (list_elems.length() > 0) {
            var first_type: String = this.get_expr_type(list_elems[0])
            if (first_type == "String") return "List<String>"
            if (first_type == "Int" or first_type == "Float") return "List<Int>"
        }
        return "List<Any>"
    }
    if (ek == "tuple_lit") {
        var tuple_elems: List<AST.Expr> = match (expr) { TupleLit(e) => e   _ => [] }
        var tuple_str: String = "Tuple<"
        var ti: Float = 0
        while (ti < tuple_elems.length()) {
            if (ti > 0) { tuple_str = tuple_str + "," }
            tuple_str = tuple_str + this.get_expr_type(tuple_elems[ti])
            ti = ti + 1
        }
        tuple_str = tuple_str + ">"
        return tuple_str
    }
    if (ek == "map_lit") return "Map<String,String>"
    if (ek == "this") return this.current_class
    if (ek == "get_field" or ek == "member") {
        var gf_inner_obj: AST.Expr = match (expr) {
            GetField(o, f) => o
            MemberAccess(o, f) => o
            _ => AST.Expr.NilLit
        }
        var gf_field: String = match (expr) {
            GetField(o, f) => f
            MemberAccess(o, f) => f
            _ => ""
        }
        var gf_obj_name: String = this.get_variable_name(gf_inner_obj)
        var gf_class: String = ""
        if (this.classify_expr(gf_inner_obj) == "this") {
            gf_class = this.current_class
        } else if (gf_obj_name.length() > 0) {
            gf_class = this.get_var_type_str(gf_obj_name)
        }
        // Tuple field access: t._0, t._1 etc.
        if (gf_class.starts_with("Tuple<") and gf_field.starts_with("_")) {
            return this.get_field_type(gf_class, gf_field)
        }
        var gf_resolved: String = this.resolve_class_type(gf_class)
        if (gf_resolved.length() > 0) {
            return this.get_field_type(gf_resolved, gf_field)
        }
    }
    if (ek == "method_call") {
        var mc_method: String = match (expr) {
            MethodCall(o, m, a) => m
            _ => ""
        }
        var mc_obj: AST.Expr = match (expr) {
            MethodCall(o, m, a) => o
            _ => AST.Expr.NilLit
        }
        // Check if method call is on a user class (resolve obj type)
        var mc_obj_name: String = this.get_variable_name(mc_obj)
        var mc_obj_type: String = ""
        if (mc_obj_name.length() > 0) {
            mc_obj_type = this.get_var_type_str(mc_obj_name)
        }
        // Fallback: if receiver is a complex expression (e.g. another method call),
        // recursively infer its type
        if (mc_obj_type.length() == 0 and mc_obj_name.length() == 0) {
            var mc_obj_kind: String = this.classify_expr(mc_obj)
            if (mc_obj_kind == "method_call" or mc_obj_kind == "call" or mc_obj_kind == "index_get") {
                mc_obj_type = this.get_expr_type(mc_obj)
            }
        }
        if (mc_obj_type.length() == 0 and this.classify_expr(mc_obj) == "this") {
            mc_obj_type = this.current_class
        } else if (this.classify_expr(mc_obj) == "get_field" or this.classify_expr(mc_obj) == "member") {
            // Handle chained field access: this.field.method()
            var inner_obj: AST.Expr = match (mc_obj) {
                GetField(o, f) => o
                MemberAccess(o, f) => o
                _ => AST.Expr.NilLit
            }
            var inner_field: String = match (mc_obj) {
                GetField(o, f) => f
                MemberAccess(o, f) => f
                _ => ""
            }
            var inner_class: String = ""
            if (this.classify_expr(inner_obj) == "this") {
                inner_class = this.current_class
            } else {
                var in_name: String = this.get_variable_name(inner_obj)
                if (in_name.length() > 0) {
                    inner_class = this.get_var_type_str(in_name)
                }
            }
            var inner_resolved: String = this.resolve_class_type(inner_class)
            if (inner_resolved.length() > 0) {
                mc_obj_type = this.get_field_type(inner_resolved, inner_field)
            }
        }
        // If object is a user class, look up method return type
        var mc_resolved: String = this.resolve_class_type(mc_obj_type)
        if (mc_resolved.length() > 0) {
            var full_mc: String = mc_resolved + "__" + mc_method
            if (this.func_ret_types.has(full_mc)) {
                return this.type_to_string(this.func_ret_types.get(full_mc))
            }
        }
        // Also check with prefix for user class methods
        if (mc_obj_type.length() > 0) {
            var prefixed_mc: String = this.current_prefix + mc_obj_type + "__" + mc_method
            if (this.func_ret_types.has(prefixed_mc)) {
                return this.type_to_string(this.func_ret_types.get(prefixed_mc))
            }
        }
        if (mc_method == "length" or mc_method == "index_of" or mc_method == "to_number") return "Int"
        if (mc_method == "slice") {
            if (mc_obj_type.starts_with("List")) { return mc_obj_type }
            return "String"
        }
        if (mc_method == "to_string" or mc_method == "join" or mc_method == "trim" or mc_method == "to_upper" or mc_method == "to_lower" or mc_method == "repeat" or mc_method == "replace" or mc_method == "char_at") return "String"
        if (mc_method == "split" or mc_method == "keys") return "List<String>"
        if (mc_method == "has" or mc_method == "contains" or mc_method == "starts_with" or mc_method == "ends_with" or mc_method == "is_upper" or mc_method == "is_lower") return "Bool"
        if (mc_method == "get") {
            // Infer return type from Map<K, V> annotation rather than always "String"
            var mc_map_type: String = mc_obj_type
            if (mc_map_type.starts_with("Map<")) {
                return this.get_map_value_type(mc_map_type)
            }
            return "String"
        }
        if (mc_method == "pop") {
            // Infer return type from List<T> element type
            if (mc_obj_type.starts_with("List<") and mc_obj_type.ends_with(">")) {
                var pop_inner: String = mc_obj_type.slice(5, mc_obj_type.length() - 1)
                return pop_inner
            }
            return "Int"
        }
        // reverse/copy/sort return the same list type as the receiver
        if (mc_method == "reverse" or mc_method == "copy" or mc_method == "sort") {
            if (mc_obj_type.starts_with("List")) { return mc_obj_type }
            return "List<Any>"
        }
    }
    if (ek == "call") {
        var call_callee: AST.Expr = match (expr) {
            Call(c, a) => c
            x => AST.Expr.NilLit
        }
        var callee_name: String = this.resolve_callee(call_callee)
        if (this.func_ret_types.has(callee_name)) {
            return this.type_to_string(this.func_ret_types.get(callee_name))
        }
        if (callee_name.contains(".")) {
            var cp: List<String> = callee_name.split(".")
            if (cp.length() >= 2 and this.module_prefixes.has(cp[0])) {
                var resolved_name: String = this.module_prefixes.get(cp[0]) + cp[1]
                if (this.func_ret_types.has(resolved_name)) {
                    return this.type_to_string(this.func_ret_types.get(resolved_name))
                }
            }
        }
    }
    if (ek == "is_check") return "Bool"
    if (ek == "binary") {
        var bin_op: String = match (expr) { Binary(l, o, r) => o   _ => "" }
        if (bin_op == "<" or bin_op == ">" or bin_op == "<=" or bin_op == ">=" or bin_op == "==" or bin_op == "!=") return "Bool"
        if (bin_op == "and" or bin_op == "or") return "Bool"
        if (bin_op == "&" or bin_op == "|" or bin_op == "^" or bin_op == "<<" or bin_op == ">>") return "Int"
        var bin_left: AST.Expr = match (expr) { Binary(l, o, r) => l   _ => AST.Expr.NilLit }
        var bin_right: AST.Expr = match (expr) { Binary(l, o, r) => r   _ => AST.Expr.NilLit }
        var left_t: String = this.get_expr_type(bin_left)
        var right_t: String = this.get_expr_type(bin_right)
        if (bin_op == "+" and (left_t == "String" or right_t == "String")) return "String"
        if (left_t == "Float" or right_t == "Float") return "Float"
        return "Int"
    }
    if (ek == "logical") return "Bool"
    if (ek == "unary") {
        var unary_op: String = match (expr) { Unary(o, r) => o   _ => "" }
        if (unary_op == "!") return "Bool"
        var unary_inner: AST.Expr = match (expr) { Unary(o, r) => r   _ => AST.Expr.NilLit }
        return this.get_expr_type(unary_inner)
    }
    if (ek == "assign") return "Any"
    if (ek == "lambda") return "Fun"
    if (ek == "enum") return "Any"
    if (ek == "match_expr") {
        var match_arms: List<AST.MatchArm> = match (expr) { Match(s, a) => a   _ => [] }
        if (match_arms.length() > 0) {
            var first_arm: AST.MatchArm = match_arms[0]
            var arm_body: AST.Expr = match (first_arm) { Arm(p, b) => b   _ => AST.Expr.NilLit }
            return this.get_expr_type(arm_body)
        }
        return "Any"
    }
    if (ek == "block_expr") {
        var block_value: AST.Expr = match (expr) { BlockExpr(s, v) => v   _ => AST.Expr.NilLit }
        return this.get_expr_type(block_value)
    }
    if (ek == "index_get") {
        var ig_obj: AST.Expr = match (expr) { IndexGet(o, i) => o   _ => AST.Expr.NilLit }
        var ig_obj_name: String = this.get_variable_name(ig_obj)
        if (ig_obj_name.length() > 0 and this.typed_vars.has(ig_obj_name)) {
            var ig_list_type: AST.Type = this.typed_vars.get(ig_obj_name)
            var ig_elem: AST.Type = this.get_list_element_type(ig_list_type)
            if (this.type_to_string(ig_elem) != "Any") {
                return this.type_to_string(ig_elem)
            }
            // Fallback: parse type string for List<X> pattern
            var ig_vtype: String = this.type_to_string(ig_list_type)
            if (ig_vtype.starts_with("List<") and ig_vtype.ends_with(">")) {
                return ig_vtype.slice(5, ig_vtype.length() - 1)
            }
        }
        return "Any"
    }
    if (ek == "index_set") return "Any"
    if (ek == "set_field") return "Any"
    return "Any"
    }

    fun gen_list_lit(elements: List<AST.Expr>): String {
    var list_val: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(list_val, "i64", "__list_new", ""))
    } else {
        this.emit_indent(list_val + " = call i64 @__list_new()")
    }
    var elem_type: AST.Type = AST.Type.AnyType
    var i: Float = 0
    while (i < elements.length()) {
        if (i == 0) {
            var ft: String = this.get_expr_type(elements[0])
            if (ft == "String") { elem_type = AST.Type.StringType }
            else if (ft == "Int" or ft == "Float") { elem_type = AST.Type.IntType }
        }
        var elem: String = this.gen_arg_value(elements[i])
        var discard_lp: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(discard_lp, "i64", "__list_push", "i64 " + list_val + ", i64 " + elem))
        } else {
            this.emit_indent(discard_lp + " = call i64 @__list_push(i64 " + list_val + ", i64 " + elem + ")")
        }
        i = i + 1
    }
    this.last_type = this.make_generic_type("List", [elem_type])
    return list_val
    }

    fun gen_index_get(object: AST.Expr, index: AST.Expr): String {
    var obj_name: String = this.get_variable_name(object)
    // Block tuple indexing: must use ._0, ._1 etc.
    if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
        var ig_ttype: String = this.type_to_string(this.typed_vars.get(obj_name))
        if (ig_ttype.starts_with("Tuple<")) {
            IO.println("[codegen] Error: use ._0, ._1 etc. to access tuple fields (not indexing)")
        }
    }
    // Map indexing: map["key"] → __map_get(map, key)
    if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
        var ig_otype: String = this.type_to_string(this.typed_vars.get(obj_name))
        if (ig_otype.starts_with("Map")) {
            var map_obj: String = this.gen_arg_value(object)
            var key_val: String = this.gen_arg_value(index)
            var key_ptr: String = this.emit_untag_ptr(key_val)
            var key_raw: String = this.fresh_local()
            this.emit_indent(key_raw + " = ptrtoint i8* " + key_ptr + " to i64")
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__map_get(i64 " + map_obj + ", i64 " + key_raw + ")")
            if (ig_otype.starts_with("Map<")) {
                var val_type_str: String = this.get_map_value_type(ig_otype)
                this.last_type = this.str_to_type(val_type_str)
            } else {
                this.last_type = AST.Type.AnyType
            }
            return local
        }
    }
    var obj: String = this.gen_arg_value(object)
    var obj_type: AST.Type = this.last_type
    var idx_tagged: String = this.gen_arg_value(index)
    // Untag the index for arithmetic and runtime call
    var idx: String = this.emit_untag_int(idx_tagged)
    // Negative indexing: if idx < 0, use length + idx
    var is_neg: String = this.fresh_local()
    this.emit_indent(is_neg + " = icmp slt i64 " + idx + ", 0")
    var len: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(len, "i64", "__list_length", "i64 " + obj))
    } else {
        this.emit_indent(len + " = call i64 @__list_length(i64 " + obj + ")")
    }
    var adjusted: String = this.fresh_local()
    this.emit_indent(adjusted + " = add i64 " + len + ", " + idx)
    var final_idx: String = this.fresh_local()
    this.emit_indent(final_idx + " = select i1 " + is_neg + ", i64 " + adjusted + ", i64 " + idx)
    var local: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(local, "i64", "__list_get", "i64 " + obj + ", i64 " + final_idx))
        // LLVM lib parallel path: track index_get result
        if (!this.identity_mode) {
            var ig_res: LLVMTypes.Value = this.llvm_block_builder.call("__list_get", LLVMTypes.Type.I64, [])
            this.llvm_values.set(local, ig_res)
        }
    } else {
        this.emit_indent(local + " = call i64 @__list_get(i64 " + obj + ", i64 " + final_idx + ")")
    }
    // Extract element type from the list's generic type
    var idx_elem_type: AST.Type = this.get_list_element_type(obj_type)
    if (this.type_to_string(idx_elem_type) == "Any" and obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
        idx_elem_type = this.get_list_element_type(this.typed_vars.get(obj_name))
        if (this.type_to_string(idx_elem_type) == "Any") {
            var vtype: String = this.type_to_string(this.typed_vars.get(obj_name))
            if (vtype.starts_with("List<") and vtype.ends_with(">")) {
                var inner: String = vtype.slice(5, vtype.length() - 1)
                idx_elem_type = this.str_to_type(inner)
            }
        }
    }
    if (this.type_to_string(idx_elem_type) != "Any") {
        this.last_type = idx_elem_type
    } else {
        this.last_type = AST.Type.AnyType
    }
    // Tuple type: extract Nth element type from Tuple<T1,T2,...>
    var obj_type_str: String = this.type_to_string(obj_type)
    if (obj_type_str.starts_with("Tuple") or (obj_name.length() > 0 and this.typed_vars.has(obj_name) and this.type_to_string(this.typed_vars.get(obj_name)).starts_with("Tuple<"))) {
        var full_type: String = obj_type_str
        if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
            full_type = this.type_to_string(this.typed_vars.get(obj_name))
        }
        if (full_type.starts_with("Tuple<") and full_type.ends_with(">")) {
            var tuple_inner: String = full_type.slice(6, full_type.length() - 1)
            var tuple_args: List<String> = this.split_type_args(tuple_inner)
            var ct_idx: Float = -1
            var idx_ek: String = this.classify_expr(index)
            if (idx_ek == "int") {
                ct_idx = match (index) { IntLit(v) => v   _ => -1 }
            }
            if (ct_idx >= 0 and ct_idx < tuple_args.length()) {
                this.last_type = this.str_to_type(tuple_args[ct_idx])
            }
        }
    }
    return local
    }

    fun gen_index_set(object: AST.Expr, index: AST.Expr, value: AST.Expr): String {
    var obj: String = this.gen_arg_value(object)
    var idx_tagged: String = this.gen_arg_value(index)
    var idx: String = this.emit_untag_int(idx_tagged)
    var val: String = this.gen_arg_value(value)
    var discard_ls: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(discard_ls, "i64", "__list_set", "i64 " + obj + ", i64 " + idx + ", i64 " + val))
    } else {
        this.emit_indent(discard_ls + " = call i64 @__list_set(i64 " + obj + ", i64 " + idx + ", i64 " + val + ")")
    }
    return val
    }

    fun gen_extend_method(ext_class: String, name: String, params: List<AST.Param>, ret_type: String, body: List<AST.Stmt>) {
    var full_name: String = ext_class + "__" + name
    // Use target class's prefix (not source file's prefix)
    var class_prefix: String = this.current_prefix
    var init_key: String = ext_class + "__init"
    if (this.func_prefix_map.has(init_key)) {
        var mapped: String = this.func_prefix_map.get(init_key)
        class_prefix = mapped.slice(0, mapped.length() - init_key.length())
    }
    var prefixed: String = class_prefix + full_name
    this.known_functions.push(prefixed)
    this.known_functions.push(full_name)
    this.func_ret_types.set(prefixed, this.str_to_type(ret_type))
    this.func_ret_types.set(full_name, this.str_to_type(ret_type))
    this.func_prefix_map.set(full_name, prefixed)
    if (this.class_methods.has(ext_class)) {
        var methods: List = this.class_methods.get(ext_class)
        methods.push(name)
    }
    var params_str: String = this.params_to_string(params)
    var full_params: String = "self:Int"
    if (params_str.length() > 0) { full_params = full_params + "," + params_str }
    var saved_class: String = this.current_class
    var saved_prefix: String = this.current_prefix
    this.current_class = ext_class
    this.current_prefix = class_prefix
    this.gen_function(full_name, full_params, ret_type, body)
    this.current_class = saved_class
    this.current_prefix = saved_prefix
    }

    fun set_result_type(result_type: String) {
    if (result_type == "Nil") { this.last_type = AST.Type.NilType }
    else if (result_type == "Int") { this.last_type = AST.Type.IntType }
    else if (result_type == "Bool") { this.last_type = AST.Type.BoolType }
    else if (result_type == "String") { this.last_type = AST.Type.StringType }
    else if (result_type == "List") { this.last_type = this.make_list_type() }
    else if (result_type == "ListStr") { this.last_type = this.make_list_str_type() }
    }

    fun tag_builtin_result(raw: String, result_type: String): String {
    if (result_type == "String") {
        var ptr: String = this.fresh_local()
        this.emit_indent(ptr + " = inttoptr i64 " + raw + " to i8*")
        return this.emit_tag_ptr(ptr)
    }
    if (result_type == "Bool") {
        return this.emit_tag_bool(raw)
    }
    if (result_type == "Int") {
        return this.emit_tag_int(raw)
    }
    return raw
    }

    fun emit_builtin_dispatch(obj: String, method: String, args: List<AST.Expr>): String {
    var desc: String = this.builtin_methods.get(method)
    var parts: List<String> = desc.split("|")
    var pattern: String = parts[0]
    var func_name: String = parts[1]
    var result_type: String = parts[2]
    var needs_push: String = parts[3]
    if (needs_push == "1") { this.called_functions.push(func_name) }
    if (pattern == "v2") {
        var val: String = this.gen_arg_value(args[0])
        var discard: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(discard, "i64", func_name, "i64 " + obj + ", i64 " + val))
        } else {
            this.emit_indent(discard + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + val + ")")
        }
        this.set_result_type(result_type)
        return "0"
    }
    if (pattern == "v3") {
        var a1: String = this.gen_arg_value(args[0])
        var a2: String = this.gen_arg_value(args[1])
        var discard: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(discard, "i64", func_name, "i64 " + obj + ", i64 " + a1 + ", i64 " + a2))
        } else {
            this.emit_indent(discard + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ", i64 " + a2 + ")")
        }
        this.set_result_type(result_type)
        return "0"
    }
    if (pattern == "r1") {
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "r2") {
        var val: String = this.gen_arg_value(args[0])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + val))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + val + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "p1") {
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "p2") {
        var a1: String = this.gen_arg_value(args[0])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + a1))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "p3") {
        var a1: String = this.gen_arg_value(args[0])
        var a2: String = this.gen_arg_value(args[1])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + a1 + ", i64 " + a2))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ", i64 " + a2 + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "m2") {
        var a1: String = this.gen_arg_value(args[0])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + a1))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    this.set_result_type(result_type)
    return "0"
    }

    fun gen_namespace_call(ns: String, method: String, obj: String, args: List<AST.Expr>, has_self: Bool): String {
    // Check if 'method' is actually a function-type field (not a real method).
    // e.g. this.compute() where compute is `var compute: () => T`
    // Function types can be: "Fun(Nil)", "(T) => R", "() => Nil", etc.
    if (has_self and this.class_fields.has(ns)) {
        var ft: String = this.get_field_type(ns, method)
        var is_fn_type: Bool = ft.starts_with("Fun(") or ft.starts_with("(") and ft.contains("=>") or ft.starts_with("() =>")
        if (is_fn_type) {
            // Check there's no actual method with this name
            var full_check: String = ns + "__" + method
            var has_method: Bool = this.known_functions.contains(full_check)
            if (!has_method and this.current_prefix.length() > 0) {
                has_method = this.known_functions.contains(this.current_prefix + full_check)
            }
            if (!has_method) {
                // Load the field value (a closure pair) and call it indirectly
                var struct_name: String = ns
                if (this.class_struct_names.has(ns)) {
                    struct_name = this.class_struct_names.get(ns)
                }
                var field_idx: Float = this.get_field_index(ns, method)
                var obj_ptr: String = this.val_to_typed_ptr(obj, "%" + struct_name + "*")
                var field_ptr: String = this.fresh_local()
                this.emit_indent(field_ptr + " = getelementptr %" + struct_name + ", %" + struct_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
                var field_val: String = this.fresh_local()
                this.emit_indent(field_val + " = load i64, i64* " + field_ptr)
                return this.gen_indirect_call(field_val, args)
            }
        }
    }

    var arg_strs: List<String> = []
    if (has_self) { arg_strs.push("i64 " + obj) }
    var i: Float = 0
    while (i < args.length()) {
        var val: String = this.gen_arg_value(args[i])
        arg_strs.push("i64 " + val)
        i = i + 1
    }
    var full_method: String = ns + "__" + method
    var canonical: String = full_method
    if (this.func_prefix_map.has(full_method)) {
        full_method = this.func_prefix_map.get(full_method)
    } else if (this.current_prefix.length() > 0 and this.known_functions.contains(this.current_prefix + full_method)) {
        full_method = this.current_prefix + full_method
    } else if (!this.known_functions.contains(full_method)) {
        var kfi: Float = 0
        while (kfi < this.known_functions.length()) {
            if (this.known_functions[kfi].ends_with(full_method)) {
                full_method = this.known_functions[kfi]
                kfi = this.known_functions.length()
            }
            kfi = kfi + 1
        }
    }
    this.called_functions.push(full_method)

    // Coroutine-aware method call: if this function is a coroutine and the
    // callee is also a coroutine, emit the await pattern instead of plain call.
    if (this.is_coroutine and this.str_in_list(this.coroutine_funcs, full_method)) {
        var mc_hdl: String = this.fresh_local()
        this.emit_indent(mc_hdl + " = call ptr @" + full_method + "(" + arg_strs.join(", ") + ")")
        var mc_hdl_i64: String = this.fresh_local()
        this.emit_indent(mc_hdl_i64 + " = ptrtoint ptr " + mc_hdl + " to i64")
        var mc_await_loop: String = this.fresh_label("await.loop")
        var mc_await_yield: String = this.fresh_label("await.yield")
        var mc_await_cleanup: String = this.fresh_label("await.cleanup")
        var mc_await_done: String = this.fresh_label("await.done")
        var mc_await_check: String = this.fresh_label("await.check")
        this.emit_terminator("br label %" + mc_await_check)
        this.start_block(mc_await_check)
        var mc_done: String = this.fresh_local()
        this.emit_indent(mc_done + " = call i64 @__sched_coro_done(i64 " + mc_hdl_i64 + ")")
        var mc_done_cmp: String = this.fresh_local()
        this.emit_indent(mc_done_cmp + " = icmp eq i64 " + mc_done + ", 1")
        this.emit_terminator("br i1 " + mc_done_cmp + ", label %" + mc_await_done + ", label %" + mc_await_yield)
        this.start_block(mc_await_yield)
        var mc_save: String = this.fresh_local()
        this.emit_indent(mc_save + " = call token @llvm.coro.save(ptr %__coro_hdl)")
        var mc_susp: String = this.fresh_local()
        this.emit_indent(mc_susp + " = call i8 @llvm.coro.suspend(token " + mc_save + ", i1 false)")
        this.emit_terminator("switch i8 " + mc_susp + ", label %__coro_suspend [i8 0, label %" + mc_await_loop + " i8 1, label %" + mc_await_cleanup + "]")
        this.start_block(mc_await_cleanup)
        this.emit_terminator("br label %__coro_cleanup")
        this.start_block(mc_await_loop)
        this.emit_indent("call void @__sched_coro_resume(i64 " + mc_hdl_i64 + ")")
        this.emit_terminator("br label %" + mc_await_check)
        this.start_block(mc_await_done)
        var mc_result: String = this.fresh_local()
        this.emit_indent(mc_result + " = load i64, i64* @__task_result")
        if (this.func_ret_types.has(full_method)) {
            this.last_type = this.func_ret_types.get(full_method)
        } else if (this.func_ret_types.has(canonical)) {
            this.last_type = this.func_ret_types.get(canonical)
        } else {
            this.last_type = AST.Type.IntType
        }
        return mc_result
    }

    // Sync-calls-coro for method calls: non-coroutine calling a coroutine method
    if (!this.is_coroutine and this.str_in_list(this.coroutine_funcs, full_method)) {
        var sc_hdl: String = this.fresh_local()
        this.emit_indent(sc_hdl + " = call ptr @" + full_method + "(" + arg_strs.join(", ") + ")")
        var sc_i64: String = this.fresh_local()
        this.emit_indent(sc_i64 + " = ptrtoint ptr " + sc_hdl + " to i64")
        var sc_check: String = this.fresh_label("sync.check")
        var sc_loop: String = this.fresh_label("sync.loop")
        var sc_done: String = this.fresh_label("sync.done")
        this.emit_terminator("br label %" + sc_check)
        this.start_block(sc_check)
        var sc_d: String = this.fresh_local()
        this.emit_indent(sc_d + " = call i64 @__sched_coro_done(i64 " + sc_i64 + ")")
        var sc_cmp: String = this.fresh_local()
        this.emit_indent(sc_cmp + " = icmp eq i64 " + sc_d + ", 1")
        this.emit_terminator("br i1 " + sc_cmp + ", label %" + sc_done + ", label %" + sc_loop)
        this.start_block(sc_loop)
        this.emit_indent("call void @__sched_coro_resume(i64 " + sc_i64 + ")")
        this.emit_terminator("br label %" + sc_check)
        this.start_block(sc_done)
        var sc_result: String = this.fresh_local()
        this.emit_indent(sc_result + " = load i64, i64* @__task_result")
        if (this.func_ret_types.has(full_method)) {
            this.last_type = this.func_ret_types.get(full_method)
        } else if (this.func_ret_types.has(canonical)) {
            this.last_type = this.func_ret_types.get(canonical)
        } else {
            this.last_type = AST.Type.IntType
        }
        return sc_result
    }

    var local: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(local, "i64", full_method, arg_strs.join(", ")))
        // LLVM lib parallel path: track method call result as a call instruction
        if (!this.identity_mode) {
            var mc_arg_vals: List<LLVMTypes.Value> = []
            var mc_ai: Float = 0
            while (mc_ai < arg_strs.length()) {
                var mc_part: String = arg_strs[mc_ai]
                var mc_sp: Float = mc_part.index_of(" ")
                if (mc_sp > 0) {
                    var mc_reg: String = mc_part.slice(mc_sp + 1, mc_part.length())
                    mc_arg_vals.push(LLVMTypes.Value.Instruction(mc_reg, LLVMTypes.Type.I64))
                }
                mc_ai = mc_ai + 1
            }
            var mc_result2: LLVMTypes.Value = this.llvm_block_builder.call(full_method, LLVMTypes.Type.I64, mc_arg_vals)
            this.llvm_values.set(local, mc_result2)
        }
    } else {
        this.emit_indent(local + " = call i64 @" + full_method + "(" + arg_strs.join(", ") + ")")
    }
    if (this.func_ret_types.has(full_method)) {
        this.last_type = this.func_ret_types.get(full_method)
    } else if (this.func_ret_types.has(canonical)) {
        this.last_type = this.func_ret_types.get(canonical)
    } else {
        this.last_type = AST.Type.IntType
    }
    return local
    }

    fun resolve_namespace(obj_name: String, object: AST.Expr): String {
    if (obj_name == "this" or this.classify_expr(object) == "this") {
        return this.current_class
    }
    if (this.module_prefixes.has(obj_name)) { return obj_name }
    if (this.class_fields.has(obj_name)) { return obj_name }
    if (obj_name.length() > 0) {
        var vtype: String = this.get_var_type_str(obj_name)
        var resolved: String = this.resolve_class_type(vtype)
        if (resolved.length() > 0) { return resolved }
    }
    return ""
    }

    fun gen_method_call(object: AST.Expr, method: String, args: List<AST.Expr>): String {
    var obj_name: String = this.get_variable_name(object)

    // Self method calls: this.method(args)
    var obj_kind_early: String = this.classify_expr(object)
    if (obj_kind_early == "this" and this.current_class.length() > 0) {
        var self_val: String = this.fresh_local()
        this.emit_indent(self_val + " = load i64, i64* %self")
        return this.gen_namespace_call(this.current_class, method, self_val, args, true)
    }

    // Actor fire-and-forget: actor.send("method_name", args...)
    if (method == "send" and args.length() >= 1 and obj_name.length() > 0) {
        var send_obj_type: String = this.get_var_type_str(obj_name)
        var send_class: String = send_obj_type
        if (this.class_fields.has(send_obj_type) and this.actor_classes.has(send_obj_type)) {
            var send_method_name: String = this.get_string_literal(args[0])
            if (send_method_name.length() > 0) {
                var send_args = []
                var sai: Float = 1
                while (sai < args.length()) {
                    send_args.push(args[sai])
                    sai = sai + 1
                }
                var send_obj: String = this.gen_arg_value(object)
                return this.gen_namespace_call(send_class, send_method_name, send_obj, send_args, true)
            }
        }
    }

    // Package namespace dispatch: check named_imports for "Alias.method" pattern.
    // This handles package re-exports where Parsley.router → router_router.
    if (obj_name.length() > 0 and this.named_imports.has(obj_name + "." + method)) {
        var __pe_target: String = this.named_imports.get(obj_name + "." + method)
        this.called_functions.push(__pe_target)
        this.called_function_arity.set(__pe_target, args.length())

        // Check if this is a class constructor
        var __pe_is_ctor: Bool = false
        if (this.class_fields.has(method) or this.class_fields.has(__pe_target)) {
            __pe_is_ctor = true
        }

        if (__pe_is_ctor) {
            var __pe_instance: String = this.fresh_local()
            this.emit_indent(__pe_instance + " = call i64 @" + __pe_target + "()")
            var __pe_init: String = __pe_target + "__init"
            if (this.str_in_list(this.known_functions, __pe_init)) {
                var __pe_init_args: List<String> = []
                __pe_init_args.push("i64 " + __pe_instance)
                var __pei: Float = 0
                while (__pei < args.length()) {
                    __pe_init_args.push("i64 " + this.gen_arg_value(args[__pei]))
                    __pei = __pei + 1
                }
                var __pe_discard: String = this.fresh_local()
                this.emit_indent(__pe_discard + " = call i64 @" + __pe_init + "(" + __pe_init_args.join(", ") + ")")
            }
            this.last_type = this.str_to_type(method)
            return __pe_instance
        }

        // Regular function call
        var __pe_args: List<String> = []
        var __peai: Float = 0
        while (__peai < args.length()) {
            __pe_args.push("i64 " + this.gen_arg_value(args[__peai]))
            __peai = __peai + 1
        }
        var __pe_result: String = this.fresh_local()
        this.emit_indent(__pe_result + " = call i64 @" + __pe_target + "(" + __pe_args.join(", ") + ")")
        // Set return type from func_ret_types if available
        if (this.func_ret_types.has(__pe_target)) {
            this.last_type = this.func_ret_types.get(__pe_target)
        }
        return __pe_result
    }

    // Universal module dispatch: route through module prefix when the module
    // was properly imported (has a real prefix like "stdlib_os_").
    // Builtins with empty prefix (IO/OS/GC registered as "") fall through
    // to their hardcoded blocks below.
    if (obj_name.length() > 0 and this.module_prefixes.has(obj_name)) {
        var __mp: String = this.module_prefixes.get(obj_name)
        if (__mp.length() > 0) {
            var __mp_func: String = __mp + method
            // Method name remapping for GC functions that conflict with gc.ll globals.
            // Use ends_with on __mp_func to avoid identity-mode pointer comparison issues.
            if (__mp_func.starts_with("__gc_")) {
                if (__mp_func.ends_with("_stats")) { __mp_func = "__gc_debug_stats" }
                else if (__mp_func.ends_with("_alloc_count")) { __mp_func = "__gc_stat_alloc_count" }
                else if (__mp_func.ends_with("_total_bytes")) { __mp_func = "__gc_stat_total_bytes" }
                else if (__mp_func.ends_with("_threshold") and !__mp_func.ends_with("_set_threshold")) { __mp_func = "__gc_stat_threshold" }
            }
            this.called_functions.push(__mp_func)

            // Check if this is a class constructor: class_fields has the method name
            // or the prefixed name, meaning it's a class not a plain function
            var __mp_is_ctor: Bool = false
            if (this.class_fields.has(method) or this.class_fields.has(__mp_func)) {
                __mp_is_ctor = true
            }

            if (__mp_is_ctor) {
                // Constructor: alloc instance, then call __init with args
                var __mp_instance: String = this.fresh_local()
                this.emit_indent(__mp_instance + " = call i64 @" + __mp_func + "()")
                // Find and call __init
                var __mp_init: String = __mp_func + "__init"
                if (this.str_in_list(this.known_functions,__mp_init)) {
                    var __mp_init_args: List<String> = []
                    __mp_init_args.push("i64 " + __mp_instance)
                    var __mpi: Float = 0
                    while (__mpi < args.length()) {
                        __mp_init_args.push("i64 " + this.gen_arg_value(args[__mpi]))
                        __mpi = __mpi + 1
                    }
                    var __mp_discard: String = this.fresh_local()
                    this.emit_indent(__mp_discard + " = call i64 @" + __mp_init + "(" + __mp_init_args.join(", ") + ")")
                }
                this.last_type = this.str_to_type(method)
                return __mp_instance
            }

            // IO.println / IO.print: pass value directly to runtime dispatch.
            // __io_println / __io_print handle all NaN-boxed types at runtime.
            // In identity mode (bootstrap), only strings reach here so raw pointer is safe.
            if ((__mp_func.starts_with("__io_println") or __mp_func.starts_with("__io_print")) and args.length() > 0) {
                var __io_arg: String = this.gen_arg_value(args[0])
                var __io_discard: String = this.fresh_local()
                this.emit_indent(__io_discard + " = call i64 @" + __mp_func + "(i64 " + __io_arg + ")")
                this.last_type = AST.Type.NilType
                return "0"
            }

            // Named arg reordering + trailing closure + default filling
            var __mp_reordered: List<AST.Expr> = args
            var __mp_has_named: Bool = false
            var __mp_tc_applied: Bool = false
            // Trailing closure: last arg is lambda and fewer args than params
            if (this.func_param_names.has(__mp_func) and args.length() > 0) {
                var __mp_pnames: List<String> = this.func_param_names.get(__mp_func)
                var __mp_tc_last: AST.Expr = args[args.length() - 1]
                if (this.classify_expr(__mp_tc_last) == "lambda" and args.length() < __mp_pnames.length()) {
                    var __mp_tc_args: List<AST.Expr> = []
                    var __mp_tci: Float = 0
                    while (__mp_tci < args.length() - 1) {
                        __mp_tc_args.push(args[__mp_tci])
                        __mp_tci = __mp_tci + 1
                    }
                    var __mp_tc_has_named: Bool = false
                    var __mp_tcni: Float = 0
                    while (__mp_tcni < __mp_tc_args.length()) {
                        if (this.classify_expr(__mp_tc_args[__mp_tcni]) == "assign") {
                            __mp_tc_has_named = true
                        }
                        __mp_tcni = __mp_tcni + 1
                    }
                    var __mp_tc_new: List<AST.Expr> = []
                    if (__mp_tc_has_named) {
                        var __mp_pos_idx: Float = 0
                        var __mp_pi: Float = 0
                        while (__mp_pi < __mp_pnames.length() - 1) {
                            var __mp_pn: String = __mp_pnames[__mp_pi]
                            var __mp_found: Bool = false
                            var __mp_si: Float = 0
                            while (__mp_si < __mp_tc_args.length()) {
                                if (this.classify_expr(__mp_tc_args[__mp_si]) == "assign") {
                                    var __mp_an: String = match (__mp_tc_args[__mp_si]) { Assign(n, v) => n
                                        _ => ""
                                    }
                                    if (__mp_an == __mp_pn) {
                                        var __mp_av: AST.Expr = match (__mp_tc_args[__mp_si]) { Assign(n, v) => v
                                            _ => AST.Expr.NilLit
                                        }
                                        __mp_tc_new.push(__mp_av)
                                        __mp_found = true
                                    }
                                }
                                __mp_si = __mp_si + 1
                            }
                            if (!__mp_found) {
                                var __mp_used_pos: Bool = false
                                while (__mp_pos_idx < __mp_tc_args.length() and !__mp_used_pos) {
                                    if (this.classify_expr(__mp_tc_args[__mp_pos_idx]) != "assign") {
                                        __mp_tc_new.push(__mp_tc_args[__mp_pos_idx])
                                        __mp_pos_idx = __mp_pos_idx + 1
                                        __mp_used_pos = true
                                    } else {
                                        __mp_pos_idx = __mp_pos_idx + 1
                                    }
                                }
                                if (!__mp_used_pos) {
                                    __mp_tc_new.push(AST.Expr.NilLit)
                                }
                            }
                            __mp_pi = __mp_pi + 1
                        }
                    } else {
                        __mp_tci = 0
                        while (__mp_tci < __mp_tc_args.length()) {
                            __mp_tc_new.push(__mp_tc_args[__mp_tci])
                            __mp_tci = __mp_tci + 1
                        }
                        while (__mp_tc_new.length() < __mp_pnames.length() - 1) {
                            __mp_tc_new.push(AST.Expr.NilLit)
                        }
                    }
                    __mp_tc_new.push(__mp_tc_last)
                    __mp_reordered = __mp_tc_new
                    __mp_has_named = true
                    __mp_tc_applied = true
                }
            }
            // Check for named args (non-trailing-closure case)
            var __mp_nai: Float = 0
            while (__mp_nai < args.length()) {
                if (this.classify_expr(args[__mp_nai]) == "assign") {
                    __mp_has_named = true
                }
                __mp_nai = __mp_nai + 1
            }
            if (__mp_has_named and this.func_param_names.has(__mp_func) and !__mp_tc_applied) {
                var __mp_pnames2: List<String> = this.func_param_names.get(__mp_func)
                var __mp_new_args: List<AST.Expr> = []
                var __mp_pos_idx2: Float = 0
                var __mp_pi2: Float = 0
                while (__mp_pi2 < __mp_pnames2.length()) {
                    var __mp_pn2: String = __mp_pnames2[__mp_pi2]
                    var __mp_found2: Bool = false
                    var __mp_si2: Float = 0
                    while (__mp_si2 < args.length()) {
                        if (this.classify_expr(args[__mp_si2]) == "assign") {
                            var __mp_an2: String = match (args[__mp_si2]) { Assign(n, v) => n
                                _ => ""
                            }
                            if (__mp_an2 == __mp_pn2) {
                                var __mp_av2: AST.Expr = match (args[__mp_si2]) { Assign(n, v) => v
                                    _ => AST.Expr.NilLit
                                }
                                __mp_new_args.push(__mp_av2)
                                __mp_found2 = true
                            }
                        }
                        __mp_si2 = __mp_si2 + 1
                    }
                    if (!__mp_found2) {
                        var __mp_used_pos2: Bool = false
                        while (__mp_pos_idx2 < args.length() and !__mp_used_pos2) {
                            if (this.classify_expr(args[__mp_pos_idx2]) != "assign") {
                                __mp_new_args.push(args[__mp_pos_idx2])
                                __mp_pos_idx2 = __mp_pos_idx2 + 1
                                __mp_used_pos2 = true
                            } else {
                                __mp_pos_idx2 = __mp_pos_idx2 + 1
                            }
                        }
                        if (!__mp_used_pos2) {
                            __mp_new_args.push(AST.Expr.NilLit)
                        }
                    }
                    __mp_pi2 = __mp_pi2 + 1
                }
                __mp_reordered = __mp_new_args
            }
            var __mp_args: List<String> = []
            var __mpi: Float = 0
            while (__mpi < __mp_reordered.length()) {
                var __mp_used_def: Bool = false
                if (__mp_has_named and this.classify_expr(__mp_reordered[__mpi]) == "nil" and this.func_defaults.has(__mp_func)) {
                    var __mp_defs: List<AST.Expr> = this.func_defaults.get(__mp_func)
                    if (__mpi < __mp_defs.length() and this.classify_expr(__mp_defs[__mpi]) != "nil") {
                        var __mp_def_val: String = this.gen_arg_value(__mp_defs[__mpi])
                        __mp_args.push("i64 " + __mp_def_val)
                        __mp_used_def = true
                    }
                }
                if (!__mp_used_def) {
                    __mp_args.push("i64 " + this.gen_arg_value(__mp_reordered[__mpi]))
                }
                __mpi = __mpi + 1
            }
            // Fill missing args with defaults
            if (this.func_defaults.has(__mp_func)) {
                var __mp_defaults: List<AST.Expr> = this.func_defaults.get(__mp_func)
                var __mp_param_count: Float = __mp_defaults.length()
                if (this.func_param_names.has(__mp_func)) {
                    var __mp_pc2: Float = this.func_param_names.get(__mp_func).length()
                    if (__mp_pc2 > __mp_param_count) { __mp_param_count = __mp_pc2 }
                }
                while (__mpi < __mp_param_count) {
                    if (__mpi < __mp_defaults.length()) {
                        var __mp_de: AST.Expr = __mp_defaults[__mpi]
                        if (this.classify_expr(__mp_de) != "nil") {
                            __mp_args.push("i64 " + this.gen_arg_value(__mp_de))
                        } else {
                            var __mp_nil_val: String = this.fresh_local()
                            this.emit_indent(__mp_nil_val + " = call i64 @__val_nil()")
                            __mp_args.push("i64 " + __mp_nil_val)
                        }
                    } else {
                        var __mp_nil_val: String = this.fresh_local()
                        this.emit_indent(__mp_nil_val + " = call i64 @__val_nil()")
                        __mp_args.push("i64 " + __mp_nil_val)
                    }
                    __mpi = __mpi + 1
                }
            } else if (this.func_param_names.has(__mp_func)) {
                var __mp_param_count: Float = this.func_param_names.get(__mp_func).length()
                while (__mp_args.length() < __mp_param_count) {
                    var __mp_nil_val: String = this.fresh_local()
                    this.emit_indent(__mp_nil_val + " = call i64 @__val_nil()")
                    __mp_args.push("i64 " + __mp_nil_val)
                }
            }
            var __mp_local: String = this.fresh_local()
            this.emit_indent(__mp_local + " = call i64 @" + __mp_func + "(" + __mp_args.join(", ") + ")")
            if (this.func_ret_types.has(__mp_func)) {
                this.last_type = this.func_ret_types.get(__mp_func)
            } else {
                this.last_type = AST.Type.IntType
            }
            // Tag results from builtin runtime functions that return raw values.
            // String-returning functions: tag raw pointer as string
            if (__mp_func == "__io_read_file" or __mp_func == "__io_readline" or __mp_func == "__io_read_stdin" or __mp_func == "__os_exec" or __mp_func == "__os_env" or __mp_func == "__os_cwd" or __mp_func == "__os_path_sep" or __mp_func == "__os_platform") {
                var __tag_ptr: String = this.fresh_local()
                this.emit_indent(__tag_ptr + " = inttoptr i64 " + __mp_local + " to i8*")
                var __tagged: String = this.emit_tag_ptr(__tag_ptr)
                this.last_type = AST.Type.StringType
                return __tagged
            }
            // Bool-returning functions: tag raw 0/1 as bool
            if (__mp_func == "__io_file_exists" or __mp_func == "__os_file_exists") {
                var __tagged: String = this.emit_tag_bool(__mp_local)
                this.last_type = AST.Type.BoolType
                return __tagged
            }
            return __mp_local
        }
    }



    // Package namespace dispatch (fallback path): same as the early check above,
    // handles cases that reach here after failing earlier conditions.
    if (obj_name.length() > 0 and this.named_imports.has(obj_name + "." + method)) {
        var __pe2_target: String = this.named_imports.get(obj_name + "." + method)
        this.called_functions.push(__pe2_target)
        this.called_function_arity.set(__pe2_target, args.length())
        var __pe2_is_ctor: Bool = false
        if (this.class_fields.has(method) or this.class_fields.has(__pe2_target)) {
            __pe2_is_ctor = true
        }
        if (__pe2_is_ctor) {
            var __pe2_inst: String = this.fresh_local()
            this.emit_indent(__pe2_inst + " = call i64 @" + __pe2_target + "()")
            var __pe2_init: String = __pe2_target + "__init"
            if (this.str_in_list(this.known_functions, __pe2_init)) {
                var __pe2_iargs: List<String> = []
                __pe2_iargs.push("i64 " + __pe2_inst)
                var __pe2i: Float = 0
                while (__pe2i < args.length()) {
                    __pe2_iargs.push("i64 " + this.gen_arg_value(args[__pe2i]))
                    __pe2i = __pe2i + 1
                }
                var __pe2_d: String = this.fresh_local()
                this.emit_indent(__pe2_d + " = call i64 @" + __pe2_init + "(" + __pe2_iargs.join(", ") + ")")
            }
            this.last_type = this.str_to_type(method)
            return __pe2_inst
        }
        var __pe2_args: List<String> = []
        var __pe2ai: Float = 0
        while (__pe2ai < args.length()) {
            __pe2_args.push("i64 " + this.gen_arg_value(args[__pe2ai]))
            __pe2ai = __pe2ai + 1
        }
        var __pe2_r: String = this.fresh_local()
        this.emit_indent(__pe2_r + " = call i64 @" + __pe2_target + "(" + __pe2_args.join(", ") + ")")
        if (this.func_ret_types.has(__pe2_target)) {
            this.last_type = this.func_ret_types.get(__pe2_target)
        }
        return __pe2_r
    }

    // Check for module-qualified function calls BEFORE loading the object.
    // This avoids emitting a spurious `load i64, i64* %ModuleName` for module aliases
    // (e.g. AST.type_to_string → would load %AST which is undefined as a value).
    if (obj_name.length() > 0 and this.module_prefixes.has(obj_name)) {
        var prefixed_name: String = this.module_prefixes.get(obj_name) + method
        // Intrinsic check: if the target is an intrinsic, emit inline IR instead of a call
        if (this.str_in_list(this.intrinsic_funcs, prefixed_name)) {
            return this.gen_intrinsic_call(prefixed_name, args)
        }
        // Extern check: if the target is an extern C function, emit the proper extern call
        if (this.extern_sigs.has(prefixed_name)) {
            return this.gen_extern_call(prefixed_name, args)
        }
        var arg_strs: List<String> = []
        var ai: Float = 0
        while (ai < args.length()) {
            var val: String = this.gen_arg_value(args[ai])
            arg_strs.push("i64 " + val)
            ai = ai + 1
        }
        this.called_functions.push(prefixed_name)
        this.called_function_arity.set(prefixed_name, args.length())
        // Coro-calls-coro: if this is a coroutine calling another coroutine,
        // emit the await loop pattern (call as ptr, suspend/resume until done)
        if (this.is_coroutine and this.str_in_list(this.coroutine_funcs, prefixed_name)) {
            var b_hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(b_hdl, "ptr", prefixed_name, arg_strs.join(", ")))
            } else {
                this.emit_indent(b_hdl + " = call ptr @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
            }
            var b_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(b_i64, b_hdl))
            } else {
                this.emit_indent(b_i64 + " = ptrtoint ptr " + b_hdl + " to i64")
            }
            var ac: String = this.fresh_label("await.check")
            var ay: String = this.fresh_label("await.yield")
            var al: String = this.fresh_label("await.loop")
            var acl: String = this.fresh_label("await.cleanup")
            var ad: String = this.fresh_label("await.done")
            this.emit_terminator("br label %" + ac)
            this.start_block(ac)
            var bd: String = this.fresh_local()
            this.emit_indent(bd + " = call i64 @__sched_coro_done(i64 " + b_i64 + ")")
            var bdc: String = this.fresh_local()
            this.emit_indent(bdc + " = icmp eq i64 " + bd + ", 1")
            this.emit_terminator("br i1 " + bdc + ", label %" + ad + ", label %" + ay)
            this.start_block(ay)
            // Propagate child's yield_reason/yield_arg — don't overwrite
            var st: String = this.fresh_local()
            this.emit_indent(st + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var sr: String = this.fresh_local()
            this.emit_indent(sr + " = call i8 @llvm.coro.suspend(token " + st + ", i1 false)")
            this.emit_terminator("switch i8 " + sr + ", label %__coro_suspend [i8 0, label %" + al + " i8 1, label %" + acl + "]")
            this.start_block(acl)
            this.emit_terminator("br label %__coro_cleanup")
            this.start_block(al)
            this.emit_indent("call void @__sched_coro_resume(i64 " + b_i64 + ")")
            this.emit_terminator("br label %" + ac)
            this.start_block(ad)
            var coro_result: String = this.fresh_local()
            this.emit_indent(coro_result + " = load i64, i64* @__task_result")
            if (this.func_ret_types.has(prefixed_name)) {
                this.last_type = this.func_ret_types.get(prefixed_name)
            } else if (this.func_ret_types.has(method)) {
                this.last_type = this.func_ret_types.get(method)
            } else {
                this.last_type = AST.Type.IntType
            }
            return coro_result
        }
        // Sync-calls-coro: non-coroutine calling a coroutine — drive to completion
        if (!this.is_coroutine and this.str_in_list(this.coroutine_funcs, prefixed_name)) {
            var s_hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(s_hdl, "ptr", prefixed_name, arg_strs.join(", ")))
            } else {
                this.emit_indent(s_hdl + " = call ptr @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
            }
            var s_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(s_i64, s_hdl))
            } else {
                this.emit_indent(s_i64 + " = ptrtoint ptr " + s_hdl + " to i64")
            }
            var sc: String = this.fresh_label("sync.check")
            var sl: String = this.fresh_label("sync.loop")
            var sd: String = this.fresh_label("sync.done")
            this.emit_terminator("br label %" + sc)
            this.start_block(sc)
            var s_done: String = this.fresh_local()
            this.emit_indent(s_done + " = call i64 @__sched_coro_done(i64 " + s_i64 + ")")
            var s_cmp: String = this.fresh_local()
            this.emit_indent(s_cmp + " = icmp eq i64 " + s_done + ", 1")
            this.emit_terminator("br i1 " + s_cmp + ", label %" + sd + ", label %" + sl)
            this.start_block(sl)
            this.emit_indent("call void @__sched_coro_resume(i64 " + s_i64 + ")")
            this.emit_terminator("br label %" + sc)
            this.start_block(sd)
            var s_result: String = this.fresh_local()
            this.emit_indent(s_result + " = load i64, i64* @__task_result")
            if (this.func_ret_types.has(prefixed_name)) {
                this.last_type = this.func_ret_types.get(prefixed_name)
            } else if (this.func_ret_types.has(method)) {
                this.last_type = this.func_ret_types.get(method)
            } else {
                this.last_type = AST.Type.IntType
            }
            return s_result
        }
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", prefixed_name, arg_strs.join(", ")))
        } else {
            this.emit_indent(local + " = call i64 @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
        }
        if (this.func_ret_types.has(prefixed_name)) {
            this.last_type = this.func_ret_types.get(prefixed_name)
        } else if (this.func_ret_types.has(method)) {
            this.last_type = this.func_ret_types.get(method)
        } else {
            this.last_type = AST.Type.IntType
        }
        return local
    }

    // Check for enum constructor: EnumName.Variant(args) — MUST come before builtin dispatch
    if (obj_name.length() > 0) {
        var enum_key: String = obj_name + "." + method
        if (this.enum_variant_tags.has(enum_key)) {
            return this.gen_enum_construct(obj_name, method, args)
        }
        // Fallback: check enum_defs in case enum_variant_tags lookup misses
        // (e.g. when enum name == variant name: enum Token { Token(...) })
        if (this.enum_defs.has(obj_name)) {
            var variants: List = this.enum_defs.get(obj_name)
            if (variants.contains(method)) {
                return this.gen_enum_construct(obj_name, method, args)
            }
        }
    }
    if (obj_name.length() == 0) {
        var obj_kind: String = this.classify_expr(object)
        if (obj_kind == "member") {
            var inner_field: String = match (object) { MemberAccess(o, f) => f
                _ => ""
            }
            var enum_key2: String = inner_field + "." + method
            if (this.enum_variant_tags.has(enum_key2)) {
                return this.gen_enum_construct(inner_field, method, args)
            }
        }
    }

    // --- Task.spawn(fn) ---
    if (method == "spawn" and obj_name == "Task") {
        // Infer the task's result type from the lambda's return type
        var task_result_type: String = "Int"
        var spawn_expr_kind: String = this.classify_expr(args[0])
        if (spawn_expr_kind == "lambda") {
            var lambda_ret: String = match (args[0]) { Lambda(p, r, b) => r   _ => "Int" }
            if (lambda_ret.length() > 0 and lambda_ret != "Any" and lambda_ret != "Int") {
                task_result_type = lambda_ret
            } else {
                // Infer from body: if body is [Return(Call(f, ...))] use f's return type
                var lambda_body: List<AST.Stmt> = match (args[0]) { Lambda(p, r, b) => b   _ => [] }
                if (lambda_body.length() == 1) {
                    var lb_kind: String = this.classify_stmt(lambda_body[0])
                    if (lb_kind == "return") {
                        var ret_expr: AST.Expr = match (lambda_body[0]) { Return(v) => v   _ => AST.Expr.NilLit }
                        var ret_ek: String = this.classify_expr(ret_expr)
                        if (ret_ek == "call") {
                            var ret_callee: AST.Expr = match (ret_expr) { Call(c, a) => c   _ => AST.Expr.NilLit }
                            var ret_callee_name: String = this.get_variable_name(ret_callee)
                            if (ret_callee_name.length() > 0) {
                                var prefixed_callee: String = this.current_prefix + ret_callee_name
                                if (this.func_ret_types.has(prefixed_callee)) {
                                    task_result_type = this.type_to_string(this.func_ret_types.get(prefixed_callee))
                                } else if (this.func_ret_types.has(ret_callee_name)) {
                                    task_result_type = this.type_to_string(this.func_ret_types.get(ret_callee_name))
                                }
                            }
                        } else if (ret_ek == "method_call") {
                            var mc_method_name: String = match (ret_expr) { MethodCall(o, m, a) => m   _ => "" }
                            var mc_obj_expr: AST.Expr = match (ret_expr) { MethodCall(o, m, a) => o   _ => AST.Expr.NilLit }
                            var mc_ns: String = this.get_variable_name(mc_obj_expr)
                            if (mc_ns.length() > 0 and this.module_prefixes.has(mc_ns)) {
                                var mc_full: String = this.module_prefixes.get(mc_ns) + mc_method_name
                                if (this.func_ret_types.has(mc_full)) {
                                    task_result_type = this.type_to_string(this.func_ret_types.get(mc_full))
                                }
                            }
                        }
                    }
                }
            }
        }
        // Get the lambda as a function pointer (i64)
        // Force the lambda to be a coroutine (Task.spawn expects a coro handle)
        this.force_next_lambda_coro = true
        this.check_spawn_sendable = true
        var spawn_arg: String = this.gen_arg_value(args[0])
        // Check if the lambda/function is a coroutine
        // Lambda names start with __lambda — check if in coroutine_funcs
        var spawn_fn_name: String = this.get_variable_name(args[0])
        var is_coro_spawn: Bool = false
        if (spawn_fn_name.length() > 0 and this.str_in_list(this.coroutine_funcs, spawn_fn_name)) {
            is_coro_spawn = true
        }
        // Also check the last-generated lambda
        if (!is_coro_spawn) {
            var li: Float = this.coroutine_funcs.length() - 1
            while (li >= 0) {
                var cf: String = this.coroutine_funcs[li]
                if (cf.starts_with("__lambda")) { is_coro_spawn = true; li = -1 }
                li = li - 1
            }
        }
        // spawn_arg is a closure: [fn_ptr, env_ptr] packed as [2 x i64]*
        var closure_ptr: String = this.val_to_typed_ptr(spawn_arg, "[2 x i64]*")
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        var fn_i64: String = this.fresh_local()
        this.emit_indent(fn_i64 + " = load i64, i64* " + fn_slot)
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        var env_i64: String = this.fresh_local()
        this.emit_indent(env_i64 + " = load i64, i64* " + env_slot)
        var fn_ptr: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_inttoptr(fn_ptr, fn_i64))
        } else {
            this.emit_indent(fn_ptr + " = inttoptr i64 " + fn_i64 + " to ptr")
        }
        var task_hdl: String = this.fresh_local()
        this.emit_indent(task_hdl + " = call ptr " + fn_ptr + "(i64 " + env_i64 + ")")
        var task_i64: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_ptrtoint(task_i64, task_hdl))
        } else {
            this.emit_indent(task_i64 + " = ptrtoint ptr " + task_hdl + " to i64")
        }
        // If the task completed synchronously (e.g. no real suspend points),
        // save its result immediately before another spawn could overwrite @__task_result.
        // Don't enqueue already-done tasks (the scheduler would read stale @__task_result).
        var spawn_done: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(spawn_done, "i64", "__sched_coro_done", "i64 " + task_i64))
        } else {
            this.emit_indent(spawn_done + " = call i64 @__sched_coro_done(i64 " + task_i64 + ")")
        }
        var spawn_done_cmp: String = this.fresh_local()
        this.emit_indent(spawn_done_cmp + " = icmp eq i64 " + spawn_done + ", 1")
        var spawn_save_label: String = this.fresh_label("spawn.save")
        var spawn_enqueue_label: String = this.fresh_label("spawn.enqueue")
        var spawn_cont_label: String = this.fresh_label("spawn.cont")
        this.emit_terminator("br i1 " + spawn_done_cmp + ", label %" + spawn_save_label + ", label %" + spawn_enqueue_label)
        this.start_block(spawn_save_label)
        var spawn_res: String = this.fresh_local()
        this.emit_indent(spawn_res + " = load i64, i64* @__task_result")
        this.emit_indent("call void @__sched_store_result(i64 " + task_i64 + ", i64 " + spawn_res + ")")
        this.called_functions.push("__sched_store_result")
        this.emit_terminator("br label %" + spawn_cont_label)
        this.start_block(spawn_enqueue_label)
        // Only enqueue tasks that haven't completed yet
        var enqueue_name: String = "enqueue"
        if (this.known_functions.contains("stdlib_scheduler_enqueue")) {
            enqueue_name = "stdlib_scheduler_enqueue"
        }
        this.emit_indent("call i64 @" + enqueue_name + "(i64 " + task_i64 + ")")
        this.called_functions.push(enqueue_name)
        this.emit_terminator("br label %" + spawn_cont_label)
        this.start_block(spawn_cont_label)
        this.last_type = this.str_to_type(task_result_type)
        return task_i64
    }

    // --- Task methods: isReady() and getResult() ---
    if (method == "isReady") {
        var task_val: String = this.gen_arg_value(object)
        var task_ptr: String = this.fresh_local()
        this.emit_indent(task_ptr + " = inttoptr i64 " + task_val + " to ptr")
        var done_i1: String = this.fresh_local()
        this.emit_indent(done_i1 + " = call i1 @llvm.coro.done(ptr " + task_ptr + ")")
        var done_i64: String = this.fresh_local()
        this.emit_indent(done_i64 + " = zext i1 " + done_i1 + " to i64")
        this.last_type = AST.Type.BoolType
        return done_i64
    }
    if (method == "getResult") {
        var gr_obj_name: String = this.get_variable_name(object)
        var gr_result_type: AST.Type = AST.Type.IntType
        if (gr_obj_name.length() > 0 and this.typed_vars.has(gr_obj_name)) {
            gr_result_type = this.typed_vars.get(gr_obj_name)
        }
        var task_val: String = this.gen_arg_value(object)
        var result_val: String = this.fresh_local()
        this.emit_indent(result_val + " = call i64 @__sched_get_stored_result(i64 " + task_val + ")")
        this.called_functions.push("__sched_get_stored_result")
        this.last_type = gr_result_type
        return result_val
    }
    // task.await() — from top-level: run scheduler then read result
    if (method == "await" and !this.is_coroutine) {
        // Determine the task's result type from the task variable's stored type
        var await_obj_name: String = this.get_variable_name(object)
        var await_result_type: AST.Type = AST.Type.IntType
        if (await_obj_name.length() > 0 and this.typed_vars.has(await_obj_name)) {
            await_result_type = this.typed_vars.get(await_obj_name)
        }
        var task_val: String = this.gen_arg_value(object)
        var sched_run_name: String = "scheduler_run"
        if (this.known_functions.contains("stdlib_scheduler_scheduler_run")) {
            sched_run_name = "stdlib_scheduler_scheduler_run"
        }
        this.emit_indent("call i64 @" + sched_run_name + "()")
        this.called_functions.push(sched_run_name)
        // Use the C-level per-task result storage (handles multi-task races)
        var result_val: String = this.fresh_local()
        this.emit_indent(result_val + " = call i64 @__sched_get_stored_result(i64 " + task_val + ")")
        this.called_functions.push("__sched_get_stored_result")
        this.last_type = await_result_type
        return result_val
    }
    // task.await() — from coroutine: loop suspend/resume until task is done
    if (method == "await" and this.is_coroutine) {
        // Determine the task's result type from the task variable's stored type
        var await_obj_name: String = this.get_variable_name(object)
        var await_result_type: AST.Type = AST.Type.IntType
        if (await_obj_name.length() > 0 and this.typed_vars.has(await_obj_name)) {
            await_result_type = this.typed_vars.get(await_obj_name)
        }
        var task_val: String = this.gen_arg_value(object)
        // Loop: check if task is done, if not suspend and retry
        var await_check: String = this.fresh_label("task.await.check")
        var await_suspend: String = this.fresh_label("task.await.suspend")
        var await_loop: String = this.fresh_label("task.await.loop")
        var await_cleanup: String = this.fresh_label("task.await.cleanup")
        var await_done: String = this.fresh_label("task.await.done")
        this.emit_terminator("br label %" + await_check)
        this.start_block(await_check)
        var done_val: String = this.fresh_local()
        this.emit_indent(done_val + " = call i64 @__sched_coro_done(i64 " + task_val + ")")
        var done_cmp: String = this.fresh_local()
        this.emit_indent(done_cmp + " = icmp eq i64 " + done_val + ", 1")
        this.emit_terminator("br i1 " + done_cmp + ", label %" + await_done + ", label %" + await_suspend)
        this.start_block(await_suspend)
        this.emit_indent("store i64 3, i64* @__yield_reason")
        this.emit_indent("store i64 " + task_val + ", i64* @__yield_arg")
        var save_tok: String = this.fresh_local()
        this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
        var susp: String = this.fresh_local()
        this.emit_indent(susp + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")
        this.emit_terminator("switch i8 " + susp + ", label %__coro_suspend [i8 0, label %" + await_loop + " i8 1, label %" + await_cleanup + "]")
        this.start_block(await_cleanup)
        this.emit_terminator("br label %__coro_cleanup")
        this.start_block(await_loop)
        this.emit_terminator("br label %" + await_check)
        this.start_block(await_done)
        // Task is done — read its stored result
        var result_val: String = this.fresh_local()
        this.emit_indent(result_val + " = call i64 @__sched_get_stored_result(i64 " + task_val + ")")
        this.called_functions.push("__sched_get_stored_result")
        this.last_type = await_result_type
        return result_val
    }

    // --- Builtin dispatch (only for non-class objects) ---
    var obj: String = this.gen_arg_value(object)
    var is_user_class: Bool = false
    if (obj_name.length() > 0) {
        var uc_type: String = this.get_var_type_str(obj_name)
        var uc_resolved: String = this.resolve_class_type(uc_type)
        if (uc_resolved.length() > 0) {
            is_user_class = true
        }
    }
    // Also check last_type after evaluation (handles chained field access like this.field.method())
    if (!is_user_class) {
        var eval_type: String = this.type_to_string(this.last_type)
        var eval_resolved: String = this.resolve_class_type(eval_type)
        if (eval_resolved.length() > 0) {
            is_user_class = true
        }
    }
    // Fallback: if type resolution failed but a user class defines this method,
    // treat as user class dispatch. Skip known builtin methods (length, push, etc.)
    // to avoid hijacking built-in container dispatch.
    var __uc_is_builtin_method: Bool = method == "keys" or method == "values" or method == "has" or method == "get" or method == "set" or method == "length" or method == "push" or method == "pop" or method == "contains" or method == "split" or method == "join" or method == "slice" or method == "reverse" or method == "sort" or method == "copy" or method == "trim" or method == "replace" or method == "index_of" or method == "starts_with" or method == "ends_with" or method == "to_upper" or method == "to_lower" or method == "repeat" or method == "char_at" or method == "to_number" or method == "to_string" or method == "to_float" or method == "abs" or method == "floor" or method == "ceil"
    if (!is_user_class and !__uc_is_builtin_method and args.length() == 0) {
