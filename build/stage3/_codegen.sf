    // (enum check moved above builtin dispatch)

    // Check for imported module function calls (module alias or unknown name)
    // Also skip global variables (they should dispatch via class method resolution below)
    if (obj_name.length() > 0 and (this.module_prefixes.has(obj_name) or (obj_name != "super" and !this.class_fields.has(obj_name) and !this.typed_vars.has(obj_name) and !this.global_var_types.has(obj_name) and !this.module_globals.has(obj_name) and !this.module_globals.has(this.current_prefix + obj_name)))) {
        var prefixed_name: String = method
        // Package namespace: check named_imports for "Alias.method" first
        if (this.named_imports.has(obj_name + "." + method)) {
            prefixed_name = this.named_imports.get(obj_name + "." + method)
        } else if (this.module_prefixes.has(obj_name)) {
            prefixed_name = this.module_prefixes.get(obj_name) + method
        } else if (this.func_prefix_map.has(method)) {
            prefixed_name = this.func_prefix_map.get(method)
        } else {
            var guessed: String = obj_name.to_lower() + "_" + method
            if (this.known_functions.contains(guessed)) {
                prefixed_name = guessed
            }
        }
        // Intrinsic check: if the target is an intrinsic, emit inline IR instead of a call
        if (this.intrinsic_funcs.contains(prefixed_name)) {
            return this.gen_intrinsic_call(prefixed_name, args)
        }
        // Extern check: if the target is an extern C function, emit the proper extern call
        if (this.extern_sigs.has(prefixed_name)) {
            return this.gen_extern_call(prefixed_name, args)
        }
        var arg_strs: List<String> = []
        var ai: Float = 0
        while (ai < args.length()) {
            var val: String = this.gen_arg_value(args[ai])
            arg_strs.push("i64 " + val)
            ai = ai + 1
        }
        this.called_functions.push(prefixed_name)
        this.called_function_arity.set(prefixed_name, args.length())
        // Coro-calls-coro: if this is a coroutine calling another, emit await loop
        var is_coro_callee: Bool = this.str_in_list(this.coroutine_funcs, prefixed_name)
        if (!is_coro_callee) {
            is_coro_callee = this.str_in_list(this.coroutine_funcs, method)
        }
        // Definitive check: if the function is already defined and is in coroutine_funcs
        if (!is_coro_callee) {
            is_coro_callee = this.str_in_list(this.coroutine_funcs, prefixed_name) or this.str_in_list(this.coroutine_funcs, method)
        }
        if (this.is_coroutine and is_coro_callee) {
            var b_hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(b_hdl, "ptr", prefixed_name, arg_strs.join(", ")))
            } else {
                this.emit_indent(b_hdl + " = call ptr @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
            }
            var b_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(b_i64, b_hdl))
            } else {
                this.emit_indent(b_i64 + " = ptrtoint ptr " + b_hdl + " to i64")
            }
            var ac: String = this.fresh_label("await.check")
            var ay: String = this.fresh_label("await.yield")
            var al: String = this.fresh_label("await.loop")
            var acl: String = this.fresh_label("await.cleanup")
            var ad: String = this.fresh_label("await.done")
            this.emit_terminator("br label %" + ac)
            this.start_block(ac)
            var bd: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(bd, "i64", "__sched_coro_done", "i64 " + b_i64))
            } else {
                this.emit_indent(bd + " = call i64 @__sched_coro_done(i64 " + b_i64 + ")")
            }
            var bdc: String = this.fresh_local()
            this.emit_indent(bdc + " = icmp eq i64 " + bd + ", 1")
            this.emit_terminator("br i1 " + bdc + ", label %" + ad + ", label %" + ay)
            this.start_block(ay)
            // Propagate child's yield_reason/yield_arg — don't overwrite
            var st: String = this.fresh_local()
            this.emit_indent(st + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var sr: String = this.fresh_local()
            this.emit_indent(sr + " = call i8 @llvm.coro.suspend(token " + st + ", i1 false)")
            this.emit_terminator("switch i8 " + sr + ", label %__coro_suspend [i8 0, label %" + al + " i8 1, label %" + acl + "]")
            this.start_block(acl)
            this.emit_terminator("br label %__coro_cleanup")
            this.start_block(al)
            this.emit_indent("call void @__sched_coro_resume(i64 " + b_i64 + ")")
            this.emit_terminator("br label %" + ac)
            this.start_block(ad)
            // Read the child coroutine's return value from @__task_result
            var coro_result: String = this.fresh_local()
            this.emit_indent(coro_result + " = load i64, i64* @__task_result")
            // Use the callee's return type (same as the non-coro path below)
            if (this.func_ret_types.has(prefixed_name)) {
                this.last_type = this.func_ret_types.get(prefixed_name)
            } else if (this.func_ret_types.has(method)) {
                this.last_type = this.func_ret_types.get(method)
            } else {
                this.last_type = AST.Type.IntType
            }
            return coro_result
        }
        // Sync-calls-coro: non-coroutine calling a coroutine — drive to completion
        if (!this.is_coroutine and is_coro_callee) {
            var s_hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(s_hdl, "ptr", prefixed_name, arg_strs.join(", ")))
            } else {
                this.emit_indent(s_hdl + " = call ptr @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
            }
            var s_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(s_i64, s_hdl))
            } else {
                this.emit_indent(s_i64 + " = ptrtoint ptr " + s_hdl + " to i64")
            }
            var sc: String = this.fresh_label("sync.check")
            var sl: String = this.fresh_label("sync.loop")
            var sd: String = this.fresh_label("sync.done")
            this.emit_terminator("br label %" + sc)
            this.start_block(sc)
            var s_done: String = this.fresh_local()
            this.emit_indent(s_done + " = call i64 @__sched_coro_done(i64 " + s_i64 + ")")
            var s_cmp: String = this.fresh_local()
            this.emit_indent(s_cmp + " = icmp eq i64 " + s_done + ", 1")
            this.emit_terminator("br i1 " + s_cmp + ", label %" + sd + ", label %" + sl)
            this.start_block(sl)
            this.emit_indent("call void @__sched_coro_resume(i64 " + s_i64 + ")")
            this.emit_terminator("br label %" + sc)
            this.start_block(sd)
            var s_result: String = this.fresh_local()
            this.emit_indent(s_result + " = load i64, i64* @__task_result")
            if (this.func_ret_types.has(prefixed_name)) {
                this.last_type = this.func_ret_types.get(prefixed_name)
            } else if (this.func_ret_types.has(method)) {
                this.last_type = this.func_ret_types.get(method)
            } else {
                this.last_type = AST.Type.IntType
            }
            return s_result
        }
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", prefixed_name, arg_strs.join(", ")))
        } else {
            this.emit_indent(local + " = call i64 @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
        }
        if (this.func_ret_types.has(prefixed_name)) {
            this.last_type = this.func_ret_types.get(prefixed_name)
        } else if (this.func_ret_types.has(method)) {
            this.last_type = this.func_ret_types.get(method)
        } else {
            this.last_type = AST.Type.IntType
        }
        return local
    }

    // Fall back to class method call (inside or outside class)
    // (must come BEFORE universal methods so class .to_string() is found)
    // typed_vars is the single source of truth for variable types.
    var class_name: String = ""
    var cn_resolved: String = this.resolve_class_type(obj_type)
    if (cn_resolved.length() > 0) {
        class_name = cn_resolved
    } else if (obj_name.length() > 0) {
        var cn_type: String = this.get_var_type_str(obj_name)
        var cn_type_resolved: String = this.resolve_class_type(cn_type)
        if (cn_type_resolved.length() > 0) {
            class_name = cn_type_resolved
        }
    }
    // Don't use find_class_for_method for builtin container/primitive methods —
    // these should dispatch to runtime builtins (Map/List/String/Int/Float) not user classes.
    // Includes type-class methods (to_string, abs, floor, ceil, to_float) that are
    // handled by inline codegen above for known primitive types.
    var is_builtin_method: Bool = method == "keys" or method == "values" or method == "has" or method == "get" or method == "set" or method == "length" or method == "push" or method == "pop" or method == "contains" or method == "split" or method == "join" or method == "slice" or method == "reverse" or method == "sort" or method == "copy" or method == "trim" or method == "replace" or method == "index_of" or method == "starts_with" or method == "ends_with" or method == "to_upper" or method == "to_lower" or method == "repeat" or method == "char_at" or method == "to_number" or method == "to_string" or method == "to_float" or method == "abs" or method == "floor" or method == "ceil"
    if (class_name.length() == 0 and this.current_class.length() > 0 and !is_builtin_method) {
        class_name = this.find_class_for_method(method)
    }
    if (class_name.length() == 0 and !is_builtin_method) {
        class_name = this.find_class_for_method(method)
    }
    // Fallback: if class_name is still empty, try find_class_for_method even for
    // builtin method names. User classes (e.g. Signal) can have .set()/.get()
    // with different arities than Map/List builtins.
    if (class_name.length() == 0 and is_builtin_method) {
        // Builtin .set() requires 2 args (Map.set(k,v) or List.set(i,v)).
        // Builtin .get() requires 1 arg (Map.get(k)).
        // If arity doesn't match builtins, it must be a user class method.
        var builtin_arity_mismatch: Bool = false
        if (method == "set" and args.length() != 2) { builtin_arity_mismatch = true }
        if (method == "get" and args.length() != 1) { builtin_arity_mismatch = true }
        // Also fallback for module globals whose type is unknown
        if (builtin_arity_mismatch or (obj_name.length() > 0 and (this.module_globals.has(obj_name) or this.module_globals.has(this.current_prefix + obj_name)))) {
            class_name = this.find_class_for_method(method)
        }
    }
    if (class_name.length() > 0) {
        // Error check: verify method actually exists on the class
        var __method_exists: Bool = false
        var __full_method_name: String = class_name + "__" + method
        if (this.known_functions.contains(__full_method_name)) { __method_exists = true }
        if (this.current_prefix.length() > 0 and this.known_functions.contains(this.current_prefix + __full_method_name)) { __method_exists = true }
        if (this.func_prefix_map.has(__full_method_name)) { __method_exists = true }
        if (this.class_methods.has(class_name)) {
            var __cm: List = this.class_methods.get(class_name)
            if (__cm.contains(method)) { __method_exists = true }
        }
        // Cross-module: class_methods is keyed by bare name (e.g. "TomlTable") but
        // class_name may be the prefixed struct name (e.g. "stdlib_toml_TomlTable").
        // Reverse-lookup via class_struct_names to find the bare name.
        if (!__method_exists) {
            var __cm_keys: List<String> = this.class_methods.keys()
            var __cmi: Float = 0
            while (__cmi < __cm_keys.length()) {
                var __cmk: String = __cm_keys[__cmi]
                if (this.class_struct_names.has(__cmk)) {
                    if (this.class_struct_names.get(__cmk) == class_name) {
                        var __cm3: List = this.class_methods.get(__cmk)
                        if (__cm3.contains(method)) { __method_exists = true }
                    }
                }
                __cmi = __cmi + 1
            }
        }
        // Also check func_prefix_map with bare class name
        if (!__method_exists) {
            var __cm_keys2: List<String> = this.class_methods.keys()
            var __cmi2: Float = 0
            while (__cmi2 < __cm_keys2.length()) {
                var __cmk2: String = __cm_keys2[__cmi2]
                if (this.class_struct_names.has(__cmk2)) {
                    if (this.class_struct_names.get(__cmk2) == class_name) {
                        var __bare_fn: String = __cmk2 + "__" + method
                        if (this.known_functions.contains(__bare_fn)) { __method_exists = true }
                        if (this.func_prefix_map.has(__bare_fn)) { __method_exists = true }
                    }
                }
                __cmi2 = __cmi2 + 1
            }
        }
        // Also allow callable fields (function-typed fields)
        if (!__method_exists and this.class_fields.has(class_name)) {
            var __ft: String = this.get_field_type(class_name, method)
            if (__ft.starts_with("Fun(") or __ft.contains("=>")) { __method_exists = true }
            var __fields_str: String = this.class_fields.get(class_name)
            if (__fields_str.contains(method + ":")) { __method_exists = true }
        }
        if (!__method_exists) {
            IO.println("[codegen] Error: type '" + class_name + "' has no method '" + method + "'")
            this.has_errors = true
            this.last_type = AST.Type.IntType
            return "0"
        }
        // Actor dispatch: serialize access with busy-check
        if (this.actor_classes.has(class_name) and this.is_coroutine and method != "init") {
            var actor_check: String = this.fresh_label("actor.check")
            var actor_suspend: String = this.fresh_label("actor.suspend")
            var actor_loop: String = this.fresh_label("actor.loop")
            var actor_cleanup: String = this.fresh_label("actor.cleanup")
            var actor_run: String = this.fresh_label("actor.run")
            var actor_done: String = this.fresh_label("actor.done")
            this.emit_terminator("br label %" + actor_check)
            this.start_block(actor_check)
            var busy_ptr: String = this.fresh_local()
            this.emit_indent(busy_ptr + " = inttoptr i64 " + obj + " to i64*")
            var busy_val: String = this.fresh_local()
            this.emit_indent(busy_val + " = load i64, i64* " + busy_ptr)
            var busy_cmp: String = this.fresh_local()
            this.emit_indent(busy_cmp + " = icmp ne i64 " + busy_val + ", 0")
            this.emit_terminator("br i1 " + busy_cmp + ", label %" + actor_suspend + ", label %" + actor_run)
            this.start_block(actor_suspend)
            this.emit_indent("store i64 5, i64* @__yield_reason")
            this.emit_indent("store i64 " + obj + ", i64* @__yield_arg")
            var save_tok: String = this.fresh_local()
            this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var susp: String = this.fresh_local()
            this.emit_indent(susp + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")
            this.emit_terminator("switch i8 " + susp + ", label %__coro_suspend [i8 0, label %" + actor_loop + " i8 1, label %" + actor_cleanup + "]")
            this.start_block(actor_cleanup)
            this.emit_terminator("br label %__coro_cleanup")
            this.start_block(actor_loop)
            this.emit_terminator("br label %" + actor_check)
            this.start_block(actor_run)
            this.emit_indent("store i64 1, i64* " + busy_ptr)
            var ns_result: String = this.gen_namespace_call(class_name, method, obj, args, true)
            this.emit_indent("store i64 0, i64* " + busy_ptr)
            var wake_name: String = "scheduler__wake_actor_waiters"
            if (this.known_functions.contains("stdlib_scheduler_wake_actor_waiters")) {
                wake_name = "stdlib_scheduler_wake_actor_waiters"
            }
            var wake_discard: String = this.fresh_local()
            this.emit_indent(wake_discard + " = call i64 @" + wake_name + "(i64 " + obj + ")")
            this.called_functions.push(wake_name)
            var ns_ret_str: String = this.type_to_string(this.last_type)
            if (ns_ret_str.length() > 0 and ns_ret_str.length() <= 2 and ns_ret_str == ns_ret_str.to_upper() and ns_ret_str != "IO" and ns_ret_str != "OS") {
                if (obj_name.length() > 0) {
                    var recv_type: String = this.get_var_type_str(obj_name)
                    if (recv_type.contains("<") and recv_type.contains(">")) {
                        var rg_start: Float = recv_type.index_of("<")
                        var rg_inner: String = recv_type.slice(rg_start + 1, recv_type.length() - 1)
                        if (rg_inner.length() > 0 and rg_inner != ns_ret_str) {
                            this.last_type = this.str_to_type(rg_inner)
                        }
                    }
                }
            }
            return ns_result
        }
        var ns_result: String = this.gen_namespace_call(class_name, method, obj, args, true)
        // Resolve generic type parameter in return type (e.g. T -> String)
        var ns_ret_str: String = this.type_to_string(this.last_type)
        if (ns_ret_str.length() > 0 and ns_ret_str.length() <= 2 and ns_ret_str == ns_ret_str.to_upper() and ns_ret_str != "IO" and ns_ret_str != "OS") {
            // Looks like a type parameter — resolve from receiver's generic type args
            if (obj_name.length() > 0) {
                var recv_type: String = this.get_var_type_str(obj_name)
                if (recv_type.contains("<") and recv_type.contains(">")) {
                    var rg_start: Float = recv_type.index_of("<")
                    var rg_inner: String = recv_type.slice(rg_start + 1, recv_type.length() - 1)
                    if (rg_inner.length() > 0 and rg_inner != ns_ret_str) {
                        this.last_type = this.str_to_type(rg_inner)
                    }
                }
            }
        }
        return ns_result
    }

    // Universal methods (last resort, after class methods checked)
    if (method == "floor") {
        this.last_type = AST.Type.IntType
        return obj
    }
    if (method == "to_string") {
        if (obj_type == "String") {
            this.last_type = AST.Type.StringType
            return obj
        }
        if (obj_type == "Any") {
            var ts_local: String = this.fresh_local()
            this.emit_indent(ts_local + " = call i64 @__any_to_string(i64 " + obj + ")")
            var ts_tagged: String = this.fresh_local()
            this.emit_indent(ts_tagged + " = call i64 @__rt_tag_ptr(i64 " + ts_local + ")")
            this.last_type = AST.Type.StringType
            return ts_tagged
        }
        if (this.enum_defs.has(obj_type)) {
            var ts_func: String = obj_type + "__to_string"
            var ts_local: String = this.fresh_local()
            this.emit_indent(ts_local + " = call i64 @" + ts_func + "(i64 " + obj + ")")
            var ts_tagged_e: String = this.fresh_local()
            this.emit_indent(ts_tagged_e + " = call i64 @__rt_tag_ptr(i64 " + ts_local + ")")
            this.last_type = AST.Type.StringType
            return ts_tagged_e
        }
        var ts_raw: String = this.emit_untag_int(obj)
        var ts_local: String = this.fresh_local()
        this.emit_indent(ts_local + " = call i64 @__int_to_string(i64 " + ts_raw + ")")
        var ts_tagged: String = this.fresh_local()
        this.emit_indent(ts_tagged + " = call i64 @__rt_tag_ptr(i64 " + ts_local + ")")
        this.last_type = AST.Type.StringType
        return ts_tagged
    }
    // Error: method not found on a known user-defined class type
    // Skip for builtin types (String, List, Map, etc.) which have runtime methods
    var is_builtin_type: Bool = false
    if (obj_type == "Any" or obj_type == "Int" or obj_type == "Float" or obj_type == "Bool" or obj_type == "String" or obj_type == "Nil") { is_builtin_type = true }
    if (obj_type.starts_with("List") or obj_type.starts_with("Map") or obj_type.starts_with("Tuple")) { is_builtin_type = true }
    if (obj_type == "StringBuilder" or obj_type == "SB") { is_builtin_type = true }
    if (!is_builtin_type and obj_type.length() > 0 and this.class_fields.has(obj_type)) {
        // Before erroring, check if the method exists via cross-module resolution
        var __ft_exists: Bool = false
        if (this.class_methods.has(obj_type)) {
            var __ftm: List = this.class_methods.get(obj_type)
            if (__ftm.contains(method)) { __ft_exists = true }
        }
        if (!__ft_exists) {
            var __ftk: List<String> = this.class_methods.keys()
            var __fti: Float = 0
            while (__fti < __ftk.length()) {
                var __ftkey: String = __ftk[__fti]
                if (this.class_struct_names.has(__ftkey)) {
                    if (this.class_struct_names.get(__ftkey) == obj_type) {
                        var __ftm2: List = this.class_methods.get(__ftkey)
                        if (__ftm2.contains(method)) { __ft_exists = true }
                    }
                }
                __fti = __fti + 1
            }
        }
        if (!__ft_exists) {
            IO.println("[codegen] Error: type '" + obj_type + "' has no method '" + method + "'")
            this.has_errors = true
        }
    }
    this.last_type = AST.Type.IntType
    return "0"
    }

    fun is_this_expr(expr: AST.Expr): Bool {
    var kind: Any = match (expr) {
        This => "this"
        IntLit(v) => "other"
        FloatLit(v) => "other"
        BoolLit(v) => "other"
        StringLit(s) => "other"
        NilLit => "other"
        Variable(n) => "other"
        Binary(l, o, r) => "other"
        Unary(o, r) => "other"
        Call(c, a) => "other"
        Assign(n, v) => "other"
        Logical(l, o, r) => "other"
        MemberAccess(o, f) => "other"
        Match(s, a) => "other"
        EnumConstruct(e, v, a) => "other"
        Lambda(p, r, b) => "other"
        GetField(o, f) => "other"
        SetField(o, f, v) => "other"
        BlockExpr(s, v) => "other"
        IsCheck(val, t) => "other"
        IfExpr(c, tb, tv, eb, ev) => "other"
        TryExpr(tb, tv, cn, cb, cv) => "other"
        Yield(v) => "other"
        TupleLit(e) => "other"
    }
    return kind == "this"
    }

    fun gen_get_field(object: AST.Expr, field: String): String {
    var obj_val: String = this.gen_arg_value(object)
    var class_name: String = this.type_to_string(this.last_type)
    if (class_name == "Int" or class_name == "Any" or !this.class_fields.has(class_name)) {
        // Try resolve_class_type to handle module-qualified types (e.g. "Func.BasicBlock")
        var resolved: String = this.resolve_class_type(class_name)
        if (resolved.length() > 0 and this.class_fields.has(resolved)) {
            class_name = resolved
        } else {
            class_name = this.current_class
        }
    }
    // Resolve to struct type name for GEP
    var struct_name: String = class_name
    if (this.class_struct_names.has(class_name)) {
        struct_name = this.class_struct_names.get(class_name)
    }
    var field_idx: Float = this.get_field_index(class_name, field)
    var obj_ptr: String = this.val_to_typed_ptr(obj_val, "%" + struct_name + "*")
    var field_ptr: String = this.fresh_local()
    this.emit_indent(field_ptr + " = getelementptr %" + struct_name + ", %" + struct_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
    var result: String = this.fresh_local()
    this.emit_indent(result + " = load volatile i64, i64* " + field_ptr)
    // LLVM lib parallel path: track field load result as opaque call (GEP+load)
    if (this.use_llvm_lib and !this.identity_mode) {
        var gf_arg_vals: List<LLVMTypes.Value> = []
        gf_arg_vals.push(LLVMTypes.Value.Instruction(obj_val, LLVMTypes.Type.I64))
        var gf_result: LLVMTypes.Value = this.llvm_block_builder.call("__field_load", LLVMTypes.Type.I64, gf_arg_vals)
        this.llvm_values.set(result, gf_result)
    }
    // Infer field type from class declaration
    this.last_type = this.str_to_type(this.get_field_type(class_name, field))
    return result
    }

    fun get_field_type(class_name: String, field: String): String {
    // Tuple field access: Tuple<T0,T1,...> with _0, _1, ...
    if (class_name.starts_with("Tuple<") and field.starts_with("_") and field.length() >= 2) {
        var gft_rest: String = field.slice(1, field.length())
        var gft_idx: Float = gft_rest.to_number()
        var gft_inner: String = class_name.slice(6, class_name.length() - 1)
        var gft_args: List<String> = this.split_type_args(gft_inner)
        if (gft_idx >= 0 and gft_idx < gft_args.length()) {
            return gft_args[gft_idx]
        }
    }
    var __gft_lookup: String = class_name
    if (!this.class_fields.has(class_name)) {
        // Cross-module: try bare name via reverse lookup
        var __gft_keys: List<String> = this.class_struct_names.keys()
        var __gft_i: Float = 0
        while (__gft_i < __gft_keys.length()) {
            if (this.class_struct_names.get(__gft_keys[__gft_i]) == class_name) {
                if (this.class_fields.has(__gft_keys[__gft_i])) {
                    __gft_lookup = __gft_keys[__gft_i]
                    __gft_i = __gft_keys.length()
                }
            }
            __gft_i = __gft_i + 1
        }
        // Also try stripping current_prefix
        if (!this.class_fields.has(__gft_lookup) and this.current_prefix.length() > 0 and class_name.starts_with(this.current_prefix)) {
            var __bare: String = class_name.slice(this.current_prefix.length(), class_name.length())
            if (this.class_fields.has(__bare)) { __gft_lookup = __bare }
        }
    }
    var fields: String = this.class_fields.get(__gft_lookup)
    if (fields.length() == 0) return "Int"
    var parts: List<String> = this.split_respecting_generics(fields, ",")
    var i: Float = 0
    while (i < parts.length()) {
        var fp: List<String> = parts[i].split(":")
        if (fp[0] == field) {
            var ft: String = fp[1]
            // In identity mode, Float and Int are both i64 — treat Float as Int
            if (this.identity_mode and ft == "Float") { return "Int" }
            return ft
        }
        i = i + 1
    }
    return "Int"
    }

    fun gen_set_field(object: AST.Expr, field: String, value: AST.Expr): String {
    // Check for module global write: ModuleAlias._field = value
    var sf_obj_name: String = this.get_variable_name(object)
    if (sf_obj_name.length() > 0 and this.module_prefixes.has(sf_obj_name)) {
        var sf_mp_resolved: String = this.module_prefixes.get(sf_obj_name) + field
        if (this.module_globals.has(sf_mp_resolved)) {
            var sf_val: String = this.gen_arg_value(value)
            this.emit_indent("store i64 " + sf_val + ", i64* @__g_" + this.sanitize_name(sf_mp_resolved))
            return sf_val
        }
    }
    var obj_val: String = this.gen_arg_value(object)
    var class_name: String = this.type_to_string(this.last_type)
    if (class_name == "Int" or class_name == "Any" or !this.class_fields.has(class_name)) {
        // Try resolve_class_type to handle module-qualified types (e.g. "Func.BasicBlock")
        var resolved: String = this.resolve_class_type(class_name)
        if (resolved.length() > 0 and this.class_fields.has(resolved)) {
            class_name = resolved
        } else {
            class_name = this.current_class
        }
    }
    // Resolve to struct type name for GEP
    var struct_name: String = class_name
    if (this.class_struct_names.has(class_name)) {
        struct_name = this.class_struct_names.get(class_name)
    }
    var val: String = this.gen_arg_value(value)
    var field_idx: Float = this.get_field_index(class_name, field)
    var obj_ptr: String = this.val_to_typed_ptr(obj_val, "%" + struct_name + "*")
    var field_ptr: String = this.fresh_local()
    this.emit_indent(field_ptr + " = getelementptr %" + struct_name + ", %" + struct_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
    this.emit_indent("store volatile i64 " + val + ", i64* " + field_ptr)
    return val
    }

    fun get_field_index(class_name: String, field: String): Float {
    var fields: String = this.class_fields.get(class_name)
    // Cross-module: if prefixed name not found, try bare name via reverse lookup
    if (fields.length() == 0) {
        var __fkeys: List<String> = this.class_struct_names.keys()
        var __fki: Float = 0
        while (__fki < __fkeys.length()) {
            if (this.class_struct_names.get(__fkeys[__fki]) == class_name) {
                fields = this.class_fields.get(__fkeys[__fki])
                if (fields.length() > 0) { __fki = __fkeys.length() }
            }
            __fki = __fki + 1
        }
    }
    // Also try: strip current_prefix from class_name to get bare name
    if (fields.length() == 0 and this.current_prefix.length() > 0 and class_name.starts_with(this.current_prefix)) {
        var bare: String = class_name.slice(this.current_prefix.length(), class_name.length())
        fields = this.class_fields.get(bare)
    }
    if (fields.length() == 0) return 0
    var parts: List<String> = this.split_respecting_generics(fields, ",")
    var i: Float = 0
    while (i < parts.length()) {
        var fp: List<String> = parts[i].split(":")
        if (fp[0] == field) return i
        i = i + 1
    }
    // Field not found on known class — but suppress if it's actually a method
    var is_method: Bool = false
    if (this.class_methods.has(class_name)) {
        var __methods: List = this.class_methods.get(class_name)
        if (__methods.contains(field)) { is_method = true }
    }
    // Cross-module: also check bare class name via class_struct_names reverse lookup
    if (!is_method) {
        var __fk: List<String> = this.class_methods.keys()
        var __fi: Float = 0
        while (__fi < __fk.length()) {
            var __fkey: String = __fk[__fi]
            if (this.class_struct_names.has(__fkey)) {
                if (this.class_struct_names.get(__fkey) == class_name) {
                    var __fm: List = this.class_methods.get(__fkey)
                    if (__fm.contains(field)) { is_method = true }
                }
            }
            __fi = __fi + 1
        }
    }
    return 0
}
}

fun generate(program: List<AST.Stmt>): String {
    var gen: Codegen = Codegen()
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_target(program: List<AST.Stmt>, target: String): String {
    var gen: Codegen = Codegen()
    gen.target = target
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_target_opts(program: List<AST.Stmt>, target: String, identity_mode: Bool): String {
    var gen: Codegen = Codegen()
    gen.target = target
    gen.identity_mode = identity_mode
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_imports(program: List<AST.Stmt>, imports: List<AST.Stmt>): String {
    // Merge imports and program into a single compilation unit
    var all_stmts: List<AST.Stmt> = []
    var i: Float = 0
    while (i < imports.length()) {
        all_stmts.push(imports[i])
        i = i + 1
    }
    i = 0
    while (i < program.length()) {
        all_stmts.push(program[i])
        i = i + 1
    }
    var gen: Codegen = Codegen()
    var result: String = gen.generate(all_stmts)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_modules(program: List<AST.Stmt>, module_stmts: List<List<AST.Stmt>>, module_prefixes_list: List<String>, alias_map: Map<String, String>): String {
    // Merge all module code + main program into one compilation unit
    // Each module's functions get prefixed via current_prefix during gen_stmt
    var gen: Codegen = Codegen()
    gen.module_prefixes = alias_map
    gen.module_prefixes.set("IO", "__io_")
    gen.module_prefixes.set("OS", "__os_")
    gen.module_prefixes.set("GC", "__gc_")
    // Task is handled by dedicated dispatch (Task.spawn, task.await, etc.)
    // and is NOT a real module prefix — don't register it here.
    gen.module_prefixes.set("Reflect", "stdlib_reflect_")

    // Register runtime functions first
    gen.known_functions.push("StringBuilder")
    gen.known_functions.push("__list_new")
    gen.known_functions.push("__list_push")
    gen.known_functions.push("__list_get")
    gen.known_functions.push("__list_set")
    gen.known_functions.push("__list_length")
    gen.known_functions.push("__list_pop")
    gen.known_functions.push("__sb_append")
    gen.known_functions.push("__sb_to_string")
    gen.known_functions.push("__safe_strcmp")
    gen.known_functions.push("__map_new")
    gen.known_functions.push("__map_set")
    gen.known_functions.push("__map_get")
    gen.known_functions.push("__map_has")
    gen.known_functions.push("__map_keys")
    gen.known_functions.push("__str_ends_with")
    gen.known_functions.push("__str_split")
    gen.known_functions.push("__str_replace")
    gen.known_functions.push("__int_to_string")
    gen.known_functions.push("__list_join")
    gen.known_functions.push("__join_append")
    gen.known_functions.push("__list_contains")
    gen.known_functions.push("__io_read_file")
    gen.known_functions.push("__io_write_file")
    gen.known_functions.push("__io_file_exists")
    gen.known_functions.push("__io_mkdir")
    gen.known_functions.push("__io_walk_dir")
    gen.known_functions.push("__io_append_file")
    gen.known_functions.push("__io_read_stdin")
    gen.known_functions.push("__io_readline")
    gen.known_functions.push("__os_exec")
    gen.known_functions.push("__os_args")
    gen.known_functions.push("__os_cwd")
    gen.known_functions.push("__os_path_sep")
    gen.known_functions.push("__os_platform")
    gen.known_functions.push("__os_env")
    gen.func_ret_types.set("StringBuilder", gen.str_to_type("StringBuilder"))

    // Pre-scan: register module-level VarDecls as globals
    var mi2: Float = 0
    while (mi2 < module_stmts.length()) {
        var stmts: List<AST.Stmt> = module_stmts[mi2]
        var prefix: String = module_prefixes_list[mi2]
        var si2: Float = 0
        while (si2 < stmts.length()) {
            if (!gen.is_decl(stmts[si2])) {
                var stmt_kind: String = gen.classify_stmt(stmts[si2])
                if (stmt_kind == "var") {
                    var vname: String = match (stmts[si2]) { VarDecl(n, t, i, d) => n }
                    var vdoc2: String = gen.get_var_doc(stmts[si2])
                    if (!vdoc2.starts_with("@import:")) {
                        gen.module_globals.set(prefix + vname, true)
                        gen.globals.push("@__g_" + prefix + gen.sanitize_name(vname) + " = global i64 0\n")
                        // Pre-register global variable type so functions compiled
                        // before the module init can resolve list/map/string dispatch
                        var vtype2: String = gen.get_var_type(stmts[si2])
                        if (vtype2.length() > 0 and vtype2 != "Any") {
                            gen.global_var_types.set(vname, vtype2)
                            gen.global_var_types.set(prefix + vname, vtype2)
                        }
                    }
                }
            }
            si2 = si2 + 1
        }
        mi2 = mi2 + 1
    }

    // Pre-scan: register extension methods from all modules
    mi2 = 0
    while (mi2 < module_stmts.length()) {
        var stmts: List<AST.Stmt> = module_stmts[mi2]
        var prefix: String = module_prefixes_list[mi2]
        var si2: Float = 0
        while (si2 < stmts.length()) {
            var fdoc: String = gen.get_fun_doc(stmts[si2])
            if (fdoc.starts_with("@extend:")) {
                var fname: String = gen.get_fun_name(stmts[si2])
                var ext_cls: String = fdoc.slice(8, fdoc.length())
                gen.extend_map.set(prefix + fname, ext_cls)
            }
            si2 = si2 + 1
        }
        mi2 = mi2 + 1
    }

    // Pre-register class declarations from all modules so extend funs
    // can reference class fields without null map lookups.
    mi2 = 0
    while (mi2 < module_stmts.length()) {
        var stmts3: List<AST.Stmt> = module_stmts[mi2]
        var prefix3: String = module_prefixes_list[mi2]
        var si3: Float = 0
        while (si3 < stmts3.length()) {
            var sk3: String = gen.classify_stmt(stmts3[si3])
            if (sk3 == "class") {
                var cn3: String = match (stmts3[si3]) { ClassDecl(n, p, f, m, d) => n
                    _ => ""
                }
                var cp3: String = match (stmts3[si3]) { ClassDecl(n, p, f, m, d) => p
                    _ => ""
                }
                var cf3: List<AST.Param> = match (stmts3[si3]) { ClassDecl(n, p, f, m, d) => f
                    _ => []
                }
                var cm3: List<AST.Stmt> = match (stmts3[si3]) { ClassDecl(n, p, f, m, d) => m
                    _ => []
                }
                var cd3: String = match (stmts3[si3]) { ClassDecl(n, p, f, m, d) => d
                    _ => ""
                }
                if (cd3.starts_with("@actor")) {
                    gen.actor_classes.set(cn3, true)
                    if (prefix3.length() > 0) { gen.actor_classes.set(prefix3 + cn3, true) }
                }
                if (cn3.length() > 0 and !gen.class_fields.has(cn3)) {
                    var cf3_str: String = gen.params_to_string(cf3)
                    var cf3_all: String = cf3_str
                    if (cp3.length() > 0 and gen.class_fields.has(cp3)) {
                        var cpf3: String = gen.class_fields.get(cp3)
                        if (cpf3.length() > 0) {
                            if (cf3_all.length() > 0) {
                                cf3_all = cpf3 + "," + cf3_all
                            } else {
                                cf3_all = cpf3
                            }
                        }
                    }
                    if (gen.actor_classes.has(cn3)) {
                        if (cf3_all.length() > 0) {
                            cf3_all = "__actor_busy:Int,__actor_queue:Int," + cf3_all
                        } else {
                            cf3_all = "__actor_busy:Int,__actor_queue:Int"
                        }
                    }
                    gen.class_fields.set(cn3, cf3_all)
                    gen.class_fields.set(prefix3 + cn3, cf3_all)
                    // Register struct names so resolve_class_type uses prefixed name
                    var sn3: String = cn3
                    if (prefix3.length() > 0) { sn3 = prefix3 + cn3 }
                    gen.class_struct_names.set(cn3, sn3)
                    if (prefix3.length() > 0) {
                        gen.class_struct_names.set(prefix3 + cn3, sn3)
                    }
                    var cm3_names: List<String> = []
                    var cm3i: Float = 0
                    while (cm3i < cm3.length()) {
                        var mn3: String = gen.get_fun_name(cm3[cm3i])
                        if (mn3.length() > 0) { cm3_names.push(mn3) }
                        cm3i = cm3i + 1
                    }
                    gen.class_methods.set(cn3, cm3_names)
                }
            }
            si3 = si3 + 1
        }
        mi2 = mi2 + 1
    }

    // Coroutine detection across all modules
    var cmi: Float = 0
    while (cmi < module_stmts.length()) {
        gen.current_prefix = module_prefixes_list[cmi]
        gen.mark_coroutines(module_stmts[cmi])
        cmi = cmi + 1
    }
    gen.current_prefix = ""
    gen.mark_coroutines(program)

    // Pre-registration pass: add all declaration names to known_functions
    // BEFORE compiling any bodies, so forward references don't trigger warnings
    var pr_mi: Float = 0
    while (pr_mi < module_stmts.length()) {
        var pr_prefix: String = module_prefixes_list[pr_mi]
        var pr_stmts: List<AST.Stmt> = module_stmts[pr_mi]
        var pr_si: Float = 0
        while (pr_si < pr_stmts.length()) {
            var pr_kind: String = gen.classify_stmt(pr_stmts[pr_si])
            if (pr_kind == "fun") {
                var pr_fname: String = gen.get_fun_name(pr_stmts[pr_si])
                if (pr_fname.length() > 0) {
                    var pr_emit: String = pr_prefix + pr_fname
                    if (!gen.str_in_list(gen.known_functions,pr_emit)) {
                        gen.known_functions.push(pr_emit)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname)) {
                        gen.known_functions.push(pr_fname)
                    }
                }
            } else if (pr_kind == "class") {
                var pr_cname: String = match (pr_stmts[pr_si]) { ClassDecl(n, p, f, m, d) => n
                    _ => ""
                }
                if (pr_cname.length() > 0) {
                    var pr_type_name: String = pr_cname
                    if (pr_prefix.length() > 0) {
                        pr_type_name = pr_prefix + pr_cname
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_type_name)) {
                        gen.known_functions.push(pr_type_name)
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_cname)) {
                        gen.known_functions.push(pr_cname)
                    }
                    var pr_methods: List<AST.Stmt> = match (pr_stmts[pr_si]) { ClassDecl(n, p, f, m, d) => m
                        _ => []
                    }
                    var pr_mj: Float = 0
                    while (pr_mj < pr_methods.length()) {
                        var pr_mname: String = gen.get_fun_name(pr_methods[pr_mj])
                        if (pr_mname.length() > 0) {
                            var pr_full: String = pr_cname + "__" + pr_mname
                            var pr_prefixed: String = pr_prefix + pr_full
                            if (!gen.str_in_list(gen.known_functions,pr_full)) {
                                gen.known_functions.push(pr_full)
                            }
                            if (!gen.str_in_list(gen.known_functions,pr_prefixed)) {
                                gen.known_functions.push(pr_prefixed)
                            }
                        }
                        pr_mj = pr_mj + 1
                    }
                }
            } else if (pr_kind == "enum") {
                var pr_ename: String = match (pr_stmts[pr_si]) { EnumDecl(n, v, d) => n
                    _ => ""
                }
                var pr_variants: List<AST.Variant> = match (pr_stmts[pr_si]) { EnumDecl(n, v, d) => v
                    _ => []
                }
                if (pr_ename.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_ename)) {
                        gen.known_functions.push(pr_ename)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_prefix + pr_ename)) {
                        gen.known_functions.push(pr_prefix + pr_ename)
                    }
                }
                var pr_vi: Float = 0
                while (pr_vi < pr_variants.length()) {
                    var pr_vname: String = gen.get_variant_name(pr_variants[pr_vi])
                    if (pr_vname.length() > 0 and !gen.str_in_list(gen.known_functions,pr_vname)) {
                        gen.known_functions.push(pr_vname)
                    }
                    pr_vi = pr_vi + 1
                }
            }
            pr_si = pr_si + 1
        }
        pr_mi = pr_mi + 1
    }
    // Also pre-register main program's declarations
    var pr_pi: Float = 0
    while (pr_pi < program.length()) {
        var pr_pk: String = gen.classify_stmt(program[pr_pi])
        if (pr_pk == "fun") {
            var pr_fname2: String = gen.get_fun_name(program[pr_pi])
            if (pr_fname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname2)) {
                gen.known_functions.push(pr_fname2)
            }
        } else if (pr_pk == "class") {
            var pr_cname2: String = match (program[pr_pi]) { ClassDecl(n, p, f, m, d) => n
                _ => ""
            }
            var pr_cdoc2: String = match (program[pr_pi]) { ClassDecl(n, p, f, m, d) => d
                _ => ""
            }
            if (pr_cdoc2.starts_with("@actor") and pr_cname2.length() > 0) {
                gen.actor_classes.set(pr_cname2, true)
            }
            if (pr_cname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_cname2)) {
                gen.known_functions.push(pr_cname2)
            }
            var pr_methods2: List<AST.Stmt> = match (program[pr_pi]) { ClassDecl(n, p, f, m, d) => m
                _ => []
            }
            var pr_mj2: Float = 0
            while (pr_mj2 < pr_methods2.length()) {
                var pr_mname2: String = gen.get_fun_name(pr_methods2[pr_mj2])
                if (pr_mname2.length() > 0) {
                    var pr_full2: String = pr_cname2 + "__" + pr_mname2
                    if (!gen.str_in_list(gen.known_functions,pr_full2)) {
                        gen.known_functions.push(pr_full2)
                    }
                }
                pr_mj2 = pr_mj2 + 1
            }
        } else if (pr_pk == "enum") {
            var pr_ename2: String = match (program[pr_pi]) { EnumDecl(n, v, d) => n
                _ => ""
            }
            var pr_variants2: List<AST.Variant> = match (program[pr_pi]) { EnumDecl(n, v, d) => v
                _ => []
            }
            if (pr_ename2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_ename2)) {
                gen.known_functions.push(pr_ename2)
            }
            var pr_vnames2: List<String> = []
            var pr_vi2: Float = 0
            while (pr_vi2 < pr_variants2.length()) {
                var pr_vname2: String = gen.get_variant_name(pr_variants2[pr_vi2])
                var pr_vfields2: String = gen.get_variant_fields(pr_variants2[pr_vi2])
                if (pr_vname2.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_vname2)) {
                        gen.known_functions.push(pr_vname2)
                    }
                    pr_vnames2.push(pr_vname2)
                    gen.enum_variant_tags.set(pr_ename2 + "." + pr_vname2, pr_vi2)
                    gen.enum_variant_fields.set(pr_ename2 + "." + pr_vname2, pr_vfields2)
                }
                pr_vi2 = pr_vi2 + 1
            }
            gen.enum_defs.set(pr_ename2, pr_vnames2)
        }
        pr_pi = pr_pi + 1
    }

    // Pre-scan: register func_defaults and func_param_names for ALL functions
    // from all modules BEFORE any IR generation. This ensures named argument
    // default filling works regardless of module compilation order.
    var df_mi: Float = 0
    while (df_mi < module_stmts.length()) {
        var df_stmts: List<AST.Stmt> = module_stmts[df_mi]
        var df_prefix: String = module_prefixes_list[df_mi]
        var df_si: Float = 0
        while (df_si < df_stmts.length()) {
            var df_kind: String = gen.classify_stmt(df_stmts[df_si])
            if (df_kind == "fun") {
                var df_name: String = gen.get_fun_name(df_stmts[df_si])
                var df_doc: String = gen.get_fun_doc(df_stmts[df_si])
                if (df_name.length() > 0 and !df_doc.starts_with("@intrinsic") and !df_doc.starts_with("@extern:")) {
                    var df_emit: String = df_prefix + df_name
                    var df_params: List<AST.Param> = gen.get_fun_params(df_stmts[df_si])
                    var df_defaults: List<AST.Expr> = []
                    var df_pnames: List<String> = []
                    var df_pi: Float = 0
                    while (df_pi < df_params.length()) {
                        var df_p: AST.Param = df_params[df_pi]
                        var df_dval: AST.Expr = match (df_p) { Param(n, t, d) => d }
                        var df_pn: String = match (df_p) { Param(n, t, d) => n }
                        df_defaults.push(df_dval)
                        df_pnames.push(df_pn)
                        df_pi = df_pi + 1
                    }
                    gen.func_defaults.set(df_emit, df_defaults)
                    gen.func_param_count.set(df_emit, df_params.length())
                    gen.func_param_names.set(df_emit, df_pnames)
                }
            } else if (df_kind == "class") {
                var df_cname: String = match (df_stmts[df_si]) { ClassDecl(n, p, f, m, d) => n
                    _ => ""
                }
                var df_methods: List<AST.Stmt> = match (df_stmts[df_si]) { ClassDecl(n, p, f, m, d) => m
                    _ => []
                }
                var df_mi2: Float = 0
                while (df_mi2 < df_methods.length()) {
                    var df_mname: String = gen.get_fun_name(df_methods[df_mi2])
                    if (df_mname.length() > 0) {
                        var df_mparams: List<AST.Param> = gen.get_fun_params(df_methods[df_mi2])
                        var df_mdefs: List<AST.Expr> = []
                        var df_mpnames: List<String> = []
                        df_mpnames.push("self")
                        df_mdefs.push(AST.Expr.NilLit)
                        var df_mpi: Float = 0
                        while (df_mpi < df_mparams.length()) {
                            var df_mp: AST.Param = df_mparams[df_mpi]
                            var df_mdval: AST.Expr = match (df_mp) { Param(n, t, d) => d }
                            var df_mpn: String = match (df_mp) { Param(n, t, d) => n }
                            df_mdefs.push(df_mdval)
                            df_mpnames.push(df_mpn)
                            df_mpi = df_mpi + 1
                        }
                        var df_full: String = df_cname + "__" + df_mname
                        var df_pfull: String = df_prefix + df_full
                        gen.func_defaults.set(df_pfull, df_mdefs)
                        gen.func_param_count.set(df_pfull, df_mpnames.length())
                        gen.func_param_names.set(df_pfull, df_mpnames)
                        gen.func_defaults.set(df_full, df_mdefs)
                        gen.func_param_count.set(df_full, df_mpnames.length())
                        gen.func_param_names.set(df_full, df_mpnames)
                    }
                    df_mi2 = df_mi2 + 1
                }
            }
            df_si = df_si + 1
        }
        df_mi = df_mi + 1
    }

    // Compile each module's declarations with its prefix (in dependency order)
    var module_init_names: List<String> = []
    gen.register_only = false
    var mi: Float = 0
    while (mi < module_stmts.length()) {
        var stmts: List<AST.Stmt> = module_stmts[mi]
        var prefix: String = module_prefixes_list[mi]
        gen.current_prefix = prefix

        // Compile declarations (functions, classes, enums) — use classify_stmt
        // for reliable detection since is_decl can misfire for VarDecl
        var si: Float = 0
        while (si < stmts.length()) {
            var sk: String = gen.classify_stmt(stmts[si])
            if (sk == "fun" or sk == "enum" or sk == "class") {
                // Set pending_extend_class from pre-scanned map before gen_stmt
                var fn_name: String = gen.get_fun_name(stmts[si])
                if (fn_name.length() > 0 and gen.extend_map.has(prefix + fn_name)) {
                    gen.pending_extend_class = gen.extend_map.get(prefix + fn_name)
                } else {
                    gen.pending_extend_class = ""
                }
                gen.gen_stmt(stmts[si])
            }
            si = si + 1
        }

        // Check if module has top-level code (VarDecl, ExprStmt, etc.)
        var has_top: Bool = false
        si = 0
        while (si < stmts.length()) {
            var sk2: String = gen.classify_stmt(stmts[si])
            if (sk2 == "var" or sk2 == "let_pattern") {
                has_top = true
            } else if (sk2 == "expr") {
                if (!gen.is_nil_expr_stmt(stmts[si])) {
                    has_top = true
                }
            } else if (sk2 != "fun" and sk2 != "enum" and sk2 != "class") {
                has_top = true
            }
            si = si + 1
        }

        // Wrap module's top-level code in an init function
        if (has_top) {
            var init_suffix: String = "prelude_" + mi.to_string()
            if (prefix.length() > 0) {
                init_suffix = prefix.slice(0, prefix.length() - 1)
            }
            var init_name: String = "__mod_init_" + init_suffix
            gen.known_functions.push(init_name)
            module_init_names.push(init_name)
            gen.emit("")
            gen.emit("define i64 @" + init_name + "() {")
            gen.emit("entry:")
            gen.block_terminated = false
            gen.reset_locals()
            // Alloca vars for module-level VarDecls
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            si = 0
            while (si < stmts.length()) {
                var sk3: String = gen.classify_stmt(stmts[si])
                if (sk3 == "var" or sk3 == "let_pattern" or (sk3 == "expr" and !gen.is_nil_expr_stmt(stmts[si])) or (sk3 != "fun" and sk3 != "enum" and sk3 != "class" and sk3 != "expr")) {
                    var single_list: List<AST.Stmt> = []
                    single_list.push(stmts[si])
                    gen.collect_vars(single_list, top_vars, top_var_types)
                }
                si = si + 1
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                var vn: String = top_vars[vi]
                if (!gen.module_globals.has(prefix + vn)) {
                    gen.emit_indent("%" + gen.sanitize_name(vn) + " = alloca i64")
                }
                vi = vi + 1
            }
            si = 0
            while (si < stmts.length()) {
                var sk4: String = gen.classify_stmt(stmts[si])
                if (sk4 == "var" or sk4 == "let_pattern" or (sk4 == "expr" and !gen.is_nil_expr_stmt(stmts[si])) or (sk4 != "fun" and sk4 != "enum" and sk4 != "class" and sk4 != "expr")) {
                    gen.gen_stmt(stmts[si])
                }
                si = si + 1
            }
            // Register module globals as permanent GC roots (never popped).
            // This prevents heap objects stored in module globals from being
            // prematurely collected after this init function returns.
            if (!gen.identity_mode and !gen.block_terminated) {
                vi = 0
                while (vi < top_vars.length()) {
                    var gv_name: String = top_vars[vi]
                    var gv_type: String = top_var_types[vi]
                    if (gen.module_globals.has(prefix + gv_name) and gen.is_gc_root_type(gv_type)) {
                        var gv_int: String = gen.typed_ptr_to_val("@__g_" + prefix + gen.sanitize_name(gv_name), "i64*")
                        gen.emit_indent("call void @__gc_push_root(i64 " + gv_int + ")")
                    }
                    vi = vi + 1
                }
            }
            if (!gen.block_terminated) {
                gen.emit_indent("ret i64 0")
            }
            gen.emit("}")
            gen.block_terminated = false
        }

        mi = mi + 1
    }

    // Then compile the main program without prefix
    gen.current_prefix = ""
    gen.module_init_names = module_init_names
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_modules_flat(program: List<AST.Stmt>, all_stmts: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, alias_map: Map<String, String>, target: String, named_imports: Map<String, String>): String {
    return generate_with_modules_flat_opts(program, all_stmts, boundaries, prefixes_joined, alias_map, target, named_imports, false)
}

fun generate_with_modules_flat_opts(program: List<AST.Stmt>, all_stmts: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, alias_map: Map<String, String>, target: String, named_imports: Map<String, String>, identity_mode: Bool): String {
    var gen: Codegen = Codegen()
    gen.target = target
    gen.identity_mode = identity_mode
    // Reflect runtime functions (generated at end of compilation)
    gen.known_functions.push("__reflect_get_fields")
    gen.known_functions.push("__reflect_class_name")
    gen.known_functions.push("__reflect_is_class")
    gen.known_functions.push("__reflect_construct_from_map")
    gen.known_functions.push("__reflect_number_to_string")
    gen.known_functions.push("__gc_get_type_tag")
    gen.module_prefixes = alias_map
    gen.module_prefixes.set("IO", "__io_")
    gen.module_prefixes.set("OS", "__os_")
    gen.module_prefixes.set("GC", "__gc_")
    // Task is handled by dedicated dispatch (Task.spawn, task.await, etc.)
    // and is NOT a real module prefix — don't register it here.
    gen.module_prefixes.set("Reflect", "stdlib_reflect_")
    gen.named_imports = named_imports
    gen.register_only = false
    var prefixes: List<String> = prefixes_joined.split("|")
    var dbgi: Float = 0
    while (dbgi < prefixes.length()) {
        dbgi = dbgi + 1
    }

    // Register runtime functions
    gen.known_functions.push("StringBuilder")
    gen.known_functions.push("__list_new")
    gen.known_functions.push("__list_push")
    gen.known_functions.push("__list_get")
    gen.known_functions.push("__list_set")
    gen.known_functions.push("__list_length")
    gen.known_functions.push("__list_pop")
    gen.known_functions.push("__sb_append")
    gen.known_functions.push("__sb_to_string")
    gen.known_functions.push("__safe_strcmp")
    gen.known_functions.push("__map_new")
    gen.known_functions.push("__map_set")
    gen.known_functions.push("__map_get")
    gen.known_functions.push("__map_has")
    gen.known_functions.push("__map_keys")
    gen.known_functions.push("__str_ends_with")
    gen.known_functions.push("__str_split")
    gen.known_functions.push("__str_replace")
    gen.known_functions.push("__int_to_string")
    gen.known_functions.push("__list_join")
    gen.known_functions.push("__join_append")
    gen.known_functions.push("__list_contains")
    gen.known_functions.push("__io_read_file")
    gen.known_functions.push("__io_write_file")
    gen.known_functions.push("__io_file_exists")
    gen.known_functions.push("__io_mkdir")
    gen.known_functions.push("__io_walk_dir")
    gen.known_functions.push("__io_append_file")
    gen.known_functions.push("__io_read_stdin")
    gen.known_functions.push("__io_readline")
    gen.known_functions.push("__os_exec")
    gen.known_functions.push("__os_args")
    gen.known_functions.push("__os_cwd")
    gen.known_functions.push("__os_path_sep")
    gen.known_functions.push("__os_platform")
    gen.known_functions.push("__os_env")
    gen.func_ret_types.set("StringBuilder", gen.str_to_type("StringBuilder"))

    // Pre-scan: register module-level VarDecls as globals
    var mi: Float = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        var si: Float = start
        while (si < end) {
            if (!gen.is_decl(all_stmts[si])) {
                var stmt_kind: String = gen.classify_stmt(all_stmts[si])
                if (stmt_kind == "var") {
                    var vname: String = match (all_stmts[si]) { VarDecl(n, t, i, d) => n
                        _ => ""
                    }
                    var vdoc3: String = gen.get_var_doc(all_stmts[si])
                    if (!vdoc3.starts_with("@import:")) {
                        gen.module_globals.set(prefix + vname, true)
                        gen.globals.push("@__g_" + prefix + gen.sanitize_name(vname) + " = global i64 0\n")
                        // Pre-register global variable type so functions compiled
                        // before the module init can resolve list/map/string dispatch
                        var vtype3: String = gen.get_var_type(all_stmts[si])
                        if (vtype3.length() > 0 and vtype3 != "Any") {
                            gen.global_var_types.set(vname, vtype3)
                            gen.global_var_types.set(prefix + vname, vtype3)
                        }
                    }
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-scan: register extension methods from all modules
    // This reads FunDecl doc fields early before potential memory issues
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var fdoc: String = gen.get_fun_doc(all_stmts[si])
            if (fdoc.starts_with("@extend:")) {
                var fname: String = gen.get_fun_name(all_stmts[si])
                var ext_cls: String = fdoc.slice(8, fdoc.length())
                gen.extend_map.set(prefix + fname, ext_cls)
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-register class declarations from ALL modules so extend funs in
    // imported modules can reference class fields without null map lookups.
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var mod_kind: String = gen.classify_stmt(all_stmts[si])
            if (mod_kind == "class") {
                var mod_name: String = match (all_stmts[si]) { ClassDecl(n, p, f, m, d) => n
                    _ => ""
                }
                var mod_parent: String = match (all_stmts[si]) { ClassDecl(n, p, f, m, d) => p
                    _ => ""
                }
                var mod_fields: List<AST.Param> = match (all_stmts[si]) { ClassDecl(n, p, f, m, d) => f
                    _ => []
                }
                var mod_methods: List<AST.Stmt> = match (all_stmts[si]) { ClassDecl(n, p, f, m, d) => m
                    _ => []
                }
                if (mod_name.length() > 0) {
                    var mod_fields_str: String = gen.params_to_string(mod_fields)
                    var mod_all_fields: String = mod_fields_str
                    if (mod_parent.length() > 0 and gen.class_fields.has(mod_parent)) {
                        var mod_parent_fields: String = gen.class_fields.get(mod_parent)
                        if (mod_parent_fields.length() > 0) {
                            if (mod_all_fields.length() > 0) {
                                mod_all_fields = mod_parent_fields + "," + mod_all_fields
                            } else {
                                mod_all_fields = mod_parent_fields
                            }
                        }
                    }
                    gen.class_fields.set(mod_name, mod_all_fields)
                    // Also register with module prefix for cross-module disambiguation
                    gen.class_fields.set(prefix + mod_name, mod_all_fields)
                    // Register struct names so resolve_class_type uses prefixed name
                    var mod_sn: String = mod_name
                    if (prefix.length() > 0) { mod_sn = prefix + mod_name }
                    gen.class_struct_names.set(mod_name, mod_sn)
                    if (prefix.length() > 0) {
                        gen.class_struct_names.set(prefix + mod_name, mod_sn)
                    }
                    // Register class methods list
                    var mod_method_names: List<String> = []
                    var mod_mi2: Float = 0
                    while (mod_mi2 < mod_methods.length()) {
                        var mname: String = gen.get_fun_name(mod_methods[mod_mi2])
                        if (mname.length() > 0) {
                            mod_method_names.push(mname)
                        }
                        mod_mi2 = mod_mi2 + 1
                    }
                    gen.class_methods.set(mod_name, mod_method_names)
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-scan: register main program top-level VarDecls as globals
    var gvi: Float = 0
    while (gvi < program.length()) {
        var gvk: String = gen.classify_stmt(program[gvi])
        if (gvk == "var") {
            var gvname: String = match (program[gvi]) { VarDecl(n, t, ii, d) => n
                _ => ""
            }
            if (gvname.length() > 0) {
                gen.module_globals.set(gvname, true)
                gen.globals.push("@__g_" + gen.sanitize_name(gvname) + " = global i64 0\n")
                // Pre-register global variable type for method dispatch
                var gvtype: String = gen.get_var_type(program[gvi])
                if (gvtype.length() > 0 and gvtype != "Any") {
                    gen.global_var_types.set(gvname, gvtype)
                }
            }
        }
        gvi = gvi + 1
    }

    // Pre-register main program's class declarations so imported modules'
    // extend funs can reference class fields without crashing on null map lookups.
    var pri: Float = 0
    while (pri < program.length()) {
        var pr_kind: String = gen.classify_stmt(program[pri])
        if (pr_kind == "class") {
            var pr_name: String = match (program[pri]) { ClassDecl(n, p, f, m, d) => n
                _ => ""
            }
            var pr_parent: String = match (program[pri]) { ClassDecl(n, p, f, m, d) => p
                _ => ""
            }
            var pr_fields: List<AST.Param> = match (program[pri]) { ClassDecl(n, p, f, m, d) => f
                _ => []
            }
            var pr_methods: List<AST.Stmt> = match (program[pri]) { ClassDecl(n, p, f, m, d) => m
                _ => []
            }
            var pr_doc: String = match (program[pri]) { ClassDecl(n, p, f, m, d) => d
                _ => ""
            }
            if (pr_doc.starts_with("@actor")) {
                gen.actor_classes.set(pr_name, true)
            }
            if (pr_name.length() > 0) {
                var pr_fields_str: String = gen.params_to_string(pr_fields)
                var pr_all_fields: String = pr_fields_str
                if (pr_parent.length() > 0 and gen.class_fields.has(pr_parent)) {
                    var pr_parent_fields: String = gen.class_fields.get(pr_parent)
                    if (pr_parent_fields.length() > 0) {
                        if (pr_all_fields.length() > 0) {
                            pr_all_fields = pr_parent_fields + "," + pr_all_fields
                        } else {
                            pr_all_fields = pr_parent_fields
                        }
                    }
                }
                if (gen.actor_classes.has(pr_name)) {
                    if (pr_all_fields.length() > 0) {
                        pr_all_fields = "__actor_busy:Int,__actor_queue:Int," + pr_all_fields
                    } else {
                        pr_all_fields = "__actor_busy:Int,__actor_queue:Int"
                    }
                }
                gen.class_fields.set(pr_name, pr_all_fields)
                gen.class_struct_names.set(pr_name, pr_name)
                // Register class methods list
                var pr_method_names: List<String> = []
                var pr_mi2: Float = 0
                while (pr_mi2 < pr_methods.length()) {
                    var mname: String = gen.get_fun_name(pr_methods[pr_mi2])
                    if (mname.length() > 0) {
                        pr_method_names.push(mname)
                    }
                    pr_mi2 = pr_mi2 + 1
                }
                gen.class_methods.set(pr_name, pr_method_names)
            }
        }
        pri = pri + 1
    }

    // Coroutine detection: scan each module's stmts with correct prefix
    var cmi: Float = 0
    while (cmi < prefixes.length()) {
        gen.current_prefix = prefixes[cmi]
        var cmi_start: Float = boundaries[cmi]
        var cmi_end: Float = boundaries[cmi + 1]
        var cmi_stmts: List<AST.Stmt> = []
        var cmi_si: Float = cmi_start
        while (cmi_si < cmi_end) {
            cmi_stmts.push(all_stmts[cmi_si])
            cmi_si = cmi_si + 1
        }
        gen.mark_coroutines(cmi_stmts)
        cmi = cmi + 1
    }
    gen.current_prefix = ""
    gen.mark_coroutines(program)

    // Pre-registration pass: add all declaration names to known_functions
    // BEFORE compiling any bodies, so forward references don't trigger warnings
    var pr_mi: Float = 0
    while (pr_mi < prefixes.length()) {
        var pr_prefix: String = prefixes[pr_mi]
        var pr_start: Float = boundaries[pr_mi]
        var pr_end: Float = boundaries[pr_mi + 1]
        var pr_si: Float = pr_start
        while (pr_si < pr_end) {
            var pr_kind: String = gen.classify_stmt(all_stmts[pr_si])
            if (pr_kind == "fun") {
                var pr_fname: String = gen.get_fun_name(all_stmts[pr_si])
                if (pr_fname.length() > 0) {
                    var pr_emit: String = pr_prefix + pr_fname
                    if (!gen.str_in_list(gen.known_functions,pr_emit)) {
                        gen.known_functions.push(pr_emit)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname)) {
                        gen.known_functions.push(pr_fname)
                    }
                }
            } else if (pr_kind == "class") {
                var pr_cname: String = match (all_stmts[pr_si]) { ClassDecl(n, p, f, m, d) => n
                    _ => ""
                }
                if (pr_cname.length() > 0) {
                    var pr_type_name: String = pr_cname
                    if (pr_prefix.length() > 0) {
                        pr_type_name = pr_prefix + pr_cname
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_type_name)) {
                        gen.known_functions.push(pr_type_name)
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_cname)) {
                        gen.known_functions.push(pr_cname)
                    }
                    // Register all method names as ClassName__method
                    var pr_methods: List<AST.Stmt> = match (all_stmts[pr_si]) { ClassDecl(n, p, f, m, d) => m
                        _ => []
                    }
                    var pr_mj: Float = 0
                    while (pr_mj < pr_methods.length()) {
                        var pr_mname: String = gen.get_fun_name(pr_methods[pr_mj])
                        if (pr_mname.length() > 0) {
                            var pr_full: String = pr_cname + "__" + pr_mname
                            var pr_prefixed: String = pr_prefix + pr_full
                            if (!gen.str_in_list(gen.known_functions,pr_full)) {
                                gen.known_functions.push(pr_full)
                            }
                            if (!gen.str_in_list(gen.known_functions,pr_prefixed)) {
                                gen.known_functions.push(pr_prefixed)
                            }
                        }
                        pr_mj = pr_mj + 1
                    }
                }
            } else if (pr_kind == "enum") {
                var pr_ename: String = match (all_stmts[pr_si]) { EnumDecl(n, v, d) => n
                    _ => ""
                }
                var pr_variants: List<AST.Variant> = match (all_stmts[pr_si]) { EnumDecl(n, v, d) => v
                    _ => []
                }
                if (pr_ename.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_ename)) {
                        gen.known_functions.push(pr_ename)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_prefix + pr_ename)) {
                        gen.known_functions.push(pr_prefix + pr_ename)
                    }
                }
                var pr_vnames: List<String> = []
                var pr_vi: Float = 0
                while (pr_vi < pr_variants.length()) {
                    var pr_vname: String = gen.get_variant_name(pr_variants[pr_vi])
                    var pr_vfields: String = gen.get_variant_fields(pr_variants[pr_vi])
                    if (pr_vname.length() > 0) {
                        if (!gen.str_in_list(gen.known_functions,pr_vname)) {
                            gen.known_functions.push(pr_vname)
                        }
                        pr_vnames.push(pr_vname)
                        gen.enum_variant_tags.set(pr_ename + "." + pr_vname, pr_vi)
                        gen.enum_variant_fields.set(pr_ename + "." + pr_vname, pr_vfields)
                    }
                    pr_vi = pr_vi + 1
                }
                gen.enum_defs.set(pr_ename, pr_vnames)
            }
            pr_si = pr_si + 1
        }
        pr_mi = pr_mi + 1
    }
    // Also pre-register main program's declarations
    var pr_pi: Float = 0
    while (pr_pi < program.length()) {
        var pr_pk: String = gen.classify_stmt(program[pr_pi])
        if (pr_pk == "fun") {
            var pr_fname2: String = gen.get_fun_name(program[pr_pi])
            if (pr_fname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname2)) {
                gen.known_functions.push(pr_fname2)
            }
        } else if (pr_pk == "class") {
            var pr_cname2: String = match (program[pr_pi]) { ClassDecl(n, p, f, m, d) => n
                _ => ""
            }
            var pr_cdoc2: String = match (program[pr_pi]) { ClassDecl(n, p, f, m, d) => d
                _ => ""
            }
            if (pr_cdoc2.starts_with("@actor") and pr_cname2.length() > 0) {
                gen.actor_classes.set(pr_cname2, true)
            }
            if (pr_cname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_cname2)) {
                gen.known_functions.push(pr_cname2)
            }
            var pr_methods2: List<AST.Stmt> = match (program[pr_pi]) { ClassDecl(n, p, f, m, d) => m
                _ => []
            }
            var pr_mj2: Float = 0
            while (pr_mj2 < pr_methods2.length()) {
                var pr_mname2: String = gen.get_fun_name(pr_methods2[pr_mj2])
                if (pr_mname2.length() > 0) {
                    var pr_full2: String = pr_cname2 + "__" + pr_mname2
                    if (!gen.str_in_list(gen.known_functions,pr_full2)) {
                        gen.known_functions.push(pr_full2)
                    }
                }
                pr_mj2 = pr_mj2 + 1
            }
        } else if (pr_pk == "enum") {
            var pr_ename2: String = match (program[pr_pi]) { EnumDecl(n, v, d) => n
                _ => ""
            }
            var pr_variants2: List<AST.Variant> = match (program[pr_pi]) { EnumDecl(n, v, d) => v
                _ => []
            }
            if (pr_ename2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_ename2)) {
                gen.known_functions.push(pr_ename2)
            }
            var pr_vnames2: List<String> = []
            var pr_vi2: Float = 0
            while (pr_vi2 < pr_variants2.length()) {
                var pr_vname2: String = gen.get_variant_name(pr_variants2[pr_vi2])
                var pr_vfields2: String = gen.get_variant_fields(pr_variants2[pr_vi2])
                if (pr_vname2.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_vname2)) {
                        gen.known_functions.push(pr_vname2)
                    }
                    pr_vnames2.push(pr_vname2)
                    gen.enum_variant_tags.set(pr_ename2 + "." + pr_vname2, pr_vi2)
                    gen.enum_variant_fields.set(pr_ename2 + "." + pr_vname2, pr_vfields2)
                }
                pr_vi2 = pr_vi2 + 1
            }
            gen.enum_defs.set(pr_ename2, pr_vnames2)
        }
        pr_pi = pr_pi + 1
    }

    // Pre-scan: register func_defaults and func_param_names for ALL functions
    // from all modules BEFORE any IR generation. This ensures named argument
    // default filling works regardless of module compilation order.
    mi = 0
    while (mi < prefixes.length()) {
        var df_prefix: String = prefixes[mi]
        var df_start: Float = boundaries[mi]
        var df_end: Float = boundaries[mi + 1]
        var df_si: Float = df_start
        while (df_si < df_end) {
            var df_kind: String = gen.classify_stmt(all_stmts[df_si])
            if (df_kind == "fun") {
                var df_name: String = gen.get_fun_name(all_stmts[df_si])
                var df_doc: String = gen.get_fun_doc(all_stmts[df_si])
                if (df_name.length() > 0 and !df_doc.starts_with("@intrinsic") and !df_doc.starts_with("@extern:")) {
                    var df_emit: String = df_prefix + df_name
                    var df_params: List<AST.Param> = gen.get_fun_params(all_stmts[df_si])
                    var df_defaults: List<AST.Expr> = []
                    var df_pnames: List<String> = []
                    var df_pi: Float = 0
                    while (df_pi < df_params.length()) {
                        var df_p: AST.Param = df_params[df_pi]
                        var df_dval: AST.Expr = match (df_p) { Param(n, t, d) => d }
                        var df_pn: String = match (df_p) { Param(n, t, d) => n }
                        df_defaults.push(df_dval)
                        df_pnames.push(df_pn)
                        df_pi = df_pi + 1
                    }
                    gen.func_defaults.set(df_emit, df_defaults)
                    gen.func_param_count.set(df_emit, df_params.length())
                    gen.func_param_names.set(df_emit, df_pnames)
                }
            } else if (df_kind == "class") {
                var df_cname: String = match (all_stmts[df_si]) { ClassDecl(n, p, f, m, d) => n
                    _ => ""
                }
                var df_methods: List<AST.Stmt> = match (all_stmts[df_si]) { ClassDecl(n, p, f, m, d) => m
                    _ => []
                }
                var df_mi2: Float = 0
                while (df_mi2 < df_methods.length()) {
                    var df_mname: String = gen.get_fun_name(df_methods[df_mi2])
                    if (df_mname.length() > 0) {
                        var df_mparams: List<AST.Param> = gen.get_fun_params(df_methods[df_mi2])
                        var df_mdefs: List<AST.Expr> = []
                        var df_mpnames: List<String> = []
                        df_mpnames.push("self")
                        df_mdefs.push(AST.Expr.NilLit)
                        var df_mpi: Float = 0
                        while (df_mpi < df_mparams.length()) {
                            var df_mp: AST.Param = df_mparams[df_mpi]
                            var df_mdval: AST.Expr = match (df_mp) { Param(n, t, d) => d }
                            var df_mpn: String = match (df_mp) { Param(n, t, d) => n }
                            df_mdefs.push(df_mdval)
                            df_mpnames.push(df_mpn)
                            df_mpi = df_mpi + 1
                        }
                        var df_full: String = df_cname + "__" + df_mname
                        var df_pfull: String = df_prefix + df_full
                        gen.func_defaults.set(df_pfull, df_mdefs)
                        gen.func_param_count.set(df_pfull, df_mpnames.length())
                        gen.func_param_names.set(df_pfull, df_mpnames)
                        gen.func_defaults.set(df_full, df_mdefs)
                        gen.func_param_count.set(df_full, df_mpnames.length())
                        gen.func_param_names.set(df_full, df_mpnames)
                    }
                    df_mi2 = df_mi2 + 1
                }
            }
            df_si = df_si + 1
        }
        mi = mi + 1
    }
    // Also pre-scan main program's function defaults
    var df_pi2: Float = 0
    while (df_pi2 < program.length()) {
        var df_pk: String = gen.classify_stmt(program[df_pi2])
        if (df_pk == "fun") {
            var df_name2: String = gen.get_fun_name(program[df_pi2])
            var df_doc2: String = gen.get_fun_doc(program[df_pi2])
            if (df_name2.length() > 0 and !df_doc2.starts_with("@intrinsic") and !df_doc2.starts_with("@extern:")) {
                var df_params2: List<AST.Param> = gen.get_fun_params(program[df_pi2])
                var df_defaults2: List<AST.Expr> = []
                var df_pnames2: List<String> = []
                var df_pi3: Float = 0
                while (df_pi3 < df_params2.length()) {
                    var df_p2: AST.Param = df_params2[df_pi3]
                    var df_dval2: AST.Expr = match (df_p2) { Param(n, t, d) => d }
                    var df_pn2: String = match (df_p2) { Param(n, t, d) => n }
                    df_defaults2.push(df_dval2)
                    df_pnames2.push(df_pn2)
                    df_pi3 = df_pi3 + 1
                }
                gen.func_defaults.set(df_name2, df_defaults2)
                gen.func_param_count.set(df_name2, df_params2.length())
                gen.func_param_names.set(df_name2, df_pnames2)
            }
        } else if (df_pk == "class") {
            var df_cname2: String = match (program[df_pi2]) { ClassDecl(n, p, f, m, d) => n
                _ => ""
            }
            var df_methods2: List<AST.Stmt> = match (program[df_pi2]) { ClassDecl(n, p, f, m, d) => m
                _ => []
            }
            var df_mi3: Float = 0
            while (df_mi3 < df_methods2.length()) {
                var df_mname2: String = gen.get_fun_name(df_methods2[df_mi3])
                if (df_mname2.length() > 0) {
                    var df_mparams2: List<AST.Param> = gen.get_fun_params(df_methods2[df_mi3])
                    var df_mdefs2: List<AST.Expr> = []
                    var df_mpnames2: List<String> = []
                    df_mpnames2.push("self")
                    df_mdefs2.push(AST.Expr.NilLit)
                    var df_mpi2: Float = 0
                    while (df_mpi2 < df_mparams2.length()) {
                        var df_mp2: AST.Param = df_mparams2[df_mpi2]
                        var df_mdval2: AST.Expr = match (df_mp2) { Param(n, t, d) => d }
                        var df_mpn2: String = match (df_mp2) { Param(n, t, d) => n }
                        df_mdefs2.push(df_mdval2)
                        df_mpnames2.push(df_mpn2)
                        df_mpi2 = df_mpi2 + 1
                    }
                    var df_full2: String = df_cname2 + "__" + df_mname2
                    gen.func_defaults.set(df_full2, df_mdefs2)
                    gen.func_param_count.set(df_full2, df_mpnames2.length())
                    gen.func_param_names.set(df_full2, df_mpnames2)
                }
                df_mi3 = df_mi3 + 1
            }
        }
        df_pi2 = df_pi2 + 1
    }

    // Compile each module's declarations
    var module_init_names: List<String> = []
    mi = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        gen.current_prefix = prefix

        var si: Float = start
        while (si < end) {
            // Use classify_stmt for reliable declaration detection —
            // is_decl can misfire for VarDecl due to cross-module enum matching issues
            var sk: String = gen.classify_stmt(all_stmts[si])
            if (sk == "fun" or sk == "enum" or sk == "class") {
                // Set pending_extend_class from pre-scanned map before gen_stmt
                var fn_name: String = gen.get_fun_name(all_stmts[si])
                if (fn_name.length() > 0 and gen.extend_map.has(prefix + fn_name)) {
                    gen.pending_extend_class = gen.extend_map.get(prefix + fn_name)
                } else {
                    gen.pending_extend_class = ""
                }
                gen.gen_stmt(all_stmts[si])
            }
            si = si + 1
        }

        // Module top-level code — use classify_stmt for reliable VarDecl detection
        var has_top: Bool = false
        si = start
        while (si < end) {
            var sk2: String = gen.classify_stmt(all_stmts[si])
            if (sk2 == "var" or sk2 == "let_pattern") {
                has_top = true
            } else if (sk2 == "expr") {
                if (!gen.is_nil_expr_stmt(all_stmts[si])) {
                    has_top = true
                }
            } else if (sk2 != "fun" and sk2 != "enum" and sk2 != "class") {
                has_top = true
            }
            si = si + 1
        }
        if (has_top) {
            var init_suffix2: String = "prelude_" + mi.to_string()
            if (prefix.length() > 0) {
                init_suffix2 = prefix.slice(0, prefix.length() - 1)
            }
            var init_name: String = "__mod_init_" + init_suffix2
            gen.known_functions.push(init_name)
            module_init_names.push(init_name)
            gen.emit("")
            gen.emit("define i64 @" + init_name + "() {")
            gen.emit("entry:")
            gen.block_terminated = false
            gen.reset_locals()
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            si = start
            while (si < end) {
                var sk3: String = gen.classify_stmt(all_stmts[si])
                if (sk3 == "var" or sk3 == "let_pattern" or (sk3 == "expr" and !gen.is_nil_expr_stmt(all_stmts[si])) or (sk3 != "fun" and sk3 != "enum" and sk3 != "class" and sk3 != "expr")) {
                    var single_list: List<AST.Stmt> = []
                    single_list.push(all_stmts[si])
                    gen.collect_vars(single_list, top_vars, top_var_types)
                }
                si = si + 1
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                var vn: String = top_vars[vi]
                if (!gen.module_globals.has(prefix + vn)) {
                    gen.emit_indent("%" + gen.sanitize_name(vn) + " = alloca i64")
                }
                vi = vi + 1
            }
            si = start
            while (si < end) {
                var sk4: String = gen.classify_stmt(all_stmts[si])
                if (sk4 == "var" or sk4 == "let_pattern") {
                    gen.gen_stmt(all_stmts[si])
                } else if (sk4 == "expr" and !gen.is_nil_expr_stmt(all_stmts[si])) {
                    gen.gen_stmt(all_stmts[si])
                }
                si = si + 1
            }
            // Register module globals as permanent GC roots (never popped).
            if (!gen.identity_mode and !gen.block_terminated) {
                vi = 0
                while (vi < top_vars.length()) {
                    var gv_name: String = top_vars[vi]
                    var gv_type: String = top_var_types[vi]
                    if (gen.module_globals.has(prefix + gv_name) and gen.is_gc_root_type(gv_type)) {
                        var gv_int: String = gen.typed_ptr_to_val("@__g_" + prefix + gen.sanitize_name(gv_name), "i64*")
                        gen.emit_indent("call void @__gc_push_root(i64 " + gv_int + ")")
                    }
                    vi = vi + 1
                }
            }
            if (!gen.block_terminated) {
                gen.emit_indent("ret i64 0")
            }
            gen.emit("}")
            gen.block_terminated = false
        }

        mi = mi + 1
    }

    gen.current_prefix = ""
    gen.module_init_names = module_init_names
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}



fun generate_with_target_opts2(program: List<AST.Stmt>, target: String, identity_mode: Bool, use_llvm_lib: Bool): String {
    return generate_with_target_opts3(program, target, identity_mode, use_llvm_lib, false)
}

fun generate_with_target_opts3(program: List<AST.Stmt>, target: String, identity_mode: Bool, use_llvm_lib: Bool, emit_llvm_lib: Bool): String {
    var gen: Codegen = Codegen()
    gen.target = target
    gen.identity_mode = identity_mode
    gen.use_llvm_lib = use_llvm_lib
    gen.emit_llvm_lib = emit_llvm_lib
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun generate_with_modules_flat_opts2(program: List<AST.Stmt>, all_stmts: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, alias_map: Map<String, String>, target: String, named_imports: Map<String, String>, identity_mode: Bool, use_llvm_lib: Bool): String {
    return generate_with_modules_flat_opts3(program, all_stmts, boundaries, prefixes_joined, alias_map, target, named_imports, identity_mode, use_llvm_lib, false)
}

fun generate_with_modules_flat_opts3(program: List<AST.Stmt>, all_stmts: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, alias_map: Map<String, String>, target: String, named_imports: Map<String, String>, identity_mode: Bool, use_llvm_lib: Bool, emit_llvm_lib: Bool): String {
    var gen: Codegen = Codegen()
    gen.target = target
    gen.identity_mode = identity_mode
    gen.use_llvm_lib = use_llvm_lib
    gen.emit_llvm_lib = emit_llvm_lib
    // Reflect runtime functions (generated at end of compilation)
    gen.known_functions.push("__reflect_get_fields")
    gen.known_functions.push("__reflect_class_name")
    gen.known_functions.push("__reflect_is_class")
    gen.known_functions.push("__reflect_construct_from_map")
    gen.known_functions.push("__reflect_number_to_string")
    gen.known_functions.push("__gc_get_type_tag")
    gen.module_prefixes = alias_map
    gen.module_prefixes.set("IO", "__io_")
    gen.module_prefixes.set("OS", "__os_")
    gen.module_prefixes.set("GC", "__gc_")
    // Task is handled by dedicated dispatch (Task.spawn, task.await, etc.)
    // and is NOT a real module prefix — don't register it here.
    gen.module_prefixes.set("Reflect", "stdlib_reflect_")
    gen.named_imports = named_imports
    gen.register_only = false
    var prefixes: List<String> = prefixes_joined.split("|")
    var dbgi: Float = 0
    while (dbgi < prefixes.length()) {
        dbgi = dbgi + 1
    }

    // Register runtime functions
    gen.known_functions.push("StringBuilder")
    gen.known_functions.push("__list_new")
    gen.known_functions.push("__list_push")
    gen.known_functions.push("__list_get")
    gen.known_functions.push("__list_set")
    gen.known_functions.push("__list_length")
    gen.known_functions.push("__list_pop")
    gen.known_functions.push("__sb_append")
    gen.known_functions.push("__sb_to_string")
    gen.known_functions.push("__safe_strcmp")
    gen.known_functions.push("__map_new")
    gen.known_functions.push("__map_set")
    gen.known_functions.push("__map_get")
    gen.known_functions.push("__map_has")
    gen.known_functions.push("__map_keys")
    gen.known_functions.push("__str_ends_with")
    gen.known_functions.push("__str_split")
    gen.known_functions.push("__str_replace")
    gen.known_functions.push("__int_to_string")
    gen.known_functions.push("__list_join")
    gen.known_functions.push("__join_append")
    gen.known_functions.push("__list_contains")
    gen.known_functions.push("__io_read_file")
    gen.known_functions.push("__io_write_file")
    gen.known_functions.push("__io_file_exists")
    gen.known_functions.push("__io_mkdir")
    gen.known_functions.push("__io_walk_dir")
    gen.known_functions.push("__io_append_file")
    gen.known_functions.push("__io_read_stdin")
    gen.known_functions.push("__io_readline")
    gen.known_functions.push("__os_exec")
    gen.known_functions.push("__os_args")
    gen.known_functions.push("__os_cwd")
    gen.known_functions.push("__os_path_sep")
    gen.known_functions.push("__os_platform")
    gen.known_functions.push("__os_env")
    gen.func_ret_types.set("StringBuilder", gen.str_to_type("StringBuilder"))

    // Pre-scan: register module-level VarDecls as globals
    var mi: Float = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        var si: Float = start
        while (si < end) {
            if (!gen.is_decl(all_stmts[si])) {
                var stmt_kind: String = gen.classify_stmt(all_stmts[si])
                if (stmt_kind == "var") {
                    var vname: String = match (all_stmts[si]) { VarDecl(n, t, i, d) => n
                        _ => ""
                    }
                    var vdoc3: String = gen.get_var_doc(all_stmts[si])
                    if (!vdoc3.starts_with("@import:")) {
                        gen.module_globals.set(prefix + vname, true)
                        gen.globals.push("@__g_" + prefix + gen.sanitize_name(vname) + " = global i64 0\n")
                        // Pre-register global variable type so functions compiled
                        // before the module init can resolve list/map/string dispatch
                        var vtype3: String = gen.get_var_type(all_stmts[si])
                        if (vtype3.length() > 0 and vtype3 != "Any") {
                            gen.global_var_types.set(vname, vtype3)
                            gen.global_var_types.set(prefix + vname, vtype3)
                        }
                    }
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-scan: register extension methods from all modules
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var fdoc: String = gen.get_fun_doc(all_stmts[si])
            if (fdoc.starts_with("@extend:")) {
                var fname: String = gen.get_fun_name(all_stmts[si])
                var ext_cls: String = fdoc.slice(8, fdoc.length())
                gen.extend_map.set(prefix + fname, ext_cls)
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-register class declarations from ALL modules
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var mod_kind: String = gen.classify_stmt(all_stmts[si])
            if (mod_kind == "class") {
                var mod_name: String = match (all_stmts[si]) { ClassDecl(n, p, f, m, d) => n
                    _ => ""
                }
                var mod_parent: String = match (all_stmts[si]) { ClassDecl(n, p, f, m, d) => p
                    _ => ""
                }
                var mod_fields: List<AST.Param> = match (all_stmts[si]) { ClassDecl(n, p, f, m, d) => f
                    _ => []
                }
                var mod_methods: List<AST.Stmt> = match (all_stmts[si]) { ClassDecl(n, p, f, m, d) => m
                    _ => []
                }
                if (mod_name.length() > 0) {
                    var mod_fields_str: String = gen.params_to_string(mod_fields)
                    var mod_all_fields: String = mod_fields_str
                    if (mod_parent.length() > 0 and gen.class_fields.has(mod_parent)) {
                        var mod_parent_fields: String = gen.class_fields.get(mod_parent)
                        if (mod_parent_fields.length() > 0) {
                            if (mod_all_fields.length() > 0) {
                                mod_all_fields = mod_parent_fields + "," + mod_all_fields
                            } else {
                                mod_all_fields = mod_parent_fields
                            }
                        }
                    }
                    gen.class_fields.set(mod_name, mod_all_fields)
                    gen.class_fields.set(prefix + mod_name, mod_all_fields)
                    var mod_sn: String = mod_name
                    if (prefix.length() > 0) { mod_sn = prefix + mod_name }
                    gen.class_struct_names.set(mod_name, mod_sn)
                    if (prefix.length() > 0) {
                        gen.class_struct_names.set(prefix + mod_name, mod_sn)
                    }
                    var mod_method_names: List<String> = []
                    var mod_mi2: Float = 0
                    while (mod_mi2 < mod_methods.length()) {
                        var mname: String = gen.get_fun_name(mod_methods[mod_mi2])
                        if (mname.length() > 0) {
                            mod_method_names.push(mname)
                        }
                        mod_mi2 = mod_mi2 + 1
                    }
                    gen.class_methods.set(mod_name, mod_method_names)
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-scan: register main program top-level VarDecls as globals
    var gvi: Float = 0
    while (gvi < program.length()) {
        var gvk: String = gen.classify_stmt(program[gvi])
        if (gvk == "var") {
            var gvname: String = match (program[gvi]) { VarDecl(n, t, ii, d) => n
                _ => ""
            }
            if (gvname.length() > 0) {
                gen.module_globals.set(gvname, true)
                gen.globals.push("@__g_" + gen.sanitize_name(gvname) + " = global i64 0\n")
                // Pre-register global variable type for method dispatch
                var gvtype: String = gen.get_var_type(program[gvi])
                if (gvtype.length() > 0 and gvtype != "Any") {
                    gen.global_var_types.set(gvname, gvtype)
                }
            }
        }
        gvi = gvi + 1
    }

    // Pre-register main program's class declarations
    var pri: Float = 0
    while (pri < program.length()) {
        var pr_kind: String = gen.classify_stmt(program[pri])
        if (pr_kind == "class") {
            var pr_name: String = match (program[pri]) { ClassDecl(n, p, f, m, d) => n
                _ => ""
            }
            var pr_parent: String = match (program[pri]) { ClassDecl(n, p, f, m, d) => p
                _ => ""
            }
            var pr_fields: List<AST.Param> = match (program[pri]) { ClassDecl(n, p, f, m, d) => f
                _ => []
            }
            var pr_methods: List<AST.Stmt> = match (program[pri]) { ClassDecl(n, p, f, m, d) => m
                _ => []
            }
            if (pr_name.length() > 0) {
                var pr_fields_str: String = gen.params_to_string(pr_fields)
                var pr_all_fields: String = pr_fields_str
                if (pr_parent.length() > 0 and gen.class_fields.has(pr_parent)) {
                    var pr_parent_fields: String = gen.class_fields.get(pr_parent)
                    if (pr_parent_fields.length() > 0) {
                        if (pr_all_fields.length() > 0) {
                            pr_all_fields = pr_parent_fields + "," + pr_all_fields
                        } else {
                            pr_all_fields = pr_parent_fields
                        }
                    }
                }
                gen.class_fields.set(pr_name, pr_all_fields)
                gen.class_struct_names.set(pr_name, pr_name)
                var pr_method_names: List<String> = []
                var pr_mi2: Float = 0
                while (pr_mi2 < pr_methods.length()) {
                    var mname: String = gen.get_fun_name(pr_methods[pr_mi2])
                    if (mname.length() > 0) {
                        pr_method_names.push(mname)
                    }
                    pr_mi2 = pr_mi2 + 1
                }
                gen.class_methods.set(pr_name, pr_method_names)
            }
        }
        pri = pri + 1
    }

    // Coroutine detection
    var cmi: Float = 0
    while (cmi < prefixes.length()) {
        gen.current_prefix = prefixes[cmi]
        var cmi_start: Float = boundaries[cmi]
        var cmi_end: Float = boundaries[cmi + 1]
        var cmi_stmts: List<AST.Stmt> = []
        var cmi_si: Float = cmi_start
        while (cmi_si < cmi_end) {
            cmi_stmts.push(all_stmts[cmi_si])
            cmi_si = cmi_si + 1
        }
        gen.mark_coroutines(cmi_stmts)
        cmi = cmi + 1
    }
    gen.current_prefix = ""
    gen.mark_coroutines(program)

    // Pre-registration pass
    var pr_mi: Float = 0
    while (pr_mi < prefixes.length()) {
        var pr_prefix: String = prefixes[pr_mi]
        var pr_start: Float = boundaries[pr_mi]
        var pr_end: Float = boundaries[pr_mi + 1]
        var pr_si: Float = pr_start
        while (pr_si < pr_end) {
            var pr_kind2: String = gen.classify_stmt(all_stmts[pr_si])
            if (pr_kind2 == "fun") {
                var pr_fname: String = gen.get_fun_name(all_stmts[pr_si])
                if (pr_fname.length() > 0) {
                    var pr_emit: String = pr_prefix + pr_fname
                    if (!gen.str_in_list(gen.known_functions,pr_emit)) {
                        gen.known_functions.push(pr_emit)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname)) {
                        gen.known_functions.push(pr_fname)
                    }
                }
            } else if (pr_kind2 == "class") {
                var pr_cname: String = match (all_stmts[pr_si]) { ClassDecl(n, p, f, m, d) => n
                    _ => ""
                }
                if (pr_cname.length() > 0) {
                    var pr_type_name: String = pr_cname
                    if (pr_prefix.length() > 0) {
                        pr_type_name = pr_prefix + pr_cname
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_type_name)) {
                        gen.known_functions.push(pr_type_name)
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_cname)) {
                        gen.known_functions.push(pr_cname)
                    }
                    var pr_methods: List<AST.Stmt> = match (all_stmts[pr_si]) { ClassDecl(n, p, f, m, d) => m
                        _ => []
                    }
                    var pr_mj: Float = 0
                    while (pr_mj < pr_methods.length()) {
                        var pr_mname: String = gen.get_fun_name(pr_methods[pr_mj])
                        if (pr_mname.length() > 0) {
                            var pr_full: String = pr_cname + "__" + pr_mname
                            var pr_prefixed: String = pr_prefix + pr_full
                            if (!gen.str_in_list(gen.known_functions,pr_full)) {
                                gen.known_functions.push(pr_full)
                            }
                            if (!gen.str_in_list(gen.known_functions,pr_prefixed)) {
                                gen.known_functions.push(pr_prefixed)
                            }
                        }
                        pr_mj = pr_mj + 1
                    }
                }
            } else if (pr_kind2 == "enum") {
                var pr_ename: String = match (all_stmts[pr_si]) { EnumDecl(n, v, d) => n
                    _ => ""
                }
                var pr_variants: List<AST.Variant> = match (all_stmts[pr_si]) { EnumDecl(n, v, d) => v
                    _ => []
                }
                if (pr_ename.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_ename)) {
                        gen.known_functions.push(pr_ename)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_prefix + pr_ename)) {
                        gen.known_functions.push(pr_prefix + pr_ename)
                    }
                }
                var pr_vi: Float = 0
                while (pr_vi < pr_variants.length()) {
                    var pr_vname: String = gen.get_variant_name(pr_variants[pr_vi])
                    if (pr_vname.length() > 0 and !gen.str_in_list(gen.known_functions,pr_vname)) {
                        gen.known_functions.push(pr_vname)
                    }
                    pr_vi = pr_vi + 1
                }
            }
            pr_si = pr_si + 1
        }
        pr_mi = pr_mi + 1
    }
    // Also pre-register main program's declarations
    var pr_pi: Float = 0
    while (pr_pi < program.length()) {
        var pr_pk: String = gen.classify_stmt(program[pr_pi])
        if (pr_pk == "fun") {
            var pr_fname2: String = gen.get_fun_name(program[pr_pi])
            if (pr_fname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname2)) {
                gen.known_functions.push(pr_fname2)
            }
        } else if (pr_pk == "class") {
            var pr_cname2: String = match (program[pr_pi]) { ClassDecl(n, p, f, m, d) => n
                _ => ""
            }
            var pr_cdoc2: String = match (program[pr_pi]) { ClassDecl(n, p, f, m, d) => d
                _ => ""
            }
            if (pr_cdoc2.starts_with("@actor") and pr_cname2.length() > 0) {
                gen.actor_classes.set(pr_cname2, true)
            }
            if (pr_cname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_cname2)) {
                gen.known_functions.push(pr_cname2)
            }
            var pr_methods2: List<AST.Stmt> = match (program[pr_pi]) { ClassDecl(n, p, f, m, d) => m
                _ => []
            }
            var pr_mj2: Float = 0
            while (pr_mj2 < pr_methods2.length()) {
                var pr_mname2: String = gen.get_fun_name(pr_methods2[pr_mj2])
                if (pr_mname2.length() > 0) {
                    var pr_full2: String = pr_cname2 + "__" + pr_mname2
                    if (!gen.str_in_list(gen.known_functions,pr_full2)) {
                        gen.known_functions.push(pr_full2)
                    }
                }
                pr_mj2 = pr_mj2 + 1
            }
        } else if (pr_pk == "enum") {
            var pr_ename2: String = match (program[pr_pi]) { EnumDecl(n, v, d) => n
                _ => ""
            }
            var pr_variants2: List<AST.Variant> = match (program[pr_pi]) { EnumDecl(n, v, d) => v
                _ => []
            }
            if (pr_ename2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_ename2)) {
                gen.known_functions.push(pr_ename2)
            }
            var pr_vnames2: List<String> = []
            var pr_vi2: Float = 0
            while (pr_vi2 < pr_variants2.length()) {
                var pr_vname2: String = gen.get_variant_name(pr_variants2[pr_vi2])
                var pr_vfields2: String = gen.get_variant_fields(pr_variants2[pr_vi2])
                if (pr_vname2.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_vname2)) {
                        gen.known_functions.push(pr_vname2)
                    }
                    pr_vnames2.push(pr_vname2)
                    gen.enum_variant_tags.set(pr_ename2 + "." + pr_vname2, pr_vi2)
                    gen.enum_variant_fields.set(pr_ename2 + "." + pr_vname2, pr_vfields2)
                }
                pr_vi2 = pr_vi2 + 1
            }
            gen.enum_defs.set(pr_ename2, pr_vnames2)
        }
        pr_pi = pr_pi + 1
    }

    // Pre-scan: register func_defaults and func_param_names for ALL functions
    // from all modules BEFORE any IR generation. This ensures named argument
    // default filling works regardless of module compilation order.
    mi = 0
    while (mi < prefixes.length()) {
        var df_prefix: String = prefixes[mi]
        var df_start: Float = boundaries[mi]
        var df_end: Float = boundaries[mi + 1]
        var df_si: Float = df_start
        while (df_si < df_end) {
            var df_kind: String = gen.classify_stmt(all_stmts[df_si])
            if (df_kind == "fun") {
                var df_name: String = gen.get_fun_name(all_stmts[df_si])
                var df_doc: String = gen.get_fun_doc(all_stmts[df_si])
                if (df_name.length() > 0 and !df_doc.starts_with("@intrinsic") and !df_doc.starts_with("@extern:")) {
                    var df_emit: String = df_prefix + df_name
                    var df_params: List<AST.Param> = gen.get_fun_params(all_stmts[df_si])
                    var df_defaults: List<AST.Expr> = []
                    var df_pnames: List<String> = []
                    var df_pi: Float = 0
                    while (df_pi < df_params.length()) {
                        var df_p: AST.Param = df_params[df_pi]
                        var df_dval: AST.Expr = match (df_p) { Param(n, t, d) => d }
                        var df_pn: String = match (df_p) { Param(n, t, d) => n }
                        df_defaults.push(df_dval)
                        df_pnames.push(df_pn)
                        df_pi = df_pi + 1
                    }
                    gen.func_defaults.set(df_emit, df_defaults)
                    gen.func_param_count.set(df_emit, df_params.length())
                    gen.func_param_names.set(df_emit, df_pnames)
                }
            } else if (df_kind == "class") {
                var df_cname: String = match (all_stmts[df_si]) { ClassDecl(n, p, f, m, d) => n
                    _ => ""
                }
                var df_methods: List<AST.Stmt> = match (all_stmts[df_si]) { ClassDecl(n, p, f, m, d) => m
                    _ => []
                }
                var df_mi2: Float = 0
                while (df_mi2 < df_methods.length()) {
                    var df_mname: String = gen.get_fun_name(df_methods[df_mi2])
                    if (df_mname.length() > 0) {
                        var df_mparams: List<AST.Param> = gen.get_fun_params(df_methods[df_mi2])
                        var df_mdefs: List<AST.Expr> = []
                        var df_mpnames: List<String> = []
                        df_mpnames.push("self")
                        df_mdefs.push(AST.Expr.NilLit)
                        var df_mpi: Float = 0
                        while (df_mpi < df_mparams.length()) {
                            var df_mp: AST.Param = df_mparams[df_mpi]
                            var df_mdval: AST.Expr = match (df_mp) { Param(n, t, d) => d }
                            var df_mpn: String = match (df_mp) { Param(n, t, d) => n }
                            df_mdefs.push(df_mdval)
                            df_mpnames.push(df_mpn)
                            df_mpi = df_mpi + 1
                        }
                        var df_full: String = df_cname + "__" + df_mname
                        var df_pfull: String = df_prefix + df_full
                        gen.func_defaults.set(df_pfull, df_mdefs)
                        gen.func_param_count.set(df_pfull, df_mpnames.length())
                        gen.func_param_names.set(df_pfull, df_mpnames)
                        gen.func_defaults.set(df_full, df_mdefs)
                        gen.func_param_count.set(df_full, df_mpnames.length())
                        gen.func_param_names.set(df_full, df_mpnames)
                    }
                    df_mi2 = df_mi2 + 1
                }
            }
            df_si = df_si + 1
        }
        mi = mi + 1
    }
    // Also pre-scan main program's function defaults
    var df_pi2: Float = 0
    while (df_pi2 < program.length()) {
        var df_pk: String = gen.classify_stmt(program[df_pi2])
        if (df_pk == "fun") {
            var df_name2: String = gen.get_fun_name(program[df_pi2])
            var df_doc2: String = gen.get_fun_doc(program[df_pi2])
            if (df_name2.length() > 0 and !df_doc2.starts_with("@intrinsic") and !df_doc2.starts_with("@extern:")) {
                var df_params2: List<AST.Param> = gen.get_fun_params(program[df_pi2])
                var df_defaults2: List<AST.Expr> = []
                var df_pnames2: List<String> = []
                var df_pi3: Float = 0
                while (df_pi3 < df_params2.length()) {
                    var df_p2: AST.Param = df_params2[df_pi3]
                    var df_dval2: AST.Expr = match (df_p2) { Param(n, t, d) => d }
                    var df_pn2: String = match (df_p2) { Param(n, t, d) => n }
                    df_defaults2.push(df_dval2)
                    df_pnames2.push(df_pn2)
                    df_pi3 = df_pi3 + 1
                }
                gen.func_defaults.set(df_name2, df_defaults2)
                gen.func_param_count.set(df_name2, df_params2.length())
                gen.func_param_names.set(df_name2, df_pnames2)
            }
        } else if (df_pk == "class") {
            var df_cname2: String = match (program[df_pi2]) { ClassDecl(n, p, f, m, d) => n
                _ => ""
            }
            var df_methods2: List<AST.Stmt> = match (program[df_pi2]) { ClassDecl(n, p, f, m, d) => m
                _ => []
            }
            var df_mi3: Float = 0
            while (df_mi3 < df_methods2.length()) {
                var df_mname2: String = gen.get_fun_name(df_methods2[df_mi3])
                if (df_mname2.length() > 0) {
                    var df_mparams2: List<AST.Param> = gen.get_fun_params(df_methods2[df_mi3])
                    var df_mdefs2: List<AST.Expr> = []
                    var df_mpnames2: List<String> = []
                    df_mpnames2.push("self")
                    df_mdefs2.push(AST.Expr.NilLit)
                    var df_mpi2: Float = 0
                    while (df_mpi2 < df_mparams2.length()) {
                        var df_mp2: AST.Param = df_mparams2[df_mpi2]
                        var df_mdval2: AST.Expr = match (df_mp2) { Param(n, t, d) => d }
                        var df_mpn2: String = match (df_mp2) { Param(n, t, d) => n }
                        df_mdefs2.push(df_mdval2)
                        df_mpnames2.push(df_mpn2)
                        df_mpi2 = df_mpi2 + 1
                    }
                    var df_full2: String = df_cname2 + "__" + df_mname2
                    gen.func_defaults.set(df_full2, df_mdefs2)
                    gen.func_param_count.set(df_full2, df_mpnames2.length())
                    gen.func_param_names.set(df_full2, df_mpnames2)
                }
                df_mi3 = df_mi3 + 1
            }
        }
        df_pi2 = df_pi2 + 1
    }

    // Compile each module's declarations
    var module_init_names: List<String> = []
    mi = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        gen.current_prefix = prefix

        var si: Float = start
        while (si < end) {
            var sk: String = gen.classify_stmt(all_stmts[si])
            if (sk == "fun" or sk == "enum" or sk == "class") {
                var fn_name: String = gen.get_fun_name(all_stmts[si])
                if (fn_name.length() > 0 and gen.extend_map.has(prefix + fn_name)) {
                    gen.pending_extend_class = gen.extend_map.get(prefix + fn_name)
                } else {
                    gen.pending_extend_class = ""
                }
                gen.gen_stmt(all_stmts[si])
            }
            si = si + 1
        }

        // Module top-level code
        var has_top: Bool = false
        si = start
        while (si < end) {
            var sk2: String = gen.classify_stmt(all_stmts[si])
            if (sk2 == "var" or sk2 == "let_pattern") {
                has_top = true
            } else if (sk2 == "expr") {
                if (!gen.is_nil_expr_stmt(all_stmts[si])) {
                    has_top = true
                }
            } else if (sk2 != "fun" and sk2 != "enum" and sk2 != "class") {
                has_top = true
            }
            si = si + 1
        }
        if (has_top) {
            var init_suffix2: String = "prelude_" + mi.to_string()
            if (prefix.length() > 0) {
                init_suffix2 = prefix.slice(0, prefix.length() - 1)
            }
            var init_name: String = "__mod_init_" + init_suffix2
            gen.known_functions.push(init_name)
            module_init_names.push(init_name)
            gen.emit("")
            gen.emit("define i64 @" + init_name + "() {")
            gen.emit("entry:")
            gen.block_terminated = false
            gen.reset_locals()
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            si = start
            while (si < end) {
                var sk3: String = gen.classify_stmt(all_stmts[si])
                if (sk3 == "var" or sk3 == "let_pattern" or (sk3 == "expr" and !gen.is_nil_expr_stmt(all_stmts[si])) or (sk3 != "fun" and sk3 != "enum" and sk3 != "class" and sk3 != "expr")) {
                    var single_list: List<AST.Stmt> = []
                    single_list.push(all_stmts[si])
                    gen.collect_vars(single_list, top_vars, top_var_types)
                }
                si = si + 1
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                var vn: String = top_vars[vi]
                if (!gen.module_globals.has(prefix + vn)) {
                    gen.emit_indent("%" + gen.sanitize_name(vn) + " = alloca i64")
                }
                vi = vi + 1
            }
            si = start
            while (si < end) {
                var sk4: String = gen.classify_stmt(all_stmts[si])
                if (sk4 == "var" or sk4 == "let_pattern") {
                    gen.gen_stmt(all_stmts[si])
                } else if (sk4 == "expr" and !gen.is_nil_expr_stmt(all_stmts[si])) {
                    gen.gen_stmt(all_stmts[si])
                }
                si = si + 1
            }
            // Register module globals as permanent GC roots
            if (!gen.identity_mode and !gen.block_terminated) {
                vi = 0
                while (vi < top_vars.length()) {
                    var gv_name: String = top_vars[vi]
                    var gv_type: String = top_var_types[vi]
                    if (gen.module_globals.has(prefix + gv_name) and gen.is_gc_root_type(gv_type)) {
                        var gv_int: String = gen.typed_ptr_to_val("@__g_" + prefix + gen.sanitize_name(gv_name), "i64*")
                        gen.emit_indent("call void @__gc_push_root(i64 " + gv_int + ")")
                    }
                    vi = vi + 1
                }
            }
            if (!gen.block_terminated) {
                gen.emit_indent("ret i64 0")
            }
            gen.emit("}")
            gen.block_terminated = false
        }

        mi = mi + 1
    }

    gen.current_prefix = ""
    gen.module_init_names = module_init_names
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun had_error(): Bool {
    return __codegen_errors
}
