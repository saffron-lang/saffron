        this.emit_indent(is_eq + " = icmp eq i32 " + cmp + ", 0")
        var raw: String = this.fresh_local()
        this.emit_indent(raw + " = zext i1 " + is_eq + " to i64")
        var result: String = this.emit_tag_bool(raw)
        this.last_type = AST.Type.BoolType
        return result
