// Null-safety type checker for Saffron
// Tracks nullable types and flags operations on potentially-nil values.
// Blocks compilation on errors by default (use --no-check to bypass).

import "./ast.sf" as AST

// The one spelling of "this file provably belongs to no package", shared by both
// sides of the package seam: main.sf produces it when a file sits under no
// pantry.toml, the checker stores it in decl_module_package, and every
// same-package test compares against it. Defined once here, and main.sf's
// _no_package_marker() delegates, because two independent literals that must
// stay equal is a silent-drift hazard — a mismatch would not fail to compile, it
// would quietly make every `internal` check answer "different package".
//
// A tagged marker rather than "" so a reader can distinguish "provably no
// package" from "not recorded yet" (invariant I2 of
// docs/design/compiler-rewrite.md: unknown must not be spelled as something
// concrete). It cannot collide with a real package root, which is always an
// absolute path and so always starts with "/".
fun no_package_marker(): String { return "nopkg" }

class Scope {
    var vars: Map<String, AST.Type>
    var narrowed: Map<String, AST.Type>
    var used: Map<String, Bool>

    fun init() {
        this.vars = {}
        this.narrowed = {}
        this.used = {}
    }
}

class TypeEnv {
    var scopes: List<Scope>
    var funcs: Map<String, AST.Type>
    var func_params: Map<String, String>
    var func_type_params: Map<String, String>
    var enum_variants: Map<String, String>
    var enum_fields: Map<String, String>
    var class_fields: Map<String, String>
    var class_methods: Map<String, String>

    fun init() {
        this.scopes = []
        this.scopes.push(Scope())
        this.funcs = {}
        this.func_params = {}
        this.func_type_params = {}
        this.enum_variants = {}
        this.enum_fields = {}
        this.class_fields = {}
        this.class_methods = {}
    }

    fun push_scope() {
        this.scopes.push(Scope())
    }

    fun pop_scope() {
        this.scopes.pop()
    }

    fun current_scope(): Scope {
        return this.scopes[this.scopes.length() - 1]
    }

    fun define_var(name: String, typ: AST.Type) {
        var scope: Scope = this.current_scope()
        scope.vars.set(name, typ)
    }

    fun get_var_type(name: String): AST.Type {
        // Search from innermost scope outward
        var i: Float = this.scopes.length() - 1
        while (i >= 0) {
            var scope: Scope = this.scopes[i]
            if (scope.narrowed.has(name)) {
                return scope.narrowed.get(name)
            }
            if (scope.vars.has(name)) {
                return scope.vars.get(name)
            }
            i = i - 1
        }
        return AST.Type.AnyType
    }

    // String wrapper — for backward compat during transition
    fun get_var(name: String): String {
        var t: AST.Type = this.get_var_type(name)
        return AST.type_to_string(t)
    }

    fun narrow(name: String, typ: AST.Type) {
        var scope: Scope = this.current_scope()
        scope.narrowed.set(name, typ)
    }

    fun mark_used(name: String) {
        var i: Float = this.scopes.length() - 1
        while (i >= 0) {
            var scope: Scope = this.scopes[i]
            if (scope.vars.has(name)) {
                scope.used.set(name, true)
                return
            }
            i = i - 1
        }
    }

    fun clear_narrowing() {
        var scope: Scope = this.current_scope()
        scope.narrowed = {}
    }

    fun define_func(name: String, ret_type: AST.Type) {
        this.funcs.set(name, ret_type)
    }

    // String-based define_func for callers passing string ret types from AST
    fun define_func_str(name: String, ret_type: String) {
        this.funcs.set(name, this.parse_type_str(ret_type))
    }

    fun parse_type_str(s: String): AST.Type {
        if (s == "Int" or s == "Number") return AST.Type.IntType
        if (s == "Float") return AST.Type.FloatType
        if (s == "Bool") return AST.Type.BoolType
        if (s == "String") return AST.Type.StringType
        if (s == "Nil") return AST.Type.NilType
        if (s == "Any") return AST.Type.AnyType
        return AST.Type.ClassType(s)
    }

    fun define_func_params(name: String, params_str: String) {
        this.func_params.set(name, params_str)
    }

    fun get_func_params(name: String): String {
        if (this.func_params.has(name)) {
            return this.func_params.get(name)
        }
        return ""
    }

    fun define_func_type_params(name: String, type_params_str: String) {
        this.func_type_params.set(name, type_params_str)
    }

    fun get_func_type_params(name: String): String {
        if (this.func_type_params.has(name)) {
            return this.func_type_params.get(name)
        }
        return ""
    }

    fun get_func_ret_type(name: String): AST.Type {
        if (this.funcs.has(name)) {
            return this.funcs.get(name)
        }
        return AST.Type.AnyType
    }

    // String wrapper for backward compat
    fun get_func_ret(name: String): String {
        var t: AST.Type = this.get_func_ret_type(name)
        return AST.type_to_string(t)
    }
}

class NullChecker {
    var env: TypeEnv
    var errors: List<String>
    var warnings: List<String>
    var current_func_ret: AST.Type
    var current_class: String
    // Every declared base of each class that has one, in source order. This was
    // `Map<String, String>` — one parent — which is why `class Duck extends
    // Flyable, Swimmable, Walkable` was invisible past Flyable: conformance only
    // ever consulted one base and is_subtype_node walked one chain.
    var class_parents: Map<String, List<String>>
    var class_method_names: Map<String, String>
    // The declared generic parameter names of each class, comma-joined:
    // `class Box<T>` → "T", `class Pair<K, V>` → "K,V". Keyed by the bare class
    // name, like every other class table. This is what lets a method declared
    // `fun getItem(k: Int): T` be typed at a call site: the receiver's own type
    // says `Box<String>`, so `T` is `String`. The parser used to discard these
    // names, which is why such a method inferred as Any (BUGS #95).
    var class_type_params: Map<String, String>
    // Only methods declared with an empty body are abstract, i.e. actually require
    // an implementation in a subclass. A parent method that HAS a body is inherited,
    // so demanding the child redeclare it is wrong. Keyed by class name, value is a
    // comma-joined method-name list, matching class_method_names' encoding.
    var class_abstract_methods: Map<String, String>
    var receiver_params: Map<String, String>
    // What a callee declares about the SHAPE of a function-typed parameter, keyed
    // "funcname:index" (and "Class__method:index"), exactly like receiver_params.
    //
    // This is the table that makes a block-syntax argument typed. A block
    // (`f(x) { p => ... }`) can never carry annotations — there is nowhere to
    // write them — so the only place its parameter types can come from is the
    // parameter it is being passed to. Without this the block's parameters stayed
    // AnyType, field-offset resolution fell through, and every field read answered
    // 0 or "" with no diagnostic (BUGS #86).
    //
    // The value encodes three distinct states, which is the whole point:
    //   absent      → the callee's parameter is not a function type at all (or the
    //                 callee is unknown). Nothing to say; leave the lambda alone.
    //   "?"         → declared a function type that carries NO parameter types
    //                 (bare `Fun`). The source does not contain the type, so an
    //                 untyped lambda parameter here is an error, not a guess.
    //   "" / "A,B"  → the declared parameter types (empty = declared zero params).
    //                 These get written into the lambda's own Param nodes.
    var fun_param_sigs: Map<String, String>
    var actor_classes: Map<String, Bool>
    // Bare enum names declared by two different modules with different variant
    // lists — see register_enum.
    var ambiguous_enums: List<String>

    // --- Module identity (Phase 2 of docs/design/access-modifiers.md) ---
    //
    // The prefix of the module whose declarations are being registered right
    // now, e.g. "stdlib_http_client_". Set by check_errors_with_modules while it
    // walks module by module, exactly as Resolve.resolve_imports sets
    // Resolver.current_prefix, and "" for the main program. Every declaration
    // registered while this is set is recorded as belonging to that module.
    var current_prefix: String
    // The owning package ROOT (the directory holding the pantry.toml) of the
    // module whose declarations are being registered right now, or the
    // packageless marker when that module belongs to no package. Set alongside
    // current_prefix by check_errors_with_modules from what main.sf read out of
    // the manifests — never derived from current_prefix, which carries no package
    // information at all.
    //
    // The ROOT and not the declared name: this tree has two distinct packages
    // both named "saffron" (the repo root and src/compiler/), so a name-keyed
    // comparison would call src/compiler/parser.sf and src/lib/io.sf
    // same-package when they are not. main.sf's `same_package` compares roots
    // for exactly this reason and this side must agree with it.
    var current_package: String
    // Owning module prefix per declared class/interface/actor name, keyed by the
    // *qualified* name (prefix + bare name) so two modules declaring the same
    // class are two entries rather than one overwritten one.
    //
    // Identity is deliberately recorded as a structure of separate questions
    // rather than one opaque string, because the two boundaries above `public`
    // are different questions:
    //
    //   file-scope   ("private")  → decl_module_file, populated here. A module
    //                               IS a file: main.sf's module_prefix_from_file
    //                               derives the prefix from the file path, so
    //                               the file prefix already is the file's
    //                               identity and no second notion is needed.
    //   package-scope ("internal") → decl_module_package, populated from
    //                               current_package. The authority for package
    //                               membership stays main.sf's pantry.toml
    //                               reading: it computes the owning package root
    //                               per module and hands the answer across the
    //                               seam. This side stores it and never
    //                               re-derives package membership from the
    //                               prefix string — that re-derivation is the M1
    //                               antipattern, and it could not work anyway,
    //                               since a prefix says nothing about which
    //                               manifest is nearest the file.
    //
    // Value is a package ROOT directory, or the packageless marker "nopkg" for a
    // module under no manifest. Kept tagged rather than "" so a reader can tell
    // "provably no package" from "not recorded" (invariant I2).
    var decl_module_file: Map<String, String>
    var decl_module_package: Map<String, String>
    // Bare class/interface/actor names declared by two different modules with
    // different field lists. The class-table analogue of ambiguous_enums; see
    // register_class_identity. `Response` in both src/lib/http/client.sf and
    // src/lib/http/server.sf is the live instance in the tree.
    var ambiguous_classes: List<String>
    // Bare names of classes declared by the statement list actually being
    // checked. Locality cannot be recovered from the key alone, because the
    // program under check is unprefixed: its qualified key and its bare key are
    // the same string. So it is recorded rather than inferred — a declaration
    // here always wins the bare name, and the ambiguity guard never fires for
    // it, because the checker is standing inside the module that declared it.
    var local_classes: List<String>
    // True while registering the statements under check rather than the imported
    // ones, so register_class_identity can tell a local declaration from a rival.
    var registering_local: Bool

    // --- Class-member visibility (Phase 4 of docs/design/access-modifiers.md) ---
    //
    // Which class members are restricted, keyed "<class key>#<member name>". The
    // class name is part of the key on purpose: two classes can declare the same
    // member name with different visibility — one `private fun bump`, one public
    // — and a table keyed by member name alone would reject the public one. Both
    // the qualified key (prefix + name) and the bare key are written, mirroring
    // env.class_fields, so a lookup through qualified_class_key finds the entry
    // whichever way the receiver's type was spelled.
    //
    // Class-private here means Kotlin's rule: the class BODY, not the file. A
    // same-module free function reading a private field is rejected. That
    // asymmetry with module-level `private` is deliberate (§6a) and is why the
    // stdlib's 24 leading-underscore fields must stay unannotated until they can
    // be marked `internal`. Class-`protected` is the same rule widened to
    // subclasses, which is the ONLY difference between the two (§5b).
    //
    // The VALUE is the restriction — "private" or "protected" — not a constant.
    // Phase 4 wrote only "private" and Phase 5b added "protected"; keeping one
    // table keyed the same way is what makes the two share a single ancestry walk
    // and a single decision function, rather than growing a parallel table whose
    // keys could drift out of step with this one.
    var member_visibility: Map<String, String>
    // Every member name that is restricted on *some* class. This is the gate on
    // the unresolvable-receiver warning (§3), and it is what keeps that warning
    // from being useless noise: an `Any`-typed receiver is pervasive and honest, so
    // warning about every member access through one would bury the signal. A
    // warning is only worth printing when the name being read is restricted
    // somewhere — i.e. when there is genuinely a check that could not be made.
    var restricted_member_names: Map<String, Bool>
    // Type names declared `private` — classes, interfaces, actors, enums and type
    // aliases. This is the input to the leak pass (§6b), and it is the FIRST
    // reader of a top-level declaration's visibility: module-level enforcement
    // itself is Phase 5, so until now nothing consulted `private` on a class.
    //
    // Keyed by the bare name ONLY for declarations of the module under check, and
    // always by the qualified name. Registering every module's private types
    // under their bare names would make a private `class Slot` in one module
    // rename every OTHER module's public `Slot` into a leak — a false error, and
    // false errors are the failure mode BUGS #56 records as worse than the silence
    // they replace. Confining the bare key to local declarations removes that
    // class of mistake outright, at the cost of not seeing a leak of a type
    // imported from elsewhere; that case needs Phase 5's cross-module resolution
    // to know the reference even lands there.
    var private_types: Map<String, Bool>
    // The module-level visibility of every top-level declaration — `fun`, `var`,
    // `let`, `class`, `enum`, `interface`, `actor`, `type` — that is NOT public,
    // keyed by the qualified name (defining prefix + bare name). Public is the
    // default and is deliberately never stored: the table's presence is the
    // signal that a cross-module reference must be checked, so an absent key
    // means "public, nothing to enforce" and the common case costs one `has`.
    //
    // This is Phase 5's registration half (§6a): module-level enforcement needs
    // to know, at a use site, both *which* module declared the name (already in
    // decl_module_file / decl_module_package) and *how restricted* it is. Only
    // ClassDecl recorded module identity before this phase; the four other
    // top-level kinds recorded nothing, so there was no entry for a `fun`, `var`,
    // `enum` or `type` to compare a use site against. register_module_decl fills
    // all three tables for every kind through one path.
    var decl_visibility: Map<String, String>
    // The entry file's `import "..." as Alias` map, alias → the defining module's
    // prefix, as main.sf already computes it for codegen (resolved_aliases). It is
    // what turns §6a path 2 — an alias-qualified `Mod.name` — into the same
    // prefix+name key the other two paths use: the checker has no type for a
    // module alias (it infers `Any`), so without this map it cannot recover which
    // module `Mod` names. Empty for the flat/no-module entry points, which have no
    // aliases to resolve and so never reach the path-2 branch.
    var entry_aliases: Map<String, String>

    fun init() {
        this.env = TypeEnv()
        this.errors = []
        this.warnings = []
        this.current_func_ret = AST.Type.NilType
        this.current_class = ""
        this.class_parents = {}
        this.class_method_names = {}
        this.class_type_params = {}
        this.class_abstract_methods = {}
        this.receiver_params = {}
        this.fun_param_sigs = {}
        this.actor_classes = {}
        this.ambiguous_enums = []
        this.current_prefix = ""
        this.current_package = no_package_marker()
        this.decl_module_file = {}
        this.decl_module_package = {}
        this.ambiguous_classes = []
        this.local_classes = []
        this.registering_local = false
        this.member_visibility = {}
        this.restricted_member_names = {}
        this.private_types = {}
        this.decl_visibility = {}
        this.entry_aliases = {}
    }

    fun error(msg: String) {
        this.errors.push(msg)
    }

    fun warn(msg: String) {
        this.warnings.push(msg)
    }

    fun check_unused_in_scope() {
        var scope: Scope = this.env.scopes[this.env.scopes.length() - 1]
        var declared: List<String> = scope.vars.keys()
        var i: Float = 0
        while (i < declared.length()) {
            var name: String = declared[i]
            if (!name.starts_with("_") and (!scope.used.has(name) or !scope.used.get(name))) {
                this.warn("unused variable '" + name + "'")
            }
            i = i + 1
        }
    }

    fun params_list_to_string(params: List<AST.Param>): String {
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < params.length()) {
            if (i > 0) { sb.append(",") }
            var p: AST.Param = params[i]
            var pname: String = match (p) { Param(n, t, d, p_vis) => n }
            var pt: AST.Type = match (p) { Param(n, t, d, p_vis) => t }
            var ptype: String = this.type_node_to_string(pt)
            sb.append(pname)
            sb.append(":")
            sb.append(ptype)
            i = i + 1
        }
        return sb.to_string()
    }

    // --- String → Type node conversion ---

    fun parse_type_node(s: String): AST.Type {
        if (s == "Int" or s == "Number") return AST.Type.IntType
        if (s == "Float") return AST.Type.FloatType
        if (s == "Bool") return AST.Type.BoolType
        if (s == "String") return AST.Type.StringType
        if (s == "Nil") return AST.Type.NilType
        if (s == "Any") return AST.Type.AnyType
        // Union: "String|Nil" or "Int|String"
        if (s.contains("|")) {
            var parts: List<String> = s.split("|")
            var types: List<AST.Type> = []
            var i: Float = 0
            while (i < parts.length()) {
                types.push(this.parse_type_node(parts[i]))
                i = i + 1
            }
            return AST.Type.UnionType(types)
        }
        // Generic: "List<String>" or "Map<String,Number>"
        if (s.contains("<")) {
            var lt_pos: Float = 0
            var i: Float = 0
            while (i < s.length()) {
                if (s.char_at(i) == "<") {
                    lt_pos = i
                    i = s.length()
                }
                i = i + 1
            }
            var base: String = s.slice(0, lt_pos)
            var args_str: String = s.slice(lt_pos + 1, s.length() - 1)
            var arg_strs: List<String> = this.split_type_args(args_str)
            var args: List<AST.Type> = []
            var j: Float = 0
            while (j < arg_strs.length()) {
                args.push(this.parse_type_node(arg_strs[j]))
                j = j + 1
            }
            return AST.Type.GenericType(base, args)
        }
        // Class/Enum type
        return AST.Type.ClassType(s)
    }

    fun split_type_args(s: String): List<String> {
        var args: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "," and depth == 0) {
                args.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            args.push(current)
        }
        return args
    }

    fun type_node_to_string(t: AST.Type): String {
        return AST.type_to_string(t)
    }

    fun is_any_type(t: AST.Type): Bool {
        return match (t) {
            AnyType => true
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(b, a) => false
            UnionType(ts) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_nullable_type(t: AST.Type): Bool {
        return match (t) {
            NullableType(inner) => true
            UnionType(types) => {
                // Check if any type in the union is Nil
                var has_nil: Bool = false
                var i: Float = 0
                while (i < types.length()) {
                    if (this.is_nil_type_node(types[i])) { has_nil = true }
                    i = i + 1
                }
                has_nil
            }
            NilType => true
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(b, a) => false
            FuncType(p, r) => false
        }
    }

    fun is_nil_type_node(t: AST.Type): Bool {
        return match (t) {
            NilType => true
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(b, a) => false
            UnionType(ts) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_sendable(typ: String): Bool {
        if (typ == "Int" or typ == "Float" or typ == "Number") return true
        if (typ == "Bool") return true
        if (typ == "String") return true
        if (typ == "Nil" or typ == "Any") return true
        if (this.actor_classes.has(typ)) return true
        if (this.env.enum_variants.has(typ)) return true
        if (typ.starts_with("List") or typ.starts_with("Map")) return false
        if (typ.starts_with("Fun") or typ.contains("=>")) return false
        if (this.class_parents.has(typ)) {
            var parents: List<String> = this.class_parents.get(typ)
            // `extends Sendable` in any position, not only the first. The old
            // single-String form used `.contains("Sendable")`, a substring test
            // that also accepted a base named `NotSendable`.
            if (this.list_has_string(parents, "Sendable")) return true
        }
        return false
    }

    // --- Type analysis (string-based to avoid native codegen crash) ---

    fun is_nullable(typ: String): Bool {
        if (typ == "Nil") return true
        if (typ == "Any") return false
        // Shorthand: "String?" means nullable
        if (typ.ends_with("?")) return true
        // Check for "Nil" component in union types
        if (typ.contains("|")) {
            var parts: List<String> = typ.split("|")
            var i: Float = 0
            while (i < parts.length()) {
                if (parts[i] == "Nil") return true
                i = i + 1
            }
        }
        return false
    }

    fun strip_nil(typ: String): String {
        if (typ == "Nil") return "Nil"
        // Shorthand: "String?" → "String"
        if (typ.ends_with("?")) {
            return typ.slice(0, typ.length() - 1)
        }
        if (!typ.contains("|")) return typ
        var parts: List<String> = typ.split("|")
        var filtered: List<String> = []
        var i: Float = 0
        while (i < parts.length()) {
            if (parts[i] != "Nil") {
                filtered.push(parts[i])
            }
            i = i + 1
        }
        if (filtered.length() == 0) return "Nil"
        if (filtered.length() == 1) return filtered[0]
        return filtered.join("|")
    }

    fun strip_nil_from_node(t: AST.Type): AST.Type {
        return match (t) {
            UnionType(types) => {
                var filtered: List<AST.Type> = []
                var i: Float = 0
                while (i < types.length()) {
                    var sub: AST.Type = types[i]
                    if (!this.is_nil_type_node(sub)) {
                        filtered.push(sub)
                    }
                    i = i + 1
                }
                if (filtered.length() == 1) {
                    filtered[0]
                } else if (filtered.length() == 0) {
                    AST.Type.NilType
                } else {
                    AST.Type.UnionType(filtered)
                }
            }
            NullableType(inner) => inner
            NilType => AST.Type.NilType
            IntType => AST.Type.IntType
            FloatType => AST.Type.FloatType
            BoolType => AST.Type.BoolType
            StringType => AST.Type.StringType
            AnyType => AST.Type.AnyType
            ClassType(n) => AST.Type.ClassType(n)
            EnumType(n) => AST.Type.EnumType(n)
            GenericType(b, a) => AST.Type.GenericType(b, a)
            FuncType(p, r) => AST.Type.FuncType(p, r)
        }
    }

    // --- Node-based generic type extraction ---

    fun extract_generic_args_node(t: AST.Type): List<AST.Type> {
        return match (t) {
            GenericType(base, args) => args
            IntType => []
            FloatType => []
            BoolType => []
            StringType => []
            NilType => []
            AnyType => []
            ClassType(n) => []
            EnumType(n) => []
            UnionType(ts) => []
            FuncType(p, r) => []
            NullableType(inner) => []
        }
    }

    fun extract_nth_generic_arg_node(t: AST.Type, n: Float): AST.Type {
        var args: List<AST.Type> = this.extract_generic_args_node(t)
        if (n < args.length()) {
            return args[n.floor()]
        }
        return AST.Type.AnyType
    }

    fun extract_list_element_type_node(t: AST.Type): AST.Type {
        return this.extract_nth_generic_arg_node(t, 0)
    }

    fun extract_map_value_type_node(t: AST.Type): AST.Type {
        var args: List<AST.Type> = this.extract_generic_args_node(t)
        if (args.length() >= 2) return args[1]
        if (args.length() == 1) return args[0]
        return AST.Type.AnyType
    }

    fun extract_map_key_type_node(t: AST.Type): AST.Type {
        return this.extract_nth_generic_arg_node(t, 0)
    }

    fun make_nullable_type(t: AST.Type): AST.Type {
        if (this.is_nullable_type(t)) return t
        if (this.is_nil_type_node(t)) return t
        return AST.Type.UnionType([t, AST.Type.NilType])
    }

    fun type_to_str(t: AST.Type): String {
        return match (t) {
            IntType => "Int"
            FloatType => "Float"
            BoolType => "Bool"
            StringType => "String"
            NilType => "Nil"
            AnyType => "Any"
            ClassType(n) => n
            EnumType(n) => n
            GenericType(base, args) => {
                // Render the type arguments, not just the base. Collapsing
                // Map<String,Int> to "Map" here erased the K/V that get()/keys()/
                // values() narrowing depends on — every extract_map_*_type then
                // saw a bare "Map" and returned Any. The downstream base-name
                // checks all use starts_with("Map<"), so the rendered form works.
                var rendered: String = base + "<"
                var gi: Float = 0
                while (gi < args.length()) {
                    if (gi > 0) { rendered = rendered + "," }
                    rendered = rendered + this.type_to_str(args[gi])
                    gi = gi + 1
                }
                rendered + ">"
            }
            FuncType(p, r) => "Fun"
            NullableType(inner) => this.type_to_str(inner) + "|Nil"
            UnionType(types) => {
                var result: String = ""
                var i: Float = 0
                while (i < types.length()) {
                    if (i > 0) { result = result + "|" }
                    result = result + this.type_to_str(types[i])
                    i = i + 1
                }
                result
            }
        }
    }

    fun make_nullable(typ: String): String {
        if (this.is_nullable(typ)) return typ
        if (typ == "Nil") return "Nil"
        return typ + "|Nil"
    }

    // True only when `annotated` and `actual` are two DIFFERENT concrete scalars
    // that no coercion bridges — the cases we can reject without false positives.
    // Everything uncertain returns false (allow): Any on either side (the
    // inferrer's "don't know" answer), Nil (handled by the nullable check),
    // Int->Float widening, and any non-scalar (class/enum/generic/union), whose
    // real subtype relationships aren't decidable from these two strings alone.
    fun scalar_mismatch(annotated: String, actual: String): Bool {
        if (annotated == actual) return false
        if (annotated == "Any" or actual == "Any") return false
        if (annotated == "Nil" or actual == "Nil") return false
        // Int literal / Int expression assigned to a Float binding is a widening,
        // not an error. (The reverse, Float into Int, IS a mismatch and is caught
        // below because neither is Any/Nil and they differ.)
        if (annotated == "Float" and actual == "Int") return false
        if (!this.is_scalar_name(annotated) or !this.is_scalar_name(actual)) return false
        return true
    }

    fun is_scalar_name(s: String): Bool {
        if (s == "Int") return true
        if (s == "Float") return true
        if (s == "Bool") return true
        if (s == "String") return true
        return false
    }

    fun is_subtype(child: String, parent: String): Bool {
        if (child == parent) return true
        if (parent == "Any") return true
        if (child == "Any") return true
        // Check via Type nodes
        var child_node: AST.Type = this.parse_type_node(child)
        var parent_node: AST.Type = this.parse_type_node(parent)
        return this.is_subtype_node(child_node, parent_node)
    }

    fun is_subtype_node(child: AST.Type, parent: AST.Type): Bool {
        // Quick checks using node structure
        if (this.is_any_type(parent)) return true
        if (this.is_any_type(child)) return true
        var cs: String = this.type_to_str(child)
        var ps: String = this.type_to_str(parent)
        if (cs == ps) return true
        // T is subtype of T|Nil (nullable) only when T is subtype of the non-Nil part
        if (this.is_nullable_type(parent) and !this.is_nullable_type(child)) {
            var inner: AST.Type = this.strip_nil_from_node(parent)
            return this.is_subtype_node(child, inner)
        }
        return this.inherits_from(cs, ps)
    }

    // Does `child` name `parent`, or any of its transitive bases? Breadth-first
    // over class_parents, which holds *every* declared base rather than one.
    //
    // This used to be a single `current = current.__parent` chain walk, so for
    // `class Duck extends Flyable, Swimmable, Walkable` only Flyable was ever
    // reachable and `d is Swimmable` was statically false. The visited list is
    // what makes a diamond (two bases sharing a grandparent) terminate instead
    // of re-expanding the shared ancestor, and it also bounds a cyclic
    // `extends` rather than looping forever.
    fun inherits_from(child: String, parent: String): Bool {
        if (child == parent) return true
        var visited: List<String> = []
        var work: List<String> = [child]
        while (work.length() > 0) {
            var cur: String = work.pop()
            if (cur == parent) return true
            if (!this.list_has_string(visited, cur)) {
                visited.push(cur)
                if (this.class_parents.has(cur)) {
                    var ps: List<String> = this.class_parents.get(cur)
                    var i: Float = 0
                    while (i < ps.length()) {
                        if (!this.list_has_string(visited, ps[i])) { work.push(ps[i]) }
                        i = i + 1
                    }
                }
            }
        }
        return false
    }

    fun requires_non_nil(method: String): Bool {
        if (method == "length") return true
        if (method == "split") return true
        if (method == "contains") return true
        if (method == "starts_with") return true
        if (method == "ends_with") return true
        if (method == "replace") return true
        if (method == "char_at") return true
        if (method == "slice") return true
        if (method == "to_number") return true
        if (method == "to_upper") return true
        if (method == "to_lower") return true
        if (method == "trim") return true
        if (method == "push") return true
        if (method == "pop") return true
        if (method == "join") return true
        if (method == "append") return true
        if (method == "to_string") return true
        return false
    }

    fun is_map_get_expr(expr: AST.Expr): Bool {
        // Returns true if expr is a MethodCall with method "get" on a map
        return match (expr) {
            MethodCall(obj, method, args) => method == "get"
            _ => false
        }
    }

    fun is_nil_init(expr: AST.Expr): Bool {
        // Returns true if the expression is a direct nil literal
        return match (expr) {
            NilLit => true
            _ => false
        }
    }

    // --- Check program ---

    fun check_program(stmts: List<AST.Stmt>) {
        // These statements are the module being checked, so a class declared
        // among them wins its bare name outright: it is not one of two rival
        // imported declarations, it is the one the code under check is talking
        // about. register_class_identity reads this to skip the ambiguity guard.
        this.registering_local = true
        // First pass: register declarations
        var i: Float = 0
        while (i < stmts.length()) {
            this.register_decl(stmts[i])
            i = i + 1
        }
        this.registering_local = false
        // Second pass: check bodies
        i = 0
        while (i < stmts.length()) {
            this.check_stmt(stmts[i])
            i = i + 1
        }
        // Third pass: check interface conformance
        this.check_conformance()
        // Fourth pass: a public declaration must not expose a private type in its
        // signature (§6b). Its own pass, and after registration, because it needs
        // EVERY declaration's visibility resolved before it can validate ANY
        // signature — a forward reference to a type declared later in the file is
        // ordinary, so neither earlier walk has the information when it passes the
        // declaration. Signatures only; it never descends into a body.
        this.check_leaks(stmts)
    }

    fun check_conformance() {
        // For each class with a parent, verify it implements the parent's ABSTRACT
        // methods. Methods the parent defines with a body are inherited, so requiring
        // the child to redeclare them defeats the point of inheritance — that older
        // behaviour made `class Dog extends Animal {}` an error whenever Animal had
        // any concrete method, and forced interface implementors to copy every
        // default method body.
        var classes: List<String> = this.class_parents.keys()
        var i: Float = 0
        while (i < classes.length()) {
            var child_name: String = classes[i]
            // Every base, not just the first. `class Duck extends Flyable,
            // Swimmable, Walkable` used to be conformance-checked against
            // Flyable alone, so an unimplemented abstract method on Swimmable or
            // Walkable was accepted silently.
            var parent_names: List<String> = this.class_parents.get(child_name)
            // What the child can offer: its own methods plus every concrete
            // method reachable through any ancestor. Without the inherited half,
            // `extends Abstract, Provider` — where Provider supplies a default
            // body for what Abstract declares bodyless — would be rejected, and
            // that combination is the whole point of multiple bases.
            var child_methods: List<String> = []
            if (this.class_method_names.has(child_name)) {
                child_methods = this.class_method_names.get(child_name).split(",")
            }
            var inherited: List<String> = this.inherited_method_names(child_name)
            var ii: Float = 0
            while (ii < inherited.length()) {
                if (!this.list_has_string(child_methods, inherited[ii])) {
                    child_methods.push(inherited[ii])
                }
                ii = ii + 1
            }
            var pi: Float = 0
            while (pi < parent_names.length()) {
                var parent_name: String = parent_names[pi]
                // The parent of an `extends` must actually name a class or interface.
                // Both register in class_fields during the first pass; List/Map/Sendable
                // are built-in bases. Without this check, `class OhNo extends NotClass`
                // where NotClass is a String variable compiled cleanly — inheriting from
                // a value is meaningless and must be rejected.
                if (!this.env.class_fields.has(parent_name)
                    and parent_name != "List" and parent_name != "Map"
                    and parent_name != "Sendable") {
                    this.error(child_name + " extends unknown type " + parent_name + " (not a class or interface)")
                }
                if (this.class_abstract_methods.has(parent_name)) {
                    var required_str: String = this.class_abstract_methods.get(parent_name)
                    var required_methods: List<String> = required_str.split(",")
                    var j: Float = 0
                    while (j < required_methods.length()) {
                        var method_name: String = required_methods[j]
                        if (method_name != "init" and method_name.length() > 0) {
                            // Exact name comparison, not substring: `.contains()` on the
                            // joined list meant a child method named `draw_border` would
                            // wrongly satisfy a required `draw`.
                            if (!this.list_has_string(child_methods, method_name)) {
                                this.error(child_name + " does not implement " + parent_name + "." + method_name + "()")
                            }
                        }
                        j = j + 1
                    }
                }
                pi = pi + 1
            }
            i = i + 1
        }
    }

    // Every method name reachable from `cls` through any base, at any depth,
    // that some base actually supplies a BODY for. Breadth-first over all
    // parents with a visited set, so a diamond visits the shared ancestor once
    // and a cyclic `extends` terminates.
    //
    // Abstract (bodyless) names are excluded, and that exclusion is the whole
    // point: this list is used to answer "is the requirement already satisfied
    // from above?". Including abstracts would let a requirement satisfy itself —
    // `class Circle extends Shape` with `Shape.area()` bodyless would find
    // `area` inherited from Shape and be accepted, which is precisely what
    // test/fail/conformance.sf is written to catch.
    fun inherited_method_names(cls: String): List<String> {
        var out: List<String> = []
        var visited: List<String> = [cls]
        var work: List<String> = []
        if (this.class_parents.has(cls)) {
            var seed: List<String> = this.class_parents.get(cls)
            var si: Float = 0
            while (si < seed.length()) {
                work.push(seed[si])
                si = si + 1
            }
        }
        while (work.length() > 0) {
            var cur: String = work.pop()
            if (!this.list_has_string(visited, cur)) {
                visited.push(cur)
                if (this.class_method_names.has(cur)) {
                    var names: List<String> = this.class_method_names.get(cur).split(",")
                    // The bodyless subset of `cur`'s own methods, to subtract.
                    var cur_abstract: List<String> = []
                    if (this.class_abstract_methods.has(cur)) {
                        cur_abstract = this.class_abstract_methods.get(cur).split(",")
                    }
                    var ni: Float = 0
                    while (ni < names.length()) {
                        if (names[ni].length() > 0 and !this.list_has_string(out, names[ni])
                            and !this.list_has_string(cur_abstract, names[ni])) {
                            out.push(names[ni])
                        }
                        ni = ni + 1
                    }
                }
                if (this.class_parents.has(cur)) {
                    var ups: List<String> = this.class_parents.get(cur)
                    var ui: Float = 0
                    while (ui < ups.length()) {
                        if (!this.list_has_string(visited, ups[ui])) { work.push(ups[ui]) }
                        ui = ui + 1
                    }
                }
            }
        }
        return out
    }

    fun list_has_string(haystack: List<String>, needle: String): Bool {
        var i: Float = 0
        while (i < haystack.length()) {
            if (haystack[i] == needle) { return true }
            i = i + 1
        }
        return false
    }

    fun register_decl(stmt: AST.Stmt) {
        match (stmt) {
            FunDecl(name, params, ret_type, body, doc, f_vis) => {
                // ret_type is a raw String on the AST (ast.sf FunDecl.ret_type),
                // not an AST.Type node. type_node_to_string() matched a String
                // against AST.Type patterns and fell through to the first arm, so
                // every function's registered return type collapsed to Int — which
                // silently defeated exhaustiveness on `match (some_call())`.
                this.env.define_func_str(name, ret_type)
                this.env.define_func_params(name, this.params_list_to_string(params))
                // Module-level identity + visibility, so a cross-module reference
                // to this function can be checked (§6a path 1/2/3). Public is not
                // stored; register_module_decl records the module either way so
                // decl_module_file is complete for every top-level kind.
                this.register_module_decl(name, f_vis)
                // Extract generic type params from docstring: @generic:T,U:Constraint\n
                this.extract_and_register_generics(name, doc)
                // Detect receiver-typed parameters: Fun[Type](...):Ret
                var rpi: Float = 0
                while (rpi < params.length()) {
                    var p: AST.Param = params[rpi]
                    var pt: AST.Type = match (p) { Param(n, t, d, p_vis) => t }
                    var pt_str: String = this.type_node_to_string(pt)
                    if (pt_str.starts_with("Fun[")) {
                        // Record: "funcname:index" → receiver class name
                        var recv_class: String = this.extract_receiver_class(pt_str)
                        if (recv_class.length() > 0) {
                            this.receiver_params.set(name + ":" + rpi.floor().to_string(), recv_class)
                        }
                    }
                    rpi = rpi + 1
                }
                // Record what each function-typed parameter says about its own
                // parameters, so a block-syntax argument can be typed (BUGS #86).
                this.register_fun_param_sigs(name, params)
            }
            EnumDecl(name, variants, doc, e_vis) => {
                this.register_enum(name, variants)
                this.register_type_visibility(name, e_vis)
                this.register_module_decl(name, e_vis)
            }
            ClassDecl(name, type_params, parents, fields, methods, doc, c_vis) => {
                if (doc.starts_with("@actor")) {
                    this.actor_classes.set(name, true)
                }
                if (type_params.length() > 0) {
                    this.class_type_params.set(name, type_params.join(","))
                }
                // Keyed by prefix + name as well as by the bare name, so two
                // modules declaring the same class stay distinguishable
                // (register_class_identity; the `Response` collision).
                this.register_class_identity(name, this.params_list_to_string(fields))
                this.register_member_visibility(name, fields, methods)
                this.register_type_visibility(name, c_vis)
                // register_class_identity already wrote decl_module_file /
                // decl_module_package under the qualified key; record only the
                // module-level visibility here so a cross-module reference to the
                // class (including a `private init`'d constructor call) can be
                // decided. Not routed through register_module_decl to avoid
                // re-writing the two identity maps register_class_identity owns.
                if (c_vis != "public") {
                    this.decl_visibility.set(this.current_prefix + name, c_vis)
                }
                // Register class constructor as a function returning the class type
                this.env.define_func(name, AST.Type.ClassType(name))
                if (parents.length() > 0) {
                    // `X__parent` keeps naming the *first* base only. It is read
                    // by nothing but the old chain walk's replacement (which now
                    // goes through class_parents instead) and by anything treating
                    // a class as having a single supertype; preserving the
                    // single-inheritance value keeps that meaning unchanged.
                    this.env.define_var(name + "__parent", this.parse_type_node(parents[0]))
                    this.class_parents.set(name, parents)
                }
                // Register methods with their return types and param types
                // Also populate class_method_names for receiver closure desugaring
                var method_names_list: List<String> = []
                var abstract_names_list: List<String> = []
                var mi: Float = 0
                while (mi < methods.length()) {
                    var method_name: String = match (methods[mi]) {
                        FunDecl(mn, mp, mr, mb, md, f_vis) => mn
                        _ => ""
                    }
                    // A bodyless method is abstract: it is a requirement on
                    // subclasses. A method with a body is inherited as-is.
                    var method_body: List<AST.Stmt> = match (methods[mi]) {
                        FunDecl(mn, mp, mr, mb, md, f_vis) => mb
                        _ => []
                    }
                    if (method_name.length() > 0 and method_body.length() == 0) {
                        abstract_names_list.push(method_name)
                    }
                    var method_ret: String = match (methods[mi]) {
                        FunDecl(mn, mp, mr, mb, md, f_vis) => mr
                        _ => "Any"
                    }
                    var method_params: List<AST.Param> = match (methods[mi]) {
                        FunDecl(mn, mp, mr, mb, md, f_vis) => mp
                        _ => []
                    }
                    if (method_name.length() > 0) {
                        this.env.define_func_str(name + "__" + method_name, method_ret)
                        this.env.define_func_params(name + "__" + method_name, this.params_list_to_string(method_params))
                        // Same as the FunDecl arm: a method taking a callback has to
                        // be able to type a block passed to it (BUGS #86).
                        //
                        // Registered ONLY under the receiver-qualified key, unlike
                        // receiver_params which also registers the bare method name.
                        // A bare key is ambiguous across classes — `Map.get(key)` and
                        // `App.get(path, handler)` are both `get` — and here an
                        // ambiguous hit does not merely fail to help, it can raise an
                        // error against a signature belonging to some other class.
                        // Missing a case costs nothing beyond the status quo; a
                        // spurious error breaks a correct program.
                        this.register_fun_param_sigs(name + "__" + method_name, method_params)
                        method_names_list.push(method_name)
                    }
                    mi = mi + 1
                }
                if (method_names_list.length() > 0) {
                    this.class_method_names.set(name, method_names_list.join(","))
                }
                if (abstract_names_list.length() > 0) {
                    this.class_abstract_methods.set(name, abstract_names_list.join(","))
                }
                // Actor Sendable enforcement: check method params and return types
                if (this.actor_classes.has(name)) {
                    var ami: Float = 0
                    while (ami < methods.length()) {
                        var am_name: String = match (methods[ami]) {
                            FunDecl(mn, mp, mr, mb, md, f_vis) => mn
                            _ => ""
                        }
                        if (am_name.length() > 0 and am_name != "init") {
                            var am_params: List<AST.Param> = match (methods[ami]) {
                                FunDecl(mn, mp, mr, mb, md, f_vis) => mp
                                _ => []
                            }
                            var am_ret: String = match (methods[ami]) {
                                FunDecl(mn, mp, mr, mb, md, f_vis) => mr
                                _ => "Nil"
                            }
                            var api: Float = 0
                            while (api < am_params.length()) {
                                var ap: AST.Param = am_params[api]
                                var ap_name: String = match (ap) { Param(n, t, d, p_vis) => n }
                                var ap_type: AST.Type = match (ap) { Param(n, t, d, p_vis) => t }
                                var ap_type_str: String = this.type_node_to_string(ap_type)
                                if (ap_type_str != "Any" and !this.is_sendable(ap_type_str)) {
                                    this.warn("actor '" + name + "' method '" + am_name + "' parameter '" + ap_name + "' has non-Sendable type '" + ap_type_str + "'")
                                }
                                api = api + 1
                            }
                            var am_ret_str: String = am_ret
                            if (am_ret_str != "Any" and am_ret_str != "Nil" and !this.is_sendable(am_ret_str)) {
                                this.warn("actor '" + name + "' method '" + am_name + "' returns non-Sendable type '" + am_ret_str + "'")
                            }
                        }
                        ami = ami + 1
                    }
                }
            }
            VarDecl(n, t, i, d, v_vis) => {
                // `type Name = T` reaches the checker as a VarDecl carrying the
                // docstring "@type_alias", not as a TypeAlias node — the parser
                // desugars it (parser.sf's parse_stmt). So the alias's visibility
                // has to be read here; the TypeAlias arm below is dead for
                // parser-produced trees and registering only there would silently
                // miss every `private type`.
                if (d == "@type_alias") {
                    this.register_type_visibility(n, v_vis)
                }
                // A top-level `var`/`let` (and a desugared `type` alias) is a
                // module-level name a cross-module reference can bind to via
                // resolve's globals prescan, so it needs an identity + visibility
                // entry just like a `fun`. register_decl runs over the imported
                // modules as well as the program under check, and only top-level
                // statements reach it, so this never fires for a local variable
                // inside a body.
                this.register_module_decl(n, v_vis)
            }
            ExprStmt(e) => {}
            Return(v) => {}
            If(c, t, e) => {}
            While(c, b) => {}
            Block(s) => {}
            Break => {}
            Continue => {}
            TryCatch(tb, cn, cb, fb) => {}
            Throw(v) => {}
            LetPattern(p, v) => {}
            // Covered for completeness. The parser desugars `type Name = T` into
            // a VarDecl with doc "@type_alias" and never emits this node, so the
            // real registration is in the VarDecl arm above; this one fires only
            // for a tree built some other way.
            TypeAlias(ta_n, ta_t, ta_vis) => {
                this.register_type_visibility(ta_n, ta_vis)
                this.register_module_decl(ta_n, ta_vis)
            }
        }
    }

    fun register_enum(name: String, variants: List<AST.Variant>) {
        var variant_names: List<String> = []
        var i: Float = 0
        while (i < variants.length()) {
            var v: AST.Variant = variants[i]
            var vname: String = match (v) { Variant(n, f) => n }
            var vfields: String = match (v) { Variant(n, f) => f }
            variant_names.push(vname)
            if (vfields.length() > 0) {
                this.env.enum_fields.set(name + "." + vname, vfields)
            }
            i = i + 1
        }
        var joined: String = variant_names.join(",")
        // enum_variants is keyed by the *bare* declared name. The compiler is its
        // own witness that this collides: `enum Type` exists in both
        // src/compiler/ast.sf and src/lib/llvm/types.sf, and whichever registered
        // last used to silently win — reporting `match` on an AST.Type as missing
        // Void/I1/I8/... The honest answer with the information available is that
        // the name is ambiguous, so exhaustiveness and payload-binding inference
        // are both skipped for it rather than answered from the wrong
        // declaration.
        //
        // The clause "no module boundaries" that used to be here is no longer
        // true: since Phase 2 of docs/design/access-modifiers.md the checker
        // receives module_boundaries/prefixes_joined and holds current_prefix
        // while registering, so this workaround COULD now be replaced by real
        // qualified keys the way register_class_identity does for classes.
        //
        // It deliberately is not, because unlike class_fields the enum side is
        // two tables and enum_fields' key is already compound — "EnumName.Variant"
        // — so a prefix would make it three-part and every one of the ~10 read
        // sites (resolve_enum_key_name, get_variant_fields, check_variant_arity,
        // check_exhaustiveness, the two MemberAccess arms, is_type_param, ...)
        // would have to agree on the new spelling at once. That is a larger and
        // riskier change than the collision it fixes, and it is not needed by any
        // later phase of the access-modifiers plan, so it is left as its own
        // piece of work. The prerequisite it was waiting on is now in place.
        if (this.env.enum_variants.has(name)) {
            // Bound to a String first: `.get()` is typed `String|Nil`, so comparing
            // its result directly emits __any_ne, which base.ll (the bootstrap
            // base) does not define — the link of gen3 fails with an undefined
            // symbol rather than any compile-time complaint.
            var prior: String = this.env.enum_variants.get(name)
            if (prior != joined) {
                if (!this.ambiguous_enums.contains(name)) {
                    this.ambiguous_enums.push(name)
                }
                return
            }
        }
        this.env.enum_variants.set(name, joined)
    }

    // True when `enum_type` names more than one distinct declaration, so nothing
    // keyed on its bare name can be trusted. See register_enum.
    fun is_ambiguous_enum(enum_type: String): Bool {
        return this.ambiguous_enums.contains(this.resolve_enum_key_name(enum_type))
    }

    // --- Class module identity (Phase 2 of docs/design/access-modifiers.md) ---

    // Record which module declared `name`, and flag the bare name as ambiguous
    // when a second module declares it with a different field list.
    //
    // This is register_enum's shape applied to classes, and it closes a real
    // misattribution rather than a hypothetical one: `class Response` is declared
    // in BOTH src/lib/http/client.sf (a `headers: Map<String,String>` and a
    // `body: String`) and src/lib/http/server.sf (`_headers: List<String>`,
    // `_body_bytes`, `_stream_fn`, ...). Both used to set the single key
    // "Response" in env.class_fields, so whichever registered last decided what
    // every `.field` on either one was typed — and a lookup that landed on the
    // wrong declaration reports a type error about a field the receiver does not
    // have. The qualified entry below is what a later phase reads to answer "was
    // this declared in my file?" without re-deriving it.
    fun register_class_identity(name: String, fields_str: String) {
        var qualified: String = this.current_prefix + name
        this.decl_module_file.set(qualified, this.current_prefix)
        // The package seam, now filled: current_package is what main.sf read out
        // of the manifests for the module being registered. Keyed by the same
        // qualified name as decl_module_file so the two answers about one
        // declaration cannot drift apart.
        this.decl_module_package.set(qualified, this.current_package)
        this.env.class_fields.set(qualified, fields_str)
        // A declaration in the module under check wins its bare name outright.
        // It is not one of two rival imported declarations that the checker has
        // to choose between — it is the one the code being checked means. Marking
        // it local both takes the bare key and exempts it from the guard below,
        // which is what keeps a program's own class precise even when an import
        // happens to declare the same name.
        if (this.registering_local) {
            if (!this.local_classes.contains(name)) {
                this.local_classes.push(name)
            }
            this.env.class_fields.set(name, fields_str)
            return
        }
        // The bare key stays populated so every existing unqualified lookup
        // keeps working; what changes is that a *conflicting* redeclaration no
        // longer silently overwrites it. Once two modules disagree, the bare
        // name is ambiguous and answering from either declaration would be an
        // invention, so it is recorded as such and the bare entry is left as it
        // was rather than flipped to the newcomer.
        if (this.env.class_fields.has(name)) {
            // Bound to a String first: `.get()` is typed `String|Nil`, and
            // comparing that directly emits __any_ne, which base.ll (the
            // bootstrap base) does not define — gen3 fails to link with an
            // undefined symbol rather than any compile-time complaint. Same
            // hazard register_enum documents.
            var prior: String = this.env.class_fields.get(name)
            if (prior != fields_str) {
                if (!this.ambiguous_classes.contains(name)) {
                    this.ambiguous_classes.push(name)
                }
                return
            }
        }
        this.env.class_fields.set(name, fields_str)
    }

    // Record a top-level declaration's owning module and its module-level
    // visibility, for every kind of top-level declaration. This is Phase 5's
    // single registration path (§6a). ClassDecl also calls register_class_identity
    // for its field table and ambiguity handling; this fills the identity and
    // visibility tables the module-level check reads, and it is the ONLY writer of
    // decl_visibility so the three tables stay keyed identically.
    //
    // Keyed by the qualified name (defining prefix + bare name) exactly like
    // decl_module_file, so a use site that has reconstructed the defining prefix
    // — the bare cross-module path carries it on Ref.slot — finds the same entry
    // the registration wrote. Public is never stored (see the decl_visibility
    // field comment): the presence of a key is the "must check" signal.
    fun register_module_decl(name: String, visibility: String) {
        var qualified: String = this.current_prefix + name
        this.decl_module_file.set(qualified, this.current_prefix)
        this.decl_module_package.set(qualified, this.current_package)
        if (visibility != "public") {
            this.decl_visibility.set(qualified, visibility)
        }
    }

    // May the code being checked reference a top-level `name` that resolved to
    // the module whose prefix is `slot`? This is Phase 5's module-level
    // enforcement (§6a), and it decides all three access paths at once because
    // they converge on the same fact: a resolved reference carrying the DEFINING
    // module's prefix.
    //
    //   path 3 (bare cross-module) — resolve.sf binds `helper()` to a module's
    //     function and stamps Ref.slot with that module's prefix. The checker
    //     sees Ref, not Variable, so `slot` is exactly the defining prefix.
    //   path 2 (alias-qualified `Mod.name`) — arrives as MethodCall/MemberAccess;
    //     its constructor/member forms are handled where those are inferred and
    //     also route their qualified name through here.
    //
    // `slot` is the qualifying key. An empty slot is a local/main-program name
    // (resolve leaves it "" for locals, params and the entry module), so there is
    // no boundary to cross and nothing to check — return early. That early return
    // is also what keeps the entry program's own private declarations legal to
    // use within the entry program.
    fun check_module_ref_visibility(name: String, slot: String) {
        var qualified: String = slot + name
        if (!this.decl_visibility.has(qualified)) { return nil }
        var vis: String = this.decl_visibility.get(qualified)
        if (vis == "private") {
            // Module-private: legal only from within the SAME module (file). The
            // use site's module is current_prefix; the defining module is `slot`.
            // Equal prefixes mean the same file, which is what module-private
            // permits — including a same-file free function, the deliberate
            // difference from class-private (§6a).
            if (slot == this.current_prefix) { return nil }
            this.error("private '" + name + "' is not accessible outside the module that declares it")
            return nil
        }
        if (vis == "internal") {
            // Package-internal: legal from any module in the SAME package. The
            // authority for package membership is main.sf's manifest reading,
            // handed across the seam into decl_module_package (defining side) and
            // current_package (use site). A packageless marker on either side
            // denies rather than grants — same conservative posture as
            // same_package in main.sf — so `internal` never leaks to a file that
            // provably belongs to no package.
            var def_pkg: String = no_package_marker()
            if (this.decl_module_package.has(qualified)) {
                def_pkg = this.decl_module_package.get(qualified)
            }
            if (def_pkg != no_package_marker()
                and this.current_package != no_package_marker()
                and def_pkg == this.current_package) { return nil }
            this.error("internal '" + name + "' is not accessible outside the package that declares it")
            return nil
        }
    }

    // True when `class_name` names more than one distinct declaration. A caller
    // holding only the bare name cannot tell the two apart, so anything keyed on
    // it is untrustworthy. See register_class_identity.
    fun is_ambiguous_class(class_name: String): Bool {
        var base: String = this.generic_base(class_name)
        // A local declaration is never ambiguous: the checker is inside the
        // module that declared it, so there is no question which one is meant.
        if (this.local_classes.contains(base)) return false
        return this.ambiguous_classes.contains(base)
    }

    // The qualified key for a class as seen from the module currently being
    // checked: prefix + bare name when that module declared it, else the bare
    // name. This is the lookup a later phase uses for a visibility decision;
    // Phase 2 uses it to prefer the local declaration over a same-named one from
    // another module.
    fun qualified_class_key(class_name: String): String {
        var base: String = this.generic_base(class_name)
        // A class declared by the module under check owns the bare key, so that
        // is already the right entry.
        if (this.local_classes.contains(base)) return base
        var qualified: String = this.current_prefix + base
        if (this.env.class_fields.has(qualified)) return qualified
        return base
    }

    // --- Type visibility + the leak pass (§6b of docs/design/access-modifiers.md) ---

    /// Record that a declared TYPE is private. Called for classes, interfaces,
    /// actors, enums and type aliases.
    ///
    /// The bare key is written only for a declaration of the module under check.
    /// Doing it for every module would turn a private `class Slot` in one module
    /// into a rename of every other module's public `Slot`, reporting leaks that
    /// do not exist — and a false error is worse than the silence it replaces
    /// (BUGS #56). See the field comment on private_types.
    fun register_type_visibility(name: String, visibility: String) {
        if (visibility != "private") { return nil }
        this.private_types.set(this.current_prefix + name, true)
        if (this.registering_local) {
            this.private_types.set(name, true)
        }
    }

    /// How to name a declaration whose signature the leak pass is checking.
    ///
    /// The pass runs on everything that is not `private`, because everything else
    /// is reachable from somewhere the private type is not — `internal` from the
    /// package, `protected` from a subclass in any module. So the subject label
    /// must say which it is: calling a `protected` field "public" in a diagnostic
    /// tells the reader to look for a `public` they will not find, and invites the
    /// conclusion that the check is wrong rather than that their field leaks.
    fun exposure_label(visibility: String): String {
        if (visibility.length() == 0) { return "public" }
        return visibility
    }

    /// Is the type `name` spells private, as seen from the module under check?
    fun is_private_type(name: String): Bool {
        var base: String = this.generic_base(name)
        if (this.private_types.has(base)) { return true }
        return this.private_types.has(this.current_prefix + base)
    }

    /// Every bare type name a type spelling mentions, at any depth.
    ///
    ///   "Slot"                      → ["Slot"]
    ///   "List<Slot>"                → ["List", "Slot"]
    ///   "Map<String,List<Slot>>"    → ["Map", "String", "List", "Slot"]
    ///   "Slot|Nil"                  → ["Slot", "Nil"]
    ///
    /// One splitter over `<`, `>`, `,` and `|`, which is all the leak pass needs:
    /// it asks "does this spelling mention a private name", never "what is the
    /// structure". Deliberately NOT a second `<>` parser — I10, and BUGS #27 is
    /// what a second one costs. The existing split_type_args stays the tool for
    /// anything that needs the arguments themselves.
    ///
    /// Purely lexical, and that matters for L6: the union case decomposes on `|`
    /// as text and never emits a runtime type test, so nothing here lowers to
    /// `is` and BUGS #69 (`is` broken on unions) is untouched by design. Do not
    /// "improve" this into a runtime check.
    fun mentioned_type_names(spelling: String): List<String> {
        var names: List<String> = []
        var current: String = ""
        var i: Float = 0
        while (i < spelling.length()) {
            var ch: String = spelling.char_at(i)
            if (ch == "<" or ch == ">" or ch == "," or ch == "|"
                or ch == " " or ch == "?" or ch == "(" or ch == ")") {
                if (current.length() > 0) {
                    names.push(current)
                    current = ""
                }
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) { names.push(current) }
        return names
    }

    /// The first private type `spelling` mentions, or "".
    fun private_type_in(spelling: String): String {
        var names: List<String> = this.mentioned_type_names(spelling)
        var i: Float = 0
        while (i < names.length()) {
            if (this.is_private_type(names[i])) { return names[i] }
            i = i + 1
        }
        return ""
    }

    /// One leak diagnostic. `via` carries the full spelling when it differs from
    /// the leaked name, so the transitive cases (L5, L6) show the path — that is
    /// part of the message, not decoration: "exposes private type 'Slot'" on a
    /// return type spelled `Map<String,List<Slot>>` does not tell the reader
    /// where to look.
    fun report_leak(subject: String, position: String, leaked: String, spelling: String) {
        var via: String = ""
        if (spelling != leaked) { via = " (via " + spelling + ")" }
        this.error(subject + " exposes private type '" + leaked + "' in " + position + via)
    }

    /// Check one type spelling in a public position and report if it leaks.
    fun check_leak(subject: String, position: String, spelling: String) {
        if (spelling.length() == 0) { return nil }
        var leaked: String = this.private_type_in(spelling)
        if (leaked.length() == 0) { return nil }
        this.report_leak(subject, position, leaked, spelling)
    }

    /// The leak pass: a public declaration must not expose a private type in its
    /// signature (§6b). A fourth pass, sibling to check_conformance, run after
    /// registration — it needs EVERY declaration's visibility resolved before it
    /// can validate ANY signature, so it cannot be folded into either earlier
    /// walk. Signatures only; it never descends into a body.
    ///
    /// Cheap exit: with no private type declared anywhere there is nothing any
    /// signature could leak, so the walk is skipped entirely rather than
    /// splitting every type spelling in the program to find nothing.
    fun check_leaks(stmts: List<AST.Stmt>) {
        if (this.private_types.keys().length() == 0) { return nil }
        var i: Float = 0
        while (i < stmts.length()) {
            this.check_leaks_in_decl(stmts[i])
            i = i + 1
        }
    }

    fun check_leaks_in_decl(stmt: AST.Stmt) {
        match (stmt) {
            FunDecl(name, params, ret_type, body, doc, f_vis) => {
                if (f_vis != "private") {
                    this.check_fun_leaks(this.exposure_label(f_vis) + " fun '" + name + "'", params, ret_type)
                }
            }
            ClassDecl(name, type_params, parents, fields, methods, doc, c_vis) => {
                // L4: a member of a private class is a no-op, and so is the class's
                // own parent list. Every path to any of it is already gated by the
                // enclosing private type, so erroring would force annotating every
                // member of every private class — churn buying nothing. This is the
                // "reachable from outside" rule stated as one early return.
                if (c_vis == "private") { return nil }
                // L7: loops EVERY parent, and the diagnostic names which one. Only
                // parents[0] contributes fields, but every base contributes methods
                // and answers `is`, so a private type in ANY position leaks its
                // members through the public child. Before BUGS #111 the parser
                // discarded parents 2..n, which would have made this a silent hole
                // in exactly the multiple-inheritance case; it is now a positive
                // requirement rather than a caveat.
                var pi: Float = 0
                while (pi < parents.length()) {
                    var parent_leak: String = this.private_type_in(parents[pi])
                    if (parent_leak.length() > 0) {
                        this.error(this.exposure_label(c_vis) + " class '" + name + "' extends private type '"
                            + parent_leak + "'; '" + parent_leak
                            + "'s members become reachable through '" + name + "'")
                    }
                    pi = pi + 1
                }
                // L1: fields reachable from outside — everything but `private`.
                var fi: Float = 0
                while (fi < fields.length()) {
                    var f_name: String = match (fields[fi]) { Param(pn, pt, pd, p_vis) => pn }
                    var f_vis: String = match (fields[fi]) { Param(pn, pt, pd, p_vis) => p_vis }
                    var f_type: AST.Type = match (fields[fi]) { Param(pn, pt, pd, p_vis) => pt }
                    if (f_vis != "private") {
                        this.check_leak(this.exposure_label(f_vis) + " field '" + name + "." + f_name + "'",
                            "its declared type", this.type_to_str(f_type))
                    }
                    fi = fi + 1
                }
                // L2/L3 for methods.
                var mi: Float = 0
                while (mi < methods.length()) {
                    var m_name: String = match (methods[mi]) {
                        FunDecl(mn, mp, mr, mb, md, mv) => mn
                        _ => ""
                    }
                    var m_vis: String = match (methods[mi]) {
                        FunDecl(mn, mp, mr, mb, md, mv) => mv
                        _ => "public"
                    }
                    var m_params: List<AST.Param> = match (methods[mi]) {
                        FunDecl(mn, mp, mr, mb, md, mv) => mp
                        _ => []
                    }
                    var m_ret: String = match (methods[mi]) {
                        FunDecl(mn, mp, mr, mb, md, mv) => mr
                        _ => ""
                    }
                    if (m_name.length() > 0 and m_vis != "private") {
                        this.check_fun_leaks(this.exposure_label(m_vis) + " method '" + name + "." + m_name + "'",
                            m_params, m_ret)
                    }
                    mi = mi + 1
                }
            }
            VarDecl(n, t, i, d, v_vis) => {
                if (v_vis != "private" and d != "@type_alias") {
                    this.check_var_leaks(n, t, i, v_vis)
                }
            }
            EnumDecl(name, variants, doc, e_vis) => {
                // A variant's payload spelling is a String on the Variant node
                // ("field:Type,field:Type"), and mentioned_type_names splits on
                // the punctuation that separates them, so a private type anywhere
                // in a payload is found without parsing the payload.
                if (e_vis != "private") {
                    var vi: Float = 0
                    while (vi < variants.length()) {
                        var v_name: String = match (variants[vi]) { Variant(vn, vf) => vn }
                        var v_fields: String = match (variants[vi]) { Variant(vn, vf) => vf }
                        this.check_leak(this.exposure_label(e_vis) + " enum '" + name + "." + v_name + "'",
                            "its payload", v_fields)
                        vi = vi + 1
                    }
                }
            }
            ExprStmt(e) => {}
            Return(v) => {}
            If(c, t, e) => {}
            While(c, b) => {}
            Block(s) => {}
            Break => {}
            Continue => {}
            TryCatch(tb, cn, cb, fb) => {}
            Throw(v) => {}
            LetPattern(p, v) => {}
            TypeAlias(ta_n, ta_t, ta_vis) => {
                if (ta_vis != "private") {
                    this.check_leak(this.exposure_label(ta_vis) + " type alias '" + ta_n + "'", "its target", ta_t)
                }
            }
        }
    }

    /// L2 and L3: a public function or method's parameter and return types.
    ///
    /// L8, stated rather than papered over: a `Fun`-typed position is
    /// DELIBERATELY unchecked, and it is not merely hard. The surface `Fun` erases
    /// to a signature-free type — BUGS #56: "the static type of an indirect call's
    /// result is not recovered (`Fun` carries no return type)", and #86 is the same
    /// root for block parameters — so `fun subscribe(cb: Fun)` where `cb` receives
    /// a private type carries no information to check against. Closing it means
    /// giving `Fun` a signature, which is a language change tracked by #56. The
    /// spelling "Fun" mentions no type name, so it simply finds nothing here;
    /// nothing suppresses it and nothing pretends to cover it.
    fun check_fun_leaks(subject: String, params: List<AST.Param>, ret_type: String) {
        var pi: Float = 0
        while (pi < params.length()) {
            var p_name: String = match (params[pi]) { Param(pn, pt, pd, p_vis) => pn }
            var p_type: AST.Type = match (params[pi]) { Param(pn, pt, pd, p_vis) => pt }
            // AST.Param is the node for both a class field and a function
            // parameter, so type_to_str is the one renderer for both — the raw
            // String / AST.Type split that forces two entry points here is I3's
            // complaint, and this feature consumes that debt rather than fixing it.
            this.check_leak(subject, "parameter " + (pi + 1).floor().to_string()
                + " ('" + p_name + "')", this.type_to_str(p_type))
            pi = pi + 1
        }
        this.check_leak(subject, "its return type", ret_type)
    }

    /// L9: a public top-level `var`.
    ///
    /// The verdict splits on whether there is an anchor to point at. An explicit
    /// annotation is an anchor and is an error. An INFERRED type is an error only
    /// when the initializer is syntactically a constructor call of a private class
    /// — the call is the anchor, and the diagnostic can name it. Inferred through
    /// several steps, the anchor is the compiler's guess, and this codebase's
    /// history is unambiguous about erroring on guesses: #56's over-erroring
    /// "traded one silent wrong answer for a batch of false rejections". So that
    /// case warns. The asymmetry is deliberate — say what you know, and say when
    /// you do not know.
    fun check_var_leaks(name: String, type_ann: String, initializer: AST.Expr, visibility: String) {
        var subject: String = this.exposure_label(visibility) + " var '" + name + "'"
        if (type_ann != "Any" and type_ann.length() > 0) {
            this.check_leak(subject, "its declared type", type_ann)
            return nil
        }
        // No annotation: look for a constructor call in the initializer.
        var ctor: String = this.constructor_call_name(initializer)
        if (ctor.length() > 0 and this.is_private_type(ctor)) {
            this.error(subject + " exposes private type '" + ctor
                + "' in its inferred type (from initializer '" + ctor + "()')")
            return nil
        }
        if (ctor.length() > 0) { return nil }
        var inferred: String = this.type_to_str(this.infer_type_readonly(initializer))
        var leaked: String = this.private_type_in(inferred)
        if (leaked.length() > 0) {
            this.warn(subject + " may expose private type '" + leaked
                + "' in its inferred type '" + inferred
                + "'; add an explicit annotation to say which you mean")
        }
    }

    /// The class name a constructor call names, or "" if the expression is not
    /// syntactically one. Both spellings: `Slot()` and `Mod.Slot()`.
    fun constructor_call_name(expr: AST.Expr): String {
        var name: String = match (expr) {
            Call(callee, args) => match (callee) {
                Variable(n) => n
                Ref(rk, rn, rs) => rn
                MemberAccess(o, f) => f
                _ => ""
            }
            // `Mod.Slot()` parses as a MethodCall with the module alias as the
            // receiver, not as a Call — the same asymmetry that made `private init`
            // enforceable only through bare references until it was covered in both
            // places.
            MethodCall(obj, method, args) => method
            _ => ""
        }
        if (name.length() == 0) { return "" }
        if (!this.env.class_fields.has(this.qualified_class_key(name))) { return "" }
        return name
    }

    /// The initializer's type WITHOUT the side effects infer_type has.
    ///
    /// infer_type marks variables used, defines scope entries, and emits its own
    /// diagnostics. The leak pass runs after registration but before/independently
    /// of the body walk, so calling it here would double every diagnostic the
    /// initializer produces and corrupt the unused-variable bookkeeping. Only the
    /// shapes that can name a type without evaluating anything are answered; the
    /// rest are Any, which the caller reads as "nothing to say".
    fun infer_type_readonly(expr: AST.Expr): AST.Type {
        return match (expr) {
            ListLit(elements) => {
                if (elements.length() == 0) {
                    AST.Type.GenericType("List", [AST.Type.AnyType])
                } else {
                    AST.Type.GenericType("List", [this.infer_type_readonly(elements[0])])
                }
            }
            Call(callee, args) => {
                var cname: String = match (callee) {
                    Variable(n) => n
                    Ref(rk, rn, rs) => rn
                    MemberAccess(o, f) => f
                    _ => ""
                }
                if (cname.length() == 0) {
                    AST.Type.AnyType
                } else {
                    this.parse_type_node(this.env.get_func_ret(cname))
                }
            }
            _ => AST.Type.AnyType
        }
    }

    // --- Class-member visibility (Phase 4 of docs/design/access-modifiers.md) ---

    /// Record every restricted (`private` or `protected`) field and method of a
    /// class, and reject the one combination that cannot mean anything.
    fun register_member_visibility(name: String, fields: List<AST.Param>, methods: List<AST.Stmt>) {
        var qualified: String = this.current_prefix + name
        var fi: Float = 0
        while (fi < fields.length()) {
            var f_name: String = match (fields[fi]) { Param(pn, pt, pd, p_vis) => pn }
            var f_vis: String = match (fields[fi]) { Param(pn, pt, pd, p_vis) => p_vis }
            if (this.is_restricting_visibility(f_vis)) {
                this.mark_restricted_member(name, qualified, f_name, f_vis)
            }
            fi = fi + 1
        }
        var mi: Float = 0
        while (mi < methods.length()) {
            var m_name: String = match (methods[mi]) {
                FunDecl(mn, mp, mr, mb, md, m_vis) => mn
                _ => ""
            }
            var m_vis: String = match (methods[mi]) {
                FunDecl(mn, mp, mr, mb, md, mv) => mv
                _ => "public"
            }
            var m_body: List<AST.Stmt> = match (methods[mi]) {
                FunDecl(mn, mp, mr, mb, md, mv) => mb
                _ => []
            }
            if (m_name.length() > 0 and this.is_restricting_visibility(m_vis)) {
                // A restricted *abstract* method is a contradiction, not a
                // restriction. The distinction is the one class_abstract_methods
                // already draws: bodyless means "a requirement on subclasses".
                // An implementor in another module must be able to name the
                // method to implement it, and check_conformance would then demand
                // an implementation that implementor is forbidden to write — so
                // the declaration makes the type unimplementable. A restricted
                // *default* method (one with a body) is a perfectly good helper
                // and is allowed.
                //
                // This holds for `protected` as well as `private`, and for a
                // narrower reason worth stating: `protected` *does* reach
                // subclasses, so a protected abstract method looks implementable.
                // It is not — the modifier restricts who may CALL the name, and
                // an interface's abstract method exists to be called by code
                // holding the interface type, which by construction is not a
                // subclass. Kotlin agrees: an abstract member cannot be private,
                // and a protected abstract member is legal only on a class, not
                // as an interface requirement. Saffron has one declaration form
                // for both, so the bodyless test is the available discriminator.
                if (m_body.length() == 0) {
                    this.error("'" + name + "." + m_name + "' is declared " + m_vis + " and has no body; a " + m_vis + " abstract method cannot be implemented")
                }
                this.mark_restricted_member(name, qualified, m_name, m_vis)
            }
            mi = mi + 1
        }
    }

    /// Does this visibility restrict member access at all? The two that do are
    /// `private` and `protected`; `public` and `internal` do not.
    ///
    /// `internal` is deliberately NOT a member restriction. On a member it means
    /// package scope, and package scope for members is not part of Kotlin parity
    /// as scoped here (§6a covers `internal` at the top level only) — so treating
    /// it as restricting would enforce a rule this design never specified. It
    /// parses and is recorded at the top level; on a member it is accepted and
    /// means public, which is the same reading Phase 4 gave it.
    fun is_restricting_visibility(vis: String): Bool {
        return vis == "private" or vis == "protected"
    }

    /// Write one restricted-member entry under both the bare and qualified keys.
    fun mark_restricted_member(bare: String, qualified: String, member: String, vis: String) {
        this.member_visibility.set(bare + "#" + member, vis)
        this.member_visibility.set(qualified + "#" + member, vis)
        this.restricted_member_names.set(member, true)
    }

    /// The restriction on `member` as declared directly on the class `class_name`
    /// names — "private", "protected", or "" when it is unrestricted there.
    fun member_restriction(class_name: String, member: String): String {
        var key: String = this.qualified_class_key(class_name) + "#" + member
        if (this.member_visibility.has(key)) { return this.member_visibility.get(key) }
        // The bare key as a fallback, for a receiver type that resolved to a
        // class the current module did not declare and did not import under a
        // prefix the lookup above could reconstruct.
        var bare_key: String = this.generic_base(class_name) + "#" + member
        if (this.member_visibility.has(bare_key)) { return this.member_visibility.get(bare_key) }
        return ""
    }

    /// Is `member` restricted at all as declared directly on `class_name`?
    fun is_private_member(class_name: String, member: String): Bool {
        return this.member_restriction(class_name, member).length() > 0
    }

    /// Does `class_name` DECLARE `member` in its own body — field or method?
    ///
    /// Own-only, which is what makes it usable as the stopping condition for the
    /// ancestry walk below. Both tables it reads are populated from a ClassDecl's
    /// own `fields`/`methods` lists and never from an ancestor's, so a subclass
    /// that merely inherits a name answers false here. (Codegen prepends parent
    /// fields for layout; the checker's tables do not, and this depends on that.)
    ///
    /// Tries the qualified key before the bare one, the same order and for the
    /// same reason as member_restriction: two modules may declare a same-named
    /// class, and the qualified key is the one that says which.
    fun class_declares_member(class_name: String, member: String): Bool {
        var qualified: String = this.qualified_class_key(class_name)
        if (this.env.class_fields.has(qualified) or this.class_method_names.has(qualified)) {
            if (this.list_has_string(this.get_receiver_fields(qualified), member)) { return true }
            if (this.list_has_string(this.get_receiver_methods(qualified), member)) { return true }
        }
        var bare: String = this.generic_base(class_name)
        if (this.list_has_string(this.get_receiver_fields(bare), member)) { return true }
        if (this.list_has_string(this.get_receiver_methods(bare), member)) { return true }
        return false
    }

    /// Which class in `class_name`'s ancestry restricts `member`, or "".
    ///
    /// The ancestry has to be searched, not just the receiver's own class: a
    /// member is inherited by name, so `this.secret` inside a subclass of the
    /// class that declared `secret` private reads a private member without ever
    /// naming the declaring class. Kotlin rejects exactly that — its `private`
    /// does not extend to subclasses, and `protected` is the modifier that does.
    /// Both are found by this one walk; the difference between them is decided by
    /// the CALLER, from the restriction this returns alongside the owner, not by
    /// searching differently. Checking only the receiver's own class would let any
    /// `class Child extends Base {}` launder every private field Base has.
    ///
    /// The walk stops at the class the DISPATCH would pick — the first ancestor
    /// that declares `member` at all — and then reports whether *that* class
    /// restricts it. It does not hunt for a restricting ancestor. That
    /// distinction is the whole of §11 decision 2 and it is measurable, not
    /// theoretical: given
    ///
    ///     interface A { protected fun tag(): Int { return 1 } }
    ///     interface B { fun tag(): Int { return 2 } }
    ///     class C extends Holder, B, A { }
    ///
    /// `C().tag()` runs B's body and returns 2 — B is the earlier base, and
    /// codegen resolves in declaration order. A "find any restricting ancestor"
    /// search refused the call anyway, citing `A.tag`: a diagnostic about a
    /// modifier on a declaration whose body never executes, and one that could
    /// not be silenced by any edit at the call site. Worse, it made `protected`
    /// on a widely-inherited interface a breaking change for every existing
    /// multiple-inheritance user — precisely the outcome §11 decision 2 rejects
    /// erroring-at-the-collision for.
    ///
    /// So visibility and dispatch must answer from the same class, and dispatch
    /// is not negotiable — it is what actually runs. Codegen resolves
    /// **depth-first pre-order in declaration order** (verified: with `A extends
    /// A2` supplying a body, `extends Holder, A, B` runs A2's, not B's), so this
    /// walk is depth-first pre-order in declaration order too, and both halves of
    /// each answer come from one place rather than being re-derived (M1).
    ///
    /// Returns "" when no ancestor declares the member, which is also the answer
    /// for an unrestricted one — the caller cannot distinguish them and does not
    /// need to, since both mean "nothing here refuses".
    ///
    /// The visited set makes a diamond visit a shared ancestor once and a cyclic
    /// `extends` terminate rather than hanging the checker.
    fun private_declaring_class(class_name: String, member: String): String {
        var base: String = this.generic_base(class_name)
        var owner: String = this.dispatch_declaring_class(base, member)
        if (owner.length() == 0) { return "" }
        if (this.is_private_member(owner, member)) { return owner }
        return ""
    }

    /// The class whose declaration of `member` wins, searched the way codegen
    /// resolves it: depth-first pre-order over `class_parents` in declaration
    /// order. Recursion carries the pre-order for free; an explicit stack would
    /// have to push the bases reversed to get the same order, which is the kind
    /// of detail that silently rots. Returns "" if no ancestor declares it.
    ///
    /// `visited` is threaded through by the caller rather than rebuilt per level,
    /// so a diamond costs one visit and a cycle terminates.
    fun dispatch_declaring_class(cls: String, member: String): String {
        var visited: List<String> = []
        return this.dispatch_declaring_class_from(cls, member, visited)
    }

    fun dispatch_declaring_class_from(cls: String, member: String, visited: List<String>): String {
        if (this.list_has_string(visited, cls)) { return "" }
        visited.push(cls)
        if (this.class_declares_member(cls, member)) { return cls }
        if (!this.class_parents.has(cls)) { return "" }
        var parents: List<String> = this.class_parents.get(cls)
        var i: Float = 0
        while (i < parents.length()) {
            var found: String = this.dispatch_declaring_class_from(parents[i], member, visited)
            if (found.length() > 0) { return found }
            i = i + 1
        }
        return ""
    }

    /// May code at the current position read or call `member` on `obj_type`?
    ///
    /// Class-private means the class BODY (Kotlin's rule for members, §6a), so
    /// the single question is whether the code being checked is inside the class
    /// that declared the member. `this.x`, a sibling instance of the same class,
    /// and one method calling another all satisfy that; a free function in the
    /// same file does not, which is the deliberate asymmetry with module-level
    /// `private`.
    ///
    /// `protected` is that same rule with one clause added: a SUBCLASS of the
    /// declaring class may also access it. That single extra clause is the whole
    /// of Phase 5b's semantics, which is why it lives here rather than in a
    /// second checking function — the ancestry walk, the unresolved-receiver
    /// fallback and the diagnostic shape are all shared, and duplicating them to
    /// vary one comparison is how the two would drift apart.
    ///
    /// Which class "declared the member" is answered by private_declaring_class,
    /// which resolves it the way dispatch does rather than by hunting for a
    /// restricting ancestor — see its comment for why that difference is
    /// load-bearing under multiple inheritance.
    fun check_member_visibility(obj_type: String, member: String, what: String) {
        var base: String = this.generic_base(obj_type)
        // An unresolved receiver: allow the access and say that it was not
        // checked (§3). Neither silent answer is honest — silently allowing
        // spells unknown as "public", silently denying spells it as "private" —
        // and denying has direct precedent for how badly it goes: BUGS #56
        // records that erroring on this same fallback "broke pass/math and
        // test_reflect". A missed denial is a missed lint; a false denial rejects
        // correct programs.
        //
        // Gated on the member name being private *somewhere*, because `Any`-typed
        // receivers are pervasive and honest: warning on every member access
        // through one would bury the signal in noise and teach readers to ignore
        // the category.
        if (base.length() == 0 or base == "Any" or !this.env.class_fields.has(this.qualified_class_key(base))) {
            if (this.restricted_member_names.has(member)) {
                this.warn("cannot determine the class of the receiver; visibility of '" + member + "' not checked")
            }
            return nil
        }
        var owner: String = this.private_declaring_class(base, member)
        if (owner.length() == 0) { return nil }
        // Inside the declaring class body — the whole extent of class-private, and
        // the first clause of protected.
        if (this.current_class.length() > 0
            and this.generic_base(this.current_class) == owner) { return nil }
        var restriction: String = this.member_restriction(owner, member)
        // Protected's extra clause: a subclass of the declaring class. Asked via
        // inherits_from, which since Phase 3b searches the whole inheritance DAG,
        // so a member protected on a SECOND or third base is answerable — the case
        // that made protected unimplementable before that widening (§5b). The
        // question is about the class the code sits in, not the receiver's type: a
        // subclass method may touch a protected member on any instance of the
        // declaring class, which is Kotlin's rule and the one that makes the
        // modifier useful for template-method shapes.
        if (restriction == "protected"
            and this.current_class.length() > 0
            and this.inherits_from(this.generic_base(this.current_class), owner)) { return nil }
        var where: String = " from outside the class"
        if (this.current_class.length() > 0) {
            where = " from class '" + this.current_class + "'"
        }
        // Name the modifier that actually refused, so the reader can tell a
        // subclass-reachable member from one that is not.
        this.error(restriction + " " + what + " '" + owner + "." + member + "' is not accessible" + where)
    }

    /// Which class declares the `init` that constructing `class_name` will
    /// actually run, or "" if none does.
    ///
    /// Deliberately NOT private_declaring_class's breadth-first search over every
    /// base. Only `parents[0]` forwards its `init` (the field-layout invariant in
    /// ast.sf's ClassDecl note), and a class that declares its own `init` runs
    /// that one and never reaches a base's. A DAG-wide search would reject
    /// `Child()` whenever *any* ancestor had a private constructor, even with
    /// Child declaring a perfectly public one of its own — a false denial, which
    /// is the failure mode BUGS #56 warns about.
    ///
    /// Depth-capped rather than visited-set-guarded because the walk is a single
    /// chain, not a fan-out: a cyclic `extends` terminates instead of hanging.
    fun constructor_owner(class_name: String): String {
        var base: String = this.generic_base(class_name)
        var depth: Float = 0
        while (depth < 32) {
            if (this.get_receiver_methods(base).contains("init")) { return base }
            if (!this.class_parents.has(base)) { return "" }
            var bases: List<String> = this.class_parents.get(base)
            if (bases.length() == 0) { return "" }
            base = this.generic_base(bases[0])
            depth = depth + 1
        }
        return ""
    }

    /// May code at the current position construct `class_name`?
    ///
    /// `private init` is MODULE-scoped, not class-scoped, and that is §6a's rule
    /// rather than an inconsistency with fields and methods. The whole point of
    /// the modifier is the factory pattern — `private init` plus a public
    /// same-module `fun new()` — which the stdlib already has the shape for in
    /// six modules (stack.sf, queue.sf, sorted_set.sf, heap.sf, deque.sf,
    /// sorted_map.sf). A class-scoped reading would reject exactly the free
    /// function the feature exists to enable, leaving the class constructible by
    /// nobody at all.
    ///
    /// Locality is read from local_classes — the recorded answer to "did the
    /// statement list under check declare this?" — and not re-derived from the
    /// key shape, which cannot answer it: the module under check is unprefixed,
    /// so its qualified and bare keys are the same string (Phase 2's finding).
    /// Phase 5 should prefer `Ref.slot`, which carries the defining module's
    /// prefix at the use site and so can also police a construction inside an
    /// imported module's own body; this pass only ever checks the main program's
    /// bodies, so the two agree here.
    ///
    /// A `protected init` is this rule plus subclasses, keeping the two modifiers
    /// MONOTONE: everything `private` permits, `protected` permits too. Kotlin's
    /// `protected` is not a superset of its `private` on the file axis, but that
    /// axis is where this constructor rule already departs from Kotlin on purpose
    /// (module-scoped, for the factory pattern), and making `protected` the
    /// narrower of the two there would be a trap — an author widening `private
    /// init` to `protected init` to reach subclasses would silently lose the
    /// same-module factory that was the reason to restrict the constructor at all.
    fun check_constructor_visibility(class_name: String) {
        var owner: String = this.constructor_owner(class_name)
        if (owner.length() == 0) { return nil }
        var restriction: String = this.member_restriction(owner, "init")
        if (restriction.length() == 0) { return nil }
        // Declared by the module being checked: same module, so allowed —
        // including from a free function, which is the factory.
        if (this.local_classes.contains(owner)) { return nil }
        // Inside the class body itself, whichever module that body is in.
        if (this.current_class.length() > 0
            and this.generic_base(this.current_class) == owner) { return nil }
        // Protected's extra clause, as in check_member_visibility: a subclass may
        // construct. This is what lets a subclass in another module exist at all
        // when its base restricts construction — `parents[0]`'s init is the one
        // forwarded, so without it the subclass could not be built by anyone.
        if (restriction == "protected"
            and this.current_class.length() > 0
            and this.inherits_from(this.generic_base(this.current_class), owner)) { return nil }
        this.error(restriction + " constructor '" + owner + ".init' is not accessible outside the module that declares '" + owner + "'")
    }

    /// The assignment-target half of check_member_visibility: `obj.field = v`.
    ///
    /// Reads and writes are separate paths in this checker — a read is a
    /// MemberAccess routed through infer_member_access, a write is a SetField
    /// whose arm in infer_type inferred only the right-hand side. So enforcing
    /// the read path alone left `private` meaning "you may not observe this
    /// field, but you may change it", which is a worse answer than no
    /// enforcement: the natural way to test the feature is to read the field, so
    /// it looks enforced. `s.count = s.count + 1` WAS rejected, but only because
    /// the right-hand side contains a read, which is why the hole hid.
    ///
    /// `what` is spelled "field" here rather than shared with the read path
    /// because a write is the only thing that can reach it: SetField's field is
    /// never a method.
    fun check_setfield_visibility(obj: AST.Expr, field: String) {
        // `this.x = v` inside the class is the ordinary case and must not warn or
        // error. It routes through the same owner comparison as a read, so it is
        // not special-cased — current_class matches the declaring class.
        var obj_type: String = this.infer_expr(obj)
        this.check_member_visibility(obj_type, field, "field")
    }

    fun check_spawn_captures(expr: AST.Expr) {
        var spawn_method: String = match (expr) {
            MethodCall(obj, method, args) => method
            _ => ""
        }
        if (spawn_method == "spawn") {
            var spawn_args = match (expr) {
                MethodCall(obj, method, args) => args
                _ => []
            }
            if (spawn_args.length() > 0) {
                this.check_lambda_sendable(spawn_args[0])
            }
        }
    }

    fun check_lambda_sendable(arg: AST.Expr) {
        // Conservative check: look at all tracked variables in scope.
        // The checker's register_decl pass tracks top-level vars in class_fields/funcs,
        // but not in scopes. This is a known limitation — full capture analysis
        // requires the codegen's free-variable pass which runs later.
        // For now, actor method param checks (above) cover the primary use case.
    }

    // --- Statement checking ---

    fun check_stmt(stmt: AST.Stmt) {
        match (stmt) {
            VarDecl(name, type_ann, init, doc, v_vis) => {
                this.check_spawn_captures(init)
                var init_type_node: AST.Type = this.infer_type(init)
                var init_type: String = this.type_to_str(init_type_node)
                // type_ann is a raw String on the AST (ast.sf VarDecl.type_ann),
                // NOT an AST.Type node. Passing it straight to the node-typed
                // helpers (type_node_to_string / is_nullable_type / define_var)
                // made every match arm miss and fall through to the first one —
                // so every declared variable's stored type collapsed to Int, and
                // `match (d)` on an enum variable saw Int, missed enum_variants,
                // and silently skipped the exhaustiveness check. Parse it first.
                var type_ann_str: String = type_ann
                var type_ann_node: AST.Type = this.parse_type_node(type_ann)
                if (type_ann_str != "Any") {
                    // Explicit type annotation: only error on direct nil assignment.
                    // Other nullable expressions (e.g. Map.get()) are treated as
                    // non-null assertions by the programmer's explicit annotation.
                    //
                    // A type alias (`type Name = T`) desugars to a VarDecl with a
                    // synthetic NilLit initializer and doc "@type_alias"; that nil is
                    // an implementation artifact, not a real assignment, so skip it.
                    if (doc != "@type_alias" and !this.is_nullable_type(type_ann_node) and this.is_nil_init(init)) {
                        this.error(name + ": cannot assign nil to non-nullable " + type_ann_str)
                    }
                    // Provable-scalar-mismatch check. The old code stored the
                    // annotation and never looked at the initializer's type, so
                    // `var s: String = 1` type-checked. We only flag pairs we can
                    // prove wrong: two distinct concrete scalars, with Int->Float
                    // widening and anything touching Any/Nil deliberately allowed.
                    // Generics and class types are left alone here because the
                    // inferrer widens list/map literals to `<Any>` (so a strict
                    // subtype test would reject `var xs: List<Int> = [1,2,3]`);
                    // tightening those is a separate, measured step.
                    if (doc != "@type_alias" and this.scalar_mismatch(type_ann_str, init_type)) {
                        this.error(name + ": cannot assign " + init_type + " to " + type_ann_str)
                    }
                    this.env.define_var(name, type_ann_node)
                } else if (init_type != "Any") {
                    // Inferred from initializer
                    this.env.define_var(name, init_type_node)
                } else {
                    // Cannot infer type — warning (not blocking)
                    this.warn(name + ": cannot infer type, add explicit annotation")
                    this.env.define_var(name, AST.Type.AnyType)
                }
            }
            FunDecl(name, params, ret_type, body, doc, f_vis) => {
                // Register method with class prefix if inside a class
                var ret_type_str: String = ret_type
                if (this.current_class.length() > 0) {
                    this.env.define_func_str(this.current_class + "__" + name, ret_type_str)
                    this.env.define_func_params(this.current_class + "__" + name, this.params_list_to_string(params))
                    // Register generic type params for class methods
                    this.extract_and_register_generics(this.current_class + "__" + name, doc)
                    // Track method names for conformance checking
                    var existing: String = ""
                    if (this.class_method_names.has(this.current_class)) {
                        existing = this.class_method_names.get(this.current_class)
                    }
                    if (existing.length() > 0) {
                        existing = existing + "," + name
                    } else {
                        existing = name
                    }
                    this.class_method_names.set(this.current_class, existing)
                }
                var old_ret: AST.Type = this.current_func_ret
                // ret_type is a String; current_func_ret is an AST.Type node, and
                // the Return arm feeds it to is_any_type/is_nullable_type. Parse it
                // so those checks see a real node instead of falling through to the
                // first match arm.
                this.current_func_ret = this.parse_type_node(ret_type)
                this.env.push_scope()
                var j: Float = 0
                while (j < params.length()) {
                    var p: AST.Param = params[j]
                    var pname: String = match (p) { Param(n, t, d, p_vis) => n }
                    var pt: AST.Type = match (p) { Param(n, t, d, p_vis) => t }
                    this.env.define_var(pname, pt)
                    j = j + 1
                }
                this.check_stmts(body)
                this.check_unused_in_scope()
                this.env.pop_scope()
                this.current_func_ret = old_ret
            }
            Return(value) => {
                var val_type_node: AST.Type = this.infer_type(value)
                if (!this.is_any_type(this.current_func_ret)) {
                    if (!this.is_nullable_type(this.current_func_ret) and this.is_nullable_type(val_type_node)) {
                        var val_str: String = this.type_to_str(val_type_node)
                        var ret_str: String = this.type_to_str(this.current_func_ret)
                        this.error("return: cannot return nullable " + val_str + " from function expecting " + ret_str)
                    }
                }
            }
            If(cond, then_branch, else_branch) => {
                this.infer_expr(cond)
                // Then-branch: apply narrowing from condition
                this.env.push_scope()
                this.apply_narrowing(cond)
                this.check_stmts(then_branch)
                this.check_unused_in_scope()
                this.env.pop_scope()
                // Else-branch: apply inverse narrowing
                this.env.push_scope()
                this.apply_inverse_narrowing(cond)
                this.check_stmts(else_branch)
                this.check_unused_in_scope()
                this.env.pop_scope()
            }
            While(cond, body) => {
                this.infer_expr(cond)
                this.env.push_scope()
                this.check_stmts(body)
                this.check_unused_in_scope()
                this.env.pop_scope()
            }
            ExprStmt(expr) => {
                this.infer_expr(expr)
            }
            Block(stmts) => {
                this.env.push_scope()
                this.check_stmts(stmts)
                this.check_unused_in_scope()
                this.env.pop_scope()
            }
            ClassDecl(name, __tps, parents, fields, methods, doc, c_vis) => {
                // Unlike register_decl this runs only over the statements being
                // checked, never over the imported list, so the class here is
                // the one whose body is about to be walked. Setting the bare key
                // unconditionally is therefore deliberate rather than a
                // collision: it makes `this.field` inside these methods resolve
                // to THIS declaration even when another module also declares the
                // name. The qualified entry is recorded too, so the identity
                // table stays complete for later phases.
                var cs_fields_str: String = this.params_list_to_string(fields)
                this.env.class_fields.set(this.current_prefix + name, cs_fields_str)
                this.decl_module_file.set(this.current_prefix + name, this.current_prefix)
                this.env.class_fields.set(name, cs_fields_str)
                if (!this.local_classes.contains(name)) {
                    this.local_classes.push(name)
                }
                if (parents.length() > 0) {
                    // Only parents[0] contributes fields, so it alone defines
                    // __parent; class_parents keeps the whole list for the
                    // inheritance-DAG search.
                    this.env.define_var(name + "__parent", this.parse_type_node(parents[0]))
                    this.class_parents.set(name, parents)
                }
                // Walk the method bodies. This arm used to stop at the fields, so
                // no statement inside any method was checked at all — not
                // nullability, not scalar mismatches, not return types, not
                // exhaustiveness (BUGS #76). ~97% of the compiler's own bodies are
                // methods, so "the checker reports nothing" meant "no checks ran".
                //
                // The FunDecl arm already handles a method correctly once
                // current_class is set, and `this.field` resolves through
                // class_fields rather than lexical scope, so no extra scope is
                // needed here.
                var saved_class: String = this.current_class
                this.current_class = name
                this.check_stmts(methods)
                this.current_class = saved_class
            }
            EnumDecl(n, v, d, e_vis) => {}
            Break => {}
            Continue => {}
            TryCatch(try_body, catch_name, catch_body, finally_body) => {
                this.env.push_scope()
                this.check_stmts(try_body)
                this.check_unused_in_scope()
                this.env.pop_scope()
                this.env.push_scope()
                this.env.define_var(catch_name, AST.Type.StringType)
                this.check_stmts(catch_body)
                this.check_unused_in_scope()
                this.env.pop_scope()
                this.env.push_scope()
                this.check_stmts(finally_body)
                this.check_unused_in_scope()
                this.env.pop_scope()
            }
            Throw(value) => {
                this.infer_expr(value)
            }
            LetPattern(pattern, value) => {
                this.infer_expr(value)
            }
            TypeAlias(ta_n, ta_t, ta_vis) => {}
        }
    }

    fun check_stmts(stmts: List<AST.Stmt>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.check_stmt(stmts[i])
            i = i + 1
        }
    }

    fun apply_narrowing(cond: AST.Expr) {
        // Single-match approach: extract all narrowing info in one pass
        // to avoid re-matching the same expression (causes native segfault).
        match (cond) {
            MethodCall(o, m, a) => {
                // map.has() guard
                if (m == "has") {
                    this.env.narrow("__has_guard", AST.Type.ClassType("active"))
                }
            }
            Binary(l, op, r) => {
                if (op == "!=") {
                    // x != nil → narrow x to non-nullable
                    var var_name: String = this.nil_check_var_from_binary(l, r)
                    if (var_name.length() > 0) {
                        var var_type_node: AST.Type = this.env.get_var_type(var_name)
                        if (this.is_nullable_type(var_type_node)) {
                            this.env.narrow(var_name, this.strip_nil_from_node(var_type_node))
                        }
                    }
                }
                if (op == "==") {
                    // x == nil → narrow x to Nil in then-branch
                    var var_name: String = this.nil_check_var_from_binary(l, r)
                    if (var_name.length() > 0) {
                        var var_type_node: AST.Type = this.env.get_var_type(var_name)
                        if (this.is_nullable_type(var_type_node)) {
                            this.env.narrow(var_name, AST.Type.NilType)
                        }
                    }
                }
            }
            Variable(n) => {
                // Truthy check: if (x) { ... } → x is non-nullable
                var var_type_node: AST.Type = this.env.get_var_type(n)
                if (this.is_nullable_type(var_type_node)) {
                    this.env.narrow(n, this.strip_nil_from_node(var_type_node))
                }
            }
            Ref(rk, rn, rs) => {
                var ref_type_node: AST.Type = this.env.get_var_type(rn)
                if (this.is_nullable_type(ref_type_node)) {
                    this.env.narrow(rn, this.strip_nil_from_node(ref_type_node))
                }
            }
            IsCheck(val, typ) => {
                // if (x is Type) → narrow x to Type
                var is_var: String = this.get_variable_name_from_expr(val)
                if (is_var.length() > 0) {
                    this.env.narrow(is_var, this.parse_type_node(typ))
                }
            }
            Logical(l, op, r) => {
                // if (a and b) → apply narrowing from both sides
                if (op == "and") {
                    this.apply_narrowing(l)
                    this.apply_narrowing(r)
                }
            }
            _ => {}
        }
    }

    fun apply_inverse_narrowing(cond: AST.Expr) {
        // Single-match approach for else-branch narrowing
        match (cond) {
            Binary(l, op, r) => {
                if (op == "!=") {
                    // Inverse of x != nil: in else branch, x is Nil
                    var var_name: String = this.nil_check_var_from_binary(l, r)
                    if (var_name.length() > 0) {
                        var var_type_node: AST.Type = this.env.get_var_type(var_name)
                        if (this.is_nullable_type(var_type_node)) {
                            this.env.narrow(var_name, AST.Type.NilType)
                        }
                    }
                }
                if (op == "==") {
                    // Inverse of x == nil: in else branch, x is non-nullable
                    var var_name: String = this.nil_check_var_from_binary(l, r)
                    if (var_name.length() > 0) {
                        var var_type_node: AST.Type = this.env.get_var_type(var_name)
                        if (this.is_nullable_type(var_type_node)) {
                            this.env.narrow(var_name, this.strip_nil_from_node(var_type_node))
                        }
                    }
                }
            }
            Logical(l, op, r) => {
                // Inverse of (a or b): not(a or b) = not a and not b
                if (op == "or") {
                    this.apply_inverse_narrowing(l)
                    this.apply_inverse_narrowing(r)
                }
            }
            _ => {}
        }
    }

    fun nil_check_var_from_binary(left: AST.Expr, right: AST.Expr): String {
        // Given left and right sides of a binary ==|!= expression,
        // return the variable name if one side is a Variable and the other is NilLit.
        var left_name: String = this.extract_var_from_nil_check(left, right)
        if (left_name.length() > 0) return left_name
        return this.extract_var_from_nil_check(right, left)
    }

    fun get_eq_nil_var_name(expr: AST.Expr): String {
        // For Binary(left, "==", right), extract variable name if one side is NilLit
        var ek: String = this.classify_cond(expr)
        if (ek != "binary") return ""
        var left_expr: AST.Expr = this.get_binary_left(expr)
        var right_expr: AST.Expr = this.get_binary_right(expr)
        var left_name: String = this.extract_var_from_nil_check(left_expr, right_expr)
        if (left_name.length() > 0) return left_name
        return this.extract_var_from_nil_check(right_expr, left_expr)
    }

    fun extract_is_check_var(cond: AST.Expr): String {
        // Get the value expression from IsCheck, then get its variable name
        var val_expr: AST.Expr = match (cond) {
            IsCheck(val, typ) => val
            _ => AST.Expr.NilLit
        }
        return this.get_variable_name_from_expr(val_expr)
    }

    fun get_variable_name_from_expr(expr: AST.Expr): String {
        return match (expr) {
            Variable(n) => n
            Ref(rk, rn, rs) => rn
            _ => ""
        }
    }

    fun get_expr_var_name(expr: AST.Expr): String {
        // For Binary(left, "!=", right), extract variable name if one side is NilLit
        var ek: String = this.classify_cond(expr)
        if (ek != "binary") return ""
        var left_expr: AST.Expr = this.get_binary_left(expr)
        var right_expr: AST.Expr = this.get_binary_right(expr)
        var left_name: String = this.extract_var_from_nil_check(left_expr, right_expr)
        if (left_name.length() > 0) return left_name
        return this.extract_var_from_nil_check(right_expr, left_expr)
    }

    fun classify_cond(expr: AST.Expr): String {
        return match (expr) {
            Binary(l, o, r) => "binary"
            _ => "other"
        }
    }

    fun get_binary_left(expr: AST.Expr): AST.Expr {
        return match (expr) {
            Binary(l, o, r) => l
            _ => AST.Expr.NilLit
        }
    }

    fun get_binary_right(expr: AST.Expr): AST.Expr {
        return match (expr) {
            Binary(l, o, r) => r
            _ => AST.Expr.NilLit
        }
    }

    fun extract_var_from_nil_check(var_side: AST.Expr, nil_side: AST.Expr): String {
        // Returns variable name if var_side is Variable and nil_side is NilLit
        var is_nil: Bool = this.is_nil_literal(nil_side)
        if (!is_nil) return ""
        return this.get_variable_name_from_expr(var_side)
    }

    fun is_nil_literal(expr: AST.Expr): Bool {
        return match (expr) {
            NilLit => true
            _ => false
        }
    }

    fun is_logical_and(expr: AST.Expr): Bool {
        return match (expr) {
            Logical(l, op, r) => op == "and"
            _ => false
        }
    }

    fun get_logical_left(expr: AST.Expr): AST.Expr {
        return match (expr) {
            Logical(l, op, r) => l
            _ => AST.Expr.NilLit
        }
    }

    fun get_logical_right(expr: AST.Expr): AST.Expr {
        return match (expr) {
            Logical(l, op, r) => r
            _ => AST.Expr.NilLit
        }
    }


    // --- Expression type inference ---

    // Returns the type as AST.Type node — the authoritative type inference
    fun infer_type(expr: AST.Expr): AST.Type {
        return match (expr) {
            IntLit(v) => AST.Type.IntType
            FloatLit(v) => AST.Type.FloatType
            BoolLit(v) => AST.Type.BoolType
            StringLit(s) => AST.Type.StringType
            NilLit => AST.Type.NilType
            Variable(name) => {
                this.env.mark_used(name)
                this.env.get_var_type(name)
            }
            Ref(rkind, rname, rslot) => {
                this.env.mark_used(rname)
                // A global or func Ref carries the DEFINING module's prefix in
                // rslot (resolve.sf resolve_variable), so a bare cross-module
                // read of a module-private/internal name is decided here — §6a
                // path 3, the one most easily forgotten. A local/self/type Ref
                // has an empty slot and check_module_ref_visibility returns at
                // once. Gated on kind so only the two module-level kinds pay for
                // the lookup.
                if (rkind == "global" or rkind == "func") {
                    this.check_module_ref_visibility(rname, rslot)
                }
                this.env.get_var_type(rname)
            }
            Binary(left, op, right) => this.parse_type_node(this.infer_binary(left, op, right))
            Unary(op, right) => this.infer_type(right)
            Call(callee, args) => this.parse_type_node(this.infer_call(callee, args))
            Assign(name, value) => this.parse_type_node(this.check_assign(name, value))
            Logical(left, op, right) => AST.Type.BoolType
            MemberAccess(obj, field) => this.parse_type_node(this.infer_member_access(obj, field))
            Match(subject, arms) => this.parse_type_node(this.infer_match(subject, arms))
            EnumConstruct(e, v, a) => AST.Type.EnumType(e)
            Lambda(p, r, b) => AST.Type.FuncType([], AST.Type.AnyType)
            GetField(obj, field) => AST.Type.AnyType
            SetField(obj, field, value) => {
                // A write is an access. This arm used to infer only `value` and
                // never look at `obj` at all, so `private` stopped a field from
                // being READ while still permitting it to be MUTATED — which is
                // worse than no enforcement, because anyone who probes it with a
                // read concludes it is protected. `s.count = s.count + 1` was
                // rejected, but only incidentally, via the read on the RHS.
                this.check_setfield_visibility(obj, field)
                this.infer_type(value)
            }
            This => AST.Type.ClassType(this.current_class)
            ListLit(elements) => AST.Type.GenericType("List", [AST.Type.AnyType])
            // A tuple is a List at runtime (expr_body.sf gen_tuple), typed
            // `Tuple<T0,...>` by codegen so `._0` can find each element's type.
            // Mirror the element types here rather than collapsing to Any.
            TupleLit(elements) => {
                var tuple_elem_types: List<AST.Type> = []
                var tei: Float = 0
                while (tei < elements.length()) {
                    tuple_elem_types.push(this.infer_type(elements[tei]))
                    tei = tei + 1
                }
                AST.Type.GenericType("Tuple", tuple_elem_types)
            }
            // `yield` resumes with whatever the scheduler stores, which the
            // checker cannot see. Any is the honest answer; before this arm
            // existed the result was an indeterminate type (BUGS #76).
            Yield(value) => {
                this.infer_expr(value)
                AST.Type.AnyType
            }
            IndexGet(obj, index) => {
                var list_type: String = this.infer_expr(obj)
                this.infer_expr(index)
                // Subscript overloading: on a user class declaring `getItem`,
                // `obj[k]` has getItem's declared return type. That type may
                // itself be a class type parameter — `class Box<T>` with
                // `fun getItem(k: Int): T` — in which case the receiver's own
                // declared type supplies the answer: `Box<String>` says `T` is
                // `String`. class_method_ret_type does that substitution.
                // extract_list_element_type is right for a real List and wrong
                // here: it reads the first generic argument positionally, which
                // has nothing to do with what getItem declares (BUGS #94/#95;
                // codegen side in methods_body.sf gen_index_get).
                //
                // Read the registry directly rather than calling
                // infer_method_call, which would re-infer `obj` and `index` and
                // so double every diagnostic they produce. Class tables are
                // keyed by the bare name, hence generic_base.
                var idx_base: String = this.generic_base(list_type)
                if (this.env.class_fields.has(idx_base)
                    and this.get_receiver_methods(idx_base).contains("getItem")) {
                    this.parse_type_node(this.class_method_ret_type(list_type, "getItem"))
                } else {
                    this.parse_type_node(this.extract_list_element_type(list_type))
                }
            }
            IndexSet(obj, index, value) => this.infer_type(value)
            MethodCall(obj, method, args) => this.parse_type_node(this.infer_method_call(obj, method, args))
            MapLit => AST.Type.GenericType("Map", [AST.Type.StringType, AST.Type.AnyType])
            BlockExpr(stmts, value) => {
                this.check_stmts(stmts)
                this.infer_type(value)
            }
            IsCheck(value, type_name) => {
                this.infer_expr(value)
                AST.Type.BoolType
            }
            IfExpr(cond, then_body, then_val, else_body, else_val) => {
                this.infer_expr(cond)
                this.check_stmts(then_body)
                var then_type: AST.Type = this.infer_type(then_val)
                this.check_stmts(else_body)
                var else_type: AST.Type = this.infer_type(else_val)
                var then_str: String = this.type_to_str(then_type)
                var else_str: String = this.type_to_str(else_type)
                if (then_str != else_str and then_str != "Any" and else_str != "Any" and then_str != "Nil" and else_str != "Nil") {
                    this.error("if-expression branches have incompatible types: " + then_str + " vs " + else_str)
                }
                then_type
            }
            TryExpr(try_body, try_val, catch_name, catch_body, catch_val) => {
                this.check_stmts(try_body)
                var try_type: AST.Type = this.infer_type(try_val)
                this.env.push_scope()
                this.env.define_var(catch_name, AST.Type.StringType)
                this.check_stmts(catch_body)
                var catch_type: AST.Type = this.infer_type(catch_val)
                this.env.pop_scope()
                var try_str: String = this.type_to_str(try_type)
                var catch_str: String = this.type_to_str(catch_type)
                if (try_str != catch_str and try_str != "Any" and catch_str != "Any" and try_str != "Nil" and catch_str != "Nil") {
                    this.error("try-expression branches have incompatible types: " + try_str + " vs " + catch_str)
                }
                // A try body that diverges (throws) has no value — its value slot
                // types as Nil. In that case the expression's type is whatever the
                // catch branch yields, so `var y = try { throw ... } catch { 99 }`
                // is an Int, not Nil.
                if (try_str == "Nil" and catch_str != "Nil") {
                    catch_type
                } else {
                    try_type
                }
            }
        }
    }

    // String wrapper for backward compat — delegates to infer_type
    fun infer_expr(expr: AST.Expr): String {
        var t: AST.Type = this.infer_type(expr)
        return this.type_to_str(t)
    }

    fun infer_member_access(obj: AST.Expr, field: String): String {
        var obj_type: String = this.infer_expr(obj)
        // this.field → look up field type from current class
        if (obj_type == this.current_class or obj_type == "This") {
            if (this.env.class_fields.has(this.current_class)) {
                // `this.x` is checked too, and it is not a redundant check: a
                // subclass reads an inherited member by name without ever naming
                // the class that declared it private, so `this.secret` inside
                // `class Child extends Base` is the case that needs catching.
                // Access from within the declaring class is what
                // check_member_visibility permits, so the ordinary use is
                // unaffected.
                this.check_member_visibility(this.current_class, field, "field")
                return this.get_class_field_type(this.current_class, field)
            }
        }
        // variable.field → look up from variable's class type. Keyed by the bare
        // name, with the receiver's type arguments substituted into the field's
        // declared type: `var v: T` on a `Box<String>` is a String (BUGS #95).
        var ma_base: String = this.generic_base(obj_type)
        if (this.env.class_fields.has(ma_base)) {
            // A class receiver whose type resolved: this is the one path where a
            // field's visibility can actually be decided. The `this.field` branch
            // above returns before reaching here, which is correct — reading your
            // own class's private field is exactly what private permits.
            this.check_member_visibility(obj_type, field, "field")
            return this.substitute_class_type_params(this.get_class_field_type(ma_base, field), obj_type)
        }
        // Known module members
        if (obj_type == "Any") {
            // Module-qualified access: IO.println, OS.args, etc.
            // Only a bare name can be a module or enum name. The 24 arms that
            // used to be spelled out one per variant, all returning "", are the
            // `_` arm — and being written by hand they went stale: IfExpr,
            // TryExpr, Yield and TupleLit were never added, so those four fell
            // through to an indeterminate value instead of "" (BUGS #76).
            var obj_name: String = match (obj) {
                Variable(n) => n
                Ref(rk, rn, rs) => rn
                _ => ""
            }
            // Enum variant access (Color.Red, Option.Some, etc.)
            if (obj_name.length() > 0 and this.env.enum_variants.has(obj_name)) {
                return obj_name
            }
        }
        // The fallback: no class resolved, so no visibility decision is possible.
        // check_member_visibility takes the soft-fail branch and warns only if
        // this member name is private on some class. This is also the working
        // route for `Math.PI`, which is why it must not become an error (§3).
        this.check_member_visibility(obj_type, field, "field")
        return field
    }

    fun get_class_field_type(class_name: String, field: String): String {
        // Prefer the declaration from the module being checked. Two modules can
        // declare the same class name — `Response` exists in both
        // src/lib/http/client.sf and src/lib/http/server.sf — and the bare key
        // holds only one of them.
        var lookup: String = this.qualified_class_key(class_name)
        // Ambiguous name and no local declaration to prefer: the field list on
        // file may be the other module's, so a type read from it is invented.
        // `Any` is the honest answer — it widens rather than reporting a
        // mismatch about a field the receiver does not have. Same posture as
        // get_variant_fields for an ambiguous enum.
        if (lookup == this.generic_base(class_name) and this.is_ambiguous_class(class_name)) {
            return "Any"
        }
        var fields_str: String = this.env.class_fields.get(lookup)
        if (fields_str.length() == 0) return "Any"
        var parts: List<String> = fields_str.split(",")
        var i: Float = 0
        while (i < parts.length()) {
            var kv: List<String> = parts[i].split(":")
            if (kv.length() >= 2) {
                if (kv[0] == field) return kv[1]
            }
            i = i + 1
        }
        return "Any"
    }

    fun extract_generic_args(typ: String): String {
        // "List<String>" → "String"
        // "Map<String,Number>" → "String,Number"
        // "Map<String,List<Int>>" → "String,List<Int>"
        if (!typ.contains("<")) return ""
        // Find first < and matching >
        var start: Float = 0
        var i: Float = 0
        while (i < typ.length()) {
            if (typ.char_at(i) == "<") {
                start = i + 1
                i = typ.length()
            }
            i = i + 1
        }
        // Remove trailing >
        var end: Float = typ.length() - 1
        if (end > start) {
            return typ.slice(start, end)
        }
        return ""
    }

    fun extract_nth_generic_arg(typ: String, n: Float): String {
        // Split generic args respecting nested <> depth
        var args_str: String = this.extract_generic_args(typ)
        if (args_str.length() == 0) return "Any"
        var args: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < args_str.length()) {
            var ch: String = args_str.char_at(i)
            if (ch == "<") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "," and depth == 0) {
                args.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            args.push(current)
        }
        if (n < args.length()) {
            return args[n.floor()]
        }
        return "Any"
    }

    fun extract_map_value_type(typ: String): String {
        // "Map<String,Number>" → "Number" (second arg)
        // "Map<String>" → "String" (fallback: first arg)
        // "Map" → "Any"
        if (!typ.contains("<")) return "Any"
        var second: String = this.extract_nth_generic_arg(typ, 1)
        if (second != "Any") return second
        return this.extract_nth_generic_arg(typ, 0)
    }

    fun extract_map_key_type(typ: String): String {
        // "Map<String,Number>" → "String"
        if (!typ.contains("<")) return "Any"
        return this.extract_nth_generic_arg(typ, 0)
    }

    fun extract_list_element_type(typ: String): String {
        // "List<String>" → "String"
        if (!typ.contains("<")) return "Any"
        return this.extract_nth_generic_arg(typ, 0)
    }

    // --- Class-level generic substitution (BUGS #95) ---

    // The bare name of a possibly-generic type: "Box<String>" → "Box".
    // Every class table — class_fields, class_method_names, class_type_params —
    // is keyed by the bare name, but a variable's declared type carries its
    // arguments, so a lookup with the full spelling always misses.
    fun generic_base(typ: String): String {
        if (!typ.contains("<")) return typ
        return typ.slice(0, typ.index_of("<"))
    }

    // The declared type parameter names of `class_name`, or [] if it is not
    // generic. Reads the bare name, so `Box<String>` resolves like `Box`.
    fun get_class_type_params(class_name: String): List<String> {
        var base: String = this.generic_base(class_name)
        if (!this.class_type_params.has(base)) return []
        var joined: String = this.class_type_params.get(base)
        if (joined.length() == 0) return []
        return joined.split(",")
    }

    // Substitute a class's type arguments into a type mentioning its parameters.
    //
    //   substitute_class_type_params("T", "Box<String>")        → "String"
    //   substitute_class_type_params("List<V>", "Pair<Int,Str>") → "List<Str>"
    //   substitute_class_type_params("Int", "Box<String>")      → "Int"
    //
    // The receiver's own declared type is the authority here: `Box<String>`
    // states what `T` is, so nothing needs to be guessed from the argument list.
    // A parameter the receiver leaves unbound (a bare `Box`, or a class with
    // more parameters than arguments) comes back unchanged rather than as Any:
    // an unsubstituted `T` is a signal that the annotation is incomplete, and
    // the caller decides what to do with it.
    fun substitute_class_type_params(typ: String, recv_type: String): String {
        if (typ.length() == 0) return typ
        var params: List<String> = this.get_class_type_params(recv_type)
        if (params.length() == 0) return typ
        if (!recv_type.contains("<")) return typ
        // A whole-type match is the common case: `fun unwrap(): T`.
        var pi: Float = 0
        while (pi < params.length()) {
            if (params[pi] == typ) {
                var arg: String = this.extract_nth_generic_arg(recv_type, pi)
                if (arg != "Any" and arg.length() > 0) return arg
                return typ
            }
            pi = pi + 1
        }
        // Otherwise recurse into the arguments: `fun items(): List<T>`.
        if (typ.contains("<")) {
            var lt: Float = typ.index_of("<")
            var base: String = typ.slice(0, lt)
            var inner: String = typ.slice(lt + 1, typ.length() - 1)
            var parts: List<String> = this.split_type_args(inner)
            var out: List<String> = []
            var i: Float = 0
            while (i < parts.length()) {
                out.push(this.substitute_class_type_params(parts[i], recv_type))
                i = i + 1
            }
            return base + "<" + out.join(",") + ">"
        }
        return typ
    }

    // A method's registered return type with the receiver's type arguments
    // substituted in. `full_name` is the "ClassName__method" registry key,
    // built from the bare name; `recv_type` is the receiver's declared type,
    // arguments and all.
    fun class_method_ret_type(recv_type: String, method: String): String {
        var base: String = this.generic_base(recv_type)
        var ret: String = this.env.get_func_ret(base + "__" + method)
        return this.substitute_class_type_params(ret, recv_type)
    }

    fun infer_binary(left: AST.Expr, op: String, right: AST.Expr): String {
        var lt: String = this.infer_expr(left)
        var rt: String = this.infer_expr(right)
        if (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=") {
            return "Bool"
        }
        if (op == "+") {
            if (lt == "String" or rt == "String") return "String"
        }
        if (lt == rt) return lt
        if (lt == "Any") return rt
        if (rt == "Any") return lt
        return "Int"
    }

    fun infer_unary(op: String, right: AST.Expr): String {
        if (op == "!") return "Bool"
        return this.infer_expr(right)
    }

    // Check if a type string is a type parameter (e.g., "T", "U", "V", "Element")
    // Type parameters are: single uppercase letters, or names that aren't known
    // concrete types (Int, Float, Bool, String, Nil, Any, List, Map, etc.)
    fun is_type_param(typ: String): Bool {
        if (typ.length() == 0) return false
        // Known concrete types are not type parameters
        if (typ == "Int" or typ == "Float" or typ == "Bool") return false
        if (typ == "String" or typ == "Nil" or typ == "Any") return false
        if (typ == "List" or typ == "Map" or typ == "Fun") return false
        if (typ == "StringBuilder") return false
        if (typ.contains("<")) return false
        if (typ.contains("|")) return false
        // Single uppercase letter: definitely a type param
        if (typ.length() == 1) {
            var ch: String = typ.char_at(0)
            if (ch >= "A" and ch <= "Z") return true
        }
        // Multi-char: type param if first char is uppercase and not a known class/enum
        var first: String = typ.char_at(0)
        if (first >= "A" and first <= "Z") {
            // Check if it's a known class or enum
            if (this.env.class_fields.has(typ)) return false
            if (this.env.enum_variants.has(typ)) return false
            // Check if it's registered as a function (class constructor)
            if (this.env.funcs.has(typ)) return false
            return true
        }
        return false
    }

    // Resolve a type parameter in a return type by matching declared param types
    // against actual argument types at the call site.
    // params_str format: "name:Type,name:Type"
    // Returns the resolved concrete type, or the original ret_type if unresolvable.
    fun resolve_type_params(ret_type: String, params_str: String, args: List<AST.Expr>): String {
        if (params_str.length() == 0) return ret_type
        // Split params_str into individual param entries
        var param_entries: List<String> = this.split_type_args(params_str)
        var i: Float = 0
        while (i < param_entries.length() and i < args.length()) {
            var entry: String = param_entries[i]
            // Each entry is "name:Type"
            var colon_pos: Float = entry.index_of(":")
            if (colon_pos >= 0) {
                var param_type: String = entry.slice(colon_pos + 1, entry.length())
                // Case 1: return type directly matches a param type (e.g., ret=T, param=T)
                if (param_type == ret_type) {
                    var arg_type: String = this.infer_expr(args[i])
                    if (arg_type != "Any") return arg_type
                }
                // Case 2: return type is a type param inside a generic param
                // e.g., ret=T, param=List<T> → extract T from the arg's generic type
                if (param_type.contains("<")) {
                    var inner: String = this.extract_generic_args(param_type)
                    if (inner == ret_type) {
                        // The param is like List<T> and ret is T
                        // So extract the first generic arg from the actual arg type
                        var arg_type: String = this.infer_expr(args[i])
                        var resolved: String = this.extract_generic_args(arg_type)
                        if (resolved.length() > 0 and resolved != "Any") return resolved
                    }
                    // Handle Map<K,V> style: check each generic arg
                    var param_args: List<String> = this.split_type_args(inner)
                    var pi: Float = 0
                    while (pi < param_args.length()) {
                        if (param_args[pi] == ret_type) {
                            var arg_type: String = this.infer_expr(args[i])
                            var resolved: String = this.extract_nth_generic_arg(arg_type, pi)
                            if (resolved != "Any") return resolved
                        }
                        pi = pi + 1
                    }
                }
            }
            i = i + 1
        }
        return ret_type
    }

    // Resolve type params within a generic return type (e.g., "List<T>" → "List<Int>")
    fun resolve_generic_return(ret_type: String, params_str: String, args: List<AST.Expr>): String {
        if (!ret_type.contains("<")) return ret_type
        // Extract base and args from return type
        var lt_pos: Float = ret_type.index_of("<")
        var base: String = ret_type.slice(0, lt_pos)
        var ret_args_str: String = ret_type.slice(lt_pos + 1, ret_type.length() - 1)
        var ret_args: List<String> = this.split_type_args(ret_args_str)
        var resolved_args: List<String> = []
        var ri: Float = 0
        while (ri < ret_args.length()) {
            var ra: String = ret_args[ri]
            if (this.is_type_param(ra)) {
                var resolved: String = this.resolve_type_params(ra, params_str, args)
                resolved_args.push(resolved)
            } else {
                resolved_args.push(ra)
            }
            ri = ri + 1
        }
        return base + "<" + resolved_args.join(",") + ">"
    }

    fun infer_call(callee: AST.Expr, args: List<AST.Expr>): String {
        var name: String = match (callee) {
            Variable(n) => n
            Ref(rk, rn, rs) => rn
            MemberAccess(o, f) => f
            // Anything else in callee position is an indirect call — a lambda
            // value, a field holding a function, an element of a list of
            // functions. There is no name to look up, and "" is what every
            // caller below already treats as "unknown callee".
            _ => ""
        }
        // A called bare cross-module function is a Ref in callee position and is
        // NOT routed through infer_type's Ref arm (infer_call reads the name off
        // the callee directly and never infers the callee expression), so §6a
        // path 3 for a *call* must be decided here. The slot carries the defining
        // module's prefix; a func-kind Ref with a non-empty slot is exactly a
        // cross-module call. Placed before arg inference so the diagnostic points
        // at the call, not at something inside its arguments.
        match (callee) {
            Ref(rk, rn, rs) => {
                if (rk == "func" or rk == "global") {
                    this.check_module_ref_visibility(rn, rs)
                }
            }
            _ => nil
        }
        // Desugar receiver closures: if a Lambda arg matches a receiver-typed param
        var di: Float = 0
        while (di < args.length()) {
            var recv_key: String = name + ":" + di.floor().to_string()
            var has_recv: Bool = this.receiver_params.has(recv_key)
            var is_lambda: Bool = this.is_lambda_expr(args[di])
            if (has_recv and is_lambda) {
                var recv_class: String = this.receiver_params.get(recv_key)
                this.desugar_receiver_closure(args, di, recv_class)
            } else if (is_lambda and this.fun_param_sigs.has(recv_key)) {
                // Type the lambda's own parameters from what the callee declares
                // about its callback (BUGS #86). Runs after the receiver-closure
                // branch so the two desugarings never fight over the same argument.
                this.apply_fun_param_sig(args, di, this.fun_param_sigs.get(recv_key), name)
            }
            di = di + 1
        }
        // Check args
        var ai: Float = 0
        while (ai < args.length()) {
            this.infer_expr(args[ai])
            ai = ai + 1
        }
        // A construction is a call: `Secret(42)` reaches here with name="Secret",
        // and so does `Mod.Secret(42)` (the MemberAccess arm above yields the
        // field name). register_decl registers every class as a function
        // returning its own type, so there is no separate instantiation node to
        // hang this off — which is why `private init` was ignorable until now.
        //
        // Gated on the name actually being a declared class so an ordinary call
        // never consults the visibility tables. A method call does not come
        // through here at all (infer_method_call handles those).
        if (name.length() > 0 and this.env.class_fields.has(this.qualified_class_key(name))) {
            this.check_constructor_visibility(name)
        }
        // Look up declared return type
        if (name.length() > 0) {
            // Check generic constraints if this is a generic function
            if (this.is_generic_func(name)) {
                this.check_generic_constraints(name, args)
            }
            var ret: String = this.env.get_func_ret(name)
            if (ret != "Any") {
                // If return type contains a type parameter, try to resolve it
                if (this.is_type_param(ret)) {
                    var params_str: String = this.env.get_func_params(name)
                    var resolved: String = this.resolve_type_params(ret, params_str, args)
                    if (resolved != ret) return resolved
                } else if (ret.contains("<")) {
                    // Generic return type like List<T> — resolve type params within
                    var params_str: String = this.env.get_func_params(name)
                    if (params_str.length() > 0) {
                        var resolved: String = this.resolve_generic_return(ret, params_str, args)
                        if (resolved != ret) return resolved
                    }
                }
                return ret
            }
            // Known builtins by name
            if (name == "read_file") return "String"
            if (name == "write_file") return "Nil"
            if (name == "println" or name == "print") return "Nil"
            if (name == "args") return "List<String>"
            if (name == "exec") return "String"
            if (name == "exit") return "Nil"
            if (name == "lex") return "List"
            if (name == "parse") return "List"
            if (name == "generate" or name == "generate_with_imports") return "String"
            if (name == "check" or name == "check_with_imports") return "String"
            if (name == "resolve_import_path") return "String"
            if (name == "extract_imports") return "List<String>"
        }
        return "Any"
    }

    fun check_assign(name: String, value: AST.Expr): String {
        var val_type: String = this.infer_expr(value)
        var var_type: String = this.env.get_var(name)
        if (var_type != "Any" and !this.is_nullable(var_type) and this.is_nullable(val_type)) {
            this.error(name + ": cannot assign nullable " + val_type + " to non-nullable " + var_type)
        }
        return val_type
    }

    // --- Method call inference (the key null-safety check) ---

    fun infer_method_call(obj: AST.Expr, method: String, args: List<AST.Expr>): String {
        var obj_type: String = this.infer_expr(obj)

        // `__iter_get` — the for-in desugaring's element read (BUGS #62). It is
        // not a real method on anything, so it has to be answered before the
        // per-type method tables below, which would report it as unknown.
        //
        // A Map yields List<Any>, not List<K|V>: the runtime hands back a
        // two-element [key, value] pair whose slots have different types, and a
        // union would type check and then silently take the wrong branch, since
        // `is` is broken on unions (BUGS #69).
        if (method == "__iter_get") {
            if (obj_type == "String") { return "String" }
            if (obj_type == "Map" or obj_type.starts_with("Map<")) { return "List<Any>" }
            if (obj_type.starts_with("List<")) {
                return this.extract_list_element_type(obj_type)
            }
            return "Any"
        }

        // Desugar receiver closures for method calls too
        // Check both "ClassName__method:idx" and "method:idx" patterns
        var obj_name: String = match (obj) {
            Variable(n) => n
            Ref(rk, rn, rs) => rn
            _ => ""
        }
        var mdi: Float = 0
        while (mdi < args.length()) {
            var md_key: String = method + ":" + mdi.floor().to_string()
            var md_key2: String = obj_name + "__" + method + ":" + mdi.floor().to_string()
            var md_recv: String = ""
            if (this.receiver_params.has(md_key)) {
                md_recv = this.receiver_params.get(md_key)
            } else if (this.receiver_params.has(md_key2)) {
                md_recv = this.receiver_params.get(md_key2)
            }
            if (md_recv.length() > 0 and this.is_lambda_expr(args[mdi])) {
                this.desugar_receiver_closure(args, mdi, md_recv)
            } else if (this.is_lambda_expr(args[mdi])) {
                // Type a block passed to a method from the method's own declared
                // callback type (BUGS #86). Prefer the receiver-qualified key: two
                // classes can both declare `get(path, handler)` with different
                // callback shapes, and the bare key cannot tell them apart.
                var md_sig_key: String = this.generic_base(obj_type) + "__" + method + ":" + mdi.floor().to_string()
                if (this.fun_param_sigs.has(md_sig_key)) {
                    this.apply_fun_param_sig(args, mdi, this.fun_param_sigs.get(md_sig_key), method)
                }
            }
            mdi = mdi + 1
        }

        // Check all argument expressions for null-safety too
        var ai: Float = 0
        while (ai < args.length()) {
            this.infer_expr(args[ai])
            ai = ai + 1
        }

        // Enum variant construction: Shape.Circle(5) → type is "Shape"
        if (obj_type == "Any") {
            var obj_name: String = match (obj) {
                Variable(n) => n
                Ref(rk, rn, rs) => rn
                _ => ""
            }
            if (obj_name.length() > 0 and this.env.enum_variants.has(obj_name)) {
                return obj_name
            }
            // Alias-qualified construction: `Mod.Gauge(42)`. This is the SECOND
            // spelling of a construction and it does not reach infer_call at all
            // — the parser builds a MethodCall here, with the module alias as the
            // receiver, so the bare `Gauge(42)` check in infer_call never sees
            // it. Missing this arm is what made `private init` enforceable only
            // through the importing file's own bare references, i.e. not at all
            // across the boundary it exists to police.
            //
            // Sits in the `obj_type == "Any"` branch beside the enum-variant
            // lookup because a module alias is exactly that: a receiver the
            // checker has no type for. Gated on the method name being a declared
            // class, so an ordinary method call on an Any-typed receiver never
            // consults the visibility tables.
            if (this.env.class_fields.has(this.qualified_class_key(method))) {
                this.check_constructor_visibility(method)
            }
            // §6a path 2: alias-qualified `Mod.name`. The receiver is a module
            // alias — an Any-typed name to the checker — so it is resolved to the
            // defining module's prefix through entry_aliases (main.sf's
            // resolved_aliases) and the module-level visibility of `prefix+method`
            // is decided exactly as the bare and named-import paths are. Gated on
            // obj_name actually being a known alias, so an ordinary method call on
            // an Any-typed receiver never consults the map. Uses the alias's
            // prefix as the defining side; check_module_ref_visibility compares it
            // against current_prefix / current_package as usual.
            if (obj_name.length() > 0 and this.entry_aliases.has(obj_name)) {
                this.check_module_ref_visibility(method, this.entry_aliases.get(obj_name))
            }
        }

        // Map.get returns nullable — unless inside a has() guard
        if (method == "get") {
            if (obj_type == "Map" or obj_type.starts_with("Map<")) {
                var val_type: String = this.extract_map_value_type(obj_type)
                var has_guard: String = this.env.get_var("__has_guard")
                if (has_guard == "active") {
                    return val_type
                }
                return this.make_nullable(val_type)
            }
        }
        // Map.has returns Bool
        if (method == "has") {
            return "Bool"
        }
        // Map.keys()/values() are List<K> / List<V>, not List<String>.
        // The hardcoded List<String> let `for (v in m.values())` on a
        // Map<String,Int> pass the checker and then segfault at runtime.
        if (method == "keys") {
            if (obj_type == "Map" or obj_type.starts_with("Map<")) {
                return "List<" + this.extract_map_key_type(obj_type) + ">"
            }
            return "List<Any>"
        }
        if (method == "values") {
            if (obj_type == "Map" or obj_type.starts_with("Map<")) {
                return "List<" + this.extract_map_value_type(obj_type) + ">"
            }
            return "List<Any>"
        }

        // Check: calling method on nullable object
        if (this.is_nullable(obj_type) and this.requires_non_nil(method)) {
            var obj_name: String = this.get_variable_name_from_expr(obj)
            if (obj_name.length() > 0) {
                this.error("cannot call ." + method + "() on nullable '" + obj_name + "' (type " + obj_type + "); add a nil check first")
            } else {
                this.error("cannot call ." + method + "() on nullable type " + obj_type + "; add a nil check first")
            }
        }

        // String methods
        if (obj_type == "String") {
            if (method == "length") return "Int"
            if (method == "split") return "List<String>"
            if (method == "contains") return "Bool"
            if (method == "starts_with") return "Bool"
            if (method == "ends_with") return "Bool"
            if (method == "replace") return "String"
            if (method == "char_at") return "String"
            if (method == "slice") return "String"
            if (method == "to_number") return "Int"
            if (method == "trim") return "String"
        }
        // List methods
        if (obj_type == "List" or obj_type.starts_with("List<")) {
            if (method == "length") return "Int"
            if (method == "join") return "String"
            if (method == "contains") return "Bool"
            if (method == "push") return "Nil"
            if (method == "pop") return "Any"
        }
        // StringBuilder
        if (obj_type == "StringBuilder") {
            if (method == "append") return "Nil"
            if (method == "to_string") return "String"
        }
        // Number methods
        if (obj_type == "Int" or obj_type == "Float") {
            if (method == "floor") return "Int"
            if (method == "to_string") return "String"
        }

        // Class method: look up return type from registered functions
        // Methods are registered as "ClassName__method" or just "method"
        if (obj_type != "Any") {
            // The registry is keyed by the bare class name, so a `Box<String>`
            // receiver has to be looked up as `Box__getItem`. The arguments are
            // not dropped, though — they are exactly what resolves the method's
            // type parameters below (BUGS #95).
            var full_name: String = this.generic_base(obj_type) + "__" + method
            // The receiver's class is known here, so a private method call can be
            // decided. Placed inside this branch rather than at the top of the
            // function on purpose: the builtin-type arms above return before
            // reaching here, so `m.get(k)` and `list.length()` never consult the
            // visibility tables and cannot be perturbed by a user class that
            // happens to declare a private method of the same name.
            this.check_member_visibility(obj_type, method, "method")
            // Check generic constraints for class methods
            if (this.is_generic_func(full_name)) {
                this.check_generic_constraints(full_name, args)
            }
            var ret: String = this.env.get_func_ret(full_name)
            // A class type parameter is substituted from the receiver's own
            // declared type — `Box<String>` says `T` is `String` — before
            // falling back to inferring it from the argument list. The source
            // states this; there is nothing to guess.
            var class_subst: String = this.substitute_class_type_params(ret, obj_type)
            if (class_subst != ret) {
                return class_subst
            }
            if (ret != "Any") {
                // Resolve type params for generic method return types
                if (this.is_type_param(ret)) {
                    var params_str: String = this.env.get_func_params(full_name)
                    var resolved: String = this.resolve_type_params(ret, params_str, args)
                    if (resolved != ret) return resolved
                } else if (ret.contains("<")) {
                    var params_str: String = this.env.get_func_params(full_name)
                    if (params_str.length() > 0) {
                        var resolved: String = this.resolve_generic_return(ret, params_str, args)
                        if (resolved != ret) return resolved
                    }
                }
                return ret
            }
        }
        var ret: String = this.env.get_func_ret(method)
        if (ret != "Any") return ret

        return "Any"
    }

    // --- Match type inference + exhaustiveness ---

    // True when evaluating `expr` cannot fall through to produce a value, because
    // control leaves the enclosing function first. Only a block whose statements
    // diverge can do that in expression position: `Struct(n, f) => { ...; return
    // "%${n}" }` is parsed as a BlockExpr with a NilLit value slot, and treating
    // that Nil as the arm's type is what made a total function look partial.
    fun expr_diverges(expr: AST.Expr): Bool {
        return match (expr) {
            BlockExpr(stmts, value) => this.stmts_diverge(stmts)
            _ => false
        }
    }

    // True when this statement list always leaves the function. Conservative on
    // purpose: a false answer only loses the refinement above, while a wrong true
    // would drop a real arm type out of the union.
    fun stmts_diverge(stmts: List<AST.Stmt>): Bool {
        var i: Float = 0
        while (i < stmts.length()) {
            var diverges: Bool = match (stmts[i]) {
                Return(v) => true
                Throw(v) => true
                // Both branches must leave for the `if` itself to leave. An empty
                // else_branch is a missing else, which falls through.
                If(c, tb, eb) => {
                    if (eb.length() == 0) { false } else { this.stmts_diverge(tb) and this.stmts_diverge(eb) }
                }
                Block(s) => this.stmts_diverge(s)
                ExprStmt(e) => this.expr_diverges(e)
                _ => false
            }
            if (diverges) return true
            i = i + 1
        }
        return false
    }

    fun infer_match(subject: AST.Expr, arms: List<AST.MatchArm>): String {
        var subj_type: String = this.infer_expr(subject)

        // Check exhaustiveness: collect matched variant names
        var matched_variants: List<String> = []
        var has_wildcard: Bool = false

        // Infer each arm body type; unify across arms
        var result_type: String = "Any"
        var have_result: Bool = false
        var i: Float = 0
        while (i < arms.length()) {
            var arm: AST.MatchArm = arms[i]
            var pattern: AST.Pattern = match (arm) { Arm(p, b) => p }
            var body: AST.Expr = match (arm) { Arm(p, b) => b }

            var variant_name: String = match (pattern) {
                VariantPattern(v, bindings) => v
                _ => "_"
            }

            if (variant_name == "_") {
                has_wildcard = true
            } else {
                matched_variants.push(variant_name)
            }

            // Push scope for arm bindings
            this.env.push_scope()
            // A NamedWildcard binds the whole subject under its own name, so it
            // gets the subject's type rather than a payload field's.
            var named_wc: String = match (pattern) { NamedWildcard(n) => n   _ => "" }
            if (named_wc.length() > 0) {
                this.env.define_var(named_wc, this.parse_type_node(subj_type))
            }
            var bindings: List<String> = match (pattern) { VariantPattern(v, b) => b   _ => [] }
            if (subj_type != "Any") {
                this.check_pattern_arity(subj_type, variant_name, bindings, "match arm")
            }
            var bi: Float = 0
            while (bi < bindings.length()) {
                // Bindings from enum fields — try to get type from enum_fields
                var field_type: String = this.get_enum_binding_type(subj_type, variant_name, bi)
                this.env.define_var(bindings[bi], this.parse_type_node(field_type))
                bi = bi + 1
            }

            var arm_type: String = this.infer_expr(body)
            this.check_unused_in_scope()
            this.env.pop_scope()

            // An arm that diverges contributes nothing to the match's type: the
            // `return` leaves the enclosing function, so control never reaches
            // the match's value. The parser gives such a block a NilLit value
            // slot, so unifying it in produced a spurious `Nil` member — which
            // is why `format_type` in src/lib/llvm/types.sf, whose Struct and
            // FnType arms both end in `return`, was reported as returning
            // `String|Nil` from a function expecting `String`.
            if (!this.expr_diverges(body)) {
                if (!have_result) {
                    result_type = arm_type
                    have_result = true
                } else {
                    if (arm_type != result_type and arm_type != "Any" and result_type != "Any") {
                        result_type = result_type + "|" + arm_type
                    }
                }
            }
            i = i + 1
        }

        // Exhaustiveness: check if all variants of an enum are covered
        if (!has_wildcard and subj_type != "Any") {
            this.check_exhaustiveness(subj_type, matched_variants)
        }

        return result_type
    }

    // `enum_fields` and `enum_variants` are keyed by the enum's *declared* name,
    // which is unqualified ("Stmt"). A subject's inferred type is often the
    // qualified spelling the importer sees ("AST.Stmt"), so every lookup has to
    // try both. check_exhaustiveness open-coded this and get_enum_binding_type
    // did not, which is why a match on an imported enum silently gave every
    // binding type Any — see BUGS #98.
    fun resolve_enum_key_name(enum_type: String): String {
        if (this.env.enum_variants.has(enum_type)) return enum_type
        if (!enum_type.contains(".")) return enum_type
        var dot_pos: Float = -1
        var ci: Float = 0
        while (ci < enum_type.length()) {
            if (enum_type.char_at(ci) == ".") { dot_pos = ci }
            ci = ci + 1
        }
        if (dot_pos < 0) return enum_type
        return enum_type.slice(dot_pos + 1, enum_type.length())
    }

    // The declared field list of a variant, one "name:Type" per entry, or an
    // empty list if the variant is unknown or carries no payload.
    fun get_variant_fields(enum_type: String, variant: String): List<String> {
        // Ambiguous name: the field list on file may be the other module's, and
        // typing a binding from it is worse than Any. See register_enum.
        if (this.is_ambiguous_enum(enum_type)) return []
        var key: String = this.resolve_enum_key_name(enum_type) + "." + variant
        if (!this.env.enum_fields.has(key)) return []
        var fields_str: String = this.env.enum_fields.get(key)
        if (fields_str.length() == 0) return []
        // Split on top-level commas only: `Map<String, Int>` is ONE field, and
        // splitting it in two shifted every later field's type by one position.
        return this.split_type_args(fields_str)
    }

    fun get_enum_binding_type(enum_type: String, variant: String, field_idx: Float): String {
        var parts: List<String> = this.get_variant_fields(enum_type, variant)
        if (field_idx >= parts.length()) return "Any"
        // First colon only. A field is "name:Type" and the type may itself
        // contain a colon, so split(":") could not be trusted to give two parts.
        var field_def: String = parts[field_idx.floor()]
        var colon: Float = field_def.index_of(":")
        if (colon < 0) return "Any"
        return field_def.slice(colon + 1, field_def.length()).trim()
    }

    // A pattern must name exactly as many bindings as the variant has fields.
    // Binding fewer left the extra fields unread; binding more invented a
    // binding whose slot was never stored, and both were silently accepted.
    // That is how the stdlib AST mirrors drifted to a stale field count without
    // a single diagnostic (BUGS #98).
    fun check_pattern_arity(enum_type: String, variant: String, bindings: List<String>, ctx: String) {
        // Braced, not `if (c) return` — a bare `return` as an unbraced if-body
        // swallowed the next statement as its value until BUGS #99, and gen2
        // still parses it that way. Keep this shape while gen2 is the root of
        // trust for the bootstrap.
        if (variant == "_" or variant.length() == 0) { return }
        if (variant.starts_with("__strpat:")) { return }
        // Ambiguous name — the declared arity on file may belong to the other
        // module's enum, so any mismatch reported here would be invented.
        if (this.is_ambiguous_enum(enum_type)) { return }
        var key: String = this.resolve_enum_key_name(enum_type) + "." + variant
        var declared: Float = 0
        if (this.env.enum_fields.has(key)) {
            declared = this.get_variant_fields(enum_type, variant).length()
        } else if (!this.env.enum_variants.has(this.resolve_enum_key_name(enum_type))) {
            // Unknown enum — nothing to compare against. Not an arity problem.
            return
        }
        if (bindings.length() != declared) {
            this.error(ctx + " " + variant + " binds " + bindings.length().to_string()
                + " field(s) but " + variant + " declares " + declared.to_string())
        }
    }

    fun check_exhaustiveness(enum_type: String, matched: List<String>) {
        // Two modules declaring this name means the variant list on file may
        // belong to the other one — reporting from it invents missing variants
        // that the matched enum never had. See register_enum.
        if (this.is_ambiguous_enum(enum_type)) return nil
        // Try both the qualified spelling and the declared (unqualified) one.
        var lookup_name: String = this.resolve_enum_key_name(enum_type)
        if (!this.env.enum_variants.has(lookup_name)) return nil
        var all_variants_str: String = this.env.enum_variants.get(lookup_name)
        if (all_variants_str.length() == 0) return nil
        var all_variants: List<String> = all_variants_str.split(",")
        var missing: List<String> = []
        var i: Float = 0
        while (i < all_variants.length()) {
            var v: String = all_variants[i]
            if (!matched.contains(v)) {
                missing.push(v)
            }
            i = i + 1
        }
        if (missing.length() > 0) {
            this.error("non-exhaustive match on " + enum_type + ": missing variants " + missing.join(", "))
        }
    }


    // --- Let-pattern type checking ---

    fun check_let_pattern(pattern: AST.Pattern, val_type: String) {
        var variant: String = match (pattern) { VariantPattern(v, b) => v   ArrayPattern(e, r) => "__array:" + r   _ => "" }
        var bindings: List<String> = match (pattern) { VariantPattern(v, b) => b   ArrayPattern(e, r) => e   _ => [] }
        if (variant.starts_with("__array:")) {
            var rest: String = variant.slice(8, variant.length())
            var bi: Float = 0
            while (bi < bindings.length()) {
                this.env.define_var(bindings[bi], AST.Type.AnyType)
                bi = bi + 1
            }
            if (rest.length() > 0) {
                this.env.define_var(rest, AST.Type.GenericType("List", [AST.Type.AnyType]))
            }
            return
        }
        if (variant == "_" or variant.length() == 0) {
            return
        }
        if (val_type == "Any") {
            this.warn("let " + variant + "(...): cannot verify pattern against type Any")
            var bi: Float = 0
            while (bi < bindings.length()) {
                this.env.define_var(bindings[bi], AST.Type.AnyType)
                bi = bi + 1
            }
            return
        }
        var key: String = this.resolve_enum_key_name(val_type) + "." + variant
        if (!this.env.enum_fields.has(key)) {
            this.error("let " + variant + "(...): " + variant + " is not a variant of " + val_type)
            var bi: Float = 0
            while (bi < bindings.length()) {
                this.env.define_var(bindings[bi], AST.Type.AnyType)
                bi = bi + 1
            }
            return
        }
        this.check_pattern_arity(val_type, variant, bindings, "let-destructuring of")
        var bi: Float = 0
        while (bi < bindings.length()) {
            var field_type: String = this.get_enum_binding_type(val_type, variant, bi)
            this.env.define_var(bindings[bi], this.parse_type_node(field_type))
            bi = bi + 1
        }
    }

    // --- Receiver closure desugaring ---

    fun extract_receiver_class(type_str: String): String {
        // "Fun[Project]():Nil" → "Project"
        // "Fun[HttpRequest](String):Nil" → "HttpRequest"
        if (!type_str.starts_with("Fun[")) return ""
        var bracket_end: Float = type_str.index_of("]")
        if (bracket_end < 0) return ""
        return type_str.slice(4, bracket_end)
    }

    fun is_lambda_expr(expr: AST.Expr): Bool {
        return match (expr) {
            Lambda(p, r, b) => true
            _ => false
        }
    }

    fun get_receiver_fields(class_name: String): List<String> {
        // Returns list of field names for a class
        var result: List<String> = []
        if (!this.env.class_fields.has(class_name)) return result
        var fields_str: String = this.env.class_fields.get(class_name)
        if (fields_str.length() == 0) return result
        var parts: List<String> = fields_str.split(",")
        var i: Float = 0
        while (i < parts.length()) {
            var kv: List<String> = parts[i].split(":")
            if (kv.length() >= 1 and kv[0].length() > 0) {
                result.push(kv[0])
            }
            i = i + 1
        }
        return result
    }

    fun get_receiver_methods(class_name: String): List<String> {
        // Returns list of method names for a class
        var result: List<String> = []
        if (!this.class_method_names.has(class_name)) return result
        var methods_str: String = this.class_method_names.get(class_name)
        if (methods_str.length() == 0) return result
        return methods_str.split(",")
    }

    // --- Function-typed parameter signatures (BUGS #86) ---

    // Read the parameter-type list out of a declared function type. Returns "?" when
    // the spelling names a function but says nothing about its parameters, so callers
    // can tell "declared zero parameters" (`""`) apart from "declared nothing"
    // (`"?"`) — collapsing those two is exactly how a guess gets laundered into a
    // type. Returns "!" for a parameter that is not a function type at all.
    //
    // The input must come from type_to_str, NOT type_node_to_string: the latter is
    // ast.sf's renderer, which prints every GenericType as its bare base name, so
    // `Fun<Box, String>` would arrive here as "Fun" with the two type arguments
    // already gone. type_to_str renders the arguments.
    //
    // Which spellings actually carry information, as of today:
    //   "Fun"            bare `Fun`              → "?"  (no information)
    //   "Fun<A,B,R>"     `Fun<A, B, R>`          → "A,B" (trailing arg is the return)
    //
    // The arrow spelling `(A) => R` does NOT come through this function at all —
    // see fun_param_sig_of below, which reads the FuncType node directly. It cannot
    // come through here, because the node's information is destroyed by the very
    // rendering step that produces this function's input: type_to_str renders every
    // FuncType as the bare string "Fun". Note that a bare `Fun` also reaches here as
    // "Fun", but by a different route — it parses to ClassType("Fun"), never to a
    // FuncType — so the two are still distinguishable at the node level even though
    // they are not distinguishable in this string.
    fun fun_param_types_of(type_str: String): String {
        if (type_str == "Fun") return "?"
        if (type_str.starts_with("Fun<")) {
            // `Fun<A, B, R>` is (A, B) => R: the trailing argument is the return
            // type, so `Fun<R>` declares no parameters at all.
            var inner: String = type_str.slice(4, type_str.length() - 1)
            var parts: List<String> = this.split_type_args(inner)
            if (parts.length() <= 1) return ""
            var kept: List<String> = []
            var pi: Float = 0
            while (pi < parts.length() - 1) {
                kept.push(parts[pi])
                pi = pi + 1
            }
            return kept.join(",")
        }
        // Not a function type — the caller must not treat this parameter as one.
        return "!"
    }

    // What one parameter declares about its own parameters, in the same three
    // states fun_param_types_of returns: "!" not a function type, "?" a function
    // type that says nothing, otherwise the comma-joined declared types.
    //
    // This dispatches on the NODE rather than on a rendered string, because the two
    // spellings survive rendering differently:
    //
    //   `f: Fun<A, B, R>`  parses to GenericType("Fun", [A, B, R]). type_to_str
    //                      renders its arguments, so the string still carries them
    //                      and fun_param_types_of can read them back out.
    //   `f: (A, B) => R`   parses to FuncType([A, B], R) — since parser.sf's
    //                      parse_fun_type_ast stopped discarding them. But
    //                      type_to_str renders EVERY FuncType as the bare "Fun",
    //                      so rendering first destroys exactly the information
    //                      needed and lands the arrow spelling in the "?" state:
    //                      an error rather than the declared types.
    //
    // Reading the node fixes that without touching type_to_str, which is the point.
    // type_to_str has other consumers that depend on its collapsed "Fun": infer_expr
    // renders a Lambda's inferred FuncType through it, and both `is_type_param` and
    // fun_param_types_of test `typ == "Fun"` by exact equality. Rendering FuncType
    // richly there would make is_type_param("Fun():Any") answer TRUE — a lambda
    // silently reclassified as a generic type parameter — and would make
    // is_subtype_node's string comparison stop equating two function types. So the
    // rich reading lives here, at the one site that needs it.
    //
    // A FuncType with no parameters is genuinely "declared zero parameters" (""),
    // not "declared nothing" ("?"): `() => Int` says its callback takes nothing, and
    // conflating that with a bare `Fun` is the collapse #86 exists to prevent. The
    // "?" state stays reachable only through ClassType("Fun"), which is what a bare
    // `Fun` annotation actually parses to.
    fun fun_param_sig_of(pt: AST.Type): String {
        return match (pt) {
            FuncType(p, r) => {
                var rendered: List<String> = []
                var fi: Float = 0
                while (fi < p.length()) {
                    rendered.push(this.type_to_str(p[fi]))
                    fi = fi + 1
                }
                rendered.join(",")
            }
            // Every other spelling still goes through the string reader, which
            // handles `Fun<A, B, R>` and answers "!" for a non-function type.
            IntType => this.fun_param_types_of(this.type_to_str(pt))
            FloatType => this.fun_param_types_of(this.type_to_str(pt))
            BoolType => this.fun_param_types_of(this.type_to_str(pt))
            StringType => this.fun_param_types_of(this.type_to_str(pt))
            NilType => this.fun_param_types_of(this.type_to_str(pt))
            AnyType => this.fun_param_types_of(this.type_to_str(pt))
            ClassType(n) => this.fun_param_types_of(this.type_to_str(pt))
            EnumType(n) => this.fun_param_types_of(this.type_to_str(pt))
            GenericType(b, a) => this.fun_param_types_of(this.type_to_str(pt))
            UnionType(ts) => this.fun_param_types_of(this.type_to_str(pt))
            NullableType(inner) => this.fun_param_types_of(this.type_to_str(pt))
        }
    }

    // Record, for every function-typed parameter of `name`, what that parameter
    // declares about its own parameters. Called from both registration sites so a
    // free function and a method are indistinguishable at the call site.
    fun register_fun_param_sigs(name: String, params: List<AST.Param>) {
        var i: Float = 0
        while (i < params.length()) {
            var p: AST.Param = params[i]
            var pt: AST.Type = match (p) { Param(n, t, d, p_vis) => t }
            var sig: String = this.fun_param_sig_of(pt)
            if (sig != "!") {
                this.fun_param_sigs.set(name + ":" + i.floor().to_string(), sig)
            }
            i = i + 1
        }
    }

    // Push the callee's declared parameter types into a lambda argument whose own
    // parameters carry no annotation, and report the case where there is nothing to
    // push. This is what turns a block-syntax parameter from "no type" into either
    // the declared type or a hard error.
    //
    // Only AnyType parameters are touched: an explicitly annotated lambda states
    // its own types and must keep them, so that a genuine mismatch stays visible
    // rather than being overwritten to agree.
    fun apply_fun_param_sig(args: List<AST.Expr>, arg_idx: Float, sig: String, callee: String) {
        var lambda: AST.Expr = args[arg_idx]
        var params: List<AST.Param> = match (lambda) { Lambda(p, r, b) => p    _ => [] }
        var ret_type: String = match (lambda) { Lambda(p, r, b) => r    _ => "Any" }
        var body: List<AST.Stmt> = match (lambda) { Lambda(p, r, b) => b    _ => [] }
        if (params.length() == 0) return nil

        // How many parameters were declared, and what are they?
        var declared: List<String> = []
        if (sig != "?" and sig.length() > 0) {
            declared = this.split_type_args(sig)
        }

        var new_params: List<AST.Param> = []
        var changed: Bool = false
        var i: Float = 0
        while (i < params.length()) {
            var pname: String = match (params[i]) { Param(n, t, d, p_vis) => n }
            var pt: AST.Type = match (params[i]) { Param(n, t, d, p_vis) => t }
            var pdef: AST.Expr = match (params[i]) { Param(n, t, d, p_vis) => d }
            // Rebuilding an existing Param below, so carry its visibility across
            // rather than resetting to "public": this rewrite exists only to fill in
            // an inferred type and must not otherwise alter the declaration.
            var pvis: String = match (params[i]) { Param(n, t, d, p_vis) => p_vis }
            if (this.is_any_type(pt) and pname != "self") {
                if (i < declared.length()) {
                    var declared_str: String = declared[i].trim()
                    if (declared_str.length() > 0 and declared_str != "Any") {
                        pt = this.parse_type_node(declared_str)
                        changed = true
                    } else {
                        this.error("parameter '" + pname + "' of the function passed to '" + callee
                            + "' has no type: '" + callee + "' declares its parameter " + i.floor().to_string()
                            + " as 'Any'. Annotate the lambda parameter, or give '" + callee
                            + "' a parameter type that says what it calls back with.")
                    }
                } else {
                    // Either the callee said nothing about its callback's shape
                    // (bare `Fun`) or it declared fewer parameters than the lambda
                    // takes. Both mean the type is genuinely not in the source, and a
                    // guess here is what BUGS #86 was: a field read answering 0.
                    this.error("parameter '" + pname + "' of the function passed to '" + callee
                        + "' has no type, and none can be derived: '" + callee
                        + "' does not declare what it calls that function with."
                        + " Annotate the parameter (`fun (" + pname
                        + ": T): R => ...`), or declare the callee's parameter as `Fun<T, R>`"
                        + " so a block can be typed from it.")
                }
            }
            new_params.push(AST.Param.Param(pname, pt, pdef, pvis))
            i = i + 1
        }
        if (changed) {
            args[arg_idx] = AST.Expr.Lambda(new_params, ret_type, body)
        }
    }

    fun desugar_receiver_closure(args: List<AST.Expr>, arg_idx: Float, receiver_class: String) {
        // Transform a Lambda at args[arg_idx] to add 'self' param and rewrite body
        var lambda: AST.Expr = args[arg_idx]
        var params: List<AST.Param> = match (lambda) { Lambda(p, r, b) => p    _ => [] }
        var ret_type: AST.Type = match (lambda) { Lambda(p, r, b) => r    _ => AST.Type.AnyType }
        var body: List<AST.Stmt> = match (lambda) { Lambda(p, r, b) => b    _ => [] }

        // Skip if Lambda already has a 'self' parameter (user provided explicit receiver)
        if (params.length() > 0) {
            var first_param_name: String = match (params[0]) { Param(n, t, d, p_vis) => n }
            if (first_param_name == "self") return nil
        }

        // Get receiver fields and methods
        var fields: List<String> = this.get_receiver_fields(receiver_class)
        var methods: List<String> = this.get_receiver_methods(receiver_class)

        // Rewrite body statements: bare assigns to receiver fields → SetField(This, ...)
        var new_body: List<AST.Stmt> = []
        var i: Float = 0
        while (i < body.length()) {
            var new_stmt: AST.Stmt = this.rewrite_receiver_stmt(body[i], fields, methods)
            new_body.push(new_stmt)
            i = i + 1
        }

        // Build new params: prepend 'self' parameter
        var new_params: List<AST.Param> = []
        new_params.push(AST.Param.Param("self", AST.Type.ClassType(receiver_class), AST.Expr.NilLit, "public"))
        var pi: Float = 0
        while (pi < params.length()) {
            new_params.push(params[pi])
            pi = pi + 1
        }

        // Replace the Lambda in the args list with the desugared version
        // Modify body in place
        var bi: Float = 0
        while (bi < body.length()) {
            body[bi] = new_body[bi]
            bi = bi + 1
        }
        // Since we can't prepend to a list in place, create a new Lambda
        args[arg_idx] = AST.Expr.Lambda(new_params, ret_type, body)
    }

    fun rewrite_receiver_stmt(stmt: AST.Stmt, fields: List<String>, methods: List<String>): AST.Stmt {
        return match (stmt) {
            ExprStmt(expr) => {
                var rewritten: AST.Expr = this.rewrite_receiver_expr(expr, fields, methods)
                var result: AST.Stmt = AST.Stmt.ExprStmt(rewritten)
                result
            }
            VarDecl(name, type_ann, init, doc, v_vis) => {
                AST.Stmt.VarDecl(name, type_ann, this.rewrite_receiver_expr(init, fields, methods), doc, v_vis)
            }
            Return(value) => {
                AST.Stmt.Return(this.rewrite_receiver_expr(value, fields, methods))
            }
            If(cond, then_b, else_b) => {
                var new_then: List<AST.Stmt> = this.rewrite_receiver_stmts(then_b, fields, methods)
                var new_else: List<AST.Stmt> = this.rewrite_receiver_stmts(else_b, fields, methods)
                AST.Stmt.If(this.rewrite_receiver_expr(cond, fields, methods), new_then, new_else)
            }
            While(cond, body) => {
                var new_body: List<AST.Stmt> = this.rewrite_receiver_stmts(body, fields, methods)
                AST.Stmt.While(this.rewrite_receiver_expr(cond, fields, methods), new_body)
            }
            Block(stmts) => {
                AST.Stmt.Block(this.rewrite_receiver_stmts(stmts, fields, methods))
            }
            _ => stmt
        }
    }

    fun rewrite_receiver_stmts(stmts: List<AST.Stmt>, fields: List<String>, methods: List<String>): List<AST.Stmt> {
        var result: List<AST.Stmt> = []
        var i: Float = 0
        while (i < stmts.length()) {
            result.push(this.rewrite_receiver_stmt(stmts[i], fields, methods))
            i = i + 1
        }
        return result
    }

    fun rewrite_receiver_expr(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        // Dispatch to specific rewrite functions to avoid complex match-arm value issues
        var ek: String = this.classify_receiver_expr(expr)
        if (ek == "assign") return this.rewrite_recv_assign(expr, fields, methods)
        if (ek == "variable") return this.rewrite_recv_variable(expr, fields, methods)
        if (ek == "call") return this.rewrite_recv_call(expr, fields, methods)
        if (ek == "binary") return this.rewrite_recv_binary(expr, fields, methods)
        if (ek == "unary") return this.rewrite_recv_unary(expr, fields, methods)
        if (ek == "method_call") return this.rewrite_recv_method_call(expr, fields, methods)
        if (ek == "set_field") return this.rewrite_recv_set_field(expr, fields, methods)
        if (ek == "get_field") return this.rewrite_recv_get_field(expr, fields, methods)
        if (ek == "index_get") return this.rewrite_recv_index_get(expr, fields, methods)
        if (ek == "index_set") return this.rewrite_recv_index_set(expr, fields, methods)
        if (ek == "logical") return this.rewrite_recv_logical(expr, fields, methods)
        if (ek == "list_lit") return this.rewrite_recv_list_lit(expr, fields, methods)
        return expr
    }

    fun classify_receiver_expr(expr: AST.Expr): String {
        return match (expr) {
            Assign(n, v) => "assign"
            Variable(n) => "variable"
            Ref(rk, rn, rs) => "variable"
            Call(c, a) => "call"
            Binary(l, o, r) => "binary"
            Unary(o, r) => "unary"
            MethodCall(o, m, a) => "method_call"
            SetField(o, f, v) => "set_field"
            GetField(o, f) => "get_field"
            IndexGet(o, i) => "index_get"
            IndexSet(o, i, v) => "index_set"
            Logical(l, o, r) => "logical"
            ListLit(e) => "list_lit"
            Lambda(p, r, b) => "lambda"
            _ => "other"
        }
    }

    fun rewrite_recv_assign(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var name: String = match (expr) { Assign(n, v) => n    _ => "" }
        var value: AST.Expr = match (expr) { Assign(n, v) => v    _ => AST.Expr.NilLit }
        if (fields.contains(name)) {
            return AST.Expr.SetField(AST.Expr.This, name, this.rewrite_receiver_expr(value, fields, methods))
        }
        return AST.Expr.Assign(name, this.rewrite_receiver_expr(value, fields, methods))
    }

    fun rewrite_recv_variable(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var name: String = match (expr) { Variable(n) => n   Ref(rk, rn, rs) => rn   _ => "" }
        if (fields.contains(name)) {
            return AST.Expr.GetField(AST.Expr.This, name)
        }
        return expr
    }

    fun rewrite_recv_call(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var callee: AST.Expr = match (expr) { Call(c, a) => c    _ => AST.Expr.NilLit }
        var args: List<AST.Expr> = match (expr) { Call(c, a) => a    _ => [] }
        var callee_name: String = match (callee) {
            Variable(n) => n
            Ref(rk, rn, rs) => rn
            _ => ""
        }
        var name_ok: Bool = callee_name.length() > 0
        var in_methods: Bool = methods.contains(callee_name)
        var is_method: Bool = name_ok and in_methods
        var result: AST.Expr = expr
        if (is_method) {
            var new_args: List<AST.Expr> = this.rewrite_receiver_exprs(args, fields, methods)
            result = AST.Expr.MethodCall(AST.Expr.This, callee_name, new_args)
        } else {
            var new_callee: AST.Expr = this.rewrite_receiver_expr(callee, fields, methods)
            var new_args: List<AST.Expr> = this.rewrite_receiver_exprs(args, fields, methods)
            result = AST.Expr.Call(new_callee, new_args)
        }
        return result
    }

    fun rewrite_recv_binary(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var left: AST.Expr = match (expr) { Binary(l, o, r) => l    _ => AST.Expr.NilLit }
        var op: String = match (expr) { Binary(l, o, r) => o    _ => "" }
        var right: AST.Expr = match (expr) { Binary(l, o, r) => r    _ => AST.Expr.NilLit }
        return AST.Expr.Binary(this.rewrite_receiver_expr(left, fields, methods), op, this.rewrite_receiver_expr(right, fields, methods))
    }

    fun rewrite_recv_unary(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var op: String = match (expr) { Unary(o, r) => o    _ => "" }
        var right: AST.Expr = match (expr) { Unary(o, r) => r    _ => AST.Expr.NilLit }
        return AST.Expr.Unary(op, this.rewrite_receiver_expr(right, fields, methods))
    }

    fun rewrite_recv_method_call(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var obj: AST.Expr = match (expr) { MethodCall(o, m, a) => o    _ => AST.Expr.NilLit }
        var method: String = match (expr) { MethodCall(o, m, a) => m    _ => "" }
        var args: List<AST.Expr> = match (expr) { MethodCall(o, m, a) => a    _ => [] }
        var new_obj: AST.Expr = this.rewrite_receiver_expr(obj, fields, methods)
        var new_args: List<AST.Expr> = this.rewrite_receiver_exprs(args, fields, methods)
        return AST.Expr.MethodCall(new_obj, method, new_args)
    }

    fun rewrite_recv_set_field(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var obj: AST.Expr = match (expr) { SetField(o, f, v) => o    _ => AST.Expr.NilLit }
        var field: String = match (expr) { SetField(o, f, v) => f    _ => "" }
        var value: AST.Expr = match (expr) { SetField(o, f, v) => v    _ => AST.Expr.NilLit }
        return AST.Expr.SetField(this.rewrite_receiver_expr(obj, fields, methods), field, this.rewrite_receiver_expr(value, fields, methods))
    }

    fun rewrite_recv_get_field(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var obj: AST.Expr = match (expr) { GetField(o, f) => o    _ => AST.Expr.NilLit }
        var field: String = match (expr) { GetField(o, f) => f    _ => "" }
        return AST.Expr.GetField(this.rewrite_receiver_expr(obj, fields, methods), field)
    }

    fun rewrite_recv_index_get(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var obj: AST.Expr = match (expr) { IndexGet(o, i) => o    _ => AST.Expr.NilLit }
        var index: AST.Expr = match (expr) { IndexGet(o, i) => i    _ => AST.Expr.NilLit }
        return AST.Expr.IndexGet(this.rewrite_receiver_expr(obj, fields, methods), this.rewrite_receiver_expr(index, fields, methods))
    }

    fun rewrite_recv_index_set(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var obj: AST.Expr = match (expr) { IndexSet(o, i, v) => o    _ => AST.Expr.NilLit }
        var index: AST.Expr = match (expr) { IndexSet(o, i, v) => i    _ => AST.Expr.NilLit }
        var value: AST.Expr = match (expr) { IndexSet(o, i, v) => v    _ => AST.Expr.NilLit }
        return AST.Expr.IndexSet(this.rewrite_receiver_expr(obj, fields, methods), this.rewrite_receiver_expr(index, fields, methods), this.rewrite_receiver_expr(value, fields, methods))
    }

    fun rewrite_recv_logical(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var left: AST.Expr = match (expr) { Logical(l, o, r) => l    _ => AST.Expr.NilLit }
        var op: String = match (expr) { Logical(l, o, r) => o    _ => "" }
        var right: AST.Expr = match (expr) { Logical(l, o, r) => r    _ => AST.Expr.NilLit }
        return AST.Expr.Logical(this.rewrite_receiver_expr(left, fields, methods), op, this.rewrite_receiver_expr(right, fields, methods))
    }

    fun rewrite_recv_list_lit(expr: AST.Expr, fields: List<String>, methods: List<String>): AST.Expr {
        var elements: List<AST.Expr> = match (expr) { ListLit(e) => e    _ => [] }
        return AST.Expr.ListLit(this.rewrite_receiver_exprs(elements, fields, methods))
    }

    fun rewrite_receiver_exprs(exprs: List<AST.Expr>, fields: List<String>, methods: List<String>): List<AST.Expr> {
        var result: List<AST.Expr> = []
        var i: Float = 0
        while (i < exprs.length()) {
            result.push(this.rewrite_receiver_expr(exprs[i], fields, methods))
            i = i + 1
        }
        return result
    }

    // --- Generic type parameter support ---

    fun extract_and_register_generics(func_name: String, doc: String) {
        // Extract @generic:T,U:Constraint+Other from docstring prefix
        if (!doc.starts_with("@generic:")) return nil
        var newline_pos: Float = doc.index_of("\n")
        var generic_str: String = ""
        if (newline_pos >= 0) {
            generic_str = doc.slice(9, newline_pos)
        } else {
            generic_str = doc.slice(9, doc.length())
        }
        if (generic_str.length() > 0) {
            this.env.define_func_type_params(func_name, generic_str)
        }
    }

    fun parse_type_param_names(type_params_str: String): List<String> {
        // "T,U:Constraint,V:A+B" → ["T", "U", "V"]
        var names: List<String> = []
        if (type_params_str.length() == 0) return names
        var parts: List<String> = type_params_str.split(",")
        var i: Float = 0
        while (i < parts.length()) {
            var part: String = parts[i]
            var colon_pos: Float = part.index_of(":")
            if (colon_pos >= 0) {
                names.push(part.slice(0, colon_pos))
            } else {
                names.push(part)
            }
            i = i + 1
        }
        return names
    }

    fun get_type_param_constraints(type_params_str: String, param_name: String): List<String> {
        // For "T,U:Serializable+Comparable" and param "U" → ["Serializable", "Comparable"]
        var constraints: List<String> = []
        if (type_params_str.length() == 0) return constraints
        var parts: List<String> = type_params_str.split(",")
        var i: Float = 0
        while (i < parts.length()) {
            var part: String = parts[i]
            var colon_pos: Float = part.index_of(":")
            if (colon_pos >= 0) {
                var name: String = part.slice(0, colon_pos)
                if (name == param_name) {
                    var constraint_str: String = part.slice(colon_pos + 1, part.length())
                    constraints = constraint_str.split("+")
                    return constraints
                }
            }
            i = i + 1
        }
        return constraints
    }

    fun check_generic_constraints(func_name: String, args: List<AST.Expr>) {
        // Look up type params for this function
        var type_params_str: String = this.env.get_func_type_params(func_name)
        if (type_params_str.length() == 0) return nil
        var params_str: String = this.env.get_func_params(func_name)
        if (params_str.length() == 0) return nil
        // Get type param names
        var tp_names: List<String> = this.parse_type_param_names(type_params_str)
        // For each type param, try to resolve it from the args, then check constraints
        var ti: Float = 0
        while (ti < tp_names.length()) {
            var tp_name: String = tp_names[ti]
            var constraints: List<String> = this.get_type_param_constraints(type_params_str, tp_name)
            if (constraints.length() > 0) {
                // Resolve what type the type param binds to
                var resolved: String = this.resolve_type_params(tp_name, params_str, args)
                if (resolved != tp_name and resolved != "Any") {
                    // Check each constraint
                    var ci: Float = 0
                    while (ci < constraints.length()) {
                        var constraint: String = constraints[ci]
                        if (!this.type_satisfies_constraint(resolved, constraint)) {
                            this.warn("generic constraint violation: " + resolved + " does not satisfy " + constraint + " (required by " + func_name + "<" + tp_name + ">)")
                        }
                        ci = ci + 1
                    }
                }
            }
            ti = ti + 1
        }
    }

    fun type_satisfies_constraint(typ: String, constraint: String): Bool {
        // Check if a type satisfies a constraint (interface name)
        // 1. Check if the type has the constraint as a parent (interface conformance)
        // Any base at any depth satisfies the constraint. The comma-splitting
        // that used to live here was vestigial — class_parents held a single
        // name, never a joined list — and it only ever looked one level up.
        if (this.inherits_from(typ, constraint)) return true
        // 2. Check if the constraint's methods are all present on the type
        if (this.class_method_names.has(constraint)) {
            var required_methods_str: String = this.class_method_names.get(constraint)
            var required_methods: List<String> = required_methods_str.split(",")
            var has_all: Bool = true
            var mi: Float = 0
            while (mi < required_methods.length()) {
                var method: String = required_methods[mi]
                if (method != "init" and method.length() > 0) {
                    // Check if the type has this method
                    var full_name: String = typ + "__" + method
                    var ret: String = this.env.get_func_ret(full_name)
                    if (ret == "Any") {
                        has_all = false
                    }
                }
                mi = mi + 1
            }
            if (has_all) return true
        }
        // 3. Built-in type structural checks for common interfaces
        // String has length(), so it satisfies HasLength-like interfaces structurally
        return false
    }

    fun is_generic_func(name: String): Bool {
        var tp: String = this.env.get_func_type_params(name)
        return tp.length() > 0
    }

    // --- Report ---

    fun report(): String {
        if (this.errors.length() == 0 and this.warnings.length() == 0) {
            return ""
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < this.errors.length()) {
            sb.append("ERROR: ")
            sb.append(this.errors[i])
            sb.append("\n")
            i = i + 1
        }
        i = 0
        while (i < this.warnings.length()) {
            sb.append("WARN: ")
            sb.append(this.warnings[i])
            sb.append("\n")
            i = i + 1
        }
        return sb.to_string()
    }

    fun has_errors(): Bool {
        return this.errors.length() > 0
    }

    fun error_report(): String {
        // Print warnings (non-blocking) to stderr
        if (this.warnings.length() > 0) {
            var wi: Float = 0
            while (wi < this.warnings.length()) {
                IO.println("[checker] Warning: " + this.warnings[wi])
                wi = wi + 1
            }
        }
        if (this.errors.length() == 0) {
            return ""
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < this.errors.length()) {
            sb.append("ERROR: ")
            sb.append(this.errors[i])
            sb.append("\n")
            i = i + 1
        }
        return sb.to_string()
    }
}

fun check(program: List<AST.Stmt>): String {
    var checker: NullChecker = NullChecker()
    checker.check_program(program)
    return checker.report()
}

fun check_with_imports(program: List<AST.Stmt>, imports: List<AST.Stmt>): String {
    var checker: NullChecker = NullChecker()
    // Register imported declarations (types, enums, classes, functions)
    // without checking their bodies
    var i: Float = 0
    while (i < imports.length()) {
        checker.register_decl(imports[i])
        i = i + 1
    }
    checker.check_program(program)
    return checker.report()
}

// Returns only error messages (blocking). Empty string means no errors.
fun check_errors_only(program: List<AST.Stmt>): String {
    var checker: NullChecker = NullChecker()
    checker.check_program(program)
    return checker.error_report()
}

// Register every imported declaration with no idea which module it came from.
// Kept as a thin wrapper over check_errors_with_modules so existing callers and
// tests keep working; anything that HAS the boundaries should pass them, because
// without them two modules declaring the same class are indistinguishable here.
fun check_errors_with_imports(program: List<AST.Stmt>, imports: List<AST.Stmt>): String {
    return check_errors_with_modules(program, imports, [], "")
}

// Phase 2 of docs/design/access-modifiers.md: the checker learns which module
// each imported declaration came from.
//
// `boundaries` and `prefixes_joined` are decoded exactly as
// Resolve.resolve_imports decodes them — boundaries[i]..boundaries[i+1] is
// module i's slice of the flat statement list, and prefixes_joined is the
// "|"-joined prefix list indexed by the same i. Deliberately the same decoding
// and not a second scheme: two readers of one encoding that disagree is how the
// module identity would drift from what codegen and resolve believe.
//
// With an empty boundary list this degrades to the old flat behaviour rather
// than failing, which is what makes check_errors_with_imports above still valid.
fun check_errors_with_modules(program: List<AST.Stmt>, imports: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String): String {
    return check_errors_with_module_packages(program, imports, boundaries, prefixes_joined, "", no_package_marker(), {})
}

// The `internal` (package-scope) half of module identity: same walk as
// check_errors_with_modules, plus the owning package root of each module.
//
// `package_roots_joined` is main.sf's package_roots_joined() — newline-joined,
// indexed by the SAME i as `prefixes_joined` and `boundaries`. Newline and not
// "|" because these entries are filesystem paths and "|" is legal in one.
//
// It is a separate list rather than a field packed into the prefix string
// because package membership is not recoverable from a prefix: the prefix comes
// from the file path shape, the package from the nearest pantry.toml above the
// file. Only main.sf has read those manifests, so main.sf is the authority and
// this function is a consumer of its answer (M1 — a consumer must not re-derive
// what the producer already knows).
//
// A short or empty list is not an error: every module whose entry is missing
// gets the packageless marker, which denies `internal` access rather than
// granting it. That is what keeps check_errors_with_modules above — and every
// caller that has no manifest information at all — valid and conservative.
fun check_errors_with_module_packages(program: List<AST.Stmt>, imports: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, package_roots_joined: String, program_package: String, entry_aliases: Map<String, String>): String {
    var checker: NullChecker = NullChecker()
    checker.entry_aliases = entry_aliases
    var prefixes: List<String> = prefixes_joined.split("|")
    var pkg_roots: List<String> = []
    if (package_roots_joined.length() > 0) {
        pkg_roots = package_roots_joined.split("\n")
    }
    if (boundaries.length() > 1) {
        // Walk module by module, restoring each module's prefix first, so every
        // declaration is registered as belonging to the module that declared it.
        var bi: Float = 0
        while (bi + 1 < boundaries.length()) {
            var start: Float = boundaries[bi]
            var end: Float = boundaries[bi + 1]
            if (bi < prefixes.length()) {
                checker.current_prefix = prefixes[bi]
            } else {
                checker.current_prefix = ""
            }
            if (bi < pkg_roots.length()) {
                checker.current_package = pkg_roots[bi]
            } else {
                checker.current_package = no_package_marker()
            }
            var si: Float = start
            while (si < end) {
                checker.register_decl(imports[si])
                si = si + 1
            }
            bi = bi + 1
        }
    } else {
        var i: Float = 0
        while (i < imports.length()) {
            checker.register_decl(imports[i])
            i = i + 1
        }
    }
    // The main program is its own module, and it is not prefixed — same
    // convention as Resolve.resolve_main. Its package is passed separately
    // because it is not in the boundary list: `boundaries` covers the imported
    // modules only.
    checker.current_prefix = ""
    checker.current_package = program_package
    checker.check_program(program)
    return checker.error_report()
}
