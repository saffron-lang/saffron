// Recursive descent parser for Saffron-mini

import "./ast.sf" as AST
import "./lexer.sf" as Lexer

class Parser {
    var tokens: List<Lexer.Token>
    var pos: Float
    var had_error: Bool
    var error_count: Float
    var source: String
    var html_depth: Float

    fun init(tokens: List<Lexer.Token>) {
        this.tokens = tokens
        this.pos = 0
        this.had_error = false
        this.error_count = 0
        this.source = ""
        this.html_depth = 0
    }

    fun current(): Lexer.Token {
        return this.tokens[this.pos]
    }

    fun current_kind(): Lexer.TokenKind {
        var tok: Lexer.Token = this.current()
        return match (tok) { Token(kind, line, col) => kind }
    }

    fun advance(): Lexer.Token {
        var tok: Lexer.Token = this.current()
        this.pos = this.pos + 1
        return tok
    }

    fun expect_ident(): String {
        var kind: Lexer.TokenKind = this.current_kind()
        this.advance()
        return match (kind) {
            TkIdent(name) => name
            TkAs => "as"
            TkIn => "in"
            TkIs => "is"
            _ => ""
        }
    }

    fun peek_ident(): String {
        if (!this.match_kind_check("ident")) return ""
        var kind: Lexer.TokenKind = this.current_kind()
        return match (kind) {
            TkIdent(name) => name
        }
    }

    fun match_kind(expected: String): Bool {
        if (this.match_kind_check(expected)) {
            this.advance()
            return true
        }
        return false
    }

    fun current_line(): String {
        var tok: Lexer.Token = this.current()
        var line: Float = match (tok) { Token(kind, line, col) => line }
        return line.floor().to_string()
    }

    fun current_line_num(): Float {
        var tok: Lexer.Token = this.current()
        return match (tok) { Token(kind, line, col) => line }
    }

    fun prev_line_num(): Float {
        var tok: Lexer.Token = this.tokens[this.pos - 1]
        return match (tok) { Token(kind, line, col) => line }
    }

    fun current_col(): String {
        var tok: Lexer.Token = this.current()
        var col: Float = match (tok) { Token(kind, line, col) => col }
        return col.floor().to_string()
    }

    fun current_token_str(): String {
        var kind: Lexer.TokenKind = this.current_kind()
        return this.kind_name(kind)
    }

    fun parse_error(message: String) {
        this.error_count = this.error_count + 1
        if (this.error_count > 20) {
            if (this.error_count == 21) {
                IO.println("Too many errors (20+), stopping.")
            }
            this.had_error = true
            // Skip to EOF to abort parsing
            while (!this.match_kind_check("eof")) {
                this.advance()
            }
            return
        }
        IO.println("[line " + this.current_line() + ", col " + this.current_col() + "] Error: " + message)
        if (this.source.length() > 0) {
            var line_num: Float = this.current_line_num()
            var lines: List<String> = this.source.split("\n")
            if (line_num > 0 and line_num <= lines.length()) {
                var src_line: String = lines[line_num - 1]
                var prefix: String = "  " + line_num.floor().to_string() + " | "
                IO.println(prefix + src_line)
                var col: Float = match (this.current()) { Token(kind, line, col) => col }
                var padding: String = ""
                var pi: Float = 0
                while (pi < prefix.length() + col - 1) {
                    padding = padding + " "
                    pi = pi + 1
                }
                IO.println(padding + "^")
            }
        }
        this.had_error = true
    }

    fun consume(expected: String) {
        if (!this.match_kind(expected)) {
            var found: String = this.current_token_str()
            this.parse_error("expected '" + expected + "' but found '" + found + "'")
        }
    }

    // --- Type annotations ---

    fun parse_type(): String {
        var name: String = this.parse_single_type()
        // Nullable shorthand: String? is preserved as-is (not desugared to String|Nil)
        // The codegen/checker interprets ? suffix as nullable when needed.
        // Union types: String | Nil, Int | String | Nil
        while (this.match_kind("|")) {
            var next: String = this.parse_single_type()
            name = name + "|" + next
        }
        return name
    }

    fun parse_single_type(): String {
        // Parenthesized types: function type or tuple type
        if (this.match_kind_check("(")) {
            this.advance()
            var inner_types: List<String> = []
            if (!this.match_kind_check(")")) {
                inner_types.push(this.parse_type())
                while (this.match_kind(",")) {
                    inner_types.push(this.parse_type())
                }
            }
            this.consume(")")
            if (this.match_kind_check("=>")) {
                // Function type: (ParamType, ...) => ReturnType
                this.advance()
                var fun_type: String = "Fun("
                var fi: Float = 0
                while (fi < inner_types.length()) {
                    if (fi > 0) { fun_type = fun_type + "," }
                    fun_type = fun_type + inner_types[fi]
                    fi = fi + 1
                }
                fun_type = fun_type + "):" + this.parse_type()
                return fun_type
            }
            // Tuple type: (Int, String) => "Tuple<Int,String>"
            var tuple_type: String = "Tuple<"
            var ti: Float = 0
            while (ti < inner_types.length()) {
                if (ti > 0) { tuple_type = tuple_type + "," }
                tuple_type = tuple_type + inner_types[ti]
                ti = ti + 1
            }
            tuple_type = tuple_type + ">"
            return tuple_type
        }
        var name: String = this.expect_ident()
        // Handle dotted types: Lexer.TokenKind, AST.Stmt, etc.
        // Also detect receiver function types: Type.() => Ret or Type.(Params) => Ret
        while (this.match_kind(".")) {
            // Check for receiver function type: Name.(params) => Ret
            if (this.match_kind_check("(")) {
                // Peek: save pos, scan for matching ), check if followed by =>
                var save_pos: Float = this.pos
                this.advance() // consume (
                // Skip tokens until matching )
                var paren_depth: Float = 1
                while (paren_depth > 0 and !this.match_kind_check("eof")) {
                    if (this.match_kind_check("(")) {
                        paren_depth = paren_depth + 1
                    } else if (this.match_kind_check(")")) {
                        paren_depth = paren_depth - 1
                        if (paren_depth > 0) { this.advance() }
                    } else {
                        this.advance()
                    }
                }
                // Now we should be at )
                var found_arrow: Bool = false
                if (this.match_kind_check(")")) {
                    this.advance() // consume )
                    if (this.match_kind_check("=>")) {
                        found_arrow = true
                    }
                }
                // Restore position and parse properly if it's a receiver type
                this.pos = save_pos
                if (found_arrow) {
                    // Parse receiver function type: Name.(ParamTypes) => RetType
                    this.advance() // consume (
                    var recv_params: List<String> = []
                    if (!this.match_kind_check(")")) {
                        recv_params.push(this.parse_type())
                        while (this.match_kind(",")) {
                            recv_params.push(this.parse_type())
                        }
                    }
                    this.consume(")")
                    this.consume("=>")
                    var recv_ret: String = this.parse_type()
                    // Encode as "Fun[ReceiverType](params):Ret"
                    var recv_type: String = "Fun[" + name + "]("
                    var rpi: Float = 0
                    while (rpi < recv_params.length()) {
                        if (rpi > 0) { recv_type = recv_type + "," }
                        recv_type = recv_type + recv_params[rpi]
                        rpi = rpi + 1
                    }
                    recv_type = recv_type + "):" + recv_ret
                    return recv_type
                }
                // Not a receiver type — continue as dotted name
                // The . was already consumed by match_kind, expect ident
            }
            var part: String = this.expect_ident()
            name = name + "." + part
        }
        // Generic args: collect tokens between < > respecting depth
        // Produces "Map<String,Number>" or "List<Map<String,Number>>"
        if (this.match_kind_check("<")) {
            this.advance()
            var args: String = ""
            var depth: Float = 1
            while (depth > 0 and !this.match_kind_check("eof")) {
                if (this.match_kind_check("<")) {
                    args = args + "<"
                    depth = depth + 1
                    this.advance()
                } else if (this.match_kind_check(">")) {
                    depth = depth - 1
                    if (depth > 0) {
                        args = args + ">"
                    }
                    this.advance()
                } else if (this.match_kind_check(">>")) {
                    depth = depth - 2
                    if (depth > 0) {
                        args = args + ">>"
                    } else if (depth == 0) {
                        args = args + ">"
                    }
                    this.advance()
                } else if (this.match_kind_check(",")) {
                    args = args + ","
                    this.advance()
                } else if (this.match_kind_check("ident")) {
                    var part: String = this.expect_ident()
                    args = args + part
                } else if (this.match_kind_check(".")) {
                    args = args + "."
                    this.advance()
                } else if (this.match_kind_check("|")) {
                    args = args + "|"
                    this.advance()
                } else if (this.match_kind_check("(")) {
                    args = args + "("
                    this.advance()
                } else if (this.match_kind_check(")")) {
                    args = args + ")"
                    this.advance()
                } else if (this.match_kind_check("=>")) {
                    args = args + "=>"
                    this.advance()
                } else if (this.match_kind_check(":")) {
                    args = args + ":"
                    this.advance()
                } else if (this.match_kind_check("?")) {
                    args = args + "?"
                    this.advance()
                } else {
                    this.advance()
                }
            }
            name = name + "<" + args + ">"
        }
        return name
    }

    // --- Expressions (Pratt parser) ---

    fun parse_expr(): AST.Expr {
        return this.parse_or()
    }

    fun parse_or(): AST.Expr {
        var left: AST.Expr = this.parse_and()
        while (this.match_kind_check("or")) {
            this.advance()
            var right: AST.Expr = this.parse_and()
            left = AST.Expr.Logical(left, "or", right)
        }
        return left
    }

    fun parse_and(): AST.Expr {
        var left: AST.Expr = this.parse_equality()
        while (this.match_kind_check("and")) {
            this.advance()
            var right: AST.Expr = this.parse_equality()
            left = AST.Expr.Logical(left, "and", right)
        }
        return left
    }

    fun parse_equality(): AST.Expr {
        var left: AST.Expr = this.parse_comparison()
        while (this.is_equality_op()) {
            var op: String = this.get_op_string()
            this.advance()
            var right: AST.Expr = this.parse_comparison()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_comparison(): AST.Expr {
        var left: AST.Expr = this.parse_bitwise_or()
        while (this.is_comparison_op()) {
            var op: String = this.get_op_string()
            this.advance()
            var right: AST.Expr = this.parse_bitwise_or()
            left = AST.Expr.Binary(left, op, right)
        }
        if (this.match_kind_check("is") and this.current_line_num() == this.prev_line_num()) {
            this.advance()
            var type_name: String = this.expect_ident()
            left = AST.Expr.IsCheck(left, type_name)
        }
        return left
    }

    fun parse_bitwise_or(): AST.Expr {
        var left: AST.Expr = this.parse_bitwise_xor()
        while (this.match_kind_check("|")) {
            this.advance()
            var right: AST.Expr = this.parse_bitwise_xor()
            left = AST.Expr.Binary(left, "|", right)
        }
        return left
    }

    fun parse_bitwise_xor(): AST.Expr {
        var left: AST.Expr = this.parse_bitwise_and()
        while (this.match_kind_check("^")) {
            this.advance()
            var right: AST.Expr = this.parse_bitwise_and()
            left = AST.Expr.Binary(left, "^", right)
        }
        return left
    }

    fun parse_bitwise_and(): AST.Expr {
        var left: AST.Expr = this.parse_shift()
        while (this.match_kind_check("&")) {
            this.advance()
            var right: AST.Expr = this.parse_shift()
            left = AST.Expr.Binary(left, "&", right)
        }
        return left
    }

    fun parse_shift(): AST.Expr {
        var left: AST.Expr = this.parse_term()
        while (this.is_shift_op()) {
            var op: String = this.get_op_string()
            this.advance()
            var right: AST.Expr = this.parse_term()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_term(): AST.Expr {
        var left: AST.Expr = this.parse_factor()
        while (this.is_term_op()) {
            var op: String = this.get_op_string()
            this.advance()
            var right: AST.Expr = this.parse_factor()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_factor(): AST.Expr {
        var left: AST.Expr = this.parse_unary()
        while (this.is_factor_op()) {
            var op: String = this.get_op_string()
            this.advance()
            var right: AST.Expr = this.parse_unary()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_unary(): AST.Expr {
        if (this.match_kind_check("-")) {
            this.advance()
            var right: AST.Expr = this.parse_unary()
            return AST.Expr.Unary("-", right)
        }
        if (this.match_kind_check("!")) {
            this.advance()
            var right: AST.Expr = this.parse_unary()
            return AST.Expr.Unary("!", right)
        }
        if (this.match_kind_check("~")) {
            this.advance()
            var right: AST.Expr = this.parse_unary()
            return AST.Expr.Unary("~", right)
        }
        return this.parse_call()
    }

    fun parse_call(): AST.Expr {
        var expr: AST.Expr = this.parse_primary()

        while (true) {
            if (this.match_kind_check(".")) {
                this.advance()
                // Numeric dot access: tuple.0, tuple.1
                if (this.match_kind_check("int")) {
                    var idx_kind: Lexer.TokenKind = this.current_kind()
                    var idx_val: Float = match (idx_kind) { TkInt(v) => v   _ => 0 }
                    this.advance()
                    expr = AST.Expr.IndexGet(expr, AST.Expr.IntLit(idx_val))
                    continue
                }
                var field: String = this.expect_ident()
                if (this.match_kind_check("(")) {
                    // Method call: obj.method(args)
                    this.advance()
                    var args: List<AST.Expr> = []
                    if (!this.match_kind_check(")")) {
                        args.push(this.parse_call_arg())
                        while (this.match_kind(",")) {
                            args.push(this.parse_call_arg())
                        }
                        this.consume(")")
                    } else {
                        this.advance()
                    }
                    // Trailing closure: obj.method(args) { ... }
                    if (this.match_kind_check("{")) {
                        args.push(this.parse_trailing_closure())
                    }
                    expr = AST.Expr.MethodCall(expr, field, args)
                } else {
                    expr = AST.Expr.MemberAccess(expr, field)
                }
            } else if (this.match_kind_check("[")) {
                // Index access: obj[expr]
                this.advance()
                var idx: AST.Expr = this.parse_expr()
                this.consume("]")
                expr = AST.Expr.IndexGet(expr, idx)
            } else if (this.match_kind_check("(")) {
                this.advance()
                var args: List<AST.Expr> = []
                if (!this.match_kind_check(")")) {
                    args.push(this.parse_call_arg())
                    while (this.match_kind(",")) {
                        args.push(this.parse_call_arg())
                    }
                    this.consume(")")
                } else {
                    this.advance()
                }
                // Trailing closure: func(args) { ... }
                if (this.match_kind_check("{")) {
                    args.push(this.parse_trailing_closure())
                }
                expr = AST.Expr.Call(expr, args)
            } else if (this.match_kind_check("{") and this.current_line_num() == this.prev_line_num()) {
                // Paren-free trailing closure: ident { ... } → ident(fun () { ... })
                var is_callable: String = match (expr) {
                    Variable(n) => "yes"
                    MemberAccess(o, f) => "yes"
                    _ => "no"
                }
                if (is_callable == "yes") {
                    var tc_args: List<AST.Expr> = [this.parse_trailing_closure()]
                    expr = AST.Expr.Call(expr, tc_args)
                } else {
                    break
                }
            } else {
                break
            }
        }

        return expr
    }

    fun parse_primary(): AST.Expr {
        // yield / yield [reason, arg]
        if (this.match_kind_check("yield") or this.is_ident_named("yield")) {
            this.advance()
            if (this.match_kind_check("[")) {
                var yval: AST.Expr = this.parse_expr()
                return AST.Expr.Yield(yval)
            }
            return AST.Expr.Yield(AST.Expr.NilLit)
        }
        // HTML fragment: <>children</>
        if (this.match_kind_check("<") and this.peek_is(">")) {
            return this.parse_html_fragment()
        }
        // HTML element expression: <tag attrs...>children</tag>
        if (this.match_kind_check("<") and this.peek_is_html_start()) {
            return this.parse_html_element()
        }
        if (this.match_kind_check("if")) {
            return this.parse_if_expr()
        }
        if (this.match_kind_check("try")) {
            return this.parse_try_expr()
        }
        if (this.match_kind_check("match")) {
            return this.parse_match_expr()
        }
        if (this.match_kind_check("fun")) {
            return this.parse_lambda()
        }
        if (this.match_kind_check("this")) {
            this.advance()
            return AST.Expr.This
        }
        if (this.is_ident_named("super")) {
            this.advance()
            return AST.Expr.Variable("super")
        }
        if (this.match_kind_check("[")) {
            return this.parse_list_lit()
        }
        if (this.match_kind_check("{")) {
            this.advance()
            if (this.match_kind_check("}")) {
                // Empty map literal: {}
                this.advance()
                return AST.Expr.MapLit
            }
            // Kotlin-style lambda: { x => body } or { x, y => body }
            // Save pos before consuming ident so we can restore on mismatch
            var kl_before: Float = this.pos
            if (this.match_kind_check("ident")) {
                var kl_name: String = this.expect_ident()
                if (this.match_kind("=>")) {
                    var lparams: List<AST.Param> = []
                    IO.println("[KL-PATH]"); lparams.push(AST.Param.Param(kl_name, AST.Type.AnyType, AST.Expr.NilLit))
                    var lbody: List<AST.Stmt> = []
                    while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                        while (this.match_kind(";")) {}
                        if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                            break
                        }
                        lbody.push(this.parse_stmt())
                    }
                    this.consume("}")
                    if (lbody.length() > 0) {
                        var klast: AST.Stmt = lbody[lbody.length() - 1]
                        var kis_expr: Bool = match (klast) {
                            ExprStmt(e) => true
                            _ => false
                        }
                        if (kis_expr) {
                            var kexpr: AST.Expr = match (klast) { ExprStmt(e) => e }
                            lbody[lbody.length() - 1] = AST.Stmt.Return(kexpr)
                        }
                    }
                    return AST.Expr.Lambda(lparams, "Any", lbody)
                } else if (this.match_kind(",")) {
                    var lparams: List<AST.Param> = []
                    lparams.push(AST.Param.Param(kl_name, AST.Type.AnyType, AST.Expr.NilLit))
                    var lpname: String = this.expect_ident()
                    lparams.push(AST.Param.Param(lpname, AST.Type.AnyType, AST.Expr.NilLit))
                    while (this.match_kind(",")) {
                        lpname = this.expect_ident()
                        lparams.push(AST.Param.Param(lpname, AST.Type.AnyType, AST.Expr.NilLit))
                    }
                    this.consume("=>")
                    var lbody: List<AST.Stmt> = []
                    while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                        while (this.match_kind(";")) {}
                        if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                            break
                        }
                        lbody.push(this.parse_stmt())
                    }
                    this.consume("}")
                    if (lbody.length() > 0) {
                        var klast: AST.Stmt = lbody[lbody.length() - 1]
                        var kis_expr: Bool = match (klast) {
                            ExprStmt(e) => true
                            _ => false
                        }
                        if (kis_expr) {
                            var kexpr: AST.Expr = match (klast) { ExprStmt(e) => e }
                            lbody[lbody.length() - 1] = AST.Stmt.Return(kexpr)
                        }
                    }
                    return AST.Expr.Lambda(lparams, "Any", lbody)
                } else {
                    this.pos = kl_before
                }
            }
            // Check for map literal: { "key": value, ... } or { ident: value, ... }
            if ((this.match_kind_check("string") or this.match_kind_check("ident")) and this.peek_is(":")) {
                // Parse as map literal — desugar to BlockExpr that builds the map
                var map_stmts: List<AST.Stmt> = []
                map_stmts.push(AST.Stmt.VarDecl("__map", "Map", AST.Expr.MapLit, ""))
                // First entry
                var key: AST.Expr = this.parse_primary()
                this.consume(":")
                var value: AST.Expr = this.parse_expr()
                map_stmts.push(AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.Variable("__map"), "set", [key, value])))
                while (this.match_kind(",")) {
                    if (this.match_kind_check("}")) { break }
                    var k: AST.Expr = this.parse_primary()
                    this.consume(":")
                    var v: AST.Expr = this.parse_expr()
                    map_stmts.push(AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.Variable("__map"), "set", [k, v])))
                }
                this.consume("}")
                return AST.Expr.BlockExpr(map_stmts, AST.Expr.Variable("__map"))
            }
            // Block expression: { stmts...; expr }
            var block_stmts: List<AST.Stmt> = []
            while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                block_stmts.push(this.parse_stmt())
            }
            this.consume("}")
            // The last statement becomes the value expression if it's an ExprStmt
            // or an If with else (value-producing if/else)
            if (block_stmts.length() > 0) {
                var last: AST.Stmt = block_stmts[block_stmts.length() - 1]
                var is_value_producing: Bool = this.is_value_stmt(last)
                if (is_value_producing) {
                    var last_kind: AST.Expr = this.stmt_to_expr(last)
                    block_stmts.pop()
                    return AST.Expr.BlockExpr(block_stmts, last_kind)
                }
                return AST.Expr.BlockExpr(block_stmts, AST.Expr.NilLit)
            }
            return AST.Expr.BlockExpr([], AST.Expr.NilLit)
        }

        var kind: Lexer.TokenKind = this.current_kind()
        this.advance()

        return match (kind) {
            TkInt(v) => AST.Expr.IntLit(v)
            TkFloat(v) => AST.Expr.FloatLit(v)
            TkTrue => AST.Expr.BoolLit(true)
            TkFalse => AST.Expr.BoolLit(false)
            TkNil => AST.Expr.NilLit
            TkString(s) => AST.Expr.StringLit(s)
            TkIdent(name) => AST.Expr.Variable(name)
            TkLParen => {
                var expr: AST.Expr = this.parse_expr()
                if (this.match_kind(",")) {
                    var elems: List<AST.Expr> = [expr]
                    if (!this.match_kind_check(")")) {
                        elems.push(this.parse_expr())
                        while (this.match_kind(",")) {
                            if (this.match_kind_check(")")) { break }
                            elems.push(this.parse_expr())
                        }
                    }
                    this.consume(")")
                    AST.Expr.TupleLit(elems)
                } else {
                    this.consume(")")
                    expr
                }
            }
        }
    }

    fun parse_list_lit(): AST.Expr {
        this.advance() // consume [
        var elements: List<AST.Expr> = []
        if (!this.match_kind_check("]")) {
            elements.push(this.parse_expr())
            while (this.match_kind(",")) {
                if (this.match_kind_check("]")) { break }
                elements.push(this.parse_expr())
            }
        }
        this.consume("]")
        return AST.Expr.ListLit(elements)
    }

    fun parse_match_expr(): AST.Expr {
        this.advance() // consume match
        this.consume("(")
        var subject: AST.Expr = this.parse_expr()
        this.consume(")")
        this.consume("{")
        var arms: List<AST.MatchArm> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            var pattern: AST.Pattern = this.parse_pattern()
            this.consume("=>")
            var body: AST.Expr = this.parse_expr()
            arms.push(AST.MatchArm.Arm(pattern, body))
            this.match_kind(",")
        }
        this.consume("}")
        return AST.Expr.Match(subject, arms)
    }

    fun parse_if_expr(): AST.Expr {
        this.advance() // consume if
        this.consume("(")
        var cond: AST.Expr = this.parse_expr()
        this.consume(")")
        var then_stmts: List<AST.Stmt> = []
        var then_val: AST.Expr = AST.Expr.NilLit
        if (this.match_kind_check("{")) {
            this.advance()
            while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                while (this.match_kind(";")) {}
                if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
                then_stmts.push(this.parse_stmt())
            }
            this.consume("}")
            if (then_stmts.length() > 0) {
                var last: AST.Stmt = then_stmts[then_stmts.length() - 1]
                if (this.is_value_stmt(last)) {
                    then_val = this.stmt_to_expr(last)
                    then_stmts.pop()
                }
            }
        } else {
            then_val = this.parse_expr()
        }
        if (!this.match_kind("else")) {
            this.parse_error("if-expression requires an else branch")
        }
        var else_stmts: List<AST.Stmt> = []
        var else_val: AST.Expr = AST.Expr.NilLit
        if (this.match_kind_check("if")) {
            else_val = this.parse_if_expr()
        } else if (this.match_kind_check("{")) {
            this.advance()
            while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                while (this.match_kind(";")) {}
                if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
                else_stmts.push(this.parse_stmt())
            }
            this.consume("}")
            if (else_stmts.length() > 0) {
                var last: AST.Stmt = else_stmts[else_stmts.length() - 1]
                if (this.is_value_stmt(last)) {
                    else_val = this.stmt_to_expr(last)
                    else_stmts.pop()
                }
            }
        } else {
            else_val = this.parse_expr()
        }
        return AST.Expr.IfExpr(cond, then_stmts, then_val, else_stmts, else_val)
    }

    fun parse_try_expr(): AST.Expr {
        this.advance() // consume try
        this.consume("{")
        var try_stmts: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
            try_stmts.push(this.parse_stmt())
        }
        this.consume("}")
        // Extract last statement as value expression
        var try_val: AST.Expr = AST.Expr.NilLit
        if (try_stmts.length() > 0) {
            var last: AST.Stmt = try_stmts[try_stmts.length() - 1]
            if (this.is_value_stmt(last)) {
                try_val = this.stmt_to_expr(last)
                try_stmts.pop()
            }
        }
        this.consume("catch")
        this.consume("(")
        var catch_name: String = this.expect_ident()
        this.consume(")")
        this.consume("{")
        var catch_stmts: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
            catch_stmts.push(this.parse_stmt())
        }
        this.consume("}")
        var catch_val: AST.Expr = AST.Expr.NilLit
        if (catch_stmts.length() > 0) {
            var last: AST.Stmt = catch_stmts[catch_stmts.length() - 1]
            if (this.is_value_stmt(last)) {
                catch_val = this.stmt_to_expr(last)
                catch_stmts.pop()
            }
        }
        return AST.Expr.TryExpr(try_stmts, try_val, catch_name, catch_stmts, catch_val)
    }

    fun parse_pattern(): AST.Pattern {
        // Optional 'is' prefix: is Ready(u) => ...
        this.match_kind("is")
        // Handle literal patterns: 0, 1, "hello", etc.
        if (this.match_kind_check("int") or this.match_kind_check("float")) {
            var kind: Lexer.TokenKind = this.current_kind()
            this.advance()
            var lit_val: String = match (kind) {
                TkInt(v) => v.floor().to_string()
                TkFloat(v) => v.to_string()
                _ => "0"
            }
            return AST.Pattern.VariantPattern(lit_val, [])
        }
        if (this.match_kind_check("string")) {
            var kind: Lexer.TokenKind = this.current_kind()
            this.advance()
            var str_val: String = match (kind) {
                TkString(s) => s
                _ => ""
            }
            return AST.Pattern.VariantPattern("__strpat:" + str_val, [])
        }
        var name: String = this.expect_ident()
        if (this.match_kind("(")) {
            var bindings: List<String> = []
            if (!this.match_kind_check(")")) {
                bindings.push(this.expect_ident())
                while (this.match_kind(",")) {
                    bindings.push(this.expect_ident())
                }
            }
            this.consume(")")
            return AST.Pattern.VariantPattern(name, bindings)
        }
        return AST.Pattern.VariantPattern(name, [])
    }

    // --- Type string to AST.Type conversion ---

    fun parse_type_ast(s: String): AST.Type {
        if (s == "Int" or s == "Number") return AST.Type.IntType
        if (s == "Float") return AST.Type.FloatType
        if (s == "Bool") return AST.Type.BoolType
        if (s == "String") return AST.Type.StringType
        if (s == "Nil") return AST.Type.NilType
        if (s == "Any") return AST.Type.AnyType
        // Union: "String|Nil" or "Int|String"
        if (s.contains("|")) {
            var parts: List<String> = s.split("|")
            var types: List<AST.Type> = []
            var i: Float = 0
            while (i < parts.length()) {
                types.push(this.parse_type_ast(parts[i]))
                i = i + 1
            }
            return AST.Type.UnionType(types)
        }
        // Generic: "List<String>" or "Map<String,Number>"
        if (s.contains("<")) {
            var lt_pos: Float = 0
            var i: Float = 0
            while (i < s.length()) {
                if (s.char_at(i) == "<") {
                    lt_pos = i
                    i = s.length()
                }
                i = i + 1
            }
            var base: String = s.slice(0, lt_pos)
            var args_str: String = s.slice(lt_pos + 1, s.length() - 1)
            var arg_strs: List<String> = this.split_type_args(args_str)
            var args: List<AST.Type> = []
            var j: Float = 0
            while (j < arg_strs.length()) {
                args.push(this.parse_type_ast(arg_strs[j]))
                j = j + 1
            }
            return AST.Type.GenericType(base, args)
        }
        // Function type: "Fun(...):Ret"
        if (s.starts_with("Fun(")) {
            return AST.Type.FuncType([], AST.Type.AnyType)
        }
        // Receiver function type: "Fun[Type](...):Ret"
        if (s.starts_with("Fun[")) {
            return AST.Type.ClassType(s)
        }
        // Class/Enum type
        return AST.Type.ClassType(s)
    }

    fun type_ast_to_string(t: AST.Type): String {
        return match (t) {
            IntType => "Int"
            FloatType => "Float"
            BoolType => "Bool"
            StringType => "String"
            NilType => "Nil"
            AnyType => "Any"
            ClassType(n) => n
            EnumType(n) => n
            GenericType(base, args) => base
            UnionType(types) => "Union"
            FuncType(p, r) => "Fun"
            NullableType(inner) => "Nullable"
        }
    }

    fun split_type_args(s: String): List<String> {
        var args: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "," and depth == 0) {
                args.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            args.push(current)
        }
        return args
    }

    // --- Helpers for operator precedence ---

    fun parse_lambda(): AST.Expr {
        this.advance() // consume fun
        this.consume("(")
        var params: List<AST.Param> = []
        if (!this.match_kind_check(")")) {
            var pname: String = this.expect_ident()
            if (!this.match_kind_check(":")) {
                this.parse_error("Parameter '" + pname + "' requires a type annotation")
                params.push(AST.Param.Param(pname, AST.Type.AnyType, AST.Expr.NilLit))
            } else {
                this.consume(":")
                var ptype: String = this.parse_type()
                var pdefault: AST.Expr = AST.Expr.NilLit
                if (this.match_kind("=")) { pdefault = this.parse_expr() }
                params.push(AST.Param.Param(pname, this.parse_type_ast(ptype), pdefault))
            }
            while (this.match_kind(",")) {
                pname = this.expect_ident()
                if (!this.match_kind_check(":")) {
                    this.parse_error("Parameter '" + pname + "' requires a type annotation")
                    params.push(AST.Param.Param(pname, AST.Type.AnyType, AST.Expr.NilLit))
                } else {
                    this.consume(":")
                    var ptype: String = this.parse_type()
                    var pdefault: AST.Expr = AST.Expr.NilLit
                    if (this.match_kind("=")) { pdefault = this.parse_expr() }
                    params.push(AST.Param.Param(pname, this.parse_type_ast(ptype), pdefault))
                }
            }
        }
        this.consume(")")
        var ret_type: String = "Int"
        if (this.match_kind(":")) {
            ret_type = this.parse_type()
        }
        if (this.match_kind("=>")) {
            // Short form: fun (x: Int) => expr
            var expr: AST.Expr = this.parse_expr()
            return AST.Expr.Lambda(params, ret_type, [AST.Stmt.Return(expr)])
        }
        // Block form: fun (x: Int) { ... }
        var body: List<AST.Stmt> = this.parse_block_stmts()
        return AST.Expr.Lambda(params, ret_type, body)
    }

    fun is_ident_named(name: String): Bool {
        if (!this.match_kind_check("ident")) return false
        var kind: Lexer.TokenKind = this.current_kind()
        var ident_name: String = match (kind) { TkIdent(n) => n }
        return ident_name == name
    }

    fun match_kind_check(expected: String): Bool {
        var kind: Lexer.TokenKind = this.current_kind()
        var name: String = this.kind_name(kind)
        return name == expected
    }

    fun kind_name(kind: Lexer.TokenKind): String {
        return match (kind) {
            TkPlus => "+"
            TkMinus => "-"
            TkStar => "*"
            TkSlash => "/"
            TkPercent => "%"
            TkAmpersand => "&"
            TkPipe => "|"
            TkCaret => "^"
            TkTilde => "~"
            TkShiftLeft => "<<"
            TkShiftRight => ">>"
            TkBang => "!"
            TkBangEq => "!="
            TkEqEq => "=="
            TkLt => "<"
            TkLtEq => "<="
            TkGt => ">"
            TkGtEq => ">="
            TkLParen => "("
            TkRParen => ")"
            TkLBrace => "{"
            TkRBrace => "}"
            TkLBracket => "["
            TkRBracket => "]"
            TkDot => "."
            TkComma => ","
            TkColon => ":"
            TkSemicolon => ";"
            TkEq => "="
            TkArrow => "->"
            TkFatArrow => "=>"
            TkQuestion => "?"
            TkVar => "var"
            TkLet => "let"
            TkFun => "fun"
            TkReturn => "return"
            TkIf => "if"
            TkElse => "else"
            TkWhile => "while"
            TkOr => "or"
            TkAnd => "and"
            TkTrue => "true"
            TkFalse => "false"
            TkNil => "nil"
            TkImport => "import"
            TkAs => "as"
            TkEnum => "enum"
            TkMatch => "match"
            TkClass => "class"
            TkThis => "this"
            TkFor => "for"
            TkIn => "in"
            TkTry => "try"
            TkCatch => "catch"
            TkThrow => "throw"
            TkFinally => "finally"
            TkIs => "is"
            TkYield => "yield"
            TkEof => "eof"
            TkInt(v) => "int"
            TkFloat(v) => "float"
            TkString(v) => "string"
            TkIdent(v) => "ident"
            TkDocComment(t) => "doc_comment"
            TkModuleDoc(t) => "module_doc"
            TkNewline => "newline"
        }
    }

    fun is_equality_op(): Bool {
        return this.match_kind_check("==") or this.match_kind_check("!=")
    }

    fun is_comparison_op(): Bool {
        if (this.html_depth > 0) { return false }
        if (this.match_kind_check("<")) {
            if (this.peek_is(">") or this.peek_is("/")) { return false }
            if (this.peek_is("ident") and this.is_html_open_at(this.pos + 1)) { return false }
            return true
        }
        return this.match_kind_check("<=") or
               this.match_kind_check(">") or this.match_kind_check(">=")
    }

    fun is_html_open_at(ident_pos: Float): Bool {
        // Check if ident at ident_pos is the start of an HTML element (not a comparison RHS).
        // HTML: <tag>, <tag/>, <tag attr=...>, <Tag> (component)
        // Comparison: <expr.method(), <expr), <expr + ...
        if (ident_pos + 1 >= this.tokens.length()) { return false }
        var next_tok: Lexer.Token = this.tokens[ident_pos + 1]
        var next_kind: Lexer.TokenKind = match (next_tok) { Token(k, l, c) => k }
        var next_str: String = this.kind_name(next_kind)
        // After a tag name: >, />, or attribute name (ident), or = (shorthand)
        if (next_str == ">" or next_str == "/" or next_str == "ident" or next_str == "=") { return true }
        // Keywords that are valid attribute names (cls, for, in, is)
        if (next_str == "class" or next_str == "for" or next_str == "in" or next_str == "is") { return true }
        return false
    }

    fun is_shift_op(): Bool {
        return this.match_kind_check("<<") or this.match_kind_check(">>")
    }

    fun is_term_op(): Bool {
        return this.match_kind_check("+") or this.match_kind_check("-")
    }

    fun is_factor_op(): Bool {
        return this.match_kind_check("*") or this.match_kind_check("/") or this.match_kind_check("%")
    }

    fun get_op_string(): String {
        var kind: Lexer.TokenKind = this.current_kind()
        return match (kind) {
            TkPlus => "+"
            TkMinus => "-"
            TkStar => "*"
            TkSlash => "/"
            TkPercent => "%"
            TkAmpersand => "&"
            TkPipe => "|"
            TkCaret => "^"
            TkShiftLeft => "<<"
            TkShiftRight => ">>"
            TkBangEq => "!="
            TkEqEq => "=="
            TkLt => "<"
            TkLtEq => "<="
            TkGt => ">"
            TkGtEq => ">="
        }
    }

    // --- Docstring collection ---

    fun collect_doc_comments(): String {
        var parts: List<String> = []
        while (this.match_kind_check("doc_comment")) {
            var kind: Lexer.TokenKind = this.current_kind()
            var text: String = match (kind) {
                TkDocComment(t) => t
            }
            this.advance()
            parts.push(text)
        }
        if (parts.length() == 0) return ""
        return parts.join("\n")
    }

    fun collect_module_doc(): String {
        var parts: List<String> = []
        while (this.match_kind_check("module_doc")) {
            var kind: Lexer.TokenKind = this.current_kind()
            var text: String = match (kind) {
                TkModuleDoc(t) => t
            }
            this.advance()
            parts.push(text)
        }
        if (parts.length() == 0) return ""
        return parts.join("\n")
    }

    // --- Statements ---

    fun parse_program(): List<AST.Stmt> {
        // Collect leading //! module doc comments
        var module_doc: String = this.collect_module_doc()
        var stmts: List<AST.Stmt> = []
        while (!this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("eof")) { return stmts }
            stmts.push(this.parse_stmt())
        }
        return stmts
    }

    fun parse_stmt(): AST.Stmt {
        // Collect /// doc comments before declarations
        var docstring: String = this.collect_doc_comments()

        // Type aliases: type Name = TargetType
        if (this.is_ident_named("type")) {
            this.advance()
            var alias_name: String = this.expect_ident()
            this.consume("=")
            var alias_target: String = this.parse_type()
            return AST.Stmt.VarDecl(alias_name, alias_target, AST.Expr.NilLit, "@type_alias")
        }

        // Extension methods: extend fun ClassName.method(params): RetType { body }
        if (this.is_ident_named("extend")) {
            this.advance()
            this.advance()
            var ext_class: String = this.expect_ident()
            this.consume(".")
            var ext_method: String = this.expect_ident()
            this.consume("(")
            var ext_params: List<AST.Param> = []
            if (!this.match_kind_check(")")) {
                var pname: String = this.expect_ident()
                if (!this.match_kind_check(":")) {
                    this.parse_error("Parameter '" + pname + "' requires a type annotation")
                    ext_params.push(AST.Param.Param(pname, AST.Type.AnyType, AST.Expr.NilLit))
                } else {
                    this.consume(":")
                    var ptype: String = this.parse_type()
                    ext_params.push(AST.Param.Param(pname, this.parse_type_ast(ptype), AST.Expr.NilLit))
                }
                while (this.match_kind(",")) {
                    pname = this.expect_ident()
                    if (!this.match_kind_check(":")) {
                        this.parse_error("Parameter '" + pname + "' requires a type annotation")
                        ext_params.push(AST.Param.Param(pname, AST.Type.AnyType, AST.Expr.NilLit))
                    } else {
                        this.consume(":")
                        var ptype: String = this.parse_type()
                        ext_params.push(AST.Param.Param(pname, this.parse_type_ast(ptype), AST.Expr.NilLit))
                    }
                }
            }
            this.consume(")")
            var ext_ret: String = "Nil"
            if (this.match_kind(":")) {
                ext_ret = this.parse_type()
            }
            var ext_body: List<AST.Stmt> = []
            if (this.match_kind_check("{")) {
                ext_body = this.parse_block_stmts()
            }
            return AST.Stmt.FunDecl(ext_method, ext_params, ext_ret, ext_body, "@extend:" + ext_class)
        }

        // Check for decorator: @intrinsic, @extern("..."), or general @name / @name("...")
        if (this.is_ident_named("@")) {
            this.advance()
            var decorator: String = this.expect_ident()
            var annotation: String = ""
            if (decorator == "intrinsic") {
                annotation = "@intrinsic"
            } else if (decorator == "extern") {
                this.consume("(")
                var kind: Lexer.TokenKind = this.current_kind()
                var sig: String = match (kind) { TkString(s) => s }
                this.advance()
                this.consume(")")
                annotation = "@extern:" + sig
            } else {
                // General decorator: @name or @name("args")
                annotation = "@" + decorator
                if (this.match_kind_check("(")) {
                    this.advance()
                    if (this.match_kind_check("string")) {
                        var darg_kind: Lexer.TokenKind = this.current_kind()
                        var darg: String = match (darg_kind) { TkString(s) => s }
                        this.advance()
                        annotation = annotation + ":" + darg
                    }
                    this.consume(")")
                }
            }
            if (this.match_kind_check("class")) {
                return this.parse_class_decl_with_doc(annotation)
            }
            return this.parse_fun_decl_with_doc(annotation)
        }

        if (this.match_kind_check("var")) return this.parse_var_decl_with_doc(docstring)
        if (this.match_kind_check("let")) return this.parse_var_decl_with_doc(docstring)
        if (this.match_kind_check("fun") and !this.peek_is("(")) return this.parse_fun_decl_with_doc(docstring)
        if (this.match_kind_check("enum")) return this.parse_enum_decl_with_doc(docstring)
        if (this.match_kind_check("class")) return this.parse_class_decl_with_doc(docstring)
        if (this.is_ident_named("interface")) return this.parse_class_decl_with_doc(docstring)
        if (this.match_kind_check("import")) return this.parse_import()
        if (this.match_kind_check("return")) return this.parse_return()
        if (this.match_kind_check("if")) return this.parse_if()
        if (this.match_kind_check("while")) return this.parse_while()
        if (this.match_kind_check("for")) return this.parse_for()
        if (this.match_kind_check("try")) return this.parse_try()
        if (this.match_kind_check("throw")) return this.parse_throw()
        if (this.is_ident_named("break")) { this.advance(); return AST.Stmt.Break }
        if (this.is_ident_named("continue")) { this.advance(); return AST.Stmt.Continue }
        if (this.match_kind_check("{")) return this.parse_block()
        // Check for assignment: ident = expr
        if (this.match_kind_check("ident") and this.peek_is("=")) {
            return this.parse_assign()
        }
        // Check for this.field = value
        if (this.match_kind_check("this")) {
            return this.parse_this_stmt()
        }
        // Check for index assignment: ident[expr] = value
        if (this.match_kind_check("ident") and this.peek_is("[")) {
            var obj_name: String = this.expect_ident()
            this.advance() // consume [
            var idx: AST.Expr = this.parse_expr()
            this.consume("]")
            if (this.match_kind("=")) {
                var value: AST.Expr = this.parse_expr()
                return AST.Stmt.ExprStmt(AST.Expr.IndexSet(
                    AST.Expr.Variable(obj_name), idx, value))
            }
            // Not an assignment — just index access as expression
            var get_expr: AST.Expr = AST.Expr.IndexGet(AST.Expr.Variable(obj_name), idx)
            return AST.Stmt.ExprStmt(get_expr)
        }
        // Default: expression statement (may be field assignment if followed by =)
        var expr: AST.Expr = this.parse_expr()
        if (this.match_kind("=")) {
            var value: AST.Expr = this.parse_expr()
            var ek: String = this.classify_expr_for_assign(expr)
            if (ek == "member") {
                var obj: AST.Expr = match (expr) { MemberAccess(o, f) => o
                    _ => AST.Expr.NilLit
                }
                var field: String = match (expr) { MemberAccess(o, f) => f
                    _ => ""
                }
                return AST.Stmt.ExprStmt(AST.Expr.SetField(obj, field, value))
            }
        }
        return AST.Stmt.ExprStmt(expr)
    }

    fun classify_expr_for_assign(expr: AST.Expr): String {
        return match (expr) {
            MemberAccess(o, f) => "member"
            _ => "other"
        }
    }

    fun peek_is(expected: String): Bool {
        if (this.pos + 1 >= this.tokens.length()) return false
        var next_tok: Lexer.Token = this.tokens[this.pos + 1]
        var next_kind: Lexer.TokenKind = match (next_tok) { Token(k, l, c) => k }
        return this.kind_name(next_kind) == expected
    }

    fun parse_call_arg(): AST.Expr {
        // Named argument: ident = expr (Kotlin-style)
        if (this.match_kind_check("ident") and this.peek_is("=")) {
            var arg_name: String = this.expect_ident()
            this.advance()
            var arg_val: AST.Expr = this.parse_expr()
            return AST.Expr.Assign(arg_name, arg_val)
        }
        return this.parse_expr()
    }

    fun parse_assign(): AST.Stmt {
        var name: String = this.expect_ident()
        this.consume("=")
        var value: AST.Expr = this.parse_expr()
        return AST.Stmt.ExprStmt(AST.Expr.Assign(name, value))
    }

    fun parse_var_decl(): AST.Stmt {
        return this.parse_var_decl_with_doc("")
    }

    fun parse_var_decl_with_doc(docstring: String): AST.Stmt {
        this.advance() // consume var/let
        // Check for array destructuring: let [a, b, c] = expr
        if (this.match_kind_check("[")) {
            return this.parse_destructure()
        }
        // Tuple destructuring: let (a, b) = expr
        if (this.match_kind_check("(")) {
            return this.parse_tuple_destructure()
        }
        var name: String = this.expect_ident()
        // Variant pattern: let Some(x) = expr
        if (this.match_kind_check("(")) {
            this.advance()
            var bindings: List<String> = []
            if (!this.match_kind_check(")")) {
                bindings.push(this.expect_ident())
                while (this.match_kind(",")) {
                    bindings.push(this.expect_ident())
                }
            }
            this.consume(")")
            this.consume("=")
            var pat_val: AST.Expr = this.parse_expr()
            return AST.Stmt.LetPattern(AST.Pattern.VariantPattern(name, bindings), pat_val)
        }
        var type_ann: String = "Any"
        if (this.match_kind(":")) {
            type_ann = this.parse_type()
        }
        this.consume("=")
        var init: AST.Expr = this.parse_expr()
        return AST.Stmt.VarDecl(name, type_ann, init, docstring)
    }

    fun parse_destructure(): AST.Stmt {
        this.advance() // consume [
        var names: List<String> = []
        var rest_name: String = ""
        if (!this.match_kind_check("]")) {
            if (this.match_kind("*")) {
                rest_name = this.expect_ident()
            } else {
                names.push(this.expect_ident())
            }
            while (this.match_kind(",")) {
                if (this.match_kind("*")) {
                    rest_name = this.expect_ident()
                } else {
                    names.push(this.expect_ident())
                }
            }
        }
        this.consume("]")
        this.consume("=")
        var init: AST.Expr = this.parse_expr()
        return AST.Stmt.LetPattern(AST.Pattern.ArrayPattern(names, rest_name), init)
    }

    fun parse_tuple_destructure(): AST.Stmt {
        this.advance() // consume (
        var names: List<String> = []
        if (!this.match_kind_check(")")) {
            names.push(this.expect_ident())
            while (this.match_kind(",")) {
                names.push(this.expect_ident())
            }
        }
        this.consume(")")
        this.consume("=")
        var init: AST.Expr = this.parse_expr()
        var stmts: List<AST.Stmt> = []
        var tmp_name: String = "__destruct"
        stmts.push(AST.Stmt.VarDecl(tmp_name, "Any", init, ""))
        var i: Float = 0
        while (i < names.length()) {
            var idx_expr: AST.Expr = AST.Expr.IndexGet(AST.Expr.Variable(tmp_name), AST.Expr.IntLit(i))
            stmts.push(AST.Stmt.VarDecl(names[i], "Any", idx_expr, ""))
            i = i + 1
        }
        return AST.Stmt.Block(stmts)
    }

    fun parse_fun_decl(): AST.Stmt {
        return this.parse_fun_decl_with_doc("")
    }

    fun parse_fun_decl_with_doc(docstring: String): AST.Stmt {
        this.advance() // consume fun
        var name: String = this.expect_ident()
        // Parse generic type parameters: fun foo<T>(...) or fun bar<K, V: Constraint>(...)
        // Encodes as "@generic:T,U:Constraint+Other\n" prefix in docstring
        if (this.match_kind_check("<")) {
            this.advance()
            var generic_str: String = ""
            var depth: Float = 1
            while (depth > 0 and !this.match_kind_check("eof")) {
                if (this.match_kind_check("<")) {
                    depth = depth + 1
                    this.advance()
                } else if (this.match_kind_check(">")) {
                    depth = depth - 1
                    if (depth > 0) {
                        generic_str = generic_str + ">"
                    }
                    this.advance()
                } else if (this.match_kind_check(">>")) {
                    depth = depth - 2
                    if (depth > 0) {
                        generic_str = generic_str + ">>"
                    }
                    this.advance()
                } else if (this.match_kind_check(",")) {
                    if (depth == 1) {
                        generic_str = generic_str + ","
                    }
                    this.advance()
                } else if (this.match_kind_check(":")) {
                    generic_str = generic_str + ":"
                    this.advance()
                } else if (this.match_kind_check("+")) {
                    generic_str = generic_str + "+"
                    this.advance()
                } else if (this.match_kind_check("ident")) {
                    var part: String = this.expect_ident()
                    generic_str = generic_str + part
                } else {
                    this.advance()
                }
            }
            if (generic_str.length() > 0) {
                docstring = "@generic:" + generic_str + "\n" + docstring
            }
        }
        // Extract type param names from generic_str for erasure
        var type_param_names: List<String> = []
        if (docstring.starts_with("@generic:")) {
            var nl_pos: Float = docstring.index_of("\n")
            var gstr: String = ""
            if (nl_pos >= 0) {
                gstr = docstring.slice(9, nl_pos)
            } else {
                gstr = docstring.slice(9, docstring.length())
            }
            var gparts: List<String> = gstr.split(",")
            var gi: Float = 0
            while (gi < gparts.length()) {
                var gp: String = gparts[gi]
                var gc_pos: Float = gp.index_of(":")
                if (gc_pos >= 0) {
                    type_param_names.push(gp.slice(0, gc_pos))
                } else {
                    type_param_names.push(gp)
                }
                gi = gi + 1
            }
        }
        this.consume("(")
        var params: List<AST.Param> = []
        var pattern_prepend: List<AST.Stmt> = []
        var param_idx: Float = 0
        if (!this.match_kind_check(")")) {
            this.parse_one_param(params, pattern_prepend, param_idx)
            param_idx = param_idx + 1
            while (this.match_kind(",")) {
                this.parse_one_param(params, pattern_prepend, param_idx)
                param_idx = param_idx + 1
            }
        }
        this.consume(")")
        var ret_type: String = "Nil"
        if (this.match_kind(":")) {
            ret_type = this.parse_type()
        }
        // Erase type params in parameter types and return type for codegen
        // (generics are erased at compile time — all values are i64 NaN-boxed)
        if (type_param_names.length() > 0) {
            var epi: Float = 0
            while (epi < params.length()) {
                var ep: AST.Param = params[epi]
                var ep_name: String = match (ep) { Param(n, t, d) => n }
                var ep_type: AST.Type = match (ep) { Param(n, t, d) => t }
                var ep_default: AST.Expr = match (ep) { Param(n, t, d) => d }
                var ep_type_str: String = this.type_ast_to_string(ep_type)
                if (type_param_names.contains(ep_type_str)) {
                    params[epi] = AST.Param.Param(ep_name, AST.Type.AnyType, ep_default)
                }
                epi = epi + 1
            }
            // Also erase type params in return type
            if (type_param_names.contains(ret_type)) {
                // Keep the type param name in ret_type for checker resolution
                // but the codegen will treat it correctly since params are erased
            }
        }
        var body: List<AST.Stmt> = []
        if (this.match_kind("=")) {
            var expr: AST.Expr = this.parse_expr()
            body = [AST.Stmt.Return(expr)]
        } else if (this.match_kind_check("{")) {
            body = this.parse_block_stmts()
        }
        if (pattern_prepend.length() > 0) {
            var new_body: List<AST.Stmt> = []
            var ppi: Float = 0
            while (ppi < pattern_prepend.length()) { new_body.push(pattern_prepend[ppi]); ppi = ppi + 1 }
            ppi = 0
            while (ppi < body.length()) { new_body.push(body[ppi]); ppi = ppi + 1 }
            body = new_body
        }
        return AST.Stmt.FunDecl(name, params, ret_type, body, docstring)
    }

    fun parse_one_param(params: List<AST.Param>, pattern_prepend: List<AST.Stmt>, idx: Float) {
        var pname: String = this.expect_ident()
        if (this.match_kind_check("(")) {
            this.advance()
            var pb: List<String> = []
            if (!this.match_kind_check(")")) {
                pb.push(this.expect_ident())
                while (this.match_kind(",")) { pb.push(this.expect_ident()) }
            }
            this.consume(")")
            this.consume(":")
            var ptype: String = this.parse_type()
            var syn_name: String = "__p" + idx.floor().to_string()
            params.push(AST.Param.Param(syn_name, this.parse_type_ast(ptype), AST.Expr.NilLit))
            pattern_prepend.push(AST.Stmt.LetPattern(AST.Pattern.VariantPattern(pname, pb), AST.Expr.Variable(syn_name)))
        } else if (pname == "_") {
            this.consume(":")
            var ptype: String = this.parse_type()
            var syn_name: String = "__p" + idx.floor().to_string()
            params.push(AST.Param.Param(syn_name, this.parse_type_ast(ptype), AST.Expr.NilLit))
        } else if (!this.match_kind_check(":")) {
            this.parse_error("Parameter '" + pname + "' requires a type annotation")
            params.push(AST.Param.Param(pname, AST.Type.AnyType, AST.Expr.NilLit))
        } else {
            this.consume(":")
            var ptype: String = this.parse_type()
            var pdefault: AST.Expr = AST.Expr.NilLit
            if (this.match_kind("=")) { pdefault = this.parse_expr() }
            params.push(AST.Param.Param(pname, this.parse_type_ast(ptype), pdefault))
        }
    }

    fun parse_enum_decl(): AST.Stmt {
        return this.parse_enum_decl_with_doc("")
    }

    fun parse_enum_decl_with_doc(docstring: String): AST.Stmt {
        this.advance() // consume enum
        var name: String = this.expect_ident()
        // Skip generic type parameters: enum Option<T> or enum Result<T, E>
        if (this.match_kind_check("<")) {
            this.advance()
            var depth: Float = 1
            while (depth > 0 and !this.match_kind_check("eof")) {
                if (this.match_kind_check("<")) {
                    depth = depth + 1
                } else if (this.match_kind_check(">")) {
                    depth = depth - 1
                } else if (this.match_kind_check(">>")) {
                    depth = depth - 2
                }
                this.advance()
            }
        }
        this.consume("{")
        var variants: List<AST.Variant> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            // Skip doc comments inside enum body
            this.collect_doc_comments()
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
            var vname: String = this.expect_ident()
            var fields: String = ""
            if (this.match_kind("(")) {
                var fields_sb: StringBuilder = StringBuilder()
                var first: Bool = true
                while (!this.match_kind_check(")")) {
                    if (!first) {
                        fields_sb.append(",")
                        this.consume(",")
                    }
                    var fname: String = this.expect_ident()
                    this.consume(":")
                    var ftype: String = this.parse_type()
                    fields_sb.append(fname)
                    fields_sb.append(":")
                    fields_sb.append(ftype)
                    first = false
                }
                this.consume(")")
                fields = fields_sb.to_string()
            }
            variants.push(AST.Variant.Variant(vname, fields))
            this.match_kind(",")
        }
        this.consume("}")
        return AST.Stmt.EnumDecl(name, variants, docstring)
    }

    fun parse_this_stmt(): AST.Stmt {
        this.advance() // consume this
        this.consume(".")
        var field: String = this.expect_ident()
        if (this.match_kind("=")) {
            // this.field = value
            var value: AST.Expr = this.parse_expr()
            return AST.Stmt.ExprStmt(AST.Expr.SetField(AST.Expr.This, field, value))
        }
        // Build the initial expression and continue chaining (dots, indexes, calls)
        var expr: AST.Expr = AST.Expr.GetField(AST.Expr.This, field)
        var chained: Bool = false
        while (this.match_kind_check(".") or this.match_kind_check("[")) {
            chained = true
            if (this.match_kind_check("[")) {
                this.advance()
                var idx: AST.Expr = this.parse_expr()
                this.consume("]")
                if (this.match_kind("=")) {
                    var value: AST.Expr = this.parse_expr()
                    return AST.Stmt.ExprStmt(AST.Expr.IndexSet(expr, idx, value))
                }
                expr = AST.Expr.IndexGet(expr, idx)
            } else {
                this.advance()
                var next_field: String = this.expect_ident()
                if (this.match_kind("(")) {
                    var args: List<AST.Expr> = []
                    if (!this.match_kind_check(")")) {
                        args.push(this.parse_call_arg())
                        while (this.match_kind(",")) {
                            args.push(this.parse_call_arg())
                        }
                    }
                    this.consume(")")
                    expr = AST.Expr.MethodCall(expr, next_field, args)
                } else if (this.match_kind("=")) {
                    var value: AST.Expr = this.parse_expr()
                    return AST.Stmt.ExprStmt(AST.Expr.SetField(expr, next_field, value))
                } else {
                    expr = AST.Expr.MemberAccess(expr, next_field)
                }
            }
        }
        // Check for trailing call: this.field[idx]() or this.method(args)
        if (this.match_kind("(")) {
            var args: List<AST.Expr> = []
            if (!this.match_kind_check(")")) {
                args.push(this.parse_call_arg())
                while (this.match_kind(",")) {
                    args.push(this.parse_call_arg())
                }
            }
            this.consume(")")
            if (chained) {
                // expr was modified by indexing/chaining — this is an indirect call
                return AST.Stmt.ExprStmt(AST.Expr.Call(expr, args))
            }
            return AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.This, field, args))
        }
        return AST.Stmt.ExprStmt(expr)
    }

    fun parse_dot_stmt(): AST.Stmt {
        var obj_name: String = this.expect_ident()
        var expr: AST.Expr = AST.Expr.Variable(obj_name)
        while (this.match_kind_check(".")) {
            this.advance()
            var field: String = this.expect_ident()
            if (this.match_kind_check("(")) {
                this.advance()
                var args: List<AST.Expr> = []
                if (!this.match_kind_check(")")) {
                    args.push(this.parse_call_arg())
                    while (this.match_kind(",")) {
                        args.push(this.parse_call_arg())
                    }
                    this.consume(")")
                } else {
                    this.advance()
                }
                expr = AST.Expr.MethodCall(expr, field, args)
            } else if (this.match_kind("=")) {
                var value: AST.Expr = this.parse_expr()
                return AST.Stmt.ExprStmt(AST.Expr.SetField(expr, field, value))
            } else {
                expr = AST.Expr.MemberAccess(expr, field)
            }
        }
        if (this.match_kind_check("[")) {
            this.advance()
            var idx: AST.Expr = this.parse_expr()
            this.consume("]")
            if (this.match_kind("=")) {
                var value: AST.Expr = this.parse_expr()
                return AST.Stmt.ExprStmt(AST.Expr.IndexSet(expr, idx, value))
            }
            expr = AST.Expr.IndexGet(expr, idx)
        }
        return AST.Stmt.ExprStmt(expr)
    }

    fun parse_class_decl(): AST.Stmt {
        return this.parse_class_decl_with_doc("")
    }

    fun parse_class_decl_with_doc(docstring: String): AST.Stmt {
        this.advance() // consume class
        var name: String = this.expect_ident()
        // Skip generic type parameters: class Foo<T> or interface Bar<K, V>
        if (this.match_kind_check("<")) {
            this.advance()
            var depth: Float = 1
            while (depth > 0 and !this.match_kind_check("eof")) {
                if (this.match_kind_check("<")) {
                    depth = depth + 1
                } else if (this.match_kind_check(">")) {
                    depth = depth - 1
                } else if (this.match_kind_check(">>")) {
                    depth = depth - 2
                }
                this.advance()
            }
        }
        var parent: String = ""
        if (this.is_ident_named("extends")) {
            this.advance() // consume extends
            parent = this.expect_ident()
            // Support multiple extends (interfaces): class Foo extends A, B, C
            while (this.match_kind(",")) {
                this.expect_ident() // skip additional interfaces for now
            }
        }
        this.consume("{")
        var fields: List<AST.Param> = []
        var methods: List<AST.Stmt> = []
        var field_defaults: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
            // Consume doc comments inside class body (attach to next member)
            var member_doc: String = this.collect_doc_comments()
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
            if (this.match_kind_check("var")) {
                // Field declaration: var name: Type  or  var name = default
                this.advance()
                var fname: String = this.expect_ident()
                var ftype: String = "Any"
                if (this.match_kind(":")) {
                    ftype = this.parse_type()
                }
                if (this.match_kind("=")) {
                    var default_val: AST.Expr = this.parse_expr()
                    // Infer type from default if not annotated
                    if (ftype == "Any") {
                        var ek: String = match (default_val) {
                            StringLit(s) => "String"
                            IntLit(v) => "Int"
                            FloatLit(v) => "Float"
                            BoolLit(v) => "Bool"
                            NilLit => "Nil"
                            ListLit(e) => "List"
                            _ => "Any"
                        }
                        if (ek != "Any") { ftype = ek }
                    }
                    // Generate: this.fname = default_val (to prepend to init)
                    field_defaults.push(AST.Stmt.ExprStmt(
                        AST.Expr.SetField(AST.Expr.This, fname, default_val)))
                }
                fields.push(AST.Param.Param(fname, this.parse_type_ast(ftype), AST.Expr.NilLit))
            } else if (this.is_ident_named("@")) {
                // Decorator on method: @inline, @intrinsic, etc.
                this.advance()
                var method_decorator: String = this.expect_ident()
                var method_annotation: String = "@" + method_decorator
                if (this.match_kind_check("(")) {
                    this.advance()
                    if (this.match_kind_check("string")) {
                        var mdarg_kind: Lexer.TokenKind = this.current_kind()
                        var mdarg: String = match (mdarg_kind) { TkString(s) => s }
                        this.advance()
                        method_annotation = method_annotation + ":" + mdarg
                    }
                    this.consume(")")
                }
                if (this.match_kind_check("fun")) {
                    methods.push(this.parse_fun_decl_with_doc(method_annotation))
                }
            } else if (this.match_kind_check("fun")) {
                // Method declaration (doc comment passed via parse_fun_decl_with_doc)
                methods.push(this.parse_fun_decl_with_doc(member_doc))
            }
        }
        this.consume("}")
        // Inject field defaults into init() method
        if (field_defaults.length() > 0) {
            this.inject_field_defaults(methods, field_defaults)
        }
        return AST.Stmt.ClassDecl(name, parent, fields, methods, docstring)
    }

    fun inject_field_defaults(methods: List<AST.Stmt>, defaults: List<AST.Stmt>) {
        // Find existing init method and prepend defaults to its body
        var i: Int = 0
        while (i < methods.length()) {
            var mname: String = match (methods[i]) { FunDecl(n, p, r, b, d) => n }
            if (mname == "init") {
                var mbody: List<AST.Stmt> = match (methods[i]) { FunDecl(n, p, r, b, d) => b }
                var mparams: List<AST.Param> = match (methods[i]) { FunDecl(n, p, r, b, d) => p }
                var mret: String = match (methods[i]) { FunDecl(n, p, r, b, d) => r }
                // Build new body: defaults + original body
                var new_body: List<AST.Stmt> = []
                var di: Int = 0
                while (di < defaults.length()) {
                    new_body.push(defaults[di])
                    di = di + 1
                }
                var bi: Int = 0
                while (bi < mbody.length()) {
                    new_body.push(mbody[bi])
                    bi = bi + 1
                }
                methods[i] = AST.Stmt.FunDecl("init", mparams, mret, new_body, "")
                return nil
            }
            i = i + 1
        }
        // No init found — create one with just the defaults
        methods.push(AST.Stmt.FunDecl("init", [], "Nil", defaults, ""))
    }

    fun parse_import(): AST.Stmt {
        this.advance()
        if (this.match_kind_check("{")) {
            this.advance()
            var names: List<String> = []
            names.push(this.expect_ident())
            while (this.match_kind(",")) {
                if (this.match_kind_check("}")) { break }
                names.push(this.expect_ident())
            }
            this.consume("}")
            this.advance()
            var kind: Lexer.TokenKind = this.current_kind()
            var path: String = match (kind) { TkString(s) => s }
            this.advance()
            // Return NilLit ExprStmt — treated as declaration by is_decl, invisible to codegen
            return AST.Stmt.ExprStmt(AST.Expr.NilLit)
        }
        var kind: Lexer.TokenKind = this.current_kind()
        var path: String = match (kind) { TkString(s) => s }
        this.advance()
        if (this.match_kind_check("as") or this.is_ident_named("as")) {
            this.advance()
            var alias: String = this.expect_ident()
            // Return NilLit ExprStmt — treated as declaration by is_decl, invisible to codegen
            return AST.Stmt.ExprStmt(AST.Expr.NilLit)
        }
        // Return NilLit ExprStmt — treated as declaration by is_decl, invisible to codegen
        return AST.Stmt.ExprStmt(AST.Expr.NilLit)
    }

    fun parse_return(): AST.Stmt {
        this.advance() // consume return
        // Bare return (no value) → return nil
        if (this.match_kind_check("}") or this.match_kind_check("eof")) {
            return AST.Stmt.Return(AST.Expr.NilLit)
        }
        var value: AST.Expr = this.parse_expr()
        return AST.Stmt.Return(value)
    }

    fun parse_if(): AST.Stmt {
        this.advance() // consume if
        this.consume("(")
        var cond: AST.Expr = this.parse_expr()
        this.consume(")")
        var then_branch: List<AST.Stmt> = this.parse_body()
        var else_branch: List<AST.Stmt> = []
        if (this.match_kind("else")) {
            if (this.match_kind_check("if")) {
                // Flatten else-if: parse as nested If in else
                // But limit depth to prevent stack overflow in codegen
                else_branch = [this.parse_if()]
            } else {
                else_branch = this.parse_body()
            }
        }
        return AST.Stmt.If(cond, then_branch, else_branch)
    }

    fun parse_body(): List<AST.Stmt> {
        // Block with braces or single statement
        if (this.match_kind_check("{")) {
            return this.parse_block_stmts()
        }
        // Single statement body (no braces)
        return [this.parse_stmt()]
    }

    fun parse_while(): AST.Stmt {
        this.advance() // consume while
        this.consume("(")
        var cond: AST.Expr = this.parse_expr()
        this.consume(")")
        var body: List<AST.Stmt> = this.parse_block_stmts()
        return AST.Stmt.While(cond, body)
    }

    fun parse_for(): AST.Stmt {
        this.advance() // consume for
        this.consume("(")
        // C-style for with var keyword: for (var i: Float = 0; i < 10; i = i + 1)
        if (this.match_kind_check("var")) {
            this.advance() // consume var
            var name: String = this.expect_ident()
            this.consume(":")
            var vtype: String = this.parse_type()
            this.consume("=")
            var init_expr: AST.Expr = this.parse_expr()
            var init: AST.Stmt = AST.Stmt.VarDecl(name, vtype, init_expr, "")
            this.consume(";")
            var cond: AST.Expr = this.parse_expr()
            this.consume(";")
            var update_name: String = this.expect_ident()
            this.consume("=")
            var update_expr: AST.Expr = this.parse_expr()
            this.consume(")")
            var body: List<AST.Stmt> = this.parse_block_stmts()
            body.push(AST.Stmt.ExprStmt(AST.Expr.Assign(update_name, update_expr)))
            var stmts: List<AST.Stmt> = []
            stmts.push(init)
            stmts.push(AST.Stmt.While(cond, body))
            return AST.Stmt.Block(stmts)
        }
        // Array pattern: for ([a, b] in list)
        if (this.match_kind_check("[")) {
            this.advance()
            var pat_names: List<String> = []
            if (!this.match_kind_check("]")) {
                pat_names.push(this.expect_ident())
                while (this.match_kind(",")) { pat_names.push(this.expect_ident()) }
            }
            this.consume("]")
            this.consume("in")
            var pat_iter: AST.Expr = this.parse_expr()
            this.consume(")")
            var pat_body: List<AST.Stmt> = this.parse_block_stmts()
            var desugar_body: List<AST.Stmt> = []
            var pdi: Float = 0
            while (pdi < pat_names.length()) {
                desugar_body.push(AST.Stmt.VarDecl(pat_names[pdi], "Any", AST.Expr.IndexGet(AST.Expr.Variable("__for_item"), AST.Expr.IntLit(pdi)), ""))
                pdi = pdi + 1
            }
            pdi = 0
            while (pdi < pat_body.length()) { desugar_body.push(pat_body[pdi]); pdi = pdi + 1 }
            return this.desugar_for_in("__for_item", pat_iter, desugar_body)
        }
        // Check for for-in: for (name in expr) or for (Variant(x) in list)
        var name: String = this.expect_ident()
        if (this.match_kind_check("(")) {
            // Variant pattern: for (Some(x) in list)
            this.advance()
            var vp_bindings: List<String> = []
            if (!this.match_kind_check(")")) {
                vp_bindings.push(this.expect_ident())
                while (this.match_kind(",")) { vp_bindings.push(this.expect_ident()) }
            }
            this.consume(")")
            this.consume("in")
            var vp_iter: AST.Expr = this.parse_expr()
            this.consume(")")
            var vp_body: List<AST.Stmt> = this.parse_block_stmts()
            var vp_desugar: List<AST.Stmt> = []
            vp_desugar.push(AST.Stmt.LetPattern(AST.Pattern.VariantPattern(name, vp_bindings), AST.Expr.Variable("__for_item")))
            var vpi: Float = 0
            while (vpi < vp_body.length()) { vp_desugar.push(vp_body[vpi]); vpi = vpi + 1 }
            return this.desugar_for_in("__for_item", vp_iter, vp_desugar)
        }
        if (this.match_kind("in")) {
            return this.parse_for_in(name)
        }
        // C-style for without var keyword: for (i: Float = 0; i < 10; i = i + 1)
        this.consume(":")
        var vtype: String = this.parse_type()
        this.consume("=")
        var init_expr: AST.Expr = this.parse_expr()
        var init: AST.Stmt = AST.Stmt.VarDecl(name, vtype, init_expr, "")
        this.consume(";")
        var cond: AST.Expr = this.parse_expr()
        this.consume(";")
        var update_name: String = this.expect_ident()
        this.consume("=")
        var update_expr: AST.Expr = this.parse_expr()
        this.consume(")")
        var body: List<AST.Stmt> = this.parse_block_stmts()
        body.push(AST.Stmt.ExprStmt(AST.Expr.Assign(update_name, update_expr)))
        var stmts: List<AST.Stmt> = []
        stmts.push(init)
        stmts.push(AST.Stmt.While(cond, body))
        return AST.Stmt.Block(stmts)
    }

    fun parse_for_in(item_name: String): AST.Stmt {
        // Desugar: for (item in list) { body }
        // Into: { var __list = list; var __i = 0; while (__i < __list.length()) { var item = __list[__i]; body; __i = __i + 1 } }
        var iter_expr: AST.Expr = this.parse_expr()
        this.consume(")")
        var body: List<AST.Stmt> = this.parse_block_stmts()

        var list_var: String = "__for_list"
        var idx_var: String = "__for_i"

        // var __for_list = iter_expr
        var init_list: AST.Stmt = AST.Stmt.VarDecl(list_var, "Any", iter_expr, "")
        // var __for_i = 0
        var init_idx: AST.Stmt = AST.Stmt.VarDecl(idx_var, "Int", AST.Expr.IntLit(0), "")
        // __for_i < __for_list.length()
        var cond: AST.Expr = AST.Expr.Binary(
            AST.Expr.Variable(idx_var),
            "<",
            AST.Expr.MethodCall(AST.Expr.Variable(list_var), "length", [])
        )
        // var item = __for_list[__for_i]
        var item_init: AST.Stmt = AST.Stmt.VarDecl(item_name, "Any",
            AST.Expr.IndexGet(AST.Expr.Variable(list_var), AST.Expr.Variable(idx_var)), "")
        // __for_i = __for_i + 1
        var increment: AST.Stmt = AST.Stmt.ExprStmt(AST.Expr.Assign(idx_var,
            AST.Expr.Binary(AST.Expr.Variable(idx_var), "+", AST.Expr.IntLit(1))))

        // Build while body: item decl + increment + user body
        // (increment before body so that `continue` doesn't skip it)
        var while_body: List<AST.Stmt> = []
        while_body.push(item_init)
        while_body.push(increment)
        var bi: Float = 0
        while (bi < body.length()) {
            while_body.push(body[bi])
            bi = bi + 1
        }

        // Build block: list init + idx init + while
        var stmts: List<AST.Stmt> = []
        stmts.push(init_list)
        stmts.push(init_idx)
        stmts.push(AST.Stmt.While(cond, while_body))
        return AST.Stmt.Block(stmts)
    }

    fun desugar_for_in(item_name: String, iter_expr: AST.Expr, body: List<AST.Stmt>): AST.Stmt {
        var list_var: String = "__for_list"
        var idx_var: String = "__for_i"
        var init_list: AST.Stmt = AST.Stmt.VarDecl(list_var, "Any", iter_expr, "")
        var init_idx: AST.Stmt = AST.Stmt.VarDecl(idx_var, "Int", AST.Expr.IntLit(0), "")
        var cond: AST.Expr = AST.Expr.Binary(AST.Expr.Variable(idx_var), "<", AST.Expr.MethodCall(AST.Expr.Variable(list_var), "length", []))
        var item_init: AST.Stmt = AST.Stmt.VarDecl(item_name, "Any", AST.Expr.IndexGet(AST.Expr.Variable(list_var), AST.Expr.Variable(idx_var)), "")
        var increment: AST.Stmt = AST.Stmt.ExprStmt(AST.Expr.Assign(idx_var, AST.Expr.Binary(AST.Expr.Variable(idx_var), "+", AST.Expr.IntLit(1))))
        var while_body: List<AST.Stmt> = []
        while_body.push(item_init)
        while_body.push(increment)
        var bi: Float = 0
        while (bi < body.length()) { while_body.push(body[bi]); bi = bi + 1 }
        var stmts: List<AST.Stmt> = []
        stmts.push(init_list)
        stmts.push(init_idx)
        stmts.push(AST.Stmt.While(cond, while_body))
        return AST.Stmt.Block(stmts)
    }

    fun parse_try(): AST.Stmt {
        this.advance() // consume try
        var try_body: List<AST.Stmt> = this.parse_block_stmts()
        this.consume("catch")
        this.consume("(")
        var catch_name: String = this.expect_ident()
        this.consume(")")
        var catch_body: List<AST.Stmt> = this.parse_block_stmts()
        var finally_body: List<AST.Stmt> = []
        if (this.match_kind("finally")) {
            finally_body = this.parse_block_stmts()
        }
        return AST.Stmt.TryCatch(try_body, catch_name, catch_body, finally_body)
    }

    fun parse_throw(): AST.Stmt {
        this.advance() // consume throw
        var value: AST.Expr = this.parse_expr()
        return AST.Stmt.Throw(value)
    }

    fun parse_trailing_closure(): AST.Expr {
        this.consume("{")
        // Check for param list: ident => or ident, ident => ...
        if (this.match_kind_check("ident")) { if (this.peek_is("=>") or this.peek_is(",")) {
            return this.parse_trailing_closure_with_params() } }
        var body: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                this.consume("}")
                return AST.Expr.Lambda([], "Nil", body)
            }
            // Bare string literals desugar to text(string)
            if (this.match_kind_check("string")) {
                var str_expr: AST.Expr = this.parse_expr()
                body.push(AST.Stmt.ExprStmt(AST.Expr.Call(AST.Expr.Variable("text"), [str_expr])))
            } else {
                body.push(this.parse_stmt())
            }
        }
        this.consume("}")
        return AST.Expr.Lambda([], "Nil", body)
    }

    fun parse_trailing_closure_with_params(): AST.Expr {
        // Collect param names before the =>
        var param_names: List<String> = []
        param_names.push(this.expect_ident())
        while (this.match_kind(",")) {
            param_names.push(this.expect_ident())
        }
        this.consume("=>")
        // Parse body
        var body: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                break
            }
            body.push(this.parse_stmt())
        }
        this.consume("}")
        // Build the Lambda using the same pattern as parse_lambda
        return this.build_lambda(param_names, body)
    }

    fun build_lambda(names: List<String>, body: List<AST.Stmt>): AST.Expr {
        var params: List<AST.Param> = []
        var i: Float = 0
        while (i < names.length()) {
            params.push(AST.Param.Param(names[i], AST.Type.AnyType, AST.Expr.NilLit))
            i = i + 1
        }
        return AST.Expr.Lambda(params, "Any", body)
    }

    // =========================================================================
    // HTML Element Parsing — <tag attrs>children</tag> desugars to builder calls
    // =========================================================================

    fun peek_is_html_start(): Bool {
        // Current token is <. Check if NEXT token (pos+1) is an HTML element or component.
        if (this.pos + 1 >= this.tokens.length()) { return false }
        var next_tok: Lexer.Token = this.tokens[this.pos + 1]
        var next_kind: Lexer.TokenKind = match (next_tok) { Token(k, l, c) => k }
        var kind_str: String = this.kind_name(next_kind)
        if (kind_str != "ident") { return false }
        var name: String = match (next_kind) { TkIdent(n) => n }
        if (name.length() == 0) { return false }
        // Uppercase = component
        var first: String = name.char_at(0)
        if (first >= "A" and first <= "Z") { return true }
        // Known HTML elements
        return this.is_html_tag(name)
    }

    fun is_html_tag(name: String): Bool {
        // Common HTML elements (covers 99% of usage)
        if (name == "div") { return true }
        if (name == "span") { return true }
        if (name == "p") { return true }
        if (name == "a") { return true }
        if (name == "h1" or name == "h2" or name == "h3" or name == "h4" or name == "h5" or name == "h6") { return true }
        if (name == "button") { return true }
        if (name == "input") { return true }
        if (name == "form") { return true }
        if (name == "label") { return true }
        if (name == "img") { return true }
        if (name == "ul" or name == "ol" or name == "li") { return true }
        if (name == "table" or name == "tr" or name == "td" or name == "th" or name == "thead" or name == "tbody") { return true }
        if (name == "nav" or name == "header" or name == "footer" or name == "main" or name == "section" or name == "article" or name == "aside") { return true }
        if (name == "br" or name == "hr") { return true }
        if (name == "select" or name == "option" or name == "textarea") { return true }
        if (name == "pre" or name == "code" or name == "blockquote") { return true }
        if (name == "em" or name == "strong" or name == "small" or name == "mark" or name == "del" or name == "ins") { return true }
        if (name == "video" or name == "audio" or name == "canvas" or name == "source") { return true }
        if (name == "details" or name == "summary" or name == "dialog") { return true }
        if (name == "fieldset" or name == "legend" or name == "optgroup") { return true }
        if (name == "iframe" or name == "embed" or name == "object") { return true }
        if (name == "link" or name == "meta" or name == "style" or name == "script") { return true }
        if (name == "head" or name == "body" or name == "html" or name == "title") { return true }
        if (name == "dl" or name == "dt" or name == "dd") { return true }
        if (name == "figure" or name == "figcaption" or name == "picture") { return true }
        if (name == "area" or name == "base" or name == "col" or name == "colgroup" or name == "caption") { return true }
        if (name == "track" or name == "wbr" or name == "slot" or name == "template") { return true }
        return false
    }

    fun is_void_tag(name: String): Bool {
        if (name == "br" or name == "hr" or name == "img" or name == "input") { return true }
        if (name == "area" or name == "base" or name == "col" or name == "embed") { return true }
        if (name == "link" or name == "meta" or name == "source" or name == "track" or name == "wbr") { return true }
        return false
    }

    fun parse_html_fragment(): AST.Expr {
        // <> already checked but not consumed. Consume < and >
        this.advance()
        this.advance()
        var children: List<AST.Stmt> = this.parse_html_children("")
        return AST.Expr.BlockExpr(children, AST.Expr.NilLit)
    }

    fun parse_html_element(): AST.Expr {
        // < already checked but not consumed. Consume it.
        this.advance()
        // Read tag name
        var tag: String = this.expect_ident()

        // Parse attributes
        var args: List<AST.Expr> = this.parse_html_attrs()

        // Check for self-closing /> or >
        if (this.match_kind_check("/")) {
            this.advance()
            this.consume(">")
            // Self-closing: tag(attrs...)
            return AST.Expr.Call(AST.Expr.Variable(tag), args)
        }

        this.consume(">")

        if (this.is_void_tag(tag)) {
            // Void element: tag(attrs...)
            return AST.Expr.Call(AST.Expr.Variable(tag), args)
        }

        // Parse children until </tag>
        var children: List<AST.Stmt> = this.parse_html_children(tag)

        // Emit: tag(attrs...) { children }
        // Add trailing closure (Lambda with children as body)
        args.push(AST.Expr.Lambda([], "Nil", children))
        return AST.Expr.Call(AST.Expr.Variable(tag), args)
    }

    fun parse_html_attrs(): List<AST.Expr> {
        var args: List<AST.Expr> = []
        // Parse name=value pairs until > or />
        // Accept identifiers and keywords that are valid HTML attribute names (class, for, etc.)
        while (this.match_kind_check("ident") or this.match_kind_check("class") or this.match_kind_check("for") or this.match_kind_check("in") or this.match_kind_check("is")) {
            var attr_name: String = ""
            if (this.match_kind_check("class")) {
                attr_name = "cls"
                this.advance()
            } else if (this.match_kind_check("for")) {
                attr_name = "html_for"
                this.advance()
            } else if (this.match_kind_check("in")) {
                attr_name = "in"
                this.advance()
            } else if (this.match_kind_check("is")) {
                attr_name = "is"
                this.advance()
            } else {
                attr_name = this.expect_ident()
            }

            if (this.match_kind("=")) {
                // name=value
                var attr_val: AST.Expr = this.parse_html_attr_value()
                args.push(AST.Expr.Assign(attr_name, attr_val))
            } else {
                // Boolean attribute: name (no value) → name=true
                args.push(AST.Expr.Assign(attr_name, AST.Expr.BoolLit(true)))
            }
        }
        return args
    }

    fun parse_html_attr_value(): AST.Expr {
        // "string" → StringLit (common case, fast path)
        if (this.match_kind_check("string")) {
            var kind: Lexer.TokenKind = this.current_kind()
            this.advance()
            return match (kind) {
                TkString(s) => AST.Expr.StringLit(s)
            }
        }
        // {expr} — brace-delimited expression value (map literals, lambdas, etc.)
        // Consume the { ourselves, parse a full expression, then consume }.
        // This is safe because the } delimiter prevents parse_expr from consuming
        // HTML structural tokens (>, <, /) as binary operators.
        // We handle { here rather than letting parse_primary's block-expression path
        // handle it, because that path calls parse_stmt() which can misparse
        // anonymous lambdas (fun () => ...) as declarations.
        if (this.match_kind_check("{")) {
            this.advance()
            var saved_depth: Float = this.html_depth
            this.html_depth = 0
            // Check for empty map: {}
            if (this.match_kind_check("}")) {
                this.advance()
                this.html_depth = saved_depth
                return AST.Expr.MapLit
            }
            // Check for Kotlin-style lambda: {x => body} or {x, y => body}
            var is_kotlin_lambda: Bool = false
            if (this.match_kind_check("ident")) {
                if (this.peek_is("=>") or this.peek_is(",")) {
                    is_kotlin_lambda = true
                }
            }
            if (is_kotlin_lambda) {
                var kl_before: Float = this.pos
                var kl_name: String = this.expect_ident()
                if (this.match_kind("=>")) {
                    // Single-param Kotlin lambda: {x => body}
                    var lparams: List<AST.Param> = []
                    lparams.push(AST.Param.Param(kl_name, AST.Type.AnyType, AST.Expr.NilLit))
                    var lbody: List<AST.Stmt> = []
                    while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                        while (this.match_kind(";")) {}
                        if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
                        lbody.push(this.parse_stmt())
                    }
                    this.consume("}")
                    if (lbody.length() > 0) {
                        var klast: AST.Stmt = lbody[lbody.length() - 1]
                        var kis_expr: Bool = match (klast) { ExprStmt(e) => true   _ => false }
                        if (kis_expr) {
                            var kexpr: AST.Expr = match (klast) { ExprStmt(e) => e }
                            lbody[lbody.length() - 1] = AST.Stmt.Return(kexpr)
                        }
                    }
                    this.html_depth = saved_depth
                    return AST.Expr.Lambda(lparams, "Any", lbody)
                } else if (this.match_kind(",")) {
                    // Multi-param Kotlin lambda: {x, y => body}
                    var lparams: List<AST.Param> = []
                    lparams.push(AST.Param.Param(kl_name, AST.Type.AnyType, AST.Expr.NilLit))
                    var lpname: String = this.expect_ident()
                    lparams.push(AST.Param.Param(lpname, AST.Type.AnyType, AST.Expr.NilLit))
                    while (this.match_kind(",")) {
                        lpname = this.expect_ident()
                        lparams.push(AST.Param.Param(lpname, AST.Type.AnyType, AST.Expr.NilLit))
                    }
                    this.consume("=>")
                    var lbody: List<AST.Stmt> = []
                    while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                        while (this.match_kind(";")) {}
                        if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
                        lbody.push(this.parse_stmt())
                    }
                    this.consume("}")
                    if (lbody.length() > 0) {
                        var klast: AST.Stmt = lbody[lbody.length() - 1]
                        var kis_expr: Bool = match (klast) { ExprStmt(e) => true   _ => false }
                        if (kis_expr) {
                            var kexpr: AST.Expr = match (klast) { ExprStmt(e) => e }
                            lbody[lbody.length() - 1] = AST.Stmt.Return(kexpr)
                        }
                    }
                    this.html_depth = saved_depth
                    return AST.Expr.Lambda(lparams, "Any", lbody)
                } else {
                    // Not a Kotlin lambda — restore position
                    this.pos = kl_before
                }
            }
            // Check for map literal: {"key": val, ...} or {ident: val, ...}
            if ((this.match_kind_check("string") or this.match_kind_check("ident")) and this.peek_is(":")) {
                var map_stmts: List<AST.Stmt> = []
                map_stmts.push(AST.Stmt.VarDecl("__map", "Map", AST.Expr.MapLit, ""))
                // First entry
                var key: AST.Expr = this.parse_primary()
                this.consume(":")
                var value: AST.Expr = this.parse_expr()
                map_stmts.push(AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.Variable("__map"), "set", [key, value])))
                while (this.match_kind(",")) {
                    if (this.match_kind_check("}")) { break }
                    var k: AST.Expr = this.parse_primary()
                    this.consume(":")
                    var v: AST.Expr = this.parse_expr()
                    map_stmts.push(AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.Variable("__map"), "set", [k, v])))
                }
                this.consume("}")
                this.html_depth = saved_depth
                return AST.Expr.BlockExpr(map_stmts, AST.Expr.Variable("__map"))
            }
            // General expression (lambda, arithmetic, etc.)
            var expr: AST.Expr = this.parse_expr()
            this.consume("}")
            this.html_depth = saved_depth
            return expr
        }
        // Bare value (identifier, number, etc.) — use parse_call to avoid
        // consuming HTML structural tokens (>, <, /) as binary operators.
        return this.parse_call()
    }

    fun parse_html_children(parent_tag: String): List<AST.Stmt> {
        var stmts: List<AST.Stmt> = []
        this.html_depth = this.html_depth + 1

        while (!this.match_kind_check("eof")) {
            // Check for closing tag: </tag> or fragment close </>
            if (this.match_kind_check("<") and this.peek_is("/")) {
                this.advance()
                this.advance()
                if (!this.match_kind_check(">")) {
                    this.expect_ident()
                }
                this.consume(">")
                this.html_depth = this.html_depth - 1
                return stmts
            }

            // Nested fragment: <>...</>
            if (this.match_kind_check("<") and this.peek_is(">")) {
                var child: AST.Expr = this.parse_html_fragment()
                stmts.push(AST.Stmt.ExprStmt(child))
            }
            // Nested HTML element: <ident ...> (any identifier — no tag list needed at depth>0)
            else if (this.match_kind_check("<") and this.peek_is("ident")) {
                var child: AST.Expr = this.parse_html_element()
                stmts.push(AST.Stmt.ExprStmt(child))
            }
            // Code block: {stmts...}
            else if (this.match_kind_check("{")) {
                this.advance()
                var saved_depth: Float = this.html_depth
                this.html_depth = 0
                while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                    while (this.match_kind(";")) {}
                    if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
                    stmts.push(this.parse_stmt())
                }
                this.consume("}")
                this.html_depth = saved_depth
            }
            // Text content — accumulate until < or { or EOF
            else if (this.match_kind_check("string")) {
                var kind: Lexer.TokenKind = this.current_kind()
                this.advance()
                var text: String = match (kind) { TkString(s) => s }
                stmts.push(AST.Stmt.ExprStmt(AST.Expr.Call(AST.Expr.Variable("text"), [AST.Expr.StringLit(text)])))
            }
            else {
                // Text tokens (identifiers, numbers, symbols) until < or { or EOF
                var full_text: String = ""
                var prev_part: String = ""
                while (!this.match_kind_check("<") and !this.match_kind_check("{") and !this.match_kind_check("eof")) {
                    var kind: Lexer.TokenKind = this.current_kind()
                    var text_part: String = match (kind) {
                        TkIdent(s) => s
                        TkInt(v) => v.to_string()
                        _ => this.kind_name(kind)
                    }
                    if (full_text.length() == 0) {
                        full_text = text_part
                    } else if (text_part == "." or text_part == "," or text_part == "!" or text_part == "?" or text_part == ":" or text_part == ";") {
                        full_text = full_text + text_part
                    } else if (prev_part == "-" or text_part == "-") {
                        // Hyphenated words: no space around -
                        full_text = full_text + text_part
                    } else {
                        full_text = full_text + " " + text_part
                    }
                    prev_part = text_part
                    this.advance()
                }
                if (full_text.length() > 0) {
                    stmts.push(AST.Stmt.ExprStmt(AST.Expr.Call(AST.Expr.Variable("text"), [AST.Expr.StringLit(full_text)])))
                } else {
                    this.advance()
                }
            }
        }

        return stmts
    }

    fun parse_block(): AST.Stmt {
        return AST.Stmt.Block(this.parse_block_stmts())
    }

    fun parse_block_stmts(): List<AST.Stmt> {
        this.consume("{")
        var stmts: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                this.consume("}")
                return stmts
            }
            stmts.push(this.parse_stmt())
        }
        this.consume("}")
        return stmts
    }

    fun stmt_to_expr(stmt: AST.Stmt): AST.Expr {
        // If it's an ExprStmt, extract the expression as the block value
        // If it's an If with else, convert to IfExpr so the value propagates
        // Otherwise return NilLit
        var kind: String = match (stmt) {
            ExprStmt(e) => "expr"
            VarDecl(n, t, i, d) => "other"
            FunDecl(n, p, r, b, d) => "other"
            EnumDecl(n, v, d) => "other"
            ClassDecl(n, f, m, d) => "other"
            Return(v) => "other"
            If(c, t, e) => "if"
            While(c, b) => "other"
            Block(s) => "other"
            Break => "other"
            Continue => "other"
            TryCatch(t, n, c, f) => "other"
            Throw(v) => "other"
            LetPattern(p, v) => "other"
        }
        if (kind == "expr") {
            return match (stmt) { ExprStmt(e) => e }
        }
        if (kind == "if") {
            return this.if_stmt_to_expr(stmt)
        }
        return AST.Expr.NilLit
    }

    fun if_stmt_to_expr(stmt: AST.Stmt): AST.Expr {
        var cond: AST.Expr = match (stmt) { If(c, t, e) => c }
        var then_branch: List<AST.Stmt> = match (stmt) { If(c, t, e) => t }
        var else_branch: List<AST.Stmt> = match (stmt) { If(c, t, e) => e }
        // Only convert if there is an else branch (otherwise not value-producing)
        if (else_branch.length() == 0) {
            return AST.Expr.NilLit
        }
        // Extract then value: last ExprStmt or If becomes value
        var then_val: AST.Expr = AST.Expr.NilLit
        if (then_branch.length() > 0) {
            var then_last: AST.Stmt = then_branch[then_branch.length() - 1]
            var then_extractable: Bool = this.is_value_stmt(then_last)
            if (then_extractable) {
                then_val = this.stmt_to_expr(then_last)
                then_branch.pop()
            }
        }
        // Extract else value: last ExprStmt or If becomes value
        var else_val: AST.Expr = AST.Expr.NilLit
        if (else_branch.length() > 0) {
            var else_last: AST.Stmt = else_branch[else_branch.length() - 1]
            var else_extractable: Bool = this.is_value_stmt(else_last)
            if (else_extractable) {
                else_val = this.stmt_to_expr(else_last)
                else_branch.pop()
            }
        }
        return AST.Expr.IfExpr(cond, then_branch, then_val, else_branch, else_val)
    }

    fun is_value_stmt(stmt: AST.Stmt): Bool {
        var kind: String = match (stmt) {
            ExprStmt(e) => "expr"
            If(c, t, e) => "if"
            _ => "other"
        }
        if (kind == "expr") { return true }
        if (kind == "if") {
            // Only if it has an else branch
            var else_br: List<AST.Stmt> = match (stmt) { If(c, t, e) => e }
            return else_br.length() > 0
        }
        return false
    }
}



var _had_error: Bool = false

fun parse(tokens: List<Lexer.Token>): List<AST.Stmt> {
    var p: Parser = Parser(tokens)
    var result: List<AST.Stmt> = p.parse_program()
    _had_error = p.had_error
    return result
}

fun parse_with_source(tokens: List<Lexer.Token>, source: String): List<AST.Stmt> {
    var p: Parser = Parser(tokens)
    p.source = source
    var result: List<AST.Stmt> = p.parse_program()
    _had_error = p.had_error
    return result
}

fun had_error(): Bool {
    return _had_error
}
