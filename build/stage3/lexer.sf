// Lexer for Saffron-mini

enum TokenKind {
    // Literals
    TkInt(value: Float),
    TkFloat(value: String),
    TkString(value: String),
    TkTrue,
    TkFalse,
    TkNil,

    // Identifiers & keywords
    TkIdent(name: String),
    TkVar,
    TkLet,
    TkFun,
    TkReturn,
    TkIf,
    TkElse,
    TkWhile,
    TkAnd,
    TkOr,
    TkImport,
    TkAs,
    TkEnum,
    TkMatch,
    TkClass,
    TkThis,
    TkFor,
    TkIn,
    TkTry,
    TkCatch,
    TkThrow,
    TkFinally,
    TkIs,
    TkYield,

    // Operators
    TkPlus,
    TkMinus,
    TkStar,
    TkSlash,
    TkPercent,
    TkAmpersand,
    TkPipe,
    TkCaret,
    TkTilde,
    TkShiftLeft,
    TkShiftRight,
    TkBang,
    TkBangEq,
    TkEq,
    TkEqEq,
    TkLt,
    TkLtEq,
    TkGt,
    TkGtEq,

    // Delimiters
    TkLParen,
    TkRParen,
    TkLBrace,
    TkRBrace,
    TkLBracket,
    TkRBracket,
    TkComma,
    TkDot,
    TkColon,
    TkSemicolon,
    TkArrow,
    TkFatArrow,
    TkQuestion,

    // Documentation
    TkDocComment(text: String),
    TkModuleDoc(text: String),

    // Special
    TkNewline,
    TkEof
}

enum Token {
    Token(kind: TokenKind, line: Float, col: Float)
}

class Lexer {
    var source: String
    var pos: Float
    var line: Float
    var col: Float
    var tokens: List<Token>

    fun init(source: String) {
        this.source = source
        this.pos = 0
        this.line = 1
        this.col = 1
        this.tokens = []
    }

    fun peek(): String {
        if (this.pos >= this.source.length()) return ""
        return this.source.char_at(this.pos)
    }

    fun peek_next(): String {
        if (this.pos + 1 >= this.source.length()) return ""
        return this.source.char_at(this.pos + 1)
    }

    fun advance(): String {
        var ch: String = this.source.char_at(this.pos)
        this.pos = this.pos + 1
        this.col = this.col + 1
        return ch
    }

    fun emit(kind: TokenKind) {
        this.tokens.push(Token.Token(kind, this.line, this.col))
    }

    fun is_digit(ch: String): Bool {
        return "0123456789".contains(ch)
    }

    fun is_alpha(ch: String): Bool {
        return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contains(ch)
    }

    fun is_alnum(ch: String): Bool {
        return this.is_digit(ch) or this.is_alpha(ch)
    }

    fun is_hex(ch: String): Bool {
        return "0123456789abcdefABCDEF".contains(ch)
    }

    fun hex_digit_value(ch: String): Float {
        var idx: Float = "0123456789abcdef".index_of(ch)
        if (idx >= 0) {
            return idx
        }
        return "0123456789ABCDEF".index_of(ch)
    }

    fun skip_whitespace() {
        while (this.pos < this.source.length()) {
            var ch: String = this.peek()
            if (ch == " " or ch == "\t" or ch == "\r") {
                this.advance()
            } else if (ch == "\n") {
                this.line = this.line + 1
                this.col = 1
                this.pos = this.pos + 1
            } else if (ch == "/" and this.peek_next() == "/") {
                // Check for /// doc comment or //! module doc
                if (this.pos + 2 < this.source.length()) {
                    var third: String = this.source.char_at(this.pos + 2)
                    if (third == "/" or third == "!") {
                        // Don't skip — let tokenize() handle it
                        break
                    }
                }
                // Regular comment: skip to end of line
                while (this.pos < this.source.length() and this.peek() != "\n") {
                    this.advance()
                }
            } else {
                break
            }
        }
    }

    fun read_number() {
        var start: Float = this.pos - 1

        // Check for hex literal: 0x or 0X
        if (this.source.char_at(start) == "0") {
            if (this.pos < this.source.length()) {
                var next_ch: String = this.peek()
                if (next_ch == "x" or next_ch == "X") {
                    this.advance() // consume the 'x' or 'X'
                    while (this.pos < this.source.length() and this.is_hex(this.peek())) {
                        this.advance()
                    }
                    // to_number() does not understand the "0x" prefix, so
                    // accumulate the hex digits manually.
                    var digits_start: Float = start + 2
                    var value: Float = 0
                    var i: Float = digits_start
                    while (i < this.pos) {
                        var d: Float = this.hex_digit_value(this.source.char_at(i))
                        value = value * 16 + d
                        i = i + 1
                    }
                    this.emit(TokenKind.TkInt(value))
                    return
                }
            }
        }

        while (this.pos < this.source.length() and this.is_digit(this.peek())) {
            this.advance()
        }

        var has_dot: Bool = false
        if (this.pos < this.source.length() and this.peek() == ".") {
            has_dot = true
            this.advance()
            while (this.pos < this.source.length() and this.is_digit(this.peek())) {
                this.advance()
            }
        }

        var text: String = this.source.slice(start, this.pos)

        if (has_dot) {
            this.emit(TokenKind.TkFloat(text))
        } else {
            var ivalue: Float = text.to_number()
            this.emit(TokenKind.TkInt(ivalue))
        }
    }

    fun read_string() {
        var result: StringBuilder = StringBuilder()
        var has_interp: Bool = false
        while (this.pos < this.source.length() and this.peek() != "\"") {
            var ch: String = this.advance()
            if (ch == "\\") {
                var esc: String = this.advance()
                if (esc == "n") { result.append("\n") }
                else if (esc == "r") { result.append("\r") }
                else if (esc == "t") { result.append("\t") }
                else if (esc == "\\") { result.append("\\") }
                else if (esc == "\"") { result.append("\"") }
                else { result.append(esc) }
            } else if (ch == "$") {
                if (this.pos < this.source.length()) {
                    if (this.peek() == "{") {
                        this.advance() // consume {
                        // Emit prefix string + plus
                        this.emit(TokenKind.TkString(result.to_string()))
                        this.emit(TokenKind.TkPlus)
                        // Lex the interpolated expression, wrapped in (expr).to_string()
                        this.emit(TokenKind.TkLParen)
                        this.read_interpolation()
                        this.emit(TokenKind.TkRParen)
                        this.emit(TokenKind.TkDot)
                        this.emit(TokenKind.TkIdent("to_string"))
                        this.emit(TokenKind.TkLParen)
                        this.emit(TokenKind.TkRParen)
                        this.emit(TokenKind.TkPlus)
                        // Reset for rest of string
                        result = StringBuilder()
                        has_interp = true
                    } else {
                        result.append(ch)
                    }
                } else {
                    result.append(ch)
                }
            } else {
                result.append(ch)
            }
        }
        this.advance() // closing quote
        this.emit(TokenKind.TkString(result.to_string()))
    }

    fun read_interpolation() {
        var depth: Float = 1
        while (this.pos < this.source.length() and depth > 0) {
            this.skip_whitespace()
            if (this.pos >= this.source.length()) break
            var ch: String = this.peek()
            if (ch == "}") {
                depth = depth - 1
                if (depth == 0) {
                    this.advance() // consume closing }
                    return nil
                }
            }
            if (ch == "{") {
                depth = depth + 1
            }
            // Lex one token normally
            var start_pos: Float = this.pos
            var tok_ch: String = this.advance()
            if (this.is_digit(tok_ch)) { this.read_number() }
            else if (this.is_alpha(tok_ch)) {
                var text: String = this.read_identifier()
                this.keyword_or_ident(text)
            }
            else if (tok_ch == "\"") { this.read_string() }
            else if (tok_ch == "(") { this.emit(TokenKind.TkLParen) }
            else if (tok_ch == ")") { this.emit(TokenKind.TkRParen) }
            else if (tok_ch == "+") { this.emit(TokenKind.TkPlus) }
            else if (tok_ch == "-") { this.emit(TokenKind.TkMinus) }
            else if (tok_ch == "*") { this.emit(TokenKind.TkStar) }
            else if (tok_ch == "/") { this.emit(TokenKind.TkSlash) }
            else if (tok_ch == ".") { this.emit(TokenKind.TkDot) }
            else if (tok_ch == ",") { this.emit(TokenKind.TkComma) }
            else if (tok_ch == "[") { this.emit(TokenKind.TkLBracket) }
            else if (tok_ch == "]") { this.emit(TokenKind.TkRBracket) }
        }
    }

    fun read_identifier(): String {
        var start: Float = this.pos - 1
        while (this.pos < this.source.length() and this.is_alnum(this.peek())) {
            this.advance()
        }
        // Trailing ? or ! is part of the identifier (e.g. next?, empty!)
        if (this.pos < this.source.length()) {
            var trail: String = this.peek()
            if (trail == "?" or trail == "!") {
                this.advance()
            }
        }
        return this.source.slice(start, this.pos)
    }

    fun keyword_or_ident(text: String) {
        if (text == "var") { this.emit(TokenKind.TkVar) }
        else if (text == "let") { this.emit(TokenKind.TkLet) }
        else if (text == "fun") { this.emit(TokenKind.TkFun) }
        else if (text == "return") { this.emit(TokenKind.TkReturn) }
        else if (text == "if") { this.emit(TokenKind.TkIf) }
        else if (text == "else") { this.emit(TokenKind.TkElse) }
        else if (text == "while") { this.emit(TokenKind.TkWhile) }
        else if (text == "and") { this.emit(TokenKind.TkAnd) }
        else if (text == "or") { this.emit(TokenKind.TkOr) }
        else if (text == "true") { this.emit(TokenKind.TkTrue) }
        else if (text == "false") { this.emit(TokenKind.TkFalse) }
        else if (text == "nil") { this.emit(TokenKind.TkNil) }
        else if (text == "import") { this.emit(TokenKind.TkImport) }
        else if (text == "as") { this.emit(TokenKind.TkAs) }
        else if (text == "enum") { this.emit(TokenKind.TkEnum) }
        else if (text == "match") { this.emit(TokenKind.TkMatch) }
        else if (text == "class") { this.emit(TokenKind.TkClass) }
        else if (text == "this") { this.emit(TokenKind.TkThis) }
        else if (text == "for") { this.emit(TokenKind.TkFor) }
        else if (text == "in") { this.emit(TokenKind.TkIn) }
        else if (text == "try") { this.emit(TokenKind.TkTry) }
        else if (text == "catch") { this.emit(TokenKind.TkCatch) }
        else if (text == "throw") { this.emit(TokenKind.TkThrow) }
        else if (text == "finally") { this.emit(TokenKind.TkFinally) }
        else if (text == "is") { this.emit(TokenKind.TkIs) }
        else if (text == "yield") { this.emit(TokenKind.TkYield) }
        else { this.emit(TokenKind.TkIdent(text)) }
    }

    fun read_doc_comment(): String {
        // Position is right after /// or //!
        // Skip optional space
        if (this.pos < this.source.length() and this.peek() == " ") {
            this.advance()
        }
        var start: Float = this.pos
        while (this.pos < this.source.length() and this.peek() != "\n") {
            this.advance()
        }
        return this.source.slice(start, this.pos)
    }

    fun tokenize(): List<Token> {
        while (this.pos < this.source.length()) {
            this.skip_whitespace()
            if (this.pos >= this.source.length()) break

            // Check for doc comments before advancing
            if (this.peek() == "/" and this.peek_next() == "/") {
                if (this.pos + 2 < this.source.length()) {
                    var third: String = this.source.char_at(this.pos + 2)
                    if (third == "/") {
                        // /// doc comment
                        this.advance() // first /
                        this.advance() // second /
                        this.advance() // third /
                        var text: String = this.read_doc_comment()
                        this.emit(TokenKind.TkDocComment(text))
                        continue
                    } else if (third == "!") {
                        // //! module doc
                        this.advance() // first /
                        this.advance() // second /
                        this.advance() // !
                        var text: String = this.read_doc_comment()
                        this.emit(TokenKind.TkModuleDoc(text))
                        continue
                    }
                }
            }

            var ch: String = this.advance()

            if (this.is_digit(ch)) { this.read_number() }
            else if (this.is_alpha(ch)) {
                var text: String = this.read_identifier()
                this.keyword_or_ident(text)
            }
            else if (ch == "\"") { this.read_string() }
            else if (ch == "(") { this.emit(TokenKind.TkLParen) }
            else if (ch == ")") { this.emit(TokenKind.TkRParen) }
            else if (ch == "{") { this.emit(TokenKind.TkLBrace) }
            else if (ch == "}") { this.emit(TokenKind.TkRBrace) }
            else if (ch == "[") { this.emit(TokenKind.TkLBracket) }
            else if (ch == "]") { this.emit(TokenKind.TkRBracket) }
            else if (ch == ",") { this.emit(TokenKind.TkComma) }
            else if (ch == ".") { this.emit(TokenKind.TkDot) }
            else if (ch == ":") { this.emit(TokenKind.TkColon) }
            else if (ch == ";") { this.emit(TokenKind.TkSemicolon) }
            else if (ch == "+") { this.emit(TokenKind.TkPlus) }
            else if (ch == "-") {
                if (this.peek() == ">") {
                    this.advance()
                    this.emit(TokenKind.TkArrow)
                } else {
                    this.emit(TokenKind.TkMinus)
                }
            }
            else if (ch == "*") { this.emit(TokenKind.TkStar) }
            else if (ch == "/") { this.emit(TokenKind.TkSlash) }
            else if (ch == "%") { this.emit(TokenKind.TkPercent) }
            else if (ch == "&") { this.emit(TokenKind.TkAmpersand) }
            else if (ch == "^") { this.emit(TokenKind.TkCaret) }
            else if (ch == "~") { this.emit(TokenKind.TkTilde) }
            else if (ch == "@") { this.tokens.push(Token.Token(TokenKind.TkIdent("@"), this.line, this.col)) }
            else if (ch == "|") { this.emit(TokenKind.TkPipe) }
            else if (ch == "!") {
                if (this.peek() == "=") {
                    this.advance()
                    this.emit(TokenKind.TkBangEq)
                } else {
                    this.emit(TokenKind.TkBang)
                }
            }
            else if (ch == "=") {
                if (this.peek() == "=") {
                    this.advance()
                    this.emit(TokenKind.TkEqEq)
                } else if (this.peek() == ">") {
                    this.advance()
                    this.emit(TokenKind.TkFatArrow)
                } else {
                    this.emit(TokenKind.TkEq)
                }
            }
            else if (ch == "<") {
                if (this.peek() == "=") {
                    this.advance()
                    this.emit(TokenKind.TkLtEq)
                } else if (this.peek() == "<") {
                    this.advance()
                    this.emit(TokenKind.TkShiftLeft)
                } else {
                    this.emit(TokenKind.TkLt)
                }
            }
            else if (ch == ">") {
                if (this.peek() == "=") {
                    this.advance()
                    this.emit(TokenKind.TkGtEq)
                } else if (this.peek() == ">") {
                    this.advance()
                    this.emit(TokenKind.TkShiftRight)
                } else {
                    this.emit(TokenKind.TkGt)
                }
            }
        }

        this.emit(TokenKind.TkEof)
        return this.tokens
    }
}

fun lex(source: String): List<Token> {
    var lexer: Lexer = Lexer(source)
    return lexer.tokenize()
}
