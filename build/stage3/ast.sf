// A source region, as produced by the lexer and propagated by the parser.
//
// `line` and `col` are 1-based and name the FIRST character of the region;
// `offset` is a 0-based byte offset into the same source text and `len` is the
// region's length in bytes. Keeping both forms means a diagnostic can print a
// line/caret without re-scanning, and a tool can slice the exact source text
// without recounting lines.
//
// The file is deliberately NOT a field. A span is meaningful only relative to
// the source text it was lexed from, and that text is held by whoever owns the
// parse unit (Parser.source, or the driver's file table). Storing a filename on
// every token would put one string copy per token on the heap for information
// that is constant across the whole unit.
//
// `len == 0` with `line == 0` is the "no span" value — see `span_none()`. A real
// token always has line >= 1, so the two cannot be confused.
enum Span {
    Span(line: Float, col: Float, offset: Float, len: Float)
}

/// The absence of a span. Distinguishable from any real span because the lexer's
/// lines are 1-based, so a real span never has line 0.
fun span_none(): Span {
    return Span.Span(0, 0, 0, 0)
}

/// True when `s` names a real source region.
fun span_is_real(s: Span): Bool {
    return match (s) { Span(line, col, offset, len) => line >= 1 }
}

fun span_line(s: Span): Float {
    return match (s) { Span(line, col, offset, len) => line }
}

fun span_col(s: Span): Float {
    return match (s) { Span(line, col, offset, len) => col }
}

fun span_offset(s: Span): Float {
    return match (s) { Span(line, col, offset, len) => offset }
}

fun span_len(s: Span): Float {
    return match (s) { Span(line, col, offset, len) => len }
}

/// The smallest span covering both `a` and `b`.
///
/// This is what a parser uses to give a compound node the extent of everything
/// it consumed: `span_merge(span_of_first_token, span_of_last_token)`. Either
/// argument may be `span_none()`, in which case the other is returned unchanged
/// — so a desugaring that has a span for only one side still propagates it
/// rather than dropping to no-span.
fun span_merge(a: Span, b: Span): Span {
    if (!span_is_real(a)) { return b }
    if (!span_is_real(b)) { return a }
    var a_off: Float = span_offset(a)
    var b_off: Float = span_offset(b)
    // Start at whichever begins first, so the caller need not order the args.
    var start: Span = a
    var end_off: Float = b_off + span_len(b)
    if (b_off < a_off) {
        start = b
        end_off = a_off + span_len(a)
    }
    var start_off: Float = span_offset(start)
    var length: Float = end_off - start_off
    if (length < 0) { length = 0 }
    return Span.Span(span_line(start), span_col(start), start_off, length)
}

/// `line:col` — the prefix a diagnostic puts in front of its message. Callers
/// prepend the filename; see `Diag.format_span` for the full rendering.
fun span_to_string(s: Span): String {
    if (!span_is_real(s)) { return "<unknown>" }
    return span_line(s).floor().to_string() + ":" + span_col(s).floor().to_string()
}

enum Type {
    IntType,
    FloatType,
    BoolType,
    StringType,
    NilType,
    AnyType,
    ClassType(name: String),
    EnumType(name: String),
    GenericType(base: String, args: List<Type>),
    UnionType(types: List<Type>),
    FuncType(params: List<Type>, ret: Type),
    NullableType(inner: Type)
}

enum Expr {
    IntLit(value: Float),
    FloatLit(value: String),
    BoolLit(value: Bool),
    StringLit(value: String),
    NilLit,
    Variable(name: String),
    Binary(left: Expr, op: String, right: Expr),
    Unary(op: String, right: Expr),
    Call(callee: Expr, args: List<Expr>),
    Assign(name: String, value: Expr),
    Logical(left: Expr, op: String, right: Expr),
    MemberAccess(object: Expr, field: String),
    Match(subject: Expr, arms: List<MatchArm>),
    EnumConstruct(enum_name: String, variant: String, args: List<Expr>),
    Lambda(params: List<Param>, ret_type: String, body: List<Stmt>),
    GetField(object: Expr, field: String),
    SetField(object: Expr, field: String, value: Expr),
    This,
    ListLit(elements: List<Expr>),
    IndexGet(object: Expr, index: Expr),
    IndexSet(object: Expr, index: Expr, value: Expr),
    MethodCall(object: Expr, method: String, args: List<Expr>),
    MapLit,
    BlockExpr(stmts: List<Stmt>, value: Expr),
    IsCheck(value: Expr, type_name: String),
    IfExpr(cond: Expr, then_stmts: List<Stmt>, then_val: Expr, else_stmts: List<Stmt>, else_val: Expr),
    TryExpr(try_stmts: List<Stmt>, try_val: Expr, catch_name: String, catch_stmts: List<Stmt>, catch_val: Expr),
    Yield(value: Expr),
    TupleLit(elements: List<Expr>),
    // Produced by resolve.sf from Variable(name), once, with a scope chain in
    // hand. `kind` is one of local/param/global/func/self/type/unknown; `slot`
    // carries the module prefix for global/func and is "" otherwise. Consumers
    // must read `kind` rather than re-deriving scope from side tables — that
    // re-derivation is BUGS #40.
    Ref(kind: String, name: String, slot: String)
}

enum MatchArm {
    Arm(pattern: Pattern, body: Expr)
}

enum Pattern {
    VariantPattern(variant: String, bindings: List<String>),
    ArrayPattern(elements: List<String>, rest: String),
    NamedWildcard(name: String),
    WildcardPattern,
    LiteralPattern(value: Expr)
}

enum Param {
    Param(name: String, type_ann: Type, default_val: Expr)
}

enum Stmt {
    ExprStmt(expr: Expr),
    VarDecl(name: String, type_ann: String, initializer: Expr, docstring: String),
    FunDecl(name: String, params: List<Param>, ret_type: String, body: List<Stmt>, docstring: String),
    EnumDecl(name: String, variants: List<Variant>, docstring: String),
    // `type_params` holds the declared generic parameter names of `class Box<T>`
    // — ["T"], or [] for a non-generic class. The parser used to consume and
    // *discard* them ("// Skip generic type parameters"), so `T` did not exist
    // anywhere after parsing and no method returning `T` could ever be typed:
    // even a direct `b.getItem(0)` on a `Box<String>` warned "cannot infer type".
    // The source supplies this information; throwing it away is what made the
    // types incomplete (BUGS #95).
    ClassDecl(name: String, type_params: List<String>, parent: String, fields: List<Param>, methods: List<Stmt>, docstring: String),
    Return(value: Expr),
    If(condition: Expr, then_branch: List<Stmt>, else_branch: List<Stmt>),
    While(condition: Expr, body: List<Stmt>),
    Block(stmts: List<Stmt>),
    Break,
    Continue,
    TryCatch(try_body: List<Stmt>, catch_name: String, catch_body: List<Stmt>, finally_body: List<Stmt>),
    Throw(value: Expr),
    LetPattern(pattern: Pattern, value: Expr),
    TypeAlias(name: String, target: String)
}

enum Variant {
    Variant(name: String, fields: String)
}

// Typed value — tracks both the LLVM register name and its Saffron type
enum TypedVal {
    TV(val: String, typ: String)
}

fun type_to_string(t: Type): String {
    return match (t) {
        IntType => "Int"
        FloatType => "Float"
        BoolType => "Bool"
        StringType => "String"
        NilType => "Nil"
        AnyType => "Any"
        ClassType(name) => name
        EnumType(name) => name
        GenericType(base, args) => base
        UnionType(types) => "Union"
        FuncType(params, ret) => "Fun"
        NullableType(inner) => type_to_string(inner) + "|Nil"
    }
}
