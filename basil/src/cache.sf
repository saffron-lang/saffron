//! Cache store — holds query results with TTL-based invalidation.

class CacheEntry {
    var data: Any
    var timestamp: Float
    var stale_time: Float
    var is_stale: Bool

    fun init(data: Any, stale_time: Float) {
        this.data = data
        this.timestamp = 0
        this.stale_time = stale_time
        this.is_stale = false
    }
}

class CacheStore {
    var entries: Map<String, CacheEntry>

    fun init() {
        this.entries = {}
    }

    fun get(key: String): CacheEntry {
        IO.println("[cache] get called for key: " + key)
        var has_it: Bool = this.entries.has(key)
        IO.println("[cache] has_it:")
        IO.println(has_it)
        if (has_it) {
            IO.println("[cache] found in cache, returning entry")
            return this.entries.get(key)
        }
        IO.println("[cache] NOT found, returning nil")
        return nil
    }

    fun set(key: String, data: Any, stale_time: Float) {
        this.entries.set(key, CacheEntry(data, stale_time))
    }

    fun invalidate(key: String) {
        if (this.entries.has(key)) {
            this.entries.get(key).is_stale = true
        }
    }

    fun invalidate_matching(prefix: String) {
        var keys: List<String> = this.entries.keys()
        var i: Int = 0
        while (i < keys.length()) {
            if (keys[i].starts_with(prefix)) {
                this.entries.get(keys[i]).is_stale = true
            }
            i = i + 1
        }
    }

    fun remove(key: String) {
        if (this.entries.has(key)) {
            this.entries.set(key, nil)
        }
    }
}

var store: CacheStore = CacheStore()
