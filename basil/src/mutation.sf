//! Mutation — typed POST/PUT/DELETE with cache invalidation.
//!
//! Usage:
//!   import "basil/mutation" as Mutation
//!   var publish = Mutation.mutation<PublishRequest, PublishResponse>("/api/v1/publish")
//!   publish.mutate(PublishRequest("pkg", "1.0", data))
//!   publish.data.get()  // Signal<PublishResponse?>

import "turmeric/signal" as Signal
import "@json" as JSON
import "./cache.sf" as Cache
import "./fetch.sf" as Fetch

class Mutation<TRequest, TResponse> {
    var url: String
    var method: String
    var data: Signal.Signal<TResponse>
    var isLoading: Signal.Signal<Bool>
    var error: Signal.Signal<String>
    var _on_success: (TResponse) => Nil
    var _invalidates: List<String>
    var _cancelled: Bool
    var _mutation_id: Float

    fun init(url: String, method: String) {
        this.url = url
        this.method = method
        this.data = Signal.signal(nil)
        this.isLoading = Signal.signal(false)
        this.error = Signal.signal("")
        this._on_success = nil
        this._invalidates = []
        this._cancelled = false
        this._mutation_id = 0
    }

    fun mutate(body: TRequest) {
        this.isLoading.set(true)
        this.error.set("")
        this._mutation_id = this._mutation_id + 1
        var expected_id: Float = this._mutation_id
        var self = this
        var body_json: String = JSON.to_string(body)
        Fetch.post(self.url, body_json, fun (response: String) => {
            if (self._cancelled or self._mutation_id != expected_id) { return }
            Signal.batch(fun () => {
                var parsed: TResponse = JSON.parse_as<TResponse>(response)
                if (parsed != nil) {
                    self.data.set(parsed)
                    self.error.set("")
                    var i: Float = 0
                    while (i < self._invalidates.length()) {
                        Cache.store.invalidate_matching(self._invalidates[i])
                        i = i + 1
                    }
                    if (self._on_success != nil) {
                        self._on_success(parsed)
                    }
                } else {
                    self.error.set("Request failed")
                }
                self.isLoading.set(false)
            })
        })
    }

    fun invalidates(prefixes: List<String>): Mutation<TRequest, TResponse> {
        this._invalidates = prefixes
        return this
    }

    fun on_success(handler: (TResponse) => Nil): Mutation<TRequest, TResponse> {
        this._on_success = handler
        return this
    }

    fun cancel() {
        this._cancelled = true
        this.isLoading.set(false)
    }

    fun reset() {
        this.data.set(nil)
        this.error.set("")
        this.isLoading.set(false)
    }
}

/// Create a typed mutation (defaults to POST).
fun mutation<TRequest, TResponse>(url: String): Mutation<TRequest, TResponse> {
    return Mutation<TRequest, TResponse>(url, "POST")
}

/// Create a typed mutation with explicit HTTP method.
fun mutation_method<TRequest, TResponse>(url: String, method: String): Mutation<TRequest, TResponse> {
    return Mutation<TRequest, TResponse>(url, method)
}
