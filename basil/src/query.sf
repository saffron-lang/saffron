//! Query — typed, cached, signal-based data fetching.
//!
//! Usage:
//!   import "basil/query" as Query
//!   var packages = Query.query<PackageList>("/api/v1/packages")
//!   packages.data.get()       // Signal<PackageList?>
//!   packages.isLoading.get()  // Signal<Bool>
//!   packages.refetch()

import "turmeric/signal" as Signal
import "@json" as JSON
import "./cache.sf" as BasilCache
import "./fetch.sf" as BasilFetch

class Query<T> {
    var url: String
    var data: Signal.Signal<T>
    var isLoading: Signal.Signal<Bool>
    var error: Signal.Signal<String>
    var _stale_time: Float
    var _cancelled: Bool
    var _fetch_id: Float
    var _on_data: (T) => Nil

    fun init(url: String, stale_time: Float) {
        this.url = url
        this.data = Signal.signal(nil)
        this.isLoading = Signal.signal(false)
        this.error = Signal.signal("")
        this._stale_time = stale_time
        this._cancelled = false
        this._fetch_id = 0
        this._on_data = nil
        this._do_fetch()
    }

    fun _do_fetch() {
        this.isLoading.set(true)
        this._fetch_id = this._fetch_id + 1
        var expected_id: Float = this._fetch_id
        var self = this
        BasilFetch.get(self.url, fun (response: String) => {
            if (self._cancelled or self._fetch_id != expected_id) { return }
            Signal.batch(fun () => {
                var parsed = JSON.parse(response)
                if (parsed != nil) {
                    self.data.set(parsed)
                    self.error.set("")
                    if (self._on_data != nil) {
                        self._on_data(parsed)
                    }
                } else {
                    self.error.set("Failed to parse response")
                }
                self.isLoading.set(false)
            })
        })
    }

    fun on_data(handler: (T) => Nil): Query<T> {
        this._on_data = handler
        // If data already arrived, fire immediately
        var current = this.data.value
        if (current != nil) {
            handler(current)
        }
        return this
    }

    fun refetch() {
        this._do_fetch()
    }

    fun invalidate() {
        this.data.set(nil)
    }

    fun cancel() {
        this._cancelled = true
        this.isLoading.set(false)
    }
}

var DEFAULT_STALE_TIME: Float = 30.0

/// Create a typed cached query.
fun query(url: String): Query {
    return Query(url, DEFAULT_STALE_TIME)
}

/// Create a typed cached query with custom stale time.
fun query_with(url: String, stale_time: Float): Query {
    return Query(url, stale_time)
}
