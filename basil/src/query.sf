//! Query — cached, signal-based data fetching for Turmeric apps.
//!
//! Usage:
//!   var packages = Q.query("/api/v1/packages")
//!   // In component:
//!   if (packages.isLoading.get()) { ... }
//!   var data = packages.data.get()

import "turmeric/signal" as Sig
import "@json" as JSON
import "./cache.sf" as Cache
import "./fetch.sf" as Fetch

class Query {
    var url: String
    var data: Sig.Signal<Any>
    var isLoading: Sig.Signal<Bool>
    var error: Sig.Signal<String>
    var _stale_time: Float

    fun init(url: String, stale_time: Float) {
        this.url = url
        this.data = Sig.signal(nil)
        this.isLoading = Sig.signal(false)
        this.error = Sig.signal("")
        this._stale_time = stale_time
        this._fetch()
    }

    fun _fetch() {
        // Check cache first
        var cached: Cache.CacheEntry = Cache.store.get(this.url)
        if (cached != nil and !cached.is_stale) {
            this.data.set(cached.data)
            return
        }

        this.isLoading.set(true)
        var self = this
        Fetch.get(this.url, fun (response: String) => {
            var parsed = JSON.parse(response)
            if (parsed != nil) {
                self.data.set(parsed)
                self.error.set("")
                Cache.store.set(self.url, parsed, self._stale_time)
            } else {
                self.error.set("Failed to parse response")
            }
            self.isLoading.set(false)
        })
    }

    fun refetch() {
        Cache.store.invalidate(this.url)
        this._fetch()
    }

    fun invalidate() {
        Cache.store.invalidate(this.url)
    }
}

/// Default stale time in seconds
var DEFAULT_STALE_TIME: Float = 30.0

/// Create a cached query for a GET endpoint
fun query(url: String): Query {
    return Query(url, DEFAULT_STALE_TIME)
}

/// Create a cached query with custom stale time
fun query_with(url: String, stale_time: Float): Query {
    return Query(url, stale_time)
}
