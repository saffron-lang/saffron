//! Fetch wrapper — async HTTP requests via browser fetch API.

@extern("void js_fetch_json(void*, i64)") fun _fetch_json(url: String, callback_id: Float)
@extern("void js_fetch_post(void*, void*, i64)") fun _fetch_post(url: String, body: String, callback_id: Float)

var _next_id: Float = 0
var _callbacks: Map<Float, (String) => Nil> = {}

fun get(url: String, callback: (String) => Nil) {
    _next_id = _next_id + 1
    var id: Float = _next_id
    _callbacks.set(id, callback)
    _fetch_json(url, id)
}

fun post(url: String, body: String, callback: (String) => Nil) {
    _next_id = _next_id + 1
    var id: Float = _next_id
    _callbacks.set(id, callback)
    _fetch_post(url, body, id)
}

fun __on_fetch_complete(id: Float, response: String) {
    if (_callbacks.has(id)) {
        _callbacks.get(id)(response)
        _callbacks.set(id, nil)
    }
}
