import "@test" as Test
import "../src/mutation.sf" as Mutation

Test.assert(true, "basil mutation module loads")

class PublishRequest {
    var name: String
    var version: String
}

class PublishResponse {
    var ok: Bool
    var package_name: String
}

// Test typed mutation creation
var publish = Mutation.mutation<PublishRequest, PublishResponse>("/api/v1/publish")
Test.assert_eq(publish.url, "/api/v1/publish", "mutation has correct url")
Test.assert_eq(publish.method, "POST", "default method is POST")
Test.assert_eq(publish.isLoading.get(), false, "initial isLoading is false")
Test.assert(publish.data.get() == nil, "initial data is nil")
Test.assert_eq(publish.error.get(), "", "initial error is empty")

// Test with explicit method
var yank = Mutation.mutation_method<String, String>("/api/v1/yank", "DELETE")
Test.assert_eq(yank.method, "DELETE", "explicit method set")

// Test invalidates chaining (returns same typed mutation)
var pub2 = Mutation.mutation<PublishRequest, PublishResponse>("/api/v1/publish")
    .invalidates(["/api/v1/packages", "/api/v1/search"])
Test.assert_eq(pub2._invalidates.length(), 2, "invalidates list set")
Test.assert_eq(pub2._invalidates[0], "/api/v1/packages", "first prefix")
Test.assert_eq(pub2._invalidates[1], "/api/v1/search", "second prefix")

// Test on_success chaining
var success_called: Bool = false
var pub3 = Mutation.mutation<PublishRequest, PublishResponse>("/api/v1/publish")
    .on_success(fun (data: PublishResponse) => { success_called = true })
Test.assert(pub3._on_success != nil, "on_success handler set")

// Test reset
publish.isLoading.set(true)
publish.error.set("something went wrong")
publish.reset()
Test.assert_eq(publish.isLoading.get(), false, "reset clears isLoading")
Test.assert_eq(publish.error.get(), "", "reset clears error")
Test.assert(publish.data.get() == nil, "reset clears data")

Test.summary()
