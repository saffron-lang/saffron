import "@test" as T
import "../src/cache.sf" as Cache

T.assert(true, "basil cache module loads")

// Test cache store creation
var store = Cache.CacheStore()
T.assert_eq(store.entries.keys().length(), 0, "new store is empty")

// Test set and get
store.set("/api/packages", "data1", 30.0)
var entry = store.get("/api/packages")
T.assert(entry != nil, "get returns entry after set")
T.assert_eq(entry.data, "data1", "entry has correct data")
T.assert_eq(entry.stale_time, 30.0, "entry has correct stale_time")
T.assert_eq(entry.is_stale, false, "new entry is not stale")

// Test overwrite
store.set("/api/packages", "data2", 60.0)
var updated = store.get("/api/packages")
T.assert_eq(updated.data, "data2", "overwritten entry has new data")
T.assert_eq(updated.stale_time, 60.0, "overwritten entry has new stale_time")

// Test cache miss
var miss = store.get("/api/nonexistent")
T.assert(miss == nil, "get returns nil for missing key")

// Test invalidate single entry
store.set("/api/users", "users_data", 30.0)
T.assert_eq(store.get("/api/users").is_stale, false, "before invalidate: not stale")
store.invalidate("/api/users")
T.assert_eq(store.get("/api/users").is_stale, true, "after invalidate: stale")
T.assert_eq(store.get("/api/users").data, "users_data", "invalidated entry retains data")

// Test invalidate_matching (prefix-based)
store.set("/api/users/1", "user1", 30.0)
store.set("/api/users/2", "user2", 30.0)
store.set("/api/users/3", "user3", 30.0)
store.set("/api/posts", "posts", 30.0)
store.invalidate_matching("/api/users")
T.assert_eq(store.get("/api/users/1").is_stale, true, "prefix match invalidates /users/1")
T.assert_eq(store.get("/api/users/2").is_stale, true, "prefix match invalidates /users/2")
T.assert_eq(store.get("/api/users/3").is_stale, true, "prefix match invalidates /users/3")
T.assert_eq(store.get("/api/posts").is_stale, false, "prefix match doesn't invalidate /posts")

// Test remove
store.set("/api/temp", "temp_data", 30.0)
T.assert(store.get("/api/temp") != nil, "entry exists before remove")
store.remove("/api/temp")
T.assert(store.get("/api/temp") == nil, "entry is nil after remove")

// Test remove nonexistent (should not crash)
store.remove("/api/never_existed")
T.assert(true, "removing nonexistent key doesn't crash")

// Test multiple stores are independent
var store2 = Cache.CacheStore()
store2.set("/other", "other_data", 10.0)
T.assert(store.get("/other") == nil, "stores are independent")
T.assert_eq(store2.get("/other").data, "other_data", "second store has its data")

T.summary()
