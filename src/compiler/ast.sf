// A source region, as produced by the lexer and propagated by the parser.
//
// `line` and `col` are 1-based and name the FIRST character of the region;
// `offset` is a 0-based byte offset into the same source text and `len` is the
// region's length in bytes. Keeping both forms means a diagnostic can print a
// line/caret without re-scanning, and a tool can slice the exact source text
// without recounting lines.
//
// The file is deliberately NOT a field. A span is meaningful only relative to
// the source text it was lexed from, and that text is held by whoever owns the
// parse unit (Parser.source, or the driver's file table). Storing a filename on
// every token would put one string copy per token on the heap for information
// that is constant across the whole unit.
//
// `len == 0` with `line == 0` is the "no span" value — see `span_none()`. A real
// token always has line >= 1, so the two cannot be confused.
enum Span {
    Span(line: Float, col: Float, offset: Float, len: Float)
}

/// The absence of a span. Distinguishable from any real span because the lexer's
/// lines are 1-based, so a real span never has line 0.
fun span_none(): Span {
    return Span.Span(0, 0, 0, 0)
}

/// True when `s` names a real source region.
fun span_is_real(s: Span): Bool {
    return match (s) { Span(line, col, offset, len) => line >= 1 }
}

fun span_line(s: Span): Float {
    return match (s) { Span(line, col, offset, len) => line }
}

fun span_col(s: Span): Float {
    return match (s) { Span(line, col, offset, len) => col }
}

fun span_offset(s: Span): Float {
    return match (s) { Span(line, col, offset, len) => offset }
}

fun span_len(s: Span): Float {
    return match (s) { Span(line, col, offset, len) => len }
}

/// The smallest span covering both `a` and `b`.
///
/// This is what a parser uses to give a compound node the extent of everything
/// it consumed: `span_merge(span_of_first_token, span_of_last_token)`. Either
/// argument may be `span_none()`, in which case the other is returned unchanged
/// — so a desugaring that has a span for only one side still propagates it
/// rather than dropping to no-span.
fun span_merge(a: Span, b: Span): Span {
    if (!span_is_real(a)) { return b }
    if (!span_is_real(b)) { return a }
    var a_off: Float = span_offset(a)
    var b_off: Float = span_offset(b)
    // Start at whichever begins first, so the caller need not order the args.
    var start: Span = a
    var end_off: Float = b_off + span_len(b)
    if (b_off < a_off) {
        start = b
        end_off = a_off + span_len(a)
    }
    var start_off: Float = span_offset(start)
    var length: Float = end_off - start_off
    if (length < 0) { length = 0 }
    return Span.Span(span_line(start), span_col(start), start_off, length)
}

/// `line:col` — the prefix a diagnostic puts in front of its message. Callers
/// prepend the filename; see `Diag.format_span` for the full rendering.
fun span_to_string(s: Span): String {
    if (!span_is_real(s)) { return "<unknown>" }
    return span_line(s).floor().to_string() + ":" + span_col(s).floor().to_string()
}

enum Type {
    IntType,
    FloatType,
    BoolType,
    StringType,
    NilType,
    AnyType,
    ClassType(name: String),
    EnumType(name: String),
    GenericType(base: String, args: List<Type>),
    UnionType(types: List<Type>),
    FuncType(params: List<Type>, ret: Type),
    NullableType(inner: Type),
    // The three bottom-ish members the type lattice used to conflate into one.
    // `AnyType` above is the honest "runtime decides" answer and stays
    // user-writable; these two are not user-writable and mean different things:
    //
    //   UnknownType — inference has not resolved this yet. Legal ONLY inside
    //     inference. It must never reach codegen: the old behaviour was to
    //     answer `Int` when nothing was known, which is how a missing inference
    //     became a wrong i64 instead of a diagnostic (mechanism M2 in
    //     docs/design/compiler-rewrite.md, invariant I2).
    //   NeverType — this expression does not return (throw, or a call that
    //     always diverges). Legal anywhere; unifies with everything, because a
    //     branch that cannot produce a value must not constrain its sibling.
    //
    // Appended last, like `visibility` on the Stmt nodes above and for the same
    // reason: appending leaves every pre-existing variant on the tag it already
    // had, so a match arm that was missed in the sweep still binds correctly
    // rather than silently reading a neighbour's payload.
    UnknownType,
    NeverType
}

// Expressions carry spans on exactly the *reference-bearing* variants, and on
// each one the span covers the identifier a user would click, not the whole
// expression. That asymmetry is the point:
//
//   Variable / Ref / Assign   name_span   — the bare name
//   MemberAccess / GetField / SetField
//                             field_span  — the `.field` identifier, NOT the object
//   MethodCall                method_span — the `.method` identifier, NOT the args
//   Call                      full_span   — callee through the closing paren
//
// Go-to-definition, find-references and rename all resolve an *identifier*, so
// a span covering `obj.field` would rename `obj` too. `Call` is the exception
// because nothing in it is an identifier of its own — its callee has a span
// already — and what a caller wants from it is the extent to underline for a
// wrong-arity or wrong-argument-type error.
//
// Literals, `Binary`, `Logical`, `Unary`, `ListLit` and friends deliberately go
// without: their sub-expressions carry the spans, and no editor feature resolves
// a `+`. Adding a span to every node would double the sweep for nodes nothing
// reads. Spans arrive where a consumer exists, not everywhere they could.
//
// Every span is appended LAST on its variant, for the same tag-stability reason
// as the declaration nodes: an arm that was not updated binds the pre-existing
// fields correctly and simply lacks the span, rather than reading a neighbour's
// payload as one. And because the arity check is exact, such an arm is a named
// compile error rather than a silent misread.
enum Expr {
    IntLit(value: Float),
    FloatLit(value: String),
    BoolLit(value: Bool),
    StringLit(value: String),
    NilLit,
    Variable(name: String, name_span: Span),
    Binary(left: Expr, op: String, right: Expr),
    Unary(op: String, right: Expr),
    Call(callee: Expr, args: List<Expr>, full_span: Span),
    Assign(name: String, value: Expr, name_span: Span),
    Logical(left: Expr, op: String, right: Expr),
    MemberAccess(object: Expr, field: String, field_span: Span),
    Match(subject: Expr, arms: List<MatchArm>),
    EnumConstruct(enum_name: String, variant: String, args: List<Expr>),
    Lambda(params: List<Param>, ret_type: String, body: List<Stmt>),
    GetField(object: Expr, field: String, field_span: Span),
    SetField(object: Expr, field: String, value: Expr, field_span: Span),
    This,
    ListLit(elements: List<Expr>),
    IndexGet(object: Expr, index: Expr),
    IndexSet(object: Expr, index: Expr, value: Expr),
    MethodCall(object: Expr, method: String, args: List<Expr>, method_span: Span),
    MapLit,
    BlockExpr(stmts: List<Stmt>, value: Expr),
    IsCheck(value: Expr, type_name: String),
    IfExpr(cond: Expr, then_stmts: List<Stmt>, then_val: Expr, else_stmts: List<Stmt>, else_val: Expr),
    TryExpr(try_stmts: List<Stmt>, try_val: Expr, catch_name: String, catch_stmts: List<Stmt>, catch_val: Expr),
    Yield(value: Expr),
    TupleLit(elements: List<Expr>),
    // Produced by resolve.sf from Variable(name), once, with a scope chain in
    // hand. `kind` is one of local/param/global/func/self/type/unknown; `slot`
    // carries the module prefix for global/func and is "" otherwise. Consumers
    // must read `kind` rather than re-deriving scope from side tables — that
    // re-derivation is BUGS #40.
    //
    // `name_span` is carried straight over from the Variable it replaced. resolve
    // runs between the parser and codegen, so dropping it here would mean every
    // post-resolve consumer — which is all of codegen — sees an unlocatable name,
    // and the resolve pass is exactly where "which definition is this?" is known.
    Ref(kind: String, name: String, slot: String, name_span: Span)
}

/// Where to point a diagnostic that is about `expr`.
///
/// MUST stay below `enum Expr`. Codegen registers variant tags as it generates
/// the enum declaration, so a match textually above it finds no tags, silently
/// takes the unknown-enum path, and compiles to an unconditional destructure of
/// the first arm with no tag check at all — reading past the allocation and
/// segfaulting on any variant with fewer fields. Moving this function up is a
/// mechanical-looking edit that miscompiles it. See BUGS #154.
///
/// Every expression that carries a span answers with it; anything else answers
/// `span_none()`, which `error_at` renders exactly as `error` did. So a caller
/// can hand this any expression and the result is never worse than no span.
///
/// `Call` answers with its full extent (callee through the closing paren) rather
/// than its callee's name, because a call's *shape* is what a wrong-arity or
/// wrong-argument-type message is about. A `Call` wrapping a named callee is the
/// one node where both would be defensible; the extent is chosen because it is
/// what the reader needs to see to judge the message.
///
/// Deliberately not recursive: `Binary`/`Unary`/`Index` have no span of their
/// own, and descending into a child would point at a sub-expression the message
/// is not about — a plausible-looking location is worse than an honest absent
/// one, because the reader trusts it. Callers with a better idea of which child
/// is at fault should ask about that child directly, which is what
/// `check_call_args` does with `args[i]`.
///
/// This lives here, not in `src/lib/ast.sf`'s wrapper of the same name, because
/// the checker imports this file and cannot import the stdlib (see the
/// no-stdlib-deps rule at the top of `diag.sf`).
fun expr_span(expr: Expr): Span {
    return match (expr) {
        Call(__callee, __args, __cs) => __cs
        Variable(__n, __vs) => __vs
        Ref(__k, __rn, __slot, __rs) => __rs
        Assign(__an, __av, __as) => __as
        MemberAccess(__mo, __mf, __ms) => __ms
        GetField(__go, __gf, __gs) => __gs
        SetField(__so, __sf, __sv, __ss) => __ss
        MethodCall(__ko, __km, __ka, __ks) => __ks
        _ => span_none()
    }
}

enum MatchArm {
    Arm(pattern: Pattern, body: Expr)
}

enum Pattern {
    VariantPattern(variant: String, bindings: List<String>),
    ArrayPattern(elements: List<String>, rest: String),
    NamedWildcard(name: String),
    WildcardPattern,
    LiteralPattern(value: Expr)
}

enum Param {
    // Param carries class *fields* and function *params* — the same node in two
    // roles — so `visibility` here is read by two different rules in Phase 4:
    // a field's visibility is class-scoped, a parameter's is meaningless and stays
    // "public" forever. Appended last, as on every widened declaration node; see
    // the note on TypeAlias in `Stmt` for why that position.
    //
    // `name_span` covers the parameter/field *name* only — it is the rename and
    // go-to-definition target, so it must not include the type annotation. A
    // param the parser synthesized (a desugared destructuring, an implicit
    // `init`) has `span_none()`; see the note on Stmt's spans.
    Param(name: String, type_ann: Type, default_val: Expr, visibility: String, name_span: Span)
}

enum Stmt {
    ExprStmt(expr: Expr),
    // Every declaration node carries two spans, appended after `visibility` for
    // the same tag-stability reason `visibility` itself was appended last (see
    // the TypeAlias note at the bottom of this enum):
    //
    //   name_span — the declared *name* alone. This is the precise target a
    //     rename rewrites, a go-to-definition jumps to, and a document-symbol
    //     highlights. It deliberately excludes the type annotation and body, so
    //     renaming `foo` cannot disturb `: String`.
    //   full_span — the whole declaration, first token through last. This is the
    //     foldable region and the extent a diagnostic underlines when the fault
    //     is the declaration as a whole rather than its name.
    //
    // Both are `span_none()` on a node the parser *synthesized* rather than read:
    // desugared `for-in` bindings, an implicit `init`, the temporaries a
    // destructuring `let` expands to. That is not a gap to fill in later — a
    // synthetic node has no source region, and inventing one would make an editor
    // jump to a construct the user never wrote. `span_is_real` is the guard.
    VarDecl(name: String, type_ann: String, initializer: Expr, docstring: String, visibility: String, name_span: Span, full_span: Span),
    FunDecl(name: String, params: List<Param>, ret_type: String, body: List<Stmt>, docstring: String, visibility: String, name_span: Span, full_span: Span),
    EnumDecl(name: String, variants: List<Variant>, docstring: String, visibility: String, name_span: Span, full_span: Span),
    // `type_params` holds the declared generic parameter names of `class Box<T>`
    // — ["T"], or [] for a non-generic class. The parser used to consume and
    // *discard* them ("// Skip generic type parameters"), so `T` did not exist
    // anywhere after parsing and no method returning `T` could ever be typed:
    // even a direct `b.getItem(0)` on a `Box<String>` warned "cannot infer type".
    // The source supplies this information; throwing it away is what made the
    // types incomplete (BUGS #95).
    // `parents` holds every name after `extends`, in source order:
    // `class Duck extends Flyable, Swimmable, Walkable` → the three of them,
    // and `[]` for a class with no base. This was a single `parent: String` and
    // the parser threw away parents 2..n ("skip additional interfaces for
    // now"), so `d.swim()` and `d.walk()` were codegen errors and the checker
    // could not see that Duck derives from Swimmable at all. Order is
    // load-bearing: parents[0] keeps the field layout and `init`-forwarding
    // behaviour single inheritance has always had, and later parents only add.
    // `visibility` takes this node to seven fields, which is precisely the shape
    // BUGS #96 segfaulted on: an arm binding only six read the seventh as 0, and
    // `0.starts_with(...)` is `strncmp(NULL, ...)`. `interface` and `actor` parse
    // through this same node, so all three are in the blast radius.
    // `introducer` is the keyword the user actually wrote: "class", "interface" or
    // "actor". All three parse through this one node, and until now which one it
    // was could not be recovered afterwards — `interface` was indistinguishable
    // from `class`, and `actor` was inferred by sniffing an "@actor\n" prefix on
    // `docstring`. That is fine for codegen, which treats them alike, but a tool
    // cannot label an outline entry or pick a symbol kind without it. Reading a
    // keyword out of an overloaded metadata string is the kind of re-derivation
    // BUGS #40 is about; the parser knows the answer, so it records it.
    ClassDecl(name: String, type_params: List<String>, parents: List<String>, fields: List<Param>, methods: List<Stmt>, docstring: String, visibility: String, name_span: Span, full_span: Span, introducer: String),
    Return(value: Expr),
    If(condition: Expr, then_branch: List<Stmt>, else_branch: List<Stmt>),
    While(condition: Expr, body: List<Stmt>),
    Block(stmts: List<Stmt>),
    Break,
    Continue,
    TryCatch(try_body: List<Stmt>, catch_name: String, catch_body: List<Stmt>, finally_body: List<Stmt>),
    Throw(value: Expr),
    LetPattern(pattern: Pattern, value: Expr),
    // `visibility` is one of "public" / "private" / "internal" / "protected".
    // Phase 3 of docs/design/access-modifiers.md adds the field and nothing else:
    // there is no syntax for it yet, so the parser writes "public" everywhere and
    // no reader consults it. It is appended *after* `docstring` on every widened
    // node deliberately — appending leaves every pre-existing field at the index it
    // already had, so a match arm that was missed still binds its old fields
    // correctly and merely lacks `visibility`. Inserting it first or mid-payload
    // would shift `name`/`docstring` by one, and since both are `String` a missed
    // arm would read a plausible *wrong string* instead of nothing, which is
    // exactly BUGS #96's failure shape.
    TypeAlias(name: String, target: String, visibility: String)
}

enum Variant {
    // `fields` is an unparsed "name:Type,…" string. Do not add structured data by
    // widening it — a comma-joined encoding already corrupts on `Map<String,Int>`.
    // `name_span` is the variant name's own region, so an outline can list enum
    // variants as children and rename can retarget one.
    Variant(name: String, fields: String, name_span: Span)
}

// Typed value — tracks both the LLVM register name and its Saffron type
enum TypedVal {
    TV(val: String, typ: String)
}

fun type_to_string(t: Type): String {
    return match (t) {
        IntType => "Int"
        FloatType => "Float"
        BoolType => "Bool"
        StringType => "String"
        NilType => "Nil"
        AnyType => "Any"
        ClassType(name) => name
        EnumType(name) => name
        GenericType(base, args) => base
        UnionType(types) => "Union"
        FuncType(params, ret) => "Fun"
        NullableType(inner) => type_to_string(inner) + "|Nil"
        // Deliberately NOT "Int" and NOT "Any". These strings are what a
        // diagnostic prints, and both must be recognisable on sight: an
        // "Unknown" in compiler output is a bug report, not a type.
        UnknownType => "Unknown"
        NeverType => "Never"
    }
}
