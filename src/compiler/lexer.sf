// Lexer for Saffron-mini

enum TokenKind {
    // Literals
    TkInt(value: Float),
    TkFloat(value: String),
    TkString(value: String),
    TkTrue,
    TkFalse,
    TkNil,

    // Identifiers & keywords
    TkIdent(name: String),
    TkVar,
    TkLet,
    TkFun,
    TkReturn,
    TkIf,
    TkElse,
    TkWhile,
    TkAnd,
    TkOr,
    TkImport,
    TkAs,
    TkEnum,
    TkMatch,
    TkClass,
    TkThis,
    TkFor,
    TkIn,
    TkTry,
    TkCatch,
    TkThrow,
    TkFinally,
    TkIs,
    TkYield,

    // Operators
    TkPlus,
    TkMinus,
    TkStar,
    TkSlash,
    TkPercent,
    TkAmpersand,
    TkPipe,
    TkCaret,
    TkTilde,
    TkShiftLeft,
    TkShiftRight,
    TkBang,
    TkBangEq,
    TkEq,
    TkEqEq,
    TkLt,
    TkLtEq,
    TkGt,
    TkGtEq,
    // Compound assignment and increment/decrement. Appended at the end of the
    // operator group rather than next to their base operators so that every
    // pre-existing variant keeps the tag it already had — the same reason the
    // AST's widened nodes append fields instead of inserting them.
    //
    // Adding `++` and `--` makes the lexer maximal-munch on those two
    // characters, so `3--2` is now `3 -- 2` and a parse error rather than
    // `3 - (-2)`. That is C's and JavaScript's reading of the same text; write
    // `3 - -2` for the subtraction. Nothing in the tree relied on the old
    // spelling (checked: no `--`, `++` or `+=` outside strings and comments
    // anywhere under src/, test/, tools/ or the app directories).
    TkPlusEq,
    TkMinusEq,
    TkStarEq,
    TkSlashEq,
    TkPercentEq,
    TkPlusPlus,
    TkMinusMinus,

    // Delimiters
    TkLParen,
    TkRParen,
    TkLBrace,
    TkRBrace,
    TkLBracket,
    TkRBracket,
    TkComma,
    TkDot,
    TkColon,
    TkSemicolon,
    TkArrow,
    TkFatArrow,
    TkQuestion,

    // Documentation
    TkDocComment(text: String),
    TkModuleDoc(text: String),

    // Special
    TkNewline,
    TkEof
}

// `line` and `col` name the token's FIRST character; `offset` is its 0-based
// byte offset into the source and `len` its length in bytes. Together the last
// three make up a span (see `AST.Span`) — they are stored inline rather than as
// a nested Span value so that reading a token's position costs one match instead
// of two, and so that widening this variant did not also require every existing
// `Token(kind, line, col)` arm to learn a new type.
//
// `line`/`col` used to be the position *after* the token was consumed, because
// `emit` read the lexer's cursor at emit time and `advance()` had already moved
// it. Every parse diagnostic's caret therefore pointed one column past the token
// it was complaining about, and multi-character tokens reported the column of
// their last character. `token_start_*`, captured before the token is scanned,
// is what makes the caret land on the offending character.
enum Token {
    Token(kind: TokenKind, line: Float, col: Float, offset: Float, len: Float)
}

// The Token -> AST.Span conversion lives in parser.sf rather than here on
// purpose: this file imports nothing, and bootstrap compiles it as its own unit
// (SOURCES=(lexer parser)). Importing ast.sf just to name a return type would
// make the lexer's compilation depend on the AST for no other reason.

// `\xNN` needs to turn a byte VALUE into a one-character String, and the
// language has no primitive for that (BUGS #152) — which is exactly why
// src/lib/base64.sf builds a 128-character ASCII table out of `\x` escapes,
// src/lib/url.sf has a 100-branch if-chain, and src/lib/bytes.sf gives up and
// returns "?". So the lexer allocates the two bytes itself.
//
// rt_malloc, not the GC: per BUGS #23 a NaN-tagged pointer is rejected by
// __gc_is_heap_ptr, so GC-allocating here would have the collector sweep the
// string while it is still live. __str_get (runtime.sf:1476) leaks its 2-byte
// buffer for the same reason and says so; this leaks one buffer per `\x`
// escape in the source text, which is bounded by the source and freed at exit.
@extern("void* malloc(i64)")
fun __lex_malloc(n: Int): Int
@intrinsic fun __lex_store8(addr: Int, val: Int)

class Lexer {
    var source: String
    var pos: Float
    var line: Float
    var col: Float
    var tokens: List<Token>
    // Position of the first character of the token currently being scanned.
    // `tokenize` and `read_interpolation` set these immediately before dispatching
    // on the lead character; `emit` reads them rather than the live cursor.
    var token_start_pos: Float
    var token_start_line: Float
    var token_start_col: Float

    fun init(source: String) {
        this.source = source
        this.pos = 0
        this.line = 1
        this.col = 1
        this.tokens = []
        this.token_start_pos = 0
        this.token_start_line = 1
        this.token_start_col = 1
    }

    /// Record where the token about to be scanned begins. Called with the cursor
    /// still on the token's first character.
    fun begin_token() {
        this.token_start_pos = this.pos
        this.token_start_line = this.line
        this.token_start_col = this.col
    }

    fun peek(): String {
        if (this.pos >= this.source.length()) return ""
        return this.source.char_at(this.pos)
    }

    fun peek_next(): String {
        if (this.pos + 1 >= this.source.length()) return ""
        return this.source.char_at(this.pos + 1)
    }

    fun peek_at(offset: Float): String {
        if (this.pos + offset >= this.source.length()) return ""
        return this.source.char_at(this.pos + offset)
    }

    fun advance(): String {
        var ch: String = this.source.char_at(this.pos)
        this.pos = this.pos + 1
        this.col = this.col + 1
        return ch
    }

    fun emit(kind: TokenKind) {
        // Length is measured from the recorded start to the live cursor, so a
        // multi-character token (an identifier, a number, `>>=`) gets its real
        // extent without each scanner having to report one.
        var len: Float = this.pos - this.token_start_pos
        if (len < 0) { len = 0 }
        this.tokens.push(Token.Token(kind, this.token_start_line, this.token_start_col,
            this.token_start_pos, len))
    }

    /// Emit a token at an explicitly supplied position, with length 0.
    ///
    /// Used for the scaffolding tokens `read_string` synthesizes when it
    /// desugars an interpolation — the parens, `+`s and `.to_string()` that no
    /// one wrote. They are given the span of the string literal they came from,
    /// so a diagnostic on the desugared expression still points at that string
    /// rather than at whatever token the interpolation lexer happened to leave
    /// in `token_start_*`. Length 0 marks them as standing for no source text.
    fun emit_at(kind: TokenKind, line: Float, col: Float, offset: Float) {
        this.tokens.push(Token.Token(kind, line, col, offset, 0))
    }

    fun is_digit(ch: String): Bool {
        return "0123456789".contains(ch)
    }

    fun is_alpha(ch: String): Bool {
        return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contains(ch)
    }

    fun is_alnum(ch: String): Bool {
        return this.is_digit(ch) or this.is_alpha(ch)
    }

    fun is_hex(ch: String): Bool {
        return "0123456789abcdefABCDEF".contains(ch)
    }

    fun hex_digit_value(ch: String): Float {
        var idx: Float = "0123456789abcdef".index_of(ch)
        if (idx >= 0) {
            return idx
        }
        return "0123456789ABCDEF".index_of(ch)
    }

    fun skip_whitespace() {
        while (this.pos < this.source.length()) {
            var ch: String = this.peek()
            if (ch == " " or ch == "\t" or ch == "\r") {
                this.advance()
            } else if (ch == "\n") {
                this.line = this.line + 1
                this.col = 1
                this.pos = this.pos + 1
            } else if (ch == "/" and this.peek_next() == "/") {
                // Check for /// doc comment or //! module doc
                if (this.pos + 2 < this.source.length()) {
                    var third: String = this.source.char_at(this.pos + 2)
                    if (third == "/" or third == "!") {
                        // Don't skip — let tokenize() handle it
                        break
                    }
                }
                // Regular comment: skip to end of line
                while (this.pos < this.source.length() and this.peek() != "\n") {
                    this.advance()
                }
            } else if (ch == "/" and this.peek_next() == "*") {
                // Block comment. These nest, so `/* outer /* inner */ outer */`
                // is one comment — that makes commenting out a region that
                // already contains a block comment work. Newlines inside still
                // have to bump this.line or every diagnostic after the comment
                // reports the wrong line.
                this.advance() // consume '/'
                this.advance() // consume '*'
                var depth: Float = 1
                while (depth > 0 and this.pos < this.source.length()) {
                    var c: String = this.peek()
                    if (c == "/" and this.peek_next() == "*") {
                        this.advance()
                        this.advance()
                        depth = depth + 1
                    } else if (c == "*" and this.peek_next() == "/") {
                        this.advance()
                        this.advance()
                        depth = depth - 1
                    } else if (c == "\n") {
                        this.line = this.line + 1
                        this.col = 1
                        this.pos = this.pos + 1
                    } else {
                        this.advance()
                    }
                }
                // An unterminated comment runs to EOF. There is no diagnostic
                // channel in the lexer, so the parser sees EOF and reports it.
            } else {
                break
            }
        }
    }

    fun read_number() {
        var start: Float = this.pos - 1

        // Check for hex literal: 0x or 0X
        if (this.source.char_at(start) == "0") {
            if (this.pos < this.source.length()) {
                var next_ch: String = this.peek()
                if (next_ch == "x" or next_ch == "X") {
                    this.advance() // consume the 'x' or 'X'
                    while (this.pos < this.source.length() and this.is_hex(this.peek())) {
                        this.advance()
                    }
                    // to_number() does not understand the "0x" prefix, so
                    // accumulate the hex digits manually.
                    var digits_start: Float = start + 2
                    var value: Float = 0
                    var i: Float = digits_start
                    while (i < this.pos) {
                        var d: Float = this.hex_digit_value(this.source.char_at(i))
                        value = value * 16 + d
                        i = i + 1
                    }
                    this.emit(TokenKind.TkInt(value))
                    return
                }
            }
        }

        while (this.pos < this.source.length() and this.is_digit(this.peek())) {
            this.advance()
        }

        var has_dot: Bool = false
        // A `.` immediately followed by a second `.` is not a decimal point.
        // Without this guard `0..5` scanned as TkFloat("0.") TkDot TkInt(5), and
        // the parser's tuple-access branch built IndexGet(0., 5) — a float handed
        // to __list_length/__list_get, which segfaulted with no diagnostic from
        // any stage (BUGS #112). Leaving both dots alone makes `0..5` come out as
        // TkInt(0) TkDot TkDot TkInt(5), which the parser rejects by name, and is
        // also the token stream a real range operator would want.
        var dot_is_decimal: Bool = this.peek() == "." and this.peek_next() != "."
        if (this.pos < this.source.length() and dot_is_decimal) {
            has_dot = true
            this.advance()
            while (this.pos < this.source.length() and this.is_digit(this.peek())) {
                this.advance()
            }
        }

        // Scientific notation: e/E, an optional sign, then at least one digit.
        // The digit is required so that `1.e` or `2E` leave the letter alone for
        // the identifier scanner instead of producing a truncated literal.
        var mantissa_end: Float = this.pos
        var has_exp: Bool = false
        var exp_ch: String = this.peek()
        if (exp_ch == "e" or exp_ch == "E") {
            var digit_offset: Float = 1
            var sign_ch: String = this.peek_next()
            if (sign_ch == "+" or sign_ch == "-") { digit_offset = 2 }
            if (this.is_digit(this.peek_at(digit_offset))) {
                has_exp = true
                this.advance() // e/E
                if (digit_offset == 2) { this.advance() } // sign
                while (this.pos < this.source.length() and this.is_digit(this.peek())) {
                    this.advance()
                }
            }
        }

        var text: String = this.source.slice(start, this.pos)

        if (has_exp) {
            // An exponent always yields a Float. LLVM's IR parser rejects a
            // mantissa with no decimal point ("1e300" is read as an integer
            // constant, which cannot have type double), so supply one when the
            // source omitted it: 1e300 -> 1.0e300.
            if (!has_dot) {
                text = this.source.slice(start, mantissa_end) + ".0" + this.source.slice(mantissa_end, this.pos)
            }
            this.emit(TokenKind.TkFloat(text))
        } else if (has_dot) {
            this.emit(TokenKind.TkFloat(text))
        } else {
            var ivalue: Float = text.to_number()
            this.emit(TokenKind.TkInt(ivalue))
        }
    }

    // One hex digit's value, or -1 if `ch` is not a hex digit.
    fun hex_digit_val(ch: String): Float {
        var lower: String = ch.to_lower()
        var d: Float = "0123456789".index_of(ch)
        if (d >= 0) return d
        var h: Float = "abcdef".index_of(lower)
        if (h >= 0) return h + 10
        return 0 - 1
    }

    // Consume up to `max` hex digits (already past the `\x`) and return the byte
    // as a one-character String. `min` digits are required; short of that the
    // escape is malformed and the literal text is returned so the source still
    // round-trips rather than silently losing characters.
    //
    // `\0` passes min=max=0, i.e. no digits and a value of 0 — see below.
    fun read_hex_escape(min: Float, max: Float): String {
        var val: Float = 0
        var digits: Float = 0
        while (digits < max and this.pos < this.source.length()) {
            var d: Float = this.hex_digit_val(this.peek())
            if (d < 0) break
            val = val * 16 + d
            this.advance()
            digits = digits + 1
        }
        if (digits < min) {
            // Not a hex escape after all. Give back what was written, minus the
            // backslash, matching the old catch-all behaviour for unknown
            // escapes rather than inventing a byte.
            return "x"
        }
        // A String is a NUL-terminated C string (rt_strlen), so an embedded 0
        // byte does not store a NUL — it TERMINATES the literal early, silently
        // discarding everything after it. Refusing to emit it is not pedantry:
        // src/lib/base64.sf:7 builds its byte->char table starting at `\x00`
        // and would get a 1-character table, while its sibling at :11 starts at
        // `\x01` with a comment saying it does so "to avoid null-byte issues".
        // One of the two authors knew. Warn so the next one does too.
        if (val == 0) {
            IO.println("[lexer] Warning: `\\0`/`\\x00` in a string literal is not representable — a String is NUL-terminated, so the literal would end here. Emitting byte 1 instead; use a List<Int> for binary data with zero bytes.")
            val = 1
        }
        return this.byte_to_char(val)
    }

    // Turn a byte value into a one-character String. See the note above the
    // class for why this allocates rather than indexing a table.
    fun byte_to_char(b: Float): String {
        var buf: Int = __lex_malloc(2)
        __lex_store8(buf, b.floor())
        __lex_store8(buf + 1, 0)
        return buf
    }

    fun read_string() {
        var result: StringBuilder = StringBuilder()
        var has_interp: Bool = false
        // The opening quote's position. read_interpolation() re-enters the normal
        // token scanners and so overwrites token_start_*; capturing the literal's
        // own start here is what lets the synthesized scaffolding tokens point
        // back at the string the user actually wrote.
        var lit_line: Float = this.token_start_line
        var lit_col: Float = this.token_start_col
        var lit_off: Float = this.token_start_pos
        while (this.pos < this.source.length() and this.peek() != "\"") {
            var ch: String = this.advance()
            if (ch == "\\") {
                var esc: String = this.advance()
                if (esc == "n") { result.append("\n") }
                else if (esc == "r") { result.append("\r") }
                else if (esc == "t") { result.append("\t") }
                else if (esc == "\\") { result.append("\\") }
                else if (esc == "\"") { result.append("\"") }
                else if (esc == "0") { result.append(this.read_hex_escape(0, 0)) }
                else if (esc == "e") { result.append(this.byte_to_char(27)) }
                else if (esc == "x" or esc == "X") {
                    result.append(this.read_hex_escape(2, 2))
                }
                else { result.append(esc) }
            } else if (ch == "$") {
                if (this.pos < this.source.length()) {
                    if (this.peek() == "{") {
                        this.advance() // consume {
                        // Wrap the whole interpolated string in one paren group,
                        // opened at the first ${. Without it, a trailing method
                        // call binds only to the final "" segment because `.`
                        // outranks `+`: `"${n}".length()` desugared to
                        // `"" + (n).to_string() + "".length()`, i.e. string +
                        // string + 0, and the 0 reached strlen as an address —
                        // a raw-pointer garbage read (BUGS #25). The matching
                        // close paren is emitted after the trailing segment below.
                        if (!has_interp) {
                            this.emit_at(TokenKind.TkLParen, lit_line, lit_col, lit_off)
                        }
                        // Emit prefix string + plus
                        this.emit_at(TokenKind.TkString(result.to_string()), lit_line, lit_col, lit_off)
                        this.emit_at(TokenKind.TkPlus, lit_line, lit_col, lit_off)
                        // Lex the interpolated expression, wrapped in (expr).to_string()
                        this.emit_at(TokenKind.TkLParen, lit_line, lit_col, lit_off)
                        this.read_interpolation()
                        this.emit_at(TokenKind.TkRParen, lit_line, lit_col, lit_off)
                        this.emit_at(TokenKind.TkDot, lit_line, lit_col, lit_off)
                        this.emit_at(TokenKind.TkIdent("to_string"), lit_line, lit_col, lit_off)
                        this.emit_at(TokenKind.TkLParen, lit_line, lit_col, lit_off)
                        this.emit_at(TokenKind.TkRParen, lit_line, lit_col, lit_off)
                        this.emit_at(TokenKind.TkPlus, lit_line, lit_col, lit_off)
                        // Reset for rest of string
                        result = StringBuilder()
                        has_interp = true
                    } else {
                        result.append(ch)
                    }
                } else {
                    result.append(ch)
                }
            } else {
                result.append(ch)
            }
        }
        this.advance() // closing quote
        if (has_interp) {
            // The trailing segment of an interpolated string is scaffolding too:
            // by here token_start_* names some token inside the last ${...}.
            this.emit_at(TokenKind.TkString(result.to_string()), lit_line, lit_col, lit_off)
            // Close the paren group opened at the first ${ (BUGS #25). Only
            // emitted when the string actually interpolated — a plain "abc"
            // opens no group.
            this.emit_at(TokenKind.TkRParen, lit_line, lit_col, lit_off)
        } else {
            // A plain literal spans from its opening quote to its closing one.
            // token_start_* still names the opening quote, so emit() measures
            // the whole literal including both quotes.
            this.emit(TokenKind.TkString(result.to_string()))
        }
    }

    fun read_interpolation() {
        var depth: Float = 1
        while (this.pos < this.source.length() and depth > 0) {
            this.skip_whitespace()
            if (this.pos >= this.source.length()) break
            var ch: String = this.peek()
            if (ch == "}") {
                depth = depth - 1
                if (depth == 0) {
                    this.advance() // consume closing }
                    return nil
                }
            }
            if (ch == "{") {
                depth = depth + 1
            }
            // Lex one token normally
            this.begin_token()
            var tok_ch: String = this.advance()
            if (this.is_digit(tok_ch)) { this.read_number() }
            else if (this.is_alpha(tok_ch)) {
                var text: String = this.read_identifier()
                this.keyword_or_ident(text)
            }
            else if (tok_ch == "\"") { this.read_string() }
            else {
                this.lex_operator(tok_ch)
            }
        }
    }

    /// Emit the operator or delimiter token for `ch`, which the caller has
    /// already consumed. Unrecognized characters are dropped.
    ///
    /// Shared by `tokenize` and `read_interpolation` so the two cannot drift.
    /// The interpolation lexer used to carry its own shorter copy of this list
    /// covering only `( ) + - * / . , [ ]`, and silently discarded anything
    /// else — so `"${a != b}"` lexed as `a b` and every comparison, `%`, `:`,
    /// `!`, and brace inside an interpolation was a parse error or, worse, a
    /// quietly different expression.
    fun lex_operator(ch: String) {
        if (ch == "(") { this.emit(TokenKind.TkLParen) }
        else if (ch == ")") { this.emit(TokenKind.TkRParen) }
        else if (ch == "{") { this.emit(TokenKind.TkLBrace) }
        else if (ch == "}") { this.emit(TokenKind.TkRBrace) }
        else if (ch == "[") { this.emit(TokenKind.TkLBracket) }
        else if (ch == "]") { this.emit(TokenKind.TkRBracket) }
        else if (ch == ",") { this.emit(TokenKind.TkComma) }
        else if (ch == ".") { this.emit(TokenKind.TkDot) }
        else if (ch == ":") { this.emit(TokenKind.TkColon) }
        else if (ch == ";") { this.emit(TokenKind.TkSemicolon) }
        else if (ch == "+") {
            if (this.peek() == "=") {
                this.advance()
                this.emit(TokenKind.TkPlusEq)
            } else if (this.peek() == "+") {
                this.advance()
                this.emit(TokenKind.TkPlusPlus)
            } else {
                this.emit(TokenKind.TkPlus)
            }
        }
        else if (ch == "-") {
            if (this.peek() == ">") {
                this.advance()
                this.emit(TokenKind.TkArrow)
            } else if (this.peek() == "=") {
                this.advance()
                this.emit(TokenKind.TkMinusEq)
            } else if (this.peek() == "-") {
                this.advance()
                this.emit(TokenKind.TkMinusMinus)
            } else {
                this.emit(TokenKind.TkMinus)
            }
        }
        else if (ch == "*") {
            if (this.peek() == "=") {
                this.advance()
                this.emit(TokenKind.TkStarEq)
            } else {
                this.emit(TokenKind.TkStar)
            }
        }
        else if (ch == "/") {
            if (this.peek() == "=") {
                this.advance()
                this.emit(TokenKind.TkSlashEq)
            } else {
                this.emit(TokenKind.TkSlash)
            }
        }
        else if (ch == "%") {
            if (this.peek() == "=") {
                this.advance()
                this.emit(TokenKind.TkPercentEq)
            } else {
                this.emit(TokenKind.TkPercent)
            }
        }
        else if (ch == "&") { this.emit(TokenKind.TkAmpersand) }
        else if (ch == "^") { this.emit(TokenKind.TkCaret) }
        else if (ch == "~") { this.emit(TokenKind.TkTilde) }
        else if (ch == "@") { this.emit(TokenKind.TkIdent("@")) }
        else if (ch == "|") { this.emit(TokenKind.TkPipe) }
        else if (ch == "!") {
            if (this.peek() == "=") {
                this.advance()
                this.emit(TokenKind.TkBangEq)
            } else {
                this.emit(TokenKind.TkBang)
            }
        }
        else if (ch == "=") {
            if (this.peek() == "=") {
                this.advance()
                this.emit(TokenKind.TkEqEq)
            } else if (this.peek() == ">") {
                this.advance()
                this.emit(TokenKind.TkFatArrow)
            } else {
                this.emit(TokenKind.TkEq)
            }
        }
        else if (ch == "?") { this.emit(TokenKind.TkQuestion) }
        else if (ch == "<") {
            if (this.peek() == "=") {
                this.advance()
                this.emit(TokenKind.TkLtEq)
            } else if (this.peek() == "<") {
                this.advance()
                this.emit(TokenKind.TkShiftLeft)
            } else {
                this.emit(TokenKind.TkLt)
            }
        }
        else if (ch == ">") {
            if (this.peek() == "=") {
                this.advance()
                this.emit(TokenKind.TkGtEq)
            } else if (this.peek() == ">") {
                this.advance()
                this.emit(TokenKind.TkShiftRight)
            } else {
                this.emit(TokenKind.TkGt)
            }
        }
    }

    fun read_identifier(): String {
        var start: Float = this.pos - 1
        while (this.pos < this.source.length() and this.is_alnum(this.peek())) {
            this.advance()
        }
        // A trailing ? or ! is NOT part of the identifier; leave it for the
        // tokenizer to emit as its own token.
        return this.source.slice(start, this.pos)
    }

    fun keyword_or_ident(text: String) {
        if (text == "var") { this.emit(TokenKind.TkVar) }
        else if (text == "let") { this.emit(TokenKind.TkLet) }
        else if (text == "fun") { this.emit(TokenKind.TkFun) }
        else if (text == "return") { this.emit(TokenKind.TkReturn) }
        else if (text == "if") { this.emit(TokenKind.TkIf) }
        else if (text == "else") { this.emit(TokenKind.TkElse) }
        else if (text == "while") { this.emit(TokenKind.TkWhile) }
        else if (text == "and") { this.emit(TokenKind.TkAnd) }
        else if (text == "or") { this.emit(TokenKind.TkOr) }
        else if (text == "true") { this.emit(TokenKind.TkTrue) }
        else if (text == "false") { this.emit(TokenKind.TkFalse) }
        else if (text == "nil") { this.emit(TokenKind.TkNil) }
        else if (text == "import") { this.emit(TokenKind.TkImport) }
        else if (text == "as") { this.emit(TokenKind.TkAs) }
        else if (text == "enum") { this.emit(TokenKind.TkEnum) }
        else if (text == "match") { this.emit(TokenKind.TkMatch) }
        else if (text == "class") { this.emit(TokenKind.TkClass) }
        else if (text == "this") { this.emit(TokenKind.TkThis) }
        else if (text == "for") { this.emit(TokenKind.TkFor) }
        else if (text == "in") { this.emit(TokenKind.TkIn) }
        else if (text == "try") { this.emit(TokenKind.TkTry) }
        else if (text == "catch") { this.emit(TokenKind.TkCatch) }
        else if (text == "throw") { this.emit(TokenKind.TkThrow) }
        else if (text == "finally") { this.emit(TokenKind.TkFinally) }
        else if (text == "is") { this.emit(TokenKind.TkIs) }
        else if (text == "yield") { this.emit(TokenKind.TkYield) }
        else { this.emit(TokenKind.TkIdent(text)) }
    }

    fun read_doc_comment(): String {
        // Position is right after /// or //!
        // Skip optional space
        if (this.pos < this.source.length() and this.peek() == " ") {
            this.advance()
        }
        var start: Float = this.pos
        while (this.pos < this.source.length() and this.peek() != "\n") {
            this.advance()
        }
        return this.source.slice(start, this.pos)
    }

    fun tokenize(): List<Token> {
        while (this.pos < this.source.length()) {
            this.skip_whitespace()
            if (this.pos >= this.source.length()) break

            // Check for doc comments before advancing
            if (this.peek() == "/" and this.peek_next() == "/") {
                if (this.pos + 2 < this.source.length()) {
                    // A doc comment is a token too, and its span starts at the
                    // first slash, not after the marker.
                    this.begin_token()
                    var third: String = this.source.char_at(this.pos + 2)
                    if (third == "/") {
                        // /// doc comment
                        this.advance() // first /
                        this.advance() // second /
                        this.advance() // third /
                        var text: String = this.read_doc_comment()
                        this.emit(TokenKind.TkDocComment(text))
                        continue
                    } else if (third == "!") {
                        // //! module doc
                        this.advance() // first /
                        this.advance() // second /
                        this.advance() // !
                        var text: String = this.read_doc_comment()
                        this.emit(TokenKind.TkModuleDoc(text))
                        continue
                    }
                }
            }

            this.begin_token()
            var ch: String = this.advance()

            if (this.is_digit(ch)) { this.read_number() }
            else if (this.is_alpha(ch)) {
                var text: String = this.read_identifier()
                this.keyword_or_ident(text)
            }
            else if (ch == "\"") { this.read_string() }
            else { this.lex_operator(ch) }
        }

        this.begin_token()
        this.emit(TokenKind.TkEof)
        return this.tokens
    }
}

fun lex(source: String): List<Token> {
    var lexer: Lexer = Lexer(source)
    return lexer.tokenize()
}
