// Recursive descent parser for Saffron-mini

import "./ast.sf" as AST
import "./lexer.sf" as Lexer
import "./diag.sf" as Diag

class Parser {
    var tokens: List<Lexer.Token>
    var pos: Float
    var had_error: Bool
    var error_count: Float
    var source: String
    var html_depth: Float
    var for_counter: Int
    var map_counter: Int
    var incr_counter: Int

    fun init(tokens: List<Lexer.Token>) {
        this.tokens = tokens
        this.pos = 0
        this.had_error = false
        this.error_count = 0
        this.source = ""
        this.html_depth = 0
        this.for_counter = 0
        this.map_counter = 0
        this.incr_counter = 0
    }

    /// Suffix that makes each desugared `for-in`'s temporaries unique.
    ///
    /// Nested loops share a scope chain, so fixed names let the inner loop
    /// redeclare — and leave behind — the outer loop's cursor.
    fun next_for_uid(): String {
        this.for_counter = this.for_counter + 1
        return "_" + this.for_counter.to_string()
    }

    /// Suffix that makes each desugared map literal's temporary unique.
    ///
    /// A literal nested inside another shares the enclosing scope's alloca, so a
    /// fixed `__map` name let the inner map redeclare — and clobber — the outer
    /// one (BUGS #41). Same fix as next_for_uid, for the same reason.
    fun next_map_uid(): String {
        this.map_counter = this.map_counter + 1
        return "_" + this.map_counter.to_string()
    }

    fun current(): Lexer.Token {
        return this.tokens[this.pos]
    }

    fun current_kind(): Lexer.TokenKind {
        var tok: Lexer.Token = this.current()
        return match (tok) { Token(kind, line, col, offset, len) => kind }
    }

    fun advance(): Lexer.Token {
        var tok: Lexer.Token = this.current()
        this.pos = this.pos + 1
        return tok
    }

    fun expect_ident(): String {
        var kind: Lexer.TokenKind = this.current_kind()
        this.advance()
        return match (kind) {
            TkIdent(name) => name
            TkAs => "as"
            TkIn => "in"
            TkIs => "is"
            _ => ""
        }
    }

    /// The span of the identifier `expect_ident` would consume, captured *before*
    /// consuming it.
    ///
    /// `expect_ident` advances, so by the time it returns the identifier's own
    /// token is behind the cursor. A caller that wants both the name and its
    /// region reads this first, then calls `expect_ident`:
    ///
    ///     var name_span: AST.Span = this.ident_span()
    ///     var name: String = this.expect_ident()
    ///
    /// Doing it in that order matters: `current_span()` after `expect_ident()`
    /// names the *next* token, which is how a rename ends up retargeting the
    /// wrong word.
    fun ident_span(): AST.Span {
        return this.current_span()
    }

    fun peek_ident(): String {
        if (!this.match_kind_check("ident")) return ""
        var kind: Lexer.TokenKind = this.current_kind()
        return match (kind) {
            TkIdent(name) => name
            _ => ""
        }
    }

    // Can the current token begin a map-literal key?
    //
    // Numeric keys used to be missing here, so `{1: "one"}` was not recognised
    // as a map literal at all. It fell through to the block-expression path,
    // where `1:` was discarded and the block's value became "one" — so the
    // variable silently held a *string*, and calling a Map method on it
    // segfaulted. Map<Int, V> literals were simply unconstructible.
    fun is_map_key_start(): Bool {
        if (this.match_kind_check("string")) { return true }
        if (this.match_kind_check("ident")) { return true }
        if (this.match_kind_check("int")) { return true }
        if (this.match_kind_check("float")) { return true }
        return false
    }

    // Parse one key of a map literal: {"a": 1} or {a: 1}.
    //
    // An ident key is shorthand for the string of the same name, so it must
    // become a StringLit here. Routing it through parse_primary() instead made
    // `{a: 1}` compile the key as a *variable reference* — which emitted
    // `call i64 @a()` and failed to link, or silently read an unrelated
    // in-scope `a`. Both desugaring sites call this.
    fun parse_map_key(): AST.Expr {
        if (this.match_kind_check("ident")) {
            return AST.Expr.StringLit(this.expect_ident())
        }
        return this.parse_primary()
    }

    fun match_kind(expected: String): Bool {
        if (this.match_kind_check(expected)) {
            this.advance()
            return true
        }
        return false
    }

    fun current_line(): String {
        var tok: Lexer.Token = this.current()
        var line: Float = match (tok) { Token(kind, line, col, offset, len) => line }
        return line.floor().to_string()
    }

    fun current_line_num(): Float {
        var tok: Lexer.Token = this.current()
        return match (tok) { Token(kind, line, col, offset, len) => line }
    }

    fun prev_line_num(): Float {
        var tok: Lexer.Token = this.tokens[this.pos - 1]
        return match (tok) { Token(kind, line, col, offset, len) => line }
    }

    fun current_col(): String {
        var tok: Lexer.Token = this.current()
        var col: Float = match (tok) { Token(kind, line, col, offset, len) => col }
        return col.floor().to_string()
    }

    fun current_token_str(): String {
        var kind: Lexer.TokenKind = this.current_kind()
        return this.kind_name(kind)
    }

    /// How to name the current token in a diagnostic about an unexpected member.
    ///
    /// kind_name answers "ident" for every identifier, which is useless in a
    /// message the reader has to act on — "unexpected 'ident'" does not say
    /// which word is wrong. Spell an identifier as itself and fall back to the
    /// kind name for everything else.
    fun current_member_desc(): String {
        var word: String = this.peek_ident()
        if (word.length() > 0) { return word }
        return this.current_token_str()
    }

    // --- Visibility modifiers ---
    //
    // `private` and `public` are **soft keywords**, exactly like `interface` and
    // `actor`: the lexer emits them as TkIdent and the parser recognises them by
    // name. That is deliberate. Making them reserved words would break any
    // program that already uses either as a variable, field or parameter name,
    // and the whole point of a visibility annotation is that adding it to the
    // language costs existing code nothing.

    /// The identifier one token ahead, or "" if that token is not an identifier.
    ///
    /// peek_is answers by *kind*, which collapses every identifier to "ident" —
    /// so it cannot distinguish `interface` from `actor` from `banana`. The
    /// soft-keyword declaration forms need the name itself.
    fun peek_ident_next(): String {
        if (this.pos + 1 >= this.tokens.length()) return ""
        var next_tok: Lexer.Token = this.tokens[this.pos + 1]
        var next_kind: Lexer.TokenKind = match (next_tok) { Token(k, l, c, o, ln) => k }
        return match (next_kind) { TkIdent(n) => n    _ => "" }
    }

    /// Is the current token a visibility modifier introducing a declaration?
    ///
    /// The lookahead is the load-bearing half. `private` on its own is still a
    /// perfectly good identifier, so treating every occurrence as a modifier
    /// would break `var private = 1` and `private.close()`. Requiring that the
    /// NEXT token begin a declaration keeps both readings available and makes
    /// the soft keyword genuinely non-breaking.
    ///
    /// All four modifiers are recognised here, so a misplaced one gets a
    /// diagnostic that names it rather than a confusing parse error about an
    /// unexpected identifier. Recognition is separate from legality: whether the
    /// word is allowed in this position is take_visibility's call, and the one
    /// positional rule is that `protected` may not appear at top level.
    fun at_visibility_modifier(): Bool {
        var word: String = this.peek_ident()
        if (word != "private" and word != "public"
            and word != "internal" and word != "protected") { return false }
        if (this.peek_is("var") or this.peek_is("let") or this.peek_is("fun")
            or this.peek_is("enum") or this.peek_is("class")) { return true }
        // `@` and `extend` introduce declarations too, and both are lexed as
        // identifiers rather than keywords, so they have to be named here. Their
        // absence was not a missing nicety: at_visibility_modifier answering
        // false makes the modifier parse as an *expression statement* naming a
        // variable, which is why `private @extern(...) fun _f()` reported
        // "undefined variable 'private'" from codegen instead of a parse error.
        // 142 of the stdlib's 292 top-level underscore functions are @extern, so
        // this one line is what makes most of the stdlib annotatable at all.
        var nxt: String = this.peek_ident_next()
        return nxt == "interface" or nxt == "actor" or nxt == "type"
            or nxt == "@" or nxt == "extend"
    }

    /// Consume a visibility modifier and answer the visibility string it means.
    ///
    /// `in_class_body` decides the one modifier whose legality is positional:
    /// `protected` means "the class and its subclasses", so outside a class body
    /// there is no class for it to name and nothing it could restrict. Kotlin
    /// makes that an error rather than a synonym for `public` (§1), and so does
    /// this — accepting it would compile a declaration whose stated intent the
    /// compiler is ignoring, which is the same wrong-answer-dressed-as-a-clean-
    /// compile that the `internal` and `protected` placeholders existed to avoid.
    ///
    /// All four modifiers are otherwise legal in both positions, and their
    /// *meaning* is position-dependent (Kotlin's model): `private` is the file at
    /// top level and the class body on a member. That difference is resolved in
    /// the checker, which knows which it is looking at; the parser only records
    /// the word.
    fun take_visibility(in_class_body: Bool): String {
        var word: String = this.peek_ident()
        this.advance()
        if (word == "protected" and !in_class_body) {
            this.parse_error("'protected' is not allowed on a top-level declaration; it means 'this class and its subclasses', and there is no class here")
            return "public"
        }
        return word
    }

    // --- Spans ---
    //
    // The parser is where a Token's inline position fields become an AST.Span.
    // Every node that records a span gets it from one of these three, so there
    // is one place that knows the Token layout and one place that decides what
    // "the span of this construct" means.

    /// The span of an arbitrary token.
    fun token_span(tok: Lexer.Token): AST.Span {
        return match (tok) {
            Token(kind, line, col, offset, len) => AST.Span.Span(line, col, offset, len)
        }
    }

    /// The span of the token the parser is about to consume. This is the right
    /// span for "the thing I am complaining about is here".
    fun current_span(): AST.Span {
        return this.token_span(this.current())
    }

    /// The span of the token most recently consumed. This is the right span for
    /// "the construct I just finished parsing ends here" — pair it with the span
    /// captured before the construct started and merge the two.
    fun prev_span(): AST.Span {
        if (this.pos <= 0) { return AST.span_none() }
        return this.token_span(this.tokens[this.pos - 1])
    }

    /// The span running from `start` through the last token consumed — the extent
    /// of a construct whose first token's span the caller saved before parsing it.
    fun span_from(start: AST.Span): AST.Span {
        return AST.span_merge(start, this.prev_span())
    }

    /// Render a span as `line:col`, or as the current token's position when the
    /// span is synthetic. Used by the diagnostic printers below.
    fun span_prefix(s: AST.Span): String {
        if (!AST.span_is_real(s)) { return "<unknown>" }
        return "line " + AST.span_line(s).floor().to_string()
            + ", col " + AST.span_col(s).floor().to_string()
    }

    /// Print `message` located at `s`, with the source line and a caret under the
    /// span's first character. Shared by parse_error and any future
    /// located-warning path so the two cannot render differently.
    ///
    /// Also records into the shared Diag sink so parser errors reach --json and the
    /// LSP as data. The *printed* form is left exactly as it was — `[line N, col M]
    /// Error: ...`, the one format today's editor client scrapes — because changing
    /// it here would break that client before the LSP rewrite (WS3) can catch up.
    /// The sink is the forward path; the print is the compatibility path.
    fun report_at(s: AST.Span, label: String, message: String) {
        Diag.record_error("parser", s, message)
        // In --json mode the sink above is the whole story; the console form
        // would be a non-JSON line on the one stream the client parses. The
        // record stays, unconditionally, so --json loses nothing.
        if (Diag.is_quiet()) { return }
        IO.println("[" + this.span_prefix(s) + "] " + label + ": " + message)
        if (this.source.length() == 0) { return }
        if (!AST.span_is_real(s)) { return }
        var line_num: Float = AST.span_line(s)
        var lines: List<String> = this.source.split("\n")
        if (line_num <= 0 or line_num > lines.length()) { return }
        var src_line: String = lines[line_num - 1]
        var prefix: String = "  " + line_num.floor().to_string() + " | "
        IO.println(prefix + src_line)
        var col: Float = AST.span_col(s)
        var padding: String = ""
        var pi: Float = 0
        while (pi < prefix.length() + col - 1) {
            padding = padding + " "
            pi = pi + 1
        }
        // Underline the whole span, not just its first character: a caret run as
        // wide as the token shows which token was meant when several sit on one
        // line. A synthetic (len 0) span still gets a single caret.
        var caret: String = "^"
        var span_width: Float = AST.span_len(s)
        var ci: Float = 1
        while (ci < span_width) {
            caret = caret + "~"
            ci = ci + 1
        }
        IO.println(padding + caret)
    }

    fun parse_error(message: String) {
        this.error_count = this.error_count + 1
        if (this.error_count > 20) {
            if (this.error_count == 21 and !Diag.is_quiet()) {
                IO.println("Too many errors (20+), stopping.")
            }
            this.had_error = true
            // Skip to EOF to abort parsing
            while (!this.match_kind_check("eof")) {
                this.advance()
            }
            return
        }
        this.report_at(this.current_span(), "Error", message)
        this.had_error = true
    }

    /// Report a parse error at an explicit span rather than at the current token.
    ///
    /// Needed whenever the parser detects the problem after having consumed the
    /// construct at fault — by then `current()` is the token *after* it, and
    /// reporting there points past the mistake.
    fun parse_error_at(s: AST.Span, message: String) {
        this.error_count = this.error_count + 1
        if (this.error_count > 20) {
            if (this.error_count == 21 and !Diag.is_quiet()) {
                IO.println("Too many errors (20+), stopping.")
            }
            this.had_error = true
            while (!this.match_kind_check("eof")) {
                this.advance()
            }
            return
        }
        this.report_at(s, "Error", message)
        this.had_error = true
    }

    fun consume(expected: String) {
        if (!this.match_kind(expected)) {
            var found: String = this.current_token_str()
            this.parse_error("expected '" + expected + "' but found '" + found + "'")
        }
    }

    // --- Type annotations ---

    fun parse_type(): String {
        var name: String = this.parse_single_type()
        // Nullable shorthand: desugar `T?` to `T|Nil` right here, so that the
        // nullable has exactly ONE representation downstream.
        //
        // This used to claim the `?` was "preserved as-is" for the checker and
        // codegen to interpret — but parse_type never consumed the token at all,
        // so a `?` was left for whatever came next to trip over. In a return
        // annotation that desynchronized the parser and the function's own
        // parameters came out undefined at codegen (BUGS #72); in a var
        // annotation it surfaced as "expected '=' but found '?'". And the claim
        // was only ever half true: the checker had two ends_with("?") special
        // cases, codegen had none, and parse_type_ast would have turned `Int?`
        // into ClassType("Int?").
        //
        // Desugaring at the parser means every consumer sees the union form it
        // already handles, rather than each one needing its own `?` case.
        if (this.match_kind("?")) {
            name = name + "|Nil"
        }
        // Union types: String | Nil, Int | String | Nil
        while (this.match_kind("|")) {
            var next: String = this.parse_single_type()
            // `T?|U` and a trailing `?` on a union member both mean nullable.
            if (this.match_kind("?")) {
                next = next + "|Nil"
            }
            name = name + "|" + next
        }
        return name
    }

    fun parse_single_type(): String {
        // Parenthesized types: function type or tuple type
        if (this.match_kind_check("(")) {
            this.advance()
            var inner_types: List<String> = []
            if (!this.match_kind_check(")")) {
                inner_types.push(this.parse_type())
                while (this.match_kind(",")) {
                    inner_types.push(this.parse_type())
                }
            }
            this.consume(")")
            if (this.match_kind_check("=>")) {
                // Function type: (ParamType, ...) => ReturnType
                this.advance()
                var fun_type: String = "Fun("
                var fi: Float = 0
                while (fi < inner_types.length()) {
                    if (fi > 0) { fun_type = fun_type + "," }
                    fun_type = fun_type + inner_types[fi]
                    fi = fi + 1
                }
                fun_type = fun_type + "):" + this.parse_type()
                return fun_type
            }
            // Tuple type: (Int, String) => "Tuple<Int,String>"
            var tuple_type: String = "Tuple<"
            var ti: Float = 0
            while (ti < inner_types.length()) {
                if (ti > 0) { tuple_type = tuple_type + "," }
                tuple_type = tuple_type + inner_types[ti]
                ti = ti + 1
            }
            tuple_type = tuple_type + ">"
            return tuple_type
        }
        var name: String = this.expect_ident()
        // Handle dotted types: Lexer.TokenKind, AST.Stmt, etc.
        // Also detect receiver function types: Type.() => Ret or Type.(Params) => Ret
        while (this.match_kind(".")) {
            // Check for receiver function type: Name.(params) => Ret
            if (this.match_kind_check("(")) {
                // Peek: save pos, scan for matching ), check if followed by =>
                var save_pos: Float = this.pos
                this.advance() // consume (
                // Skip tokens until matching )
                var paren_depth: Float = 1
                while (paren_depth > 0 and !this.match_kind_check("eof")) {
                    if (this.match_kind_check("(")) {
                        paren_depth = paren_depth + 1
                    } else if (this.match_kind_check(")")) {
                        paren_depth = paren_depth - 1
                        if (paren_depth > 0) { this.advance() }
                    } else {
                        this.advance()
                    }
                }
                // Now we should be at )
                var found_arrow: Bool = false
                if (this.match_kind_check(")")) {
                    this.advance() // consume )
                    if (this.match_kind_check("=>")) {
                        found_arrow = true
                    }
                }
                // Restore position and parse properly if it's a receiver type
                this.pos = save_pos
                if (found_arrow) {
                    // Parse receiver function type: Name.(ParamTypes) => RetType
                    this.advance() // consume (
                    var recv_params: List<String> = []
                    if (!this.match_kind_check(")")) {
                        recv_params.push(this.parse_type())
                        while (this.match_kind(",")) {
                            recv_params.push(this.parse_type())
                        }
                    }
                    this.consume(")")
                    this.consume("=>")
                    var recv_ret: String = this.parse_type()
                    // Encode as "Fun[ReceiverType](params):Ret"
                    var recv_type: String = "Fun[" + name + "]("
                    var rpi: Float = 0
                    while (rpi < recv_params.length()) {
                        if (rpi > 0) { recv_type = recv_type + "," }
                        recv_type = recv_type + recv_params[rpi]
                        rpi = rpi + 1
                    }
                    recv_type = recv_type + "):" + recv_ret
                    return recv_type
                }
                // Not a receiver type — continue as dotted name
                // The . was already consumed by match_kind, expect ident
            }
            var part: String = this.expect_ident()
            name = name + "." + part
        }
        // Generic args: collect tokens between < > respecting depth
        // Produces "Map<String,Number>" or "List<Map<String,Number>>"
        if (this.match_kind_check("<")) {
            this.advance()
            var args: String = ""
            var depth: Float = 1
            while (depth > 0 and !this.match_kind_check("eof")) {
                if (this.match_kind_check("<")) {
                    args = args + "<"
                    depth = depth + 1
                    this.advance()
                } else if (this.match_kind_check(">")) {
                    depth = depth - 1
                    if (depth > 0) {
                        args = args + ">"
                    }
                    this.advance()
                } else if (this.match_kind_check(">>")) {
                    depth = depth - 2
                    if (depth > 0) {
                        args = args + ">>"
                    } else if (depth == 0) {
                        args = args + ">"
                    }
                    this.advance()
                } else if (this.match_kind_check(",")) {
                    args = args + ","
                    this.advance()
                } else if (this.match_kind_check("ident")) {
                    var part: String = this.expect_ident()
                    args = args + part
                } else if (this.match_kind_check(".")) {
                    args = args + "."
                    this.advance()
                } else if (this.match_kind_check("|")) {
                    args = args + "|"
                    this.advance()
                } else if (this.match_kind_check("(")) {
                    args = args + "("
                    this.advance()
                } else if (this.match_kind_check(")")) {
                    args = args + ")"
                    this.advance()
                } else if (this.match_kind_check("=>")) {
                    args = args + "=>"
                    this.advance()
                } else if (this.match_kind_check(":")) {
                    args = args + ":"
                    this.advance()
                } else if (this.match_kind_check("?")) {
                    args = args + "?"
                    this.advance()
                } else {
                    this.advance()
                }
            }
            name = name + "<" + args + ">"
        }
        return name
    }

    // --- Expressions (Pratt parser) ---

    fun parse_expr(): AST.Expr {
        return this.parse_or()
    }

    fun parse_or(): AST.Expr {
        var left: AST.Expr = this.parse_and()
        while (this.match_kind_check("or")) {
            this.advance()
            var right: AST.Expr = this.parse_and()
            left = AST.Expr.Logical(left, "or", right)
        }
        return left
    }

    fun parse_and(): AST.Expr {
        var left: AST.Expr = this.parse_equality()
        while (this.match_kind_check("and")) {
            this.advance()
            var right: AST.Expr = this.parse_equality()
            left = AST.Expr.Logical(left, "and", right)
        }
        return left
    }

    fun parse_equality(): AST.Expr {
        var left: AST.Expr = this.parse_comparison()
        while (this.is_equality_op()) {
            var op: String = this.get_op_string()
            this.advance()
            var right: AST.Expr = this.parse_comparison()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_comparison(): AST.Expr {
        var left: AST.Expr = this.parse_bitwise_or()
        while (this.is_comparison_op()) {
            var op: String = this.get_op_string()
            this.advance()
            var right: AST.Expr = this.parse_bitwise_or()
            left = AST.Expr.Binary(left, op, right)
        }
        if (this.match_kind_check("is") and this.current_line_num() == this.prev_line_num()) {
            this.advance()
            var type_name: String = this.expect_ident()
            left = AST.Expr.IsCheck(left, type_name)
        }
        return left
    }

    fun parse_bitwise_or(): AST.Expr {
        var left: AST.Expr = this.parse_bitwise_xor()
        while (this.match_kind_check("|")) {
            this.advance()
            var right: AST.Expr = this.parse_bitwise_xor()
            left = AST.Expr.Binary(left, "|", right)
        }
        return left
    }

    fun parse_bitwise_xor(): AST.Expr {
        var left: AST.Expr = this.parse_bitwise_and()
        while (this.match_kind_check("^")) {
            this.advance()
            var right: AST.Expr = this.parse_bitwise_and()
            left = AST.Expr.Binary(left, "^", right)
        }
        return left
    }

    fun parse_bitwise_and(): AST.Expr {
        var left: AST.Expr = this.parse_shift()
        while (this.match_kind_check("&")) {
            this.advance()
            var right: AST.Expr = this.parse_shift()
            left = AST.Expr.Binary(left, "&", right)
        }
        return left
    }

    fun parse_shift(): AST.Expr {
        var left: AST.Expr = this.parse_term()
        while (this.is_shift_op()) {
            var op: String = this.get_op_string()
            this.advance()
            var right: AST.Expr = this.parse_term()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_term(): AST.Expr {
        var left: AST.Expr = this.parse_factor()
        while (this.is_term_op()) {
            var op: String = this.get_op_string()
            this.advance()
            var right: AST.Expr = this.parse_factor()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_factor(): AST.Expr {
        var left: AST.Expr = this.parse_unary()
        while (this.is_factor_op()) {
            var op: String = this.get_op_string()
            this.advance()
            var right: AST.Expr = this.parse_unary()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_unary(): AST.Expr {
        if (this.match_kind_check("-")) {
            this.advance()
            var right: AST.Expr = this.parse_unary()
            return AST.Expr.Unary("-", right)
        }
        if (this.match_kind_check("!")) {
            this.advance()
            var right: AST.Expr = this.parse_unary()
            return AST.Expr.Unary("!", right)
        }
        if (this.match_kind_check("~")) {
            this.advance()
            var right: AST.Expr = this.parse_unary()
            return AST.Expr.Unary("~", right)
        }
        // Prefix `++x` / `--x` is rejected by name rather than silently parsed.
        //
        // It is not implemented because it would be a second spelling for the
        // one thing postfix already does in every position this language can
        // reach: statement position discards the value, so the two forms would
        // be identical there, and the pre-increment value is `x + 1` written
        // more clearly. Accepting it would also collide with unary minus —
        // `--x` is already `-(-x)` in C-free languages — so leaving it as a
        // lexer-level `--` and reporting it here is the only reading that cannot
        // be mistaken for arithmetic.
        if (this.match_kind_check("++") or this.match_kind_check("--")) {
            var pre_op: String = this.kind_name(this.current_kind())
            this.parse_error("'" + pre_op + "' is postfix only in Saffron - write 'x" + pre_op + "' or, for the incremented value, 'x " + pre_op.slice(0, 1) + " 1'")
            this.advance()
            return this.parse_unary()
        }
        return this.parse_postfix()
    }

    /// A call/member/index chain, then any postfix `++` / `--`.
    ///
    /// `x++` desugars to a BlockExpr that reads the old value into a temporary,
    /// writes back `old <op> 1` and evaluates to the temporary — so it is an
    /// expression with the value C gives it, usable anywhere an expression is,
    /// and it needs no new AST node or codegen support. The receiver and index
    /// are hoisted into their own temporaries first so that `f()[g()]++`
    /// evaluates `f()` and `g()` exactly once each, which the naive
    /// `t = e; e = t + 1` rewrite would not.
    ///
    /// Applied only once, not in a loop: `x++++` is not a thing, because the
    /// result of `x++` is a value and not a place. Leaving the second `++`
    /// unconsumed makes it a parse error at the operator rather than a silently
    /// accepted double increment.
    fun parse_postfix(): AST.Expr {
        var expr: AST.Expr = this.parse_call()
        if (this.match_kind_check("++") or this.match_kind_check("--")) {
            var op: String = "+"
            if (this.match_kind_check("--")) { op = "-" }
            var spelling: String = this.kind_name(this.current_kind())
            this.advance()
            return this.build_postfix_incr(expr, op, spelling)
        }
        return expr
    }

    /// The BlockExpr behind `target++` / `target--`.
    ///
    /// Shape, for a variable target `x`:
    ///     { var __inc_N: Any = x
    ///       x = __inc_N <op> 1
    ///       __inc_N }
    ///
    /// For a field or element target the receiver (and index) are hoisted first,
    /// so each subexpression is evaluated once:
    ///     { var __inc_recv_N = <receiver>
    ///       var __inc_idx_N = <index>
    ///       var __inc_N: Any = __inc_recv_N[__inc_idx_N]
    ///       __inc_recv_N[__inc_idx_N] = __inc_N <op> 1
    ///       __inc_N }
    ///
    /// The value temp is annotated `Any` rather than left to inference because
    /// the checker cannot infer an element or field read and would warn "cannot
    /// infer type" on a temporary the user never wrote. `Any` costs nothing at
    /// runtime here — measured: an `Any`-annotated temp round-trips Int, Float
    /// and String unchanged, and arithmetic and comparison on it behave as the
    /// underlying type.
    ///
    /// The uid makes nesting safe, for the same reason next_for_uid and
    /// next_map_uid exist: `lst[i++] = j++` puts two of these in one scope, and
    /// a fixed name would let the second redeclare the first (BUGS #41).
    fun build_postfix_incr(target: AST.Expr, op: String, spelling: String): AST.Expr {
        var ek: String = this.classify_expr_for_assign(target)
        if (ek == "other") {
            this.parse_error("the operand of '" + spelling + "' must be a variable, field or element, not an expression")
            return target
        }
        var uid: String = this.next_incr_uid()
        var val_name: String = "__inc" + uid
        var stmts: List<AST.Stmt> = []
        // Every node built below is synthetic — `__inc_N`, `__inc_recv_N` and the
        // rewritten place appear nowhere in the user's source — so they all carry
        // span_none(). Giving them the operand's span would be worse than giving
        // them nothing: go-to-definition on `x` would offer a binding the author
        // cannot see, and rename would try to rewrite a name that is not there.
        // The one span that must survive is the *place*'s, and it does: the
        // MemberAccess/GetField arms below read the field name out of the original
        // target, and build_assign carries the rebuilt place's span into the write.
        var synth: AST.Span = AST.span_none()
        // The `""` in each VarDecl below is the sentinel meaning "infer from the
        // initializer", the same one parse_var_decl_with_doc writes for an
        // unannotated `var`. The checker's VarDecl arm reads it that way. So these
        // temporaries are typed as precisely as `var t = <expr>` is.
        //
        // These said "Any" until BUGS #147, when the sentinel moved to "" so that
        // an explicit `: Any` could be told apart from an omitted annotation. They
        // must track the sentinel, not the spelling: leaving them as "Any" would
        // have made every `x++` temporary carry a real widening annotation.
        //
        // The place to read from and write back to, rewritten over the hoisted
        // temporaries. For a plain variable there is nothing to hoist.
        var place: AST.Expr = target
        if (ek == "index") {
            var iobj: AST.Expr = match (target) { IndexGet(o, i) => o
                _ => AST.Expr.NilLit
            }
            var iidx: AST.Expr = match (target) { IndexGet(o, i) => i
                _ => AST.Expr.NilLit
            }
            var recv_name: String = "__inc_recv" + uid
            var idx_name: String = "__inc_idx" + uid
            stmts.push(AST.Stmt.VarDecl(recv_name, "", iobj, "", "public", synth, synth))
            stmts.push(AST.Stmt.VarDecl(idx_name, "", iidx, "", "public", synth, synth))
            place = AST.Expr.IndexGet(AST.Expr.Variable(recv_name, synth), AST.Expr.Variable(idx_name, synth))
        } else if (ek == "member" or ek == "get_field") {
            var mobj: AST.Expr = match (target) { MemberAccess(o, f, __ms) => o
                GetField(o, f, __gs) => o
                _ => AST.Expr.NilLit
            }
            var mfield: String = match (target) { MemberAccess(o, f, __ms) => f
                GetField(o, f, __gs) => f
                _ => ""
            }
            // The field's own span, unlike the temporaries, IS real and is the
            // operand the user wrote. Carrying it into the rebuilt place means
            // `holder.slot++` still locates `slot` where the source has it.
            var mfs: AST.Span = match (target) { MemberAccess(o, f, __ms) => __ms
                GetField(o, f, __gs) => __gs
                _ => AST.span_none()
            }
            // `this.f++` keeps `this` as the receiver rather than hoisting it:
            // `this` is already a single evaluation with no side effect, and a
            // local holding it would defeat the field-access paths in codegen
            // that special-case a `This` receiver.
            var recv_is_this: Bool = match (mobj) { This => true
                _ => false
            }
            if (recv_is_this) {
                place = AST.Expr.GetField(AST.Expr.This, mfield, mfs)
            } else {
                var mrecv_name: String = "__inc_recv" + uid
                stmts.push(AST.Stmt.VarDecl(mrecv_name, "", mobj, "", "public", synth, synth))
                place = AST.Expr.MemberAccess(AST.Expr.Variable(mrecv_name, synth), mfield, mfs)
            }
        }
        stmts.push(AST.Stmt.VarDecl(val_name, "", place, "", "public", synth, synth))
        var updated: AST.Expr = AST.Expr.Binary(AST.Expr.Variable(val_name, synth), op, AST.Expr.IntLit(1))
        stmts.push(this.build_assign(place, updated))
        return AST.Expr.BlockExpr(stmts, AST.Expr.Variable(val_name, synth))
    }

    /// Suffix that makes each desugared `++`/`--`'s temporaries unique. Same
    /// role as next_for_uid / next_map_uid.
    fun next_incr_uid(): String {
        this.incr_counter = this.incr_counter + 1
        return "_" + this.incr_counter.to_string()
    }

    fun parse_call(): AST.Expr {
        // The postfix chain's start, captured before the primary is consumed.
        // `Call`'s span runs from here to the closing paren, so in `a.b.c(x)`
        // the span underlines the whole callee chain and its arguments — the
        // extent a wrong-arity error wants to point at. Note this is a running
        // start, not per-link: each iteration re-merges from the same origin, so
        // a chained `f(1)(2)` gives the outer Call the full extent.
        var chain_start: AST.Span = this.current_span()
        var expr: AST.Expr = this.parse_primary()

        while (true) {
            if (this.match_kind_check(".")) {
                // `..` is not an operator: Saffron has no range syntax. Report it
                // here, at the first dot, rather than letting the shape fall
                // through — it used to reach codegen as an IndexGet and segfault
                // with no diagnostic from any stage (BUGS #112).
                if (this.peek_is(".")) {
                    this.parse_error("'..' is not an operator - Saffron has no range syntax; build a list or use a while/for loop")
                    if (this.match_kind_check("eof")) { break }
                    this.advance() // first '.'
                    if (this.match_kind_check(".")) { this.advance() } // second '.'
                    // Swallow the intended right-hand endpoint so the rest of the
                    // statement does not produce a second, unrelated error.
                    if (!this.match_kind_check("eof")) { this.parse_unary() }
                    break
                }
                this.advance()
                // Numeric dot access: tuple.0, tuple.1
                if (this.match_kind_check("int")) {
                    var idx_kind: Lexer.TokenKind = this.current_kind()
                    var idx_val: Float = match (idx_kind) { TkInt(v) => v   _ => 0 }
                    // A float literal is never a tuple, so `<float>.<int>` is
                    // always a mis-scan, not a field access: `1.5.0` reaches here,
                    // and so did `0..5` before the lexer stopped eating the first
                    // dot as a decimal point (BUGS #112). Guarding the shape keeps
                    // it from becoming __list_get on a double.
                    var recv_is_float: Bool = match (expr) {
                        FloatLit(v) => true
                        _ => false
                    }
                    if (recv_is_float) {
                        this.parse_error("cannot use '.' field access on a float literal - a '.' right after a number is its decimal point")
                        this.advance()
                        continue
                    }
                    this.advance()
                    expr = AST.Expr.IndexGet(expr, AST.Expr.IntLit(idx_val))
                    continue
                }
                // Captured before `expect_ident` consumes it. This span covers the
                // field/method identifier ALONE — not the object it hangs off —
                // because that is what a rename rewrites and what go-to-definition
                // resolves. A span covering `obj.field` would rename `obj` too.
                var field_span: AST.Span = this.ident_span()
                var field: String = this.expect_ident()
                if (this.match_kind_check("(")) {
                    // Method call: obj.method(args)
                    this.advance()
                    var args: List<AST.Expr> = []
                    if (!this.match_kind_check(")")) {
                        args.push(this.parse_call_arg())
                        while (this.match_kind(",")) {
                            args.push(this.parse_call_arg())
                        }
                        this.consume(")")
                    } else {
                        this.advance()
                    }
                    // Trailing closure: obj.method(args) { ... }
                    if (this.match_kind_check("{")) {
                        args.push(this.parse_trailing_closure())
                    }
                    expr = AST.Expr.MethodCall(expr, field, args, field_span)
                } else {
                    expr = AST.Expr.MemberAccess(expr, field, field_span)
                }
            } else if (this.match_kind_check("[")) {
                // Index access: obj[expr]
                this.advance()
                var idx: AST.Expr = this.parse_expr()
                this.consume("]")
                expr = AST.Expr.IndexGet(expr, idx)
            } else if (this.match_kind_check("(")) {
                this.advance()
                var args: List<AST.Expr> = []
                if (!this.match_kind_check(")")) {
                    args.push(this.parse_call_arg())
                    while (this.match_kind(",")) {
                        args.push(this.parse_call_arg())
                    }
                    this.consume(")")
                } else {
                    this.advance()
                }
                // Trailing closure: func(args) { ... }
                if (this.match_kind_check("{")) {
                    args.push(this.parse_trailing_closure())
                }
                expr = AST.Expr.Call(expr, args, this.span_from(chain_start))
            } else if (this.match_kind_check("{") and this.current_line_num() == this.prev_line_num()) {
                // Paren-free trailing closure: ident { ... } → ident(fun () { ... })
                var is_callable: Bool = match (expr) {
                    Variable(n, __vs) => true
                    MemberAccess(o, f, __ms) => true
                    _ => false
                }
                if (is_callable) {
                    var tc_args: List<AST.Expr> = [this.parse_trailing_closure()]
                    expr = AST.Expr.Call(expr, tc_args, this.span_from(chain_start))
                } else {
                    break
                }
            } else {
                break
            }
        }

        return expr
    }

    fun parse_primary(): AST.Expr {
        // yield / yield [reason, arg]
        if (this.match_kind_check("yield") or this.is_ident_named("yield")) {
            this.advance()
            if (this.match_kind_check("[")) {
                var yval: AST.Expr = this.parse_expr()
                return AST.Expr.Yield(yval)
            }
            return AST.Expr.Yield(AST.Expr.NilLit)
        }
        // HTML fragment: <>children</>
        if (this.match_kind_check("<") and this.peek_is(">")) {
            return this.parse_html_fragment()
        }
        // HTML element expression: <tag attrs...>children</tag>
        if (this.match_kind_check("<") and this.peek_is_html_start()) {
            return this.parse_html_element()
        }
        if (this.match_kind_check("if")) {
            return this.parse_if_expr()
        }
        if (this.match_kind_check("try")) {
            return this.parse_try_expr()
        }
        if (this.match_kind_check("match")) {
            return this.parse_match_expr()
        }
        if (this.match_kind_check("fun")) {
            return this.parse_lambda()
        }
        if (this.match_kind_check("this")) {
            this.advance()
            return AST.Expr.This
        }
        if (this.is_ident_named("super")) {
            var super_span: AST.Span = this.current_span()
            this.advance()
            return AST.Expr.Variable("super", super_span)
        }
        if (this.match_kind_check("[")) {
            return this.parse_list_lit()
        }
        if (this.match_kind_check("{")) {
            this.advance()
            if (this.match_kind_check("}")) {
                // Empty map literal: {}
                this.advance()
                return AST.Expr.MapLit
            }
            // Kotlin-style lambda: { x => body } or { x, y => body }
            // Save pos before consuming ident so we can restore on mismatch
            var kl_before: Float = this.pos
            if (this.match_kind_check("ident")) {
                var kl_name: String = this.expect_ident()
                if (this.match_kind("=>")) {
                    var lparams: List<AST.Param> = []
                    IO.println("[KL-PATH]"); lparams.push(AST.Param.Param(kl_name, AST.Type.AnyType, AST.Expr.NilLit, "public", AST.span_none()))
                    var lbody: List<AST.Stmt> = []
                    while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                        while (this.match_kind(";")) {}
                        if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                            break
                        }
                        lbody.push(this.parse_stmt())
                    }
                    this.consume("}")
                    if (lbody.length() > 0) {
                        var klast: AST.Stmt = lbody[lbody.length() - 1]
                        var kis_expr: Bool = match (klast) {
                            ExprStmt(e) => true
                            _ => false
                        }
                        if (kis_expr) {
                            var kexpr: AST.Expr = match (klast) { ExprStmt(e) => e    _ => AST.Expr.NilLit }
                            lbody[lbody.length() - 1] = AST.Stmt.Return(kexpr)
                        }
                    }
                    return AST.Expr.Lambda(lparams, AST.Type.AnyType, lbody)
                } else if (this.match_kind(",")) {
                    var lparams: List<AST.Param> = []
                    lparams.push(AST.Param.Param(kl_name, AST.Type.AnyType, AST.Expr.NilLit, "public", AST.span_none()))
                    var lpname: String = this.expect_ident()
                    lparams.push(AST.Param.Param(lpname, AST.Type.AnyType, AST.Expr.NilLit, "public", AST.span_none()))
                    while (this.match_kind(",")) {
                        lpname = this.expect_ident()
                        lparams.push(AST.Param.Param(lpname, AST.Type.AnyType, AST.Expr.NilLit, "public", AST.span_none()))
                    }
                    this.consume("=>")
                    var lbody: List<AST.Stmt> = []
                    while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                        while (this.match_kind(";")) {}
                        if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                            break
                        }
                        lbody.push(this.parse_stmt())
                    }
                    this.consume("}")
                    if (lbody.length() > 0) {
                        var klast: AST.Stmt = lbody[lbody.length() - 1]
                        var kis_expr: Bool = match (klast) {
                            ExprStmt(e) => true
                            _ => false
                        }
                        if (kis_expr) {
                            var kexpr: AST.Expr = match (klast) { ExprStmt(e) => e    _ => AST.Expr.NilLit }
                            lbody[lbody.length() - 1] = AST.Stmt.Return(kexpr)
                        }
                    }
                    return AST.Expr.Lambda(lparams, AST.Type.AnyType, lbody)
                } else {
                    this.pos = kl_before
                }
            }
            // Check for map literal: { "key": value, ... } or { ident: value, ... }
            if (this.is_map_key_start() and this.peek_is(":")) {
                // Parse as map literal — desugar to BlockExpr that builds the map.
                // The temporary needs a unique name: a nested literal shares this
                // scope's alloca and a fixed `__map` clobbered the outer one
                // (BUGS #41). Bind it BEFORE parse_expr below, which recurses into
                // nested literals and bumps the counter.
                var mvar: String = "__map" + this.next_map_uid()
                var map_stmts: List<AST.Stmt> = []
                map_stmts.push(AST.Stmt.VarDecl(mvar, "Map", AST.Expr.MapLit, "", "public", AST.span_none(), AST.span_none()))
                // First entry
                var key: AST.Expr = this.parse_map_key()
                this.consume(":")
                var value: AST.Expr = this.parse_expr()
                map_stmts.push(AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.Variable(mvar, AST.span_none()), "set", [key, value], AST.span_none())))
                while (this.match_kind(",")) {
                    if (this.match_kind_check("}")) { break }
                    var k: AST.Expr = this.parse_map_key()
                    this.consume(":")
                    var v: AST.Expr = this.parse_expr()
                    map_stmts.push(AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.Variable(mvar, AST.span_none()), "set", [k, v], AST.span_none())))
                }
                this.consume("}")
                return AST.Expr.BlockExpr(map_stmts, AST.Expr.Variable(mvar, AST.span_none()))
            }
            // Block expression: { stmts...; expr }
            //
            // The `;` skip mirrors parse_block_stmts (below): every other
            // statement loop in this file drains separators before parse_stmt,
            // and this one was the sole omission, so `{ var q = 5; q }` handed the
            // bare `;` to parse_stmt and died with "expected a literal" (BUGS
            // #136). The multi-line form worked only because newlines are not
            // tokens here. Re-checking `}`/eof after the skip lets a trailing `;`
            // (`{ 7; }`) close the block instead of demanding another statement.
            var block_stmts: List<AST.Stmt> = []
            while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                while (this.match_kind(";")) {}
                if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                    this.consume("}")
                    return AST.Expr.BlockExpr(block_stmts, AST.Expr.NilLit)
                }
                block_stmts.push(this.parse_stmt())
            }
            this.consume("}")
            // The last statement becomes the value expression if it's an ExprStmt
            // or an If with else (value-producing if/else)
            if (block_stmts.length() > 0) {
                var last: AST.Stmt = block_stmts[block_stmts.length() - 1]
                var is_value_producing: Bool = this.is_value_stmt(last)
                if (is_value_producing) {
                    var last_kind: AST.Expr = this.stmt_to_expr(last)
                    block_stmts.pop()
                    return AST.Expr.BlockExpr(block_stmts, last_kind)
                }
                return AST.Expr.BlockExpr(block_stmts, AST.Expr.NilLit)
            }
            return AST.Expr.BlockExpr([], AST.Expr.NilLit)
        }

        var kind: Lexer.TokenKind = this.current_kind()
        // Captured before `advance`, because the TkIdent arm below needs the span
        // of the token being consumed and `prev_span()` would be correct only for
        // as long as no arm consumes anything further — TkLParen does.
        var prim_span: AST.Span = this.current_span()
        this.advance()

        return match (kind) {
            TkInt(v) => AST.Expr.IntLit(v)
            TkFloat(v) => AST.Expr.FloatLit(v)
            TkTrue => AST.Expr.BoolLit(true)
            TkFalse => AST.Expr.BoolLit(false)
            TkNil => AST.Expr.NilLit
            TkString(s) => AST.Expr.StringLit(s)
            TkIdent(name) => AST.Expr.Variable(name, prim_span)
            // Soft keywords are legal binding names, so they must also be legal
            // *references*. `as`, `in` and `is` get their own token kinds from the
            // lexer, so a `TkIdent` arm alone never sees them: `fun f(as: String)`
            // parsed and type checked (expect_ident maps all three back to their
            // spelling), but reading `as` in the body hit the `_ =>` catch-all
            // below and died with "expected a literal, name or '('" (BUGS #137).
            // `actor` and `interface` are soft keywords too but stay `TkIdent`, so
            // they were never affected and need no arm here.
            TkAs => AST.Expr.Variable("as", prim_span)
            TkIn => AST.Expr.Variable("in", prim_span)
            TkIs => AST.Expr.Variable("is", prim_span)
            TkLParen => {
                var expr: AST.Expr = this.parse_expr()
                if (this.match_kind(",")) {
                    var elems: List<AST.Expr> = [expr]
                    if (!this.match_kind_check(")")) {
                        elems.push(this.parse_expr())
                        while (this.match_kind(",")) {
                            if (this.match_kind_check(")")) { break }
                            elems.push(this.parse_expr())
                        }
                    }
                    this.consume(")")
                    AST.Expr.TupleLit(elems)
                } else {
                    this.consume(")")
                    expr
                }
            }
            // The caller has already checked that the current token can start a
            // primary, so this arm is unreachable in practice. It still has to
            // exist: a missing arm yields an indeterminate value rather than a
            // diagnostic (BUGS #76), so "unreachable" silently became "returns
            // garbage" for any token the check above let through by mistake.
            _ => {
                this.parse_error("expected a literal, name or '(' here")
                AST.Expr.NilLit
            }
        }
    }

    fun parse_list_lit(): AST.Expr {
        this.advance() // consume [
        var elements: List<AST.Expr> = []
        if (!this.match_kind_check("]")) {
            elements.push(this.parse_expr())
            while (this.match_kind(",")) {
                if (this.match_kind_check("]")) { break }
                elements.push(this.parse_expr())
            }
        }
        this.consume("]")
        return AST.Expr.ListLit(elements)
    }

    fun parse_match_expr(): AST.Expr {
        this.advance() // consume match
        this.consume("(")
        var subject: AST.Expr = this.parse_expr()
        this.consume(")")
        this.consume("{")
        var arms: List<AST.MatchArm> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            var pattern: AST.Pattern = this.parse_pattern()
            this.consume("=>")
            var body: AST.Expr = this.parse_expr()
            arms.push(AST.MatchArm.Arm(pattern, body))
            this.match_kind(",")
        }
        this.consume("}")
        return AST.Expr.Match(subject, arms)
    }

    fun parse_if_expr(): AST.Expr {
        this.advance() // consume if
        this.consume("(")
        var cond: AST.Expr = this.parse_expr()
        this.consume(")")
        var then_stmts: List<AST.Stmt> = []
        var then_val: AST.Expr = AST.Expr.NilLit
        if (this.match_kind_check("{")) {
            this.advance()
            while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                while (this.match_kind(";")) {}
                if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
                then_stmts.push(this.parse_stmt())
            }
            this.consume("}")
            if (then_stmts.length() > 0) {
                var last: AST.Stmt = then_stmts[then_stmts.length() - 1]
                if (this.is_value_stmt(last)) {
                    then_val = this.stmt_to_expr(last)
                    then_stmts.pop()
                }
            }
        } else {
            then_val = this.parse_expr()
        }
        if (!this.match_kind("else")) {
            this.parse_error("if-expression requires an else branch")
        }
        var else_stmts: List<AST.Stmt> = []
        var else_val: AST.Expr = AST.Expr.NilLit
        if (this.match_kind_check("if")) {
            else_val = this.parse_if_expr()
        } else if (this.match_kind_check("{")) {
            this.advance()
            while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                while (this.match_kind(";")) {}
                if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
                else_stmts.push(this.parse_stmt())
            }
            this.consume("}")
            if (else_stmts.length() > 0) {
                var last: AST.Stmt = else_stmts[else_stmts.length() - 1]
                if (this.is_value_stmt(last)) {
                    else_val = this.stmt_to_expr(last)
                    else_stmts.pop()
                }
            }
        } else {
            else_val = this.parse_expr()
        }
        return AST.Expr.IfExpr(cond, then_stmts, then_val, else_stmts, else_val)
    }

    fun parse_try_expr(): AST.Expr {
        this.advance() // consume try
        this.consume("{")
        var try_stmts: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
            try_stmts.push(this.parse_stmt())
        }
        this.consume("}")
        // Extract last statement as value expression
        var try_val: AST.Expr = AST.Expr.NilLit
        if (try_stmts.length() > 0) {
            var last: AST.Stmt = try_stmts[try_stmts.length() - 1]
            if (this.is_value_stmt(last)) {
                try_val = this.stmt_to_expr(last)
                try_stmts.pop()
            }
        }
        this.consume("catch")
        this.consume("(")
        var catch_name: String = this.expect_ident()
        this.consume(")")
        this.consume("{")
        var catch_stmts: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
            catch_stmts.push(this.parse_stmt())
        }
        this.consume("}")
        var catch_val: AST.Expr = AST.Expr.NilLit
        if (catch_stmts.length() > 0) {
            var last: AST.Stmt = catch_stmts[catch_stmts.length() - 1]
            if (this.is_value_stmt(last)) {
                catch_val = this.stmt_to_expr(last)
                catch_stmts.pop()
            }
        }
        return AST.Expr.TryExpr(try_stmts, try_val, catch_name, catch_stmts, catch_val)
    }

    fun parse_pattern(): AST.Pattern {
        // Optional 'is' prefix: is Ready(u) => ...
        this.match_kind("is")
        // Handle literal patterns: 0, 1, "hello", etc.
        if (this.match_kind_check("int") or this.match_kind_check("float")) {
            var kind: Lexer.TokenKind = this.current_kind()
            this.advance()
            var lit_val: String = match (kind) {
                TkInt(v) => v.floor().to_string()
                TkFloat(v) => v.to_string()
                _ => "0"
            }
            return AST.Pattern.VariantPattern(lit_val, [])
        }
        if (this.match_kind_check("string")) {
            var kind: Lexer.TokenKind = this.current_kind()
            this.advance()
            var str_val: String = match (kind) {
                TkString(s) => s
                _ => ""
            }
            return AST.Pattern.VariantPattern("__strpat:" + str_val, [])
        }
        var name: String = this.expect_ident()
        if (this.match_kind("(")) {
            var bindings: List<String> = []
            if (!this.match_kind_check(")")) {
                bindings.push(this.expect_ident())
                while (this.match_kind(",")) {
                    bindings.push(this.expect_ident())
                }
            }
            this.consume(")")
            return AST.Pattern.VariantPattern(name, bindings)
        }
        // A bare lowercase name with no payload list is a catch-all that binds
        // the subject, not a variant reference — variants are capitalised. The
        // AST has carried NamedWildcard for this since the start and the parser
        // never produced it, so `x => ...` came out as VariantPattern("x", []).
        // Codegen already treats an unknown variant name as a catch-all, which
        // is why the compiler ran; the checker counted "x" as a matched variant
        // and then reported every real variant as missing.
        if (name.length() > 0) {
            var first_ch: String = name.char_at(0)
            if (first_ch == first_ch.to_lower() and first_ch != first_ch.to_upper()) {
                return AST.Pattern.NamedWildcard(name)
            }
        }
        return AST.Pattern.VariantPattern(name, [])
    }

    // --- Type string to AST.Type conversion ---

    fun parse_type_ast(s: String): AST.Type {
        if (s == "Int" or s == "Number") return AST.Type.IntType
        if (s == "Float") return AST.Type.FloatType
        if (s == "Bool") return AST.Type.BoolType
        if (s == "String") return AST.Type.StringType
        if (s == "Nil") return AST.Type.NilType
        if (s == "Any") return AST.Type.AnyType
        // Function type: "Fun(A,B):R", as parse_single_type encodes `(A, B) => R`.
        //
        // This is checked BEFORE the union and generic branches, not after, because
        // both of those would claim the string first and mangle it. `Fun(Map<String,
        // Int>):Bool` contains a `<`, so the generic branch below used to slice it
        // into GenericType("Fun(Map", ...) — and it does not end in `>`, so even the
        // argument slice was off by the trailing `):Bool`. Likewise `Fun(String|Nil):
        // Int` contains a `|` and came out as a two-member union of two fragments.
        // A function type is recognizable from its first four characters; recognize
        // it there and the nesting is handled by recursion instead of by luck.
        if (s.starts_with("Fun(")) {
            return this.parse_fun_type_ast(s)
        }
        // Receiver function type: "Fun[Type](...):Ret"
        //
        // Also moved above the generic branch for the same reason: `Fun[Map<String,
        // Int>]():Bool` was being read as a generic. This still returns ClassType(s)
        // — the whole encoded string as a class name, which is what every downstream
        // consumer of a receiver closure type already expects — so the only change is
        // that it now reaches this line at all.
        if (s.starts_with("Fun[")) {
            return AST.Type.ClassType(s)
        }
        // Union: "String|Nil" or "Int|String"
        if (s.contains("|")) {
            var parts: List<String> = s.split("|")
            var types: List<AST.Type> = []
            var i: Float = 0
            while (i < parts.length()) {
                types.push(this.parse_type_ast(parts[i]))
                i = i + 1
            }
            return AST.Type.UnionType(types)
        }
        // Generic: "List<String>" or "Map<String,Number>"
        if (s.contains("<")) {
            var lt_pos: Float = 0
            var i: Float = 0
            while (i < s.length()) {
                if (s.char_at(i) == "<") {
                    lt_pos = i
                    i = s.length()
                }
                i = i + 1
            }
            var base: String = s.slice(0, lt_pos)
            var args_str: String = s.slice(lt_pos + 1, s.length() - 1)
            var arg_strs: List<String> = this.split_type_args(args_str)
            var args: List<AST.Type> = []
            var j: Float = 0
            while (j < arg_strs.length()) {
                args.push(this.parse_type_ast(arg_strs[j]))
                j = j + 1
            }
            return AST.Type.GenericType(base, args)
        }
        // Class/Enum type
        return AST.Type.ClassType(s)
    }

    // Parse the "Fun(A,B):R" encoding that parse_single_type produces for the arrow
    // spelling `(A, B) => R` into the FuncType node it describes.
    //
    // This used to be one line in parse_type_ast:
    //     if (s.starts_with("Fun(")) { return AST.Type.FuncType([], AST.Type.AnyType) }
    // which threw away the parameter list and the return type that parse_single_type
    // had just finished encoding. Every consumer downstream then saw a FuncType with
    // no parameters returning Any, and could not tell `(Box) => String` apart from a
    // bare `Fun`. That is what made `Fun<A, B, R>` the only spelling able to type a
    // block-syntax lambda `{ x => ... }` (BUGS #86): the checker's fun_param_types_of
    // reads the rendered declared type, and there was nothing left in it to read.
    //
    // The shape is fixed by parse_single_type (see the `=>` branch there): literal
    // "Fun(", the parameter types joined by "," with no spaces, then "):", then the
    // return type. Both halves go back through parse_type_ast, so a nested function
    // type or generic in either position parses by recursion.
    fun parse_fun_type_ast(s: String): AST.Type {
        // Find the ")" that closes the "(" in "Fun(". NOT the first ")": a nested
        // function type in the parameter list — "Fun(Fun(Int):Int):Bool" — has its
        // own, and stopping at that one would read the parameters as "Fun(Int" and
        // the return type as "Int):Bool".
        var depth: Float = 0
        var close_paren: Float = 0 - 1
        var i: Float = 4
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "(") {
                depth = depth + 1
            } else if (ch == ")") {
                if (depth == 0) {
                    close_paren = i
                    i = s.length()
                } else {
                    depth = depth - 1
                }
            }
            i = i + 1
        }
        // Unbalanced. Nothing parse_single_type emits looks like this, so it means
        // the string came from somewhere else; there is no structure to recover and
        // guessing one is what this function exists to stop doing.
        if (close_paren < 0) {
            return AST.Type.FuncType([], AST.Type.AnyType)
        }

        var params_str: String = s.slice(4, close_paren)
        var param_types: List<AST.Type> = []
        // "Fun():Void" must give zero parameters, not one parameter named "". Guard
        // on the slice being empty rather than splitting and filtering after, so the
        // empty string never becomes a type name.
        if (params_str.length() > 0) {
            var param_strs: List<String> = this.split_type_args(params_str)
            var pi: Float = 0
            while (pi < param_strs.length()) {
                var p: String = param_strs[pi].trim()
                if (p.length() > 0) {
                    param_types.push(this.parse_type_ast(p))
                }
                pi = pi + 1
            }
        }

        // ":" + return type follows the ")". A missing return type cannot come out of
        // parse_single_type, which always writes "):" before the return type — so
        // reaching this default means the string was built elsewhere. Any is the same
        // answer codegen's parse_func_type_str (types_body.sf) gives for the same
        // input, and it keeps the two readings of one encoding in agreement.
        var ret_type: AST.Type = AST.Type.AnyType
        if (close_paren + 1 < s.length() and s.char_at(close_paren + 1) == ":") {
            var ret_str: String = s.slice(close_paren + 2, s.length()).trim()
            if (ret_str.length() > 0) {
                // A top-level "|" here belongs to the RETURN type, not to the
                // function type. parse_single_type builds the return type with a full
                // parse_type() call, which consumes `?` and `|` itself — so by the
                // time it returns "Fun(A):R", the token stream is already past any
                // union, and the outer parse_type can never append one. `(A) => R?`
                // and `(A) => R|Nil` both arrive here as "Fun(A):R|Nil", meaning a
                // function returning `R|Nil`. The nullable-function type
                // `((A) => R)|Nil` has no distinct spelling in this encoding.
                ret_type = this.parse_type_ast(ret_str)
            }
        }
        return AST.Type.FuncType(param_types, ret_type)
    }

    fun type_ast_to_string(t: AST.Type): String {
        return match (t) {
            IntType => "Int"
            FloatType => "Float"
            BoolType => "Bool"
            StringType => "String"
            NilType => "Nil"
            AnyType => "Any"
            ClassType(n) => n
            EnumType(n) => n
            GenericType(base, args) => base
            UnionType(types) => "Union"
            FuncType(p, r) => "Fun"
            NullableType(inner) => "Nullable"
            // The parser never *builds* either of these — there is no surface
            // syntax for them — but the arms must exist, because a missing arm
            // returns an indeterminate value rather than failing to compile.
            UnknownType => "Unknown"
            NeverType => "Never"
        }
    }

    // Split a comma-separated type list on its TOP-LEVEL commas only.
    //
    // `<>`, `()` and `[]` all nest. Angle brackets were the only pair tracked here,
    // which was enough while the sole caller was the generic branch of
    // parse_type_ast — a generic argument list has no bare parentheses. It stopped
    // being enough once parse_fun_type_ast started splitting a function type's
    // parameter list, because a nested function type puts its own commas inside
    // parentheses: the parameter list of `Fun(Fun(Int,Bool):Int,String)` is
    // "Fun(Int,Bool):Int,String", whose first comma is inside the inner `Fun(...)`.
    // Tracking `<>` alone split that into three fragments — "Fun(Int", "Bool):Int",
    // "String" — and each fragment then parsed as a class named after the fragment.
    //
    // `[]` is tracked for the receiver form "Fun[Recv](A,B):R", which reaches the
    // parameter list of an enclosing function type the same way.
    fun split_type_args(s: String): List<String> {
        var args: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<" or ch == "(" or ch == "[") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">" or ch == ")" or ch == "]") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "," and depth == 0) {
                args.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            args.push(current)
        }
        return args
    }

    // --- Helpers for operator precedence ---

    fun parse_lambda(): AST.Expr {
        this.advance() // consume fun
        this.consume("(")
        var params: List<AST.Param> = []
        if (!this.match_kind_check(")")) {
            var pname_span: AST.Span = this.ident_span()
            var pname: String = this.expect_ident()
            if (!this.match_kind_check(":")) {
                this.parse_error("Parameter '" + pname + "' requires a type annotation")
                params.push(AST.Param.Param(pname, AST.Type.AnyType, AST.Expr.NilLit, "public", pname_span))
            } else {
                this.consume(":")
                var ptype: String = this.parse_type()
                var pdefault: AST.Expr = AST.Expr.NilLit
                if (this.match_kind("=")) { pdefault = this.parse_expr() }
                params.push(AST.Param.Param(pname, this.parse_type_ast(ptype), pdefault, "public", pname_span))
            }
            while (this.match_kind(",")) {
                pname_span = this.ident_span()
                pname = this.expect_ident()
                if (!this.match_kind_check(":")) {
                    this.parse_error("Parameter '" + pname + "' requires a type annotation")
                    params.push(AST.Param.Param(pname, AST.Type.AnyType, AST.Expr.NilLit, "public", pname_span))
                } else {
                    this.consume(":")
                    var ptype: String = this.parse_type()
                    var pdefault: AST.Expr = AST.Expr.NilLit
                    if (this.match_kind("=")) { pdefault = this.parse_expr() }
                    params.push(AST.Param.Param(pname, this.parse_type_ast(ptype), pdefault, "public", pname_span))
                }
            }
        }
        this.consume(")")
        // An omitted return type is UnknownType, not the old in-band `"Int"`.
        // `"Int"` was a real type name standing in for "nobody wrote one", so a
        // lambda returning a String was indistinguishable from one declared
        // `: Int` — mechanism M2, and the reason check_lambda_body has to blank
        // current_func_ret rather than trust this field.
        var ret_type: AST.Type = AST.Type.UnknownType
        if (this.match_kind(":")) {
            ret_type = this.parse_type_ast(this.parse_type())
        }
        if (this.match_kind("=>")) {
            // Short form: fun (x: Int) => expr
            var expr: AST.Expr = this.parse_expr()
            return AST.Expr.Lambda(params, ret_type, [AST.Stmt.Return(expr)])
        }
        // Block form: fun (x: Int) { ... }
        var body: List<AST.Stmt> = this.parse_block_stmts()
        return AST.Expr.Lambda(params, ret_type, body)
    }

    fun is_ident_named(name: String): Bool {
        if (!this.match_kind_check("ident")) return false
        var kind: Lexer.TokenKind = this.current_kind()
        var ident_name: String = match (kind) { TkIdent(n) => n    _ => "" }
        return ident_name == name
    }

    fun match_kind_check(expected: String): Bool {
        var kind: Lexer.TokenKind = this.current_kind()
        var name: String = this.kind_name(kind)
        return name == expected
    }

    fun kind_name(kind: Lexer.TokenKind): String {
        return match (kind) {
            TkPlus => "+"
            TkMinus => "-"
            TkStar => "*"
            TkSlash => "/"
            TkPercent => "%"
            TkAmpersand => "&"
            TkPipe => "|"
            TkCaret => "^"
            TkTilde => "~"
            TkShiftLeft => "<<"
            TkShiftRight => ">>"
            TkBang => "!"
            TkBangEq => "!="
            TkEqEq => "=="
            TkLt => "<"
            TkLtEq => "<="
            TkGt => ">"
            TkGtEq => ">="
            TkPlusEq => "+="
            TkMinusEq => "-="
            TkStarEq => "*="
            TkSlashEq => "/="
            TkPercentEq => "%="
            TkPlusPlus => "++"
            TkMinusMinus => "--"
            TkLParen => "("
            TkRParen => ")"
            TkLBrace => "{"
            TkRBrace => "}"
            TkLBracket => "["
            TkRBracket => "]"
            TkDot => "."
            TkComma => ","
            TkColon => ":"
            TkSemicolon => ";"
            TkEq => "="
            TkArrow => "->"
            TkFatArrow => "=>"
            TkQuestion => "?"
            TkVar => "var"
            TkLet => "let"
            TkFun => "fun"
            TkReturn => "return"
            TkIf => "if"
            TkElse => "else"
            TkWhile => "while"
            TkOr => "or"
            TkAnd => "and"
            TkTrue => "true"
            TkFalse => "false"
            TkNil => "nil"
            TkImport => "import"
            TkAs => "as"
            TkEnum => "enum"
            TkMatch => "match"
            TkClass => "class"
            TkThis => "this"
            TkFor => "for"
            TkIn => "in"
            TkTry => "try"
            TkCatch => "catch"
            TkThrow => "throw"
            TkFinally => "finally"
            TkIs => "is"
            TkYield => "yield"
            TkEof => "eof"
            TkInt(v) => "int"
            TkFloat(v) => "float"
            TkString(v) => "string"
            TkIdent(v) => "ident"
            TkDocComment(t) => "doc_comment"
            TkModuleDoc(t) => "module_doc"
            TkNewline => "newline"
        }
    }

    fun is_equality_op(): Bool {
        return this.match_kind_check("==") or this.match_kind_check("!=")
    }

    fun is_comparison_op(): Bool {
        if (this.html_depth > 0) { return false }
        if (this.match_kind_check("<")) {
            if (this.peek_is(">") or this.peek_is("/")) { return false }
            if (this.peek_is("ident") and this.is_html_open_at(this.pos + 1)) { return false }
            return true
        }
        return this.match_kind_check("<=") or
               this.match_kind_check(">") or this.match_kind_check(">=")
    }

    fun is_html_open_at(ident_pos: Float): Bool {
        // Check if ident at ident_pos is the start of an HTML element (not a comparison RHS).
        // HTML: <tag>, <tag/>, <tag attr=...>, <Tag> (component)
        // Comparison: <expr.method(), <expr), <expr + ...
        if (ident_pos + 1 >= this.tokens.length()) { return false }
        var next_tok: Lexer.Token = this.tokens[ident_pos + 1]
        var next_kind: Lexer.TokenKind = match (next_tok) { Token(k, l, c, o, ln) => k }
        var next_str: String = this.kind_name(next_kind)
        // After a tag name: >, />, or attribute name (ident), or = (shorthand)
        if (next_str == ">" or next_str == "/" or next_str == "ident" or next_str == "=") { return true }
        // Keywords that are valid attribute names (cls, for, in, is)
        if (next_str == "class" or next_str == "for" or next_str == "in" or next_str == "is") { return true }
        return false
    }

    fun is_shift_op(): Bool {
        return this.match_kind_check("<<") or this.match_kind_check(">>")
    }

    fun is_term_op(): Bool {
        return this.match_kind_check("+") or this.match_kind_check("-")
    }

    fun is_factor_op(): Bool {
        return this.match_kind_check("*") or this.match_kind_check("/") or this.match_kind_check("%")
    }

    fun get_op_string(): String {
        var kind: Lexer.TokenKind = this.current_kind()
        return match (kind) {
            TkPlus => "+"
            TkMinus => "-"
            TkStar => "*"
            TkSlash => "/"
            TkPercent => "%"
            TkAmpersand => "&"
            TkPipe => "|"
            TkCaret => "^"
            TkShiftLeft => "<<"
            TkShiftRight => ">>"
            TkBangEq => "!="
            TkEqEq => "=="
            TkLt => "<"
            TkLtEq => "<="
            TkGt => ">"
            TkGtEq => ">="
            // Callers only reach this after checking the token is an operator,
            // so "" is unreachable rather than a real spelling. Naming it keeps
            // the match exhaustive; without the arm the result was an
            // indeterminate string, not an error (BUGS #76).
            _ => ""
        }
    }

    // --- Docstring collection ---

    fun collect_doc_comments(): String {
        var parts: List<String> = []
        while (this.match_kind_check("doc_comment")) {
            var kind: Lexer.TokenKind = this.current_kind()
            var text: String = match (kind) {
                TkDocComment(t) => t
                _ => ""
}
            this.advance()
            parts.push(text)
        }
        if (parts.length() == 0) return ""
        return parts.join("\n")
    }

    fun collect_module_doc(): String {
        var parts: List<String> = []
        while (this.match_kind_check("module_doc")) {
            var kind: Lexer.TokenKind = this.current_kind()
            var text: String = match (kind) {
                TkModuleDoc(t) => t
                _ => ""
}
            this.advance()
            parts.push(text)
        }
        if (parts.length() == 0) return ""
        return parts.join("\n")
    }

    // --- Statements ---

    fun parse_program(): List<AST.Stmt> {
        // Collect leading //! module doc comments
        var module_doc: String = this.collect_module_doc()
        var stmts: List<AST.Stmt> = []
        while (!this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("eof")) { return stmts }
            stmts.push(this.parse_stmt())
        }
        return stmts
    }

    fun parse_stmt(): AST.Stmt {
        // Collect /// doc comments before declarations
        var docstring: String = this.collect_doc_comments()

        // An optional visibility modifier, read BEFORE any declaration test
        // below. It has to be first: `private` is a soft keyword, so by the time
        // one of the `match_kind_check("var")` tests runs the modifier would
        // already have been read as an expression statement naming a variable
        // called `private`. at_visibility_modifier's lookahead is what keeps
        // that reading available for code that genuinely has such a variable.
        var visibility: String = "public"
        if (this.at_visibility_modifier()) {
            visibility = this.take_visibility(false)
        }

        // Type aliases: type Name = TargetType
        if (this.is_ident_named("type")) {
            var alias_start: AST.Span = this.current_span()
            this.advance()
            var alias_name_span: AST.Span = this.ident_span()
            var alias_name: String = this.expect_ident()
            this.consume("=")
            var alias_target: String = this.parse_type()
            return AST.Stmt.VarDecl(alias_name, alias_target, AST.Expr.NilLit, "@type_alias", visibility,
                alias_name_span, this.span_from(alias_start))
        }

        // Extension methods: extend fun ClassName.method(params): RetType { body }
        if (this.is_ident_named("extend")) {
            var ext_start: AST.Span = this.current_span()
            this.advance()
            this.advance()
            var ext_class: String = this.expect_ident()
            this.consume(".")
            // The *method* name is the declaration's name, so it is the rename
            // target — not `ext_class`, which is a reference to a class declared
            // elsewhere.
            var ext_name_span: AST.Span = this.ident_span()
            var ext_method: String = this.expect_ident()
            this.consume("(")
            var ext_params: List<AST.Param> = []
            if (!this.match_kind_check(")")) {
                var pname_span: AST.Span = this.ident_span()
                var pname: String = this.expect_ident()
                if (!this.match_kind_check(":")) {
                    this.parse_error("Parameter '" + pname + "' requires a type annotation")
                    ext_params.push(AST.Param.Param(pname, AST.Type.AnyType, AST.Expr.NilLit, "public", pname_span))
                } else {
                    this.consume(":")
                    var ptype: String = this.parse_type()
                    ext_params.push(AST.Param.Param(pname, this.parse_type_ast(ptype), AST.Expr.NilLit, "public", pname_span))
                }
                while (this.match_kind(",")) {
                    pname_span = this.ident_span()
                    pname = this.expect_ident()
                    if (!this.match_kind_check(":")) {
                        this.parse_error("Parameter '" + pname + "' requires a type annotation")
                        ext_params.push(AST.Param.Param(pname, AST.Type.AnyType, AST.Expr.NilLit, "public", pname_span))
                    } else {
                        this.consume(":")
                        var ptype: String = this.parse_type()
                        ext_params.push(AST.Param.Param(pname, this.parse_type_ast(ptype), AST.Expr.NilLit, "public", pname_span))
                    }
                }
            }
            this.consume(")")
            // Same sentinel rule as the plain FunDecl site above: omitted is
            // UnknownType, not "Nil".
            var ext_ret: AST.Type = AST.Type.UnknownType
            if (this.match_kind(":")) {
                ext_ret = this.parse_type_ast(this.parse_type())
            }
            var ext_body: List<AST.Stmt> = []
            if (this.match_kind_check("{")) {
                ext_body = this.parse_block_stmts()
            }
            return AST.Stmt.FunDecl(ext_method, ext_params, ext_ret, ext_body, "@extend:" + ext_class, visibility,
                ext_name_span, this.span_from(ext_start))
        }

        // Check for decorator: @intrinsic, @extern("..."), or general @name / @name("...")
        if (this.is_ident_named("@")) {
            this.advance()
            var decorator: String = this.expect_ident()
            var annotation: String = ""
            if (decorator == "intrinsic") {
                annotation = "@intrinsic"
            } else if (decorator == "extern") {
                // @extern requires a parenthesized C signature string:
                //   @extern("double sqrt(double)") fun sqrt(x: Float): Float
                // Guard every step. The bare form `@extern fun ...` used to reach
                // the unguarded `match (kind) { TkString(s) => s }` below with a
                // `fun` token and crash the compiler with a SIGSEGV instead of a
                // diagnostic. A malformed decorator must be a parse error.
                this.consume("(")
                if (!this.match_kind_check("string")) {
                    this.parse_error("@extern requires a signature string, e.g. @extern(\"double sqrt(double)\")")
                    var sig: String = ""
                    annotation = "@extern:" + sig
                } else {
                    var kind: Lexer.TokenKind = this.current_kind()
                    var sig: String = match (kind) {
                        TkString(s) => s
                        _ => ""
                    }
                    this.advance()
                    this.consume(")")
                    annotation = "@extern:" + sig
                }
            } else {
                // General decorator: @name or @name("args")
                annotation = "@" + decorator
                if (this.match_kind_check("(")) {
                    this.advance()
                    if (this.match_kind_check("string")) {
                        var darg_kind: Lexer.TokenKind = this.current_kind()
                        var darg: String = match (darg_kind) { TkString(s) => s    _ => "" }
                        this.advance()
                        annotation = annotation + ":" + darg
                    }
                    this.consume(")")
                }
            }
            // A modifier may also follow the decorator, which is the order
            // Kotlin's style guide uses (annotations, then modifiers) and the
            // order that leaves the stdlib's 142 `@extern("...") fun _x` lines
            // annotatable by inserting one word rather than moving the signature.
            // Both orders are accepted; writing both is not, because the two
            // would have to agree and the diagnostic for disagreeing is worse
            // than the diagnostic for saying it twice.
            if (this.at_visibility_modifier()) {
                if (visibility != "public") {
                    this.parse_error("visibility given twice: '" + visibility + "' before the decorator and '" + this.peek_ident() + "' after it")
                }
                visibility = this.take_visibility(false)
            }

            // The modifier read at the top of parse_stmt governs the decorated
            // declaration, so it has to be threaded through rather than left at
            // the `"public"` these two _with_doc helpers default to. Dropping it
            // would accept `private @extern(...) fun _f()` and then export _f,
            // which is the silent-wrong-answer shape the whole feature exists to
            // avoid.
            if (this.match_kind_check("class")) {
                return this.parse_class_decl_vis(annotation, visibility)
            }
            return this.parse_fun_decl_vis(annotation, visibility)
        }

        if (this.match_kind_check("var")) return this.parse_var_decl_vis(docstring, visibility)
        if (this.match_kind_check("let")) return this.parse_var_decl_vis(docstring, visibility)
        if (this.match_kind_check("fun") and !this.peek_is("(")) return this.parse_fun_decl_vis(docstring, visibility)
        if (this.match_kind_check("enum")) return this.parse_enum_decl_vis(docstring, visibility)
        if (this.match_kind_check("class")) return this.parse_class_decl_vis(docstring, visibility)
        if (this.is_ident_named("interface")) return this.parse_class_decl_vis(docstring, visibility)
        if (this.is_ident_named("actor")) return this.parse_class_decl_vis("@actor\n" + docstring, visibility)
        // A modifier was consumed but nothing below this point is a declaration,
        // so there is nothing for it to modify. Reporting it beats letting the
        // statement parse as if the word had not been written: at_visibility_modifier
        // only returns true when a declaration keyword follows, so reaching here
        // means the two disagree and the disagreement is a bug worth surfacing.
        if (visibility != "public") {
            this.parse_error("'" + visibility + "' must be followed by a declaration")
        }
        if (this.match_kind_check("import")) return this.parse_import()
        if (this.match_kind_check("return")) return this.parse_return()
        if (this.match_kind_check("if")) return this.parse_if()
        if (this.match_kind_check("while")) return this.parse_while()
        if (this.match_kind_check("for")) return this.parse_for()
        if (this.match_kind_check("try")) return this.parse_try()
        if (this.match_kind_check("throw")) return this.parse_throw()
        if (this.is_ident_named("break")) { this.advance(); return AST.Stmt.Break }
        if (this.is_ident_named("continue")) { this.advance(); return AST.Stmt.Continue }
        if (this.match_kind_check("{")) return this.parse_block()
        // Check for assignment: ident = expr
        if (this.match_kind_check("ident") and this.peek_is("=")) {
            return this.parse_assign()
        }
        // Check for this.field = value
        //
        // parse_this_stmt (and the `ident[...]` branch below) consume a
        // member/index/call chain and return an ExprStmt *terminally*, never
        // handing the result back to the binary-operator layer. So an infix
        // operator that followed was left trying to start a fresh statement:
        // `this.f + 1` reported "expected a literal, name or '(' here" at the
        // `+` (BUGS #129), which reads as if the operator were the mistake.
        //
        // Rather than thread a precedence level through both functions, note
        // where the statement began and, if one of them stopped on an operator
        // that can only continue an expression, rewind and re-parse the whole
        // thing through parse_expr — which already handles `this` and indexing
        // as ordinary primaries. Re-parsing cannot loop: parse_expr does not
        // consult this branch, and the assignment forms never stop on an infix
        // operator (their right-hand side has already absorbed it), so a rewind
        // only ever happens for a shape parse_expr can handle by itself.
        if (this.match_kind_check("this")) {
            var this_start: Float = this.pos
            var this_errs: Float = this.error_count
            var this_stmt: AST.Stmt = this.parse_this_stmt()
            if (this.error_count == this_errs and this.at_expr_continuation()) {
                this.pos = this_start
                return this.parse_expr_stmt()
            }
            return this_stmt
        }
        // A statement beginning `ident[` needs no special case. It used to have
        // one — consume the name, `[`, the index, `]`, then check for `=` — and
        // that branch is BUGS #138: it *returned* at the `]`, so the postfix
        // chain past it (`xs[0].bump()`) was left in the token stream and
        // re-parsed as a fresh statement starting at `.`.
        //
        // A rewind-on-continuation guard was tried here first (the shape used for
        // `this` above) and is NOT sufficient: `at_expr_continuation` lists infix
        // operators, so it catches `xs[0] + 1` but not `.`, `[` or `(`. Adding
        // those three to it would work, and would still leave a branch whose only
        // remaining job is duplicating what the general path does.
        //
        // parse_expr_stmt already handles every shape this branch existed for:
        // parse_expr's postfix loop consumes `[ ] -> . -> call` to the end, and a
        // trailing `=` reaches build_assign, whose "index" arm builds the same
        // IndexSet this branch built by hand. So the fix is deletion, not
        // another guard.
        return this.parse_expr_stmt()
    }

    /// The general expression-statement path: parse one expression, then handle
    /// a trailing `=`, a compound assignment (`+=` and friends) or a postfix
    /// `++`/`--`.
    ///
    /// Split out of parse_stmt so the two rewind sites above can re-enter it,
    /// and so all three assignment forms share one place that decides what
    /// counts as an assignable target.
    fun parse_expr_stmt(): AST.Stmt {
        var expr: AST.Expr = this.parse_expr()
        if (this.match_kind("=")) {
            var value: AST.Expr = this.parse_expr()
            return this.build_assign(expr, value)
        }
        if (this.at_compound_assign_op()) {
            var cop: String = this.compound_assign_base_op()
            this.advance()
            var rhs: AST.Expr = this.parse_expr()
            return this.build_compound_assign(expr, cop, rhs)
        }
        // `x++` is NOT handled here. It is a postfix *expression* operator
        // (parse_postfix), so by this point parse_expr has already consumed it
        // and `expr` is the BlockExpr it desugars to. Adding a branch for it
        // here would be dead code that looks live — the shape that made #38 and
        // #91 hard to find.
        return AST.Stmt.ExprStmt(expr)
    }

    /// `target = value`, as the statement node the target's shape calls for.
    ///
    /// A plain `MemberAccess` target has to become `SetField`; everything else
    /// (a `Variable` handled by parse_assign, an `IndexGet` handled by the
    /// branch above, an `Assign` already built by the expression layer) is
    /// already in its assignment form by the time it gets here.
    fun build_assign(target: AST.Expr, value: AST.Expr): AST.Stmt {
        var ek: String = this.classify_expr_for_assign(target)
        // Every arm here rewrites a *read* node into its matching *write* node,
        // and both spell the same source identifier. So the write inherits the
        // read's span rather than re-deriving one: `obj.f` and `obj.f = v` must
        // locate at the same place or a rename finds only half its occurrences.
        // By this point the tokens are long consumed, so the node's own span is
        // the only record of where they were.
        if (ek == "member") {
            var obj: AST.Expr = match (target) { MemberAccess(o, f, __ms) => o
                _ => AST.Expr.NilLit
            }
            var field: String = match (target) { MemberAccess(o, f, __ms) => f
                _ => ""
            }
            var fs: AST.Span = match (target) { MemberAccess(o, f, __ms) => __ms
                _ => AST.span_none()
            }
            return AST.Stmt.ExprStmt(AST.Expr.SetField(obj, field, value, fs))
        }
        if (ek == "index") {
            var iobj: AST.Expr = match (target) { IndexGet(o, i) => o
                _ => AST.Expr.NilLit
            }
            var iidx: AST.Expr = match (target) { IndexGet(o, i) => i
                _ => AST.Expr.NilLit
            }
            // IndexSet carries no span: there is no identifier to point at.
            return AST.Stmt.ExprStmt(AST.Expr.IndexSet(iobj, iidx, value))
        }
        if (ek == "get_field") {
            var gobj: AST.Expr = match (target) { GetField(o, f, __gs) => o
                _ => AST.Expr.NilLit
            }
            var gfield: String = match (target) { GetField(o, f, __gs) => f
                _ => ""
            }
            var gs: AST.Span = match (target) { GetField(o, f, __gs) => __gs
                _ => AST.span_none()
            }
            return AST.Stmt.ExprStmt(AST.Expr.SetField(gobj, gfield, value, gs))
        }
        if (ek == "variable") {
            var vname: String = match (target) { Variable(n, __vs) => n
                _ => ""
            }
            var vs: AST.Span = match (target) { Variable(n, __vs) => __vs
                _ => AST.span_none()
            }
            return AST.Stmt.ExprStmt(AST.Expr.Assign(vname, value, vs))
        }
        // Some other shape on the left of `=` — a literal, a call, an
        // arithmetic result. Silently discarding `value` (the old behaviour)
        // is worse than saying so; this diagnostic came from the BUGS #137 fix,
        // where the soft-keyword read arms exposed that `as = "x"` had its value
        // dropped with no error at all. `as`/`in`/`is` now classify as
        // "variable" above, so this arm is the genuine non-place case.
        this.parse_error("cannot assign to this expression")
        return AST.Stmt.ExprStmt(target)
    }

    /// `target <op>= rhs`, desugared to `target = target <op> (rhs)`.
    ///
    /// The target is re-evaluated rather than held in a temporary, so a target
    /// with a side effect in it (`f().x += 1`) evaluates `f()` twice. Rust and
    /// Python both evaluate the place exactly once; matching them needs a real
    /// place-expression AST node, which is more surgery than this feature is
    /// worth today. This is a known and deliberate gap, NOT a rejected case —
    /// `f().x += 1` compiles and calls `f()` twice. Postfix `++`/`--` does not
    /// share it: `build_postfix_incr` hoists the receiver and index into
    /// temporaries, so `arr[g()]++` calls `g()` once (asserted in
    /// test/pass/increment.sf). If the double evaluation here ever bites, the
    /// fix is to give compound assignment the same hoisting, not to reject the
    /// shape.
    ///
    /// `rhs` is wrapped in nothing, but `parse_expr` has already given it the
    /// whole remainder of the expression, so `x *= 2 + 3` is `x = x * (2 + 3)`
    /// — the low precedence of the compound operator falls out of parsing the
    /// right-hand side as a complete expression, as it should.
    fun build_compound_assign(target: AST.Expr, op: String, rhs: AST.Expr): AST.Stmt {
        if (!this.check_compound_assign_target(target, op)) {
            return AST.Stmt.ExprStmt(target)
        }
        return this.build_assign(target, AST.Expr.Binary(target, op, rhs))
    }

    /// Reject a compound-assignment target that is not a simple place, with a
    /// diagnostic naming the restriction.
    ///
    /// Returns true when the target is assignable. `Variable`, `MemberAccess`,
    /// `GetField` and `IndexGet` are the four shapes `build_assign` can turn
    /// into an assignment; anything else — a literal, a call, an arithmetic
    /// result — is not a place, and the desugaring would otherwise produce
    /// `1 = 1 + 1` and hand it to the checker as a confusing downstream error.
    fun check_compound_assign_target(target: AST.Expr, op: String): Bool {
        var ek: String = this.classify_expr_for_assign(target)
        if (ek == "variable" or ek == "member" or ek == "get_field" or ek == "index") {
            return true
        }
        this.parse_error("the left side of '" + op + "=' must be a variable, field or element, not an expression")
        return false
    }

    fun at_compound_assign_op(): Bool {
        return this.match_kind_check("+=") or this.match_kind_check("-=") or
               this.match_kind_check("*=") or this.match_kind_check("/=") or
               this.match_kind_check("%=")
    }

    /// The arithmetic operator underlying the compound-assignment token the
    /// parser is sitting on — `+=` yields `"+"`.
    fun compound_assign_base_op(): String {
        if (this.match_kind_check("+=")) { return "+" }
        if (this.match_kind_check("-=")) { return "-" }
        if (this.match_kind_check("*=")) { return "*" }
        if (this.match_kind_check("/=")) { return "/" }
        if (this.match_kind_check("%=")) { return "%" }
        // Callers check at_compound_assign_op first, so this is unreachable
        // rather than a real spelling — named so the function has no
        // indeterminate result (BUGS #76).
        return "+"
    }

    /// True when the current token can only *continue* an expression, never
    /// begin a statement — i.e. some infix operator.
    ///
    /// Used by the `this`- and `ident[`-initial statement branches to detect
    /// that they stopped mid-expression and should hand the whole statement to
    /// parse_expr instead (BUGS #129). Every operator listed here is one the
    /// precedence ladder in parse_or..parse_factor consumes, plus the two
    /// logical keywords and `is`.
    ///
    /// `is` carries parse_comparison's same-line guard, because that is the
    /// condition under which parse_comparison would actually absorb it; without
    /// the guard a following line's `is`-pattern match arm would drag the
    /// previous statement into itself.
    ///
    /// `.`, `[` and `(` are deliberately absent, and the reason is specific to
    /// the one caller: parse_this_stmt's chain loops already consume those, so
    /// seeing one here would mean the chain ended for some other reason and
    /// rewinding would change nothing.
    ///
    /// That reasoning does NOT generalise. The `ident[`-initial branch had no
    /// such loop — it returned at the `]` — so for it the postfix tokens were
    /// exactly the continuations that mattered, and this predicate missed them
    /// (BUGS #138: `xs[0].bump()` still failed with the rewind in place). That
    /// branch is gone rather than patched. Before adding a second caller, check
    /// whether it consumes postfix tokens itself; if it does not, this predicate
    /// is the wrong tool.
    ///
    /// The compound-assignment and increment operators are included for the same
    /// reason as the infix ones: `this.f += 1` and `this.f++` need to reach
    /// parse_expr_stmt's handling of them, and parse_this_stmt stops on both.
    fun at_expr_continuation(): Bool {
        if (this.at_compound_assign_op()) { return true }
        if (this.match_kind_check("++") or this.match_kind_check("--")) { return true }
        if (this.is_term_op()) { return true }
        if (this.is_factor_op()) { return true }
        if (this.is_shift_op()) { return true }
        if (this.is_equality_op()) { return true }
        if (this.is_comparison_op()) { return true }
        if (this.match_kind_check("&")) { return true }
        if (this.match_kind_check("|")) { return true }
        if (this.match_kind_check("^")) { return true }
        if (this.match_kind_check("and")) { return true }
        if (this.match_kind_check("or")) { return true }
        if (this.match_kind_check("is") and this.current_line_num() == this.prev_line_num()) {
            return true
        }
        return false
    }

    /// Which assignment form `expr` can serve as the target of.
    ///
    /// "member"/"get_field" become SetField, "index" becomes IndexSet,
    /// "variable" becomes Assign, and "other" is not a place at all. Only
    /// "member" mattered while `=` was the sole assignment operator and the
    /// other three shapes were each handled by their own branch in parse_stmt;
    /// compound assignment routes all four through build_assign, so they all
    /// need naming here.
    fun classify_expr_for_assign(expr: AST.Expr): String {
        return match (expr) {
            MemberAccess(o, f, __ms) => "member"
            GetField(o, f, __gs) => "get_field"
            IndexGet(o, i) => "index"
            Variable(n, __vs) => "variable"
            _ => "other"
        }
    }

    fun peek_is(expected: String): Bool {
        if (this.pos + 1 >= this.tokens.length()) return false
        var next_tok: Lexer.Token = this.tokens[this.pos + 1]
        var next_kind: Lexer.TokenKind = match (next_tok) { Token(k, l, c, o, ln) => k }
        return this.kind_name(next_kind) == expected
    }

    fun parse_call_arg(): AST.Expr {
        // Named argument: ident = expr (Kotlin-style)
        if (this.match_kind_check("ident") and this.peek_is("=")) {
            var arg_span: AST.Span = this.ident_span()
            var arg_name: String = this.expect_ident()
            this.advance()
            var arg_val: AST.Expr = this.parse_expr()
            return AST.Expr.Assign(arg_name, arg_val, arg_span)
        }
        return this.parse_expr()
    }

    fun parse_assign(): AST.Stmt {
        var name_span: AST.Span = this.ident_span()
        var name: String = this.expect_ident()
        this.consume("=")
        var value: AST.Expr = this.parse_expr()
        return AST.Stmt.ExprStmt(AST.Expr.Assign(name, value, name_span))
    }

    fun parse_var_decl(): AST.Stmt {
        return this.parse_var_decl_with_doc("")
    }

    fun parse_var_decl_with_doc(docstring: String): AST.Stmt {
        return this.parse_var_decl_vis(docstring, "public")
    }

    fun parse_var_decl_vis(docstring: String, visibility: String): AST.Stmt {
        // Captured before `advance()`, so the declaration's extent starts at the
        // `var`/`let` keyword rather than at the name.
        var decl_start: AST.Span = this.current_span()
        this.advance() // consume var/let
        // Check for array destructuring: let [a, b, c] = expr
        if (this.match_kind_check("[")) {
            return this.parse_destructure()
        }
        // Tuple destructuring: let (a, b) = expr
        if (this.match_kind_check("(")) {
            return this.parse_tuple_destructure()
        }
        var name_span: AST.Span = this.ident_span()
        var name: String = this.expect_ident()
        // Qualified variant pattern: `let Shape.Circle(r) = ...`. Unqualified
        // `let Circle(r) = ...` already worked, but writing the enum name — the
        // natural thing to do, and how the value itself is constructed — was a
        // parse error ("expected '=' but found '.'"). Only the variant name is
        // kept: patterns resolve by variant, and gen_match /
        // find_enum_for_variant recover the enum from it.
        // A loop, not a single step, so a module-qualified enum
        // (`let Shapes.Shape.Circle(r) = ...`) also parses.
        var was_qualified: Bool = false
        while (this.match_kind_check(".")) {
            this.advance()
            // Track the span alongside the name: only the last segment is kept as
            // the name, so only the last segment's region is the right target.
            name_span = this.ident_span()
            name = this.expect_ident()
            was_qualified = true
        }
        // A dotted name is only meaningful as a variant pattern. Anything else
        // (`var x.y = 5`) is malformed, and saying so beats silently declaring
        // `y`.
        if (was_qualified and !this.match_kind_check("(")) {
            this.parse_error("qualified name is only valid in a destructuring pattern, e.g. let Shape.Circle(r) = ...")
        }
        // Variant pattern: let Some(x) = expr
        if (this.match_kind_check("(")) {
            this.advance()
            var bindings: List<String> = []
            if (!this.match_kind_check(")")) {
                bindings.push(this.expect_ident())
                while (this.match_kind(",")) {
                    bindings.push(this.expect_ident())
                }
            }
            this.consume(")")
            this.consume("=")
            var pat_val: AST.Expr = this.parse_expr()
            return AST.Stmt.LetPattern(AST.Pattern.VariantPattern(name, bindings), pat_val)
        }
        // "" means "no annotation was written", NOT "Any". This used to default to
        // "Any", which made an explicit `var x: Any = f()` indistinguishable from
        // an unannotated `var x = f()` — so the checker took the infer-from-
        // initializer branch and bound the initializer's type, and `: Any` could
        // not widen a binding, the one thing an author writes it for (BUGS #147).
        //
        // Every downstream reader already treated empty and "Any" alike (see the
        // `vtype.length() == 0 or vtype == "Any"` guards in codegen.sf's global
        // pre-scans), so "" is the value that was already safe to send; what was
        // missing was the parser ever sending it.
        var type_ann: String = ""
        if (this.match_kind(":")) {
            type_ann = this.parse_type()
        }
        this.consume("=")
        var init: AST.Expr = this.parse_expr()
        return AST.Stmt.VarDecl(name, type_ann, init, docstring, visibility,
            name_span, this.span_from(decl_start))
    }

    fun parse_destructure(): AST.Stmt {
        this.advance() // consume [
        var names: List<String> = []
        var rest_name: String = ""
        if (!this.match_kind_check("]")) {
            if (this.match_kind("*")) {
                rest_name = this.expect_ident()
            } else {
                names.push(this.expect_ident())
            }
            while (this.match_kind(",")) {
                if (this.match_kind("*")) {
                    rest_name = this.expect_ident()
                } else {
                    names.push(this.expect_ident())
                }
            }
        }
        this.consume("]")
        this.consume("=")
        var init: AST.Expr = this.parse_expr()
        return AST.Stmt.LetPattern(AST.Pattern.ArrayPattern(names, rest_name), init)
    }

    fun parse_tuple_destructure(): AST.Stmt {
        this.advance() // consume (
        var names: List<String> = []
        if (!this.match_kind_check(")")) {
            names.push(this.expect_ident())
            while (this.match_kind(",")) {
                names.push(this.expect_ident())
            }
        }
        this.consume(")")
        this.consume("=")
        var init: AST.Expr = this.parse_expr()
        var stmts: List<AST.Stmt> = []
        var tmp_name: String = "__destruct"
        stmts.push(AST.Stmt.VarDecl(tmp_name, "", init, "", "public", AST.span_none(), AST.span_none()))
        var i: Float = 0
        while (i < names.length()) {
            var idx_expr: AST.Expr = AST.Expr.IndexGet(AST.Expr.Variable(tmp_name, AST.span_none()), AST.Expr.IntLit(i))
            stmts.push(AST.Stmt.VarDecl(names[i], "", idx_expr, "", "public", AST.span_none(), AST.span_none()))
            i = i + 1
        }
        return AST.Stmt.Block(stmts)
    }

    fun parse_fun_decl(): AST.Stmt {
        return this.parse_fun_decl_with_doc("")
    }

    fun parse_fun_decl_with_doc(docstring: String): AST.Stmt {
        return this.parse_fun_decl_vis(docstring, "public")
    }

    fun parse_fun_decl_vis(docstring: String, visibility: String): AST.Stmt {
        var decl_start: AST.Span = this.current_span()
        this.advance() // consume fun
        var name_span: AST.Span = this.ident_span()
        var name: String = this.expect_ident()
        // Parse generic type parameters: fun foo<T>(...) or fun bar<K, V: Constraint>(...)
        // Encodes as "@generic:T,U:Constraint+Other\n" prefix in docstring
        if (this.match_kind_check("<")) {
            this.advance()
            var generic_str: String = ""
            var depth: Float = 1
            while (depth > 0 and !this.match_kind_check("eof")) {
                if (this.match_kind_check("<")) {
                    depth = depth + 1
                    this.advance()
                } else if (this.match_kind_check(">")) {
                    depth = depth - 1
                    if (depth > 0) {
                        generic_str = generic_str + ">"
                    }
                    this.advance()
                } else if (this.match_kind_check(">>")) {
                    depth = depth - 2
                    if (depth > 0) {
                        generic_str = generic_str + ">>"
                    }
                    this.advance()
                } else if (this.match_kind_check(",")) {
                    if (depth == 1) {
                        generic_str = generic_str + ","
                    }
                    this.advance()
                } else if (this.match_kind_check(":")) {
                    generic_str = generic_str + ":"
                    this.advance()
                } else if (this.match_kind_check("+")) {
                    generic_str = generic_str + "+"
                    this.advance()
                } else if (this.match_kind_check("ident")) {
                    var part: String = this.expect_ident()
                    generic_str = generic_str + part
                } else {
                    this.advance()
                }
            }
            if (generic_str.length() > 0) {
                docstring = "@generic:" + generic_str + "\n" + docstring
            }
        }
        // Extract type param names from generic_str for erasure
        var type_param_names: List<String> = []
        if (docstring.starts_with("@generic:")) {
            var nl_pos: Float = docstring.index_of("\n")
            var gstr: String = ""
            if (nl_pos >= 0) {
                gstr = docstring.slice(9, nl_pos)
            } else {
                gstr = docstring.slice(9, docstring.length())
            }
            var gparts: List<String> = gstr.split(",")
            var gi: Float = 0
            while (gi < gparts.length()) {
                var gp: String = gparts[gi]
                var gc_pos: Float = gp.index_of(":")
                if (gc_pos >= 0) {
                    type_param_names.push(gp.slice(0, gc_pos))
                } else {
                    type_param_names.push(gp)
                }
                gi = gi + 1
            }
        }
        this.consume("(")
        var params: List<AST.Param> = []
        var pattern_prepend: List<AST.Stmt> = []
        var param_idx: Float = 0
        if (!this.match_kind_check(")")) {
            this.parse_one_param(params, pattern_prepend, param_idx)
            param_idx = param_idx + 1
            while (this.match_kind(",")) {
                this.parse_one_param(params, pattern_prepend, param_idx)
                param_idx = param_idx + 1
            }
        }
        this.consume(")")
        // An omitted return type is UnknownType. It used to be the string "Nil",
        // which is a type a user can actually write — so `fun f(): Nil` and
        // `fun f()` were the same node, and the Return check could not reject
        // `fun f(): Nil { return 42 }` without also rejecting every unannotated
        // function (BUGS #155).
        var ret_type: AST.Type = AST.Type.UnknownType
        if (this.match_kind(":")) {
            ret_type = this.parse_type_ast(this.parse_type())
        }
        // Erase type params in parameter types and return type for codegen
        // (generics are erased at compile time — all values are i64 NaN-boxed)
        if (type_param_names.length() > 0) {
            var epi: Float = 0
            while (epi < params.length()) {
                var ep: AST.Param = params[epi]
                var ep_name: String = match (ep) { Param(n, t, d, p_vis, __ns) => n }
                var ep_type: AST.Type = match (ep) { Param(n, t, d, p_vis, __ns) => t }
                var ep_default: AST.Expr = match (ep) { Param(n, t, d, p_vis, __ns) => d }
                var ep_type_str: String = this.type_ast_to_string(ep_type)
                if (type_param_names.contains(ep_type_str)) {
                    params[epi] = AST.Param.Param(ep_name, AST.Type.AnyType, ep_default, "public", AST.span_none())
                }
                epi = epi + 1
            }
            // Also erase type params in return type
            if (type_param_names.contains(this.type_ast_to_string(ret_type))) {
                // Keep the type param name in ret_type for checker resolution
                // but the codegen will treat it correctly since params are erased
            }
        }
        var body: List<AST.Stmt> = []
        if (this.match_kind("=")) {
            var expr: AST.Expr = this.parse_expr()
            body = [AST.Stmt.Return(expr)]
        } else if (this.match_kind_check("{")) {
            body = this.parse_block_stmts()
        }
        if (pattern_prepend.length() > 0) {
            var new_body: List<AST.Stmt> = []
            var ppi: Float = 0
            while (ppi < pattern_prepend.length()) { new_body.push(pattern_prepend[ppi]); ppi = ppi + 1 }
            ppi = 0
            while (ppi < body.length()) { new_body.push(body[ppi]); ppi = ppi + 1 }
            body = new_body
        }
        return AST.Stmt.FunDecl(name, params, ret_type, body, docstring, visibility,
            name_span, this.span_from(decl_start))
    }

    fun parse_one_param(params: List<AST.Param>, pattern_prepend: List<AST.Stmt>, idx: Float) {
        var pname_span: AST.Span = this.ident_span()
        var pname: String = this.expect_ident()
        if (this.match_kind_check("(")) {
            this.advance()
            var pb: List<String> = []
            if (!this.match_kind_check(")")) {
                pb.push(this.expect_ident())
                while (this.match_kind(",")) { pb.push(this.expect_ident()) }
            }
            this.consume(")")
            this.consume(":")
            var ptype: String = this.parse_type()
            var syn_name: String = "__p" + idx.floor().to_string()
            params.push(AST.Param.Param(syn_name, this.parse_type_ast(ptype), AST.Expr.NilLit, "public", AST.span_none()))
            pattern_prepend.push(AST.Stmt.LetPattern(AST.Pattern.VariantPattern(pname, pb), AST.Expr.Variable(syn_name, AST.span_none())))
        } else if (pname == "_") {
            this.consume(":")
            var ptype: String = this.parse_type()
            var syn_name: String = "__p" + idx.floor().to_string()
            params.push(AST.Param.Param(syn_name, this.parse_type_ast(ptype), AST.Expr.NilLit, "public", AST.span_none()))
        } else if (!this.match_kind_check(":")) {
            this.parse_error("Parameter '" + pname + "' requires a type annotation")
            params.push(AST.Param.Param(pname, AST.Type.AnyType, AST.Expr.NilLit, "public", pname_span))
        } else {
            this.consume(":")
            var ptype: String = this.parse_type()
            var pdefault: AST.Expr = AST.Expr.NilLit
            if (this.match_kind("=")) { pdefault = this.parse_expr() }
            params.push(AST.Param.Param(pname, this.parse_type_ast(ptype), pdefault, "public", pname_span))
        }
    }

    fun parse_enum_decl(): AST.Stmt {
        return this.parse_enum_decl_with_doc("")
    }

    fun parse_enum_decl_with_doc(docstring: String): AST.Stmt {
        return this.parse_enum_decl_vis(docstring, "public")
    }

    fun parse_enum_decl_vis(docstring: String, visibility: String): AST.Stmt {
        var decl_start: AST.Span = this.current_span()
        this.advance() // consume enum
        var name_span: AST.Span = this.ident_span()
        var name: String = this.expect_ident()
        // Skip generic type parameters: enum Option<T> or enum Result<T, E>
        if (this.match_kind_check("<")) {
            this.advance()
            var depth: Float = 1
            while (depth > 0 and !this.match_kind_check("eof")) {
                if (this.match_kind_check("<")) {
                    depth = depth + 1
                } else if (this.match_kind_check(">")) {
                    depth = depth - 1
                } else if (this.match_kind_check(">>")) {
                    depth = depth - 2
                }
                this.advance()
            }
        }
        this.consume("{")
        var variants: List<AST.Variant> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            // Skip doc comments inside enum body
            this.collect_doc_comments()
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
            // Per-variant visibility is rejected by design, not unimplemented.
            // Either exhaustiveness demands another module name a variant it may
            // not write, or it exempts private variants and the only total form
            // needs a `_` arm — and a non-exhaustive match in Saffron yields an
            // indeterminate value rather than an error (BUGS #76). Both readings
            // are worse than refusing the syntax. `private enum E` — the whole
            // type — is supported and has none of this interaction.
            var vis_word: String = this.peek_ident()
            if (vis_word == "private" or vis_word == "public"
                or vis_word == "internal" or vis_word == "protected") {
                var after_vis: String = this.peek_ident_next()
                if (after_vis.length() > 0) {
                    this.parse_error("enum variants cannot have a visibility modifier; mark the whole enum '"
                        + name + "' instead")
                    this.advance()
                }
            }
            var vname_span: AST.Span = this.ident_span()
            var vname: String = this.expect_ident()
            var fields: String = ""
            if (this.match_kind("(")) {
                var fields_sb: StringBuilder = StringBuilder()
                var first: Bool = true
                while (!this.match_kind_check(")")) {
                    if (!first) {
                        fields_sb.append(",")
                        this.consume(",")
                    }
                    var fname: String = this.expect_ident()
                    this.consume(":")
                    var ftype: String = this.parse_type()
                    fields_sb.append(fname)
                    fields_sb.append(":")
                    fields_sb.append(ftype)
                    first = false
                }
                this.consume(")")
                fields = fields_sb.to_string()
            }
            variants.push(AST.Variant.Variant(vname, fields, vname_span))
            this.match_kind(",")
        }
        this.consume("}")
        return AST.Stmt.EnumDecl(name, variants, docstring, visibility,
            name_span, this.span_from(decl_start))
    }

    fun parse_this_stmt(): AST.Stmt {
        var this_start: AST.Span = this.current_span()
        this.advance() // consume this
        this.consume(".")
        var field_span: AST.Span = this.ident_span()
        var field: String = this.expect_ident()
        if (this.match_kind("=")) {
            // this.field = value
            var value: AST.Expr = this.parse_expr()
            return AST.Stmt.ExprStmt(AST.Expr.SetField(AST.Expr.This, field, value, field_span))
        }
        // Build the initial expression and continue chaining (dots, indexes, calls)
        var expr: AST.Expr = AST.Expr.GetField(AST.Expr.This, field, field_span)
        var chained: Bool = false
        while (this.match_kind_check(".") or this.match_kind_check("[")) {
            chained = true
            if (this.match_kind_check("[")) {
                this.advance()
                var idx: AST.Expr = this.parse_expr()
                this.consume("]")
                if (this.match_kind("=")) {
                    var value: AST.Expr = this.parse_expr()
                    return AST.Stmt.ExprStmt(AST.Expr.IndexSet(expr, idx, value))
                }
                expr = AST.Expr.IndexGet(expr, idx)
            } else {
                this.advance()
                var next_span: AST.Span = this.ident_span()
                var next_field: String = this.expect_ident()
                if (this.match_kind("(")) {
                    var args: List<AST.Expr> = []
                    if (!this.match_kind_check(")")) {
                        args.push(this.parse_call_arg())
                        while (this.match_kind(",")) {
                            args.push(this.parse_call_arg())
                        }
                    }
                    this.consume(")")
                    expr = AST.Expr.MethodCall(expr, next_field, args, next_span)
                } else if (this.match_kind("=")) {
                    var value: AST.Expr = this.parse_expr()
                    return AST.Stmt.ExprStmt(AST.Expr.SetField(expr, next_field, value, next_span))
                } else {
                    expr = AST.Expr.MemberAccess(expr, next_field, next_span)
                }
            }
        }
        // Check for trailing call: this.field[idx]() or this.method(args)
        if (this.match_kind("(")) {
            var args: List<AST.Expr> = []
            if (!this.match_kind_check(")")) {
                args.push(this.parse_call_arg())
                while (this.match_kind(",")) {
                    args.push(this.parse_call_arg())
                }
            }
            this.consume(")")
            if (chained) {
                // expr was modified by indexing/chaining — this is an indirect call
                return AST.Stmt.ExprStmt(AST.Expr.Call(expr, args, this.span_from(this_start)))
            }
            return AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.This, field, args, field_span))
        }
        return AST.Stmt.ExprStmt(expr)
    }

    fun parse_dot_stmt(): AST.Stmt {
        var obj_span: AST.Span = this.ident_span()
        var obj_name: String = this.expect_ident()
        var expr: AST.Expr = AST.Expr.Variable(obj_name, obj_span)
        while (this.match_kind_check(".")) {
            this.advance()
            var field_span: AST.Span = this.ident_span()
            var field: String = this.expect_ident()
            if (this.match_kind_check("(")) {
                this.advance()
                var args: List<AST.Expr> = []
                if (!this.match_kind_check(")")) {
                    args.push(this.parse_call_arg())
                    while (this.match_kind(",")) {
                        args.push(this.parse_call_arg())
                    }
                    this.consume(")")
                } else {
                    this.advance()
                }
                expr = AST.Expr.MethodCall(expr, field, args, field_span)
            } else if (this.match_kind("=")) {
                var value: AST.Expr = this.parse_expr()
                return AST.Stmt.ExprStmt(AST.Expr.SetField(expr, field, value, field_span))
            } else {
                expr = AST.Expr.MemberAccess(expr, field, field_span)
            }
        }
        if (this.match_kind_check("[")) {
            this.advance()
            var idx: AST.Expr = this.parse_expr()
            this.consume("]")
            if (this.match_kind("=")) {
                var value: AST.Expr = this.parse_expr()
                return AST.Stmt.ExprStmt(AST.Expr.IndexSet(expr, idx, value))
            }
            expr = AST.Expr.IndexGet(expr, idx)
        }
        return AST.Stmt.ExprStmt(expr)
    }

    fun parse_class_decl(): AST.Stmt {
        return this.parse_class_decl_with_doc("")
    }

    fun parse_class_decl_with_doc(docstring: String): AST.Stmt {
        return this.parse_class_decl_vis(docstring, "public")
    }

    fun parse_class_decl_vis(docstring: String, visibility: String): AST.Stmt {
        var decl_start: AST.Span = this.current_span()
        // The introducer is the token we are about to consume, so it can simply be
        // read. `class` is a real keyword; `interface` and `actor` are soft
        // keywords and arrive as plain idents. Recording it here is what lets a
        // tool label the symbol afterwards — the alternative, re-deriving `actor`
        // from the "@actor\n" prefix the caller glues onto `docstring`, is exactly
        // the kind of side-table re-derivation BUGS #40 warns about. That prefix
        // still exists for codegen; nothing below reads it to answer this question.
        var introducer: String = "class"
        if (this.is_ident_named("interface")) { introducer = "interface" }
        if (this.is_ident_named("actor")) { introducer = "actor" }
        this.advance() // consume class/interface/actor
        var name_span: AST.Span = this.ident_span()
        var name: String = this.expect_ident()
        // Generic type parameters: class Foo<T> or interface Bar<K, V>.
        // These used to be consumed and discarded, which is why no method
        // returning `T` could be typed — `T` did not survive parsing, so
        // `Box<String>.getItem(): T` inferred as Any and warned "cannot infer
        // type". Collect the names at depth 1; anything nested (a constraint like
        // `T: Comparable<U>`) is still skipped, since only the parameter names
        // participate in substitution (BUGS #95).
        var type_params: List<String> = []
        if (this.match_kind_check("<")) {
            this.advance()
            var depth: Float = 1
            while (depth > 0 and !this.match_kind_check("eof")) {
                if (this.match_kind_check("<")) {
                    depth = depth + 1
                } else if (this.match_kind_check(">")) {
                    depth = depth - 1
                } else if (this.match_kind_check(">>")) {
                    depth = depth - 2
                } else if (depth == 1) {
                    var tp_name: String = match (this.current_kind()) {
                        TkIdent(n) => n
                        _ => ""
                    }
                    if (tp_name.length() > 0) { type_params.push(tp_name) }
                }
                this.advance()
            }
        }
        // Every name after `extends`, in source order. This used to keep only
        // the first and discard the rest, so `class Duck extends Flyable,
        // Swimmable, Walkable` parsed as `extends Flyable` — the other two
        // interfaces contributed no methods, no conformance and no `is` relation.
        var parents: List<String> = []
        if (this.is_ident_named("extends")) {
            this.advance() // consume extends
            parents.push(this.expect_ident())
            // Support multiple extends (interfaces): class Foo extends A, B, C
            while (this.match_kind(",")) {
                parents.push(this.expect_ident())
            }
        }
        this.consume("{")
        var fields: List<AST.Param> = []
        var methods: List<AST.Stmt> = []
        var field_defaults: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
            // Consume doc comments inside class body (attach to next member)
            var member_doc: String = this.collect_doc_comments()
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
            // A member's own visibility, read before the branches below for the
            // same reason as in parse_stmt: `private` is an identifier until the
            // lookahead says otherwise, and the branches below only test the
            // declaration keyword.
            var member_vis: String = "public"
            if (this.at_visibility_modifier()) {
                member_vis = this.take_visibility(true)
            }
            if (this.match_kind_check("var")) {
                // Field declaration: var name: Type  or  var name = default
                this.advance()
                var fname_span: AST.Span = this.ident_span()
                var fname: String = this.expect_ident()
                var ftype: String = "Any"
                if (this.match_kind(":")) {
                    ftype = this.parse_type()
                }
                if (this.match_kind("=")) {
                    var default_val: AST.Expr = this.parse_expr()
                    // Infer type from default if not annotated
                    if (ftype == "Any") {
                        var ek: String = match (default_val) {
                            StringLit(s) => "String"
                            IntLit(v) => "Int"
                            FloatLit(v) => "Float"
                            BoolLit(v) => "Bool"
                            NilLit => "Nil"
                            ListLit(e) => "List"
                            _ => "Any"
                        }
                        if (ek != "Any") { ftype = ek }
                    }
                    // Generate: this.fname = default_val (to prepend to init)
                    field_defaults.push(AST.Stmt.ExprStmt(
                        AST.Expr.SetField(AST.Expr.This, fname, default_val, AST.span_none())))
                }
                fields.push(AST.Param.Param(fname, this.parse_type_ast(ftype), AST.Expr.NilLit, member_vis, fname_span))
            } else if (this.is_ident_named("@")) {
                // Decorator on method: @inline, @intrinsic, etc.
                this.advance()
                var method_decorator: String = this.expect_ident()
                var method_annotation: String = "@" + method_decorator
                if (this.match_kind_check("(")) {
                    this.advance()
                    if (this.match_kind_check("string")) {
                        var mdarg_kind: Lexer.TokenKind = this.current_kind()
                        var mdarg: String = match (mdarg_kind) { TkString(s) => s    _ => "" }
                        this.advance()
                        method_annotation = method_annotation + ":" + mdarg
                    }
                    this.consume(")")
                }
                if (this.match_kind_check("fun")) {
                    methods.push(this.parse_fun_decl_vis(method_annotation, member_vis))
                }
            } else if (this.match_kind_check("fun")) {
                // Method declaration (doc comment passed via parse_fun_decl_vis)
                methods.push(this.parse_fun_decl_vis(member_doc, member_vis))
            } else {
                // An unrecognised member token. This arm is not optional
                // bookkeeping — without it the loop HANGS. The condition above
                // tests only `}` and `eof`, and all three branches above advance
                // only when they match, so a token matching none of them left
                // this.pos where it was and the loop spun forever. `class C {
                // private var x: Int }` reproduced it exactly: rc=124 under
                // timeout, with no output at all.
                //
                // A hang is the worst failure mode available here, because there
                // is no error string to grep for and nothing to point a user at.
                // Any future member syntax hits this same arm, so the fix is an
                // unconditional advance plus a diagnostic rather than one more
                // specific test.
                this.parse_error("unexpected '" + this.current_member_desc()
                    + "' in the body of class '" + name + "'; expected 'var', 'fun' or '}'")
                // Advance unconditionally FIRST — that single step is what makes
                // progress guaranteed regardless of what the resync loop below
                // decides — then skip ahead to the next plausible member start so
                // one malformed member produces one diagnostic instead of one per
                // token. `let x: Int = 1` otherwise reported six.
                this.advance()
                while (!this.match_kind_check("var") and !this.match_kind_check("fun")
                    and !this.match_kind_check("}") and !this.match_kind_check("eof")) {
                    this.advance()
                }
            }
        }
        this.consume("}")
        // Inject field defaults into init() method
        if (field_defaults.length() > 0) {
            this.inject_field_defaults(methods, field_defaults)
        }
        return AST.Stmt.ClassDecl(name, type_params, parents, fields, methods, docstring, visibility,
            name_span, this.span_from(decl_start), introducer)
    }

    fun inject_field_defaults(methods: List<AST.Stmt>, defaults: List<AST.Stmt>) {
        // Find existing init method and prepend defaults to its body
        var i: Int = 0
        while (i < methods.length()) {
            var mname: String = match (methods[i]) { FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => n    _ => "" }
            if (mname == "init") {
                var mbody: List<AST.Stmt> = match (methods[i]) { FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => b    _ => [] }
                var mparams: List<AST.Param> = match (methods[i]) { FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => p    _ => [] }
                var mret: AST.Type = match (methods[i]) { FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => r    _ => AST.Type.UnknownType }
                // Rebuilding an *existing* init: carry its own visibility across
                // rather than resetting it to "public". Today the parser only ever
                // produces "public", so this is behaviour-identical -- but once
                // Phase 4 adds the syntax, a hardcoded "public" here would silently
                // strip `private init`, which is the one declaration §6a of
                // access-modifiers.md most wants to honour.
                var mvis: String = match (methods[i]) { FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => f_vis    _ => "public" }
                // Build new body: defaults + original body
                var new_body: List<AST.Stmt> = []
                var di: Int = 0
                while (di < defaults.length()) {
                    new_body.push(defaults[di])
                    di = di + 1
                }
                var bi: Int = 0
                while (bi < mbody.length()) {
                    new_body.push(mbody[bi])
                    bi = bi + 1
                }
                methods[i] = AST.Stmt.FunDecl("init", mparams, mret, new_body, "", mvis, AST.span_none(), AST.span_none())
                return nil
            }
            i = i + 1
        }
        // No init found — create one with just the defaults
        methods.push(AST.Stmt.FunDecl("init", [], AST.Type.NilType, defaults, "", "public", AST.span_none(), AST.span_none()))
    }

    fun parse_import(): AST.Stmt {
        this.advance()
        if (this.match_kind_check("{")) {
            this.advance()
            var names: List<String> = []
            names.push(this.expect_ident())
            while (this.match_kind(",")) {
                if (this.match_kind_check("}")) { break }
                names.push(this.expect_ident())
            }
            this.consume("}")
            this.advance()
            var kind: Lexer.TokenKind = this.current_kind()
            var path: String = match (kind) { TkString(s) => s    _ => "" }
            this.advance()
            // Return NilLit ExprStmt — treated as declaration by is_decl, invisible to codegen
            return AST.Stmt.ExprStmt(AST.Expr.NilLit)
        }
        var kind: Lexer.TokenKind = this.current_kind()
        var path: String = match (kind) { TkString(s) => s    _ => "" }
        this.advance()
        if (this.match_kind_check("as") or this.is_ident_named("as")) {
            this.advance()
            var alias: String = this.expect_ident()
            // Return NilLit ExprStmt — treated as declaration by is_decl, invisible to codegen
            return AST.Stmt.ExprStmt(AST.Expr.NilLit)
        }
        // Return NilLit ExprStmt — treated as declaration by is_decl, invisible to codegen
        return AST.Stmt.ExprStmt(AST.Expr.NilLit)
    }

    fun parse_return(): AST.Stmt {
        this.advance() // consume return
        // Bare return (no value) → return nil.
        //
        // `;` counts as a terminator here. Statements do not consume their own
        // trailing `;` — the enclosing body skips them afterwards with
        // `while (this.match_kind(";"))` — so `return;` reaches this point with
        // the `;` still current. Without it in this check, `return;` fell
        // through to parse_expr, which reported "expected a literal, name or
        // '(' here" against whatever followed. `return` and `return 1;` both
        // parsed, so the gap looked like anything but a missing terminator.
        if (this.match_kind_check("}") or this.match_kind_check("eof")
                or this.match_kind_check(";")) {
            return AST.Stmt.Return(AST.Expr.NilLit)
        }
        // A `return` is also bare when the next token is on a later line. There
        // are no statement terminators, so `if (c) return` followed by the next
        // statement used to parse that statement as the return *value*: the
        // statement vanished from the enclosing body and everything it declared
        // became undefined. `if (a) return` above `var key = ...` gave
        // "undefined variable 'key'" pointing at the use, never the return
        // (BUGS #99).
        //
        // Same-line values still work — `return x`, and `return` alone before a
        // `}` — because both are checked before this point or sit on this line.
        if (this.current_line_num() > this.prev_line_num()) {
            return AST.Stmt.Return(AST.Expr.NilLit)
        }
        var value: AST.Expr = this.parse_expr()
        return AST.Stmt.Return(value)
    }

    fun parse_if(): AST.Stmt {
        this.advance() // consume if
        this.consume("(")
        var cond: AST.Expr = this.parse_expr()
        this.consume(")")
        var then_branch: List<AST.Stmt> = this.parse_body()
        var else_branch: List<AST.Stmt> = []
        if (this.match_kind("else")) {
            if (this.match_kind_check("if")) {
                // Flatten else-if: parse as nested If in else
                // But limit depth to prevent stack overflow in codegen
                else_branch = [this.parse_if()]
            } else {
                else_branch = this.parse_body()
            }
        }
        return AST.Stmt.If(cond, then_branch, else_branch)
    }

    fun parse_body(): List<AST.Stmt> {
        // Block with braces or single statement
        if (this.match_kind_check("{")) {
            return this.parse_block_stmts()
        }
        // Single statement body (no braces)
        return [this.parse_stmt()]
    }

    fun parse_while(): AST.Stmt {
        this.advance() // consume while
        this.consume("(")
        var cond: AST.Expr = this.parse_expr()
        this.consume(")")
        var body: List<AST.Stmt> = this.parse_block_stmts()
        return AST.Stmt.While(cond, body)
    }

    fun parse_for(): AST.Stmt {
        this.advance() // consume for
        this.consume("(")
        // C-style for with var keyword: for (var i: Float = 0; i < 10; i = i + 1)
        if (this.match_kind_check("var")) {
            this.advance() // consume var
            var name: String = this.expect_ident()
            // The annotation is optional: `for (var i = 0; ...)` infers from the
            // initializer, like every other binding form. "Any" is the inference
            // sentinel parse_var_decl_with_doc uses (parser.sf:1493) — the
            // checker's VarDecl arm reads it as "infer from the initializer".
            var vtype: String = "Any"
            if (this.match_kind(":")) {
                vtype = this.parse_type()
            }
            this.consume("=")
            var init_expr: AST.Expr = this.parse_expr()
            var init: AST.Stmt = AST.Stmt.VarDecl(name, vtype, init_expr, "", "public", AST.span_none(), AST.span_none())
            this.consume(";")
            var cond: AST.Expr = this.parse_expr()
            this.consume(";")
            // The update clause used to be hardcoded as `ident = expr`, which
            // made `for (var i = 0; i < 10; i++)` and `i += 1` parse errors —
            // the two spellings a C-style `for` is mostly written with. Routing
            // it through parse_expr_stmt accepts all three forms and keeps
            // `i = i + 1` working, since that is the shape parse_expr_stmt's
            // plain-`=` branch already builds.
            var update: AST.Stmt = this.parse_expr_stmt()
            this.consume(")")
            var body: List<AST.Stmt> = this.parse_block_stmts()
            body.push(update)
            var stmts: List<AST.Stmt> = []
            stmts.push(init)
            stmts.push(AST.Stmt.While(cond, body))
            return AST.Stmt.Block(stmts)
        }
        // Array pattern: for ([a, b] in list)
        if (this.match_kind_check("[")) {
            this.advance()
            var pat_names: List<String> = []
            if (!this.match_kind_check("]")) {
                pat_names.push(this.expect_ident())
                while (this.match_kind(",")) { pat_names.push(this.expect_ident()) }
            }
            this.consume("]")
            this.consume("in")
            var pat_iter: AST.Expr = this.parse_expr()
            this.consume(")")
            var pat_body: List<AST.Stmt> = this.parse_block_stmts()
            var desugar_body: List<AST.Stmt> = []
            var pdi: Float = 0
            while (pdi < pat_names.length()) {
                desugar_body.push(AST.Stmt.VarDecl(pat_names[pdi], "", AST.Expr.IndexGet(AST.Expr.Variable("__for_item", AST.span_none()), AST.Expr.IntLit(pdi)), "", "public", AST.span_none(), AST.span_none()))
                pdi = pdi + 1
            }
            pdi = 0
            while (pdi < pat_body.length()) { desugar_body.push(pat_body[pdi]); pdi = pdi + 1 }
            return this.desugar_for_in("__for_item", pat_iter, desugar_body)
        }
        // Check for for-in: for (name in expr) or for (Variant(x) in list)
        var name: String = this.expect_ident()
        if (this.match_kind_check("(")) {
            // Variant pattern: for (Some(x) in list)
            this.advance()
            var vp_bindings: List<String> = []
            if (!this.match_kind_check(")")) {
                vp_bindings.push(this.expect_ident())
                while (this.match_kind(",")) { vp_bindings.push(this.expect_ident()) }
            }
            this.consume(")")
            this.consume("in")
            var vp_iter: AST.Expr = this.parse_expr()
            this.consume(")")
            var vp_body: List<AST.Stmt> = this.parse_block_stmts()
            var vp_desugar: List<AST.Stmt> = []
            vp_desugar.push(AST.Stmt.LetPattern(AST.Pattern.VariantPattern(name, vp_bindings), AST.Expr.Variable("__for_item", AST.span_none())))
            var vpi: Float = 0
            while (vpi < vp_body.length()) { vp_desugar.push(vp_body[vpi]); vpi = vpi + 1 }
            return this.desugar_for_in("__for_item", vp_iter, vp_desugar)
        }
        if (this.match_kind("in")) {
            return this.parse_for_in(name)
        }
        // C-style for without var keyword: for (i: Float = 0; i < 10; i = i + 1)
        // The annotation is optional here too, so `for (i = 0; ...)` infers.
        var vtype: String = "Any"
        if (this.match_kind(":")) {
            vtype = this.parse_type()
        }
        this.consume("=")
        var init_expr: AST.Expr = this.parse_expr()
        var init: AST.Stmt = AST.Stmt.VarDecl(name, vtype, init_expr, "", "public", AST.span_none(), AST.span_none())
        this.consume(";")
        var cond: AST.Expr = this.parse_expr()
        this.consume(";")
        // Same widening as the `var`-keyword form above: the update clause is a
        // statement, so `i++` and `i += 1` work here too rather than only
        // `i = i + 1`.
        var update: AST.Stmt = this.parse_expr_stmt()
        this.consume(")")
        var body: List<AST.Stmt> = this.parse_block_stmts()
        body.push(update)
        var stmts: List<AST.Stmt> = []
        stmts.push(init)
        stmts.push(AST.Stmt.While(cond, body))
        return AST.Stmt.Block(stmts)
    }

    fun parse_for_in(item_name: String): AST.Stmt {
        var iter_expr: AST.Expr = this.parse_expr()
        this.consume(")")
        var body: List<AST.Stmt> = this.parse_block_stmts()
        return this.desugar_for_in(item_name, iter_expr, body)
    }

    /// Desugar `for (item in coll) { body }` into an index-driven while loop:
    ///
    ///   { var src = coll
    ///     var i = 0
    ///     while (i < src.length()) {
    ///         var item = src.__iter_get(i); i = i + 1; body } }
    ///
    /// The temporaries are gensym'd. They used to be the fixed names
    /// `__for_list` / `__for_i`, which meant an inner loop redeclared the outer
    /// loop's cursor in the same scope chain: the inner loop ran its course,
    /// left the shared `__for_i` past the end, and the outer `while` condition
    /// then failed immediately — so `for (a in xs) { for (b in ys) {...} }`
    /// silently visited only the first element of `xs`.
    ///
    /// The increment is emitted before the user body so `continue` cannot skip
    /// it and spin forever.
    fun desugar_for_in(item_name: String, iter_expr: AST.Expr, body: List<AST.Stmt>): AST.Stmt {
        var uid: String = this.next_for_uid()
        var list_var: String = "__for_src" + uid
        var idx_var: String = "__for_i" + uid
        var init_list: AST.Stmt = AST.Stmt.VarDecl(list_var, "", iter_expr, "", "public", AST.span_none(), AST.span_none())
        var init_idx: AST.Stmt = AST.Stmt.VarDecl(idx_var, "Int", AST.Expr.IntLit(0), "", "public", AST.span_none(), AST.span_none())
        var cond: AST.Expr = AST.Expr.Binary(AST.Expr.Variable(idx_var, AST.span_none()), "<", AST.Expr.MethodCall(AST.Expr.Variable(list_var, AST.span_none()), "length", [], AST.span_none()))
        // The element read is `__iter_get`, NOT an ordinary `src[i]` (BUGS #62).
        // For a List or String the two are the same thing, but for a Map `m[k]`
        // is a *key* lookup: the loop's integer cursor went to __map_get as a
        // key, which missed every time on a Map<String,_> (yielding nil) and
        // would have looked up the keys 0, 1, 2... on a Map<Int,_> rather than
        // walking the entries. "element at position i of an iteration" and
        // "value for key k" are different operations that only looked alike
        // because Lists happen to be indexable.
        //
        // Spelled as a MethodCall on a reserved name rather than a new AST.Expr
        // variant deliberately: a variant would need arms at ~30 match sites,
        // and a missing arm yields an indeterminate value rather than an error
        // (BUGS #76), so the variant is the riskier encoding of the same thing.
        var item_init: AST.Stmt = AST.Stmt.VarDecl(item_name, "", AST.Expr.MethodCall(AST.Expr.Variable(list_var, AST.span_none()), "__iter_get", [AST.Expr.Variable(idx_var, AST.span_none())], AST.span_none()), "", "public", AST.span_none(), AST.span_none())
        var increment: AST.Stmt = AST.Stmt.ExprStmt(AST.Expr.Assign(idx_var, AST.Expr.Binary(AST.Expr.Variable(idx_var, AST.span_none()), "+", AST.Expr.IntLit(1)), AST.span_none()))
        var while_body: List<AST.Stmt> = []
        while_body.push(item_init)
        while_body.push(increment)
        var bi: Float = 0
        while (bi < body.length()) { while_body.push(body[bi]); bi = bi + 1 }
        var stmts: List<AST.Stmt> = []
        stmts.push(init_list)
        stmts.push(init_idx)
        stmts.push(AST.Stmt.While(cond, while_body))
        return AST.Stmt.Block(stmts)
    }

    fun parse_try(): AST.Stmt {
        this.advance() // consume try
        var try_body: List<AST.Stmt> = this.parse_block_stmts()
        this.consume("catch")
        this.consume("(")
        var catch_name: String = this.expect_ident()
        this.consume(")")
        var catch_body: List<AST.Stmt> = this.parse_block_stmts()
        var finally_body: List<AST.Stmt> = []
        if (this.match_kind("finally")) {
            finally_body = this.parse_block_stmts()
        }
        return AST.Stmt.TryCatch(try_body, catch_name, catch_body, finally_body)
    }

    fun parse_throw(): AST.Stmt {
        this.advance() // consume throw
        var value: AST.Expr = this.parse_expr()
        return AST.Stmt.Throw(value)
    }

    fun parse_trailing_closure(): AST.Expr {
        this.consume("{")
        // Check for param list: ident => or ident, ident => ...
        if (this.match_kind_check("ident")) { if (this.peek_is("=>") or this.peek_is(",")) {
            return this.parse_trailing_closure_with_params() } }
        var body: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                this.consume("}")
                return AST.Expr.Lambda([], AST.Type.NilType, body)
            }
            // Bare string literals desugar to text(string)
            if (this.match_kind_check("string")) {
                var str_expr: AST.Expr = this.parse_expr()
                body.push(AST.Stmt.ExprStmt(AST.Expr.Call(AST.Expr.Variable("text", AST.span_none()), [str_expr], AST.span_none())))
            } else {
                body.push(this.parse_stmt())
            }
        }
        this.consume("}")
        return AST.Expr.Lambda([], AST.Type.NilType, body)
    }

    fun parse_trailing_closure_with_params(): AST.Expr {
        // Collect param names before the =>
        var param_names: List<String> = []
        param_names.push(this.expect_ident())
        while (this.match_kind(",")) {
            param_names.push(this.expect_ident())
        }
        this.consume("=>")
        // Parse body
        var body: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                break
            }
            body.push(this.parse_stmt())
        }
        this.consume("}")
        // Build the Lambda using the same pattern as parse_lambda
        return this.build_lambda(param_names, body)
    }

    fun build_lambda(names: List<String>, body: List<AST.Stmt>): AST.Expr {
        var params: List<AST.Param> = []
        var i: Float = 0
        while (i < names.length()) {
            params.push(AST.Param.Param(names[i], AST.Type.AnyType, AST.Expr.NilLit, "public", AST.span_none()))
            i = i + 1
        }
        return AST.Expr.Lambda(params, AST.Type.AnyType, body)
    }

    // =========================================================================
    // HTML Element Parsing — <tag attrs>children</tag> desugars to builder calls
    // =========================================================================

    fun peek_is_html_start(): Bool {
        // Current token is <. Check if NEXT token (pos+1) is an HTML element or component.
        if (this.pos + 1 >= this.tokens.length()) { return false }
        var next_tok: Lexer.Token = this.tokens[this.pos + 1]
        var next_kind: Lexer.TokenKind = match (next_tok) { Token(k, l, c, o, ln) => k }
        var kind_str: String = this.kind_name(next_kind)
        if (kind_str != "ident") { return false }
        var name: String = match (next_kind) { TkIdent(n) => n    _ => "" }
        if (name.length() == 0) { return false }
        // Uppercase = component
        var first: String = name.char_at(0)
        if (first >= "A" and first <= "Z") { return true }
        // Known HTML elements
        return this.is_html_tag(name)
    }

    fun is_html_tag(name: String): Bool {
        // Common HTML elements (covers 99% of usage)
        if (name == "div") { return true }
        if (name == "span") { return true }
        if (name == "p") { return true }
        if (name == "a") { return true }
        if (name == "h1" or name == "h2" or name == "h3" or name == "h4" or name == "h5" or name == "h6") { return true }
        if (name == "button") { return true }
        if (name == "input") { return true }
        if (name == "form") { return true }
        if (name == "label") { return true }
        if (name == "img") { return true }
        if (name == "ul" or name == "ol" or name == "li") { return true }
        if (name == "table" or name == "tr" or name == "td" or name == "th" or name == "thead" or name == "tbody") { return true }
        if (name == "nav" or name == "header" or name == "footer" or name == "main" or name == "section" or name == "article" or name == "aside") { return true }
        if (name == "br" or name == "hr") { return true }
        if (name == "select" or name == "option" or name == "textarea") { return true }
        if (name == "pre" or name == "code" or name == "blockquote") { return true }
        if (name == "em" or name == "strong" or name == "small" or name == "mark" or name == "del" or name == "ins") { return true }
        if (name == "video" or name == "audio" or name == "canvas" or name == "source") { return true }
        if (name == "details" or name == "summary" or name == "dialog") { return true }
        if (name == "fieldset" or name == "legend" or name == "optgroup") { return true }
        if (name == "iframe" or name == "embed" or name == "object") { return true }
        if (name == "link" or name == "meta" or name == "style" or name == "script") { return true }
        if (name == "head" or name == "body" or name == "html" or name == "title") { return true }
        if (name == "dl" or name == "dt" or name == "dd") { return true }
        if (name == "figure" or name == "figcaption" or name == "picture") { return true }
        if (name == "area" or name == "base" or name == "col" or name == "colgroup" or name == "caption") { return true }
        if (name == "track" or name == "wbr" or name == "slot" or name == "template") { return true }
        return false
    }

    fun is_void_tag(name: String): Bool {
        if (name == "br" or name == "hr" or name == "img" or name == "input") { return true }
        if (name == "area" or name == "base" or name == "col" or name == "embed") { return true }
        if (name == "link" or name == "meta" or name == "source" or name == "track" or name == "wbr") { return true }
        return false
    }

    fun parse_html_fragment(): AST.Expr {
        // <> already checked but not consumed. Consume < and >
        this.advance()
        this.advance()
        var children: List<AST.Stmt> = this.parse_html_children("")
        return AST.Expr.BlockExpr(children, AST.Expr.NilLit)
    }

    fun parse_html_element(): AST.Expr {
        // < already checked but not consumed. Consume it.
        var elem_start: AST.Span = this.current_span()
        this.advance()
        // Read tag name. A tag is not decoration: `<div>` lowers to a call of a
        // real function named `div`, so the tag identifier is a genuine reference
        // and go-to-definition on it must land on that function.
        var tag_span: AST.Span = this.ident_span()
        var tag: String = this.expect_ident()

        // Parse attributes
        var args: List<AST.Expr> = this.parse_html_attrs()

        // Check for self-closing /> or >
        if (this.match_kind_check("/")) {
            this.advance()
            this.consume(">")
            // Self-closing: tag(attrs...)
            return AST.Expr.Call(AST.Expr.Variable(tag, tag_span), args, this.span_from(elem_start))
        }

        this.consume(">")

        if (this.is_void_tag(tag)) {
            // Void element: tag(attrs...)
            return AST.Expr.Call(AST.Expr.Variable(tag, tag_span), args, this.span_from(elem_start))
        }

        // Parse children until </tag>
        var children: List<AST.Stmt> = this.parse_html_children(tag)

        // Emit: tag(attrs...) { children }
        // Add trailing closure (Lambda with children as body)
        args.push(AST.Expr.Lambda([], AST.Type.NilType, children))
        return AST.Expr.Call(AST.Expr.Variable(tag, tag_span), args, this.span_from(elem_start))
    }

    fun parse_html_attrs(): List<AST.Expr> {
        var args: List<AST.Expr> = []
        // Parse name=value pairs until > or />
        // Accept identifiers and keywords that are valid HTML attribute names (class, for, etc.)
        while (this.match_kind_check("ident") or this.match_kind_check("class") or this.match_kind_check("for") or this.match_kind_check("in") or this.match_kind_check("is")) {
            var attr_name: String = ""
            if (this.match_kind_check("class")) {
                attr_name = "cls"
                this.advance()
            } else if (this.match_kind_check("for")) {
                attr_name = "html_for"
                this.advance()
            } else if (this.match_kind_check("in")) {
                attr_name = "in"
                this.advance()
            } else if (this.match_kind_check("is")) {
                attr_name = "is"
                this.advance()
            } else {
                attr_name = this.expect_ident()
            }
            // `prev_span` and not `ident_span`: every branch above has already
            // consumed the attribute-name token by this point.
            var attr_span: AST.Span = this.prev_span()

            if (this.match_kind("=")) {
                // name=value
                var attr_val: AST.Expr = this.parse_html_attr_value()
                args.push(AST.Expr.Assign(attr_name, attr_val, attr_span))
            } else {
                // Boolean attribute: name (no value) → name=true
                args.push(AST.Expr.Assign(attr_name, AST.Expr.BoolLit(true), attr_span))
            }
        }
        return args
    }

    fun parse_html_attr_value(): AST.Expr {
        // "string" → StringLit (common case, fast path)
        if (this.match_kind_check("string")) {
            var kind: Lexer.TokenKind = this.current_kind()
            this.advance()
            return match (kind) {
                TkString(s) => AST.Expr.StringLit(s)
                _ => AST.Expr.NilLit
            }
        }
        // {expr} — brace-delimited expression value (map literals, lambdas, etc.)
        // Consume the { ourselves, parse a full expression, then consume }.
        // This is safe because the } delimiter prevents parse_expr from consuming
        // HTML structural tokens (>, <, /) as binary operators.
        // We handle { here rather than letting parse_primary's block-expression path
        // handle it, because that path calls parse_stmt() which can misparse
        // anonymous lambdas (fun () => ...) as declarations.
        if (this.match_kind_check("{")) {
            this.advance()
            var saved_depth: Float = this.html_depth
            this.html_depth = 0
            // Check for empty map: {}
            if (this.match_kind_check("}")) {
                this.advance()
                this.html_depth = saved_depth
                return AST.Expr.MapLit
            }
            // Check for Kotlin-style lambda: {x => body} or {x, y => body}
            var is_kotlin_lambda: Bool = false
            if (this.match_kind_check("ident")) {
                if (this.peek_is("=>") or this.peek_is(",")) {
                    is_kotlin_lambda = true
                }
            }
            if (is_kotlin_lambda) {
                var kl_before: Float = this.pos
                var kl_name: String = this.expect_ident()
                if (this.match_kind("=>")) {
                    // Single-param Kotlin lambda: {x => body}
                    var lparams: List<AST.Param> = []
                    lparams.push(AST.Param.Param(kl_name, AST.Type.AnyType, AST.Expr.NilLit, "public", AST.span_none()))
                    var lbody: List<AST.Stmt> = []
                    while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                        while (this.match_kind(";")) {}
                        if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
                        lbody.push(this.parse_stmt())
                    }
                    this.consume("}")
                    if (lbody.length() > 0) {
                        var klast: AST.Stmt = lbody[lbody.length() - 1]
                        var kis_expr: Bool = match (klast) { ExprStmt(e) => true   _ => false }
                        if (kis_expr) {
                            var kexpr: AST.Expr = match (klast) { ExprStmt(e) => e    _ => AST.Expr.NilLit }
                            lbody[lbody.length() - 1] = AST.Stmt.Return(kexpr)
                        }
                    }
                    this.html_depth = saved_depth
                    return AST.Expr.Lambda(lparams, AST.Type.AnyType, lbody)
                } else if (this.match_kind(",")) {
                    // Multi-param Kotlin lambda: {x, y => body}
                    var lparams: List<AST.Param> = []
                    lparams.push(AST.Param.Param(kl_name, AST.Type.AnyType, AST.Expr.NilLit, "public", AST.span_none()))
                    var lpname: String = this.expect_ident()
                    lparams.push(AST.Param.Param(lpname, AST.Type.AnyType, AST.Expr.NilLit, "public", AST.span_none()))
                    while (this.match_kind(",")) {
                        lpname = this.expect_ident()
                        lparams.push(AST.Param.Param(lpname, AST.Type.AnyType, AST.Expr.NilLit, "public", AST.span_none()))
                    }
                    this.consume("=>")
                    var lbody: List<AST.Stmt> = []
                    while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                        while (this.match_kind(";")) {}
                        if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
                        lbody.push(this.parse_stmt())
                    }
                    this.consume("}")
                    if (lbody.length() > 0) {
                        var klast: AST.Stmt = lbody[lbody.length() - 1]
                        var kis_expr: Bool = match (klast) { ExprStmt(e) => true   _ => false }
                        if (kis_expr) {
                            var kexpr: AST.Expr = match (klast) { ExprStmt(e) => e    _ => AST.Expr.NilLit }
                            lbody[lbody.length() - 1] = AST.Stmt.Return(kexpr)
                        }
                    }
                    this.html_depth = saved_depth
                    return AST.Expr.Lambda(lparams, AST.Type.AnyType, lbody)
                } else {
                    // Not a Kotlin lambda — restore position
                    this.pos = kl_before
                }
            }
            // Check for map literal: {"key": val, ...} or {ident: val, ...}
            if (this.is_map_key_start() and this.peek_is(":")) {
                // Unique temporary — see the note at the other desugaring site
                // (BUGS #41). Bind before the recursive parse_expr calls below.
                var mvar: String = "__map" + this.next_map_uid()
                var map_stmts: List<AST.Stmt> = []
                map_stmts.push(AST.Stmt.VarDecl(mvar, "Map", AST.Expr.MapLit, "", "public", AST.span_none(), AST.span_none()))
                // First entry
                var key: AST.Expr = this.parse_map_key()
                this.consume(":")
                var value: AST.Expr = this.parse_expr()
                map_stmts.push(AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.Variable(mvar, AST.span_none()), "set", [key, value], AST.span_none())))
                while (this.match_kind(",")) {
                    if (this.match_kind_check("}")) { break }
                    var k: AST.Expr = this.parse_map_key()
                    this.consume(":")
                    var v: AST.Expr = this.parse_expr()
                    map_stmts.push(AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.Variable(mvar, AST.span_none()), "set", [k, v], AST.span_none())))
                }
                this.consume("}")
                this.html_depth = saved_depth
                return AST.Expr.BlockExpr(map_stmts, AST.Expr.Variable(mvar, AST.span_none()))
            }
            // General expression (lambda, arithmetic, etc.)
            var expr: AST.Expr = this.parse_expr()
            this.consume("}")
            this.html_depth = saved_depth
            return expr
        }
        // Bare value (identifier, number, etc.) — use parse_call to avoid
        // consuming HTML structural tokens (>, <, /) as binary operators.
        return this.parse_call()
    }

    fun parse_html_children(parent_tag: String): List<AST.Stmt> {
        var stmts: List<AST.Stmt> = []
        this.html_depth = this.html_depth + 1

        while (!this.match_kind_check("eof")) {
            // Check for closing tag: </tag> or fragment close </>
            if (this.match_kind_check("<") and this.peek_is("/")) {
                this.advance()
                this.advance()
                if (!this.match_kind_check(">")) {
                    this.expect_ident()
                }
                this.consume(">")
                this.html_depth = this.html_depth - 1
                return stmts
            }

            // Nested fragment: <>...</>
            if (this.match_kind_check("<") and this.peek_is(">")) {
                var child: AST.Expr = this.parse_html_fragment()
                stmts.push(AST.Stmt.ExprStmt(child))
            }
            // Nested HTML element: <ident ...> (any identifier — no tag list needed at depth>0)
            else if (this.match_kind_check("<") and this.peek_is("ident")) {
                var child: AST.Expr = this.parse_html_element()
                stmts.push(AST.Stmt.ExprStmt(child))
            }
            // Code block: {stmts...}
            // If the block contains a single expression that is not a top-level
            // function Call (e.g. {name}, {count.get()}, {"hi " + x}), auto-wrap
            // it in text() so string expressions render as text nodes.
            // Top-level Calls are excluded because they are typically element builders
            // (div(), SomeComponent()) or helpers (for_each(), text()) that manage
            // their own DOM output.
            else if (this.match_kind_check("{")) {
                this.advance()
                var saved_depth: Float = this.html_depth
                this.html_depth = 0
                var interp_stmts: List<AST.Stmt> = []
                while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                    while (this.match_kind(";")) {}
                    if (this.match_kind_check("}") or this.match_kind_check("eof")) { break }
                    interp_stmts.push(this.parse_stmt())
                }
                this.consume("}")
                this.html_depth = saved_depth
                // Auto-wrap: single ExprStmt whose expr is NOT a Call/Assign → text(expr)
                if (interp_stmts.length() == 1) {
                    var interp_is_expr: Bool = match (interp_stmts[0]) { ExprStmt(e) => true   _ => false }
                    if (interp_is_expr) {
                        var interp_expr: AST.Expr = match (interp_stmts[0]) { ExprStmt(e) => e    _ => AST.Expr.NilLit }
                        var interp_skip: Bool = match (interp_expr) { Call(c, a, __cs) => true   MethodCall(o, m, a, __ks) => true   Assign(n, v, __as) => true   _ => false }
                        if (!interp_skip) {
                            stmts.push(AST.Stmt.ExprStmt(AST.Expr.Call(AST.Expr.Variable("text", AST.span_none()), [interp_expr], AST.span_none())))
                        } else {
                            stmts.push(interp_stmts[0])
                        }
                    } else {
                        stmts.push(interp_stmts[0])
                    }
                } else {
                    var interp_i: Float = 0
                    while (interp_i < interp_stmts.length()) {
                        stmts.push(interp_stmts[interp_i])
                        interp_i = interp_i + 1
                    }
                }
            }
            // Text content — accumulate until < or { or EOF
            else if (this.match_kind_check("string")) {
                var kind: Lexer.TokenKind = this.current_kind()
                this.advance()
                var text: String = match (kind) { TkString(s) => s    _ => "" }
                stmts.push(AST.Stmt.ExprStmt(AST.Expr.Call(AST.Expr.Variable("text", AST.span_none()), [AST.Expr.StringLit(text)], AST.span_none())))
            }
            else {
                // Text tokens (identifiers, numbers, symbols) until < or { or EOF
                var full_text: String = ""
                var prev_part: String = ""
                while (!this.match_kind_check("<") and !this.match_kind_check("{") and !this.match_kind_check("eof")) {
                    var kind: Lexer.TokenKind = this.current_kind()
                    var text_part: String = match (kind) {
                        TkIdent(s) => s
                        TkInt(v) => v.to_string()
                        _ => this.kind_name(kind)
                    }
                    if (full_text.length() == 0) {
                        full_text = text_part
                    } else if (text_part == "." or text_part == "," or text_part == "!" or text_part == "?" or text_part == ":" or text_part == ";") {
                        full_text = full_text + text_part
                    } else if (prev_part == "-" or text_part == "-") {
                        // Hyphenated words: no space around -
                        full_text = full_text + text_part
                    } else {
                        full_text = full_text + " " + text_part
                    }
                    prev_part = text_part
                    this.advance()
                }
                if (full_text.length() > 0) {
                    stmts.push(AST.Stmt.ExprStmt(AST.Expr.Call(AST.Expr.Variable("text", AST.span_none()), [AST.Expr.StringLit(full_text)], AST.span_none())))
                } else {
                    this.advance()
                }
            }
        }

        return stmts
    }

    fun parse_block(): AST.Stmt {
        return AST.Stmt.Block(this.parse_block_stmts())
    }

    fun parse_block_stmts(): List<AST.Stmt> {
        this.consume("{")
        var stmts: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                this.consume("}")
                return stmts
            }
            stmts.push(this.parse_stmt())
        }
        this.consume("}")
        return stmts
    }

    fun stmt_to_expr(stmt: AST.Stmt): AST.Expr {
        // If it's an ExprStmt, extract the expression as the block value
        // If it's an If with else, convert to IfExpr so the value propagates
        // Otherwise return NilLit
        var kind: String = match (stmt) {
            ExprStmt(e) => "expr"
            VarDecl(n, t, i, d, v_vis, __ns, __fs) => "other"
            FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => "other"
            EnumDecl(n, v, d, e_vis, __ns, __fs) => "other"
            ClassDecl(n, tp, ps, f, m, d, c_vis, __ns, __fs, __intro) => "other"
            Return(v) => "other"
            If(c, t, e) => "if"
            While(c, b) => "other"
            Block(s) => "other"
            Break => "other"
            Continue => "other"
            TryCatch(t, n, c, f) => "other"
            Throw(v) => "other"
            LetPattern(p, v) => "other"
            TypeAlias(ta_n, ta_t, ta_vis) => "other"
        }
        if (kind == "expr") {
            return match (stmt) { ExprStmt(e) => e   _ => AST.Expr.NilLit }
        }
        if (kind == "if") {
            return this.if_stmt_to_expr(stmt)
        }
        return AST.Expr.NilLit
    }

    fun if_stmt_to_expr(stmt: AST.Stmt): AST.Expr {
        var cond: AST.Expr = match (stmt) { If(c, t, e) => c    _ => AST.Expr.NilLit }
        var then_branch: List<AST.Stmt> = match (stmt) { If(c, t, e) => t    _ => [] }
        var else_branch: List<AST.Stmt> = match (stmt) { If(c, t, e) => e    _ => [] }
        // Only convert if there is an else branch (otherwise not value-producing)
        if (else_branch.length() == 0) {
            return AST.Expr.NilLit
        }
        // Extract then value: last ExprStmt or If becomes value
        var then_val: AST.Expr = AST.Expr.NilLit
        if (then_branch.length() > 0) {
            var then_last: AST.Stmt = then_branch[then_branch.length() - 1]
            var then_extractable: Bool = this.is_value_stmt(then_last)
            if (then_extractable) {
                then_val = this.stmt_to_expr(then_last)
                then_branch.pop()
            }
        }
        // Extract else value: last ExprStmt or If becomes value
        var else_val: AST.Expr = AST.Expr.NilLit
        if (else_branch.length() > 0) {
            var else_last: AST.Stmt = else_branch[else_branch.length() - 1]
            var else_extractable: Bool = this.is_value_stmt(else_last)
            if (else_extractable) {
                else_val = this.stmt_to_expr(else_last)
                else_branch.pop()
            }
        }
        return AST.Expr.IfExpr(cond, then_branch, then_val, else_branch, else_val)
    }

    fun is_value_stmt(stmt: AST.Stmt): Bool {
        var kind: String = match (stmt) {
            ExprStmt(e) => "expr"
            If(c, t, e) => "if"
            _ => "other"
        }
        if (kind == "expr") { return true }
        if (kind == "if") {
            // Only if it has an else branch
            var else_br: List<AST.Stmt> = match (stmt) { If(c, t, e) => e    _ => [] }
            return else_br.length() > 0
        }
        return false
    }
}



var _had_error: Bool = false

fun parse(tokens: List<Lexer.Token>): List<AST.Stmt> {
    var p: Parser = Parser(tokens)
    var result: List<AST.Stmt> = p.parse_program()
    _had_error = p.had_error
    return result
}

fun parse_with_source(tokens: List<Lexer.Token>, source: String): List<AST.Stmt> {
    var p: Parser = Parser(tokens)
    p.source = source
    var result: List<AST.Stmt> = p.parse_program()
    _had_error = p.had_error
    return result
}

fun had_error(): Bool {
    return _had_error
}
