// Recursive descent parser for Saffron-mini

import "./ast.sf" as AST
import "./lexer.sf" as Lexer

class Parser {
    var tokens: List<Lexer.Token>
    var pos: Float

    fun init(tokens: List<Lexer.Token>) {
        this.tokens = tokens
        this.pos = 0
    }

    fun current(): Lexer.Token {
        return this.tokens[this.pos]
    }

    fun current_kind(): Lexer.TokenKind {
        var tok = this.current()
        return match (tok) { Token(kind, line, col) => kind }
    }

    fun advance(): Lexer.Token {
        var tok = this.current()
        this.pos = this.pos + 1
        return tok
    }

    fun expect_ident(): String {
        var kind = this.current_kind()
        this.advance()
        return match (kind) {
            TkIdent(name) => name
        }
    }

    fun peek_ident(): String {
        if (!this.match_kind_check("ident")) return ""
        var kind = this.current_kind()
        return match (kind) {
            TkIdent(name) => name
        }
    }

    fun match_kind(expected: String): Bool {
        if (this.match_kind_check(expected)) {
            this.advance()
            return true
        }
        return false
    }

    fun current_line(): String {
        var tok = this.current()
        var line = match (tok) { Token(kind, line, col) => line }
        return line.floor().to_string()
    }

    fun parse_error(message: String) {
        IO.println("[line " + this.current_line() + "] Parse error: " + message)
    }

    fun consume(expected: String) {
        if (!this.match_kind(expected)) {
            this.parse_error("expected " + expected)
        }
    }

    // --- Type annotations ---

    fun parse_type(): String {
        var name = this.expect_ident()
        // Handle dotted types: Lexer.TokenKind, AST.Stmt, etc.
        while (this.match_kind(".")) {
            var part = this.expect_ident()
            name = name + "." + part
        }
        // Capture first generic arg for type tracking (List<String> → List<String>)
        if (this.match_kind_check("<")) {
            this.advance() // consume <
            // Peek at first type arg before skipping generic contents
            var first_arg = this.peek_ident()
            var depth = 1
            while (depth > 0 and !this.match_kind_check("eof")) {
                if (this.match_kind_check("<")) {
                    depth = depth + 1
                } else if (this.match_kind_check(">")) {
                    depth = depth - 1
                } else if (this.match_kind_check(">>")) {
                    depth = depth - 2
                }
                this.advance()
            }
            if (first_arg.length() > 0) {
                name = name + "<" + first_arg + ">"
            }
        }
        return name
    }

    // --- Expressions (Pratt parser) ---

    fun parse_expr(): AST.Expr {
        return this.parse_or()
    }

    fun parse_or(): AST.Expr {
        var left = this.parse_and()
        while (this.match_kind_check("or")) {
            this.advance()
            var right = this.parse_and()
            left = AST.Expr.Logical(left, "or", right)
        }
        return left
    }

    fun parse_and(): AST.Expr {
        var left = this.parse_equality()
        while (this.match_kind_check("and")) {
            this.advance()
            var right = this.parse_equality()
            left = AST.Expr.Logical(left, "and", right)
        }
        return left
    }

    fun parse_equality(): AST.Expr {
        var left = this.parse_comparison()
        while (this.is_equality_op()) {
            var op = this.get_op_string()
            this.advance()
            var right = this.parse_comparison()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_comparison(): AST.Expr {
        var left = this.parse_bitwise_or()
        while (this.is_comparison_op()) {
            var op = this.get_op_string()
            this.advance()
            var right = this.parse_bitwise_or()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_bitwise_or(): AST.Expr {
        var left = this.parse_bitwise_xor()
        while (this.match_kind_check("|")) {
            this.advance()
            var right = this.parse_bitwise_xor()
            left = AST.Expr.Binary(left, "|", right)
        }
        return left
    }

    fun parse_bitwise_xor(): AST.Expr {
        var left = this.parse_bitwise_and()
        while (this.match_kind_check("^")) {
            this.advance()
            var right = this.parse_bitwise_and()
            left = AST.Expr.Binary(left, "^", right)
        }
        return left
    }

    fun parse_bitwise_and(): AST.Expr {
        var left = this.parse_shift()
        while (this.match_kind_check("&")) {
            this.advance()
            var right = this.parse_shift()
            left = AST.Expr.Binary(left, "&", right)
        }
        return left
    }

    fun parse_shift(): AST.Expr {
        var left = this.parse_term()
        while (this.is_shift_op()) {
            var op = this.get_op_string()
            this.advance()
            var right = this.parse_term()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_term(): AST.Expr {
        var left = this.parse_factor()
        while (this.is_term_op()) {
            var op = this.get_op_string()
            this.advance()
            var right = this.parse_factor()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_factor(): AST.Expr {
        var left = this.parse_unary()
        while (this.is_factor_op()) {
            var op = this.get_op_string()
            this.advance()
            var right = this.parse_unary()
            left = AST.Expr.Binary(left, op, right)
        }
        return left
    }

    fun parse_unary(): AST.Expr {
        if (this.match_kind_check("-")) {
            this.advance()
            var right = this.parse_unary()
            return AST.Expr.Unary("-", right)
        }
        if (this.match_kind_check("!")) {
            this.advance()
            var right = this.parse_unary()
            return AST.Expr.Unary("!", right)
        }
        if (this.match_kind_check("~")) {
            this.advance()
            var right = this.parse_unary()
            return AST.Expr.Unary("~", right)
        }
        return this.parse_call()
    }

    fun parse_call(): AST.Expr {
        var expr = this.parse_primary()

        while (true) {
            if (this.match_kind_check(".")) {
                this.advance()
                var field = this.expect_ident()
                if (this.match_kind_check("(")) {
                    // Method call: obj.method(args)
                    this.advance()
                    var args: List<AST.Expr> = []
                    if (!this.match_kind_check(")")) {
                        args.push(this.parse_expr())
                        while (this.match_kind(",")) {
                            args.push(this.parse_expr())
                        }
                        this.consume(")")
                    } else {
                        this.advance()
                    }
                    expr = AST.Expr.MethodCall(expr, field, args)
                } else {
                    expr = AST.Expr.MemberAccess(expr, field)
                }
            } else if (this.match_kind_check("[")) {
                // Index access: obj[expr]
                this.advance()
                var idx = this.parse_expr()
                this.consume("]")
                expr = AST.Expr.IndexGet(expr, idx)
            } else if (this.match_kind_check("(")) {
                this.advance()
                var args: List<AST.Expr> = []
                if (!this.match_kind_check(")")) {
                    args.push(this.parse_expr())
                    while (this.match_kind(",")) {
                        args.push(this.parse_expr())
                    }
                    this.consume(")")
                } else {
                    this.advance()
                }
                expr = AST.Expr.Call(expr, args)
            } else {
                break
            }
        }

        return expr
    }

    fun parse_primary(): AST.Expr {
        if (this.match_kind_check("match")) {
            return this.parse_match_expr()
        }
        if (this.match_kind_check("fun")) {
            return this.parse_lambda()
        }
        if (this.match_kind_check("this")) {
            this.advance()
            return AST.Expr.This
        }
        if (this.match_kind_check("[")) {
            return this.parse_list_lit()
        }
        if (this.match_kind_check("{")) {
            this.advance()
            if (this.match_kind_check("}")) {
                // Empty map literal: {}
                this.advance()
                return AST.Expr.MapLit
            }
            // Block expression: { stmts...; expr }
            var block_stmts: List<AST.Stmt> = []
            while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
                block_stmts.push(this.parse_stmt())
            }
            this.consume("}")
            // The last statement becomes the value expression if it's an ExprStmt
            if (block_stmts.length() > 0) {
                var last = block_stmts[block_stmts.length() - 1]
                var last_kind = this.stmt_to_expr(last)
                var is_expr_stmt = match (last) {
                    ExprStmt(e) => true
                    VarDecl(n, t, i, d) => false
                    FunDecl(n, p, r, b, d) => false
                    EnumDecl(n, v, d) => false
                    ClassDecl(n, f, m, d) => false
                    Return(v) => false
                    If(c, t, e) => false
                    While(c, b) => false
                    Block(s) => false
                    Break => false
                    Continue => false
                }
                if (is_expr_stmt) {
                    block_stmts.pop()
                    return AST.Expr.BlockExpr(block_stmts, last_kind)
                }
                return AST.Expr.BlockExpr(block_stmts, AST.Expr.NilLit)
            }
            return AST.Expr.BlockExpr([], AST.Expr.NilLit)
        }

        var kind = this.current_kind()
        this.advance()

        return match (kind) {
            TkInt(v) => AST.Expr.IntLit(v)
            TkFloat(v) => AST.Expr.FloatLit(v)
            TkTrue => AST.Expr.BoolLit(true)
            TkFalse => AST.Expr.BoolLit(false)
            TkNil => AST.Expr.NilLit
            TkString(s) => AST.Expr.StringLit(s)
            TkIdent(name) => AST.Expr.Variable(name)
            TkLParen => {
                var expr = this.parse_expr()
                this.consume(")")
                expr
            }
        }
    }

    fun parse_list_lit(): AST.Expr {
        this.advance() // consume [
        var elements: List<AST.Expr> = []
        if (!this.match_kind_check("]")) {
            elements.push(this.parse_expr())
            while (this.match_kind(",")) {
                elements.push(this.parse_expr())
            }
        }
        this.consume("]")
        return AST.Expr.ListLit(elements)
    }

    fun parse_match_expr(): AST.Expr {
        this.advance() // consume match
        this.consume("(")
        var subject = this.parse_expr()
        this.consume(")")
        this.consume("{")
        var arms: List<AST.MatchArm> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            var pattern = this.parse_pattern()
            this.consume("=>")
            var body = this.parse_expr()
            arms.push(AST.MatchArm.Arm(pattern, body))
        }
        this.consume("}")
        return AST.Expr.Match(subject, arms)
    }

    fun parse_pattern(): AST.Pattern {
        var name = this.expect_ident()
        if (this.match_kind("(")) {
            var bindings: List<String> = []
            if (!this.match_kind_check(")")) {
                bindings.push(this.expect_ident())
                while (this.match_kind(",")) {
                    bindings.push(this.expect_ident())
                }
            }
            this.consume(")")
            return AST.Pattern.VariantPattern(name, bindings)
        }
        return AST.Pattern.VariantPattern(name, [])
    }

    // --- Helpers for operator precedence ---

    fun parse_lambda(): AST.Expr {
        this.advance() // consume fun
        this.consume("(")
        var params_sb = StringBuilder()
        if (!this.match_kind_check(")")) {
            var pname = this.expect_ident()
            this.consume(":")
            var ptype = this.parse_type()
            params_sb.append(pname)
            params_sb.append(":")
            params_sb.append(ptype)
            while (this.match_kind(",")) {
                pname = this.expect_ident()
                this.consume(":")
                ptype = this.parse_type()
                params_sb.append(",")
                params_sb.append(pname)
                params_sb.append(":")
                params_sb.append(ptype)
            }
        }
        this.consume(")")
        var ret_type = "Int"
        if (this.match_kind(":")) {
            ret_type = this.parse_type()
        }
        if (this.match_kind("=>")) {
            // Short form: fun (x: Int) => expr
            var expr = this.parse_expr()
            var params = params_sb.to_string()
            return AST.Expr.Lambda(params, ret_type, [AST.Stmt.Return(expr)])
        }
        // Block form: fun (x: Int) { ... }
        var params = params_sb.to_string()
        var body = this.parse_block_stmts()
        return AST.Expr.Lambda(params, ret_type, body)
    }

    fun is_ident_named(name: String): Bool {
        if (!this.match_kind_check("ident")) return false
        var kind = this.current_kind()
        var ident_name = match (kind) { TkIdent(n) => n }
        return ident_name == name
    }

    fun match_kind_check(expected: String): Bool {
        var kind = this.current_kind()
        var name = this.kind_name(kind)
        return name == expected
    }

    fun kind_name(kind: Lexer.TokenKind): String {
        return match (kind) {
            TkPlus => "+"
            TkMinus => "-"
            TkStar => "*"
            TkSlash => "/"
            TkPercent => "%"
            TkAmpersand => "&"
            TkPipe => "|"
            TkCaret => "^"
            TkTilde => "~"
            TkShiftLeft => "<<"
            TkShiftRight => ">>"
            TkBang => "!"
            TkBangEq => "!="
            TkEqEq => "=="
            TkLt => "<"
            TkLtEq => "<="
            TkGt => ">"
            TkGtEq => ">="
            TkLParen => "("
            TkRParen => ")"
            TkLBrace => "{"
            TkRBrace => "}"
            TkLBracket => "["
            TkRBracket => "]"
            TkDot => "."
            TkComma => ","
            TkColon => ":"
            TkSemicolon => ";"
            TkEq => "="
            TkArrow => "->"
            TkFatArrow => "=>"
            TkVar => "var"
            TkLet => "let"
            TkFun => "fun"
            TkReturn => "return"
            TkIf => "if"
            TkElse => "else"
            TkWhile => "while"
            TkOr => "or"
            TkAnd => "and"
            TkTrue => "true"
            TkFalse => "false"
            TkNil => "nil"
            TkImport => "import"
            TkAs => "as"
            TkEnum => "enum"
            TkMatch => "match"
            TkClass => "class"
            TkThis => "this"
            TkFor => "for"
            TkIn => "in"
            TkTry => "try"
            TkCatch => "catch"
            TkThrow => "throw"
            TkFinally => "finally"
            TkEof => "eof"
            TkInt(v) => "int"
            TkFloat(v) => "float"
            TkString(v) => "string"
            TkIdent(v) => "ident"
            TkDocComment(t) => "doc_comment"
            TkModuleDoc(t) => "module_doc"
            TkNewline => "newline"
        }
    }

    fun is_equality_op(): Bool {
        return this.match_kind_check("==") or this.match_kind_check("!=")
    }

    fun is_comparison_op(): Bool {
        return this.match_kind_check("<") or this.match_kind_check("<=") or
               this.match_kind_check(">") or this.match_kind_check(">=")
    }

    fun is_shift_op(): Bool {
        return this.match_kind_check("<<") or this.match_kind_check(">>")
    }

    fun is_term_op(): Bool {
        return this.match_kind_check("+") or this.match_kind_check("-")
    }

    fun is_factor_op(): Bool {
        return this.match_kind_check("*") or this.match_kind_check("/") or this.match_kind_check("%")
    }

    fun get_op_string(): String {
        var kind = this.current_kind()
        return match (kind) {
            TkPlus => "+"
            TkMinus => "-"
            TkStar => "*"
            TkSlash => "/"
            TkPercent => "%"
            TkAmpersand => "&"
            TkPipe => "|"
            TkCaret => "^"
            TkShiftLeft => "<<"
            TkShiftRight => ">>"
            TkBangEq => "!="
            TkEqEq => "=="
            TkLt => "<"
            TkLtEq => "<="
            TkGt => ">"
            TkGtEq => ">="
        }
    }

    // --- Docstring collection ---

    fun collect_doc_comments(): String {
        var parts: List<String> = []
        while (this.match_kind_check("doc_comment")) {
            var kind = this.current_kind()
            var text = match (kind) {
                TkDocComment(t) => t
            }
            this.advance()
            parts.push(text)
        }
        if (parts.length() == 0) return ""
        return parts.join("\n")
    }

    fun collect_module_doc(): String {
        var parts: List<String> = []
        while (this.match_kind_check("module_doc")) {
            var kind = this.current_kind()
            var text = match (kind) {
                TkModuleDoc(t) => t
            }
            this.advance()
            parts.push(text)
        }
        if (parts.length() == 0) return ""
        return parts.join("\n")
    }

    // --- Statements ---

    fun parse_program(): List<AST.Stmt> {
        // Collect leading //! module doc comments
        var module_doc = this.collect_module_doc()
        var stmts: List<AST.Stmt> = []
        while (!this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("eof")) { return stmts }
            stmts.push(this.parse_stmt())
        }
        return stmts
    }

    fun parse_stmt(): AST.Stmt {
        // Collect /// doc comments before declarations
        var docstring = this.collect_doc_comments()

        if (this.match_kind_check("var")) return this.parse_var_decl_with_doc(docstring)
        if (this.match_kind_check("let")) return this.parse_var_decl_with_doc(docstring)
        if (this.match_kind_check("fun")) return this.parse_fun_decl_with_doc(docstring)
        if (this.match_kind_check("enum")) return this.parse_enum_decl_with_doc(docstring)
        if (this.match_kind_check("class")) return this.parse_class_decl_with_doc(docstring)
        if (this.match_kind_check("import")) return this.parse_import()
        if (this.match_kind_check("return")) return this.parse_return()
        if (this.match_kind_check("if")) return this.parse_if()
        if (this.match_kind_check("while")) return this.parse_while()
        if (this.match_kind_check("for")) return this.parse_for()
        if (this.match_kind_check("try")) return this.parse_try()
        if (this.match_kind_check("throw")) return this.parse_throw()
        if (this.is_ident_named("break")) { this.advance(); return AST.Stmt.Break }
        if (this.is_ident_named("continue")) { this.advance(); return AST.Stmt.Continue }
        if (this.match_kind_check("{")) return this.parse_block()
        // Check for assignment: ident = expr
        if (this.match_kind_check("ident") and this.peek_is("=")) {
            return this.parse_assign()
        }
        // Check for this.field = value
        if (this.match_kind_check("this")) {
            return this.parse_this_stmt()
        }
        // Default: expression statement
        var expr = this.parse_expr()
        return AST.Stmt.ExprStmt(expr)
    }

    fun peek_is(expected: String): Bool {
        if (this.pos + 1 >= this.tokens.length()) return false
        var next_tok = this.tokens[this.pos + 1]
        var next_kind = match (next_tok) { Token(k, l, c) => k }
        return this.kind_name(next_kind) == expected
    }

    fun parse_assign(): AST.Stmt {
        var name = this.expect_ident()
        this.consume("=")
        var value = this.parse_expr()
        return AST.Stmt.ExprStmt(AST.Expr.Assign(name, value))
    }

    fun parse_var_decl(): AST.Stmt {
        return this.parse_var_decl_with_doc("")
    }

    fun parse_var_decl_with_doc(docstring: String): AST.Stmt {
        this.advance() // consume var/let
        var name = this.expect_ident()
        var type_ann = "Any"
        if (this.match_kind(":")) {
            type_ann = this.parse_type()
        }
        this.consume("=")
        var init = this.parse_expr()
        return AST.Stmt.VarDecl(name, type_ann, init, docstring)
    }

    fun parse_fun_decl(): AST.Stmt {
        return this.parse_fun_decl_with_doc("")
    }

    fun parse_fun_decl_with_doc(docstring: String): AST.Stmt {
        this.advance() // consume fun
        var name = this.expect_ident()
        this.consume("(")
        var params_sb = StringBuilder()
        var first_param = true
        if (!this.match_kind_check(")")) {
            var pname = this.expect_ident()
            this.consume(":")
            var ptype = this.parse_type()
            params_sb.append(pname)
            params_sb.append(":")
            params_sb.append(ptype)
            first_param = false
            while (this.match_kind(",")) {
                pname = this.expect_ident()
                this.consume(":")
                ptype = this.parse_type()
                params_sb.append(",")
                params_sb.append(pname)
                params_sb.append(":")
                params_sb.append(ptype)
            }
        }
        this.consume(")")
        var ret_type = "Nil"
        if (this.match_kind(":")) {
            ret_type = this.parse_type()
        }
        var params = params_sb.to_string()
        var body = this.parse_block_stmts()
        return AST.Stmt.FunDecl(name, params, ret_type, body, docstring)
    }

    fun parse_enum_decl(): AST.Stmt {
        return this.parse_enum_decl_with_doc("")
    }

    fun parse_enum_decl_with_doc(docstring: String): AST.Stmt {
        this.advance() // consume enum
        var name = this.expect_ident()
        this.consume("{")
        var variants: List<AST.Variant> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            var vname = this.expect_ident()
            var fields = ""
            if (this.match_kind("(")) {
                var fields_sb = StringBuilder()
                var first = true
                while (!this.match_kind_check(")")) {
                    if (!first) {
                        fields_sb.append(",")
                        this.consume(",")
                    }
                    var fname = this.expect_ident()
                    this.consume(":")
                    var ftype = this.parse_type()
                    fields_sb.append(fname)
                    fields_sb.append(":")
                    fields_sb.append(ftype)
                    first = false
                }
                this.consume(")")
                fields = fields_sb.to_string()
            }
            variants.push(AST.Variant.Variant(vname, fields))
            this.match_kind(",")
        }
        this.consume("}")
        return AST.Stmt.EnumDecl(name, variants, docstring)
    }

    fun parse_this_stmt(): AST.Stmt {
        this.advance() // consume this
        this.consume(".")
        var field = this.expect_ident()
        if (this.match_kind("=")) {
            // this.field = value
            var value = this.parse_expr()
            return AST.Stmt.ExprStmt(AST.Expr.SetField(AST.Expr.This, field, value))
        }
        // Check for chained method: this.field.method(args)
        var expr = AST.Expr.GetField(AST.Expr.This, field)
        if (this.match_kind_check(".")) {
            this.advance()
            var method = this.expect_ident()
            if (this.match_kind("(")) {
                var args: List<AST.Expr> = []
                if (!this.match_kind_check(")")) {
                    args.push(this.parse_expr())
                    while (this.match_kind(",")) {
                        args.push(this.parse_expr())
                    }
                }
                this.consume(")")
                return AST.Stmt.ExprStmt(AST.Expr.MethodCall(expr, method, args))
            }
        }
        // Check for direct method call: this.method(args)
        if (this.match_kind("(")) {
            var args: List<AST.Expr> = []
            if (!this.match_kind_check(")")) {
                args.push(this.parse_expr())
                while (this.match_kind(",")) {
                    args.push(this.parse_expr())
                }
            }
            this.consume(")")
            return AST.Stmt.ExprStmt(AST.Expr.MethodCall(AST.Expr.This, field, args))
        }
        return AST.Stmt.ExprStmt(expr)
    }

    fun parse_class_decl(): AST.Stmt {
        return this.parse_class_decl_with_doc("")
    }

    fun parse_class_decl_with_doc(docstring: String): AST.Stmt {
        this.advance() // consume class
        var name = this.expect_ident()
        this.consume("{")
        var fields_sb = StringBuilder()
        var methods: List<AST.Stmt> = []
        var first_field = true
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) { return AST.Stmt.ClassDecl(name, fields_sb.to_string(), methods, docstring) }
            if (this.match_kind_check("var")) {
                // Field declaration: var name: Type
                this.advance()
                var fname = this.expect_ident()
                this.consume(":")
                var ftype = this.parse_type()
                if (!first_field) { fields_sb.append(",") }
                fields_sb.append(fname)
                fields_sb.append(":")
                fields_sb.append(ftype)
                first_field = false
            } else if (this.match_kind_check("fun")) {
                // Method declaration
                methods.push(this.parse_fun_decl())
            }
        }
        this.consume("}")
        return AST.Stmt.ClassDecl(name, fields_sb.to_string(), methods, docstring)
    }

    fun parse_import(): AST.Stmt {
        this.advance() // consume import
        // Skip: "path" as Name  or  { names } from "path"
        while (!this.match_kind_check("eof") and !this.match_kind_check("var") and !this.match_kind_check("fun") and !this.match_kind_check("class") and !this.match_kind_check("enum") and !this.match_kind_check("import")) {
            this.advance()
        }
        return AST.Stmt.ExprStmt(AST.Expr.NilLit)
    }

    fun parse_return(): AST.Stmt {
        this.advance() // consume return
        // Bare return (no value) → return nil
        if (this.match_kind_check("}") or this.match_kind_check("eof")) {
            return AST.Stmt.Return(AST.Expr.NilLit)
        }
        var value = this.parse_expr()
        return AST.Stmt.Return(value)
    }

    fun parse_if(): AST.Stmt {
        this.advance() // consume if
        this.consume("(")
        var cond = this.parse_expr()
        this.consume(")")
        var then_branch = this.parse_body()
        var else_branch: List<AST.Stmt> = []
        if (this.match_kind("else")) {
            if (this.match_kind_check("if")) {
                // Flatten else-if: parse as nested If in else
                // But limit depth to prevent stack overflow in codegen
                else_branch = [this.parse_if()]
            } else {
                else_branch = this.parse_body()
            }
        }
        return AST.Stmt.If(cond, then_branch, else_branch)
    }

    fun parse_body(): List<AST.Stmt> {
        // Block with braces or single statement
        if (this.match_kind_check("{")) {
            return this.parse_block_stmts()
        }
        // Single statement body (no braces)
        return [this.parse_stmt()]
    }

    fun parse_while(): AST.Stmt {
        this.advance() // consume while
        this.consume("(")
        var cond = this.parse_expr()
        this.consume(")")
        var body = this.parse_block_stmts()
        return AST.Stmt.While(cond, body)
    }

    fun parse_for(): AST.Stmt {
        this.advance() // consume for
        this.consume("(")
        // Check for for-in: for (name in expr)
        var name = this.expect_ident()
        if (this.match_kind("in")) {
            return this.parse_for_in(name)
        }
        // C-style for: for (var name = init; cond; update)
        this.consume(":")
        var vtype = this.parse_type()
        this.consume("=")
        var init_expr = this.parse_expr()
        var init = AST.Stmt.VarDecl(name, vtype, init_expr, "")
        this.consume(";")
        var cond = this.parse_expr()
        this.consume(";")
        var update_name = this.expect_ident()
        this.consume("=")
        var update_expr = this.parse_expr()
        this.consume(")")
        var body = this.parse_block_stmts()
        body.push(AST.Stmt.ExprStmt(AST.Expr.Assign(update_name, update_expr)))
        var stmts: List<AST.Stmt> = []
        stmts.push(init)
        stmts.push(AST.Stmt.While(cond, body))
        return AST.Stmt.Block(stmts)
    }

    fun parse_for_in(item_name: String): AST.Stmt {
        // Desugar: for (item in list) { body }
        // Into: { var __list = list; var __i = 0; while (__i < __list.length()) { var item = __list[__i]; body; __i = __i + 1 } }
        var iter_expr = this.parse_expr()
        this.consume(")")
        var body = this.parse_block_stmts()

        var list_var = "__for_list"
        var idx_var = "__for_i"

        // var __for_list = iter_expr
        var init_list = AST.Stmt.VarDecl(list_var, "List", iter_expr, "")
        // var __for_i = 0
        var init_idx = AST.Stmt.VarDecl(idx_var, "Int", AST.Expr.IntLit(0), "")
        // __for_i < __for_list.length()
        var cond = AST.Expr.Binary(
            AST.Expr.Variable(idx_var),
            "<",
            AST.Expr.MethodCall(AST.Expr.Variable(list_var), "length", [])
        )
        // var item = __for_list[__for_i]
        var item_init = AST.Stmt.VarDecl(item_name, "Any",
            AST.Expr.IndexGet(AST.Expr.Variable(list_var), AST.Expr.Variable(idx_var)), "")
        // __for_i = __for_i + 1
        var increment = AST.Stmt.ExprStmt(AST.Expr.Assign(idx_var,
            AST.Expr.Binary(AST.Expr.Variable(idx_var), "+", AST.Expr.IntLit(1))))

        // Build while body: item decl + user body + increment
        var while_body: List<AST.Stmt> = []
        while_body.push(item_init)
        var bi = 0
        while (bi < body.length()) {
            while_body.push(body[bi])
            bi = bi + 1
        }
        while_body.push(increment)

        // Build block: list init + idx init + while
        var stmts: List<AST.Stmt> = []
        stmts.push(init_list)
        stmts.push(init_idx)
        stmts.push(AST.Stmt.While(cond, while_body))
        return AST.Stmt.Block(stmts)
    }

    fun parse_try(): AST.Stmt {
        this.advance() // consume try
        var try_body = this.parse_block_stmts()
        this.consume("catch")
        this.consume("(")
        var catch_name = this.expect_ident()
        this.consume(")")
        var catch_body = this.parse_block_stmts()
        // TODO: handle finally
        return AST.Stmt.TryCatch(try_body, catch_name, catch_body)
    }

    fun parse_throw(): AST.Stmt {
        this.advance() // consume throw
        var value = this.parse_expr()
        return AST.Stmt.Throw(value)
    }

    fun parse_block(): AST.Stmt {
        return AST.Stmt.Block(this.parse_block_stmts())
    }

    fun parse_block_stmts(): List<AST.Stmt> {
        this.consume("{")
        var stmts: List<AST.Stmt> = []
        while (!this.match_kind_check("}") and !this.match_kind_check("eof")) {
            while (this.match_kind(";")) {}
            if (this.match_kind_check("}") or this.match_kind_check("eof")) {
                this.consume("}")
                return stmts
            }
            stmts.push(this.parse_stmt())
        }
        this.consume("}")
        return stmts
    }

    fun stmt_to_expr(stmt: AST.Stmt): AST.Expr {
        // If it's an ExprStmt, extract the expression as the block value
        // Otherwise return NilLit
        var kind = match (stmt) {
            ExprStmt(e) => "expr"
            VarDecl(n, t, i, d) => "other"
            FunDecl(n, p, r, b, d) => "other"
            EnumDecl(n, v, d) => "other"
            ClassDecl(n, f, m, d) => "other"
            Return(v) => "other"
            If(c, t, e) => "other"
            While(c, b) => "other"
            Block(s) => "other"
            Break => "other"
            Continue => "other"
        }
        if (kind == "expr") {
            return match (stmt) { ExprStmt(e) => e }
        }
        return AST.Expr.NilLit
    }
}

fun parse(tokens: List<Lexer.Token>): List<AST.Stmt> {
    var p = Parser(tokens)
    return p.parse_program()
}
