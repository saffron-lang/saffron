    fun make_list_type(): AST.Type {
        return AST.Type.GenericType("List", [AST.Type.AnyType])
    }
    fun make_list_str_type(): AST.Type {
        return AST.Type.GenericType("List", [AST.Type.StringType])
    }
    fun make_map_type(): AST.Type {
        return AST.Type.GenericType("Map", [AST.Type.StringType, AST.Type.AnyType])
    }
    fun make_generic_type(base: String, args: List<AST.Type>): AST.Type {
        return AST.Type.GenericType(base, args)
    }

    fun params_to_string(params: List<AST.Param>): String {
        if (!(params is List)) {
            return ""
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < params.length()) {
            if (i > 0) { sb.append(",") }
            var p: AST.Param = params[i]
            var pname: String = match (p) { Param(n, t, d, p_vis) => n }
            var pt: AST.Type = match (p) { Param(n, t, d, p_vis) => t }
            var ptype: String = this.type_to_string(pt)
            sb.append(pname)
            sb.append(":")
            sb.append(ptype)
            i = i + 1
        }
        return sb.to_string()
    }

    /// The Saffron type names of `params`, comma-joined and positional
    /// ("Int,Any,Float"). Unlike `params_to_string` this drops the names, so it
    /// can be indexed straight against an extern's C parameter list.
    fun param_types_csv(params: List<AST.Param>): String {
        if (!(params is List)) {
            return ""
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < params.length()) {
            if (i > 0) { sb.append(",") }
            var p: AST.Param = params[i]
            var pt: AST.Type = match (p) { Param(n, t, d, p_vis) => t }
            sb.append(this.type_to_string(pt))
            i = i + 1
        }
        return sb.to_string()
    }

    fun str_to_type(s: String): AST.Type {
        if (!(s is String)) return AST.Type.AnyType
        if (s == "String") return AST.Type.StringType
        // `Number` is deprecated: it is one surface name for two representations,
        // so no mapping of it can be right. `fun area(): Number` returning 12.0 is
        // relabelled Int and the caller's `.to_string()` untags a double as an
        // integer and prints 0; mapping it to Float instead breaks every `Number`
        // used as a list index. Int is kept because it is the integer-ish reading
        // that user code overwhelmingly means, and because src/lib no longer writes
        // `Number` at all — the remaining users are user programs and test/.
        // Retire the spelling rather than re-tune this line. See BUGS.md #49 and
        // M2 in docs/design/compiler-rewrite.md ("Int is the bottom type").
        if (s == "Int" or s == "Number") return AST.Type.IntType
        if (s == "Float") return AST.Type.FloatType
        if (s == "Bool") return AST.Type.BoolType
        if (s == "Nil") return AST.Type.NilType
        if (s == "Any") return AST.Type.AnyType
        // Union types: check for "|" at top level (not inside <> or ())
        if (s.contains("|")) {
            var union_parts: List<String> = this.split_type_union(s)
            if (union_parts.length() > 1) {
                var types: List<AST.Type> = []
                var ui: Float = 0
                while (ui < union_parts.length()) {
                    types.push(this.str_to_type(union_parts[ui]))
                    ui = ui + 1
                }
                return AST.Type.UnionType(types)
            }
        }
        // Function types: Fun(Int,String):Bool
        if (s.starts_with("Fun(")) {
            return this.parse_func_type_str(s)
        }
        if (s == "List") return this.make_list_type()
        if (s.starts_with("List<") and s.ends_with(">")) {
            var inner: String = s.slice(5, s.length() - 1)
            return this.make_generic_type("List", [this.str_to_type(inner)])
        }
        if (s == "Map") return this.make_map_type()
        if (s.starts_with("Map<") and s.ends_with(">")) {
            var map_inner: String = s.slice(4, s.length() - 1)
            var map_parts: List<String> = this.split_respecting_generics(map_inner, ",")
            if (map_parts.length() >= 2) {
                return this.make_generic_type("Map", [this.str_to_type(map_parts[0]), this.str_to_type(map_parts[1])])
            }
            return this.make_map_type()
        }
        if (s == "StringBuilder") return AST.Type.ClassType("StringBuilder")
        return AST.Type.ClassType(s)
    }

    fun parse_func_type_str(s: String): AST.Type {
        // Format: Fun(param1,param2):RetType
        // Find the closing paren that matches the opening one
        var depth: Float = 0
        var close_paren: Float = -1
        var i: Float = 4  // skip "Fun("
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "(") {
                depth = depth + 1
            } else if (ch == ")") {
                if (depth == 0) {
                    close_paren = i
                    i = s.length()
                } else {
                    depth = depth - 1
                }
            }
            i = i + 1
        }
        if (close_paren < 0) {
            return AST.Type.FuncType([], AST.Type.AnyType)
        }
        var params_str: String = s.slice(4, close_paren)
        var param_types: List<AST.Type> = []
        if (params_str.length() > 0) {
            var param_parts: List<String> = this.split_respecting_generics(params_str, ",")
            var pi: Float = 0
            while (pi < param_parts.length()) {
                param_types.push(this.str_to_type(param_parts[pi]))
                pi = pi + 1
            }
        }
        var ret_type: AST.Type = AST.Type.AnyType
        // After ")" there should be ":RetType"
        if (close_paren + 1 < s.length() and s.char_at(close_paren + 1) == ":") {
            var ret_str: String = s.slice(close_paren + 2, s.length())
            ret_type = this.str_to_type(ret_str)
        }
        return AST.Type.FuncType(param_types, ret_type)
    }

    fun type_to_string(t: AST.Type): String {
        var result: String = match (t) {
            IntType => "Int"
            FloatType => "Float"
            BoolType => "Bool"
            StringType => "String"
            NilType => "Nil"
            AnyType => "Any"
            ClassType(n) => n
            EnumType(n) => n
            GenericType(base, args) => this.generic_type_string(base, args)
            UnionType(types) => this.union_type_string(types)
            FuncType(p, r) => this.func_type_string(p, r)
            NullableType(inner) => this.type_to_string(inner) + "|Nil"
        }
        // In identity mode, Float and Int are both i64 — treat Float as Int
        if (this.identity_mode and result == "Float") { return "Int" }
        return result
    }

    fun union_type_string(types: List<AST.Type>): String {
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < types.length()) {
            if (i > 0) { sb.append("|") }
            sb.append(this.type_to_string(types[i]))
            i = i + 1
        }
        return sb.to_string()
    }

    fun func_type_string(params: List<AST.Type>, ret: AST.Type): String {
        var sb: StringBuilder = StringBuilder()
        sb.append("Fun(")
        var i: Float = 0
        while (i < params.length()) {
            if (i > 0) { sb.append(",") }
            sb.append(this.type_to_string(params[i]))
            i = i + 1
        }
        sb.append("):")
        sb.append(this.type_to_string(ret))
        return sb.to_string()
    }

    fun split_type_union(s: String): List<String> {
        var result: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<" or ch == "(") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">" or ch == ")") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "|" and depth == 0) {
                result.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            result.push(current)
        }
        return result
    }

    fun split_type_args(s: String): List<String> {
        var result: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<" or ch == "(") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">" or ch == ")") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "," and depth == 0) {
                result.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            result.push(current)
        }
        return result
    }

    fun generic_type_string(base: String, args: List<AST.Type>): String {
        if (args.length() > 1) {
            var sb: StringBuilder = StringBuilder()
            sb.append(base)
            sb.append("<")
            var gi: Float = 0
            while (gi < args.length()) {
                if (gi > 0) { sb.append(",") }
                sb.append(this.type_to_string(args[gi]))
                gi = gi + 1
            }
            sb.append(">")
            return sb.to_string()
        }
        if (args.length() > 0) {
            return base + "<" + this.type_to_string(args[0]) + ">"
        }
        return base
    }

    fun get_list_element_type(t: AST.Type): AST.Type {
        return match (t) {
            GenericType(base, args) => {
                if (base == "List" and args.length() > 0) {
                    return args[0]
                }
                return AST.Type.AnyType
            }
            IntType => AST.Type.AnyType
            FloatType => AST.Type.AnyType
            BoolType => AST.Type.AnyType
            StringType => AST.Type.AnyType
            NilType => AST.Type.AnyType
            AnyType => AST.Type.AnyType
            ClassType(n) => AST.Type.AnyType
            EnumType(n) => AST.Type.AnyType
            UnionType(types) => AST.Type.AnyType
            FuncType(p, r) => AST.Type.AnyType
            NullableType(inner) => AST.Type.AnyType
        }
    }

    fun is_string_type(t: AST.Type): Bool {
        return match (t) {
            StringType => true
            IntType => false
            FloatType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_int_type(t: AST.Type): Bool {
        return match (t) {
            IntType => true
            FloatType => true
            StringType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_float_type(t: AST.Type): Bool {
        return match (t) {
            FloatType => true
            IntType => false
            StringType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_bool_type(t: AST.Type): Bool {
        return match (t) {
            BoolType => true
            IntType => false
            FloatType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_nil_type(t: AST.Type): Bool {
        return match (t) {
            NilType => true
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_list_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => base == "List"
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_string_list_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => {
                if (base != "List") return false
                if (args.length() == 0) return false
                return this.is_string_type(args[0])
            }
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_map_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => base == "Map"
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    // True when the type admits more than one runtime representation, so no
    // compile-time answer about a value's actual type is available. Every
    // is_*_type predicate answers `false` for these, which makes a whitelist
    // of "is it Any?" silently wrong: both arms of `x is Int` / `x is Nil` on
    // an `Int|Nil` compiled to a literal false. See BUGS #69.
    fun is_undecidable_type(t: AST.Type): Bool {
        return match (t) {
            AnyType => true
            UnionType(types) => true
            NullableType(inner) => true
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            FuncType(p, r) => false
        }
    }

    fun is_class_type(t: AST.Type, name: String): Bool {
        return match (t) {
            ClassType(n) => n == name
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    // Extract the value type string from a Map<K, V> type annotation.
    // e.g. "Map<String,AST.Type>" → "AST.Type"
    //      "Map<String,String>"   → "String"
    //      "Map" or unknown       → "Any"
    fun get_map_value_type(map_type: String): String {
        if (!map_type.starts_with("Map<")) return "Any"
        // Strip "Map<" prefix and trailing ">"
        var inner: String = map_type.slice(4, map_type.length() - 1)
        // Split on first comma respecting nested generics
        var parts: List<String> = this.split_respecting_generics(inner, ",")
        if (parts.length() < 2) return "Any"
        return parts[1]
    }

    // The type an iteration over `coll` yields per step — the static counterpart
    // of what __any_iter_get computes at runtime (BUGS #62).
    //
    // A List<T> yields T, a String yields String (one character), and a Map<K,V>
    // yields List<Any> because the runtime hands back a two-element [key, value]
    // pair whose two slots have different types. `List<K|V>` would be more
    // precise but `is` is broken on union types (BUGS #69), so it would type
    // check and then silently take the wrong branch — Any is the honest answer
    // until that is fixed.
    //
    // Any receiver whose type is unknown, generic, or not iterable yields Any.
    // That is not a diagnostic here: `for-in` over a non-iterable is a checker
    // concern, and reporting it from a type helper would fire on every
    // Any-typed receiver that works fine at runtime.
    fun iter_element_type(coll: AST.Expr): AST.Type {
        var name: String = this.get_variable_name(coll)
        var ts: String = ""
        if (name.length() > 0) {
            ts = this.get_var_type_str(name)
        }
        if (ts.length() == 0) { return AST.Type.AnyType }
        if (ts == "String") { return AST.Type.StringType }
        if (ts.starts_with("Map")) {
            return this.make_generic_type("List", [AST.Type.AnyType])
        }
        if (ts.starts_with("List<")) {
            var inner: String = ts.slice(5, ts.length() - 1)
            var parts: List<String> = this.split_respecting_generics(inner, ",")
            if (parts.length() < 1) { return AST.Type.AnyType }
            return this.str_to_type(parts[0])
        }
        return AST.Type.AnyType
    }

    // Extract the key type string from a Map<K, V> type annotation.
    // e.g. "Map<String,AST.Type>" → "String"
    //      "Map<Int,String>"      → "Int"
    //      "Map" or unknown       → "Any"
    fun get_map_key_type(map_type: String): String {
        if (!map_type.starts_with("Map<")) return "Any"
        var inner: String = map_type.slice(4, map_type.length() - 1)
        var parts: List<String> = this.split_respecting_generics(inner, ",")
        if (parts.length() < 1) return "Any"
        return parts[0]
    }

    // Fold one map-literal entry's key/value types into the receiver's Map type.
    //
    // Called once per desugared .set() of a map literal. Each call merges the
    // new entry against what the earlier entries established: agreement keeps
    // the precise type, disagreement widens that side to Any. A side already
    // widened to Any stays there.
    //
    // Restricted to the parser's map-literal temporary. That is exactly the
    // scope of the bug, and it means an explicit `var m: Map<String, Any> = ...`
    // is never touched: a user-named variable keeps the type its annotation
    // gave it, rather than being silently narrowed by its own initializer.
    fun refine_map_entry_type(name: String, key_type: String, val_type: String) {
        if (!name.starts_with("__map")) { return }
        var current: String = this.get_var_type_str(name)
        if (current.length() == 0) { return }
        if (!(current == "Map" or current.starts_with("Map<"))) { return }
        var known_k: String = this.get_map_key_type(current)
        var known_v: String = this.get_map_value_type(current)
        // Seed from nothing on the first entry. A bare "Map" annotation resolves
        // through str_to_type to Map<String, Any>, so treating that String as an
        // observation would make {1: "x"} merge Int against String and widen the
        // key back to Any — learning nothing. The literal's own entries are the
        // only evidence here, so start both sides unknown.
        if (current == "Map") {
            known_k = "Any"
            known_v = "Any"
        }
        var next_k: String = this.merge_entry_type(known_k, key_type)
        var next_v: String = this.merge_entry_type(known_v, val_type)
        this.typed_vars.set(name, this.make_generic_type("Map", [this.str_to_type(next_k), this.str_to_type(next_v)]))
    }

    // Merge one entry's observed type into the accumulated type for that side.
    // "Any" on either side is the unknown/widened state, so it absorbs.
    fun merge_entry_type(known: String, observed: String): String {
        if (observed.length() == 0 or observed == "Any" or observed == "Nil") { return "Any" }
        if (known == "Any") { return observed }
        if (known == observed) { return known }
        return "Any"
    }

    // Get the type string for a variable from typed_vars (the single source of truth).
    // Returns "" if the variable is not registered.
    fun get_var_type_str(name: String): String {
        var result: String = ""
        if (this.typed_vars.has(name)) {
            result = this.type_to_string(this.typed_vars.get(name))
        } else if (this.global_var_types.has(name)) {
            result = this.global_var_types.get(name)
        } else if (this.current_prefix.length() > 0 and this.global_var_types.has(this.current_prefix + name)) {
            result = this.global_var_types.get(this.current_prefix + name)
        }
        // In identity mode, Float and Int are both i64 — treat Float as Int
        if (this.identity_mode and result == "Float") { return "Int" }
        return result
    }

    /// The bare name of a possibly-generic type: "Box<String>" → "Box",
    /// "Map<String,List<Int>>" → "Map", "Dict" → "Dict".
    ///
    /// `class_fields`, `class_methods` and the `ClassName__method` symbol names
    /// are all keyed by the bare name, but a variable's declared type carries its
    /// arguments. Testing `class_fields.has("Box<String>")` is therefore always
    /// false, which silently skipped dispatch for every generic receiver
    /// (BUGS #94 second half).
    fun generic_base_name(typ: String): String {
        if (!typ.contains("<")) { return typ }
        return typ.slice(0, typ.index_of("<"))
    }

    /// `typ` with the receiver's class type arguments substituted in:
    ///
    ///     substitute_class_type_params("T", "Box<String>")         → "String"
    ///     substitute_class_type_params("List<V>", "Pair<Int,Str>")  → "List<Str>"
    ///     substitute_class_type_params("Int", "Box<String>")        → "Int"
    ///
    /// A method declared `fun getItem(k: Int): T` registers "T" as its return
    /// type, and "T" names no runtime representation — dispatch on the result
    /// matches no arm. The receiver's declared type is the authority: the source
    /// wrote `Box<String>`, so `T` is `String`, and nothing has to be inferred
    /// from the argument list. A parameter the annotation leaves unbound (a bare
    /// `Box`, or fewer arguments than parameters) comes back unchanged rather
    /// than as Any, so the caller can tell the difference between "resolved" and
    /// "the source did not say" (BUGS #95).
    fun substitute_class_type_params(typ: String, recv_type: String): String {
        if (typ.length() == 0) { return typ }
        if (!recv_type.contains("<")) { return typ }
        var base_name: String = this.generic_base_name(recv_type)
        if (!this.class_type_params.has(base_name)) { return typ }
        var params: List<String> = this.class_type_params.get(base_name)
        if (params.length() == 0) { return typ }
        var recv_args: List<String> = this.split_type_args(this.strip_generic_brackets(recv_type))
        // Whole-type match: `fun unwrap(): T`.
        var pi: Float = 0
        while (pi < params.length()) {
            if (params[pi] == typ) {
                if (pi < recv_args.length()) {
                    var arg: String = recv_args[pi]
                    if (arg.length() > 0) { return arg }
                }
                return typ
            }
            pi = pi + 1
        }
        // Otherwise recurse into the arguments: `fun items(): List<T>`.
        if (typ.contains("<")) {
            var lt: Float = typ.index_of("<")
            var tbase: String = typ.slice(0, lt)
            var parts: List<String> = this.split_type_args(this.strip_generic_brackets(typ))
            var out: List<String> = []
            var i: Float = 0
            while (i < parts.length()) {
                out.push(this.substitute_class_type_params(parts[i], recv_type))
                i = i + 1
            }
            return tbase + "<" + out.join(",") + ">"
        }
        return typ
    }

    /// The inside of the outermost `<...>`: "Map<String,Int>" → "String,Int".
    /// A type with no arguments yields "".
    fun strip_generic_brackets(typ: String): String {
        if (!typ.contains("<")) { return "" }
        var lt: Float = typ.index_of("<")
        if (typ.length() - 1 <= lt + 1) { return "" }
        return typ.slice(lt + 1, typ.length() - 1)
    }

    /// `typ` with a `Nil` member dropped from a union: "String|Nil" → "String".
    /// A non-union, or a union with no Nil member, comes back unchanged.
    ///
    /// This exists for *method dispatch*, which needs the type a receiver has
    /// once it is known non-nil. The checker already narrows `String|Nil` to
    /// `String` inside a `!= nil` guard and rejects every unguarded call
    /// ("cannot call .length() on nullable 'r'; add a nil check first"), but
    /// that narrowing lives in the checker's own env and never reaches
    /// `typed_vars` — so codegen still sees "String|Nil". The dispatch arms
    /// match on exact names ("String", "List<...>", "Map<...>"), so the union
    /// spelling matched nothing and fell through to the catch-all `else`, which
    /// assumes List. `__list_length` does `inttoptr` on the value as given: a
    /// List is stored untagged, a String is NaN-tagged, so it dereferenced
    /// 0x7FF8... and segfaulted. Other arms (to_upper, trim, ...) missed their
    /// String test the same way and silently emitted nothing at all.
    ///
    /// Because the checker guarantees non-nil at every call site, dropping Nil
    /// here cannot mask a real nil access — it only tells dispatch what the
    /// checker already proved (BUGS #93).
    fun strip_nil_type_str(typ: String): String {
        if (typ == "Nil") { return typ }
        if (!typ.contains("|")) { return typ }
        var parts: List<String> = typ.split("|")
        var kept: List<String> = []
        var i: Float = 0
        while (i < parts.length()) {
            if (parts[i] != "Nil") { kept.push(parts[i]) }
            i = i + 1
        }
        // Only a single surviving member is a usable dispatch target. A genuine
        // multi-member union ("Int|String") stays as it was: it has no single
        // right arm, and picking one would be the same guess that caused #93.
        if (kept.length() == 1) { return kept[0] }
        return typ
    }

    /// The receiver type for builtin method dispatch: the variable's annotation
    /// when it has one, else the type codegen just inferred, with a nullable
    /// wrapper stripped. Ten dispatch arms in `methods_body.sf` open with this
    /// exact three-step preamble; centralising it means a fix lands in all of
    /// them at once rather than in whichever one is being read (BUGS #93).
    fun dispatch_recv_type(obj_name: String, fallback: AST.Type): String {
        var t: String = this.type_to_string(fallback)
        if (obj_name.length() > 0) {
            var annotated: String = this.get_var_type_str(obj_name)
            if (annotated.length() > 0) { t = annotated }
        }
        return this.strip_nil_type_str(t)
    }

    // Resolve a type string to the class name registered in class_fields.
    // Handles module-prefixed types like "Mod.Thing" by stripping the prefix
    // when class_fields only has "Thing".
    fun resolve_class_type(vtype: String): String {
        // Try module-prefixed version first to get correct struct type
        if (this.current_prefix.length() > 0) {
            var prefixed: String = this.current_prefix + vtype
            if (this.class_fields.has(prefixed)) {
                return prefixed
            }
        }
        if (this.class_fields.has(vtype)) {
            // Return the actual struct type name (may be prefixed)
            if (this.class_struct_names.has(vtype)) {
                return this.class_struct_names.get(vtype)
            }
            return vtype
        }
        // Strip module prefix: "Mod.Thing" -> "Thing"
        if (vtype.contains(".")) {
            var dot_idx: Float = vtype.index_of(".")
            var bare: String = vtype.slice(dot_idx + 1, vtype.length())
            // Try current module prefix on the bare name
            if (this.current_prefix.length() > 0) {
                var prefixed_bare: String = this.current_prefix + bare
                if (this.class_fields.has(prefixed_bare)) {
                    return prefixed_bare
                }
            }
            if (this.class_fields.has(bare)) {
                if (this.class_struct_names.has(bare)) {
                    return this.class_struct_names.get(bare)
                }
                return bare
            }
        }
        // Strip generic params then try: "Mod.Thing<X>" -> "Thing"
        if (vtype.contains("<")) {
            var base: String = vtype.slice(0, vtype.index_of("<"))
            if (this.current_prefix.length() > 0) {
                var prefixed_base: String = this.current_prefix + base
                if (this.class_fields.has(prefixed_base)) {
                    return prefixed_base
                }
            }
            if (this.class_fields.has(base)) {
                if (this.class_struct_names.has(base)) {
                    return this.class_struct_names.get(base)
                }
                return base
            }
            if (base.contains(".")) {
                var dot_idx2: Float = base.index_of(".")
                var bare2: String = base.slice(dot_idx2 + 1, base.length())
                if (this.current_prefix.length() > 0) {
                    var prefixed_bare2: String = this.current_prefix + bare2
                    if (this.class_fields.has(prefixed_bare2)) {
                        return prefixed_bare2
                    }
                }
                if (this.class_fields.has(bare2)) {
                    if (this.class_struct_names.has(bare2)) {
                        return this.class_struct_names.get(bare2)
                    }
                    return bare2
                }
            }
        }
        return ""
    }

    // --- Identity-mode tag/untag helpers ---
    // In identity mode, these are no-ops (values are raw i64).
    // In normal mode, they emit __val_tag/untag calls for NaN-boxing.

    fun emit_tag_int(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_int(i64 " + val + ")")
        return local
    }

    fun emit_untag_int(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_untag_int(i64 " + val + ")")
        return local
    }

    fun emit_tag_ptr(ptr: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = ptrtoint i8* " + ptr + " to i64")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_ptr(i8* " + ptr + ")")
        return local
    }

    fun emit_untag_ptr(val: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = inttoptr i64 " + val + " to i8*")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i8* @__val_untag_ptr(i64 " + val + ")")
        return local
    }

    // Tag a void* extern return, but map NULL to int-tagged 0 so a `== 0` guard
    // fires (BUGS #84). In identity mode ptrtoint already turns NULL into 0, so
    // plain emit_tag_ptr is correct there and the _nullable runtime symbol is
    // never referenced during the (identity-mode) bootstrap.
    fun emit_tag_ptr_nullable(ptr: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = ptrtoint i8* " + ptr + " to i64")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_ptr_nullable(i8* " + ptr + ")")
        return local
    }

    fun emit_tag_bool(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_bool(i64 " + val + ")")
        return local
    }

    fun emit_untag_bool(val: String): String {
        if (this.identity_mode) { return val }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_untag_bool(i64 " + val + ")")
        return local
    }

    fun emit_tag_float(val: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = bitcast double " + val + " to i64")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 @__val_tag_float(double " + val + ")")
        return local
    }

    fun emit_untag_float(val: String): String {
        if (this.identity_mode) {
            var local: String = this.fresh_local()
            this.emit_indent(local + " = bitcast i64 " + val + " to double")
            return local
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call double @__val_untag_float(i64 " + val + ")")
        return local
    }

    // Untag a value used as an integer index, given its static type. A
    // Float-tagged value must be *converted* (untag to double, fptosi), not
    // untagged as an int — emit_untag_int reinterprets the double's bit pattern,
    // which for small values lands on index 0 with no warning (BUGS #52). The
    // caller passes the type it saw in this.last_type right after evaluating the
    // index. Non-Float types keep the plain int untag.
    fun emit_untag_index(val: String, idx_type: AST.Type): String {
        if (this.type_to_string(idx_type) == "Float") {
            var as_double: String = this.emit_untag_float(val)
            var as_int: String = this.fresh_local()
            this.emit_indent(as_int + " = fptosi double " + as_double + " to i64")
            return as_int
        }
        return this.emit_untag_int(val)
    }

