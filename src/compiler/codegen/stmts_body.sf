    fun gen_stmt(stmt: AST.Stmt) {
        match (stmt) {
            ExprStmt(expr) => { this.gen_arg_value(expr) }
            VarDecl(name, type_ann, init, doc, v_vis, __ns, __fs) => {
                if (!doc.starts_with("@import:")) {
                    this.gen_var_decl(stmt)
                }
            }
            Return(value) => { this.gen_return(stmt) }
            If(cond, then_branch, else_branch) => {
                this.gen_if(cond, then_branch, else_branch)
            }
            While(cond, body) => { this.gen_while(cond, body) }
            Block(stmts) => { this.gen_stmts(stmts) }
            Break => {
                if (this.loop_break_label.length() > 0) {
                    this.emit_terminator("br label %" + this.loop_break_label)
                }
            }
            Continue => {
                if (this.loop_continue_label.length() > 0) {
                    this.emit_terminator("br label %" + this.loop_continue_label)
                }
            }
            TryCatch(try_body, catch_name, catch_body, finally_body) => {
                this.gen_try_catch(try_body, catch_name, catch_body, finally_body)
            }
            Throw(value) => {
                this.gen_throw(value)
            }
            LetPattern(pattern, value) => {
                this.gen_let_pattern(pattern, value)
            }
            FunDecl(name, params, ret_type, body, doc, f_vis, __ns, __fs) => {
                // Capture and clear pending_extend_class to prevent stale state
                // in nested gen_stmt calls
                var saved_extend: String = this.pending_extend_class
                this.pending_extend_class = ""
                // A nested `fun f` binds `f` in the *enclosing body*, and that
                // binding has to beat a like-named module global — the same
                // innermost-wins rule `var` already gets from current_fn_locals
                // (BUGS #59). Without this, `fun mk() { fun cl() {...}; return cl }`
                // alongside a module-level `var cl` compiled `return cl` to a load
                // from @__g_cl: the global, read before it is initialised, so `mk`
                // handed back 0 and the caller's `cl()` dereferenced a null
                // closure pair (BUGS #80). Recorded under a reserved key rather
                // than the bare name so it can never be mistaken for a `var`
                // binding by the alloca / GC-root sites that also read this map.
                // current_fn_locals is saved and restored around every body, so
                // the marker is scoped to this body for free, and gen_function
                // restores the *same* map object — mutating it here survives the
                // hoisting call below.
                if (this.in_function) {
                    this.current_fn_locals.set("__nestedfn:" + name, true)
                }
                if (doc.starts_with("@intrinsic")) {
                    var emit_name: String = this.current_prefix + name
                    this.known_functions.push(emit_name)
                    this.func_ret_types.set(emit_name, this.ret_type_for_registration(ret_type))
                    this.intrinsic_funcs.push(emit_name)
                } else if (doc.starts_with("@inline")) {
                    // Mark function for alwaysinline attribute, then process normally
                    var emit_name: String = this.current_prefix + name
                    this.inline_funcs.push(emit_name)
                    var params_str: String = this.params_to_string(params)
                    var defaults: List<AST.Expr> = []
                    var param_names: List<String> = []
                    var pi: Float = 0
                    while (pi < params.length()) {
                        var p: AST.Param = params[pi]
                        var dval: AST.Expr = match (p) { Param(n, t, d, p_vis, __ns) => d }
                        var pname: String = match (p) { Param(n, t, d, p_vis, __ns) => n }
                        defaults.push(dval)
                        param_names.push(pname)
                        pi = pi + 1
                    }
                    this.func_defaults.set(emit_name, defaults)
                    this.func_param_count.set(emit_name, params.length())
                    this.func_param_names.set(emit_name, param_names)
                    this.gen_function(name, params_str, ret_type, body)
                } else if (doc.starts_with("@extern:")) {
                    var c_sig: String = doc.slice(8, doc.length())
                    var emit_name: String = this.current_prefix + name
                    this.known_functions.push(emit_name)
                    this.func_ret_types.set(emit_name, this.ret_type_for_registration(ret_type))
                    this.extern_sigs.set(emit_name, c_sig)
                    this.extern_param_types.set(emit_name, this.param_types_csv(params))
                } else if (doc.starts_with("@extend:")) {
                    var ext_class: String = doc.slice(8, doc.length())
                    this.gen_extend_method(ext_class, name, params, ret_type, body)
                } else if (saved_extend.length() > 0) {
                    // Fallback: doc field was unreadable for cross-module FunDecl
                    // but pre-scan identified this as an extension method
                    this.gen_extend_method(saved_extend, name, params, ret_type, body)
                } else {
                    var params_str: String = this.params_to_string(params)
                    // Register default values for optional params
                    var emit_name: String = this.current_prefix + name
                    var defaults: List<AST.Expr> = []
                    var param_names: List<String> = []
                    var pi: Float = 0
                    while (pi < params.length()) {
                        var p: AST.Param = params[pi]
                        var dval: AST.Expr = match (p) { Param(n, t, d, p_vis, __ns) => d }
                        var pname: String = match (p) { Param(n, t, d, p_vis, __ns) => n }
                        defaults.push(dval)
                        param_names.push(pname)
                        pi = pi + 1
                    }
                    this.func_defaults.set(emit_name, defaults)
                    this.func_param_count.set(emit_name, params.length())
                    this.func_param_names.set(emit_name, param_names)
                    this.gen_function(name, params_str, ret_type, body)
                }
            }
            EnumDecl(name, variants, doc, e_vis, __ns, __fs) => {
                this.gen_enum_decl(name, variants)
            }
            ClassDecl(name, type_params, parents, fields, methods, doc, c_vis, __ns, __fs, __intro) => {
                // Registered before the body is generated: a method returning a
                // class type parameter is typed by substituting the receiver's
                // own type arguments, and that has to be known by the time any
                // call site in this class is emitted (BUGS #95).
                if (type_params.length() > 0) {
                    this.class_type_params.set(name, type_params)
                    if (this.current_prefix.length() > 0) {
                        this.class_type_params.set(this.current_prefix + name, type_params)
                    }
                }
                this.gen_class_decl_with_parents(name, parents, fields, methods)
            }
            TypeAlias(ta_n, ta_t, ta_vis) => {}
        }
    }

    fun get_var_name(stmt: AST.Stmt): String {
        return match (stmt) { VarDecl(n, t, i, d, v_vis, __ns, __fs) => n
            _ => ""
        }
    }

    /// The declared type of a `var`, as a node.
    ///
    /// The non-VarDecl fallback is `UnknownType`, which is also what a VarDecl with
    /// no annotation carries — the same collision `fun_ret_type` documents in
    /// src/lib/ast.sf. Every caller here pre-checks `classify_stmt(...) == "var"`,
    /// so neither of them reaches the fallback; a caller that could should ask
    /// first rather than reading the answer.
    fun get_var_type(stmt: AST.Stmt): AST.Type {
        return match (stmt) { VarDecl(n, t, i, d, v_vis, __ns, __fs) => t
            _ => AST.Type.UnknownType
        }
    }

    fun get_var_init(stmt: AST.Stmt): AST.Expr {
        return match (stmt) { VarDecl(n, t, i, d, v_vis, __ns, __fs) => i
            // Was `_ => ""`: a String default on a function declared to return
            // AST.Expr. Nothing rejected it because the checker never walked
            // method bodies (BUGS #76), and every caller pre-checks for a
            // VarDecl, so the wrong-typed value was never produced. NilLit is
            // the honest "no initializer" of the right type.
            _ => AST.Expr.NilLit
        }
    }

    fun get_var_doc(stmt: AST.Stmt): String {
        return match (stmt) { VarDecl(n, t, i, d, v_vis, __ns, __fs) => d
            _ => ""
        }
    }

    fun get_fun_doc(stmt: AST.Stmt): String {
        return match (stmt) { FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => d
            _ => ""
        }
    }

    fun gen_var_decl(stmt: AST.Stmt) {
        var name: String = this.get_var_name(stmt)
        this.gen_var_decl_with_name(name, this.get_var_type(stmt), this.get_var_init(stmt))
    }

    fun gen_var_decl_with_name(name: String, type_ann: AST.Type, init: AST.Expr) {
        // `UnknownType` is the parser's "no annotation" node and the only value that
        // means infer. An explicit `: Any` is a real annotation and must NOT be
        // overwritten by the initializer's type — that conflation was BUGS #147.
        //
        // `type_to_string`, not `type_to_source`: everything downstream of `vtype`
        // in this function is written against the diagnostic spellings — the
        // `vtype.contains("<")` generic-argument resolution below, `== "Nil"`,
        // `starts_with("List")` at the callers. Rendering the faithful form here
        // would hand those a string they were not written for, which is precisely
        // the reason type_to_source was added as a second function rather than as a
        // fix to the first (see the note on it in ast.sf).
        //
        // The infer path starts from "" rather than from the rendered node, because
        // `type_to_string(UnknownType)` is the literal word "Unknown" and I2 forbids
        // that reaching codegen. Every line below either overwrites `vtype` or tests
        // it against a real type name, so "" is what the old String encoding put
        // here and what those lines are written to see when nothing is known.
        var vt_infer: Bool = this.is_unknown_type(type_ann)
        var vtype: String = ""
        if (!vt_infer) {
            vtype = this.type_to_string(type_ann)
        }
        if (vt_infer) {
            vtype = this.get_expr_type(init)
        }
        var val: String = this.gen_arg_value(init)
        // After gen_arg_value, last_type reflects the actual compiled expression type.
        // Always use last_type when inferring, since get_expr_type may fail for
        // complex expressions involving variables not yet in typed_vars.
        if (vt_infer) {
            var post_type: String = this.type_to_string(this.last_type)
            if (post_type != "Any") {
                vtype = post_type
            }
        }
        // A nil initialiser says nothing about the variable's type, so do not let it
        // narrow to "Nil".
        //
        // `var parsed: Any = nil` (and the inferred `var x = nil`) used to type the
        // variable as Nil for the rest of its life. Nothing widened it on
        // reassignment, so after `parsed = JSON.parse(body)` the variable still
        // claimed to be Nil — and the `== nil` comparison in gen_binary keys off the
        // *static* type, emitting `__val_is_nil` against the nil literal rather than
        // against the variable. The result was a comparison that was unconditionally
        // true: `parsed == nil` reported nil for a live object, and the playground's
        // /api/compile rejected every request as "missing 'source' field".
        //
        // "Any" is the honest type here — it routes through the runtime dispatch
        // helpers, which inspect the actual tag. This is I2 in
        // docs/design/compiler-rewrite.md ("Unknown is distinct"), applied to the one
        // case where the current tree spells unknown as a concrete type.
        if (vtype == "Nil") {
            vtype = "Any"
        }
        // Resolve generic type parameters from lambda argument return types.
        // e.g. var x = computed(fun (): String => ...) infers Computed<String> not Computed<T>
        if (vtype.contains("<") and vtype.contains(">")) {
            var gt_start: Float = vtype.index_of("<")
            var gt_inner: String = vtype.slice(gt_start + 1, vtype.length() - 1)
            var gt_base_name: String = vtype.slice(0, gt_start)
            // Whether `gt_inner` is an unbound type parameter. The class's own
            // declared parameter list is the authority: `class Computed<T>` says
            // "T" is a parameter and "String" is not, with no guessing about
            // name shape. The one-or-two-uppercase-characters test below is the
            // old heuristic, kept only for a class whose declaration this
            // codegen instance never saw (a cross-module type whose params were
            // not registered) — it misses a spelled-out `Element` and would
            // misfire on a two-letter class name (BUGS #95).
            var gt_is_param: Bool = false
            if (this.class_type_params.has(gt_base_name)) {
                var gt_params: List<String> = this.class_type_params.get(gt_base_name)
                gt_is_param = gt_params.contains(gt_inner)
            } else {
                gt_is_param = gt_inner.length() <= 2 and gt_inner.length() > 0 and gt_inner == gt_inner.to_upper()
            }
            if (gt_is_param) {
                // Try to infer from init expression's lambda return type
                var inferred: String = this.infer_generic_from_init(init)
                if (inferred.length() > 0 and inferred != "Any" and inferred != "Int") {
                    var gt_base: String = vtype.slice(0, gt_start)
                    vtype = gt_base + "<" + inferred + ">"
                }
            }
        }
        this.typed_vars.set(name, this.str_to_type(vtype))
        if (vtype == "String") {
            this.string_vars.push(name)
        }
        // Int -> Float widening at an annotated declaration (BUGS #28).
        //
        // `var f: Float = 1` used to store the literal with its TAG_INT intact
        // while every downstream read treated the bits as a double, so `1` came
        // back as the subnormal 4.94e-324 — or NaN once it reached a
        // tag-inspecting path. Mixed arithmetic (`1 + 1.0`) was never affected
        // because `__val_untag_float` already converts an int-tagged operand
        // via sitofp; only the declaration path skipped the conversion.
        //
        // The round trip through untag_float/tag_float reuses exactly that
        // conversion rather than duplicating a sitofp here.
        //
        // Gated on !identity_mode deliberately: identity mode has no tags and
        // compiles Float arithmetic as `add i64`, so Float *is* Int there. The
        // compiler's own sources rely on that in 455 places (`Parser.pos`,
        // `var depth: Float = 1`); converting would corrupt every one of them.
        if (!this.identity_mode and vtype == "Float" and this.type_to_string(this.last_type) == "Int") {
            var widened: String = this.emit_untag_float(val)
            val = this.emit_tag_float(widened)
        }
        var var_ref: String = "%" + this.sanitize_name(name)
        // Only the *prefixed* key is consulted. A bare-name fallback used to
        // follow, and it could never help: when current_prefix is "" the two
        // keys are the same string, so the fallback only ever fired with a
        // non-empty prefix — i.e. it matched a global belonging to some other
        // module. `var p: Project = Project()` inside pantry_config's project()
        // then stored to the main program's @__g_p while output_body.sf still
        // allocated %p, and the local was written to an unrelated global.
        // A local shadowing a module global is a local (BUGS #59):
        // current_fn_locals wins, matching the alloca emitted in gen_function.
        if (!this.current_fn_locals.has(name) and this.module_globals.has(this.current_prefix + name)) {
            var_ref = "@__g_" + this.current_prefix + this.sanitize_name(name)
            this.global_var_types.set(name, vtype)
            this.global_var_types.set(this.current_prefix + name, vtype)
        }
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_store(val, "i64", var_ref))
            // LLVM lib parallel path: associate the variable's alloca with the stored Value
            if (!this.identity_mode and this.llvm_values.has(val)) {
                this.llvm_values.set(var_ref, this.llvm_values.get(val))
            }
        } else {
            this.emit_indent("store i64 " + val + ", i64* " + var_ref)
            this.verify_store(val, "i64", var_ref)
        }
    }

    fun infer_generic_from_init(init: AST.Expr): String {
        // If init is a Call(callee, args, ...), try to infer generic type from args:
        // 1. Lambda args with explicit return type
        // 2. String literal args → String
        // 3. Number literal args → Float
        // 4. Typed variable args → that variable's type
        var ek: String = this.classify_expr(init)
        if (ek == "call") {
            var call_args: List<AST.Expr> = match (init) { Call(c, a, __cs) => a   _ => [] }
            var ai: Float = 0
            while (ai < call_args.length()) {
                var arg_kind: String = this.classify_expr(call_args[ai])
                if (arg_kind == "lambda") {
                    // The two spellings excluded here were the *sentinels*: an
                    // unannotated lambda carried "Int", and "Any" carries no
                    // information a generic could be inferred from. With the node
                    // encoding the first is UnknownType and states outright that
                    // nothing was declared, so it is excluded by name rather than
                    // by guessing from a type that happened to mean "absent".
                    var lam_ret: AST.Type = match (call_args[ai]) { Lambda(p, r, b) => r   _ => AST.Type.UnknownType }
                    if (!this.is_unknown_type(lam_ret)) {
                        var lam_ret_str: String = this.type_to_string(lam_ret)
                        if (lam_ret_str != "Int" and lam_ret_str != "Any") {
                            return lam_ret_str
                        }
                    }
                }
                if (arg_kind == "string") {
                    return "String"
                }
                if (arg_kind == "number") {
                    return "Float"
                }
                if (arg_kind == "bool") {
                    return "Bool"
                }
                if (arg_kind == "ident") {
                    var arg_type: String = this.get_expr_type(call_args[ai])
                    if (arg_type.length() > 0 and arg_type != "Any" and arg_type != "Int") {
                        return arg_type
                    }
                }
                ai = ai + 1
            }
        }
        return ""
    }

    fun gen_return(stmt: AST.Stmt) {
        var value: AST.Expr = match (stmt) { Return(v) => v
            _ => AST.Expr.NilLit
        }
        if (this.is_coroutine) {
            var val: String = this.gen_arg_value(value)
            this.emit_indent("store i64 " + val + ", i64* @__task_result")
            this.emit_terminator("br label %__coro_final")
        } else if (this.current_ret_type == "void") {
            // Pop GC roots before returning
            if (this.gc_root_count > 0) {
                this.emit_indent("call void @__gc_pop_roots(i64 " + this.gc_root_count.floor().to_string() + ")")
            }
            this.emit_terminator("ret void")
        } else {
            var val: String = this.gen_arg_value(value)
            // Pop GC roots before returning
            if (this.gc_root_count > 0) {
                this.emit_indent("call void @__gc_pop_roots(i64 " + this.gc_root_count.floor().to_string() + ")")
            }
            this.emit_terminator("ret i64 " + val)
            // LLVM lib parallel path: ret
            // NOTE: Cannot call bb.ret(val_v) directly — it writes to
            // block.terminator_str and block.is_terminated through nested
            // cross-module field access, which triggers a gen2 segfault.
            // Workaround: call ret_set() which delegates to block.set_terminator_text()
            // (method dispatch works), avoiding direct field assignment.
            if (!this.identity_mode and this.use_llvm_lib and this.llvm_values.has(val)) {
                var ret_val_v: Any = this.llvm_values.get(val)
                this.llvm_block_builder.ret_set(ret_val_v)
            }
        }
    }

    fun gen_class_decl_with_parents(name: String, parents: List<String>, fields: List<AST.Param>, methods: List<AST.Stmt>) {
        // The primary base: the one whose field layout the child extends, whose
        // `init` it may forward to, and which `super` names. Bases 2..n
        // contribute methods only — see the field guard below.
        var parent: String = ""
        if (parents.length() > 0) { parent = parents[0] }
        // Convert fields to string format for internal use
        var fields_str: String = this.params_to_string(fields)
        // Inherit parent fields (prepend parent fields before child's own).
        //
        // Only the FIRST base contributes fields, deliberately. Prepending base
        // 2's fields as well would be more complete but would break the one
        // invariant the whole inheritance lowering rests on: parent field index i
        // must equal child field index i, which is what makes `init` forwarding
        // and every inherited method's field access correct without a vtable.
        // That can hold for exactly one base. Keeping it on parents[0] means a
        // single-inheritance class lays out byte-for-byte as it always has.
        var all_fields: String = fields_str
        if (parent.length() > 0 and this.class_fields.has(parent)) {
            var parent_fields: String = this.class_fields.get(parent)
            if (parent_fields.length() > 0) {
                if (all_fields.length() > 0) {
                    all_fields = parent_fields + "," + all_fields
                } else {
                    all_fields = parent_fields
                }
            }
        }
        // So a second base that carries state cannot work, and must say so rather
        // than emit methods that read the first base's fields at those offsets.
        // Interfaces — the overwhelmingly common case for `extends A, B, C` — are
        // fieldless and are unaffected.
        var gi: Float = 1
        while (gi < parents.length()) {
            var extra: String = parents[gi]
            // Bound to a local and nil-checked rather than written as
            // `has(extra) and get(extra).length() > 0`. An `and` narrows its right
            // operand from its left (see the Logical arm of checker.sf's
            // infer_type), but only for a *nil check on a variable* — `has()` is an
            // unrelated call the checker cannot connect to the `get()` beside it,
            // so that spelling would still call `.length()` on a `String|Nil`.
            // `!= nil` on a bound local is the guard that both narrows and
            // evaluates correctly (`is` is broken on unions, BUGS #69).
            var extra_fields: String|Nil = this.class_fields.get(extra)
            if (extra_fields != nil and extra_fields.length() > 0) {
                IO.println("Error: class " + name + " cannot extend " + extra
                    + " as a secondary base: it declares fields, and only the first base's fields are inherited. Make it the first base, or give it no fields.")
            }
            gi = gi + 1
        }
        // For actors, prepend hidden fields: __actor_busy (Int), __actor_queue (Int)
        if (this.actor_classes.has(name)) {
            if (all_fields.length() > 0) {
                all_fields = "__actor_busy:Int,__actor_queue:Int," + all_fields
            } else {
                all_fields = "__actor_busy:Int,__actor_queue:Int"
            }
        }
        // Generate the class with inherited fields
        this.current_parent = parent
        this.gen_class_decl(name, all_fields, methods)
        this.current_parent = ""
        // Record the hierarchy, keyed the same way class_type_ids is (by struct
        // name, i.e. module-prefixed) so __class_is_a can join the two tables.
        // The parent was always available here — it drove field and method
        // inheritance above and was then dropped, which is why `is` on a class
        // could never see a subclass relation (BUGS #61) and dispatch had no
        // hierarchy to switch on (BUGS #50). class_struct_names resolves the
        // parent's own prefix, so a base class in another module still joins.
        if (parents.length() > 0) {
            var child_struct: String = name
            if (this.class_struct_names.has(name)) { child_struct = this.class_struct_names.get(name) }
            var parent_struct: String = parent
            if (this.class_struct_names.has(parent)) { parent_struct = this.class_struct_names.get(parent) }
            this.class_parent_of.set(child_struct, parent_struct)
            // …and the full set, struct-resolved the same way, for __class_is_a.
            var all_structs: List<String> = []
            var psi: Float = 0
            while (psi < parents.length()) {
                var one: String = parents[psi]
                if (this.class_struct_names.has(one)) { one = this.class_struct_names.get(one) }
                all_structs.push(one)
                psi = psi + 1
            }
            this.class_parents_of.set(child_struct, all_structs)
        }
        // Register inherited methods: if child doesn't define a method, map it to
        // parent's — for EVERY base, in declaration order, not just the first.
        // This loop used to run once against parents[0], which is why
        // `class Duck extends Flyable, Swimmable, Walkable` got a Duck__fly
        // forwarder and nothing for swim or walk: `d.swim()` then failed with
        // "type 'Duck' has no method 'swim'". Earlier bases win ties, since
        // str_in_list(child_methods, ...) sees names pushed by previous
        // iterations — the same first-wins rule an override already had.
        var ppi: Float = 0
        while (ppi < parents.length()) {
        var cur_parent: String = parents[ppi]
        if (this.class_methods.has(cur_parent)) {
            var parent_methods: List = this.class_methods.get(cur_parent)
            // Which of this base's methods are bodyless. There is nothing to
            // forward *to* for those, and claiming the name would shadow a real
            // body on a later base: `class Both extends Requires, Provides`,
            // Requires.compute() bodyless and Provides.compute() concrete, forwarded
            // Both__compute to Requires__compute and b.compute() returned 0.
            var cur_abstract: List<String> = []
            if (this.class_abstract_methods.has(cur_parent)) {
                cur_abstract = this.class_abstract_methods.get(cur_parent)
            }
            var child_methods: List = this.class_methods.get(name)
            var i: Int = 0
            while (i < parent_methods.length()) {
                var mname: String = parent_methods[i]
                var forward_method: Bool = !this.str_in_list(child_methods,mname)
                if (this.str_in_list(cur_abstract, mname)) { forward_method = false }
                if (mname == "init") {
                    // Only the primary base's constructor may be forwarded. A
                    // secondary base's fields are NOT prepended to the child (see
                    // the layout note above), so its init would write the child's
                    // inherited-from-parents[0] slots at its own field indices.
                    if (ppi > 0) { forward_method = false }
                    // `init` used to be excluded here, which meant a child that
                    // declares no constructor of its own got no Child__init at
                    // all. The call site in gen_call only emits the __init call
                    // when it is a known function, so `Child("Rex")` compiled to
                    // a bare `call @Child()` with every argument silently
                    // dropped; the fields stayed zero and the first field read
                    // through an inherited method segfaulted.
                    //
                    // Forwarding is safe because the parent's fields are
                    // prepended to the child's, so parent field index i is also
                    // child field index i and all fields are i64. The one case
                    // where that does not hold is an actor inheriting from a
                    // non-actor: the actor gets two hidden fields prepended,
                    // shifting every inherited index by two.
                    if (this.actor_classes.has(name) and !this.actor_classes.has(cur_parent)) {
                        forward_method = false
                    }
                    // Without a known arity we cannot emit matching parameters,
                    // and a forwarder with the wrong arity is worse than none.
                    if (!this.called_function_arity.has(this.current_prefix + cur_parent + "__init")) {
                        forward_method = false
                    }
                }
                if (forward_method) {
                    // Register parent method as callable on child
                    child_methods.push(mname)
                    // Map ChildClass__method to ParentClass__method
                    var child_full: String = name + "__" + mname
                    var parent_full: String = cur_parent + "__" + mname
                    if (this.func_ret_types.has(parent_full)) {
                        this.func_ret_types.set(child_full, this.func_ret_types.get(parent_full))
                    } else {
                        this.func_ret_types.set(child_full, this.str_to_type("Int"))
                    }
                    this.known_functions.push(child_full)
                    // Emit a thin forwarder with proper parameter forwarding
                    var fwd_params_def: String = "i64 %self"
                    var fwd_params_call: String = "i64 %self"
                    var arity_key: String = this.current_prefix + parent_full
                    var fwd_arity: Float = 1
                    if (this.called_function_arity.has(arity_key)) {
                        var arity: Float = this.called_function_arity.get(arity_key)
                        fwd_arity = arity
                        var pi2: Float = 1
                        while (pi2 < arity) {
                            fwd_params_def = fwd_params_def + ", i64 %p" + pi2.floor().to_string()
                            fwd_params_call = fwd_params_call + ", i64 %p" + pi2.floor().to_string()
                            pi2 = pi2 + 1
                        }
                    }
                    // Register the forwarder's own arity, or a grandchild that
                    // inherits through it gets none: the init-forwarding guard
                    // (line 384) checks called_function_arity for the immediate
                    // parent, and a two-level chain (Puppy -> Dog -> Animal)
                    // would break at the second level, dropping constructor
                    // arguments and leaving fields zero (BUGS #87). Set both the
                    // bare and prefixed keys, matching gen_class_method.
                    this.called_function_arity.set(child_full, fwd_arity)
                    if (this.current_prefix.length() > 0) {
                        this.called_function_arity.set(this.current_prefix + child_full, fwd_arity)
                    }
                    // Both symbols must carry the module prefix, exactly as
                    // gen_function does for every other class symbol (output_body.sf:2
                    // — emit_name = current_prefix + name). This is the one site that
                    // emitted a class symbol without going through it, so a module
                    // class inheriting from another module class defined `@Sub__init`
                    // and called `@Base__init` while the real bodies were
                    // `@m3_Base__init`: `opt` rejected the IR with "use of undefined
                    // value '@Base__init'" and, because that is a compiler-bug path
                    // rather than a diagnostic, the program never ran (BUGS #151).
                    // Register the prefix mapping too, so a call site that resolves
                    // the bare name reaches the emitted symbol.
                    // Resolve each class through class_struct_names rather than
                    // pasting current_prefix on: the parent may live in a DIFFERENT
                    // module than the child, in which case the child's prefix is the
                    // wrong one for it. That table is the same resolution the
                    // hierarchy registration above (class_parent_of) uses, so the
                    // symbol and the dispatch tables agree.
                    var fwd_child_c: String = name
                    if (this.class_struct_names.has(name)) { fwd_child_c = this.class_struct_names.get(name) }
                    var fwd_parent_c: String = cur_parent
                    if (this.class_struct_names.has(cur_parent)) { fwd_parent_c = this.class_struct_names.get(cur_parent) }
                    var fwd_child_sym: String = fwd_child_c + "__" + mname
                    var fwd_parent_sym: String = fwd_parent_c + "__" + mname
                    if (fwd_child_sym != child_full) {
                        this.known_functions.push(fwd_child_sym)
                        this.func_prefix_map.set(child_full, fwd_child_sym)
                    }
                    this.emit("")
                    this.emit("define i64 @" + fwd_child_sym + "(" + fwd_params_def + ") {")
                    this.emit("entry:")
                    this.emit("  %r = call i64 @" + fwd_parent_sym + "(" + fwd_params_call + ")")
                    this.emit("  ret i64 %r")
                    this.emit("}")
                }
                i = i + 1
            }
        }
        ppi = ppi + 1
        }
        // Conformance: only a base's ABSTRACT (bodyless) methods are
        // requirements. Previously this keyed off "parent has no fields" as a
        // proxy for "parent is an interface", then demanded every parent method
        // be redeclared — which rejected legitimate inheritance from a
        // fieldless base class and forced implementors to copy interface
        // default-method bodies. child_methods has had every inherited name
        // pushed into it above, so a method inherited from a grandparent
        // correctly counts as satisfying the requirement.
        //
        // This runs in a SECOND loop, after all forwarding, not interleaved with
        // it. Interleaved, `class C extends Abstract, Provider` — Abstract
        // declares `foo` bodyless, Provider supplies a body — would be checked
        // against Abstract before Provider's foo had been forwarded, and report a
        // requirement that is in fact satisfied. That combination is a large part
        // of why multiple bases are worth having.
        var cpi: Float = 0
        while (cpi < parents.length()) {
            var conf_parent: String = parents[cpi]
            if (this.class_abstract_methods.has(conf_parent)) {
                var have: List = []
                if (this.class_methods.has(name)) { have = this.class_methods.get(name) }
                var required_methods: List = this.class_abstract_methods.get(conf_parent)
                var pi: Int = 0
                while (pi < required_methods.length()) {
                    var required: String = required_methods[pi]
                    if (required != "init" and !this.str_in_list(have,required)) {
                        IO.println("Error: class " + name + " does not implement " + conf_parent + "." + required + "()")
                    }
                    pi = pi + 1
                }
            }
            cpi = cpi + 1
        }
    }

    fun gen_class_decl(name: String, fields: String, methods: List<AST.Stmt>) {
        // Use module-prefixed type name to avoid cross-module class name collisions
        var type_name: String = name
        if (this.current_prefix.length() > 0) {
            type_name = this.current_prefix + name
        }
        this.class_fields.set(name, fields)
        this.class_struct_names.set(name, type_name)
        if (this.current_prefix.length() > 0) {
            this.class_fields.set(type_name, fields)
            this.class_struct_names.set(type_name, type_name)
        }

        // Parse field names for struct layout
        var field_list: List<String> = []
        var field_entries: List<String> = []
        var i: Float = 0
        if (fields.length() > 0) {
            var parts: List<String> = this.split_respecting_generics(fields, ",")
            while (i < parts.length()) {
                var fp: List<String> = parts[i].split(":")
                field_list.push(fp[0])
                field_entries.push(parts[i])
                i = i + 1
            }
        }
        // Store structured field list (each entry is "name:type")
        this.class_field_list.set(name, field_entries)
        if (this.current_prefix.length() > 0) {
            this.class_field_list.set(type_name, field_entries)
        }

        // Emit struct type: { i64 field0, i64 field1, ... }
        var num_fields: Float = field_list.length()
        if (!this.register_only and !this.str_in_list(this.known_functions,"__type_" + type_name)) {
            this.known_functions.push("__type_" + type_name)
            var field_types_str: String = ""
            var fi: Float = 0
            while (fi < num_fields) {
                if (fi > 0) { field_types_str = field_types_str + ", " }
                field_types_str = field_types_str + "i64"
                fi = fi + 1
            }
            this.type_defs.append("%" + type_name + " = type { " + field_types_str + " }\n")
        }

        // Register method names
        var method_names: List<String> = []
        var abstract_method_names: List<String> = []
        i = 0
        while (i < methods.length()) {
            var reg_mname: String = this.get_fun_name(methods[i])
            method_names.push(reg_mname)
            // Bodyless == abstract == a requirement on subclasses.
            if (this.get_fun_body(methods[i]).length() == 0) {
                abstract_method_names.push(reg_mname)
            }
            i = i + 1
        }
        this.class_methods.set(name, method_names)
        this.class_abstract_methods.set(name, abstract_method_names)

        // Pre-register all method return types so forward references resolve correctly
        i = 0
        while (i < methods.length()) {
            var mname: String = this.get_fun_name(methods[i])
            var mret: AST.Type = this.get_fun_ret(methods[i])
            var full_name: String = name + "__" + mname
            var prefixed_full: String = this.current_prefix + full_name
            var mret_reg: AST.Type = this.ret_type_for_registration(mret)
            this.func_ret_types.set(prefixed_full, mret_reg)
            this.func_ret_types.set(full_name, mret_reg)
            this.known_functions.push(prefixed_full)
            this.known_functions.push(full_name)
            this.func_prefix_map.set(full_name, prefixed_full)
            i = i + 1
        }

        // Pre-register constructor so methods can call ClassName(args)
        this.known_functions.push(type_name)
        if (this.current_prefix.length() > 0) {
            this.known_functions.push(name)
        }
        // BUGS #161: the prefixed constructor (ta_Marker) must return the
        // PREFIXED type, not the bare name. An inferred `var m = TargetA.Marker(x)`
        // takes its type from this entry; recording the bare `Marker` there loses
        // the module identity, so `m.describe()` fell through to the ambiguous
        // last-writer-wins bare lookup in resolve_class_type and bound the wrong
        // module's method. The bare `name` key stays bare — it serves callers that
        // know only the unqualified name, which is inherently the ambiguous case.
        this.func_ret_types.set(type_name, this.str_to_type(type_name))
        this.func_ret_types.set(name, this.str_to_type(name))

        // Generate methods as functions with name prefix: ClassName__method
        // Methods get 'self' (i64 pointer to instance) as first param
        this.current_class = type_name
        i = 0
        while (i < methods.length()) {
            this.gen_class_method(name, methods[i])
            i = i + 1
        }

        // Generate constructor function: ClassName(args...) -> instance ptr
        this.gen_class_constructor(type_name, fields, field_list)
    }

    fun get_fun_name(stmt: AST.Stmt): String {
        return match (stmt) { FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => n
            _ => ""
        }
    }

    fun get_fun_params(stmt: AST.Stmt): List<AST.Param> {
        return match (stmt) { FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => p
            _ => []
        }
    }

    /// The declared return type of a FunDecl, as a node.
    ///
    /// Every caller used to take the String this returned and immediately hand it
    /// to `str_to_type`, so the migration to `AST.Type` deleted a round-trip
    /// rather than adding one. The non-FunDecl fallback is UnknownType, which is
    /// also what callers now test instead of the old `ret.length() > 0` — an
    /// emptiness probe that could not tell "not a function" from "no annotation".
    fun get_fun_ret(stmt: AST.Stmt): AST.Type {
        return match (stmt) { FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => r
            _ => AST.Type.UnknownType
        }
    }

    fun get_fun_body(stmt: AST.Stmt): List<AST.Stmt> {
        return match (stmt) { FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => b
            _ => ""
        }
    }

    fun gen_class_method(class_name: String, method: AST.Stmt) {
        var mname: String = this.get_fun_name(method)
        var mparams: List<AST.Param> = this.get_fun_params(method)
        var mret: AST.Type = this.get_fun_ret(method)
        var mbody: List<AST.Stmt> = this.get_fun_body(method)
        var mdoc: String = this.get_fun_doc(method)
        var full_name: String = class_name + "__" + mname
        // Mark method for alwaysinline if annotated with @inline
        if (mdoc.starts_with("@inline")) {
            var inline_emit: String = this.current_prefix + full_name
            this.inline_funcs.push(inline_emit)
            this.inline_funcs.push(full_name)
        }
        var mparams_str: String = this.params_to_string(mparams)
        var full_params: String = "self:Int"
        if (mparams_str.length() > 0) {
            full_params = full_params + "," + mparams_str
        }
        var param_count: Float = 1
        if (mparams_str.length() > 0) {
            param_count = this.split_respecting_generics(mparams_str, ",").length() + 1
        }
        this.called_function_arity.set(full_name, param_count)
        if (this.current_prefix.length() > 0) {
            this.called_function_arity.set(this.current_prefix + full_name, param_count)
        }
        // Register param names for named arg dispatch (self + method params)
        var method_param_names: List<String> = []
        method_param_names.push("self")
        var mpi: Float = 0
        while (mpi < mparams.length()) {
            var mp: AST.Param = mparams[mpi]
            var mpn: String = match (mp) { Param(n, t, d, p_vis, __ns) => n }
            method_param_names.push(mpn)
            mpi = mpi + 1
        }
        this.func_param_names.set(full_name, method_param_names)
        if (this.current_prefix.length() > 0) {
            this.func_param_names.set(this.current_prefix + full_name, method_param_names)
        }
        // Register defaults for class methods
        var method_defaults: List<AST.Expr> = []
        method_defaults.push(AST.Expr.NilLit)
        mpi = 0
        while (mpi < mparams.length()) {
            var mp: AST.Param = mparams[mpi]
            var mdval: AST.Expr = match (mp) { Param(n, t, d, p_vis, __ns) => d }
            method_defaults.push(mdval)
            mpi = mpi + 1
        }
        this.func_defaults.set(full_name, method_defaults)
        if (this.current_prefix.length() > 0) {
            this.func_defaults.set(this.current_prefix + full_name, method_defaults)
        }
        this.func_param_count.set(full_name, param_count)
        if (this.current_prefix.length() > 0) {
            this.func_param_count.set(this.current_prefix + full_name, param_count)
        }
        this.gen_function(full_name, full_params, mret, mbody)
    }

    fun gen_class_constructor(type_name: String, fields: String, field_list: List<String>) {
        var num_fields: Float = field_list.length()
        var struct_size: Float = num_fields * 8
        this.known_functions.push(type_name)
        this.func_ret_types.set(type_name, this.str_to_type(type_name))
        // Assign a unique type ID for reflection (tags >= 10 are per-class)
        if (!this.class_type_ids.has(type_name)) {
            this.class_type_ids.set(type_name, this.next_class_type_id)
            this.next_class_type_id = this.next_class_type_id + 1
        }
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,type_name)) { return }
        this.defined_funcs.push(type_name)
        this.emit("")
        var ctor_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            ctor_linkage = "define"
        }
        this.emit(ctor_linkage + " i64 @" + type_name + "() {")
        this.emit("entry:")
        this.block_terminated = false
        // Allocate instance on GC-tracked heap with per-class type tag
        var class_tag: Float = this.class_type_ids.get(type_name)
        var raw: String = this.fresh_local()
        if (this.identity_mode) {
            this.emit_indent(raw + " = call i8* @__sf_malloc(i64 " + struct_size.floor().to_string() + ")")
        } else {
            this.emit_indent(raw + " = call i64 @__gc_alloc(i64 " + struct_size.floor().to_string() + ", i64 " + class_tag.floor().to_string() + ")")
        }
        var ptr: String = ""
        if (this.identity_mode) {
            ptr = this.fresh_local()
            this.emit_indent(ptr + " = bitcast i8* " + raw + " to %" + type_name + "*")
        } else {
            ptr = this.fresh_local()
            this.emit_indent(ptr + " = inttoptr i64 " + raw + " to %" + type_name + "*")
        }
        // Zero-initialize fields
        var i: Float = 0
        while (i < num_fields) {
            var field_ptr: String = this.fresh_local()
            this.emit_indent(field_ptr + " = getelementptr %" + type_name + ", %" + type_name + "* " + ptr + ", i32 0, i32 " + i.floor().to_string())
            this.emit_indent("store i64 0, i64* " + field_ptr)
            i = i + 1
        }
        // Return as i64
        var result: String = this.typed_ptr_to_val(ptr, "%" + type_name + "*")
        this.emit_terminator("ret i64 " + result)
        this.emit("}")
        this.block_terminated = false
    }

    // Assign the GC type tag of a payload-carrying enum, from the same counter
    // as class_type_ids (BUGS #154).
    //
    // Called from every place that registers an enum — gen_enum_decl,
    // register_enum_variants, and the four prescans — for the reason
    // class_type_ids is: a value is constructed in source order, but the tag
    // must already exist when gen_enum_construct emits the __gc_alloc, and an
    // enum declared below its first use would otherwise allocate with tag 0.
    // Idempotent, same key, same value, exactly like the class writes.
    //
    // Requires enum_variant_fields to be populated first, since get_max_fields
    // reads it — every caller does that immediately before.
    //
    // A fieldless enum gets NO tag, and that is the whole shape of the
    // half-fix: its value is the bare immediate `tag << 56`, with no allocation
    // to carry a header, so there is nothing for __val_class_tag to read. It
    // keeps printing its bit pattern. Guessing from the bit pattern was
    // deliberately rejected for #115 and is rejected here for the same reason —
    // mistaking a real double for an enum is worse than visible garbage.
    fun register_enum_tag(name: String) {
        if (this.enum_type_ids.has(name)) { return }
        if (this.get_max_fields(name) == 0) { return }
        // The tag is 8 bits wide: __gc_pack_info stores `tag << 8` and
        // __gc_info_tag reads it back with `and 255`, so 256 would come back as
        // 0 and 266 as 10 — a silent collision with the first class. Refuse to
        // register past the end instead: an unregistered enum allocates with
        // __sf_malloc and prints its bit pattern, which is the behaviour before
        // this change rather than a wrong to_string call.
        if (this.next_class_type_id > 255) { return }
        this.enum_type_ids.set(name, this.next_class_type_id)
        this.next_class_type_id = this.next_class_type_id + 1
    }

    // Allocate the `[tag, f0, ...]` payload array of an enum and return it as a
    // typed `[N x i64]*`. The one place the heap encoding is allocated, so the
    // GC-header decision is made once for gen_enum_construct's two sites and
    // emit_enum_constructor's.
    //
    // __gc_alloc rather than __sf_malloc, so the value carries a header and
    // __val_class_tag can name it — which is what lets __val_to_string format an
    // enum reached through `Any` (BUGS #154). This is a representation change,
    // not a formatting one: the payload array grows a 24-byte header (16 on
    // wasm32) and becomes GC-traced. Tracing needs nothing new — __gc_mark_drain
    // routes any tag >= 10 to trace_instance, which scans size/8 slots as
    // values, and slot 0 (the small variant tag) is rejected by
    // __gc_is_heap_ptr's alignment/4 GB guards, so the scan is already correct
    // for this shape.
    //
    // What this does expose: a payload enum becomes sweepable where it was
    // previously an un-freed malloc, so it joins class instances in depending on
    // shadow-stack rooting. is_gc_root_type roots every non-numeric local
    // including the unannotated ones, and the collector is non-moving, so the
    // remaining hole is the same one class instances already have — a live object
    // held only in an LLVM SSA temp across an allocating call is not a root
    // (BUGS #63). Enums are not a new case of that; they are a new instance of
    // it.
    //
    // The result stays a BARE pointer, never NaN-tagged. ensure_enum_eq's
    // shape check bails to "unequal" unless both operands' `lshr 48` is 0, so
    // tagging an enum here would break `==` on every payload enum.
    //
    // identity_mode keeps __sf_malloc, the same gate emit_reflect_helpers and
    // emit_class_hierarchy_helpers use: base.ll's __gc_alloc is a weak stub that
    // mallocs and drops the tag, so there would be no header to read and nothing
    // to gain. Consequence worth naming — the bootstrap compiles the compiler in
    // identity mode, so it never exercises this path. Test with a user program
    // built by gen3.
    fun emit_enum_payload_alloc(enum_name: String, num_slots: Float): String {
        var arr_bytes: Float = num_slots * 8
        var arr_type: String = "[" + num_slots.floor().to_string() + " x i64]*"
        // No tag means a fieldless enum (or the >255 refusal in
        // register_enum_tag): allocate as before. gen_enum_construct can reach
        // this via its "max_fields==0 but args>0" fall-through.
        if (this.identity_mode or !this.enum_type_ids.has(enum_name)) {
            var arr_raw: String = this.fresh_local()
            this.emit_indent(arr_raw + " = call i8* @__sf_malloc(i64 " + arr_bytes.floor().to_string() + ")")
            var arr_ptr: String = this.fresh_local()
            this.emit_indent(arr_ptr + " = bitcast i8* " + arr_raw + " to " + arr_type)
            return arr_ptr
        }
        var etag: Float = this.enum_type_ids.get(enum_name)
        var gc_raw: String = this.fresh_local()
        this.emit_indent(gc_raw + " = call i64 @__gc_alloc(i64 " + arr_bytes.floor().to_string() + ", i64 " + etag.floor().to_string() + ")")
        return this.val_to_typed_ptr(gc_raw, arr_type)
    }

    fun get_variant_name(v: AST.Variant): String {
        return match (v) { Variant(n, f, __ns) => n
            _ => ""
        }
    }

    fun get_variant_fields(v: AST.Variant): String {
        return match (v) { Variant(n, f, __ns) => f
            _ => ""
        }
    }

    fun register_variant(name: String, variant_names: List<String>, v: AST.Variant, idx: Float) {
        var vname: String = this.get_variant_name(v)
        var vfields: String = this.get_variant_fields(v)
        variant_names.push(vname)
        this.enum_variant_tags.set(name + "." + vname, idx)
        this.enum_variant_fields.set(name + "." + vname, vfields)
    }

    fun gen_enum_decl(name: String, variants: List<AST.Variant>) {
        var variant_names: List<String> = []
        var i: Float = 0
        while (i < variants.length()) {
            this.register_variant(name, variant_names, variants[i], i)
            i = i + 1
        }
        this.enum_defs.set(name, variant_names)
        this.register_enum_tag(name)
        if (!this.register_only and !this.str_in_list(this.known_functions,"__type_" + name)) {
            this.known_functions.push("__type_" + name)
            this.type_defs.append("%" + name + " = type { i8, [16 x i8] }\n")
        }

        // Emit constructor functions for variants with fields
        var max_fields: Float = this.get_max_fields(name)
        i = 0
        while (i < variants.length()) {
            var v: AST.Variant = variants[i]
            var vname: String = match (v) { Variant(n, f, __ns) => n
                _ => ""
            }
            var vfields: String = match (v) { Variant(n, f, __ns) => f
                _ => ""
            }
            if (vfields.length() > 0) {
                this.emit_enum_constructor(vname, i, vfields, max_fields, name)
            }
            i = i + 1
        }

        // Emit to_string function for this enum
        this.emit_enum_to_string(name, variants)
    }

    fun emit_enum_to_string(name: String, variants: List<AST.Variant>) {
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,name + "__to_string")) { return }
        this.defined_funcs.push(name + "__to_string")
        var max_fields: Float = this.get_max_fields(name)
        var func_name: String = name + "__to_string"

        this.emit("")
        var ts_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            ts_linkage = "define"
        }
        this.emit(ts_linkage + " i64 @" + func_name + "(i64 %self) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()

        // Extract tag based on encoding.
        //
        // The threshold is `== 0`, not `<= 1`. gen_enum_construct (expr_body.sf)
        // and gen_match (match_body.sf) both switch to the heap [tag, f0, ...]
        // array as soon as ANY variant has a field, so a one-field enum is an
        // array too. This used to read `<= 1` and so decoded a one-field enum's
        // heap pointer as a `tag << 56` immediate: `lshr ptr, 56` yields 0 for
        // any real pointer, which is variant 0's tag, so every value of such an
        // enum stringified as its FIRST variant regardless of what it was, and
        // the "payload" it printed was the low 56 bits of the pointer.
        // A slot to hold the StringBuilder across the appends, so it can be a GC
        // ROOT rather than an SSA temporary.
        //
        // This is BUGS #63's shape, and it bit here specifically because this
        // function allocates on every field: __sb_append can grow the buffer, and
        // a nested-enum field calls another to_string that allocates a whole
        // subtree of StringBuilders. The accumulator `sb` lived only in an LLVM
        // register across all of that, so a collection triggered mid-format
        // reclaimed the very buffer being appended to. The symptom was not a crash
        // but a plausible-looking short string: `Pair(Pair(Leaf(1)...` came back as
        // `1)))))`, because the buffer was freed and partly rewritten while the
        // remaining appends carried on into it. Depth 1-3 were correct and depth 4+
        // corrupt purely because that is where allocation crossed the 64KB
        // threshold — which is why this looked like a nesting-depth limit.
        //
        // Classes never showed it: a user-written `to_string()` keeps its
        // intermediates in real locals, and output_body.sf already allocas and
        // pushes those as roots. Only this GENERATED formatter held its
        // accumulator in a register, which is the asymmetry that located the bug.
        //
        // identity_mode is excluded because it has no GC at all (its __gc_alloc is
        // a plain malloc), and max_fields == 0 because a fieldless enum's arms
        // return a string constant without building anything.
        // `%self` needs a root slot of its own, for the same reason and one level
        // out. The payload array being formatted is reachable only through this
        // parameter: an i64 argument is not an alloca, so output_body.sf's
        // param-rooting loop (which pushes the ADDRESS of a param's slot) has
        // nothing to push here. A collection triggered by any append therefore
        // reclaims the array whose fields are still being read, and the next
        // `load i64, i64* %self`-derived slot reads 0 — which is exactly the
        // EXC_BAD_ACCESS at `L__to_string + 16` (`ldr x8, [x0]` with x0 = 0) that a
        // nested enum produced at depth 4.
        //
        // This was invisible before payload enums had GC headers: an __sf_malloc
        // array is never reclaimed, so an unrooted pointer to one is harmless. It is
        // not a new bug so much as one that only becomes reachable once the value
        // is collectable at all, which is the cost side of the #154 fix and belongs
        // to it.
        var self_slot: String = ""
        if (max_fields > 0 and !this.identity_mode) {
            self_slot = this.fresh_local()
            this.emit_indent(self_slot + " = alloca i64")
            this.emit_indent("store i64 %self, i64* " + self_slot)
            var self_root: String = this.typed_ptr_to_val(self_slot, "i64*")
            this.emit_indent("call void @__gc_push_root(i64 " + self_root + ")")
            this.called_functions.push("__gc_push_root")
        }

        var sb_slot: String = ""
        if (max_fields > 0 and !this.identity_mode) {
            sb_slot = this.fresh_local()
            this.emit_indent(sb_slot + " = alloca i64")
            this.emit_indent("store i64 0, i64* " + sb_slot)
        }

        var tag_val: String = ""
        if (max_fields == 0) {
            tag_val = this.fresh_local()
            this.emit_indent(tag_val + " = lshr i64 %self, 56")
        } else {
            var arr_ptr: String = this.val_to_typed_ptr("%self", "i64*")
            tag_val = this.fresh_local()
            this.emit_indent(tag_val + " = load i64, i64* " + arr_ptr)
        }

        // Build switch on tag
        var end_label: String = this.fresh_label("ets.end")
        var arm_labels: List<String> = []
        var i: Float = 0
        while (i < variants.length()) {
            arm_labels.push(this.fresh_label("ets.v"))
            i = i + 1
        }

        var switch_cases: String = ""
        i = 0
        while (i < variants.length()) {
            switch_cases = switch_cases + " i64 " + i.floor().to_string() + ", label %" + arm_labels[i]
            i = i + 1
        }
        this.emit_indent("switch i64 " + tag_val + ", label %" + end_label + " [" + switch_cases + " ]")
        this.block_terminated = true

        // Emit each variant arm
        i = 0
        while (i < variants.length()) {
            var v: AST.Variant = variants[i]
            var vname: String = this.get_variant_name(v)
            var vfields: String = this.get_variant_fields(v)

            this.start_block(arm_labels[i])

            if (vfields.length() == 0) {
                // No fields: just return "VariantName"
                var const_name: String = this.add_string_constant(vname)
                var str_len: Float = vname.length() + 1
                var gep: String = this.fresh_local()
                this.emit_indent(gep + " = getelementptr [" + str_len.to_string() + " x i8], [" + str_len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
                var as_i64: String = this.ptr_to_val(gep)
                // A fieldless VARIANT of an enum that has payload variants still
                // took the self root above (the gate is max_fields, per enum), so
                // this exit has to balance it. Only self is pushed on this path —
                // the StringBuilder is never created here.
                if (self_slot.length() > 0) {
                    this.emit_indent("call void @__gc_pop_roots(i64 1)")
                    this.called_functions.push("__gc_pop_roots")
                }
                this.emit_terminator("ret i64 " + as_i64)
            } else {
                // Has fields: build "VariantName(field0, field1, ...)"
                var parts: List<String> = this.split_respecting_generics(vfields, ",")
                var num_fields: Float = parts.length()

                // Allocate StringBuilder via malloc + manual concat
                // Start with "VariantName("
                var prefix_str: String = vname + "("
                var prefix_const: String = this.add_string_constant(prefix_str)
                var prefix_len: Float = prefix_str.length() + 1
                var prefix_gep: String = this.fresh_local()
                this.emit_indent(prefix_gep + " = getelementptr [" + prefix_len.to_string() + " x i8], [" + prefix_len.to_string() + " x i8]* " + prefix_const + ", i64 0, i64 0")
                var prefix_i64: String = this.ptr_to_val(prefix_gep)

                // Create a StringBuilder, append prefix.
                //
                // The push has to happen BEFORE the first append, not after the
                // loop: __sb_append itself allocates, so a window of even one
                // append is enough to lose the builder. Rooting is the address of
                // the slot, so the collector re-reads it each cycle.
                var sb: String = this.fresh_local()
                this.emit_indent(sb + " = call i64 @StringBuilder()")
                if (sb_slot.length() > 0) {
                    this.emit_indent("store i64 " + sb + ", i64* " + sb_slot)
                    var sb_root: String = this.typed_ptr_to_val(sb_slot, "i64*")
                    this.emit_indent("call void @__gc_push_root(i64 " + sb_root + ")")
                    this.called_functions.push("__gc_push_root")
                }
                this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + prefix_i64 + ")")

                // For each field, extract, convert to string, append
                var fi: Float = 0
                while (fi < num_fields) {
                    // Extract field value
                    var field_val: String = ""
                    if (max_fields == 0) {
                        // Simple encoding: value = self & 0x00FFFFFFFFFFFFFF.
                        // Unreachable in practice — max_fields == 0 means no
                        // variant has a field, so num_fields is 0 and this loop
                        // never runs. Kept as the mirror of the tag read above.
                        field_val = this.fresh_local()
                        this.emit_indent(field_val + " = and i64 %self, 72057594037927935")
                    } else {
                        // Array encoding: fields start at index 1
                        var num_slots: Float = num_fields + 1
                        var total_str: String = num_slots.floor().to_string()
                        var f_arr: String = this.val_to_typed_ptr("%self", "[" + total_str + " x i64]*")
                        var field_idx: Float = fi + 1
                        var f_slot: String = this.fresh_local()
                        this.emit_indent(f_slot + " = getelementptr [" + total_str + " x i64], [" + total_str + " x i64]* " + f_arr + ", i64 0, i64 " + field_idx.floor().to_string())
                        field_val = this.fresh_local()
                        this.emit_indent(field_val + " = load i64, i64* " + f_slot)
                    }

                    // Determine field type and convert to string
                    var field_part: String = parts[fi]
                    var field_type: String = "Int"
                    if (field_part.contains(":")) {
                        var ft_parts: List<String> = field_part.split(":")
                        if (ft_parts.length() > 1) {
                            field_type = ft_parts[1]
                        }
                    }

                    // The payload slot holds a fully NaN-boxed value —
                    // gen_enum_construct stores gen_arg_value's result verbatim —
                    // while __sb_append takes a RAW char* (it calls strlen on it,
                    // through an @extern, so every argument must be untagged).
                    // Each arm below is responsible for landing on a raw pointer.
                    //
                    // Two of the three arms used to get this wrong. A String field
                    // was appended still tagged, so strlen dereferenced
                    // 0x7FF8_0000_0000_0000|ptr and the process died — printing any
                    // enum carrying a String was a segfault. A Bool field was
                    // handed to __bool_to_string without untagging, and that helper
                    // tests `!= 0` against a raw 0/1 on three of the four bases, so
                    // tagged `false` (0x7FFA000000000000, nonzero) read as true:
                    // every Bool field printed "true". Float had no arm at all and
                    // fell into __int_to_string via emit_untag_int, which reads a
                    // double's bits as an integer.
                    //
                    // The arm list is also the whole of the type coverage, and it
                    // was missing List, Map and nested enum (BUGS #108). Those
                    // three fell into the final `else`, which untags the payload as
                    // an integer and formats it with __int_to_string — so a List
                    // payload printed its heap ADDRESS in decimal, varying between
                    // runs of one unchanged binary, and a nested enum printed the
                    // low bits of its `tag << 56` immediate as 0. A String payload
                    // is a heap pointer too and printed fine, which is what showed
                    // this was a missing-formatter list rather than an inability to
                    // handle heap payloads.
                    //
                    // The three arms added below call the SAME helpers the ordinary
                    // `.to_string()` dispatch in methods_body.sf uses for these
                    // types — __list_to_string, __map_to_string, and the payload
                    // enum's own generated to_string. All three already return a
                    // raw char*, which is exactly what __sb_append wants, so no
                    // tag/untag step belongs on any of them. Routing through
                    // __any_to_string was the alternative and is deliberately not
                    // taken: it does not exist in wasm_base.ll, and a static type
                    // is in hand here so the runtime dispatch buys nothing.
                    var field_str: String = ""
                    if (field_type == "String") {
                        var s_ptr: String = this.emit_untag_ptr(field_val)
                        field_str = this.ptr_to_val(s_ptr)
                    } else if (field_type.starts_with("List")) {
                        // __list_to_string accepts the value as stored: a list
                        // literal reaches the payload slot as __list_new's raw
                        // pointer, and the helper inttoptr's whatever it is given
                        // — the same call shape as `"${a_list}"` on a bare local.
                        this.called_functions.push("__list_to_string")
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__list_to_string(i64 " + field_val + ")")
                    } else if (field_type.starts_with("Map")) {
                        this.called_functions.push("__map_to_string")
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__map_to_string(i64 " + field_val + ")")
                    } else if (this.enum_defs.has(field_type)) {
                        // A nested enum formats itself. Its generated to_string
                        // knows its own encoding — `tag << 56` for a fieldless
                        // enum, the heap array otherwise — which is the whole
                        // reason this cannot be open-coded here.
                        var nested_ts: String = field_type + "__to_string"
                        this.called_functions.push(nested_ts)
                        this.called_function_arity.set(nested_ts, 1)
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @" + nested_ts + "(i64 " + field_val + ")")
                    } else if (field_type == "Bool") {
                        var b_raw: String = this.emit_untag_bool(field_val)
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__bool_to_string(i64 " + b_raw + ")")
                    } else if (field_type == "Float" or field_type == "Number") {
                        // __float_to_string takes the tagged value: it untags
                        // internally and its int-tagged path is a sitofp, so a
                        // whole-number Float that happens to be int-tagged still
                        // formats correctly (BUGS #83).
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__float_to_string(i64 " + field_val + ")")
                    } else {
                        var field_raw: String = this.emit_untag_int(field_val)
                        field_str = this.fresh_local()
                        this.emit_indent(field_str + " = call i64 @__int_to_string(i64 " + field_raw + ")")
                    }

                    this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + field_str + ")")

                    // Append ", " between fields
                    if (fi < num_fields - 1) {
                        var comma_const: String = this.add_string_constant(", ")
                        var comma_len: Float = 3
                        var comma_gep: String = this.fresh_local()
                        this.emit_indent(comma_gep + " = getelementptr [" + comma_len.to_string() + " x i8], [" + comma_len.to_string() + " x i8]* " + comma_const + ", i64 0, i64 0")
                        var comma_i64: String = this.ptr_to_val(comma_gep)
                        this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + comma_i64 + ")")
                    }

                    fi = fi + 1
                }

                // Append closing ")"
                var close_const: String = this.add_string_constant(")")
                var close_len: Float = 2
                var close_gep: String = this.fresh_local()
                this.emit_indent(close_gep + " = getelementptr [" + close_len.to_string() + " x i8], [" + close_len.to_string() + " x i8]* " + close_const + ", i64 0, i64 0")
                var close_i64: String = this.ptr_to_val(close_gep)
                this.emit_indent("call i64 @__sb_append(i64 " + sb + ", i64 " + close_i64 + ")")

                // Finalize. __sb_to_string reads the buffer out, so the builder has
                // to stay rooted through it; the pop goes between that read and the
                // return. Leaking a root would be worse than the bug being fixed —
                // the shadow stack is a stack, so an unbalanced push corrupts every
                // frame above it.
                var result: String = this.fresh_local()
                this.emit_indent(result + " = call i64 @__sb_to_string(i64 " + sb + ")")
                // Two roots on this path: self, then the builder. Pop both.
                if (sb_slot.length() > 0) {
                    this.emit_indent("call void @__gc_pop_roots(i64 2)")
                    this.called_functions.push("__gc_pop_roots")
                }
                this.emit_terminator("ret i64 " + result)
            }

            i = i + 1
        }

        // Default case (unreachable but needed)
        this.start_block(end_label)
        var empty_const: String = this.add_string_constant("Unknown")
        var empty_len: Float = 8
        var empty_gep: String = this.fresh_local()
        this.emit_indent(empty_gep + " = getelementptr [" + empty_len.to_string() + " x i8], [" + empty_len.to_string() + " x i8]* " + empty_const + ", i64 0, i64 0")
        var empty_i64: String = this.ptr_to_val(empty_gep)
        // The switch's default. Reachable only from a corrupt tag, but it is a real
        // `ret`, and an unbalanced shadow stack corrupts every frame above it — a
        // far worse failure than the "Unknown" it returns. So it balances too.
        if (self_slot.length() > 0) {
            this.emit_indent("call void @__gc_pop_roots(i64 1)")
            this.called_functions.push("__gc_pop_roots")
        }
        this.emit_terminator("ret i64 " + empty_i64)

        this.emit("}")
        this.block_terminated = false
        this.known_functions.push(func_name)
        this.func_ret_types.set(func_name, this.str_to_type("String"))
    }

    // `enum_name` is only used to look up the payload GC tag, but it has to be
    // passed rather than derived: this is keyed by VARIANT name, and a variant
    // name alone does not identify its enum.
    fun emit_enum_constructor(vname: String, tag: Float, fields_str: String, max_fields: Float, enum_name: String) {
        if (this.register_only) { return }
        if (this.str_in_list(this.defined_funcs,vname)) { return }
        this.defined_funcs.push(vname)
        var parts: List<String> = this.split_respecting_generics(fields_str, ",")
        var num_fields: Float = parts.length()

        // Build param list: (i64 %f0, i64 %f1, ...)
        var params: String = ""
        var pi: Float = 0
        while (pi < num_fields) {
            if (pi > 0) { params = params + ", " }
            params = params + "i64 %f" + pi.floor().to_string()
            pi = pi + 1
        }

        this.emit("")
        var ev_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            ev_linkage = "define"
        }
        this.emit(ev_linkage + " i64 @" + vname + "(" + params + ") {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()

        // `== 0`, matching gen_enum_construct and gen_match. This is only
        // reachable with at least one field (the caller guards on
        // `vfields.length() > 0`), so the simple-encoding branch is dead — but
        // it read `<= 1` and would have packed a one-field variant as
        // `tag << 56 | value`, which no reader decodes that way. Left in place
        // and corrected rather than deleted, so the three encoding decisions
        // read identically.
        if (max_fields == 0) {
            // Simple encoding: (tag << 56) | value
            var t: String = this.fresh_local()
            this.emit_indent(t + " = shl i64 " + tag.floor().to_string() + ", 56")
            var r: String = this.fresh_local()
            this.emit_indent(r + " = or i64 " + t + ", %f0")
            this.emit_terminator("ret i64 " + r)
        } else {
            // Array encoding: [tag, f0, f1, ...] — see emit_enum_payload_alloc
            // for why this is __gc_alloc outside identity mode.
            var num_slots: Float = num_fields + 1
            var arr: String = this.emit_enum_payload_alloc(enum_name, num_slots)
            // Store tag
            var ts: String = this.fresh_local()
            this.emit_indent(ts + " = getelementptr [" + num_slots.floor().to_string() + " x i64], [" + num_slots.floor().to_string() + " x i64]* " + arr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + ts)
            // Store fields
            var fi: Float = 0
            while (fi < num_fields) {
                var slot: String = this.fresh_local()
                var slot_idx: Float = fi + 1
                this.emit_indent(slot + " = getelementptr [" + num_slots.floor().to_string() + " x i64], [" + num_slots.floor().to_string() + " x i64]* " + arr + ", i64 0, i64 " + slot_idx.floor().to_string())
                this.emit_indent("store i64 %f" + fi.floor().to_string() + ", i64* " + slot)
                fi = fi + 1
            }
            var result: String = this.typed_ptr_to_val(arr, "[" + num_slots.floor().to_string() + " x i64]*")
            this.emit_terminator("ret i64 " + result)
        }

        this.emit("}")
        this.block_terminated = false
        this.known_functions.push(vname)
    }

    fun get_enum_decl_name(stmt: AST.Stmt): String {
        return match (stmt) { EnumDecl(n, v, d, e_vis, __ns, __fs) => n
            _ => ""
        }
    }

    fun get_enum_decl_variants(stmt: AST.Stmt): List<AST.Variant> {
        return match (stmt) { EnumDecl(n, v, d, e_vis, __ns, __fs) => v
            _ => ""
        }
    }

    fun register_external_enums(decls: List<AST.Stmt>) {
        var i: Float = 0
        while (i < decls.length()) {
            this.try_register_enum(decls[i])
            i = i + 1
        }
    }

    fun try_register_enum(decl: AST.Stmt) {
        match (decl) {
            EnumDecl(name, variants, doc, e_vis, __ns, __fs) => {
                this.register_enum_variants(name, variants)
            }
            VarDecl(n, t, i, d, v_vis, __ns, __fs) => {}
            FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => {}
            ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => {}
            If(c, t, e) => {}
            While(c, b) => {}
            Block(s) => {}
            ExprStmt(e) => {}
            Return(v) => {}
            Break => {}
            Continue => {}
            TryCatch(t, n, c, f) => {}
            Throw(v) => {}
            LetPattern(p, v) => {}
            TypeAlias(ta_n, ta_t, ta_vis) => {}
        }
    }

    fun register_enum_variants(name: String, variants: List<AST.Variant>) {
        var variant_names: List<String> = []
        var j: Float = 0
        while (j < variants.length()) {
            this.register_variant(name, variant_names, variants[j], j)
            j = j + 1
        }
        this.enum_defs.set(name, variant_names)
        this.register_enum_tag(name)
    }

    fun emit_block_alloca_for(stmt: AST.Stmt) {
        var vname: String = match (stmt) { VarDecl(n, t, init, d, v_vis, __ns, __fs) => n
            _ => ""
        }
        var vdoc: String = match (stmt) { VarDecl(n, t, init, d, v_vis, __ns, __fs) => d
            _ => ""
        }
        if (vdoc.starts_with("@import:")) { return }
        if (!this.typed_vars.has(vname) and !this.str_in_list(this.known_functions,"__alloc_" + vname)) {
            this.known_functions.push("__alloc_" + vname)
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_alloca("%" + this.sanitize_name(vname), "i64"))
            } else {
                this.emit_indent("%" + this.sanitize_name(vname) + " = alloca i64")
                this.verify_alloca("%" + this.sanitize_name(vname), "i64")
            }
        }
    }

    fun emit_block_allocas(stmts: List<AST.Stmt>) {
        var i: Float = 0
        while (i < stmts.length()) {
            var kind: String = this.classify_stmt(stmts[i])
            if (kind == "var") {
                this.emit_block_alloca_for(stmts[i])
            }
            i = i + 1
        }
    }

    fun gen_stmts(stmts: List<AST.Stmt>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.gen_stmt(stmts[i])
            i = i + 1
        }
    }

    fun to_i1(val: String): String {
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_trunc(local, val, "i64", "i1"))
            // LLVM lib parallel path: track trunc value
            if (!this.identity_mode and this.llvm_values.has(val)) {
                var val_v: Any = this.llvm_values.get(val)
                var tr_v: Any = this.llvm_block_builder.trunc(val_v, LLVMTypes.Type.I1)
                this.llvm_values.set(local, tr_v)
            }
        } else {
            this.emit_indent(local + " = trunc i64 " + val + " to i1")
            this.verify_trunc(local, val, "i64", "i1")
        }
        return local
    }

    fun gen_if(cond: AST.Expr, then_branch: List<AST.Stmt>, else_branch: List<AST.Stmt>) {
        var end_label: String = this.fresh_label("endif")
        var current_cond: AST.Expr = cond
        var current_then: List<AST.Stmt> = then_branch
        var current_else: List<AST.Stmt> = else_branch

        // LLVM lib parallel path: create end block upfront
        var llvm_end_bb: Any = nil
        if (!this.identity_mode and this.use_llvm_lib) {
            llvm_end_bb = this.llvm_func_builder.new_block(end_label)
        }

        // Iterative else-if chain to avoid deep C stack recursion
        while (true) {
            var cond_val: String = this.to_i1(this.gen_arg_value(current_cond))
            var then_label: String = this.fresh_label("then")
            var else_label: String = this.fresh_label("else")

            if (this.use_llvm_lib) {
                this.emit_terminator(this.lib_cond_br(cond_val, then_label, else_label))
                // LLVM lib parallel path: emit conditional branch and switch to then block
                if (!this.identity_mode and this.llvm_values.has(cond_val)) {
                    var cond_v: Any = this.llvm_values.get(cond_val)
                    this.llvm_block_builder.cond_br_labels_set(cond_v, then_label, else_label)
                    var llvm_then_bb: Any = this.llvm_func_builder.new_block(then_label)
                    this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_then_bb)
                    this.llvm_block_builder.init(this.llvm_func_builder, llvm_then_bb)
                }
            } else {
                this.emit_terminator("br i1 " + cond_val + ", label %" + then_label + ", label %" + else_label)
                this.verify_cond_br(cond_val, then_label, else_label)
            }

            this.start_block(then_label)
            this.gen_stmts(current_then)
            if (this.use_llvm_lib) {
                this.emit_terminator(this.lib_br(end_label))
                // LLVM lib parallel path: terminate then block, switch to else block
                if (!this.identity_mode) {
                    this.llvm_block_builder.br_label_set(end_label)
                    var llvm_else_bb: Any = this.llvm_func_builder.new_block(else_label)
                    this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_else_bb)
                    this.llvm_block_builder.init(this.llvm_func_builder, llvm_else_bb)
                }
            } else {
                this.emit_terminator("br label %" + end_label)
                this.verify_br(end_label)
            }

            this.start_block(else_label)

            // Check if else is a single If (else-if chain)
            var is_elseif: Bool = false
            if (current_else.length() == 1) {
                if (this.classify_stmt(current_else[0]) == "if") {
                    is_elseif = true
                }
            }
            if (is_elseif) {
                var nested: Any = current_else[0]
                current_cond = match (nested) { If(c, t, e) => c   _ => AST.Expr.NilLit }
                current_then = match (nested) { If(c, t, e) => t   _ => [] }
                current_else = match (nested) { If(c, t, e) => e   _ => [] }
                // Continue loop instead of recursing
            } else {
                // Final else or no else
                if (current_else.length() > 0) {
                    this.gen_stmts(current_else)
                }
                this.emit_terminator("br label %" + end_label)
                // LLVM lib parallel path: terminate else block, switch to end block
                if (!this.identity_mode and this.use_llvm_lib) {
                    this.llvm_block_builder.br_label_set(end_label)
                    this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_end_bb)
                    this.llvm_block_builder.init(this.llvm_func_builder, llvm_end_bb)
                }
                break
            }
        }

        this.start_block(end_label)
    }

        fun classify_stmt(stmt: AST.Stmt): String {
        return match (stmt) {
            If(c, t, e) => "if"
            ExprStmt(expr) => "expr"
            VarDecl(n, t, i, d, v_vis, __ns, __fs) => "var"
            FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => "fun"
            EnumDecl(n, v, d, e_vis, __ns, __fs) => "enum"
            ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => "class"
            Return(v) => "return"
            While(c, b) => "while"
            Block(s) => "block"
            Break => "break"
            Continue => "continue"
            TryCatch(t, n, c, f) => "try"
            Throw(v) => "throw"
            LetPattern(p, v) => "let_pattern"
            // A type alias is erased by the time codegen runs — resolve.sf has
            // already rewritten every use of the name. It still has to be named
            // here: `classify_stmt` returns one tag per variant, and until BUGS
            // #76 made the checker walk method bodies, a missing arm yielded an
            // indeterminate string rather than an error.
            TypeAlias(ta_n, ta_t, ta_vis) => "type_alias"
        }
    }

    fun is_if_stmt(stmt: AST.Stmt): Bool {
        var kind: Any = match (stmt) {
            If(c, t, e) => "if"
            ExprStmt(expr) => "other"
            VarDecl(n, t, i, d, v_vis, __ns, __fs) => "other"
            FunDecl(n, p, r, b, d, f_vis, __ns, __fs) => "other"
            EnumDecl(n, v, d, e_vis, __ns, __fs) => "other"
            ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => "other"
            Return(v) => "other"
            While(c, b) => "other"
            Block(s) => "other"
            Break => "other"
            Continue => "other"
            TryCatch(t, n, c, f) => "other"
            Throw(v) => "other"
            LetPattern(p, v) => "other"
            TypeAlias(ta_n, ta_t, ta_vis) => "other"
        }
        return kind == "if"
    }

    fun gen_let_pattern(pattern: AST.Pattern, value: AST.Expr) {
        var variant_name: String = match (pattern) {
            VariantPattern(v, b) => v
            ArrayPattern(e, r) => "__array:" + r
            _ => ""
        }
        var bindings: List<String> = match (pattern) {
            VariantPattern(v, b) => b
            ArrayPattern(e, r) => e
            _ => []
        }
        var val: String = this.gen_arg_value(value)
        var val_type: AST.Type = this.last_type
        if (variant_name.starts_with("__array:")) {
            this.gen_let_array_pattern(bindings, variant_name, val, val_type)
            return
        }
        // For variant patterns, extract fields from the tagged value
        if (bindings.length() > 0) {
            // Determine the enum name from the variant
            var enum_name: String = this.find_enum_for_variant(variant_name)
            var max_fields: Float = 0
            if (enum_name != "Unknown") {
                max_fields = this.get_max_fields(enum_name)
            }
            // Use extract_arm_bindings which handles both encodings
            this.extract_arm_bindings(bindings, val, max_fields)
            // Set type information for each binding
            var bi: Float = 0
            while (bi < bindings.length()) {
                var btype: String = "Int"
                if (enum_name != "Unknown") {
                    btype = this.get_variant_field_type(enum_name, variant_name, bi)
                }
                this.typed_vars.set(bindings[bi], this.str_to_type(btype))
                if (btype == "String") {
                    this.string_vars.push(bindings[bi])
                }
                bi = bi + 1
            }
        }
    }

    fun gen_let_array_pattern(elements: List<String>, variant_name: String, val: String, val_type: AST.Type) {
        var rest: String = variant_name.slice(8, variant_name.length())
        // Infer element type from list type
        var elem_type_str: String = "Int"
        var list_type_str: String = this.type_to_string(val_type)
        if (list_type_str.starts_with("List<") and list_type_str.ends_with(">")) {
            elem_type_str = list_type_str.slice(5, list_type_str.length() - 1)
        }
        var elem_type: AST.Type = this.str_to_type(elem_type_str)
        var i: Float = 0
        while (i < elements.length()) {
            var elem_val: String = this.fresh_local()
            this.emit_indent(elem_val + " = call i64 @__list_get(i64 " + val + ", i64 " + i.floor().to_string() + ")")
            this.emit_indent("store i64 " + elem_val + ", i64* %" + this.sanitize_name(elements[i]))
            this.typed_vars.set(elements[i], elem_type)
            if (elem_type_str == "String") {
                this.string_vars.push(elements[i])
            }
            i = i + 1
        }
        if (rest.length() > 0) {
            var len_val: String = this.fresh_local()
            this.emit_indent(len_val + " = call i64 @__list_length(i64 " + val + ")")
            var rest_val: String = this.fresh_local()
            this.emit_indent(rest_val + " = call i64 @__list_slice(i64 " + val + ", i64 " + elements.length().floor().to_string() + ", i64 " + len_val + ")")
            this.emit_indent("store i64 " + rest_val + ", i64* %" + this.sanitize_name(rest))
            this.typed_vars.set(rest, val_type)
        }
    }

    fun gen_throw(value: AST.Expr) {
        var val: String = this.gen_arg_value(value)
        this.emit_indent("store i64 " + val + ", i64* @__exception_value")
        // Load the current jmp_buf pointer and check for null (uncaught exception)
        var jmp_ptr: String = this.fresh_local()
        this.emit_indent(jmp_ptr + " = load i8*, i8** @__jmp_buf_current")
        var is_null: String = this.fresh_local()
        this.emit_indent(is_null + " = icmp eq i8* " + jmp_ptr + ", null")
        var uncaught_label: String = this.fresh_label("uncaught")
        var do_throw_label: String = this.fresh_label("do_throw")
        this.emit_terminator("br i1 " + is_null + ", label %" + uncaught_label + ", label %" + do_throw_label)
        // Uncaught exception: convert to string, print fatal error, and exit
        this.start_block(uncaught_label)
        var msg_str: String = this.fresh_local()
        this.emit_indent(msg_str + " = call i64 @__any_to_string(i64 " + val + ")")
        this.emit_indent("call i64 @__runtime_error_fatal(i64 " + msg_str + ")")
        this.emit_indent("call void @exit(i32 1)")
        this.emit_terminator("unreachable")
        // Normal throw: longjmp to handler
        this.start_block(do_throw_label)
        this.emit_indent("call void @longjmp(i8* " + jmp_ptr + ", i32 1)")
        this.emit_terminator("unreachable")
    }

    fun gen_try_catch(try_body: List<AST.Stmt>, catch_name: String, catch_body: List<AST.Stmt>, finally_body: List<AST.Stmt>) {
        var try_label: String = this.fresh_label("try")
        var catch_label: String = this.fresh_label("catch")
        var finally_label: String = this.fresh_label("finally")
        var end_label: String = this.fresh_label("tryend")

        // Was annotated Float while holding a comparison result. It is only ever
        // used as an `if` condition, so nothing misbehaved — but the annotation
        // was simply wrong, and no pass rejected it until the checker began
        // walking method bodies (BUGS #76).
        var has_finally: Bool = finally_body.length() > 0

        // Allocate a local jmp_buf on the stack (512 bytes, enough for any platform)
        var jmp_buf: String = this.fresh_local()
        this.emit_indent(jmp_buf + " = alloca [512 x i8], align 16")
        var jmp_buf_ptr: String = this.fresh_local()
        this.emit_indent(jmp_buf_ptr + " = getelementptr [512 x i8], [512 x i8]* " + jmp_buf + ", i64 0, i64 0")

        // Save the previous jmp_buf pointer (for nested try/catch)
        var saved_jmp: String = this.fresh_local()
        this.emit_indent(saved_jmp + " = load i8*, i8** @__jmp_buf_current")
        // Set current jmp_buf to our local buffer
        this.emit_indent("store i8* " + jmp_buf_ptr + ", i8** @__jmp_buf_current")

        // Save shadow stack depth so we can restore it on catch (longjmp skips pop_roots)
        var saved_ss_depth: String = this.fresh_local()
        this.emit_indent(saved_ss_depth + " = call i64 @__gc_shadow_stack_depth()")

        // setjmp returns 0 on first call, non-zero on longjmp
        var setjmp_result: String = this.fresh_local()
        this.emit_indent(setjmp_result + " = call i32 @setjmp(i8* " + jmp_buf_ptr + ")")
        var is_throw: String = this.fresh_local()
        this.emit_indent(is_throw + " = icmp ne i32 " + setjmp_result + ", 0")
        this.emit_terminator("br i1 " + is_throw + ", label %" + catch_label + ", label %" + try_label)

        // Try body
        this.start_block(try_label)
        this.gen_stmts(try_body)
        if (!this.block_terminated) {
            // Restore previous jmp_buf before leaving try
            this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
            if (has_finally) {
                this.emit_terminator("br label %" + finally_label)
            } else {
                this.emit_terminator("br label %" + end_label)
            }
        }

        // Catch body
        this.start_block(catch_label)
        // Restore previous jmp_buf before running catch (so re-throws use outer handler)
        this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
        // Restore shadow stack depth (longjmp skipped pop_roots in unwound frames)
        var cur_ss_depth: String = this.fresh_local()
        this.emit_indent(cur_ss_depth + " = call i64 @__gc_shadow_stack_depth()")
        var ss_pop_n: String = this.fresh_local()
        this.emit_indent(ss_pop_n + " = sub i64 " + cur_ss_depth + ", " + saved_ss_depth)
        this.emit_indent("call void @__gc_pop_roots(i64 " + ss_pop_n + ")")
        // Load exception value into catch variable
        var exc_val: String = this.fresh_local()
        this.emit_indent(exc_val + " = load i64, i64* @__exception_value")
        this.emit_indent("store i64 " + exc_val + ", i64* %" + this.sanitize_name(catch_name))
        this.typed_vars.set(catch_name, AST.Type.StringType)
        this.gen_stmts(catch_body)
        if (!this.block_terminated) {
            if (has_finally) {
                this.emit_terminator("br label %" + finally_label)
            } else {
                this.emit_terminator("br label %" + end_label)
            }
        }

        // Finally body (runs after both try and catch paths)
        if (has_finally) {
            this.start_block(finally_label)
            this.gen_stmts(finally_body)
            if (!this.block_terminated) {
                this.emit_terminator("br label %" + end_label)
            }
        }

        this.start_block(end_label)
    }

    fun gen_while(cond: AST.Expr, body: List<AST.Stmt>) {
        var cond_label: String = this.fresh_label("while.cond")
        var body_label: String = this.fresh_label("while.body")
        var end_label: String = this.fresh_label("while.end")

        var saved_loop_end: String = this.loop_end_label
        var saved_break: String = this.loop_break_label
        var saved_continue: String = this.loop_continue_label
        this.loop_end_label = end_label + ":" + cond_label
        this.loop_break_label = end_label
        this.loop_continue_label = cond_label

        // LLVM lib parallel path: create blocks for while structure
        var llvm_cond_bb: Any = nil
        var llvm_body_bb: Any = nil
        var llvm_end_bb: Any = nil
        if (!this.identity_mode and this.use_llvm_lib) {
            llvm_cond_bb = this.llvm_func_builder.new_block(cond_label)
            llvm_body_bb = this.llvm_func_builder.new_block(body_label)
            llvm_end_bb = this.llvm_func_builder.new_block(end_label)
        }

        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(cond_label))
            // LLVM lib parallel path: br to cond block, switch builder
            if (!this.identity_mode) {
                this.llvm_block_builder.br_label_set(cond_label)
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_cond_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_cond_bb)
            }
        } else {
            this.emit_terminator("br label %" + cond_label)
            this.verify_br(cond_label)
        }

        this.start_block(cond_label)
        var cond_val: String = this.to_i1(this.gen_arg_value(cond))
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_cond_br(cond_val, body_label, end_label))
            // LLVM lib parallel path: cond_br, switch to body block
            if (!this.identity_mode and this.llvm_values.has(cond_val)) {
                var cond_v: Any = this.llvm_values.get(cond_val)
                this.llvm_block_builder.cond_br_labels_set(cond_v, body_label, end_label)
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_body_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_body_bb)
            }
        } else {
            this.emit_terminator("br i1 " + cond_val + ", label %" + body_label + ", label %" + end_label)
            this.verify_cond_br(cond_val, body_label, end_label)
        }

        this.start_block(body_label)
        this.gen_stmts(body)
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(cond_label))
            // LLVM lib parallel path: loop back to cond, switch to end block
            if (!this.identity_mode) {
                this.llvm_block_builder.br_label_set(cond_label)
                this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, llvm_end_bb)
                this.llvm_block_builder.init(this.llvm_func_builder, llvm_end_bb)
            }
        } else {
            this.emit_terminator("br label %" + cond_label)
            this.verify_br(cond_label)
        }

        this.loop_end_label = saved_loop_end
        this.loop_break_label = saved_break
        this.loop_continue_label = saved_continue

        this.start_block(end_label)
    }

    // Every ancestor struct name of `struct_c`, transitively, through ALL of its
    // bases. Breadth-first with a visited set, so a diamond yields the shared
    // ancestor once and an `extends` cycle terminates instead of hanging codegen.
    // Does not include struct_c itself.
    fun all_ancestor_structs(struct_c: String): List<String> {
        var out: List<String> = []
        var visited: List<String> = [struct_c]
        var work: List<String> = []
        if (this.class_parents_of.has(struct_c)) {
            var seed: List<String> = this.class_parents_of.get(struct_c)
            var si: Float = 0
            while (si < seed.length()) {
                work.push(seed[si])
                si = si + 1
            }
        } else if (this.class_parent_of.has(struct_c)) {
            // Sites that only recorded the primary base still contribute it.
            work.push(this.class_parent_of.get(struct_c))
        }
        while (work.length() > 0) {
            var cur: String = work.pop()
            if (!this.str_in_list(visited, cur)) {
                visited.push(cur)
                out.push(cur)
                var ups: List<String> = []
                if (this.class_parents_of.has(cur)) {
                    ups = this.class_parents_of.get(cur)
                } else if (this.class_parent_of.has(cur)) {
                    ups = [this.class_parent_of.get(cur)]
                }
                var ui: Float = 0
                while (ui < ups.length()) {
                    if (!this.str_in_list(visited, ups[ui])) { work.push(ups[ui]) }
                    ui = ui + 1
                }
            }
        }
        return out
    }

    // Emit the two helpers that give the class hierarchy a runtime existence:
    // __class_parent_tag (the PRIMARY base of each class, one switch arm each)
    // and __class_is_a (does a tag name a target or a descendant of it).
    //
    // Emitted for *every* target and both modes, unlike emit_reflect_helpers
    // which is skipped in identity mode. gen_is_check calls __class_is_a
    // unconditionally, so skipping the definition here would leave an undefined
    // symbol whenever the compiler compiles itself.
    //
    // __class_is_a is a flattened tag -> ancestor-set table, not a chain walk.
    // The walk was O(depth) and easier to read in the IR, but it could only ever
    // follow ONE parent per tag — a switch arm returns a single value — so
    // `duck is Swimmable` was false for `class Duck extends Flyable, Swimmable,
    // Walkable`. Multiple bases are a DAG, not a chain, and no single-successor
    // walk can traverse one. The closure is computed here at compile time (see
    // all_ancestor_structs), so the emitted form is a nested switch and O(1).
    fun emit_class_hierarchy_helpers() {
        var child_names: List<String> = this.class_parent_of.keys()
        this.emit("")
        this.emit("define i64 @__class_parent_tag(i64 %tag) {")
        this.emit("entry:")
        this.block_terminated = false
        var arms: String = ""
        var arm_lbls: List<String> = []
        var arm_parents: List<String> = []
        var hi: Float = 0
        while (hi < child_names.length()) {
            var child: String = child_names[hi]
            var par: String = this.class_parent_of.get(child)
            // An interface or a base declared but never constructed has no type
            // id, so there is no tag to walk to; skip rather than emit an arm
            // pointing at 0, which __class_is_a reads as "chain ended".
            if (this.class_type_ids.has(child) and this.class_type_ids.has(par)) {
                var ctag: Float = this.class_type_ids.get(child)
                var ptag: Float = this.class_type_ids.get(par)
                var lbl: String = this.fresh_label("cpt.a")
                arm_lbls.push(lbl)
                arm_parents.push(ptag.floor().to_string())
                arms = arms + " i64 " + ctag.floor().to_string() + ", label %" + lbl
            }
            hi = hi + 1
        }
        if (arm_lbls.length() == 0) {
            this.emit_terminator("ret i64 0")
            this.emit("}")
            this.block_terminated = false
        } else {
            this.emit_indent("switch i64 %tag, label %cpt.none [" + arms + " ]")
            this.block_terminated = true
            var ai: Float = 0
            while (ai < arm_lbls.length()) {
                this.start_block(arm_lbls[ai])
                this.emit_terminator("ret i64 " + arm_parents[ai])
                ai = ai + 1
            }
            this.start_block("cpt.none")
            this.emit_terminator("ret i64 0")
            this.emit("}")
            this.block_terminated = false
        }

        // __class_is_a(tag, target): does `tag` name `target` or a descendant of
        // it? The zero tests come before the equality test so a target of 0 (a
        // non-class value, whose __gc_get_type_tag is 0) answers false rather
        // than matching the no-such-class sentinel.
        //
        // Outer switch on the receiver's tag, inner switch on the target against
        // that class's precomputed ancestor set. A chain walk cannot do this: it
        // has one successor per step and multiple bases are a DAG.
        var isa_children: List<String> = this.class_parents_of.keys()
        var isa_lbls: List<String> = []
        var isa_sets: List<List<String>> = []
        var isa_arms: String = ""
        var ci: Float = 0
        while (ci < isa_children.length()) {
            var ch: String = isa_children[ci]
            if (this.class_type_ids.has(ch)) {
                // Ancestors that actually have a tag. An interface never
                // constructed has no type id, so there is nothing to compare
                // against and it contributes no arm — but note gen_is_check
                // resolves the *target* through class_type_ids too, so an
                // untagged interface is unaskable rather than wrongly false.
                var tagged: List<String> = []
                var anc: List<String> = this.all_ancestor_structs(ch)
                var ai2: Float = 0
                while (ai2 < anc.length()) {
                    if (this.class_type_ids.has(anc[ai2])) {
                        var atag: Float = this.class_type_ids.get(anc[ai2])
                        tagged.push(atag.floor().to_string())
                    }
                    ai2 = ai2 + 1
                }
                if (tagged.length() > 0) {
                    var chtag: Float = this.class_type_ids.get(ch)
                    var clbl: String = "cia.c" + isa_lbls.length().floor().to_string()
                    isa_lbls.push(clbl)
                    isa_sets.push(tagged)
                    isa_arms = isa_arms + " i64 " + chtag.floor().to_string() + ", label %" + clbl
                }
            }
            ci = ci + 1
        }
        this.emit("")
        this.emit("define i1 @__class_is_a(i64 %tag, i64 %target) {")
        this.emit("entry:")
        this.emit("  %z = icmp eq i64 %tag, 0")
        this.emit("  br i1 %z, label %cia.no, label %cia.tchk")
        this.emit("cia.tchk:")
        this.emit("  %tz = icmp eq i64 %target, 0")
        this.emit("  br i1 %tz, label %cia.no, label %cia.self")
        this.emit("cia.self:")
        this.emit("  %hit = icmp eq i64 %tag, %target")
        if (isa_lbls.length() == 0) {
            this.emit("  br i1 %hit, label %cia.yes, label %cia.no")
        } else {
            this.emit("  br i1 %hit, label %cia.yes, label %cia.disp")
            this.emit("cia.disp:")
            this.emit("  switch i64 %tag, label %cia.no [" + isa_arms + " ]")
            var li: Float = 0
            while (li < isa_lbls.length()) {
                this.emit(isa_lbls[li] + ":")
                var set: List<String> = isa_sets[li]
                var tarms: String = ""
                var ti: Float = 0
                while (ti < set.length()) {
                    tarms = tarms + " i64 " + set[ti] + ", label %cia.yes"
                    ti = ti + 1
                }
                this.emit("  switch i64 %target, label %cia.no [" + tarms + " ]")
                li = li + 1
            }
        }
        this.emit("cia.yes:")
        this.emit("  ret i1 1")
        this.emit("cia.no:")
        this.emit("  ret i1 0")
        this.emit("}")
        this.block_terminated = false

        this.emit_val_to_string()
    }

    // BUGS #115. `IO.println(p)` on a class instance printed 5.21502e-310 — an
    // address reinterpreted as a subnormal double — while `"${p}"` printed
    // `Pt(3)` correctly. The interpolation path has the static type in hand and
    // calls `Pt__to_string` directly; println and every list/map element read go
    // through `__any_to_string`, whose last useful arm (`do_ptr`) hands back the
    // pointer as-is because a hand-written .ll file cannot know that a value
    // with GC type tag 12 should be formatted by `Pt__to_string`.
    //
    // The value IS identifiable — a class instance carries a GC header, and
    // __val_class_tag reads it safely. What was missing is the tag -> symbol
    // mapping, and that lives only here, in codegen's class_type_ids /
    // class_own_methods. So the fix is a generated switch, emitted next to
    // __class_parent_tag and __class_is_a from the very same tables, that
    // __any_to_string consults before falling through to do_float.
    //
    // Contract with the caller, which is the part that is easy to get wrong:
    // __any_to_string's arms all return a RAW char*, and a user to_string
    // returns a NaN-TAGGED string (see the tail of any generated
    // <Class>__to_string: __val_tag_ptr). So the tag has to come off here. #102
    // was the mirror-image mistake — tagging a value that was already raw — and
    // it segfaulted, so the direction matters more than the presence.
    //
    // Returning 0 for "not a class, or a class with no to_string" is what keeps
    // this composable: 0 is the sentinel __any_to_string tests, so every value
    // this cannot name falls through to the arms that were already there. A
    // class without a to_string therefore keeps printing its bit pattern. That
    // is a deliberate non-goal: inventing `<Pt object>` would be a new output
    // format decided by a bug fix, and the field-by-field default belongs with
    // whatever eventually gives enums the same treatment.
    fun emit_val_to_string() {
        // Only classes that supply a to_string body get an arm. effective_method_owner
        // rather than a class_own_methods lookup, so a subclass that inherits
        // to_string from its base dispatches to the base's symbol instead of
        // falling into the default (the #135 shape: no forwarder is emitted for a
        // method a class does not redeclare, so deriving the symbol from the
        // concrete class would name something that does not exist).
        var vts_names: List<String> = this.class_type_ids.keys()
        var vts_tags: List<String> = []
        var vts_syms: List<String> = []
        // 1 for an enum arm, 0 for a class arm. The two disagree about whether
        // the callee's result is tagged — see the untag site below.
        var vts_raw: List<String> = []
        var vi: Float = 0
        while (vi < vts_names.length()) {
            var vc: String = vts_names[vi]
            var owner: String = this.effective_method_owner(vc, "to_string")
            if (owner.length() > 0) {
                var vbare: String = owner
                if (this.class_bare_of.has(owner)) { vbare = this.class_bare_of.get(owner) }
                var vtag: Float = this.class_type_ids.get(vc)
                vts_tags.push(vtag.floor().to_string())
                vts_syms.push(this.resolve_method_symbol(vbare, "to_string"))
                vts_raw.push("0")
            }
            vi = vi + 1
        }
        // One arm per payload enum (BUGS #154). Unconditional, unlike the class
        // loop's effective_method_owner test: emit_enum_to_string generates
        // <Enum>__to_string for every enum it lowers, so the symbol always
        // exists — there is no user-declared-or-not question to ask.
        var vts_enums: List<String> = this.enum_type_ids.keys()
        var vei: Float = 0
        while (vei < vts_enums.length()) {
            var ve: String = vts_enums[vei]
            var vetag: Float = this.enum_type_ids.get(ve)
            vts_tags.push(vetag.floor().to_string())
            vts_syms.push(ve + "__to_string")
            vts_raw.push("1")
            vei = vei + 1
        }
        this.emit("")
        this.emit("define i64 @__val_to_string(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        if (vts_tags.length() == 0) {
            // No class in this program formats itself. The definition is still
            // emitted: __any_to_string in base_nanbox.ll calls it unconditionally,
            // so omitting it would be an undefined symbol in every program that
            // declares no classes at all.
            this.emit_terminator("ret i64 0")
            this.emit("}")
            this.block_terminated = false
            return nil
        }
        var vts_tag_r: String = this.fresh_local()
        this.emit_indent(vts_tag_r + " = call i64 @__val_class_tag(i64 %val)")
        var vts_none: String = this.fresh_label("vts.none")
        var vts_arms: List<String> = []
        var vts_cases: String = ""
        vi = 0
        while (vi < vts_tags.length()) {
            var albl: String = this.fresh_label("vts.c")
            vts_arms.push(albl)
            vts_cases = vts_cases + " i64 " + vts_tags[vi.floor()] + ", label %" + albl
            vi = vi + 1
        }
        this.emit_terminator("switch i64 " + vts_tag_r + ", label %" + vts_none + " [" + vts_cases + " ]")
        vi = 0
        while (vi < vts_arms.length()) {
            this.start_block(vts_arms[vi.floor()])
            var sym: String = vts_syms[vi.floor()]
            var sres: String = this.fresh_local()
            this.emit_indent(sres + " = call i64 @" + sym + "(i64 %val)")
            this.called_functions.push(sym)
            // The tagged->raw step. Note %val is passed through unchanged: a
            // method takes its receiver exactly as the value sits in the slot
            // (see any generated call site — `call i64 @Pt__to_string(i64 %t8)`
            // with no untag), and __val_class_tag already accepted both the
            // tagged and the bare-pointer spelling, so no normalisation belongs
            // between the tag read and the call.
            //
            // An enum arm skips it, because the two to_strings disagree on their
            // return representation: a class <C>__to_string ends at
            // __val_tag_ptr and hands back a TAGGED string, while
            // emit_enum_to_string ends at __sb_to_string — a bare
            // `load64(sb + 16)` — and hands back a RAW char*. The evidence is at
            // the enum call sites in methods_body.sf, which wrap the result in
            // __rt_tag_ptr while class calls do not. Untagging an already-raw
            // pointer is the #102 mistake mirrored, and it corrupts the address
            // rather than failing loudly.
            if (vts_raw[vi.floor()] == "1") {
                this.emit_terminator("ret i64 " + sres)
            } else {
                var sptr: String = this.fresh_local()
                this.emit_indent(sptr + " = call i8* @__val_untag_ptr(i64 " + sres + ")")
                var sraw: String = this.ptr_to_val(sptr)
                this.emit_terminator("ret i64 " + sraw)
            }
            vi = vi + 1
        }
        this.start_block(vts_none)
        this.emit_terminator("ret i64 0")
        this.emit("}")
        this.block_terminated = false
    }

    fun emit_reflect_helpers() {
        var class_names: List<String> = this.class_type_ids.keys()
        if (class_names.length() == 0) { return }
        this.emit("")
        this.emit("define i64 @__reflect_class_name(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var tag_r: String = this.fresh_local()
        this.emit_indent(tag_r + " = call i64 @__val_class_tag(i64 %val)")
        var end_lbl: String = this.fresh_label("rcn.end")
        var switch_str: String = ""
        var arm_labels: List<String> = []
        var ci: Float = 0
        while (ci < class_names.length()) {
            var lbl: String = this.fresh_label("rcn.c")
            arm_labels.push(lbl)
            var tid: Float = this.class_type_ids.get(class_names[ci])
            switch_str = switch_str + " i64 " + tid.floor().to_string() + ", label %" + lbl
            ci = ci + 1
        }
        this.emit_indent("switch i64 " + tag_r + ", label %" + end_lbl + " [" + switch_str + " ]")
        this.block_terminated = true
        ci = 0
        while (ci < class_names.length()) {
            this.start_block(arm_labels[ci])
            var cname: String = class_names[ci]
            var str_const: String = this.add_string_constant(cname)
            var str_len: Float = cname.length() + 1
            var gep: String = this.fresh_local()
            this.emit_indent(gep + " = getelementptr [" + str_len.to_string() + " x i8], [" + str_len.to_string() + " x i8]* " + str_const + ", i64 0, i64 0")
            var as_i64: String = this.ptr_to_val(gep)
            this.emit_terminator("ret i64 " + as_i64)
            ci = ci + 1
        }
        this.start_block(end_lbl)
        var unk_const: String = this.add_string_constant("Unknown")
        var unk_gep: String = this.fresh_local()
        this.emit_indent(unk_gep + " = getelementptr [8 x i8], [8 x i8]* " + unk_const + ", i64 0, i64 0")
        var unk_i64: String = this.ptr_to_val(unk_gep)
        this.emit_terminator("ret i64 " + unk_i64)
        this.emit("}")
        this.block_terminated = false

        this.emit("")
        this.emit("define i64 @__reflect_is_class(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var is_tag: String = this.fresh_local()
        this.emit_indent(is_tag + " = call i64 @__val_class_tag(i64 %val)")
        var cmp: String = this.fresh_local()
        this.emit_indent(cmp + " = icmp uge i64 " + is_tag + ", 10")
        var result: String = this.fresh_local()
        this.emit_indent(result + " = zext i1 " + cmp + " to i64")
        this.emit_terminator("ret i64 " + result)
        this.emit("}")
        this.block_terminated = false

        this.emit("")
        this.emit("define i64 @__reflect_number_to_string(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var untagged: String = this.fresh_local()
        this.emit_indent(untagged + " = call i64 @__val_untag_int(i64 %val)")
        var ns_result: String = this.fresh_local()
        this.emit_indent(ns_result + " = call i64 @__int_to_string(i64 " + untagged + ")")
        var ns_ptr: String = this.fresh_local()
        this.emit_indent(ns_ptr + " = inttoptr i64 " + ns_result + " to i8*")
        var ns_tagged: String = this.fresh_local()
        this.emit_indent(ns_tagged + " = call i64 @__val_tag_ptr(i8* " + ns_ptr + ")")
        this.emit_terminator("ret i64 " + ns_tagged)
        this.emit("}")
        this.block_terminated = false

        // __reflect_get_fields: returns a Map of field_name -> field_value for an instance
        this.emit("")
        this.emit("define i64 @__reflect_get_fields(i64 %val) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var gf_tag: String = this.fresh_local()
        this.emit_indent(gf_tag + " = call i64 @__val_class_tag(i64 %val)")
        var gf_end: String = this.fresh_label("rgf.end")
        var gf_switch: String = ""
        var gf_arms: List<String> = []
        ci = 0
        while (ci < class_names.length()) {
            var gf_lbl: String = this.fresh_label("rgf.c")
            gf_arms.push(gf_lbl)
            var gf_tid: Float = this.class_type_ids.get(class_names[ci])
            gf_switch = gf_switch + " i64 " + gf_tid.floor().to_string() + ", label %" + gf_lbl
            ci = ci + 1
        }
        this.emit_indent("switch i64 " + gf_tag + ", label %" + gf_end + " [" + gf_switch + " ]")
        this.block_terminated = true
        ci = 0
        while (ci < class_names.length()) {
            this.start_block(gf_arms[ci])
            var cname2: String = class_names[ci]
            var fld_entries: List<String> = []
            if (this.class_field_list.has(cname2)) { fld_entries = this.class_field_list.get(cname2) }
            var map_val: String = this.fresh_local()
            this.emit_indent(map_val + " = call i64 @__map_new()")
            var fi: Float = 0
            while (fi < fld_entries.length()) {
                var fp: List<String> = fld_entries[fi].split(":")
                var fname: String = fp[0]
                var fname_const: String = this.add_string_constant(fname)
                var fname_len: Float = fname.length() + 1
                var fname_gep: String = this.fresh_local()
                this.emit_indent(fname_gep + " = getelementptr [" + fname_len.to_string() + " x i8], [" + fname_len.to_string() + " x i8]* " + fname_const + ", i64 0, i64 0")
                var fname_i64: String = this.emit_tag_ptr(fname_gep)
                var inst_ptr: String = this.fresh_local()
                this.emit_indent(inst_ptr + " = inttoptr i64 %val to %" + cname2 + "*")
                var field_ptr: String = this.fresh_local()
                this.emit_indent(field_ptr + " = getelementptr %" + cname2 + ", %" + cname2 + "* " + inst_ptr + ", i32 0, i32 " + fi.floor().to_string())
                var field_val: String = this.fresh_local()
                this.emit_indent(field_val + " = load i64, i64* " + field_ptr)
                this.emit_indent("call i64 @__map_set(i64 " + map_val + ", i64 " + fname_i64 + ", i64 " + field_val + ")")
                fi = fi + 1
            }
            this.emit_terminator("ret i64 " + map_val)
            ci = ci + 1
        }
        this.start_block(gf_end)
        var empty_map: String = this.fresh_local()
        this.emit_indent(empty_map + " = call i64 @__map_new()")
        this.emit_terminator("ret i64 " + empty_map)
        this.emit("}")
        this.block_terminated = false

        // __reflect_construct_from_map: given a class constructor ptr and a map, construct instance
        this.emit("")
        this.emit("define i64 @__reflect_construct_from_map(i64 %klass, i64 %map) {")
        this.emit("entry:")
        this.block_terminated = false
        this.reset_locals()
        var rc_end: String = this.fresh_label("rcon.end")
        ci = 0
        while (ci < class_names.length()) {
            var cname3: String = class_names[ci]
            var fn_ptr_val: String = this.fresh_local()
            this.emit_indent(fn_ptr_val + " = ptrtoint i64 (...)* bitcast (i64 ()* @" + cname3 + " to i64 (...)*) to i64")
            var cmp_r: String = this.fresh_local()
            this.emit_indent(cmp_r + " = icmp eq i64 %klass, " + fn_ptr_val)
            var rc_arm: String = this.fresh_label("rcon.hit")
            var rc_next: String = this.fresh_label("rcon.next")
            if (ci < class_names.length() - 1) {
                this.emit_terminator("br i1 " + cmp_r + ", label %" + rc_arm + ", label %" + rc_next)
            } else {
                this.emit_terminator("br i1 " + cmp_r + ", label %" + rc_arm + ", label %" + rc_end)
            }
            this.start_block(rc_arm)
            var new_inst: String = this.fresh_local()
            this.emit_indent(new_inst + " = call i64 @" + cname3 + "()")
            var c_entries: List<String> = []
            if (this.class_field_list.has(cname3)) { c_entries = this.class_field_list.get(cname3) }
            if (c_entries.length() > 0) {
                var c_ptr: String = this.fresh_local()
                this.emit_indent(c_ptr + " = inttoptr i64 " + new_inst + " to %" + cname3 + "*")
                var cfi: Float = 0
                while (cfi < c_entries.length()) {
                    var cfp: List<String> = c_entries[cfi].split(":")
                    var cf_name: String = cfp[0]
                    var cf_key_const: String = this.add_string_constant(cf_name)
                    var cf_key_len: Float = cf_name.length() + 1
                    var cf_key_gep: String = this.fresh_local()
                    this.emit_indent(cf_key_gep + " = getelementptr [" + cf_key_len.to_string() + " x i8], [" + cf_key_len.to_string() + " x i8]* " + cf_key_const + ", i64 0, i64 0")
                    var cf_key_i64: String = this.ptr_to_val(cf_key_gep)
                    var cf_val: String = this.fresh_local()
                    this.emit_indent(cf_val + " = call i64 @__map_get(i64 %map, i64 " + cf_key_i64 + ")")
                    var cf_fld_ptr: String = this.fresh_local()
                    this.emit_indent(cf_fld_ptr + " = getelementptr %" + cname3 + ", %" + cname3 + "* " + c_ptr + ", i32 0, i32 " + cfi.floor().to_string())
                    this.emit_indent("store i64 " + cf_val + ", i64* " + cf_fld_ptr)
                    cfi = cfi + 1
                }
            }
            this.emit_terminator("ret i64 " + new_inst)
            if (ci < class_names.length() - 1) {
                this.start_block(rc_next)
            }
            ci = ci + 1
        }
        this.start_block(rc_end)
        this.emit_terminator("ret i64 0")
        this.emit("}")
        this.block_terminated = false
    }

