    fun find_class_for_method(method: String): String {
    var keys: List<String> = this.class_methods.keys()
    var i: Float = 0
    var interface_fallback: String = ""
    while (i < keys.length()) {
        var class_name: String = keys[i]
        var methods: List = this.class_methods.get(class_name)
        if (methods.contains(method)) {
            // Skip built-in types (String, List, Map, etc.) that are registered
            // in class_methods but not in class_fields. Their methods are handled
            // by builtin method dispatch, not class method dispatch.
            if (!this.class_fields.has(class_name)) {
                i = i + 1
                continue
            }
            // Skip interfaces (classes with no fields) — prefer concrete classes.
            // Interfaces have empty class_fields and register stub methods.
            var cf: String = this.class_fields.get(class_name)
            if (cf.length() == 0) {
                // Could be an interface — save as fallback, keep searching
                if (interface_fallback.length() == 0) {
                    interface_fallback = class_name
                }
            } else {
                return class_name
            }
        }
        i = i + 1
    }
    return interface_fallback
    }

    fun get_method_ret(class_name: String, method: String): String {
    // All functions return i64 (no void) to avoid call type mismatches
    return "i64"
    }

    // True when the receiver's static type is a concrete builtin — a primitive,
    // a container, or StringBuilder — as opposed to `Any` (unknown, keep the
    // heuristic) or a user class (has class_fields). find_class_for_method must
    // NOT fire for these: a String receiver calling a method String does not have
    // was resolving to whatever unrelated user class happened to declare that
    // name, dispatching to its symbol with a String pointer as `this` — printing
    // a garbage value, or segfaulting when the borrowed method touched a field
    // (BUGS #134). A concrete builtin with no matching builtin arm must instead
    // reach the terminal fall-through, which reports "type 'X' has no method".
    // `Any` is deliberately excluded — it stays on the find_class heuristic and
    // its own "annotate the receiver" diagnostic.
    fun recv_is_concrete_builtin(obj_type: String): Bool {
        if (obj_type == "Int" or obj_type == "Float" or obj_type == "Bool" or obj_type == "String" or obj_type == "Nil") { return true }
        if (obj_type.starts_with("List") or obj_type.starts_with("Map") or obj_type.starts_with("Tuple")) { return true }
        if (obj_type == "StringBuilder" or obj_type == "SB") { return true }
        return false
    }

    fun classify_expr(expr: AST.Expr): String {
    return match (expr) {
        MethodCall(o, m, a, __ks) => "method_call"
        ListLit(e) => "list_lit"
        IndexGet(o, i) => "index_get"
        IndexSet(o, i, v) => "index_set"
        MapLit => "map_lit"
        StringLit(s) => "string"
        IntLit(v) => "int"
        FloatLit(v) => "float"
        BoolLit(v) => "bool"
        Variable(n, __vs) => "variable"
        Ref(rk, rn, rs, __rs) => "variable"
        Binary(l, o, r) => "binary"
        Unary(o, r) => "unary"
        Call(c, a, __cs) => "call"
        Assign(n, v, __as) => "assign"
        Logical(l, o, r) => "logical"
        MemberAccess(o, f, __ms) => "member"
        NilLit => "nil"
        Match(s, a) => "match_expr"
        EnumConstruct(e, v, a) => "enum"
        Lambda(p, r, b) => "lambda"
        GetField(o, f, __gs) => "get_field"
        SetField(o, f, v, __ss) => "set_field"
        This => "this"
        BlockExpr(s, v) => "block_expr"
        IsCheck(val, t) => "is_check"
        IfExpr(c, tb, tv, eb, ev) => "if_expr"
        TryExpr(tb, tv, cn, cb, cv) => "try_expr"
        Yield(v) => "yield"\
        TupleLit(e) => "tuple_lit"
    }
    }

    fun get_variable_name(expr: AST.Expr): String {
    // The 28 arms that used to follow, all returning "", are the `_` arm: only a
    // name-shaped expression has a name. Written out by hand they were also
    // wrong — the closing brace sat on the same line as the last arm, and the
    // result was bound as `Any`, so the declared String return type was never
    // actually checked (BUGS #76).
    return match (expr) {
        Variable(n, __vs) => n
        Ref(rk, rn, rs, __rs) => rn
        _ => ""
    }
    }

    fun get_string_literal(expr: AST.Expr): String {
        return match (expr) {
            StringLit(s) => s
            _ => ""
        }
    }

    fun get_expr_type(expr: AST.Expr): String {
    var ek: String = this.classify_expr(expr)
    if (ek == "variable") {
        var vname: String = this.get_variable_name(expr)
        if (vname.length() > 0 and this.typed_vars.has(vname)) {
            var vt: String = this.type_to_string(this.typed_vars.get(vname))
            // In identity mode, Float and Int are both i64 — treat Float as Int
            if (this.identity_mode and vt == "Float") { return "Int" }
            return vt
        }
        return "Any"
    }
    if (ek == "string") return "String"
    if (ek == "int") return "Int"
    if (ek == "float") {
        if (this.identity_mode) { return "Int" }
        return "Float"
    }
    if (ek == "bool") return "Bool"
    if (ek == "nil") return "Nil"
    if (ek == "list_lit") {
        // Same whitelist, same defect, second copy — see gen_list_lit (BUGS #117).
        // These two must agree: this function decides what a nested list literal's
        // element type is, and gen_list_lit decides what the list it emits is typed
        // as. Fixing only one would leave `[[Pt(1)]]` disagreeing with `[Pt(1)]`.
        var list_elems: List<AST.Expr> = match (expr) { ListLit(e) => e   _ => [] }
        if (list_elems.length() > 0) {
            var first_type: String = this.get_expr_type(list_elems[0])
            var ll_homogeneous: Bool = true
            var llk: Float = 1
            while (llk < list_elems.length()) {
                if (this.get_expr_type(list_elems[llk]) != first_type) { ll_homogeneous = false }
                llk = llk + 1
            }
            if (ll_homogeneous and first_type.length() > 0 and first_type != "Any") {
                return "List<" + first_type + ">"
            }
        }
        return "List<Any>"
    }
    if (ek == "tuple_lit") {
        var tuple_elems: List<AST.Expr> = match (expr) { TupleLit(e) => e   _ => [] }
        var tuple_str: String = "Tuple<"
        var ti: Float = 0
        while (ti < tuple_elems.length()) {
            if (ti > 0) { tuple_str = tuple_str + "," }
            tuple_str = tuple_str + this.get_expr_type(tuple_elems[ti])
            ti = ti + 1
        }
        tuple_str = tuple_str + ">"
        return tuple_str
    }
    if (ek == "map_lit") return "Map<String,String>"
    if (ek == "this") return this.current_class
    if (ek == "get_field" or ek == "member") {
        var gf_inner_obj: AST.Expr = match (expr) {
            GetField(o, f, __gs) => o
            MemberAccess(o, f, __ms) => o
            _ => AST.Expr.NilLit
        }
        var gf_field: String = match (expr) {
            GetField(o, f, __gs) => f
            MemberAccess(o, f, __ms) => f
            _ => ""
        }
        var gf_obj_name: String = this.get_variable_name(gf_inner_obj)
        var gf_class: String = ""
        if (this.classify_expr(gf_inner_obj) == "this") {
            gf_class = this.current_class
        } else if (gf_obj_name.length() > 0) {
            gf_class = this.get_var_type_str(gf_obj_name)
        }
        // Tuple field access: t._0, t._1 etc.
        if (gf_class.starts_with("Tuple<") and gf_field.starts_with("_")) {
            return this.get_field_type(gf_class, gf_field)
        }
        var gf_resolved: String = this.resolve_class_type(gf_class)
        if (gf_resolved.length() > 0) {
            return this.get_field_type(gf_resolved, gf_field)
        }
    }
    if (ek == "method_call") {
        var mc_method: String = match (expr) {
            MethodCall(o, m, a, __ks) => m
            _ => ""
        }
        var mc_obj: AST.Expr = match (expr) {
            MethodCall(o, m, a, __ks) => o
            _ => AST.Expr.NilLit
        }
        // Check if method call is on a user class (resolve obj type)
        var mc_obj_name: String = this.get_variable_name(mc_obj)
        var mc_obj_type: String = ""
        if (mc_obj_name.length() > 0) {
            mc_obj_type = this.get_var_type_str(mc_obj_name)
        }
        // Fallback: if receiver is a complex expression (e.g. another method call),
        // recursively infer its type
        if (mc_obj_type.length() == 0 and mc_obj_name.length() == 0) {
            var mc_obj_kind: String = this.classify_expr(mc_obj)
            if (mc_obj_kind == "method_call" or mc_obj_kind == "call" or mc_obj_kind == "index_get") {
                mc_obj_type = this.get_expr_type(mc_obj)
            }
        }
        if (mc_obj_type.length() == 0 and this.classify_expr(mc_obj) == "this") {
            mc_obj_type = this.current_class
        } else if (this.classify_expr(mc_obj) == "get_field" or this.classify_expr(mc_obj) == "member") {
            // Handle chained field access: this.field.method()
            var inner_obj: AST.Expr = match (mc_obj) {
                GetField(o, f, __gs) => o
                MemberAccess(o, f, __ms) => o
                _ => AST.Expr.NilLit
            }
            var inner_field: String = match (mc_obj) {
                GetField(o, f, __gs) => f
                MemberAccess(o, f, __ms) => f
                _ => ""
            }
            var inner_class: String = ""
            if (this.classify_expr(inner_obj) == "this") {
                inner_class = this.current_class
            } else {
                var in_name: String = this.get_variable_name(inner_obj)
                if (in_name.length() > 0) {
                    inner_class = this.get_var_type_str(in_name)
                }
            }
            var inner_resolved: String = this.resolve_class_type(inner_class)
            if (inner_resolved.length() > 0) {
                mc_obj_type = this.get_field_type(inner_resolved, inner_field)
            }
        }
        // Alias-qualified free function: `Lib.make()`. The parser builds this as a
        // MethodCall whose receiver is a module alias, not a value, so none of the
        // class lookups below can resolve it — the alias has no type. The `call`
        // arm further down already handles this shape for a bare Call; without the
        // same arm here, `var b = Lib.make()` typed as Any and dispatch fell
        // through to Int (BUGS #146). Checked before the class lookups because a
        // module alias is never a class instance, so there is nothing to lose by
        // answering first.
        if (mc_obj_name.length() > 0 and this.has_module_alias(mc_obj_name)) {
            var alias_full: String = this.module_alias_prefix(mc_obj_name) + mc_method
            if (this.func_ret_types.has(alias_full)) {
                return this.type_to_string(this.func_ret_types.get(alias_full))
            }
        }
        // If object is a user class, look up method return type
        var mc_resolved: String = this.resolve_class_type(mc_obj_type)
        if (mc_resolved.length() > 0) {
            var full_mc: String = mc_resolved + "__" + mc_method
            if (this.func_ret_types.has(full_mc)) {
                return this.type_to_string(this.func_ret_types.get(full_mc))
            }
        }
        // Also check with prefix for user class methods
        if (mc_obj_type.length() > 0) {
            var prefixed_mc: String = this.current_prefix + mc_obj_type + "__" + mc_method
            if (this.func_ret_types.has(prefixed_mc)) {
                return this.type_to_string(this.func_ret_types.get(prefixed_mc))
            }
        }
        if (mc_method == "length" or mc_method == "index_of" or mc_method == "to_number") return "Int"
        if (mc_method == "slice") {
            if (mc_obj_type.starts_with("List")) { return mc_obj_type }
            if (mc_obj_type == "String") { return "String" }
            // Unknown receiver: don't claim String. `slice` is defined on both
            // List and String, so on an unannotated value we cannot say which.
            // Claiming String let a sliced list be handed to string-typed code.
            return "Any"
        }
        if (mc_method == "to_string" or mc_method == "join" or mc_method == "trim" or mc_method == "to_upper" or mc_method == "to_lower" or mc_method == "repeat" or mc_method == "replace" or mc_method == "char_at") return "String"
        if (mc_method == "split") return "List<String>"
        // Map.keys()/values() element type comes from the Map<K, V> annotation.
        // Hardcoding List<String> made `for (v in m.values())` on a
        // Map<String,Int> treat every Int as a string pointer and SEGFAULT.
        if (mc_method == "keys") {
            if (mc_obj_type.starts_with("Map<")) {
                return "List<" + this.get_map_key_type(mc_obj_type) + ">"
            }
            return "List<Any>"
        }
        if (mc_method == "values") {
            if (mc_obj_type.starts_with("Map<")) {
                return "List<" + this.get_map_value_type(mc_obj_type) + ">"
            }
            return "List<Any>"
        }
        if (mc_method == "has" or mc_method == "contains" or mc_method == "starts_with" or mc_method == "ends_with" or mc_method == "is_upper" or mc_method == "is_lower") return "Bool"
        if (mc_method == "get") {
            // Infer return type from Map<K, V> annotation rather than always "String"
            var mc_map_type: String = mc_obj_type
            if (mc_map_type.starts_with("Map<")) {
                return this.get_map_value_type(mc_map_type)
            }
            // Unannotated map: Any, not String (BUGS #37). Claiming String made
            // `var arr = m.get(k)` then `arr.push(x)` fall through to a silent
            // return "0" emitting no call. See the matching site in the runtime
            // dispatch arm of gen_method_call. Annotated Map<K, V> still narrows
            // to V above, so this only widens what was already unknown.
            return "Any"
        }
        if (mc_method == "pop") {
            // Infer return type from List<T> element type
            if (mc_obj_type.starts_with("List<") and mc_obj_type.ends_with(">")) {
                var pop_inner: String = mc_obj_type.slice(5, mc_obj_type.length() - 1)
                return pop_inner
            }
            // The receiver is not a `List<T>` — a bare `List`, an `Any`, or a
            // type this path never resolved. `.pop()` returns whatever the list
            // holds, so there is nothing about `Int` that follows from a missing
            // element type. Same shape as the `.get()` miss just above, which
            // BUGS #37 already converted from a false "String" to "Any".
            Diag.record_unresolved("get_expr_type: .pop() on a receiver with no element type", "'" + mc_obj_name + "' of type '" + mc_obj_type + "'", "Int")
            return "Int"
        }
        // reverse/copy/sort return the same list type as the receiver
        if (mc_method == "reverse" or mc_method == "copy" or mc_method == "sort") {
            if (mc_obj_type.starts_with("List")) { return mc_obj_type }
            return "List<Any>"
        }
    }
    if (ek == "call") {
        var call_callee: AST.Expr = match (expr) {
            Call(c, a, __cs) => c
            x => AST.Expr.NilLit
        }
        var callee_name: String = this.resolve_callee(call_callee)
        if (this.func_ret_types.has(callee_name)) {
            return this.type_to_string(this.func_ret_types.get(callee_name))
        }
        if (callee_name.contains(".")) {
            var cp: List<String> = callee_name.split(".")
            if (cp.length() >= 2 and this.has_module_alias(cp[0])) {
                var resolved_name: String = this.module_alias_prefix(cp[0]) + cp[1]
                if (this.func_ret_types.has(resolved_name)) {
                    return this.type_to_string(this.func_ret_types.get(resolved_name))
                }
            }
        }
        // `Pt(1)` is class CONSTRUCTION, not a function call, so it is absent from
        // func_ret_types and this arm used to fall through to "" — the caller then
        // read that as "unknown". Every consumer that asks what a constructor
        // expression evaluates to therefore had to already know, which is how
        // gen_list_lit ended up unable to type `[Pt(1), Pt(2)]` (BUGS #117). The
        // registry that answers this is right here; consult it.
        if (this.class_fields.has(callee_name)) {
            return callee_name
        }
    }
    if (ek == "is_check") return "Bool"
    if (ek == "binary") {
        var bin_op: String = match (expr) { Binary(l, o, r) => o   _ => "" }
        if (bin_op == "<" or bin_op == ">" or bin_op == "<=" or bin_op == ">=" or bin_op == "==" or bin_op == "!=") return "Bool"
        if (bin_op == "and" or bin_op == "or") return "Bool"
        if (bin_op == "&" or bin_op == "|" or bin_op == "^" or bin_op == "<<" or bin_op == ">>") return "Int"
        var bin_left: AST.Expr = match (expr) { Binary(l, o, r) => l   _ => AST.Expr.NilLit }
        var bin_right: AST.Expr = match (expr) { Binary(l, o, r) => r   _ => AST.Expr.NilLit }
        var left_t: String = this.get_expr_type(bin_left)
        var right_t: String = this.get_expr_type(bin_right)
        if (bin_op == "+" and (left_t == "String" or right_t == "String")) return "String"
        if (left_t == "Float" or right_t == "Float") return "Float"
        // An overloaded operator. gen_binary resolves `Vec2 + Vec2` to a call to
        // Vec2__add and reads its declared return type out of func_ret_types
        // (expr_body.sf:835) — but this function did not, so it answered `Int`
        // for an expression the emitter knew returned a Vec2. The two disagreed,
        // which is M2's failure mode exactly: the information was present and a
        // second consumer of it guessed instead. Mirror the emitter's lookup,
        // gated on the same "names a declared class" test it uses.
        var bin_method: String = this.op_to_method(bin_op)
        if (bin_method.length() > 0 and this.class_fields.has(left_t)) {
            if (this.class_methods.has(left_t)) {
                var bin_methods: List = this.class_methods.get(left_t)
                if (bin_methods.contains(bin_method)) {
                    var bin_full: String = left_t + "__" + bin_method
                    if (this.func_prefix_map.has(bin_full)) {
                        bin_full = this.func_prefix_map.get(bin_full)
                    } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions, this.current_prefix + bin_full)) {
                        bin_full = this.current_prefix + bin_full
                    }
                    if (this.func_ret_types.has(bin_full)) {
                        return this.type_to_string(this.func_ret_types.get(bin_full))
                    }
                    // Declared with no return annotation. The receiver's own
                    // class is what gen_binary assumes in that case, so agree
                    // with it rather than reporting a gap that is not one.
                    return left_t
                }
            }
        }
        // Arithmetic where neither operand resolved to a representation. `Int` is
        // right when both sides really are integers and it is reported anyway,
        // because this function cannot tell the two apart: an unresolved operand
        // spells itself "Any" or "", exactly like an operand nobody annotated.
        // That makes this the noisiest of the nine, and deliberately so — every
        // report here is a place where an operand's type was never established.
        if (left_t != "Int" or right_t != "Int") {
            Diag.record_unresolved("get_expr_type: binary '" + bin_op + "' with unresolved operands", "'" + left_t + "' " + bin_op + " '" + right_t + "'", "Int")
        }
        return "Int"
    }
    if (ek == "logical") return "Bool"
    if (ek == "unary") {
        var unary_op: String = match (expr) { Unary(o, r) => o   _ => "" }
        if (unary_op == "!") return "Bool"
        var unary_inner: AST.Expr = match (expr) { Unary(o, r) => r   _ => AST.Expr.NilLit }
        return this.get_expr_type(unary_inner)
    }
    if (ek == "assign") return "Any"
    if (ek == "lambda") return "Fun"
    if (ek == "enum") return "Any"
    if (ek == "match_expr") {
        var match_arms: List<AST.MatchArm> = match (expr) { Match(s, a) => a   _ => [] }
        if (match_arms.length() > 0) {
            var first_arm: AST.MatchArm = match_arms[0]
            var arm_body: AST.Expr = match (first_arm) { Arm(p, b) => b   _ => AST.Expr.NilLit }
            return this.get_expr_type(arm_body)
        }
        return "Any"
    }
    if (ek == "block_expr") {
        var block_value: AST.Expr = match (expr) { BlockExpr(s, v) => v   _ => AST.Expr.NilLit }
        return this.get_expr_type(block_value)
    }
    if (ek == "index_get") {
        var ig_obj: AST.Expr = match (expr) { IndexGet(o, i) => o   _ => AST.Expr.NilLit }
        var ig_obj_name: String = this.get_variable_name(ig_obj)
        if (ig_obj_name.length() > 0 and this.typed_vars.has(ig_obj_name)) {
            var ig_list_type: AST.Type = this.typed_vars.get(ig_obj_name)
            var ig_elem: AST.Type = this.get_list_element_type(ig_list_type)
            if (this.type_to_string(ig_elem) != "Any") {
                return this.type_to_string(ig_elem)
            }
            // Fallback: parse type string for List<X> pattern
            var ig_vtype: String = this.type_to_string(ig_list_type)
            if (ig_vtype.starts_with("List<") and ig_vtype.ends_with(">")) {
                return ig_vtype.slice(5, ig_vtype.length() - 1)
            }
        }
        return "Any"
    }
    if (ek == "index_set") return "Any"
    if (ek == "set_field") return "Any"
    return "Any"
    }

    fun gen_list_lit(elements: List<AST.Expr>): String {
    var list_val: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(list_val, "i64", "__list_new", ""))
    } else {
        this.emit_indent(list_val + " = call i64 @__list_new()")
    }
    // The element type used to be recognised from a two-entry whitelist — String,
    // or Int/Float collapsed to Int — and everything else stayed Any. A list of
    // class instances therefore produced `List<Any>`, so `un[0].to_string()` had an
    // untyped receiver, dispatch was dropped, and the raw pointer printed as a
    // subnormal double (BUGS #117). Annotating the variable was the workaround.
    //
    // Take whatever type the element actually has instead of enumerating the ones
    // we happen to know. Homogeneity is required: a `List<T>` that lies is worse
    // than `List<Any>`, because Any routes to the runtime dispatch that already
    // handles scalars, while a wrong T dispatches statically to the wrong class.
    // Mixed lists stay Any, matching the checker's arm for the same expression.
    //
    // Float is no longer folded into Int. That fold predates the Int/Float split
    // and is a lie the moment anything reads the element type back — except in
    // identity mode, where the two really are one representation, and get_expr_type
    // already answers "Int" for a float there.
    var elem_type: AST.Type = AST.Type.AnyType
    var i: Float = 0
    while (i < elements.length()) {
        if (i == 0) {
            var ft: String = this.get_expr_type(elements[0])
            var homogeneous: Bool = true
            var hj: Float = 1
            while (hj < elements.length()) {
                if (this.get_expr_type(elements[hj]) != ft) { homogeneous = false }
                hj = hj + 1
            }
            if (homogeneous and ft.length() > 0 and ft != "Any") {
                elem_type = this.str_to_type(ft)
            }
        }
        var elem: String = this.gen_arg_value(elements[i])
        var discard_lp: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(discard_lp, "i64", "__list_push", "i64 " + list_val + ", i64 " + elem))
        } else {
            this.emit_indent(discard_lp + " = call i64 @__list_push(i64 " + list_val + ", i64 " + elem + ")")
        }
        i = i + 1
    }
    this.last_type = this.make_generic_type("List", [elem_type])
    return list_val
    }

    fun gen_index_get(object: AST.Expr, index: AST.Expr): String {
    var obj_name: String = this.get_variable_name(object)
    // Block tuple indexing: must use ._0, ._1 etc.
    if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
        var ig_ttype: String = this.type_to_string(this.typed_vars.get(obj_name))
        if (ig_ttype.starts_with("Tuple<")) {
            // Recorded into the sink for --json, but deliberately NOT routed through
            // codegen_error: unlike every other site here, this one prints an error
            // and never sets has_errors, so the compile currently exits 0. That is
            // a latent BUGS #37 shape, but flipping it to fatal is a behavior change
            // that belongs in its own commit, not smuggled in under a diagnostics
            // refactor. Preserve the current fatality; surface the message as data.
            IO.println("[codegen] Error: use ._0, ._1 etc. to access tuple fields (not indexing)")
            Diag.record_error("codegen", AST.span_none(), "use ._0, ._1 etc. to access tuple fields (not indexing)")
        }
    }
    // Map indexing: map["key"] → __map_get(map, key)
    if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
        var ig_otype: String = this.type_to_string(this.typed_vars.get(obj_name))
        if (ig_otype.starts_with("Map")) {
            var map_obj: String = this.gen_arg_value(object)
            // Key passed through NaN-boxed, NOT untagged — see Map.set. The
            // runtime's __map_key_cmp reads the tag to tell string keys from
            // numeric ones; untagging here destroyed that discriminator.
            var key_raw: String = this.gen_arg_value(index)
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__map_get(i64 " + map_obj + ", i64 " + key_raw + ")")
            if (ig_otype.starts_with("Map<")) {
                var val_type_str: String = this.get_map_value_type(ig_otype)
                this.last_type = this.str_to_type(val_type_str)
            } else {
                this.last_type = AST.Type.AnyType
            }
            return local
        }
    }
    // Subscript overloading: obj[key] → obj.getItem(key) when the receiver is a
    // user class declaring `getItem`. `Indexable` in src/lib/prelude.sf has
    // specified this protocol all along, but nothing ever implemented it: the
    // arms above handle Map and String and everything else fell through to the
    // list path below, which calls __list_length on the instance pointer and
    // reads a class struct as a list header — SIGSEGV. That is what crashed
    // test/pass/getitem_overload.sf (BUGS #94).
    //
    // Resolved before `gen_arg_value(object)` runs: emitting the receiver first
    // and deciding dispatch after is the preamble hazard that BUGS #70 is about.
    // Class resolution mirrors gen_binary's operator-overload path, including
    // its fallback for a non-variable receiver (a constructor call, `this.f`, a
    // method result), and it likewise accepts get_expr_type's answer only when
    // it names a declared class.
    //
    // The lookup goes through generic_base_name: class_fields, class_methods and
    // the ClassName__method symbols are all keyed by the *bare* name, while a
    // variable's declared type carries its arguments. Testing
    // `class_fields.has("Box<String>")` is always false, so before this every
    // generic receiver skipped this arm and fell straight into the list path
    // that segfaults (BUGS #95).
    // `gi_recv_type` keeps the full spelling ("Box<String>") because that is what
    // resolves the method's type parameters; `gi_class` is the bare name used for
    // every table and symbol lookup.
    var gi_recv_type: String = ""
    if (obj_name.length() > 0) {
        gi_recv_type = this.get_var_type_str(obj_name)
    }
    var gi_class: String = this.generic_base_name(gi_recv_type)
    if (!this.class_fields.has(gi_class)) {
        var gi_inferred_full: String = this.get_expr_type(object)
        var gi_inferred: String = this.generic_base_name(gi_inferred_full)
        if (this.class_fields.has(gi_inferred)) {
            gi_class = gi_inferred
            gi_recv_type = gi_inferred_full
        } else {
            gi_class = ""
            gi_recv_type = ""
        }
    }
    if (gi_class.length() > 0 and this.class_methods.has(gi_class)) {
        var gi_methods: List = this.class_methods.get(gi_class)
        if (gi_methods.contains("getItem")) {
            var gi_recv: String = this.gen_arg_value(object)
            var gi_key: String = this.gen_arg_value(index)
            var gi_target: String = gi_class + "__getItem"
            if (this.func_prefix_map.has(gi_target)) {
                gi_target = this.func_prefix_map.get(gi_target)
            } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions, this.current_prefix + gi_target)) {
                gi_target = this.current_prefix + gi_target
            }
            this.called_functions.push(gi_target)
            var gi_local: String = this.fresh_local()
            this.emit_indent(gi_local + " = call i64 @" + gi_target + "(i64 " + gi_recv + ", i64 " + gi_key + ")")
            // The declared return type, when known, with the receiver's class
            // type arguments substituted in: `class Box<T>` declaring
            // `fun getItem(k: Int): T` returns a String for a `Box<String>`.
            // Without that step last_type would be the bare "T", which names no
            // representation and makes every downstream dispatch miss.
            //
            // Falling back to Any rather than to the receiver's class: getItem
            // returns an *element*, and claiming the container type would
            // misroute the next dispatch.
            if (this.func_ret_types.has(gi_target)) {
                var gi_ret: AST.Type = this.func_ret_types.get(gi_target)
                var gi_ret_str: String = this.type_to_string(gi_ret)
                var gi_subst: String = this.substitute_class_type_params(gi_ret_str, gi_recv_type)
                if (gi_subst != gi_ret_str) {
                    this.last_type = this.str_to_type(gi_subst)
                } else {
                    this.last_type = gi_ret
                }
            } else {
                this.last_type = AST.Type.AnyType
            }
            return gi_local
        }
    }
    var obj: String = this.gen_arg_value(object)
    var obj_type: AST.Type = this.last_type
    // String indexing: s[i] → __str_get(s, i), a one-character String.
    // Without this the list path runs against a char*, reading a character as
    // if it were a list header (BUGS #29). It also blocked `for (c in "ab")`,
    // since the for-in desugaring is index-based. __str_get does its own
    // bounds check and negative-index adjustment, so the length/select dance
    // below is skipped entirely.
    if (this.type_to_string(obj_type) == "String") {
        var sg_idx_tagged: String = this.gen_arg_value(index)
        var sg_idx: String = this.emit_untag_index(sg_idx_tagged, this.last_type)
        var sg_local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(sg_local, "i64", "__str_get", "i64 " + obj + ", i64 " + sg_idx))
        } else {
            this.emit_indent(sg_local + " = call i64 @__str_get(i64 " + obj + ", i64 " + sg_idx + ")")
        }
        this.called_functions.push("__str_get")
        this.last_type = AST.Type.StringType
        return sg_local
    }
    // An UNRESOLVED receiver is not a list. Everything above this point handled a
    // receiver whose static type is known — Map, a getItem class, String — and the
    // list path below is what is left, so it has been acting as the default for
    // "no idea what this is". It calls __list_length on the value as given, which
    // inttoptr's a NaN-tagged String and reads character bytes as a list header:
    // SIGSEGV. That default is the shared root of BUGS #29, #93, #94 and #95, each
    // fixed by adding one more static type above it; this routes the leftover case
    // to __any_index_get, which discriminates on the GC type tag at runtime the way
    // __any_length already does for `.length()` (BUGS #153).
    //
    // `Any` is INCLUDED. It is tempting to exclude it on the theory that an
    // untyped receiver reaching a subscript is usually a List, and keeping it on
    // the static path costs nothing — that was the first version of this fix, and
    // it left the bug in place for the exact chain that reported it. `Any` is not
    // a hint that the value is a List; it is the compiler saying it does not know,
    // which is precisely when a runtime tag check is required. It is also what
    // this very arm returns, so an unannotated `a[i][j]` feeds `Any` straight back
    // in and the second subscript would take the crashing path.
    //
    // Only the List and Tuple spellings keep the static path, so nothing whose
    // representation is actually known changes shape. String and Map were both
    // handled above and never arrive here.
    var ig_obj_type_str: String = this.type_to_string(obj_type)
    var ig_unresolved: Bool = !ig_obj_type_str.starts_with("List") and !ig_obj_type_str.starts_with("Tuple")
    if (ig_unresolved) {
        // The subscript goes over still NaN-boxed. __any_index_get needs the tag
        // to treat a Map key as a key rather than an ordinal, and it untags for
        // the List/String cases itself — codegen cannot make that choice here
        // precisely because it does not know the receiver.
        var ai_idx: String = this.gen_arg_value(index)
        this.called_functions.push("__any_index_get")
        // The auto-declare in output_body.sf defaults to arity 1, so a two-argument
        // runtime helper that is not in runtime_declares() gets a `declare i64
        // @__any_index_get(i64)` that contradicts its definition and fails to link —
        // the BUGS #85 shape. Record the real arity instead of relying on the default.
        this.called_function_arity.set("__any_index_get", 2)
        var ai_res: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(ai_res, "i64", "__any_index_get", "i64 " + obj + ", i64 " + ai_idx))
        } else {
            this.emit_indent(ai_res + " = call i64 @__any_index_get(i64 " + obj + ", i64 " + ai_idx + ")")
        }
        // Any, not the receiver's type: this is an *element*, and claiming the
        // container's type would misroute the next dispatch — the same reasoning
        // the getItem arm above records for its fallback.
        this.last_type = AST.Type.AnyType
        return ai_res
    }
    var idx_tagged: String = this.gen_arg_value(index)
    // Untag the index for arithmetic and runtime call. A Float index is
    // converted, not bit-reinterpreted (BUGS #52).
    var idx: String = this.emit_untag_index(idx_tagged, this.last_type)
    // Negative indexing: if idx < 0, use length + idx
    var is_neg: String = this.fresh_local()
    this.emit_indent(is_neg + " = icmp slt i64 " + idx + ", 0")
    var len: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(len, "i64", "__list_length", "i64 " + obj))
    } else {
        this.emit_indent(len + " = call i64 @__list_length(i64 " + obj + ")")
    }
    var adjusted: String = this.fresh_local()
    this.emit_indent(adjusted + " = add i64 " + len + ", " + idx)
    var final_idx: String = this.fresh_local()
    this.emit_indent(final_idx + " = select i1 " + is_neg + ", i64 " + adjusted + ", i64 " + idx)
    var local: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(local, "i64", "__list_get", "i64 " + obj + ", i64 " + final_idx))
        // LLVM lib parallel path: track index_get result
        if (!this.identity_mode) {
            var ig_res: LLVMTypes.Value = this.llvm_block_builder.call("__list_get", LLVMTypes.Type.I64, [])
            this.llvm_values.set(local, ig_res)
        }
    } else {
        this.emit_indent(local + " = call i64 @__list_get(i64 " + obj + ", i64 " + final_idx + ")")
    }
    // Extract element type from the list's generic type
    var idx_elem_type: AST.Type = this.get_list_element_type(obj_type)
    if (this.type_to_string(idx_elem_type) == "Any" and obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
        idx_elem_type = this.get_list_element_type(this.typed_vars.get(obj_name))
        if (this.type_to_string(idx_elem_type) == "Any") {
            var vtype: String = this.type_to_string(this.typed_vars.get(obj_name))
            if (vtype.starts_with("List<") and vtype.ends_with(">")) {
                var inner: String = vtype.slice(5, vtype.length() - 1)
                idx_elem_type = this.str_to_type(inner)
            }
        }
    }
    if (this.type_to_string(idx_elem_type) != "Any") {
        this.last_type = idx_elem_type
    } else {
        this.last_type = AST.Type.AnyType
    }
    // Tuple type: extract Nth element type from Tuple<T1,T2,...>
    var obj_type_str: String = this.type_to_string(obj_type)
    if (obj_type_str.starts_with("Tuple") or (obj_name.length() > 0 and this.typed_vars.has(obj_name) and this.type_to_string(this.typed_vars.get(obj_name)).starts_with("Tuple<"))) {
        var full_type: String = obj_type_str
        if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
            full_type = this.type_to_string(this.typed_vars.get(obj_name))
        }
        if (full_type.starts_with("Tuple<") and full_type.ends_with(">")) {
            var tuple_inner: String = full_type.slice(6, full_type.length() - 1)
            var tuple_args: List<String> = this.split_type_args(tuple_inner)
            var ct_idx: Float = -1
            var idx_ek: String = this.classify_expr(index)
            if (idx_ek == "int") {
                ct_idx = match (index) { IntLit(v) => v   _ => -1 }
            }
            if (ct_idx >= 0 and ct_idx < tuple_args.length()) {
                this.last_type = this.str_to_type(tuple_args[ct_idx])
            }
        }
    }
    return local
    }

    fun gen_index_set(object: AST.Expr, index: AST.Expr, value: AST.Expr): String {
    var obj: String = this.gen_arg_value(object)
    var idx_tagged: String = this.gen_arg_value(index)
    // A Float index is converted, not bit-reinterpreted (BUGS #52).
    var idx: String = this.emit_untag_index(idx_tagged, this.last_type)
    var val: String = this.gen_arg_value(value)
    var discard_ls: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(discard_ls, "i64", "__list_set", "i64 " + obj + ", i64 " + idx + ", i64 " + val))
    } else {
        this.emit_indent(discard_ls + " = call i64 @__list_set(i64 " + obj + ", i64 " + idx + ", i64 " + val + ")")
    }
    return val
    }

    /// The module prefix an extension method's symbol must carry: the prefix of
    /// the class being EXTENDED, not of the file the `extend fun` is written in.
    /// `extend fun Ctx.ay()` in other.sf, with Ctx declared in core.sf, emits
    /// @core_Ctx__ay.
    ///
    /// Factored out because two callers must agree exactly: this and the
    /// pre-registration loop in generate_with_modules_flat_opts3. If they
    /// disagreed, the pre-registered symbol would name a function that is never
    /// defined — trading BUGS #103's link error for a different one.
    ///
    /// The two lookups are ordered so both callers land on the same answer even
    /// though they run at different times. At pre-scan time no class has been
    /// lowered, so func_prefix_map is empty and class_struct_names (filled by the
    /// class pre-registration loop) answers. At lowering time func_prefix_map has
    /// the entry and answers first. Both are `<module prefix> + <class name>` for
    /// the same class, so the two agree by construction.
    fun extend_class_prefix(ext_class: String, fallback: String): String {
        var init_key: String = ext_class + "__init"
        if (this.func_prefix_map.has(init_key)) {
            var mapped: String = this.func_prefix_map.get(init_key)
            return mapped.slice(0, mapped.length() - init_key.length())
        }
        // A class with no `init` at all has no entry above. Without this second
        // lookup such a class fell back to the *source file's* prefix, so an
        // extension method on it emitted under the wrong module.
        if (this.class_struct_names.has(ext_class)) {
            var struct_name: String = this.class_struct_names.get(ext_class)
            if (struct_name.ends_with(ext_class)) {
                return struct_name.slice(0, struct_name.length() - ext_class.length())
            }
        }
        return fallback
    }

    /// Register the SYMBOL of every `extend fun` in stmts[start..end) before any
    /// body is lowered (BUGS #103).
    ///
    /// gen_extend_method below registers `Ctx__bx -> core_Ctx__bx` in
    /// func_prefix_map only as it lowers that method, so a call generated BEFORE
    /// the callee was lowered found nothing and resolve_method_symbol fell through
    /// to an unprefixed guess — `@Ctx__bx` against a definition actually named
    /// `@core_Ctx__bx`. That passes codegen and dies at link time. Two `extend
    /// fun`s in different modules calling each other hit it in BOTH import orders,
    /// each order naming the other direction's symbol, so no ordering fixed it.
    ///
    /// Invisible in a single file because there the prefix is "" and the guess is
    /// accidentally right. It only breaks once the code lives in a module.
    ///
    /// Must run after class pre-registration: extend_class_prefix reads
    /// class_struct_names to find the extended class's module.
    fun prescan_extend_symbols(stmts: List<AST.Stmt>, start: Float, end: Float, prefix: String) {
        var xi: Float = start
        while (xi < end) {
            var xdoc: String = this.get_fun_doc(stmts[xi])
            if (xdoc.starts_with("@extend:")) {
                var xname: String = this.get_fun_name(stmts[xi])
                var xcls: String = xdoc.slice(8, xdoc.length())
                if (xname.length() > 0 and xcls.length() > 0) {
                    var xfull: String = xcls + "__" + xname
                    var xprefixed: String = this.extend_class_prefix(xcls, prefix) + xfull
                    this.func_prefix_map.set(xfull, xprefixed)
                    if (!this.str_in_list(this.known_functions, xprefixed)) {
                        this.known_functions.push(xprefixed)
                    }
                    if (!this.str_in_list(this.known_functions, xfull)) {
                        this.known_functions.push(xfull)
                    }
                    // The receiver's method list too, or gen_method_call's
                    // "type 'X' has no method 'y'" check rejects a call compiled
                    // before the extend fun is lowered.
                    if (this.class_methods.has(xcls)) {
                        var xmethods: List<String> = this.class_methods.get(xcls)
                        if (!this.str_in_list(xmethods, xname)) { xmethods.push(xname) }
                    }
                    var xret: String = this.get_fun_ret(stmts[xi])
                    if (xret.length() > 0) {
                        this.func_ret_types.set(xprefixed, this.str_to_type(xret))
                        this.func_ret_types.set(xfull, this.str_to_type(xret))
                    }
                }
            }
            xi = xi + 1
        }
    }

    fun gen_extend_method(ext_class: String, name: String, params: List<AST.Param>, ret_type: String, body: List<AST.Stmt>) {
    var full_name: String = ext_class + "__" + name
    // Use target class's prefix (not source file's prefix)
    var class_prefix: String = this.extend_class_prefix(ext_class, this.current_prefix)
    var prefixed: String = class_prefix + full_name
    this.known_functions.push(prefixed)
    this.known_functions.push(full_name)
    this.func_ret_types.set(prefixed, this.str_to_type(ret_type))
    this.func_ret_types.set(full_name, this.str_to_type(ret_type))
    this.func_prefix_map.set(full_name, prefixed)
    if (this.class_methods.has(ext_class)) {
        var methods: List = this.class_methods.get(ext_class)
        methods.push(name)
    }
    var params_str: String = this.params_to_string(params)
    var full_params: String = "self:Int"
    if (params_str.length() > 0) { full_params = full_params + "," + params_str }
    var saved_class: String = this.current_class
    var saved_prefix: String = this.current_prefix
    this.current_class = ext_class
    this.current_prefix = class_prefix
    this.gen_function(full_name, full_params, ret_type, body)
    this.current_class = saved_class
    this.current_prefix = saved_prefix
    }

    fun set_result_type(result_type: String) {
    if (result_type == "Nil") { this.last_type = AST.Type.NilType }
    else if (result_type == "Int") { this.last_type = AST.Type.IntType }
    else if (result_type == "Bool") { this.last_type = AST.Type.BoolType }
    else if (result_type == "String") { this.last_type = AST.Type.StringType }
    else if (result_type == "List") { this.last_type = this.make_list_type() }
    else if (result_type == "ListStr") { this.last_type = this.make_list_str_type() }
    }

    fun tag_builtin_result(raw: String, result_type: String): String {
    if (result_type == "String") {
        var ptr: String = this.fresh_local()
        this.emit_indent(ptr + " = inttoptr i64 " + raw + " to i8*")
        return this.emit_tag_ptr(ptr)
    }
    if (result_type == "Bool") {
        return this.emit_tag_bool(raw)
    }
    if (result_type == "Int") {
        return this.emit_tag_int(raw)
    }
    return raw
    }

    fun emit_builtin_dispatch(obj: String, method: String, args: List<AST.Expr>): String {
    var desc: String = this.builtin_methods.get(method)
    var parts: List<String> = desc.split("|")
    var pattern: String = parts[0]
    var func_name: String = parts[1]
    var result_type: String = parts[2]
    var needs_push: String = parts[3]
    if (needs_push == "1") { this.called_functions.push(func_name) }
    if (pattern == "v2") {
        var val: String = this.gen_arg_value(args[0])
        var discard: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(discard, "i64", func_name, "i64 " + obj + ", i64 " + val))
        } else {
            this.emit_indent(discard + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + val + ")")
        }
        this.set_result_type(result_type)
        return "0"
    }
    if (pattern == "v3") {
        var a1: String = this.gen_arg_value(args[0])
        var a2: String = this.gen_arg_value(args[1])
        var discard: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(discard, "i64", func_name, "i64 " + obj + ", i64 " + a1 + ", i64 " + a2))
        } else {
            this.emit_indent(discard + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ", i64 " + a2 + ")")
        }
        this.set_result_type(result_type)
        return "0"
    }
    if (pattern == "r1") {
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "r2") {
        var val: String = this.gen_arg_value(args[0])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + val))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + val + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "p1") {
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "p2") {
        var a1: String = this.gen_arg_value(args[0])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + a1))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "p3") {
        var a1: String = this.gen_arg_value(args[0])
        var a2: String = this.gen_arg_value(args[1])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + a1 + ", i64 " + a2))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ", i64 " + a2 + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    if (pattern == "m2") {
        var a1: String = this.gen_arg_value(args[0])
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", func_name, "i64 " + obj + ", i64 " + a1))
        } else {
            this.emit_indent(local + " = call i64 @" + func_name + "(i64 " + obj + ", i64 " + a1 + ")")
        }
        this.set_result_type(result_type)
        return this.tag_builtin_result(local, result_type)
    }
    this.set_result_type(result_type)
    return "0"
    }

    // Resolve a class method symbol the way gen_namespace_call does inline
    // (func_prefix_map, then module prefix, then a known_functions suffix match).
    // Factored out so gen_virtual_dispatch forms each subclass arm's callee the
    // same way the static default is formed.
    fun resolve_method_symbol(bare_class: String, method: String): String {
        var full: String = bare_class + "__" + method
        if (this.func_prefix_map.has(full)) { return this.func_prefix_map.get(full) }
        if (this.current_prefix.length() > 0 and this.known_functions.contains(this.current_prefix + full)) {
            return this.current_prefix + full
        }
        if (this.known_functions.contains(full)) { return full }
        var kfi: Float = 0
        while (kfi < this.known_functions.length()) {
            if (this.known_functions[kfi].ends_with(full)) { return this.known_functions[kfi] }
            kfi = kfi + 1
        }
        // Nothing matched. This used to `return full` — the unprefixed guess. That
        // guess is right only when the symbol carries no module prefix, so in a
        // module it named a function that does not exist, passed codegen, and died
        // at link time with "use of undefined value" (BUGS #103).
        //
        // The guess was load-bearing until extension methods were pre-registered:
        // before prescan_extend_symbols, an `extend fun` not yet lowered was absent
        // from all four lookups above, and the guess accidentally saved the
        // single-file case. With pre-registration every method — declared in a class
        // body or added by `extend fun`, in any module or the main program — is in
        // func_prefix_map or known_functions before any body is lowered, so reaching
        // here means the method genuinely does not exist. Report it instead of
        // emitting a call to a name that was never defined.
        this.codegen_error("no symbol for method '" + method + "' on class '" + bare_class + "' — expected '" + full + "' or a module-prefixed form, found neither.")
        return full
    }

    // The struct name that actually implements `method` for the class whose
    // struct name is `struct_c` — the nearest class at or above it that declares
    // the method itself (class_own_methods). "" if none does.
    //
    // Searches every base, not one chain, so a method supplied by the 2nd or 3rd
    // interface of `extends A, B, C` has an owner. Bases are visited in
    // declaration order at each level (all_ancestor_structs is breadth-first),
    // matching the first-wins rule the forwarder emission uses.
    fun effective_method_owner(struct_c: String, method: String): String {
        if (this.class_own_methods.has(struct_c)) {
            var own0: List<String> = this.class_own_methods.get(struct_c)
            if (own0.contains(method)) { return struct_c }
        }
        var anc: List<String> = this.all_ancestor_structs(struct_c)
        var ai: Float = 0
        while (ai < anc.length()) {
            if (this.class_own_methods.has(anc[ai])) {
                var own: List<String> = this.class_own_methods.get(anc[ai])
                if (own.contains(method)) { return anc[ai] }
            }
            ai = ai + 1
        }
        return ""
    }

    // Does `struct_c`, or anything it inherits from, DECLARE `method` without a
    // body? Searched over the ancestors too, so a class extending an interface
    // that itself extends another interface still finds the declaration.
    //
    // The companion to effective_method_owner: that one answers "who supplies a
    // body", this one "is the name known but bodyless". Together they let
    // gen_virtual_dispatch distinguish an unrelated method from an abstract one
    // (BUGS #150).
    fun declares_abstract(struct_c: String, method: String): Bool {
        if (this.class_own_abstract.has(struct_c)) {
            var abs0: List<String> = this.class_own_abstract.get(struct_c)
            if (abs0.contains(method)) { return true }
        }
        var anc: List<String> = this.all_ancestor_structs(struct_c)
        var ai: Float = 0
        while (ai < anc.length()) {
            if (this.class_own_abstract.has(anc[ai])) {
                var absn: List<String> = this.class_own_abstract.get(anc[ai])
                if (absn.contains(method)) { return true }
            }
            ai = ai + 1
        }
        return false
    }

    // BUGS #50. A call statically bound to <ns>__<method> is only right when the
    // receiver is exactly ns; a subclass in an ns-typed slot (or `this` inside an
    // inherited method) needs its own override. Emit a switch on the receiver's
    // runtime class tag with an arm for each descendant of ns whose effective
    // implementation differs from ns's, calling that subclass's own symbol
    // (a real override or the forwarder codegen already emits). Returns "" when
    // nothing overrides — the caller then emits the plain static call, so the
    // common no-inheritance case pays nothing. Also "" in identity mode, where
    // there is no tag and __val_class_tag is not linked (the bootstrap keeps the
    // old static behaviour for the compiler's own source).
    fun gen_virtual_dispatch(ns: String, method: String, obj: String, full_method: String, arg_strs: List<String>, canonical: String): String {
        if (this.identity_mode) { return "" }
        // Resolve ns to a struct name (the key domain of class_parent_of /
        // class_type_ids / class_own_methods).
        var struct_ns: String = ns
        if (this.class_struct_names.has(ns)) { struct_ns = this.class_struct_names.get(ns) }
        if (!this.class_type_ids.has(struct_ns)) { return "" }
        var ns_owner: String = this.effective_method_owner(struct_ns, method)
        if (ns_owner.length() == 0) {
            // No class at or above ns supplies a body. That is either "ns has
            // nothing to do with this method" — bail, as before — or "ns declares
            // it abstractly", which is an interface. The second case is exactly
            // where dispatch matters MOST: the static call would go to the
            // abstract method's stub, which codegen emits as a bare `ret i64 0`,
            // so before BUGS #150 every call through an interface-typed receiver
            // silently did nothing and returned 0. Fall through with ns_owner ""
            // — no implementation to be equal to means every implementor below
            // is an override, which is precisely right for an interface.
            if (!this.declares_abstract(struct_ns, method)) { return "" }
        }
        // Collect descendant structs whose effective owner differs from ns's.
        var arm_tags: List<String> = []
        var arm_syms: List<String> = []
        var keys: List<String> = this.class_type_ids.keys()
        var ki: Float = 0
        while (ki < keys.length()) {
            var sc: String = keys[ki]
            if (sc != struct_ns) {
                // Is sc a descendant of struct_ns, through any of its bases? The
                // single-chain walk this replaces missed a class whose relation to
                // struct_ns runs through its 2nd or 3rd base, so a call typed at
                // the interface did not dispatch to that implementor.
                var is_desc: Bool = this.str_in_list(this.all_ancestor_structs(sc), struct_ns)
                if (is_desc) {
                    var sc_owner: String = this.effective_method_owner(sc, method)
                    if (sc_owner.length() > 0 and sc_owner != ns_owner) {
                        // The arm switches on sc's runtime tag (the concrete
                        // class) but must CALL sc_owner's symbol — the class that
                        // actually declares the method. When the concrete class
                        // inherits the method without redeclaring it (Base→Mid
                        // overrides, Leaf does not), no `Leaf__label` forwarder is
                        // ever emitted, so deriving the symbol from sc gave
                        // resolve_method_symbol a name that does not exist and it
                        // reported "no symbol for method" on a valid program
                        // (BUGS #135). sc_owner (Mid) is exactly the class whose
                        // symbol was emitted.
                        var bare: String = sc_owner
                        if (this.class_bare_of.has(sc_owner)) { bare = this.class_bare_of.get(sc_owner) }
                        var tag: Float = this.class_type_ids.get(sc)
                        arm_tags.push(tag.floor().to_string())
                        arm_syms.push(this.resolve_method_symbol(bare, method))
                    }
                }
            }
            ki = ki + 1
        }
        if (arm_tags.length() == 0) { return "" }
        // Emit: read tag, switch, one arm per overriding descendant, default is
        // the static symbol. obj is already evaluated by the caller.
        var vd_result: String = this.fresh_local()
        this.emit_indent(vd_result + " = alloca i64")
        var vd_tag: String = this.fresh_local()
        this.emit_indent(vd_tag + " = call i64 @__val_class_tag(i64 " + obj + ")")
        // __val_class_tag is declared in runtime_declares(); pushing it to
        // called_functions would trigger a second, conflicting auto-declare.
        var vd_default: String = this.fresh_label("vd.default")
        var vd_end: String = this.fresh_label("vd.end")
        var arm_labels: List<String> = []
        var ai: Float = 0
        while (ai < arm_tags.length()) {
            arm_labels.push(this.fresh_label("vd.arm"))
            ai = ai + 1
        }
        var cases: String = ""
        ai = 0
        while (ai < arm_tags.length()) {
            cases = cases + " i64 " + arm_tags[ai] + ", label %" + arm_labels[ai.floor()]
            ai = ai + 1
        }
        this.emit_terminator("switch i64 " + vd_tag + ", label %" + vd_default + " [" + cases + " ]")
        var args_joined: String = arg_strs.join(", ")
        ai = 0
        while (ai < arm_tags.length()) {
            this.start_block(arm_labels[ai.floor()])
            var ar: String = this.fresh_local()
            this.emit_indent(ar + " = call i64 @" + arm_syms[ai.floor()] + "(" + args_joined + ")")
            this.called_functions.push(arm_syms[ai.floor()])
            this.emit_indent("store i64 " + ar + ", i64* " + vd_result)
            this.emit_terminator("br label %" + vd_end)
            ai = ai + 1
        }
        this.start_block(vd_default)
        var dr: String = this.fresh_local()
        this.emit_indent(dr + " = call i64 @" + full_method + "(" + args_joined + ")")
        this.called_functions.push(full_method)
        this.emit_indent("store i64 " + dr + ", i64* " + vd_result)
        this.emit_terminator("br label %" + vd_end)
        this.start_block(vd_end)
        var vd_local: String = this.fresh_local()
        this.emit_indent(vd_local + " = load i64, i64* " + vd_result)
        if (this.func_ret_types.has(full_method)) {
            this.last_type = this.func_ret_types.get(full_method)
        } else if (this.func_ret_types.has(canonical)) {
            this.last_type = this.func_ret_types.get(canonical)
        } else {
            this.last_type = AST.Type.IntType
        }
        if (!this.identity_mode) {
            var vdr: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
            this.llvm_values.set(vd_local, vdr)
        }
        return vd_local
    }

    fun gen_namespace_call(ns: String, method: String, obj: String, args: List<AST.Expr>, has_self: Bool): String {
    // Check if 'method' is actually a function-type field (not a real method).
    // e.g. this.compute() where compute is `var compute: () => T`
    //
    // Every spelling of a function type has to be listed here, because the three
    // of them reach this point as three unrelated strings:
    //
    //   `(A, B) => R`   parses to FuncType, and func_type_string renders it
    //                   "Fun(A,B):R"          → starts_with("Fun(")
    //   `Fun<A, B, R>`  parses to GenericType("Fun", ...), and
    //                   generic_type_string renders it "Fun<A,B,R>"
    //   bare `Fun`      parses to ClassType("Fun") — NOT a FuncType — so
    //                   type_to_string returns it via the ClassType(n) arm as
    //                   the plain string "Fun", with no bracket of any kind
    //
    // Only the first was tested, so a `var f: Fun` field fell through to the
    // ordinary method path below and emitted a call to the symbol `Ns__f`, which
    // no definition exists for: the program failed to LINK rather than
    // miscompiling. Copying the field to a local first worked around it because
    // a local goes through gen_call's indirect path, which never consults a
    // field type at all. Bare `Fun` is the spelling `src/lib/heap.sf` uses for
    // its comparator, which is why that stdlib module could not link.
    // try_get_field_type, not get_field_type: this is asking whether `method` is
    // a function-typed FIELD rather than a real method, and "it is not a field"
    // is the answer for every ordinary method call in the program. A miss here is
    // not an inference gap, so it must not be reported as one.
    if (has_self and this.class_fields.has(ns)) {
        var ft: String = this.try_get_field_type(ns, method)
        var is_fn_type: Bool = ft.starts_with("Fun(") or ft.starts_with("Fun<") or ft == "Fun" or ft.starts_with("(") and ft.contains("=>") or ft.starts_with("() =>")
        if (is_fn_type) {
            // Check there's no actual method with this name
            var full_check: String = ns + "__" + method
            var has_method: Bool = this.known_functions.contains(full_check)
            if (!has_method and this.current_prefix.length() > 0) {
                has_method = this.known_functions.contains(this.current_prefix + full_check)
            }
            if (!has_method) {
                // Load the field value (a closure pair) and call it indirectly
                var struct_name: String = ns
                if (this.class_struct_names.has(ns)) {
                    struct_name = this.class_struct_names.get(ns)
                }
                var field_idx: Float = this.get_field_index(ns, method)
                var obj_ptr: String = this.val_to_typed_ptr(obj, "%" + struct_name + "*")
                var field_ptr: String = this.fresh_local()
                this.emit_indent(field_ptr + " = getelementptr %" + struct_name + ", %" + struct_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
                var field_val: String = this.fresh_local()
                this.emit_indent(field_val + " = load i64, i64* " + field_ptr)
                return this.gen_indirect_call(field_val, args)
            }
        }
    }

    var arg_strs: List<String> = []
    if (has_self) { arg_strs.push("i64 " + obj) }
    var i: Float = 0
    while (i < args.length()) {
        var val: String = this.gen_arg_value(args[i])
        arg_strs.push("i64 " + val)
        i = i + 1
    }
    var full_method: String = ns + "__" + method
    var canonical: String = full_method
    if (this.func_prefix_map.has(full_method)) {
        full_method = this.func_prefix_map.get(full_method)
    } else if (this.current_prefix.length() > 0 and this.known_functions.contains(this.current_prefix + full_method)) {
        full_method = this.current_prefix + full_method
    } else if (!this.known_functions.contains(full_method)) {
        var kfi: Float = 0
        while (kfi < this.known_functions.length()) {
            if (this.known_functions[kfi].ends_with(full_method)) {
                full_method = this.known_functions[kfi]
                kfi = this.known_functions.length()
            }
            kfi = kfi + 1
        }
    }
    this.called_functions.push(full_method)

    // Coroutine-aware method call: if this function is a coroutine and the
    // callee is also a coroutine, emit the await pattern instead of plain call.
    if (this.is_coroutine and this.str_in_list(this.coroutine_funcs, full_method)) {
        var mc_hdl: String = this.fresh_local()
        this.emit_indent(mc_hdl + " = call ptr @" + full_method + "(" + arg_strs.join(", ") + ")")
        var mc_hdl_i64: String = this.fresh_local()
        this.emit_indent(mc_hdl_i64 + " = ptrtoint ptr " + mc_hdl + " to i64")
        var mc_await_loop: String = this.fresh_label("await.loop")
        var mc_await_yield: String = this.fresh_label("await.yield")
        var mc_await_cleanup: String = this.fresh_label("await.cleanup")
        var mc_await_done: String = this.fresh_label("await.done")
        var mc_await_check: String = this.fresh_label("await.check")
        this.emit_terminator("br label %" + mc_await_check)
        this.start_block(mc_await_check)
        var mc_done: String = this.fresh_local()
        this.emit_indent(mc_done + " = call i64 @__sched_coro_done(i64 " + mc_hdl_i64 + ")")
        var mc_done_cmp: String = this.fresh_local()
        this.emit_indent(mc_done_cmp + " = icmp eq i64 " + mc_done + ", 1")
        this.emit_terminator("br i1 " + mc_done_cmp + ", label %" + mc_await_done + ", label %" + mc_await_yield)
        this.start_block(mc_await_yield)
        var mc_save: String = this.fresh_local()
        this.emit_indent(mc_save + " = call token @llvm.coro.save(ptr %__coro_hdl)")
        var mc_susp: String = this.fresh_local()
        this.emit_indent(mc_susp + " = call i8 @llvm.coro.suspend(token " + mc_save + ", i1 false)")
        this.emit_terminator("switch i8 " + mc_susp + ", label %__coro_suspend [i8 0, label %" + mc_await_loop + " i8 1, label %" + mc_await_cleanup + "]")
        this.start_block(mc_await_cleanup)
        this.emit_terminator("br label %__coro_cleanup")
        this.start_block(mc_await_loop)
        this.emit_indent("call void @__sched_coro_resume(i64 " + mc_hdl_i64 + ")")
        this.emit_terminator("br label %" + mc_await_check)
        this.start_block(mc_await_done)
        var mc_result: String = this.fresh_local()
        this.emit_indent(mc_result + " = load i64, i64* @__task_result")
        if (this.func_ret_types.has(full_method)) {
            this.last_type = this.func_ret_types.get(full_method)
        } else if (this.func_ret_types.has(canonical)) {
            this.last_type = this.func_ret_types.get(canonical)
        } else {
            this.last_type = AST.Type.IntType
        }
        return mc_result
    }

    // Sync-calls-coro for method calls: non-coroutine calling a coroutine method
    if (!this.is_coroutine and this.str_in_list(this.coroutine_funcs, full_method)) {
        var sc_hdl: String = this.fresh_local()
        this.emit_indent(sc_hdl + " = call ptr @" + full_method + "(" + arg_strs.join(", ") + ")")
        var sc_i64: String = this.fresh_local()
        this.emit_indent(sc_i64 + " = ptrtoint ptr " + sc_hdl + " to i64")
        var sc_check: String = this.fresh_label("sync.check")
        var sc_loop: String = this.fresh_label("sync.loop")
        var sc_done: String = this.fresh_label("sync.done")
        this.emit_terminator("br label %" + sc_check)
        this.start_block(sc_check)
        var sc_d: String = this.fresh_local()
        this.emit_indent(sc_d + " = call i64 @__sched_coro_done(i64 " + sc_i64 + ")")
        var sc_cmp: String = this.fresh_local()
        this.emit_indent(sc_cmp + " = icmp eq i64 " + sc_d + ", 1")
        this.emit_terminator("br i1 " + sc_cmp + ", label %" + sc_done + ", label %" + sc_loop)
        this.start_block(sc_loop)
        this.emit_indent("call void @__sched_coro_resume(i64 " + sc_i64 + ")")
        this.emit_terminator("br label %" + sc_check)
        this.start_block(sc_done)
        var sc_result: String = this.fresh_local()
        this.emit_indent(sc_result + " = load i64, i64* @__task_result")
        if (this.func_ret_types.has(full_method)) {
            this.last_type = this.func_ret_types.get(full_method)
        } else if (this.func_ret_types.has(canonical)) {
            this.last_type = this.func_ret_types.get(canonical)
        } else {
            this.last_type = AST.Type.IntType
        }
        return sc_result
    }

    // Virtual dispatch (BUGS #50): if this call resolves statically to
    // <ns>__<method> but some subclass of ns overrides method, the receiver may
    // actually be that subclass — a Dog held in an Animal-typed slot, or `this`
    // inside an inherited Animal method that is really a Dog. Switch on the
    // receiver's runtime class tag and call the subclass's own symbol. Correct
    // by construction: every class in the subtree already has a C__method symbol
    // (a real override or a forwarder), so an arm per overriding descendant plus
    // a default of the static symbol covers every case. Only plain sync methods
    // reach here — coroutine/actor dispatch returned above — which is exactly
    // #50's shape. obj is already evaluated, so this does not re-enter the
    // receiver expression (the #70 preamble hazard).
    if (has_self) {
        var vd: String = this.gen_virtual_dispatch(ns, method, obj, full_method, arg_strs, canonical)
        if (vd.length() > 0) { return vd }
    }

    var local: String = this.fresh_local()
    if (this.use_llvm_lib) {
        this.emit_indent(this.lib_call(local, "i64", full_method, arg_strs.join(", ")))
        // LLVM lib parallel path: track method call result as a call instruction
        if (!this.identity_mode) {
            var mc_arg_vals: List<LLVMTypes.Value> = []
            var mc_ai: Float = 0
            while (mc_ai < arg_strs.length()) {
                var mc_part: String = arg_strs[mc_ai]
                var mc_sp: Float = mc_part.index_of(" ")
                if (mc_sp > 0) {
                    var mc_reg: String = mc_part.slice(mc_sp + 1, mc_part.length())
                    mc_arg_vals.push(LLVMTypes.Value.Instruction(mc_reg, LLVMTypes.Type.I64))
                }
                mc_ai = mc_ai + 1
            }
            var mc_result2: LLVMTypes.Value = this.llvm_block_builder.call(full_method, LLVMTypes.Type.I64, mc_arg_vals)
            this.llvm_values.set(local, mc_result2)
        }
    } else {
        this.emit_indent(local + " = call i64 @" + full_method + "(" + arg_strs.join(", ") + ")")
    }
    if (this.func_ret_types.has(full_method)) {
        this.last_type = this.func_ret_types.get(full_method)
    } else if (this.func_ret_types.has(canonical)) {
        this.last_type = this.func_ret_types.get(canonical)
    } else {
        this.last_type = AST.Type.IntType
    }
    return local
    }

    /// Emit a call to the coroutine `target` and drive it to completion, returning
    /// the local holding its result. A coroutine is emitted `define ptr ...
    /// presplitcoroutine` and returns a *frame handle*, not a value, so a plain
    /// `call i64` against it reads the handle as the result AND never runs the
    /// suspension the callee asked for — that is BUGS #38 in both its symptoms
    /// (`Async.gather` returning `2,8`, and `Async.sleep` not sleeping: nothing
    /// reads __yield_reason, so reason 1 never reaches the scheduler's
    /// sleep_queue).
    ///
    /// Two shapes, picked by whether the *caller* is itself a coroutine:
    ///   - coro-calls-coro: suspend the caller between resumes, so the scheduler
    ///     stays in control and a sibling task can run.
    ///   - sync-calls-coro: spin the resume loop inline; there is no frame to
    ///     suspend.
    ///
    /// Callers set last_type themselves — the return-type key differs per arm
    /// (prefixed name, bare method, named-import target).
    fun gen_coro_call(target: String, arg_strs: List<String>): String {
        var hdl: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(hdl, "ptr", target, arg_strs.join(", ")))
        } else {
            this.emit_indent(hdl + " = call ptr @" + target + "(" + arg_strs.join(", ") + ")")
        }
        var hdl_i64: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_ptrtoint(hdl_i64, hdl))
        } else {
            this.emit_indent(hdl_i64 + " = ptrtoint ptr " + hdl + " to i64")
        }
        var check: String = this.fresh_label("await.check")
        var loop: String = this.fresh_label("await.loop")
        var done: String = this.fresh_label("await.done")
        this.emit_terminator("br label %" + check)
        this.start_block(check)
        var d: String = this.fresh_local()
        this.emit_indent(d + " = call i64 @__sched_coro_done(i64 " + hdl_i64 + ")")
        var cmp: String = this.fresh_local()
        this.emit_indent(cmp + " = icmp eq i64 " + d + ", 1")
        if (this.is_coroutine) {
            var yld: String = this.fresh_label("await.yield")
            var cleanup: String = this.fresh_label("await.cleanup")
            this.emit_terminator("br i1 " + cmp + ", label %" + done + ", label %" + yld)
            this.start_block(yld)
            // Suspend without touching __yield_reason/__yield_arg: the callee
            // already set them, and the scheduler must see the child's reason
            // (sleep, io, await) rather than a reason invented here.
            var save: String = this.fresh_local()
            this.emit_indent(save + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var susp: String = this.fresh_local()
            this.emit_indent(susp + " = call i8 @llvm.coro.suspend(token " + save + ", i1 false)")
            this.emit_terminator("switch i8 " + susp + ", label %__coro_suspend [i8 0, label %" + loop + " i8 1, label %" + cleanup + "]")
            this.start_block(cleanup)
            this.emit_terminator("br label %__coro_cleanup")
        } else {
            this.emit_terminator("br i1 " + cmp + ", label %" + done + ", label %" + loop)
        }
        this.start_block(loop)
        this.emit_indent("call void @__sched_coro_resume(i64 " + hdl_i64 + ")")
        this.emit_terminator("br label %" + check)
        this.start_block(done)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = load i64, i64* @__task_result")
        return result
    }

    // The boxing discipline for a runtime `__io_*`/`__os_*` symbol reached
    // through builtin-namespace dispatch (`IO.foo(...)` mangles straight to
    // `@__io_foo` and never enters the wrapper in src/lib/io.sf, so the wrapper's
    // return annotation is not consulted).
    //
    // Returns one of "string", "bool", "int", "list", "void", or "" for
    // not-a-runtime-symbol. This used to be three hardcoded `or` chains at the
    // call site, and the failure mode of that shape is that a symbol absent from
    // all three chains silently keeps `last_type = IntType`: `IO.readln()` and
    // `IO.read_line()` are aliases of `__io_readline`, which IS listed, but the
    // aliases were not, so both printed a raw heap address (`[5360378368]`)
    // instead of the line. The value itself was correct and correctly TAG_PTR'd
    // by the runtime — only codegen's *static* type was wrong, which is why
    // `.length()` on the same value returned 5 while interpolating it printed an
    // address. That asymmetry is the tell for this class of bug.
    //
    // Note this classifies the STATIC TYPE, and the tagging that follows is
    // idempotent: __io_read_file already returns __rt_tag_ptr'd memory and is
    // tagged again here, which is harmless because __val_tag_ptr masks the low 48
    // bits and re-ors TAG_PTR. Doubling an UNTAG is the unsafe direction (BUGS
    // #77) — do not read this as licence to double up in general.
    fun runtime_ret_discipline(fn: String): String {
        if (fn == "__io_read_file" or fn == "__io_readline" or fn == "__io_readln" or fn == "__io_read_line" or fn == "__io_read_stdin") { return "string" }
        if (fn == "__os_exec" or fn == "__os_env" or fn == "__os_cwd" or fn == "__os_path_sep" or fn == "__os_platform" or fn == "__os_home") { return "string" }
        if (fn == "__io_file_exists" or fn == "__os_file_exists" or fn == "__io_is_dir" or fn == "__io_rename" or fn == "__io_delete_file" or fn == "__os_set_env") { return "bool" }
        if (fn == "__io_file_size" or fn == "__io_read_binary" or fn == "__os_system") { return "int" }
        // Lists travel deliberately UNTAGGED. Tagging the returned list pointer
        // here segfaults: __gc_is_heap_ptr (gc.ll:615) rejects any NaN-tagged
        // value as a heap pointer, so a tagged __list_new() result stops being
        // traced and is swept while live. That is the caveat in BUGS #23, and it
        // is why "list" is a discipline of its own rather than an omission.
        // `__str_split` is the precedent and is also untagged at its call site.
        if (fn == "__io_walk_dir" or fn == "__io_list_dir" or fn == "__os_list_dir" or fn == "__os_args") { return "list" }
        if (fn == "__io_write_file" or fn == "__io_append_file" or fn == "__io_mkdir" or fn == "__os_mkdir") { return "void" }
        // Intercepted before generic dispatch, but listed so they are never
        // reported as unclassified.
        if (fn == "__io_println" or fn == "__io_print") { return "void" }
        return ""
    }

    fun resolve_namespace(obj_name: String, object: AST.Expr): String {
    if (obj_name == "this" or this.classify_expr(object) == "this") {
        return this.current_class
    }
    if (this.has_module_alias(obj_name)) { return obj_name }
    if (this.class_fields.has(obj_name)) { return obj_name }
    if (obj_name.length() > 0) {
        var vtype: String = this.get_var_type_str(obj_name)
        var resolved: String = this.resolve_class_type(vtype)
        if (resolved.length() > 0) { return resolved }
    }
    return ""
    }

    fun gen_method_call(object: AST.Expr, method: String, args: List<AST.Expr>): String {
    var obj_name: String = this.get_variable_name(object)

    // `__iter_get` — the for-in desugaring's element read (BUGS #62). Nothing
    // stops a user from spelling the name (there is no reserved-identifier rule
    // in the lexer), which is why __any_iter_get is total: it discriminates on
    // the receiver's GC type tag and falls through to a bounds-checked
    // __str_get, rather than trusting that the receiver is a collection.
    //
    // Decided HERE, above every arm that emits IR. `Alias.method()` dispatch
    // further down runs an unconditional gen_arg_value on the receiver before it
    // has decided anything, so an arm added below it emits a stray load for a
    // slot no prologue allocates — the same preamble hazard that made `super`
    // fail LLVM verification (BUGS #70).
    //
    // Static Map receivers could emit __map_* directly, but there is no reason
    // to: __any_iter_get discriminates by GC type tag, which also covers the
    // Any-typed and generic receivers where no static type is available — the
    // case that made the bug reachable through iter.sf's map/filter/reduce.
    if (method == "__iter_get" and args.length() == 1) {
        var __ig_obj: String = this.gen_arg_value(object)
        var __ig_idx_tagged: String = this.gen_arg_value(args[0])
        var __ig_idx: String = this.emit_untag_index(__ig_idx_tagged, this.last_type)
        this.called_functions.push("__any_iter_get")
        var __ig_res: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(__ig_res, "i64", "__any_iter_get", "i64 " + __ig_obj + ", i64 " + __ig_idx))
        } else {
            this.emit_indent(__ig_res + " = call i64 @__any_iter_get(i64 " + __ig_obj + ", i64 " + __ig_idx + ")")
        }
        // The element's type is whatever the collection holds: T for a List<T>,
        // String for a String, List<Any> for a Map, and Any when the receiver is
        // the desugaring's untyped temporary.
        this.last_type = this.iter_element_type(object)
        return __ig_res
    }

    // Self method calls: this.method(args)
    var obj_kind_early: String = this.classify_expr(object)
    if (obj_kind_early == "this" and this.current_class.length() > 0) {
        var self_val: String = this.fresh_local()
        this.emit_indent(self_val + " = load i64, i64* %self")
        return this.gen_namespace_call(this.current_class, method, self_val, args, true)
    }

    // super.method(args) — must be decided HERE, above the builtin-dispatch
    // preamble further down, which does an unconditional gen_arg_value(object).
    // `super` parses as an ordinary Variable node (parser.sf), so that preamble
    // emits `load i64, i64* %super` for a slot no prologue allocates, and the
    // module fails LLVM verification even though the call below is correct
    // (BUGS #70). Same reason the `this` receiver is handled just above.
    if (obj_name == "super" and this.current_parent.length() > 0) {
        var super_self: String = this.fresh_local()
        this.emit_indent(super_self + " = load i64, i64* %self")
        var super_args: List<String> = []
        super_args.push("i64 " + super_self)
        var super_i: Float = 0
        while (super_i < args.length()) {
            var super_arg: String = this.gen_arg_value(args[super_i])
            super_args.push("i64 " + super_arg)
            super_i = super_i + 1
        }
        var parent_method: String = this.current_parent + "__" + method
        this.called_functions.push(parent_method)
        var super_result: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(super_result, "i64", parent_method, super_args.join(", ")))
        } else {
            this.emit_indent(super_result + " = call i64 @" + parent_method + "(" + super_args.join(", ") + ")")
        }
        if (this.func_ret_types.has(parent_method)) {
            this.last_type = this.func_ret_types.get(parent_method)
        } else {
            this.last_type = AST.Type.StringType
        }
        return super_result
    }

    // Actor fire-and-forget: actor.send("method_name", args...)
    if (method == "send" and args.length() >= 1 and obj_name.length() > 0) {
        var send_obj_type: String = this.get_var_type_str(obj_name)
        var send_class: String = send_obj_type
        if (this.class_fields.has(send_obj_type) and this.actor_classes.has(send_obj_type)) {
            var send_method_name: String = this.get_string_literal(args[0])
            if (send_method_name.length() > 0) {
                var send_args = []
                var sai: Float = 1
                while (sai < args.length()) {
                    send_args.push(args[sai])
                    sai = sai + 1
                }
                var send_obj: String = this.gen_arg_value(object)
                return this.gen_namespace_call(send_class, send_method_name, send_obj, send_args, true)
            }
        }
    }

    // Package namespace dispatch: check named_imports for "Alias.method" pattern.
    // This handles package re-exports where Parsley.router → router_router.
    if (obj_name.length() > 0 and this.named_imports.has(obj_name + "." + method)) {
        var __pe_target: String = this.named_imports.get(obj_name + "." + method)
        this.called_functions.push(__pe_target)
        this.called_function_arity.set(__pe_target, args.length())

        // Check if this is a class constructor
        var __pe_is_ctor: Bool = false
        if (this.class_fields.has(method) or this.class_fields.has(__pe_target)) {
            __pe_is_ctor = true
        }

        if (__pe_is_ctor) {
            var __pe_instance: String = this.fresh_local()
            this.emit_indent(__pe_instance + " = call i64 @" + __pe_target + "()")
            var __pe_init: String = __pe_target + "__init"
            if (this.str_in_list(this.known_functions, __pe_init)) {
                var __pe_init_args: List<String> = []
                __pe_init_args.push("i64 " + __pe_instance)
                var __pei: Float = 0
                while (__pei < args.length()) {
                    __pe_init_args.push("i64 " + this.gen_arg_value(args[__pei]))
                    __pei = __pei + 1
                }
                var __pe_discard: String = this.fresh_local()
                this.emit_indent(__pe_discard + " = call i64 @" + __pe_init + "(" + __pe_init_args.join(", ") + ")")
            }
            this.last_type = this.str_to_type(method)
            return __pe_instance
        }

        // Regular function call
        var __pe_args: List<String> = []
        var __peai: Float = 0
        while (__peai < args.length()) {
            __pe_args.push("i64 " + this.gen_arg_value(args[__peai]))
            __peai = __peai + 1
        }
        // Same coroutine hazard as the module-prefix arm below (BUGS #38): a
        // re-exported or named-imported coroutine needs its frame driven, not a
        // bare `call i64`. `import { sleep } from "@async"` reaches here.
        if (this.str_in_list(this.coroutine_funcs, __pe_target)) {
            var __pe_coro: String = this.gen_coro_call(__pe_target, __pe_args)
            if (this.func_ret_types.has(__pe_target)) {
                this.last_type = this.func_ret_types.get(__pe_target)
            }
            return __pe_coro
        }
        var __pe_result: String = this.fresh_local()
        this.emit_indent(__pe_result + " = call i64 @" + __pe_target + "(" + __pe_args.join(", ") + ")")
        // Set return type from func_ret_types if available
        if (this.func_ret_types.has(__pe_target)) {
            this.last_type = this.func_ret_types.get(__pe_target)
        }
        return __pe_result
    }

    // Universal module dispatch: route through module prefix when the module
    // was properly imported (has a real prefix like "stdlib_os_").
    // Builtins with empty prefix (IO/OS/GC registered as "") fall through
    // to their hardcoded blocks below.
    if (obj_name.length() > 0 and this.has_module_alias(obj_name)) {
        var __mp: String = this.module_alias_prefix(obj_name)
        if (__mp.length() > 0) {
            var __mp_func: String = __mp + method
            // Method name remapping for GC functions that conflict with gc.ll globals.
            // Use ends_with on __mp_func to avoid identity-mode pointer comparison issues.
            if (__mp_func.starts_with("__gc_")) {
                if (__mp_func.ends_with("_stats")) { __mp_func = "__gc_debug_stats" }
                else if (__mp_func.ends_with("_alloc_count")) { __mp_func = "__gc_stat_alloc_count" }
                else if (__mp_func.ends_with("_total_bytes")) { __mp_func = "__gc_stat_total_bytes" }
                else if (__mp_func.ends_with("_threshold") and !__mp_func.ends_with("_set_threshold")) { __mp_func = "__gc_stat_threshold" }
                // Memory cap lives in the __mem_ namespace, not __gc_.
                // Check _set_max_memory before _max_memory: the former also
                // ends with the latter.
                else if (__mp_func.ends_with("_set_max_memory")) { __mp_func = "__mem_set_limit" }
                else if (__mp_func.ends_with("_max_memory")) { __mp_func = "__mem_get_limit" }
                else if (__mp_func.ends_with("_live_bytes")) { __mp_func = "__mem_live_bytes" }
            }
            // An @extern or @intrinsic must be recognised HERE, not only in the
            // module-prefix arm further down at :1630 — this arm intercepts
            // every alias with a non-empty prefix, so that arm never sees one.
            // Falling through emitted `call i64 @stdlib_scheduler_get_yield_reason`:
            // the Saffron-level symbol, which has no definition and no `declare`,
            // so the IR failed verification with "use of undefined value". Same
            // shape as the coroutine defect in this arm (BUGS #91, #38).
            // Registered before called_functions.push so the extern's C symbol,
            // not this name, is what gets declared.
            if (this.str_in_list(this.intrinsic_funcs, __mp_func)) {
                return this.gen_intrinsic_call(__mp_func, args)
            }
            if (this.extern_sigs.has(__mp_func)) {
                return this.gen_extern_call(__mp_func, args)
            }
            this.called_functions.push(__mp_func)

            // Check if this is a class constructor: class_fields has the method name
            // or the prefixed name, meaning it's a class not a plain function
            var __mp_is_ctor: Bool = false
            if (this.class_fields.has(method) or this.class_fields.has(__mp_func)) {
                __mp_is_ctor = true
            }

            if (__mp_is_ctor) {
                // Constructor: alloc instance, then call __init with args
                var __mp_instance: String = this.fresh_local()
                this.emit_indent(__mp_instance + " = call i64 @" + __mp_func + "()")
                // Find and call __init
                var __mp_init: String = __mp_func + "__init"
                if (this.str_in_list(this.known_functions,__mp_init)) {
                    var __mp_init_args: List<String> = []
                    __mp_init_args.push("i64 " + __mp_instance)
                    var __mpi: Float = 0
                    while (__mpi < args.length()) {
                        __mp_init_args.push("i64 " + this.gen_arg_value(args[__mpi]))
                        __mpi = __mpi + 1
                    }
                    var __mp_discard: String = this.fresh_local()
                    this.emit_indent(__mp_discard + " = call i64 @" + __mp_init + "(" + __mp_init_args.join(", ") + ")")
                }
                this.last_type = this.str_to_type(method)
                return __mp_instance
            }

            // IO.println / IO.print: pass value directly to runtime dispatch.
            // __io_println / __io_print handle all NaN-boxed types at runtime.
            // In identity mode (bootstrap), only strings reach here so raw pointer is safe.
            if ((__mp_func.starts_with("__io_println") or __mp_func.starts_with("__io_print")) and args.length() > 0) {
                var __io_arg: String = this.gen_arg_value(args[0])
                // An enum value is NOT self-describing at runtime (BUGS #105).
                // A fieldless variant is the bare immediate `tag << 56`, which
                // carries no NaN-box tag at all, so __io_println concluded it was
                // an unboxed double and printed the raw bit pattern: `Color.Red`
                // (0 << 56) as "0" and `Color.Green` (1 << 56) as "7.29112e-304".
                // A payload variant is an untagged heap [tag, f0, ...] pointer,
                // which reads as a denormal and printed as "5.21502e-310".
                //
                // Convert here, through the enum's own generated to_string, rather
                // than teaching __io_println the `tag << 56` encoding: that would
                // put the encoding in a second place that must be kept in step with
                // gen_enum_construct and emit_enum_to_string. String interpolation
                // was already correct precisely because the lexer inserts an
                // explicit .to_string() call, so routing here makes println use the
                // one path interpolation already uses instead of a parallel one.
                //
                // gen_arg_value has just run, so last_type is the argument's type —
                // and gen_enum_construct sets it to EnumType(name) even though
                // get_expr_type reports a bare "Any" for the same expression.
                var __io_ty: String = this.type_to_string(this.last_type)
                if (this.enum_defs.has(__io_ty)) {
                    var __io_ts: String = this.fresh_local()
                    this.emit_indent(__io_ts + " = call i64 @" + __io_ty + "__to_string(i64 " + __io_arg + ")")
                    __io_arg = this.fresh_local()
                    this.emit_indent(__io_arg + " = call i64 @__rt_tag_ptr(i64 " + __io_ts + ")")
                }
                var __io_discard: String = this.fresh_local()
                this.emit_indent(__io_discard + " = call i64 @" + __mp_func + "(i64 " + __io_arg + ")")
                this.last_type = AST.Type.NilType
                return "0"
            }

            // Named arg reordering + trailing closure + default filling
            var __mp_reordered: List<AST.Expr> = args
            var __mp_has_named: Bool = false
            var __mp_tc_applied: Bool = false
            // Trailing closure: last arg is lambda and fewer args than params
            if (this.func_param_names.has(__mp_func) and args.length() > 0) {
                var __mp_pnames: List<String> = this.func_param_names.get(__mp_func)
                var __mp_tc_last: AST.Expr = args[args.length() - 1]
                if (this.classify_expr(__mp_tc_last) == "lambda" and args.length() < __mp_pnames.length()) {
                    var __mp_tc_args: List<AST.Expr> = []
                    var __mp_tci: Float = 0
                    while (__mp_tci < args.length() - 1) {
                        __mp_tc_args.push(args[__mp_tci])
                        __mp_tci = __mp_tci + 1
                    }
                    var __mp_tc_has_named: Bool = false
                    var __mp_tcni: Float = 0
                    while (__mp_tcni < __mp_tc_args.length()) {
                        if (this.classify_expr(__mp_tc_args[__mp_tcni]) == "assign") {
                            __mp_tc_has_named = true
                        }
                        __mp_tcni = __mp_tcni + 1
                    }
                    var __mp_tc_new: List<AST.Expr> = []
                    if (__mp_tc_has_named) {
                        var __mp_pos_idx: Float = 0
                        var __mp_pi: Float = 0
                        while (__mp_pi < __mp_pnames.length() - 1) {
                            var __mp_pn: String = __mp_pnames[__mp_pi]
                            var __mp_found: Bool = false
                            var __mp_si: Float = 0
                            while (__mp_si < __mp_tc_args.length()) {
                                if (this.classify_expr(__mp_tc_args[__mp_si]) == "assign") {
                                    var __mp_an: String = match (__mp_tc_args[__mp_si]) { Assign(n, v, __as) => n
                                        _ => ""
                                    }
                                    if (__mp_an == __mp_pn) {
                                        var __mp_av: AST.Expr = match (__mp_tc_args[__mp_si]) { Assign(n, v, __as) => v
                                            _ => AST.Expr.NilLit
                                        }
                                        __mp_tc_new.push(__mp_av)
                                        __mp_found = true
                                    }
                                }
                                __mp_si = __mp_si + 1
                            }
                            if (!__mp_found) {
                                var __mp_used_pos: Bool = false
                                while (__mp_pos_idx < __mp_tc_args.length() and !__mp_used_pos) {
                                    if (this.classify_expr(__mp_tc_args[__mp_pos_idx]) != "assign") {
                                        __mp_tc_new.push(__mp_tc_args[__mp_pos_idx])
                                        __mp_pos_idx = __mp_pos_idx + 1
                                        __mp_used_pos = true
                                    } else {
                                        __mp_pos_idx = __mp_pos_idx + 1
                                    }
                                }
                                if (!__mp_used_pos) {
                                    __mp_tc_new.push(AST.Expr.NilLit)
                                }
                            }
                            __mp_pi = __mp_pi + 1
                        }
                    } else {
                        __mp_tci = 0
                        while (__mp_tci < __mp_tc_args.length()) {
                            __mp_tc_new.push(__mp_tc_args[__mp_tci])
                            __mp_tci = __mp_tci + 1
                        }
                        while (__mp_tc_new.length() < __mp_pnames.length() - 1) {
                            __mp_tc_new.push(AST.Expr.NilLit)
                        }
                    }
                    __mp_tc_new.push(__mp_tc_last)
                    __mp_reordered = __mp_tc_new
                    __mp_has_named = true
                    __mp_tc_applied = true
                }
            }
            // Check for named args (non-trailing-closure case)
            var __mp_nai: Float = 0
            while (__mp_nai < args.length()) {
                if (this.classify_expr(args[__mp_nai]) == "assign") {
                    __mp_has_named = true
                }
                __mp_nai = __mp_nai + 1
            }
            if (__mp_has_named and this.func_param_names.has(__mp_func) and !__mp_tc_applied) {
                var __mp_pnames2: List<String> = this.func_param_names.get(__mp_func)
                var __mp_new_args: List<AST.Expr> = []
                var __mp_pos_idx2: Float = 0
                var __mp_pi2: Float = 0
                while (__mp_pi2 < __mp_pnames2.length()) {
                    var __mp_pn2: String = __mp_pnames2[__mp_pi2]
                    var __mp_found2: Bool = false
                    var __mp_si2: Float = 0
                    while (__mp_si2 < args.length()) {
                        if (this.classify_expr(args[__mp_si2]) == "assign") {
                            var __mp_an2: String = match (args[__mp_si2]) { Assign(n, v, __as) => n
                                _ => ""
                            }
                            if (__mp_an2 == __mp_pn2) {
                                var __mp_av2: AST.Expr = match (args[__mp_si2]) { Assign(n, v, __as) => v
                                    _ => AST.Expr.NilLit
                                }
                                __mp_new_args.push(__mp_av2)
                                __mp_found2 = true
                            }
                        }
                        __mp_si2 = __mp_si2 + 1
                    }
                    if (!__mp_found2) {
                        var __mp_used_pos2: Bool = false
                        while (__mp_pos_idx2 < args.length() and !__mp_used_pos2) {
                            if (this.classify_expr(args[__mp_pos_idx2]) != "assign") {
                                __mp_new_args.push(args[__mp_pos_idx2])
                                __mp_pos_idx2 = __mp_pos_idx2 + 1
                                __mp_used_pos2 = true
                            } else {
                                __mp_pos_idx2 = __mp_pos_idx2 + 1
                            }
                        }
                        if (!__mp_used_pos2) {
                            __mp_new_args.push(AST.Expr.NilLit)
                        }
                    }
                    __mp_pi2 = __mp_pi2 + 1
                }
                __mp_reordered = __mp_new_args
            }
            var __mp_args: List<String> = []
            var __mpi: Float = 0
            while (__mpi < __mp_reordered.length()) {
                var __mp_used_def: Bool = false
                if (__mp_has_named and this.classify_expr(__mp_reordered[__mpi]) == "nil" and this.func_defaults.has(__mp_func)) {
                    var __mp_defs: List<AST.Expr> = this.func_defaults.get(__mp_func)
                    if (__mpi < __mp_defs.length() and this.classify_expr(__mp_defs[__mpi]) != "nil") {
                        var __mp_def_val: String = this.gen_arg_value(__mp_defs[__mpi])
                        __mp_args.push("i64 " + __mp_def_val)
                        __mp_used_def = true
                    }
                }
                if (!__mp_used_def) {
                    __mp_args.push("i64 " + this.gen_arg_value(__mp_reordered[__mpi]))
                }
                __mpi = __mpi + 1
            }
            // Fill missing args with defaults
            if (this.func_defaults.has(__mp_func)) {
                var __mp_defaults: List<AST.Expr> = this.func_defaults.get(__mp_func)
                var __mp_param_count: Float = __mp_defaults.length()
                if (this.func_param_names.has(__mp_func)) {
                    var __mp_pc2: Float = this.func_param_names.get(__mp_func).length()
                    if (__mp_pc2 > __mp_param_count) { __mp_param_count = __mp_pc2 }
                }
                while (__mpi < __mp_param_count) {
                    if (__mpi < __mp_defaults.length()) {
                        var __mp_de: AST.Expr = __mp_defaults[__mpi]
                        if (this.classify_expr(__mp_de) != "nil") {
                            __mp_args.push("i64 " + this.gen_arg_value(__mp_de))
                        } else {
                            var __mp_nil_val: String = this.fresh_local()
                            this.emit_indent(__mp_nil_val + " = call i64 @__val_nil()")
                            __mp_args.push("i64 " + __mp_nil_val)
                        }
                    } else {
                        var __mp_nil_val: String = this.fresh_local()
                        this.emit_indent(__mp_nil_val + " = call i64 @__val_nil()")
                        __mp_args.push("i64 " + __mp_nil_val)
                    }
                    __mpi = __mpi + 1
                }
            } else if (this.func_param_names.has(__mp_func)) {
                var __mp_param_count: Float = this.func_param_names.get(__mp_func).length()
                while (__mp_args.length() < __mp_param_count) {
                    var __mp_nil_val: String = this.fresh_local()
                    this.emit_indent(__mp_nil_val + " = call i64 @__val_nil()")
                    __mp_args.push("i64 " + __mp_nil_val)
                }
            }
            // Coroutine target: drive the frame instead of emitting `call i64`
            // against a `ptr`-returning presplitcoroutine (BUGS #38). This arm
            // catches every alias with a non-empty prefix, so it reaches here
            // before the coro-aware arms further down at :1608/:1658 — those only
            // ever ran for empty-prefix builtins (IO/OS/GC), which is why
            // `Async.sleep` lowered to a bare call and never suspended.
            if (this.str_in_list(this.coroutine_funcs, __mp_func)) {
                var __mp_coro: String = this.gen_coro_call(__mp_func, __mp_args)
                if (this.func_ret_types.has(__mp_func)) {
                    this.last_type = this.func_ret_types.get(__mp_func)
                } else if (this.func_ret_types.has(method)) {
                    this.last_type = this.func_ret_types.get(method)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return __mp_coro
            }
            var __mp_local: String = this.fresh_local()
            this.emit_indent(__mp_local + " = call i64 @" + __mp_func + "(" + __mp_args.join(", ") + ")")
            if (this.func_ret_types.has(__mp_func)) {
                this.last_type = this.func_ret_types.get(__mp_func)
            } else {
                this.last_type = AST.Type.IntType
            }
            // Box the result of a builtin runtime symbol per its declared
            // discipline. See runtime_ret_discipline above for why this is one
            // table rather than three `or` chains, and for the alias omission
            // (`__io_readln`/`__io_read_line`) that shape hid.
            var __mp_disc: String = this.runtime_ret_discipline(__mp_func)
            if (__mp_disc == "string") {
                var __tag_ptr: String = this.fresh_local()
                this.emit_indent(__tag_ptr + " = inttoptr i64 " + __mp_local + " to i8*")
                var __tagged: String = this.emit_tag_ptr(__tag_ptr)
                this.last_type = AST.Type.StringType
                return __tagged
            }
            if (__mp_disc == "bool") {
                var __tagged: String = this.emit_tag_bool(__mp_local)
                this.last_type = AST.Type.BoolType
                return __tagged
            }
            if (__mp_disc == "int") {
                var __tagged: String = this.emit_tag_int(__mp_local)
                this.last_type = AST.Type.IntType
                return __tagged
            }
            // "list" and "void" fall through deliberately untagged — see the
            // __gc_is_heap_ptr caveat in runtime_ret_discipline.
            return __mp_local
        }
    }



    // Package namespace dispatch (fallback path): same as the early check above,
    // handles cases that reach here after failing earlier conditions.
    if (obj_name.length() > 0 and this.named_imports.has(obj_name + "." + method)) {
        var __pe2_target: String = this.named_imports.get(obj_name + "." + method)
        this.called_functions.push(__pe2_target)
        this.called_function_arity.set(__pe2_target, args.length())
        var __pe2_is_ctor: Bool = false
        if (this.class_fields.has(method) or this.class_fields.has(__pe2_target)) {
            __pe2_is_ctor = true
        }
        if (__pe2_is_ctor) {
            var __pe2_inst: String = this.fresh_local()
            this.emit_indent(__pe2_inst + " = call i64 @" + __pe2_target + "()")
            var __pe2_init: String = __pe2_target + "__init"
            if (this.str_in_list(this.known_functions, __pe2_init)) {
                var __pe2_iargs: List<String> = []
                __pe2_iargs.push("i64 " + __pe2_inst)
                var __pe2i: Float = 0
                while (__pe2i < args.length()) {
                    __pe2_iargs.push("i64 " + this.gen_arg_value(args[__pe2i]))
                    __pe2i = __pe2i + 1
                }
                var __pe2_d: String = this.fresh_local()
                this.emit_indent(__pe2_d + " = call i64 @" + __pe2_init + "(" + __pe2_iargs.join(", ") + ")")
            }
            this.last_type = this.str_to_type(method)
            return __pe2_inst
        }
        var __pe2_args: List<String> = []
        var __pe2ai: Float = 0
        while (__pe2ai < args.length()) {
            __pe2_args.push("i64 " + this.gen_arg_value(args[__pe2ai]))
            __pe2ai = __pe2ai + 1
        }
        // Coroutine target — see the __pe_target arm above (BUGS #38).
        if (this.str_in_list(this.coroutine_funcs, __pe2_target)) {
            var __pe2_coro: String = this.gen_coro_call(__pe2_target, __pe2_args)
            if (this.func_ret_types.has(__pe2_target)) {
                this.last_type = this.func_ret_types.get(__pe2_target)
            }
            return __pe2_coro
        }
        var __pe2_r: String = this.fresh_local()
        this.emit_indent(__pe2_r + " = call i64 @" + __pe2_target + "(" + __pe2_args.join(", ") + ")")
        if (this.func_ret_types.has(__pe2_target)) {
            this.last_type = this.func_ret_types.get(__pe2_target)
        }
        return __pe2_r
    }

    // Check for module-qualified function calls BEFORE loading the object.
    // This avoids emitting a spurious `load i64, i64* %ModuleName` for module aliases
    // (e.g. AST.type_to_string → would load %AST which is undefined as a value).
    if (obj_name.length() > 0 and this.has_module_alias(obj_name)) {
        var prefixed_name: String = this.module_alias_prefix(obj_name) + method
        // Intrinsic check: if the target is an intrinsic, emit inline IR instead of a call
        if (this.str_in_list(this.intrinsic_funcs, prefixed_name)) {
            return this.gen_intrinsic_call(prefixed_name, args)
        }
        // Extern check: if the target is an extern C function, emit the proper extern call
        if (this.extern_sigs.has(prefixed_name)) {
            return this.gen_extern_call(prefixed_name, args)
        }
        var arg_strs: List<String> = []
        var ai: Float = 0
        while (ai < args.length()) {
            var val: String = this.gen_arg_value(args[ai])
            arg_strs.push("i64 " + val)
            ai = ai + 1
        }
        this.called_functions.push(prefixed_name)
        this.called_function_arity.set(prefixed_name, args.length())
        // Coro-calls-coro: if this is a coroutine calling another coroutine,
        // emit the await loop pattern (call as ptr, suspend/resume until done)
        if (this.is_coroutine and this.str_in_list(this.coroutine_funcs, prefixed_name)) {
            var b_hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(b_hdl, "ptr", prefixed_name, arg_strs.join(", ")))
            } else {
                this.emit_indent(b_hdl + " = call ptr @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
            }
            var b_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(b_i64, b_hdl))
            } else {
                this.emit_indent(b_i64 + " = ptrtoint ptr " + b_hdl + " to i64")
            }
            var ac: String = this.fresh_label("await.check")
            var ay: String = this.fresh_label("await.yield")
            var al: String = this.fresh_label("await.loop")
            var acl: String = this.fresh_label("await.cleanup")
            var ad: String = this.fresh_label("await.done")
            this.emit_terminator("br label %" + ac)
            this.start_block(ac)
            var bd: String = this.fresh_local()
            this.emit_indent(bd + " = call i64 @__sched_coro_done(i64 " + b_i64 + ")")
            var bdc: String = this.fresh_local()
            this.emit_indent(bdc + " = icmp eq i64 " + bd + ", 1")
            this.emit_terminator("br i1 " + bdc + ", label %" + ad + ", label %" + ay)
            this.start_block(ay)
            // Propagate child's yield_reason/yield_arg — don't overwrite
            var st: String = this.fresh_local()
            this.emit_indent(st + " = call token @llvm.coro.save(ptr %__coro_hdl)")
            var sr: String = this.fresh_local()
            this.emit_indent(sr + " = call i8 @llvm.coro.suspend(token " + st + ", i1 false)")
            this.emit_terminator("switch i8 " + sr + ", label %__coro_suspend [i8 0, label %" + al + " i8 1, label %" + acl + "]")
            this.start_block(acl)
            this.emit_terminator("br label %__coro_cleanup")
            this.start_block(al)
            this.emit_indent("call void @__sched_coro_resume(i64 " + b_i64 + ")")
            this.emit_terminator("br label %" + ac)
            this.start_block(ad)
            var coro_result: String = this.fresh_local()
            this.emit_indent(coro_result + " = load i64, i64* @__task_result")
            if (this.func_ret_types.has(prefixed_name)) {
                this.last_type = this.func_ret_types.get(prefixed_name)
            } else if (this.func_ret_types.has(method)) {
                this.last_type = this.func_ret_types.get(method)
            } else {
                this.last_type = AST.Type.IntType
            }
            return coro_result
        }
        // Sync-calls-coro: non-coroutine calling a coroutine — drive to completion
        if (!this.is_coroutine and this.str_in_list(this.coroutine_funcs, prefixed_name)) {
            var s_hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(s_hdl, "ptr", prefixed_name, arg_strs.join(", ")))
            } else {
                this.emit_indent(s_hdl + " = call ptr @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
            }
            var s_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(s_i64, s_hdl))
            } else {
                this.emit_indent(s_i64 + " = ptrtoint ptr " + s_hdl + " to i64")
            }
            var sc: String = this.fresh_label("sync.check")
            var sl: String = this.fresh_label("sync.loop")
            var sd: String = this.fresh_label("sync.done")
            this.emit_terminator("br label %" + sc)
            this.start_block(sc)
            var s_done: String = this.fresh_local()
            this.emit_indent(s_done + " = call i64 @__sched_coro_done(i64 " + s_i64 + ")")
            var s_cmp: String = this.fresh_local()
            this.emit_indent(s_cmp + " = icmp eq i64 " + s_done + ", 1")
            this.emit_terminator("br i1 " + s_cmp + ", label %" + sd + ", label %" + sl)
            this.start_block(sl)
            this.emit_indent("call void @__sched_coro_resume(i64 " + s_i64 + ")")
            this.emit_terminator("br label %" + sc)
            this.start_block(sd)
            var s_result: String = this.fresh_local()
            this.emit_indent(s_result + " = load i64, i64* @__task_result")
            if (this.func_ret_types.has(prefixed_name)) {
                this.last_type = this.func_ret_types.get(prefixed_name)
            } else if (this.func_ret_types.has(method)) {
                this.last_type = this.func_ret_types.get(method)
            } else {
                this.last_type = AST.Type.IntType
            }
            return s_result
        }
        var local: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(local, "i64", prefixed_name, arg_strs.join(", ")))
        } else {
            this.emit_indent(local + " = call i64 @" + prefixed_name + "(" + arg_strs.join(", ") + ")")
        }
        if (this.func_ret_types.has(prefixed_name)) {
            this.last_type = this.func_ret_types.get(prefixed_name)
        } else if (this.func_ret_types.has(method)) {
            this.last_type = this.func_ret_types.get(method)
        } else {
            this.last_type = AST.Type.IntType
        }
        return local
    }

    // Check for enum constructor: EnumName.Variant(args) — MUST come before builtin dispatch
    if (obj_name.length() > 0) {
        var enum_key: String = obj_name + "." + method
        if (this.enum_variant_tags.has(enum_key)) {
            return this.gen_enum_construct(obj_name, method, args)
        }
        // Fallback: check enum_defs in case enum_variant_tags lookup misses
        // (e.g. when enum name == variant name: enum Token { Token(...) })
        if (this.enum_defs.has(obj_name)) {
            var variants: List = this.enum_defs.get(obj_name)
            if (variants.contains(method)) {
                return this.gen_enum_construct(obj_name, method, args)
            }
        }
    }
    if (obj_name.length() == 0) {
        var obj_kind: String = this.classify_expr(object)
        if (obj_kind == "member") {
            var inner_field: String = match (object) { MemberAccess(o, f, __ms) => f
                _ => ""
            }
            var enum_key2: String = inner_field + "." + method
            if (this.enum_variant_tags.has(enum_key2)) {
                return this.gen_enum_construct(inner_field, method, args)
            }
        }
    }

    // --- Task.spawn(fn) ---
    if (method == "spawn" and obj_name == "Task") {
        // Infer the task's result type from the lambda's return type
        var task_result_type: String = "Int"
        var spawn_expr_kind: String = this.classify_expr(args[0])
        if (spawn_expr_kind == "lambda") {
            var lambda_ret: String = match (args[0]) { Lambda(p, r, b) => r   _ => "Int" }
            if (lambda_ret.length() > 0 and lambda_ret != "Any" and lambda_ret != "Int") {
                task_result_type = lambda_ret
            } else {
                // Infer from body: if body is [Return(Call(f, ...))] use f's return type
                var lambda_body: List<AST.Stmt> = match (args[0]) { Lambda(p, r, b) => b   _ => [] }
                if (lambda_body.length() == 1) {
                    var lb_kind: String = this.classify_stmt(lambda_body[0])
                    if (lb_kind == "return") {
                        var ret_expr: AST.Expr = match (lambda_body[0]) { Return(v) => v   _ => AST.Expr.NilLit }
                        var ret_ek: String = this.classify_expr(ret_expr)
                        if (ret_ek == "call") {
                            var ret_callee: AST.Expr = match (ret_expr) { Call(c, a, __cs) => c   _ => AST.Expr.NilLit }
                            var ret_callee_name: String = this.get_variable_name(ret_callee)
                            if (ret_callee_name.length() > 0) {
                                var prefixed_callee: String = this.current_prefix + ret_callee_name
                                if (this.func_ret_types.has(prefixed_callee)) {
                                    task_result_type = this.type_to_string(this.func_ret_types.get(prefixed_callee))
                                } else if (this.func_ret_types.has(ret_callee_name)) {
                                    task_result_type = this.type_to_string(this.func_ret_types.get(ret_callee_name))
                                }
                            }
                        } else if (ret_ek == "method_call") {
                            var mc_method_name: String = match (ret_expr) { MethodCall(o, m, a, __ks) => m   _ => "" }
                            var mc_obj_expr: AST.Expr = match (ret_expr) { MethodCall(o, m, a, __ks) => o   _ => AST.Expr.NilLit }
                            var mc_ns: String = this.get_variable_name(mc_obj_expr)
                            if (mc_ns.length() > 0 and this.has_module_alias(mc_ns)) {
                                var mc_full: String = this.module_alias_prefix(mc_ns) + mc_method_name
                                if (this.func_ret_types.has(mc_full)) {
                                    task_result_type = this.type_to_string(this.func_ret_types.get(mc_full))
                                }
                            }
                        }
                    }
                }
            }
        }
        // Get the lambda as a function pointer (i64)
        // Force the lambda to be a coroutine (Task.spawn expects a coro handle)
        this.force_next_lambda_coro = true
        this.check_spawn_sendable = true
        var spawn_arg: String = this.gen_arg_value(args[0])
        // Check if the lambda/function is a coroutine
        // Lambda names start with __lambda — check if in coroutine_funcs
        var spawn_fn_name: String = this.get_variable_name(args[0])
        var is_coro_spawn: Bool = false
        if (spawn_fn_name.length() > 0 and this.str_in_list(this.coroutine_funcs, spawn_fn_name)) {
            is_coro_spawn = true
        }
        // Also check the last-generated lambda
        if (!is_coro_spawn) {
            var li: Float = this.coroutine_funcs.length() - 1
            while (li >= 0) {
                var cf: String = this.coroutine_funcs[li]
                if (cf.starts_with("__lambda")) { is_coro_spawn = true; li = -1 }
                li = li - 1
            }
        }
        // spawn_arg is a closure: [fn_ptr, env_ptr] packed as [2 x i64]*
        var closure_ptr: String = this.val_to_typed_ptr(spawn_arg, "[2 x i64]*")
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        var fn_i64: String = this.fresh_local()
        this.emit_indent(fn_i64 + " = load i64, i64* " + fn_slot)
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        var env_i64: String = this.fresh_local()
        this.emit_indent(env_i64 + " = load i64, i64* " + env_slot)
        var fn_ptr: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_inttoptr(fn_ptr, fn_i64))
        } else {
            this.emit_indent(fn_ptr + " = inttoptr i64 " + fn_i64 + " to ptr")
        }
        var task_hdl: String = this.fresh_local()
        this.emit_indent(task_hdl + " = call ptr " + fn_ptr + "(i64 " + env_i64 + ")")
        var task_i64: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_ptrtoint(task_i64, task_hdl))
        } else {
            this.emit_indent(task_i64 + " = ptrtoint ptr " + task_hdl + " to i64")
        }
        // If the task completed synchronously (e.g. no real suspend points),
        // save its result immediately before another spawn could overwrite @__task_result.
        // Don't enqueue already-done tasks (the scheduler would read stale @__task_result).
        var spawn_done: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_call(spawn_done, "i64", "__sched_coro_done", "i64 " + task_i64))
        } else {
            this.emit_indent(spawn_done + " = call i64 @__sched_coro_done(i64 " + task_i64 + ")")
        }
        var spawn_done_cmp: String = this.fresh_local()
        this.emit_indent(spawn_done_cmp + " = icmp eq i64 " + spawn_done + ", 1")
        var spawn_save_label: String = this.fresh_label("spawn.save")
        var spawn_enqueue_label: String = this.fresh_label("spawn.enqueue")
        var spawn_cont_label: String = this.fresh_label("spawn.cont")
        this.emit_terminator("br i1 " + spawn_done_cmp + ", label %" + spawn_save_label + ", label %" + spawn_enqueue_label)
        this.start_block(spawn_save_label)
        var spawn_res: String = this.fresh_local()
        this.emit_indent(spawn_res + " = load i64, i64* @__task_result")
        this.emit_indent("call void @__sched_store_result(i64 " + task_i64 + ", i64 " + spawn_res + ")")
        this.called_functions.push("__sched_store_result")
        this.emit_terminator("br label %" + spawn_cont_label)
        this.start_block(spawn_enqueue_label)
        // Only enqueue tasks that haven't completed yet
        var enqueue_name: String = "enqueue"
        if (this.known_functions.contains("stdlib_scheduler_enqueue")) {
            enqueue_name = "stdlib_scheduler_enqueue"
        }
        this.emit_indent("call i64 @" + enqueue_name + "(i64 " + task_i64 + ")")
        this.called_functions.push(enqueue_name)
        this.emit_terminator("br label %" + spawn_cont_label)
        this.start_block(spawn_cont_label)
        this.last_type = this.str_to_type(task_result_type)
        return task_i64
    }

    // --- Task methods: isReady() and getResult() ---
    if (method == "isReady") {
        var task_val: String = this.gen_arg_value(object)
        var task_ptr: String = this.fresh_local()
        this.emit_indent(task_ptr + " = inttoptr i64 " + task_val + " to ptr")
        var done_i1: String = this.fresh_local()
        this.emit_indent(done_i1 + " = call i1 @llvm.coro.done(ptr " + task_ptr + ")")
        var done_i64: String = this.fresh_local()
        this.emit_indent(done_i64 + " = zext i1 " + done_i1 + " to i64")
        this.last_type = AST.Type.BoolType
        return done_i64
    }
    if (method == "getResult") {
        var gr_obj_name: String = this.get_variable_name(object)
        // Unknown, not Int (BUGS #32). get_variable_name only answers for a bare
        // Variable, so `tasks[i].getResult()` yields "" and we learn nothing about
        // the result type. Any routes such values through the runtime-dispatching
        // helpers (__any_length etc.); Int sent a String straight to __list_length.
        var gr_result_type: AST.Type = AST.Type.AnyType
        if (gr_obj_name.length() > 0 and this.typed_vars.has(gr_obj_name)) {
            gr_result_type = this.typed_vars.get(gr_obj_name)
        }
        var task_val: String = this.gen_arg_value(object)
        var result_val: String = this.fresh_local()
        this.emit_indent(result_val + " = call i64 @__sched_get_stored_result(i64 " + task_val + ")")
        this.called_functions.push("__sched_get_stored_result")
        this.last_type = gr_result_type
        return result_val
    }
    // task.await() — from top-level: run scheduler then read result
    if (method == "await" and !this.is_coroutine) {
        // Determine the task's result type from the task variable's stored type
        var await_obj_name: String = this.get_variable_name(object)
        // Falls back to Any, not Int — see the note on getResult above (BUGS #32).
        var await_result_type: AST.Type = AST.Type.AnyType
        if (await_obj_name.length() > 0 and this.typed_vars.has(await_obj_name)) {
            await_result_type = this.typed_vars.get(await_obj_name)
        }
        var task_val: String = this.gen_arg_value(object)
        var sched_run_name: String = "scheduler_run"
        if (this.known_functions.contains("stdlib_scheduler_scheduler_run")) {
            sched_run_name = "stdlib_scheduler_scheduler_run"
        }
        this.emit_indent("call i64 @" + sched_run_name + "()")
        this.called_functions.push(sched_run_name)
        // Use the C-level per-task result storage (handles multi-task races)
        var result_val: String = this.fresh_local()
        this.emit_indent(result_val + " = call i64 @__sched_get_stored_result(i64 " + task_val + ")")
        this.called_functions.push("__sched_get_stored_result")
        this.last_type = await_result_type
        return result_val
    }
    // task.await() — from coroutine: loop suspend/resume until task is done
    if (method == "await" and this.is_coroutine) {
        // Determine the task's result type from the task variable's stored type
        var await_obj_name: String = this.get_variable_name(object)
        // Falls back to Any, not Int — see the note on getResult above (BUGS #32).
        var await_result_type: AST.Type = AST.Type.AnyType
        if (await_obj_name.length() > 0 and this.typed_vars.has(await_obj_name)) {
            await_result_type = this.typed_vars.get(await_obj_name)
        }
        var task_val: String = this.gen_arg_value(object)
        // Loop: check if task is done, if not suspend and retry
        var await_check: String = this.fresh_label("task.await.check")
        var await_suspend: String = this.fresh_label("task.await.suspend")
        var await_loop: String = this.fresh_label("task.await.loop")
        var await_cleanup: String = this.fresh_label("task.await.cleanup")
        var await_done: String = this.fresh_label("task.await.done")
        this.emit_terminator("br label %" + await_check)
        this.start_block(await_check)
        var done_val: String = this.fresh_local()
        this.emit_indent(done_val + " = call i64 @__sched_coro_done(i64 " + task_val + ")")
        var done_cmp: String = this.fresh_local()
        this.emit_indent(done_cmp + " = icmp eq i64 " + done_val + ", 1")
        this.emit_terminator("br i1 " + done_cmp + ", label %" + await_done + ", label %" + await_suspend)
        this.start_block(await_suspend)
        this.emit_indent("store i64 3, i64* @__yield_reason")
        this.emit_indent("store i64 " + task_val + ", i64* @__yield_arg")
        var save_tok: String = this.fresh_local()
        this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
        var susp: String = this.fresh_local()
        this.emit_indent(susp + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")
        this.emit_terminator("switch i8 " + susp + ", label %__coro_suspend [i8 0, label %" + await_loop + " i8 1, label %" + await_cleanup + "]")
        this.start_block(await_cleanup)
        this.emit_terminator("br label %__coro_cleanup")
        this.start_block(await_loop)
        this.emit_terminator("br label %" + await_check)
        this.start_block(await_done)
        // Task is done — read its stored result
        var result_val: String = this.fresh_local()
        this.emit_indent(result_val + " = call i64 @__sched_get_stored_result(i64 " + task_val + ")")
        this.called_functions.push("__sched_get_stored_result")
        this.last_type = await_result_type
        return result_val
    }

    // --- Builtin dispatch (only for non-class objects) ---
    var obj: String = this.gen_arg_value(object)
    var is_user_class: Bool = false
    if (obj_name.length() > 0) {
