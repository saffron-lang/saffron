                var __st_tagged: String = this.emit_tag_ptr(__st_ptr)
                this.last_type = AST.Type.StringType
                return __st_tagged
            }
            if (method == "to_upper") {
                this.called_functions.push("rt_str_to_upper")
                var __su_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__su_local, "i64", "rt_str_to_upper", "i64 " + obj))
                } else {
                    this.emit_indent(__su_local + " = call i64 @rt_str_to_upper(i64 " + obj + ")")
                }
                var __su_ptr: String = this.fresh_local()
                this.emit_indent(__su_ptr + " = inttoptr i64 " + __su_local + " to i8*")
                var __su_tagged: String = this.emit_tag_ptr(__su_ptr)
                this.last_type = AST.Type.StringType
                return __su_tagged
            }
            if (method == "to_lower") {
                this.called_functions.push("rt_str_to_lower")
                var __sl_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__sl_local, "i64", "rt_str_to_lower", "i64 " + obj))
                } else {
                    this.emit_indent(__sl_local + " = call i64 @rt_str_to_lower(i64 " + obj + ")")
                }
                var __sl_ptr: String = this.fresh_local()
                this.emit_indent(__sl_ptr + " = inttoptr i64 " + __sl_local + " to i8*")
