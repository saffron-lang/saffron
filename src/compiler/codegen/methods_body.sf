                var __sr_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__sr_local, "i64", "rt_str_repeat", "i64 " + obj + ", i64 " + __sr_arg))
                } else {
                    this.emit_indent(__sr_local + " = call i64 @rt_str_repeat(i64 " + obj + ", i64 " + __sr_arg + ")")
                }
                var __sr_ptr: String = this.fresh_local()
                this.emit_indent(__sr_ptr + " = inttoptr i64 " + __sr_local + " to i8*")
                var __sr_tagged: String = this.emit_tag_ptr(__sr_ptr)
                this.last_type = AST.Type.StringType
                return __sr_tagged
            }
