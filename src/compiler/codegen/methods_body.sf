                } else {
                    this.emit_indent(__ljoin_local + " = call i64 @__list_join(i64 " + obj + ", i64 " + __ljoin_val + ")")
                }
                this.last_type = AST.Type.StringType
                return __ljoin_local
            }
        }
    }

    // --- Map method dispatch (type-aware, replaces builtin_methods for Map) ---
    if (!is_user_class) {
        var __map_obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        var __map_type_match: Bool = __map_obj_type.starts_with("Map") or __map_obj_type == "Any"
        if (__map_type_match and method == "keys") {
            var __mk_local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(__mk_local, "i64", "__map_keys", "i64 " + obj))
            } else {
                this.emit_indent(__mk_local + " = call i64 @__map_keys(i64 " + obj + ")")
            }
