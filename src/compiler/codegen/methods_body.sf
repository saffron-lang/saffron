    // --- Ambiguous builtin dispatch (needs obj_type from last_type) ---
    // Prefer typed_vars annotation over last_type (source of truth for variable types).
    var obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)

    if (!is_user_class and method == "length") {
        // A receiver that is neither Any, String, List nor Map is *unresolved*,
        // not a list. The old `else` sent every such spelling to
        // `__list_length`, which does `inttoptr` on the value as given — fine
        // for a List (stored untagged), a segfault for a NaN-tagged String. That
        // is how a "String|Nil" receiver crashed (BUGS #93). `__any_length`
        // reads the GC type tag and picks list/map/strlen at runtime, so an
        // unresolved receiver is exactly its job; route it there and keep the
        // static call for the types we actually know.
        var length_unresolved: Bool = obj_type != "Any" and obj_type != "String" and !obj_type.starts_with("List") and !obj_type.starts_with("Map")
        if (obj_type == "Any" or length_unresolved) {
            if (obj_type == "Any") {
