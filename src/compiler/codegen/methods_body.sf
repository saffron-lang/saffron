                var __lcopy_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lcopy_local, "i64", "rt_list_copy", "i64 " + obj))
                } else {
                    this.emit_indent(__lcopy_local + " = call i64 @rt_list_copy(i64 " + obj + ")")
                }
