    // If receiver type is unknown ("Any") but a user class defines this method,
    // skip builtin dispatch and fall through to class method resolution.
    // Exclude built-in type classes (String/List/Map/Int/Float/Bool) — these
    // are registered for documentation/future dispatch but shouldn't override
    // the inline builtin_methods emission.
    if (!is_user_class and this.builtin_methods.has(method)) {
        var bd_obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        if (bd_obj_type == "Any") {
            var fcm_class: String = this.find_class_for_method(method)
            if (fcm_class.length() > 0 and fcm_class != "String" and fcm_class != "List" and fcm_class != "Map" and fcm_class != "Int" and fcm_class != "Float" and fcm_class != "Bool") {
