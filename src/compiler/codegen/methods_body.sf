                var __lsort_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lsort_local, "i64", "rt_list_sort", "i64 " + obj))
                } else {
                    this.emit_indent(__lsort_local + " = call i64 @rt_list_sort(i64 " + obj + ")")
                }
                this.last_type = __list_saved_type
                return __lsort_local
            }
            if (method == "join") {
