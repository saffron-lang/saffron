    // Fallback: if type resolution failed but a user class defines this method,
    // treat as user class dispatch. Skip known builtin methods (length, push, etc.)
    // to avoid hijacking built-in container dispatch.
    var __uc_is_builtin_method: Bool = method == "keys" or method == "values" or method == "has" or method == "get" or method == "set" or method == "length" or method == "push" or method == "pop" or method == "contains" or method == "split" or method == "join" or method == "slice" or method == "reverse" or method == "sort" or method == "copy" or method == "trim" or method == "replace" or method == "index_of" or method == "starts_with" or method == "ends_with" or method == "to_upper" or method == "to_lower" or method == "repeat" or method == "char_at" or method == "to_number" or method == "to_string" or method == "to_float" or method == "abs" or method == "floor" or method == "ceil"
    // The find_class_for_method fallback is a heuristic for a receiver whose type
    // codegen could not resolve — it must not fire when the receiver has a KNOWN
    // concrete builtin type, or an unrelated user class declaring `method` hijacks
    // the call (BUGS #134). Only an Any/unresolved receiver keeps the heuristic.
    var __uc_recv_type: String = this.dispatch_recv_type(obj_name, this.last_type)
    if (!is_user_class and !__uc_is_builtin_method and args.length() == 0 and !this.recv_is_concrete_builtin(__uc_recv_type)) {
        var __uc_fcm: String = this.find_class_for_method(method)
        if (__uc_fcm.length() > 0 and __uc_fcm != "String" and __uc_fcm != "List" and __uc_fcm != "Map" and __uc_fcm != "Int" and __uc_fcm != "Float" and __uc_fcm != "Bool") {
            is_user_class = true
        }
    }

    // --- List method dispatch (type-aware, replaces builtin_methods for List) ---
    if (!is_user_class) {
        var __list_obj_type: String = this.dispatch_recv_type(obj_name, this.last_type)
        var __list_is_any: Bool = __list_obj_type == "Any"
        var __list_any_skip: Bool = false
        if (__list_is_any) {
            var __fcm: String = this.find_class_for_method(method)
            if (__fcm.length() > 0 and __fcm != "String" and __fcm != "List" and __fcm != "Map" and __fcm != "Int" and __fcm != "Float" and __fcm != "Bool") {
                __list_any_skip = true
            }
        }
        var __list_type_match: Bool = __list_obj_type.starts_with("List") or __list_is_any
        var __list_meth_match: Bool = method == "push" or method == "pop" or method == "remove" or method == "reverse" or method == "copy" or method == "sort" or method == "join"
        if (!__list_any_skip and __list_type_match and __list_meth_match) {
            var __list_saved_type: AST.Type = this.last_type
            if (obj_name.length() > 0 and this.typed_vars.has(obj_name)) {
                __list_saved_type = this.typed_vars.get(obj_name)
            }
            if (method == "push") {
                var __lp_val: String = this.gen_arg_value(args[0])
                var __lp_discard: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lp_discard, "i64", "__list_push", "i64 " + obj + ", i64 " + __lp_val))
                } else {
                    this.emit_indent(__lp_discard + " = call i64 @__list_push(i64 " + obj + ", i64 " + __lp_val + ")")
                }
                this.last_type = AST.Type.NilType
                return "0"
            }
            if (method == "pop") {
                var __lpop_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lpop_local, "i64", "__list_pop", "i64 " + obj))
                } else {
                    this.emit_indent(__lpop_local + " = call i64 @__list_pop(i64 " + obj + ")")
                }
                var __pop_elem: AST.Type = this.get_list_element_type(__list_saved_type)
                if (this.type_to_string(__pop_elem) != "Any") {
                    this.last_type = __pop_elem
                } else {
                    this.last_type = AST.Type.IntType
                }
                return __lpop_local
            }
            if (method == "remove") {
                // @__list_remove takes a RAW i64 index; gen_arg_value returns tagged.
                var __lrm_tagged: String = this.gen_arg_value(args[0])
                var __lrm_val: String = this.emit_untag_int(__lrm_tagged)
                var __lrm_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lrm_local, "i64", "__list_remove", "i64 " + obj + ", i64 " + __lrm_val))
                } else {
                    this.emit_indent(__lrm_local + " = call i64 @__list_remove(i64 " + obj + ", i64 " + __lrm_val + ")")
                }
                var __rm_elem: AST.Type = this.get_list_element_type(__list_saved_type)
                if (this.type_to_string(__rm_elem) != "Any") {
                    this.last_type = __rm_elem
                } else {
                    this.last_type = AST.Type.IntType
                }
                return __lrm_local
            }
            if (method == "reverse") {
                this.called_functions.push("rt_list_reverse")
                var __lrev_local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(__lrev_local, "i64", "rt_list_reverse", "i64 " + obj))
                } else {
                    this.emit_indent(__lrev_local + " = call i64 @rt_list_reverse(i64 " + obj + ")")
                }
                this.last_type = __list_saved_type
                return __lrev_local
            }
            if (method == "copy") {
