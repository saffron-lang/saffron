            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(raw, "i64", "__any_length", "i64 " + obj))
            } else {
                this.emit_indent(raw + " = call i64 @__any_length(i64 " + obj + ")")
            }
            var local: String = this.emit_tag_int(raw)
            this.last_type = AST.Type.IntType
            return local
        }
        if (obj_type == "String") {
            var str_ptr: String = this.emit_untag_ptr(obj)
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = call i64 @strlen(i8* " + str_ptr + ")")
            var local: String = this.emit_tag_int(raw)
            this.last_type = AST.Type.IntType
            return local
        } else {
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = call i64 @__list_length(i64 " + obj + ")")
            var local: String = this.emit_tag_int(raw)
            this.last_type = AST.Type.IntType
            return local
        }
    }
    if (!is_user_class and method == "contains" and args.length() > 0) {
        if (obj_type == "Any") {
            IO.println("[codegen] Warning: dispatching 'contains' on untyped value (type inference failed)")
        }
        var contains_arg_type: String = this.get_expr_type(args[0])
        // Check for List/Map FIRST to avoid gen3 string-comparison misrouting
