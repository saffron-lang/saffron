            // made `for (k in m.keys())` on a Map<Int,String> hand each raw Int
            // to string-typed consumers and SEGFAULT. Unannotated maps stay Any.
            this.last_type = this.make_generic_type("List", [this.str_to_type(this.get_map_key_type(__map_obj_type))])
            return __mk_local
        }
        if (__map_type_match and method == "values") {
            this.called_functions.push("__map_values")
            var __mv_local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(__mv_local, "i64", "__map_values", "i64 " + obj))
            } else {
                this.emit_indent(__mv_local + " = call i64 @__map_values(i64 " + obj + ")")
            }
            // Element type is V — see the keys() note above.
            this.last_type = this.make_generic_type("List", [this.str_to_type(this.get_map_value_type(__map_obj_type))])
            return __mv_local
        }
    }

    // --- String method dispatch (type-aware, replaces builtin_methods for String) ---
    if (!is_user_class) {
