                this.emit_indent(eq_result + " = call i64 @__string_eq(i64 " + elem + ", i64 " + val + ")")
            } else {
                var icmp_eq: String = this.fresh_local()
                this.emit_indent(icmp_eq + " = icmp eq i64 " + elem + ", " + val)
                this.emit_indent(eq_result + " = zext i1 " + icmp_eq + " to i64")
            }
            var is_found: String = this.fresh_local()
            this.emit_indent(is_found + " = icmp ne i64 " + eq_result + ", 0")
            this.emit_terminator("br i1 " + is_found + ", label %" + found_lbl + ", label %" + next_lbl)
            this.start_block(next_lbl)
            var next_idx: String = this.fresh_local()
            this.emit_indent(next_idx + " = add i64 " + idx_val + ", 1")
            this.emit_indent("store i64 " + next_idx + ", i64* " + idx_alloca)
            this.emit_terminator("br label %" + loop_lbl)
            this.start_block(found_lbl)
            this.emit_terminator("br label %" + done_lbl)
            this.start_block(done_lbl)
            var phi_val: String = this.fresh_local()
            this.emit_indent(phi_val + " = phi i64 [1, %" + found_lbl + "], [0, %" + loop_lbl + "]")
            var result: String = this.emit_tag_bool(phi_val)
            this.last_type = AST.Type.BoolType
            return result
        } else if (obj_type == "String" or (obj_type == "Any" and contains_arg_type == "String")) {
