    fun gen_match(subject: AST.Expr, arms: List<AST.MatchArm>): String {
        var subj: String = this.gen_arg_value(subject)
        var subj_type: String = this.type_to_string(this.last_type)
        var result_ptr: String = this.fresh_local()
        this.emit_indent(result_ptr + " = alloca i64")

        // Give every arm binding a slot to be stored into before any arm block
        // exists, so the alloca dominates all of them (BUGS #106). Only names that
        // collide with a module global get one here; every other binding already
        // has an alloca from the enclosing frame's hoist list. Emitted for all
        // three lowerings below — enum switch, class pattern, unknown enum — since
        // each stores into the same `%<name>` slots.
        this.ensure_arm_slots(this.all_arm_bound_names(arms))

        // Determine which enum from first arm's pattern
        var first_arm: AST.MatchArm = arms[0]
        var first_pattern: AST.Pattern = match (first_arm) { Arm(p, b) => p
            _ => AST.Pattern.VariantPattern("", [])
        }
        var first_variant: String = match (first_pattern) { VariantPattern(v, b) => v
            _ => ""
        }

        // Check if this is a string literal match (prefix "__strpat:")
        if (first_variant.starts_with("__strpat:")) {
            // String literal match — generate if/else chain with __string_eq
            var end_label: String = this.fresh_label("match.end")
            var match_result_type: AST.Type = AST.Type.StringType
            var i: Float = 0
            while (i < arms.length()) {
                var arm: AST.MatchArm = arms[i]
                var arm_pattern: AST.Pattern = match (arm) { Arm(p, b) => p
                    _ => AST.Pattern.VariantPattern("", [])
                }
                var arm_body: AST.Expr = match (arm) { Arm(p, b) => b
                    _ => AST.Expr.NilLit
                }
                var arm_vname: String = match (arm_pattern) { VariantPattern(v, b) => v
                    _ => ""
                }

                if (arm_vname == "_") {
                    // Default/wildcard arm — just generate body
                    var val: String = this.gen_arg_value(arm_body)
                    if (i == 0) { match_result_type = this.last_type }
                    this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
                    this.emit_terminator("br label %" + end_label)
                } else if (arm_vname.starts_with("__strpat:")) {
                    // String pattern arm — compare with __string_eq
                    var str_val: String = arm_vname.slice(9, arm_vname.length())
                    var const_name: String = this.add_string_constant(str_val)
                    var len: Float = str_val.length() + 1
                    var gep: String = this.fresh_local()
                    this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
                    var pattern_val: String = this.ptr_to_val(gep)
                    var eq_result: String = this.fresh_local()
                    this.emit_indent(eq_result + " = call i64 @__string_eq(i64 " + subj + ", i64 " + pattern_val + ")")
                    var cmp: String = this.fresh_local()
                    this.emit_indent(cmp + " = trunc i64 " + eq_result + " to i1")
                    var then_label: String = this.fresh_label("match.arm")
                    var next_label: String = this.fresh_label("match.next")
                    this.emit_terminator("br i1 " + cmp + ", label %" + then_label + ", label %" + next_label)
                    // Arm body
                    this.start_block(then_label)
                    var val: String = this.gen_arg_value(arm_body)
                    if (i == 0) { match_result_type = this.last_type }
                    this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
                    this.emit_terminator("br label %" + end_label)
                    // Continue to next arm
                    this.start_block(next_label)
                }
                i = i + 1
            }
            // If no arm matched (no wildcard), store nil
            this.emit_indent("store i64 0, i64* " + result_ptr)
            this.emit_terminator("br label %" + end_label)
            this.start_block(end_label)
            var result: String = this.fresh_local()
            this.emit_indent(result + " = load i64, i64* " + result_ptr)
            this.last_type = match_result_type
            // LLVM lib parallel path: track string match result
            if (!this.identity_mode) {
                var smr: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
                this.llvm_values.set(result, smr)
            }
            return result
        }

        var enum_name: String = this.find_enum_for_variant(first_variant)

        // If enum not found, just generate the first arm's body as default
        if (enum_name == "Unknown") {
            // Unknown enum — extract bindings from subject using array encoding
            var first_bindings: List<String> = match (first_pattern) { VariantPattern(v, b) => b
                _ => []
            }
            // `match (x) { is Dog(d) => ..., is Cat(c) => ... }` — class
            // patterns, not enum variants. There is no payload to index into:
            // the binding IS the subject.
            //
            // This used to pick ONE arm at compile time by comparing each arm's
            // name against the subject's static type, because codegen had no
            // runtime class identity. With an `Any` subject — the only shape
            // where a class match is useful — no name matched, so every arm fell
            // through to `_` (measured behaviour in BUGS #61: not "the first arm
            // wins", but "all of them lose"). It now emits an if/else chain of
            // __class_is_a tests, the same shape as the string-literal match
            // above, so the arm is chosen by the object's actual class.
            //
            // Bindings still have to be registered in typed_vars or `d.bark()`
            // cannot resolve, and since BUGS #37 an unresolved Variable is a
            // hard error rather than a silent bad load.
            if (this.class_fields.has(first_variant)) {
                var cls_end: String = this.fresh_label("match.end")
                var cls_type: AST.Type = AST.Type.AnyType
                var cls_wild: Float = -1
                var ci: Float = 0
                while (ci < arms.length()) {
                    var cpat: AST.Pattern = this.get_arm_pattern(arms[ci])
                    var cname: String = match (cpat) { VariantPattern(v, b) => v
                        _ => ""
                    }
                    var cbinds: List<String> = this.get_pattern_bindings(cpat)
                    var cbody: AST.Expr = this.get_arm_body(arms[ci])
                    if (cname == "_") {
                        // Emit the wildcard last, after every test has failed —
                        // its position in the source does not make it a guard.
                        cls_wild = ci
                    } else {
                        var ctest: String = this.gen_class_tag_check_i1(subj, cname)
                        if (ctest.length() == 0) {
                            // Not a class we can test for. Skipping the arm
                            // silently is what made #61 invisible, so say so.
                            IO.println("[codegen] Warning: match arm `is " + cname + "` cannot be tested at runtime and is skipped")
                        } else {
                            var cthen: String = this.fresh_label("match.arm")
                            var cnext: String = this.fresh_label("match.next")
                            this.emit_terminator("br i1 " + ctest + ", label %" + cthen + ", label %" + cnext)
                            this.start_block(cthen)
                            // Same arm scoping as the enum path below (BUGS #106):
                            // `is Dog(d)` binds `d` for this arm only, and `d` may
                            // well name something in the enclosing scope.
                            var cscope: List<String> = []
                            if (cbinds.length() >= 1) { cscope.push(cbinds[0]) }
                            var csaved: List<String> = this.save_arm_slots(cscope)
                            var ctypes: List<String> = this.save_arm_types(cscope)
                            if (cbinds.length() >= 1) {
                                this.emit_indent("store i64 " + subj + ", i64* " + this.arm_slot_ref(cbinds[0]))
                                this.typed_vars.set(cbinds[0], this.str_to_type(cname))
                            }
                            var cval: String = this.gen_arg_value(cbody)
                            if (ci == 0) { cls_type = this.last_type }
                            this.emit_indent("store i64 " + cval + ", i64* " + result_ptr)
                            this.restore_arm_slots(cscope, csaved)
                            this.restore_arm_types(cscope, ctypes)
                            this.emit_terminator("br label %" + cls_end)
                            this.start_block(cnext)
                        }
                    }
                    ci = ci + 1
                }
                if (cls_wild >= 0) {
                    var wpat: AST.Pattern = this.get_arm_pattern(arms[cls_wild.floor()])
                    var wbinds: List<String> = this.get_pattern_bindings(wpat)
                    var wscope: List<String> = []
                    if (wbinds.length() >= 1) { wscope.push(wbinds[0]) }
                    var wsaved: List<String> = this.save_arm_slots(wscope)
                    var wtypes: List<String> = this.save_arm_types(wscope)
                    if (wbinds.length() >= 1) {
                        this.emit_indent("store i64 " + subj + ", i64* " + this.arm_slot_ref(wbinds[0]))
                    }
                    var wval: String = this.gen_arg_value(this.get_arm_body(arms[cls_wild.floor()]))
                    if (cls_wild == 0) { cls_type = this.last_type }
                    this.emit_indent("store i64 " + wval + ", i64* " + result_ptr)
                    this.restore_arm_slots(wscope, wsaved)
                    this.restore_arm_types(wscope, wtypes)
                } else {
                    // No wildcard and nothing matched. Storing nil keeps this an
                    // indeterminate value rather than a fault — the same gap as
                    // the string match above and BUGS #37's general case.
                    this.emit_indent("store i64 0, i64* " + result_ptr)
                }
                this.emit_terminator("br label %" + cls_end)
                this.start_block(cls_end)
                var cls_result: String = this.fresh_local()
                this.emit_indent(cls_result + " = load i64, i64* " + result_ptr)
                this.last_type = cls_type
                if (!this.identity_mode) {
                    var cmr: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
                    this.llvm_values.set(cls_result, cmr)
                }
                return cls_result
            }
            var ue_saved: List<String> = this.save_arm_slots(first_bindings)
            var ue_types: List<String> = this.save_arm_types(first_bindings)
            if (first_bindings.length() >= 1) {
                // Array encoding: inttoptr → GEP for each binding
                var num_slots: Float = first_bindings.length() + 1
                var total_str: String = num_slots.floor().to_string()
                var arr_ptr: String = this.val_to_typed_ptr(subj, "[" + total_str + " x i64]*")
                var bi: Float = 0
                while (bi < first_bindings.length()) {
                    var bname: String = first_bindings[bi]
                    var field_idx: Float = bi + 1
                    var field_slot: String = this.fresh_local()
                    this.emit_indent(field_slot + " = getelementptr [" + total_str + " x i64], [" + total_str + " x i64]* " + arr_ptr + ", i64 0, i64 " + field_idx.floor().to_string())
                    var extracted: String = this.fresh_local()
                    this.emit_indent(extracted + " = load i64, i64* " + field_slot)
                    this.emit_indent("store i64 " + extracted + ", i64* " + this.arm_slot_ref(bname))
                    bi = bi + 1
                }
            }
            var body_expr: AST.Expr = match (first_arm) { Arm(p, b) => b
                _ => AST.Expr.NilLit
            }
            var val: String = this.gen_arg_value(body_expr)
            this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
            this.restore_arm_slots(first_bindings, ue_saved)
            this.restore_arm_types(first_bindings, ue_types)
            var result: String = this.fresh_local()
            this.emit_indent(result + " = load i64, i64* " + result_ptr)
            // LLVM lib parallel path: track unknown-enum match result
            if (!this.identity_mode) {
                var umr: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
                this.llvm_values.set(result, umr)
            }
            return result
        }

        // Determine max fields across variants to pick encoding
        var max_fields: Float = this.get_max_fields(enum_name)

        // Extract tag based on encoding
        var tag_val: String = this.fresh_local()
        if (max_fields == 0) {
            // No-data enum: tag << 56 encoding
            var tag_shifted: String = this.fresh_local()
            this.emit_indent(tag_shifted + " = lshr i64 " + subj + ", 56")
            this.emit_indent(tag_val + " = trunc i64 " + tag_shifted + " to i8")
        } else {
            // Enum with data: heap-allocated array encoding, tag at array[0]
            var arr_ptr: String = this.val_to_typed_ptr(subj, "i64*")
            var tag_i64: String = this.fresh_local()
            this.emit_indent(tag_i64 + " = load i64, i64* " + arr_ptr)
            this.emit_indent(tag_val + " = trunc i64 " + tag_i64 + " to i8")
        }

        // Build switch
        var end_label: String = this.fresh_label("match.end")
        var arm_labels: List<String> = []
        var i: Float = 0
        while (i < arms.length()) {
            arm_labels.push(this.fresh_label("match.arm"))
            i = i + 1
        }

        var default_label: String = end_label
        var switch_cases: String = ""
        i = 0
        while (i < arms.length()) {
            var arm: AST.MatchArm = arms[i]
            var pattern: AST.Pattern = match (arm) { Arm(p, b) => p
                _ => AST.Pattern.VariantPattern("", [])
            }
            if (this.is_wildcard_in_enum(pattern, enum_name)) {
                default_label = arm_labels[i]
            } else {
                var variant_name: String = match (pattern) { VariantPattern(v, b) => v
                    _ => ""
                }
                var lookup_key: String = enum_name + "." + variant_name
                if (this.enum_variant_tags.has(lookup_key)) {
                    var tag_idx: Float = this.enum_variant_tags.get(lookup_key)
                    switch_cases = switch_cases + " i8 " + tag_idx.floor().to_string() + ", label %" + arm_labels[i]
                }
            }
            i = i + 1
        }
        this.emit_terminator("switch i8 " + tag_val + ", label %" + default_label + " [" + switch_cases + " ]")

        // Generate each arm
        var match_result_type: AST.Type = AST.Type.IntType
        i = 0
        while (i < arms.length()) {
            this.start_block(arm_labels[i])
            var arm: AST.MatchArm = arms[i]
            var pattern: AST.Pattern = match (arm) { Arm(p, b) => p
                _ => AST.Pattern.VariantPattern("", [])
            }
            var body_expr: AST.Expr = match (arm) { Arm(p, b) => b
                _ => AST.Expr.NilLit
            }

            // Extract bindings from payload and set their types
            var arm_variant: String = match (pattern) { VariantPattern(v, b) => v
                _ => ""
            }
            // A NamedWildcard binds the subject itself, not a payload field, so
            // it is stored directly rather than GEP'd out of the enum's payload.
            var nw_name: String = match (pattern) { NamedWildcard(n) => n   _ => "" }
            // Every name this arm binds — a NamedWildcard binds one too, and it
            // shadows an enclosing variable exactly the same way.
            var arm_names: List<String> = []
            if (nw_name.length() > 0) {
                arm_names.push(nw_name)
            }
            var bindings: List<String> = match (pattern) { VariantPattern(v, b) => b
                _ => []
            }
            var bind_count: Float = bindings.length()
            var bni: Float = 0
            while (bni < bind_count) {
                arm_names.push(bindings[bni])
                bni = bni + 1
            }
            // Snapshot the slots and the static types BEFORE any payload store,
            // so the enclosing scope's variable can be put back on the way out
            // (BUGS #106).
            var saved_slots: List<String> = this.save_arm_slots(arm_names)
            var saved_types: List<String> = this.save_arm_types(arm_names)
            if (nw_name.length() > 0) {
                this.emit_indent("store i64 " + subj + ", i64* " + this.arm_slot_ref(nw_name))
                this.typed_vars.set(nw_name, this.str_to_type(enum_name))
            }
            if (bind_count > 0) {
                this.extract_arm_bindings(bindings, subj, max_fields)
                var bi: Float = 0
                while (bi < bind_count) {
                    var btype: String = this.get_variant_field_type(enum_name, arm_variant, bi)
                    this.typed_vars.set(bindings[bi], this.str_to_type(btype))
                    if (btype == "String") {
                        this.string_vars.push(bindings[bi])
                    }
                    bi = bi + 1
                }
            }
            var val: String = this.gen_arg_value(body_expr)
            if (i == 0) {
                match_result_type = this.last_type
            }
            this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
            // Restore before the branch out, not after: `end_label` is shared by
            // every arm, so a restore there would run with whichever arm's temps
            // and would not dominate. The arm body's own value is already in
            // result_ptr by now, so putting the outer variable back cannot
            // disturb it.
            this.restore_arm_slots(arm_names, saved_slots)
            this.restore_arm_types(arm_names, saved_types)
            this.emit_terminator("br label %" + end_label)
            i = i + 1
        }

        this.start_block(end_label)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = load i64, i64* " + result_ptr)
        this.last_type = match_result_type
        // LLVM lib parallel path: track match result as opaque call placeholder
        if (!this.identity_mode) {
            var match_res: LLVMTypes.Value = this.llvm_block_builder.call("__match_result", LLVMTypes.Type.I64, [])
            this.llvm_values.set(result, match_res)
        }
        return result
    }

    // --- Match-arm binding scope (BUGS #106) ---
    //
    // A match arm's bindings are a scope of their own: they shadow whatever the
    // enclosing scope calls by the same name, for the arm's extent only. Codegen
    // has no scope chain, only one flat `%<name>` slot per name, so an arm
    // binding used to be written straight into the enclosing variable's slot.
    // That had two faces:
    //
    //   At module scope the outer variable is a global at `@__g_s`, so no
    //   `%s` alloca exists at all (the alloca loops in output_body.sf skip names
    //   that are module globals). `store i64 %tN, i64* %s` was invalid IR —
    //   "use of undefined value '%s'", caught by `opt -passes=verify`. Loud.
    //
    //   Inside a function `%s = alloca i64` DOES exist, so the store landed in
    //   the outer variable's slot. A `String`-declared local silently came to
    //   hold a tagged Int: `IO.println(s)` printed the payload, `s.length()`
    //   printed 0 (a small integer dereferenced as a char*), exit 0, no
    //   diagnostic. Silent, and the reason this needed fixing.
    //
    // resolve.sf already has this right, which is worth knowing before reading the
    // fix. `resolve_arms` pushes a scope per arm and `declare_pattern` declares
    // each binding `"local"` in it, so the binding reaches codegen as
    // `Ref("local", name, "")` and expr_body.sf loads it from `%<name>`. The arm
    // IS scoped in the AST; what was missing was codegen honouring it. So the
    // slot for an arm binding is always the local one — never `@__g_`, even when
    // a module global shares the name — and the two gaps to close are:
    //
    //   1. At module scope that `%<name>` slot was never allocated, because
    //      output_body.sf's top-level alloca loop skips any name that is a module
    //      global. `ensure_arm_slots` below allocates it, in the block before the
    //      switch so it dominates every arm. The enclosing `@__g_s` is then
    //      untouched by construction, and a read of the outer `s` after the match
    //      resolves to `Ref("global")` → `@__g_s` and is correct.
    //
    //   2. Inside a function the outer variable and the binding genuinely share
    //      one `%<name>` alloca — both are locals of the same function and
    //      codegen has no scope chain to separate them. Nothing structural can be
    //      done per-slot here, so save/restore brackets the arm instead: snapshot
    //      the slot on entry to the arm, put it back before the branch out. Only
    //      one arm runs per match and each ends in an unconditional branch to the
    //      match's end label, so the restore runs exactly once on the taken path.
    //
    // Renaming the binding to a unique slot would be the other shape of fix, and
    // is what `test/oracle_stringify.sf` had to do by hand. It is not available
    // from this file: the READ sites are emitted by expr_body.sf's `Ref`/`Variable`
    // arms, which spell the slot `%<sanitize_name(name)>` with no indirection to
    // redirect.

    fun arm_slot_ref(name: String): String {
        return "%" + this.sanitize_name(name)
    }

    /// True when `name` has no `%<name>` slot in the current frame — the
    /// module-scope collision case, where the alloca loop skipped it as a global.
    fun arm_slot_missing(name: String): Bool {
        if (this.current_fn_locals.has(name)) { return false }
        return this.module_globals.has(this.current_prefix + name) or this.module_globals.has(name)
    }

    /// Allocate the slots the enclosing frame did not, and record that we did.
    ///
    /// Called from gen_match while the pre-switch block is current: an alloca
    /// outside the entry block is legal IR and this block dominates every arm
    /// block, which is all the store and load sites need. (`result_ptr` above is
    /// allocated the same way.)
    ///
    /// The bookkeeping key is `"__armslot:" + name` in `current_fn_locals`, the
    /// same namespaced-key trick stmts_body.sf uses for `"__nestedfn:"`. Two
    /// properties come for free: that map is saved and restored around every
    /// function body, so the record has exactly per-frame lifetime; and nothing
    /// reads a key with that prefix, so no dispatch or alloca decision shifts. It
    /// has to be recorded somewhere, because two matches in one scope binding the
    /// same colliding name would otherwise emit `%s = alloca i64` twice and LLVM
    /// rejects the duplicate name.
    fun ensure_arm_slots(names: List<String>) {
        var i: Float = 0
        while (i < names.length()) {
            var n: String = names[i]
            var key: String = "__armslot:" + n
            if (this.arm_slot_missing(n) and !this.current_fn_locals.has(key)) {
                this.current_fn_locals.set(key, true)
                this.emit_indent("%" + this.sanitize_name(n) + " = alloca i64")
                // Zeroed for the same reason output_body.sf zeroes GC-root
                // allocas: this slot is a save/restore source below, and an undef
                // load is not something to hand to the GC or to rt_strlen. Note
                // the slot is NOT registered as a GC root — the payload it holds
                // is reachable through the subject for the arm's extent, and
                // adding a root here would need a matching pop on every arm exit.
                this.emit_indent("store i64 0, i64* %" + this.sanitize_name(n))
            }
            i = i + 1
        }
    }

    /// Every name any arm of this match binds. Collected across all arms up front
    /// rather than per arm, because the allocas have to be emitted once, in the
    /// single block that dominates all the arm blocks.
    fun all_arm_bound_names(arms: List<AST.MatchArm>): List<String> {
        var out: List<String> = []
        var i: Float = 0
        while (i < arms.length()) {
            var pat: AST.Pattern = this.get_arm_pattern(arms[i])
            // get_pattern_bindings already folds a NamedWildcard's name in, so
            // `x => ...` shadowing an enclosing `x` is covered too.
            var bs: List<String> = this.get_pattern_bindings(pat)
            var j: Float = 0
            while (j < bs.length()) {
                if (!out.contains(bs[j])) { out.push(bs[j]) }
                j = j + 1
            }
            i = i + 1
        }
        return out
    }

    /// Snapshot each binding's slot into a fresh temp. Emitted at the top of the
    /// arm block, before the payload stores, so the temps dominate the restore.
    fun save_arm_slots(bindings: List<String>): List<String> {
        var saved: List<String> = []
        var i: Float = 0
        while (i < bindings.length()) {
            var tmp: String = this.fresh_local()
            this.emit_indent(tmp + " = load i64, i64* " + this.arm_slot_ref(bindings[i]))
            saved.push(tmp)
            i = i + 1
        }
        return saved
    }

    fun restore_arm_slots(bindings: List<String>, saved: List<String>) {
        var i: Float = 0
        while (i < bindings.length()) {
            if (i < saved.length()) {
                this.emit_indent("store i64 " + saved[i] + ", i64* " + this.arm_slot_ref(bindings[i]))
            }
            i = i + 1
        }
    }

    /// The static side of the same shadowing. `typed_vars` and `string_vars` are
    /// flat too, so registering a binding's type overwrote the enclosing
    /// variable's: after the match, a `String` local was typed Int and method
    /// dispatch on it silently picked the integer arms. "" marks a name that had
    /// no entry, which is left alone on restore.
    fun save_arm_types(bindings: List<String>): List<String> {
        var prev: List<String> = []
        var i: Float = 0
        while (i < bindings.length()) {
            if (this.typed_vars.has(bindings[i])) {
                prev.push(this.type_to_string(this.typed_vars.get(bindings[i])))
            } else {
                prev.push("")
            }
            i = i + 1
        }
        return prev
    }

    fun restore_arm_types(bindings: List<String>, prev: List<String>) {
        var i: Float = 0
        while (i < bindings.length()) {
            if (i < prev.length()) {
                var pt: String = prev[i]
                if (pt.length() > 0) {
                    this.typed_vars.set(bindings[i], this.str_to_type(pt))
                    // string_vars is consulted by is_string_variable to decide
                    // whether `+` is concatenation. An Int binding over a String
                    // local must not strip the local's entry, and a String
                    // binding over an Int local must not add one.
                    if (pt == "String") {
                        if (!this.string_vars.contains(bindings[i])) {
                            this.string_vars.push(bindings[i])
                        }
                    } else {
                        this.drop_string_var(bindings[i])
                    }
                }
            }
            i = i + 1
        }
    }

    fun drop_string_var(name: String) {
        var kept: List<String> = []
        var i: Float = 0
        while (i < this.string_vars.length()) {
            if (this.string_vars[i] != name) {
                kept.push(this.string_vars[i])
            }
            i = i + 1
        }
        this.string_vars = kept
    }

    fun extract_arm_bindings(bindings: List<String>, subj: String, max_fields: Float) {
        var bind_count: Float = bindings.length()
        // Always use array encoding: inttoptr and GEP to extract fields
        // (max_fields >= 1 means heap-allocated [tag, field0, field1, ...])
        var total: Float = bind_count + 1
        var total_str: String = total.floor().to_string()
        var arr_ptr: String = this.val_to_typed_ptr(subj, "[" + total_str + " x i64]*")
        // One extraction per binding, however many there are.
        //
        // This used to be five unrolled `if (bind_count >= n)` lines, capped at
        // five, "to avoid VM loop variable bug" — a workaround for the C VM in
        // legacy/, which has been dead and unsupported for a long time. The cap
        // outlived its reason and became a silent arity limit: gen_enum_construct
        // stores every argument in a loop, so a six-field variant was built
        // correctly and then read back with its sixth field never loaded. The
        // binding kept whatever its alloca held, which reads as 0 — and a 0 where
        // a String belongs is a null pointer the next strncmp/strlen dereferences.
        //
        // That is exactly how `ClassDecl` gaining `type_params` (BUGS #95) turned
        // into a segfault in the codegen pre-scan: the sixth field is `docstring`,
        // so `cd3.starts_with("@actor")` ran strncmp against NULL. No diagnostic,
        // no wrong-looking IR — just a truncated payload (BUGS #96).
        var bi: Float = 0
        while (bi < bind_count) {
            this.extract_one_field(bindings[bi], arr_ptr, total_str, bi + 1)
            bi = bi + 1
        }
    }

    fun extract_one_field(bname: String, arr_ptr: String, total_str: String, idx: Float) {
        var field_slot: String = this.fresh_local()
        this.emit_indent(field_slot + " = getelementptr [" + total_str + " x i64], [" + total_str + " x i64]* " + arr_ptr + ", i64 0, i64 " + idx.floor().to_string())
        var extracted: String = this.fresh_local()
        this.emit_indent(extracted + " = load i64, i64* " + field_slot)
        // arm_slot_ref, not a bare `%<name>`: at module scope a name that is a
        // module global has no alloca, and the bare form emitted a store against
        // an undefined `%s` (BUGS #106's loud face). This is also the store site
        // for `let Some(v) = ...`, where the global is likewise the right slot.
        this.emit_indent("store i64 " + extracted + ", i64* " + this.arm_slot_ref(bname))
    }

    /// The declared type of one payload field of one enum variant, as a string.
    ///
    /// Five of the nine M2 fallbacks in docs/design/compiler-rewrite.md are the
    /// five misses in this function, and each is a *different* failure to read
    /// enum metadata, which is why each reports its own message instead of
    /// sharing one "cannot infer". `Int` is still the value returned — see the
    /// block comment above Diag.record_unresolved for why the conversion is
    /// measure-then-fail rather than fail-now — but it is no longer silent, so
    /// the count is a build statistic and a wrong answer here names itself.
    fun get_variant_field_type(enum_name: String, variant_name: String, field_idx: Float): String {
        var key: String = enum_name + "." + variant_name
        if (!this.enum_variant_fields.has(key)) {
            Diag.record_unresolved("get_variant_field_type: variant not registered", "field " + field_idx.floor().to_string() + " of " + key, "Int")
            return "Int"
        }
        var fields: String = this.enum_variant_fields.get(key)
        if (fields.length() == 0) {
            Diag.record_unresolved("get_variant_field_type: variant has no recorded fields", "field " + field_idx.floor().to_string() + " of " + key, "Int")
            return "Int"
        }
        var parts: List<String> = this.split_respecting_generics(fields, ",")
        if (field_idx >= parts.length()) {
            Diag.record_unresolved("get_variant_field_type: field index out of bounds (" + parts.length().floor().to_string() + " fields)", "field " + field_idx.floor().to_string() + " of " + key, "Int")
            return "Int"
        }
        var field_def: String = parts[field_idx.floor()]
        var name_type: List<String> = field_def.split(":")
        if (name_type.length() < 2) {
            Diag.record_unresolved("get_variant_field_type: field definition has no name:type split", "'" + field_def + "' in " + key, "Int")
            return "Int"
        }
        var ftype: String = name_type[1]
        if (ftype == "String") return "String"
        // `Int` was never in this list, so an honestly-Int field fell all the way
        // through to the bottom and was answered by the *fallback* — the right
        // value reached by the wrong route, and indistinguishable from a guess.
        // 27 of the reports in test/pass/enum_payload_value_equality.sf alone were
        // this. Answering it here is the difference the whole stage is about: two
        // textually identical `Int`s, one a conclusion and one a shrug.
        if (ftype == "Int") return "Int"
        // Float must stay Float. Collapsing it to Int made arithmetic on a
        // match binding emit integer ops against a NaN-boxed double, so
        // `Circle(r) => 3.14159 * r * r` evaluated to nan. Identity mode still
        // wants Int, and type_to_string_for_target already applies that.
        if (ftype == "Float" or ftype == "Number") return "Float"
        if (ftype == "Bool") return "Int"
        if (ftype.starts_with("List")) return "List<String>"
        // Same accidental-correctness as `Int` above, one step further out: a
        // field declared `Any` or `Nil` genuinely has no more specific codegen
        // type than the i64 slot, so `Int` here is the answer and not a guess.
        // `Map` is listed for the same reason `List` is — the payload is a
        // pointer either way, and the element types are not consulted.
        if (ftype == "Any" or ftype == "Nil") return "Int"
        if (ftype.starts_with("Map")) return "Map<String, String>"
        // Past the builtin spellings. The metadata was read fine; `ftype` is a
        // name — an enum, a class, possibly module-qualified. Those used to
        // collapse to `Int`, which is the M2 fallback in its purest form: the
        // declared type was right there in the string and got thrown away. All
        // 2350 remaining reports on the compiler's own source were this one arm,
        // and every one of them named a type the codegen tables already know
        // ('Expr', 'Span', 'Types.Value', ...).
        //
        // So answer with the name when the tables confirm it, and keep the
        // report for the case where they do not. Enums are checked before
        // classes because a generic enum's bare name is what enum_defs is keyed
        // by, and because a name that is both would be a redeclaration the
        // checker rejects earlier.
        if (this.enum_defs.has(ftype)) { return ftype }
        var vft_resolved: String = this.resolve_class_type(ftype)
        if (vft_resolved.length() > 0) { return vft_resolved }
        // A module-qualified enum: `AST.Span` is keyed in enum_defs by its bare
        // name plus whatever prefix the declaring module got, neither of which is
        // the spelling the field declaration used.
        if (ftype.contains(".")) {
            var vft_bare: String = ftype.slice(ftype.index_of(".") + 1, ftype.length())
            if (this.enum_defs.has(vft_bare)) { return vft_bare }
            if (this.current_prefix.length() > 0 and this.enum_defs.has(this.current_prefix + vft_bare)) {
                return this.current_prefix + vft_bare
            }
        }
        // A generic type PARAMETER (`T`, `E`): its concrete type is not knowable
        // at the enum declaration — it depends on the instantiation — so the honest
        // codegen type is `Any`, which routes every consumer through runtime tag
        // inspection. Returning `Int` here (the old fallback) was the bug behind a
        // String payload of `enum Result<T,E> { Err(error: E) }` printing a raw bit
        // pattern under `"${msg}"`: the match binding was typed Int, so to_string,
        // interpolation and arithmetic all untagged a string pointer as an integer.
        // Fixing it HERE, at the binding's type source, fixes every downstream
        // consumer at once rather than patching each (to_string was one such site).
        if (this.is_type_param_spelling(ftype)) { return "Any" }
        // Genuinely unknown: a type name no table in codegen has heard of. This
        // is the residue stage 1 is meant to leave visible rather than paper over.
        Diag.record_unresolved("get_variant_field_type: unknown declared type '" + ftype + "'", "field " + field_idx.floor().to_string() + " of " + key, "Int")
        return "Int"
    }

    fun get_max_fields(enum_name: String): Float {
        var max_f: Float = 0
        if (!this.enum_defs.has(enum_name)) return 0
        var variants: List = this.enum_defs.get(enum_name)
        var i: Float = 0
        while (i < variants.length()) {
            var vname: String = variants[i]
            var key: String = enum_name + "." + vname
            if (this.enum_variant_fields.has(key)) {
                var fields: String = this.enum_variant_fields.get(key)
                if (fields.length() > 0) {
                    var parts: List<String> = this.split_respecting_generics(fields, ",")
                    // Each part is "name:Type", count them
                    var field_count: Float = parts.length()
                    if (field_count > max_f) {
                        max_f = field_count
                    }
                }
            }
            i = i + 1
        }
        return max_f
    }


