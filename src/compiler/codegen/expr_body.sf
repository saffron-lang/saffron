    fun gen_expr(expr: AST.Expr): String {
        return match (expr) {
            IntLit(v) => {
                this.last_type = AST.Type.IntType
                var raw: String = this.fresh_local()
                this.emit_indent(raw + " = add i64 0, " + v.floor().to_string())
                // LLVM lib parallel path — builds IntLit in the LLVM Module alongside string emission
                if (this.use_llvm_lib and !this.identity_mode) {
                    var llvm_zero: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(0, 64))
                    var llvm_val: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(v.floor(), 64))
                    var llvm_result: LLVMTypes.Value = this.llvm_block_builder.add(llvm_zero, llvm_val)
                    this.llvm_values.set(raw, llvm_result)
                }
                var local: String = this.emit_tag_int(raw)
                local
            }
            FloatLit(v) => {
                this.last_type = AST.Type.FloatType
                // v is the float literal text (e.g. "3.14").
                var local: String = this.emit_tag_float(v)
                local
            }
            BoolLit(v) => {
                this.last_type = AST.Type.BoolType
                var raw: String = this.fresh_local()
                var val_str: String = "0"
                if (v) { val_str = "1" }
                this.emit_indent(raw + " = add i64 0, " + val_str)
                // LLVM lib parallel path — builds BoolLit in the LLVM Module alongside string emission
                if (this.use_llvm_lib and !this.identity_mode) {
                    var bool_int: Float = 0
                    if (v) { bool_int = 1 }
                    var llvm_zero: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(0, 64))
                    var llvm_val: LLVMTypes.Value = LLVMTypes.Value.Constant(LLVMTypes.Const.Int(bool_int, 64))
                    var llvm_result: LLVMTypes.Value = this.llvm_block_builder.add(llvm_zero, llvm_val)
                    this.llvm_values.set(raw, llvm_result)
                }
                var local: String = this.emit_tag_bool(raw)
                local
            }
            StringLit(s) => {
                this.last_type = AST.Type.StringType
                var const_name: String = this.add_string_constant(s)
                var gep: String = this.fresh_local()
                var len: Float = s.length() + 1
                this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
                var local: String = this.emit_tag_ptr(gep)
                // LLVM lib parallel path — string literal ptrtoint
                // Full path needs Module.add_global_string() + GEP + ptrtoint;
                // deferred until the LLVM lib gains global string constant support
                if (this.use_llvm_lib and !this.identity_mode) {
                    // placeholder: string constants need Module.add_global_string()
                }
                local
            }
            NilLit => {
                this.last_type = AST.Type.NilType
                if (this.identity_mode or !this.in_function) {
                    "0"
                } else {
                    var local: String = this.fresh_local()
                    this.emit_indent(local + " = call i64 @__val_nil()")
                    local
                }
            }
            Variable(name, __vs) => {
                if (this.typed_vars.has(name)) {
                    this.last_type = this.typed_vars.get(name)
                } else {
                    // Module-level globals are registered in global_var_types by the
                    // pre-scan, not in typed_vars. This arm used to fall straight to
                    // IntType without consulting that table, so a global read from
                    // inside any function claimed to be an Int — the dishonest
                    // "unknown means Int" fallback of BUGS #32/#33. Method dispatch
                    // then took no branch and returned a literal "0" (#37):
                    //
                    //   var _order = "abc"          // module level
                    //   fun f() { _order.index_of("b") }   // was 0, ignoring the string
                    //
                    // Reading the same global at top level worked, because typed_vars
                    // has it there. That asymmetry is what made this survive so long.
                    var gv_type: String = this.get_var_type_str(name)
                    if (gv_type.length() > 0) {
                        this.last_type = this.str_to_type(gv_type)
                    } else {
                        this.last_type = AST.Type.IntType
                    }
                }
                // Error check: undefined variable
                // Skip check for module aliases and enum names (they are valid in expressions)
                // BUGS #175: a nested fun is emitted under a per-scope symbol
                // (scope$$name), so a reference to it by bare name is "known" only
                // via that qualified symbol. Without this term the undefined-var
                // check below fires before the nested-fun ref path is reached, so
                // `return uncollided` (a nested fun returned as a value) wrongly
                // errored "undefined variable 'uncollided'".
                var __nf_ref_known: Bool = this.current_fn_locals.has("__nestedfn:" + name) and this.nested_scope.length() > 0 and this.str_in_list(this.known_functions, this.nested_fun_symbol(this.nested_scope, name))
                if (!__nf_ref_known and !this.typed_vars.has(name) and !this.module_globals.has(this.current_prefix + name) and !this.module_globals.has(name) and !this.str_in_list(this.known_functions,name) and !this.str_in_list(this.known_functions,this.current_prefix + name) and name != "self" and name != "this" and name != "super" and name != "IO" and name != "OS" and name != "GC" and name != "Task" and !this.module_prefixes.has(name) and !this.enum_defs.has(name) and !this.class_fields.has(name)) {
                    // Error, not a warning (BUGS #37). Emitting a load from an
                    // undeclared %name produces invalid LLVM, so the compile
                    // fails regardless — just with "use of undefined value
                    // '%data'" from llc instead of a source-level diagnostic.
                    // Failing here names the variable and stops before codegen.
                    this.codegen_error("undefined variable '" + name + "'")
                }
                // A nested `fun` declared in THIS body shadows a like-named module
                // global, so it must be answered as a function reference even though
                // the module_globals guards below would otherwise divert to a load
                // from @__g_. Tested first for exactly that reason (BUGS #80).
                if (this.current_fn_locals.has("__nestedfn:" + name) and !this.typed_vars.has(name) and !this.named_imports.has(name)) {
                    // BUGS #175: prefer the per-scope symbol (scope$$name) so a
                    // reference binds to THIS scope's nested fun, not a same-named
                    // one elsewhere.
                    if (this.nested_scope.length() > 0) {
                        var __nfr: String = this.nested_fun_symbol(this.nested_scope, name)
                        if (this.str_in_list(this.known_functions, __nfr)) {
                            return this.gen_func_ref(__nfr)
                        }
                    }
                    if (this.str_in_list(this.known_functions,this.current_prefix + name)) {
                        return this.gen_func_ref(this.current_prefix + name)
                    }
                    if (this.str_in_list(this.known_functions,name)) {
                        return this.gen_func_ref(name)
                    }
                }
                // Function reference as first-class value: ptrtoint (check BEFORE load)
                // Skip for named imports — they should go through gen_call for direct dispatch
                if (this.str_in_list(this.known_functions,name)) {
                    if (!this.typed_vars.has(name)) {
                        if (!this.module_globals.has(this.current_prefix + name) and !this.module_globals.has(name)) {
                            if (!this.named_imports.has(name)) {
                                return this.gen_func_ref(name)
                            }
                        }
                    }
                }
                if (this.str_in_list(this.known_functions,this.current_prefix + name)) {
                    if (!this.typed_vars.has(name)) {
                        if (!this.module_globals.has(this.current_prefix + name) and !this.module_globals.has(name)) {
                            if (!this.named_imports.has(name)) {
                                return this.gen_func_ref(this.current_prefix + name)
                            }
                        }
                    }
                }
                var local: String = this.fresh_local()
                var var_ref: String = "%" + this.sanitize_name(name)
                // `super` names the same receiver pointer as `this` — only the
                // dispatch differs, and gen_method_call handles that above. In
                // value position there is no `%super` alloca, so the generic
                // load below emitted `load i64, i64* %super` and the module
                // failed LLVM verification (BUGS #70).
                if (name == "super") {
                    var_ref = "%self"
                }
                if (this.module_globals.has(this.current_prefix + name)) {
                    var_ref = "@__g_" + this.current_prefix + this.sanitize_name(name)
                } else if (this.module_globals.has(name)) {
                    var_ref = "@__g_" + this.sanitize_name(name)
                }
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_load(local, "i64", var_ref))
                    // LLVM lib parallel path: propagate stored Value for this variable
                    if (!this.identity_mode and this.llvm_values.has(var_ref)) {
                        this.llvm_values.set(local, this.llvm_values.get(var_ref))
                    }
                } else {
                    this.emit_indent(local + " = load i64, i64* " + var_ref)
                    this.verify_load(local, "i64", var_ref)
                }
                local
            }
            Ref(rkind, rname, rslot, __rs) => {
                // Resolved by resolve.sf with a scope chain in hand, so the
                // local-vs-global question is already answered. The Variable arm
                // above has to re-derive it from module_globals, and gets it
                // wrong whenever a module global shares a name with a parameter
                // (BUGS #40): the global branch wins because it is tested first,
                // and the parameter becomes unreachable. Here `rkind` decides,
                // and no side table is consulted at all.
                if (this.typed_vars.has(rname)) {
                    this.last_type = this.typed_vars.get(rname)
                } else {
                    var rgv_type: String = this.get_var_type_str(rname)
                    if (rgv_type.length() > 0) {
                        this.last_type = this.str_to_type(rgv_type)
                    } else {
                        this.last_type = AST.Type.IntType
                    }
                }
                if (rkind == "unknown") {
                    this.codegen_error("undefined variable '" + rname + "'")
                }
                if (rkind == "func") {
                    if (!this.named_imports.has(rname)) {
                        return this.gen_func_ref(rslot + rname)
                    }
                }
                var rlocal: String = this.fresh_local()
                var rvar_ref: String = "%" + this.sanitize_name(rname)
                if (rkind == "global") {
                    rvar_ref = "@__g_" + rslot + this.sanitize_name(rname)
                }
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_load(rlocal, "i64", rvar_ref))
                    if (!this.identity_mode and this.llvm_values.has(rvar_ref)) {
                        this.llvm_values.set(rlocal, this.llvm_values.get(rvar_ref))
                    }
                } else {
                    this.emit_indent(rlocal + " = load i64, i64* " + rvar_ref)
                    this.verify_load(rlocal, "i64", rvar_ref)
                }
                rlocal
            }
            Binary(left, op, right) => {
                this.gen_binary(left, op, right)
            }
            Unary(op, right) => {
                this.gen_unary(op, right)
            }
            Call(callee, args, __cs) => {
                this.gen_call(callee, args)
            }
            Assign(name, value, __as) => {
                var val: String = this.gen_arg_value(value)
                // Prefixed key only — see the note in stmts_body.sf's
                // gen_var_decl_with_name. The bare-name fallback could only
                // ever fire across a module boundary, so `i = i - 1` inside
                // @random's shuffle() stored to the main program's @__g_i while
                // every read used %i: the loop counter never decremented and
                // shuffle() spun forever.
                if (this.typed_vars.has(name) or this.module_globals.has(this.current_prefix + name)) {
                    var var_ref: String = "%" + this.sanitize_name(name)
                    // A function-local `var` shadowing a like-named module global
                    // must assign into its OWN slot (%name), not @__g_name. Reads
                    // and the declaration store already honour current_fn_locals
                    // (stmts_body.sf gen_var_decl_with_name, and the Variable read
                    // arm); this assignment arm did not, so `var g = 0; g = 7`
                    // inside a function with a global `g` wrote the global and left
                    // the local stale — and a shadowed loop counter (`while (i<3){
                    // i=i+1 }`) hung forever because the condition read the local
                    // while the increment stored the global. Same guard as the
                    // declaration store: only reach for the global when the name is
                    // NOT a local here (BUGS #59's assignment sibling).
                    if (!this.current_fn_locals.has(name) and this.module_globals.has(this.current_prefix + name)) {
                        var_ref = "@__g_" + this.current_prefix + this.sanitize_name(name)
                    }
                    if (this.use_llvm_lib) {
                        this.emit_indent(this.lib_store(val, "i64", var_ref))
                    } else {
                        this.emit_indent("store i64 " + val + ", i64* " + var_ref)
                        this.verify_store(val, "i64", var_ref)
                    }
                }
                val
            }









            Logical(left, op, right) => {
                this.gen_logical(left, op, right)
            }
            MemberAccess(object, field, __ms) => {
                // Check if object is This -> field access
                if (this.is_this_expr(object)) {
                    return this.gen_get_field(object, field)
                }
                // Check if object is a variable of class type -> field access
                var obj_name: String = this.get_variable_name(object)
                // Tuple field access: t._0, t._1, etc.
                if (obj_name.length() > 0 and field.starts_with("_") and field.length() >= 2) {
                    var tf_vtype: String = this.get_var_type_str(obj_name)
                    if (tf_vtype.starts_with("Tuple<")) {
                        var tf_rest: String = field.slice(1, field.length())
                        var tf_idx: Float = tf_rest.to_number()
                        var tf_obj: String = this.gen_arg_value(object)
                        var tf_idx_val: String = this.fresh_local()
                        this.emit_indent(tf_idx_val + " = add i64 0, " + tf_idx.floor().to_string())
                        var tf_result: String = this.fresh_local()
                        this.emit_indent(tf_result + " = call i64 @__list_get(i64 " + tf_obj + ", i64 " + tf_idx_val + ")")
                        var tf_inner: String = tf_vtype.slice(6, tf_vtype.length() - 1)
                        var tf_args: List<String> = AST.split_type_args(tf_inner)
                        if (tf_idx >= 0 and tf_idx < tf_args.length()) {
                            this.last_type = this.str_to_type(tf_args[tf_idx])
                        } else {
                            this.last_type = AST.Type.AnyType
                        }
                        return tf_result
                    }
                }
                if (obj_name.length() > 0) {
                    // Check enum first
                    var key: String = obj_name + "." + field
                    if (this.enum_variant_tags.has(key)) {
                        return this.gen_enum_construct(obj_name, field, [])
                    }
                    // Check if variable holds a class instance
                    var vtype: String = this.get_var_type_str(obj_name)
                    var resolved_type: String = this.resolve_class_type(vtype)
                    if (resolved_type.length() > 0) {
                        // It's a class instance — do field access
                        var obj_val: String = this.gen_arg_value(object)
                        var saved_class: String = this.current_class
                        this.current_class = resolved_type
                        var field_idx: Float = this.get_field_index(resolved_type, field)
                        var obj_ptr: String = this.val_to_typed_ptr(obj_val, "%" + resolved_type + "*")
                        var field_ptr: String = this.fresh_local()
                        this.emit_indent(field_ptr + " = getelementptr %" + resolved_type + ", %" + resolved_type + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
                        var result: String = this.fresh_local()
                        this.emit_indent(result + " = load i64, i64* " + field_ptr)
                        // `resolved_type` is the bare/struct name (resolve_class_type
                        // strips the generic arguments), which is what the field
                        // tables are keyed by; `vtype` still has the arguments, and
                        // those are what a field declared `var v: T` needs to become
                        // a String on a `Box<String>` (BUGS #95).
                        var gf_ft: String = this.get_field_type(resolved_type, field)
                        this.last_type = this.str_to_type(this.substitute_class_type_params(gf_ft, vtype))
                        this.current_class = saved_class
                        return result
                    }
                    // Package namespace: check named_imports for "Alias.field" first
                    if (this.named_imports.has(obj_name + "." + field)) {
                        var pe_ref: String = this.named_imports.get(obj_name + "." + field)
                        if (this.str_in_list(this.known_functions, pe_ref)) {
                            return this.gen_func_ref(pe_ref)
                        }
                    }
                    // Module-prefixed function reference: e.g. Routes.list_packages used as value
                    if (this.has_module_alias(obj_name)) {
                        var mp_resolved: String = this.module_alias_prefix(obj_name) + field
                        if (this.str_in_list(this.known_functions, mp_resolved)) {
                            return this.gen_func_ref(mp_resolved)
                        }
                        // Module-prefixed global variable: e.g. Cache.store
                        if (this.module_globals.has(mp_resolved)) {
                            var mg_local: String = this.fresh_local()
                            var mg_ref: String = "@__g_" + this.sanitize_name(mp_resolved)
                            this.emit_indent(mg_local + " = load i64, i64* " + mg_ref)
                            // Publish the type so a method call on this receiver
                            // dispatches. Without it last_type is stale/unknown and
                            // `Flag.items.push(1)` hit the silent `return "0"` in the
                            // method dispatcher: the load was emitted, the call was
                            // discarded, and the program compiled clean but did nothing.
                            if (this.global_var_types.has(mp_resolved)) {
                                this.last_type = this.str_to_type(this.global_var_types.get(mp_resolved))
                            }
                            return mg_local
                        }
                        // Neither a function nor a global under this module's
                        // prefix. The alias is *known* to be a module here, so
                        // "not found" is expressible — and this is the only place
                        // it is. Falling through instead reached the generic
                        // receiver path below, which evaluated the bare alias as
                        // a local and emitted `load i64, i64* %Math` — invalid IR
                        // blamed on the compiler for what is a typo in the user's
                        // program (BUGS #118). Same family as #22/#40/#78/#37/
                        // #103/#113/#114: a resolver with no way to say "not
                        // found" guesses instead of reporting absence.
                        //
                        // This arm is currently unreachable — `gen_arg_value`'s
                        // parallel copy of this block wins for every spelling
                        // measured (336 files) — but it is kept correct so it
                        // reports rather than guesses if it ever goes live.
                        this.codegen_error("no member '" + field + "' in module '" + obj_name + "'")
                        return "0"
                    }
                }
                // Fallback: evaluate object, check last_type for class (handles chained expr like list[i].field)
                var ma_obj_val: String = this.gen_arg_value(object)
                var ma_type_str: String = this.type_to_string(this.last_type)
                var ma_resolved: String = this.resolve_class_type(ma_type_str)
                if (ma_resolved.length() > 0 and this.class_fields.has(ma_resolved)) {
                    var saved_class: String = this.current_class
                    this.current_class = ma_resolved
                    var struct_name: String = ma_resolved
                    if (this.class_struct_names.has(ma_resolved)) {
                        struct_name = this.class_struct_names.get(ma_resolved)
                    }
                    var field_idx: Float = this.get_field_index(ma_resolved, field)
                    var obj_ptr: String = this.val_to_typed_ptr(ma_obj_val, "%" + struct_name + "*")
                    var field_ptr: String = this.fresh_local()
                    this.emit_indent(field_ptr + " = getelementptr %" + struct_name + ", %" + struct_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
                    var result: String = this.fresh_local()
                    this.emit_indent(result + " = load i64, i64* " + field_ptr)
                    // Same split as the annotated-variable path above: the tables
                    // want the bare name, the substitution wants the arguments.
                    var ma_ft: String = this.get_field_type(ma_resolved, field)
                    this.last_type = this.str_to_type(this.substitute_class_type_params(ma_ft, ma_type_str))
                    this.current_class = saved_class
                    return result
                }
                "0"
            }
            EnumConstruct(enum_name, variant, args) => {
                this.gen_enum_construct(enum_name, variant, args)
            }
            Match(subject, arms) => {
                this.gen_match(subject, arms)
            }
            Lambda(params, ret_type, body) => {
                this.gen_lambda(params, ret_type, body)
            }
            This => {
                this.last_type = this.str_to_type(this.current_class)
                var local: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_load(local, "i64", "%self"))
                } else {
                    this.emit_indent(local + " = load i64, i64* %self")
                }
                local
            }
            GetField(object, field, __gs) => {
                this.gen_get_field(object, field)
            }
            SetField(object, field, value, __ss) => {
                // This arm is currently UNREACHABLE, and measured so rather than
                // argued: with a distinct marker string on each of the two write
                // sites, 18 syntactic positions were swept (top level, function
                // body, if/else, while, for-in, C-style for, try, catch, match
                // arm, class method, `init`, nested `fun`, actor method, bare
                // block, two writes in a row) and `gen_arg_value`'s `set_field`
                // branch fired in every one — this arm in none. `gen_expr` has
                // only four callers, all inside `gen_arg_value`, and
                // `gen_arg_value` handles `set_field` before reaching any of
                // them. Kept correct anyway, exactly as #118 kept its own dead
                // read copy correct: a fix applied only to the readable one would
                // have changed nothing and still bootstrapped green.
                if (this.report_missing_module_write(object, field)) {
                    return "0"
                }
                this.gen_set_field(object, field, value)
            }
            ListLit(elements) => {
                this.gen_list_lit(elements)
            }
            IndexGet(object, index) => {
                this.gen_index_get(object, index)
            }
            IndexSet(object, index, value) => {
                this.gen_index_set(object, index, value)
            }
            MethodCall(object, method, args, __ks) => {
                this.gen_method_call(object, method, args)
            }
            MapLit => {
                this.last_type = this.make_map_type()
                var local: String = this.fresh_local()
                this.emit_indent(local + " = call i64 @__map_new()")
                local
            }
            BlockExpr(stmts, value) => {
                this.gen_stmts(stmts)
                this.gen_arg_value(value)
            }
            IsCheck(value, type_name) => {
                this.gen_is_check(value, type_name)
            }
            IfExpr(cond, then_stmts, then_val, else_stmts, else_val) => {
                this.gen_if_expr(cond, then_stmts, then_val, else_stmts, else_val)
            }
            TryExpr(try_stmts, try_val, catch_name, catch_stmts, catch_val) => {
                this.gen_try_expr(try_stmts, try_val, catch_name, catch_stmts, catch_val)
            }
            Yield(value) => {
                this.gen_yield(value)
            }
            TupleLit(elements) => {
                var result: String = this.gen_list_lit(elements)
                var tuple_type_str: String = "Tuple<"
                var tti: Float = 0
                while (tti < elements.length()) {
                    if (tti > 0) { tuple_type_str = tuple_type_str + "," }
                    var elem_type: String = this.get_expr_type(elements[tti])
                    tuple_type_str = tuple_type_str + elem_type
                    tti = tti + 1
                }
                tuple_type_str = tuple_type_str + ">"
                this.last_type = this.str_to_type(tuple_type_str)
                result
            }
        }
    }

    fun gen_yield(value: AST.Expr): String {
        // Detect yield [reason, arg] pattern for sleep/IO
        var is_list: Bool = match (value) { ListLit(elems) => true _ => false }
        if (is_list) {
            var elems: List<AST.Expr> = match (value) { ListLit(e) => e    _ => [] }
            if (elems.length() >= 1) {
                var reason: String = this.gen_arg_value(elems[0])
                this.emit_indent("store i64 " + reason + ", i64* @__yield_reason")
                if (elems.length() >= 2) {
                    var arg: String = this.gen_arg_value(elems[1])
                    this.emit_indent("store i64 " + arg + ", i64* @__yield_arg")
                }
            }
        }

        // Coroutine suspend sequence
        var save_tok: String = this.fresh_local()
        this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
        var susp_result: String = this.fresh_local()
        this.emit_indent(susp_result + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")

        var resume_label: String = this.fresh_label("yield.resume")
        var cleanup_label: String = this.fresh_label("yield.cleanup")

        // Default (suspend) case branches to the shared __coro_suspend block.
        // CoroSplit requires all suspend points to share a single suspend/ret block;
        // per-yield suspend blocks become unreachable in the .resume function.
        this.emit_terminator("switch i8 " + susp_result + ", label %__coro_suspend [i8 0, label %" + resume_label + " i8 1, label %" + cleanup_label + "]")

        // Cleanup path (coroutine destroyed while suspended)
        this.emit(cleanup_label + ":")
        this.block_terminated = false
        this.emit_terminator("br label %__coro_cleanup")

        // Resume path — read resume value from promise slot
        this.emit(resume_label + ":")
        this.block_terminated = false
        var resume_val: String = "0"

        this.last_type = AST.Type.IntType
        return resume_val
    }

    fun gen_is_check(value: AST.Expr, type_name: String): String {
        var val: String = this.gen_arg_value(value)
        var val_type: AST.Type = this.last_type
        this.last_type = AST.Type.BoolType

        // A type that admits several runtime representations — Any, a union, a
        // nullable — cannot be decided at compile time, so emit a runtime
        // NaN-boxing tag check. This condition used to be `val_type_str ==
        // "Any"`, a whitelist that silently mis-answered everything it forgot:
        // an `Int|Nil` reached the compile-time path below, where every
        // is_*_type predicate answers false for a union, so BOTH `x is Int` and
        // `x is Nil` compiled to a literal false. See BUGS #69.
        var val_type_str: String = this.type_to_string(val_type)
        if (this.is_undecidable_type(val_type)) {
            var rt_func: String = ""
            if (type_name == "Int") {
                rt_func = "__val_is_int"
            } else if (type_name == "Float") {
                rt_func = "__val_is_float"
            } else if (type_name == "String") {
                rt_func = "__val_is_string"
            } else if (type_name == "Bool") {
                rt_func = "__val_is_bool"
            } else if (type_name == "Nil") {
                rt_func = "__val_is_nil"
            } else if (type_name == "List") {
                rt_func = "__val_is_list"
            } else if (type_name == "Map") {
                rt_func = "__val_is_map"
            }
            if (rt_func.length() > 0) {
                var check_result: String = this.fresh_local()
                this.emit_indent(check_result + " = call i1 @" + rt_func + "(i64 " + val + ")")
                var raw_bool: String = this.fresh_local()
                this.emit_indent(raw_bool + " = zext i1 " + check_result + " to i64")
                return this.emit_tag_bool(raw_bool)
            }
            // A class name: dispatch on the object's actual GC type tag. This
            // used to emit a literal 0 plus a warning, because codegen was
            // believed to have no runtime model of the hierarchy; it now emits
            // one (see emit_class_hierarchy_helpers). __class_is_a walks the
            // parent chain, so `d is Animal` for a Dog answers true — something
            // the old path could not express at all, warning or not.
            var cls_check: String = this.gen_class_tag_check(val, type_name)
            if (cls_check.length() > 0) { return cls_check }
            // Not a known class (an enum name, a generic parameter, an
            // interface with no instances): still undecidable. Warn rather than
            // answering silently — a dead `is` branch is invisible at runtime.
            IO.println("[codegen] Warning: `is " + type_name + "` on a value of type " + val_type_str + " always answers false — class identity is not checked at runtime")
            var local: String = this.fresh_local()
            this.emit_indent(local + " = add i64 0, 0")
            return this.emit_tag_bool(local)
        }

        // Compile-time resolution when type is statically known
        var matches: String = "0"
        if (type_name == "Int" or type_name == "Float") {
            if (this.is_int_type(val_type)) { matches = "1" }
        } else if (type_name == "String") {
            if (this.is_string_type(val_type)) { matches = "1" }
        } else if (type_name == "Bool") {
            if (this.is_bool_type(val_type)) { matches = "1" }
        } else if (type_name == "Nil") {
            if (this.is_nil_type(val_type)) { matches = "1" }
        } else if (type_name == "List") {
            if (this.is_list_type(val_type)) { matches = "1" }
        } else if (type_name == "Map") {
            if (this.is_map_type(val_type)) { matches = "1" }
        } else {
            // A class name. Folding via is_class_type is only correct when the
            // static type is *exactly* type_name and cannot be a subclass —
            // is_class_type answers `n == name`, so it says false for a Dog
            // tested against Animal and for anything the checker could not
            // infer precisely. That was the other half of BUGS #61, and a fix
            // confined to the undecidable branch above would have looked
            // complete while leaving it. Emit the runtime check and let LLVM
            // fold the cases it can prove.
            var cls_check2: String = this.gen_class_tag_check(val, type_name)
            if (cls_check2.length() > 0) { return cls_check2 }
            if (this.is_class_type(val_type, type_name)) { matches = "1" }
        }
        var local: String = this.fresh_local()
        this.emit_indent(local + " = add i64 0, " + matches)
        return this.emit_tag_bool(local)
    }

    // Emit `__class_is_a(__val_class_tag(val), <tag of type_name>)` as a tagged
    // Saffron Bool, or "" when type_name is not a class this program declares —
    // an enum name, a generic parameter, an interface with no instances. The
    // empty string is the "I don't know" the callers need: gen_is_check falls
    // back rather than emitting a check against a tag that does not exist.
    // Returning a plausible `false` instead is the exact shape of failure that
    // made BUGS #61, #69 and #22 all silent.
    fun gen_class_tag_check(val: String, type_name: String): String {
        var hit: String = this.gen_class_tag_check_i1(val, type_name)
        if (hit.length() == 0) { return "" }
        var raw: String = this.fresh_local()
        this.emit_indent(raw + " = zext i1 " + hit + " to i64")
        return this.emit_tag_bool(raw)
    }

    // The raw i1 behind gen_class_tag_check, for callers that want to branch on
    // it rather than produce a value — gen_match's class-pattern chain does,
    // and re-truncating a freshly tagged Bool just to test it would be silly.
    // Same "" contract: not a class this program declares.
    fun gen_class_tag_check_i1(val: String, type_name: String): String {
        // Identity mode has no GC headers and no hierarchy helpers, so there is
        // no tag to read; the caller keeps its compile-time answer.
        if (this.identity_mode) { return "" }
        var struct_name: String = type_name
        if (this.class_struct_names.has(type_name)) { struct_name = this.class_struct_names.get(type_name) }
        if (!this.class_type_ids.has(struct_name)) { return "" }
        var target: Float = this.class_type_ids.get(struct_name)
        var tag_reg: String = this.fresh_local()
        this.emit_indent(tag_reg + " = call i64 @__val_class_tag(i64 " + val + ")")
        var hit: String = this.fresh_local()
        this.emit_indent(hit + " = call i1 @__class_is_a(i64 " + tag_reg + ", i64 " + target.floor().to_string() + ")")
        return hit
    }

    fun gen_if_expr(cond: AST.Expr, then_stmts: List<AST.Stmt>, then_val: AST.Expr, else_stmts: List<AST.Stmt>, else_val: AST.Expr): String {
        var result_ptr: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_alloca(result_ptr, "i64"))
        } else {
            this.emit_indent(result_ptr + " = alloca i64")
            this.verify_alloca(result_ptr, "i64")
        }

        var cond_val: String = this.to_i1(this.gen_arg_value(cond))
        var then_label: String = this.fresh_label("ifexpr.then")
        var else_label: String = this.fresh_label("ifexpr.else")
        var end_label: String = this.fresh_label("ifexpr.end")

        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_cond_br(cond_val, then_label, else_label))
        } else {
            this.emit_terminator("br i1 " + cond_val + ", label %" + then_label + ", label %" + else_label)
            this.verify_cond_br(cond_val, then_label, else_label)
        }

        this.start_block(then_label)
        this.gen_stmts(then_stmts)
        var then_result: String = this.gen_arg_value(then_val)
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_store(then_result, "i64", result_ptr))
        } else {
            this.emit_indent("store i64 " + then_result + ", i64* " + result_ptr)
            this.verify_store(then_result, "i64", result_ptr)
        }
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(end_label))
        } else {
            this.emit_terminator("br label %" + end_label)
            this.verify_br(end_label)
        }

        this.start_block(else_label)
        this.gen_stmts(else_stmts)
        var else_result: String = this.gen_arg_value(else_val)
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_store(else_result, "i64", result_ptr))
        } else {
            this.emit_indent("store i64 " + else_result + ", i64* " + result_ptr)
            this.verify_store(else_result, "i64", result_ptr)
        }
        if (this.use_llvm_lib) {
            this.emit_terminator(this.lib_br(end_label))
        } else {
            this.emit_terminator("br label %" + end_label)
            this.verify_br(end_label)
        }

        this.start_block(end_label)
        var result: String = this.fresh_local()
        if (this.use_llvm_lib) {
            this.emit_indent(this.lib_load(result, "i64", result_ptr))
        } else {
            this.emit_indent(result + " = load i64, i64* " + result_ptr)
            this.verify_load(result, "i64", result_ptr)
        }
        return result
    }

    fun gen_try_expr(try_stmts: List<AST.Stmt>, try_val: AST.Expr, catch_name: String, catch_stmts: List<AST.Stmt>, catch_val: AST.Expr): String {
        var result_ptr: String = this.fresh_local()
        this.emit_indent(result_ptr + " = alloca i64")

        var try_label: String = this.fresh_label("tryexpr.try")
        var catch_label: String = this.fresh_label("tryexpr.catch")
        var end_label: String = this.fresh_label("tryexpr.end")

        // Allocate a local jmp_buf on the stack
        var jmp_buf: String = this.fresh_local()
        this.emit_indent(jmp_buf + " = alloca [512 x i8], align 16")
        var jmp_buf_ptr: String = this.fresh_local()
        this.emit_indent(jmp_buf_ptr + " = getelementptr [512 x i8], [512 x i8]* " + jmp_buf + ", i64 0, i64 0")

        // Save previous jmp_buf
        var saved_jmp: String = this.fresh_local()
        this.emit_indent(saved_jmp + " = load i8*, i8** @__jmp_buf_current")
        this.emit_indent("store i8* " + jmp_buf_ptr + ", i8** @__jmp_buf_current")

        // Save shadow stack depth for restoration on catch
        var saved_ss_depth: String = this.fresh_local()
        this.emit_indent(saved_ss_depth + " = call i64 @__gc_shadow_stack_depth()")

        // setjmp
        var setjmp_result: String = this.fresh_local()
        this.emit_indent(setjmp_result + " = call i32 @setjmp(i8* " + jmp_buf_ptr + ")")
        var is_throw: String = this.fresh_local()
        this.emit_indent(is_throw + " = icmp ne i32 " + setjmp_result + ", 0")
        this.emit_terminator("br i1 " + is_throw + ", label %" + catch_label + ", label %" + try_label)

        // Try body
        this.start_block(try_label)
        this.gen_stmts(try_stmts)
        var try_result: String = this.gen_arg_value(try_val)
        this.emit_indent("store i64 " + try_result + ", i64* " + result_ptr)
        this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
        this.emit_terminator("br label %" + end_label)

        // Catch body
        this.start_block(catch_label)
        this.emit_indent("store i8* " + saved_jmp + ", i8** @__jmp_buf_current")
        // Restore shadow stack depth (longjmp skipped pop_roots)
        var cur_ss_depth: String = this.fresh_local()
        this.emit_indent(cur_ss_depth + " = call i64 @__gc_shadow_stack_depth()")
        var ss_pop_n: String = this.fresh_local()
        this.emit_indent(ss_pop_n + " = sub i64 " + cur_ss_depth + ", " + saved_ss_depth)
        this.emit_indent("call void @__gc_pop_roots(i64 " + ss_pop_n + ")")
        var exc_val: String = this.fresh_local()
        this.emit_indent(exc_val + " = load i64, i64* @__exception_value")
        this.emit_indent("store i64 " + exc_val + ", i64* %" + this.sanitize_name(catch_name))
        this.gen_stmts(catch_stmts)
        var catch_result: String = this.gen_arg_value(catch_val)
        this.emit_indent("store i64 " + catch_result + ", i64* " + result_ptr)
        this.emit_terminator("br label %" + end_label)

        this.start_block(end_label)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = load i64, i64* " + result_ptr)
        return result
    }

    /// Does this static type name settle the *representation* of an ordering
    /// comparison, so `<` can be a direct icmp/fcmp with no tag inspection?
    ///
    /// Only the numeric primitives qualify. Everything else — `Any`, a class, a
    /// union, a generic parameter, or the empty string get_expr_type returns when
    /// inference gave up — leaves the representation unknown at compile time, and
    /// a comparison on an unknown representation has to ask the value itself.
    ///
    /// `Bool` is deliberately absent: it is TAG_SPEC, not an integer, so an icmp
    /// on the boxed bit pattern is not its order. It falls to the runtime helper
    /// along with everything else.
    fun is_ordered_primitive(t: String): Bool {
        return t == "Int" or t == "Float"
    }

    /// The runtime helper implementing `op` for operands whose static types do
    /// not settle the comparison. Empty for a non-relational op.
    fun ordering_helper(op: String): String {
        if (op == "<") { return "__val_lt" }
        if (op == "<=") { return "__val_le" }
        if (op == ">") { return "__val_gt" }
        if (op == ">=") { return "__val_ge" }
        return ""
    }

    fun op_to_method(op: String): String {
        if (op == "+") { return "add" }
        if (op == "-") { return "sub" }
        if (op == "*") { return "mul" }
        if (op == "/") { return "div" }
        if (op == "%") { return "mod" }
        if (op == "<") { return "lt" }
        if (op == ">") { return "gt" }
        if (op == "==") { return "eq" }
        return ""
    }

    fun gen_binary(left: AST.Expr, op: String, right: AST.Expr): String {
        // Operator overloading: check if left operand is a class with the method
        var method_name: String = this.op_to_method(op)
        if (method_name.length() > 0) {
            var left_name: String = this.get_variable_name(left)
            var left_class: String = ""
            if (left_name.length() > 0) {
                left_class = this.get_var_type_str(left_name)
            } else {
                // The left operand is not a plain variable. It used to be given
                // up on here, so `Vec2(1,2) + Vec2(3,4)` — a constructor call,
                // `this.pos`, a method result — skipped overload dispatch
                // entirely and fell through to the primitive integer path,
                // emitting `add i64` on two *pointers* and printing a garbage
                // address. Silent wrong answer, no diagnostic. get_expr_type
                // already resolves calls and field accesses, so just ask it.
                //
                // Accept the answer ONLY if it names a declared class.
                // get_expr_type also returns primitives ("Int", "Number",
                // "Any"), and letting those through made `a + b + c` — whose
                // left operand is itself a Binary — resolve to a primitive that
                // collided with a user function sharing the overload method
                // name, rewriting the addition into a call to the user's own
                // global `add`: "'add' expects 3 arguments, got 2".
                var inferred_class: String = this.get_expr_type(left)
                if (this.class_fields.has(inferred_class)) {
                    left_class = inferred_class
                }
            }
            if (left_class.length() > 0) {
                if (this.class_methods.has(left_class)) {
                    var methods: List = this.class_methods.get(left_class)
                    if (methods.contains(method_name)) {
                        // Dispatch: left.method(right)
                        var lhs: String = this.gen_arg_value(left)
                        var rhs: String = this.gen_arg_value(right)
                        var full_method: String = left_class + "__" + method_name
                        if (this.func_prefix_map.has(full_method)) {
                            full_method = this.func_prefix_map.get(full_method)
                        } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions,this.current_prefix + full_method)) {
                            full_method = this.current_prefix + full_method
                        }
                        this.called_functions.push(full_method)
                        var local: String = this.fresh_local()
                        this.emit_indent(local + " = call i64 @" + full_method + "(i64 " + lhs + ", i64 " + rhs + ")")
                        if (this.func_ret_types.has(full_method)) {
                            this.last_type = this.func_ret_types.get(full_method)
                        } else {
                            this.last_type = this.str_to_type(left_class)
                        }
                        return local
                    }
                }
            }
        }

        // String equality comparison
        if (op == "==" or op == "!=") {
            var left_type: String = this.get_expr_type(left)
            var right_type: String = this.get_expr_type(right)
            var lhs: String = this.gen_arg_value(left)
            if (left_type == "Any") { left_type = this.type_to_string(this.last_type) }
            var rhs: String = this.gen_arg_value(right)
            if (right_type == "Any") { right_type = this.type_to_string(this.last_type) }

            // Nil comparison: use __val_is_nil in NaN-boxing mode
            // Must come before string comparison to handle cases like:
            // map.get("missing") == nil where get returns "String" type but actual value is nil
            if (!this.identity_mode) {
                // Which side is the *literal* nil, syntactically. This is the only
                // reliable signal for "test the other operand for nil".
                //
                // Keying off the inferred type alone is wrong when both sides are typed
                // Nil, which happens for `var x: Any = nil; ...; x == nil`: the
                // declaration used to narrow x to Nil (now fixed in gen_var_decl, but
                // any other Nil-typed expression reaches here too), and then
                // `check_val` picked whichever side the type test happened to name —
                // ending up testing the nil literal against itself, which is
                // unconditionally true regardless of what the variable holds.
                var left_is_literal_nil: Bool = this.is_nil_expr(left)
                var right_is_literal_nil: Bool = this.is_nil_expr(right)

                var is_nil_cmp: Bool = false
                if (left_type == "Nil") { is_nil_cmp = true }
                if (right_type == "Nil") { is_nil_cmp = true }
                if (left_is_literal_nil or right_is_literal_nil) { is_nil_cmp = true }
                if (is_nil_cmp) {
                    // Prefer the syntactic literal: check the side that is NOT `nil`.
                    var check_val: String = lhs
                    if (left_is_literal_nil and !right_is_literal_nil) {
                        check_val = rhs
                    } else if (right_is_literal_nil) {
                        check_val = lhs
                    } else if (left_type == "Nil") {
                        // Neither side is a literal; fall back to the type test.
                        check_val = rhs
                    }
                    var is_nil_raw: String = this.fresh_local()
                    this.emit_indent(is_nil_raw + " = call i1 @__val_is_nil(i64 " + check_val + ")")
                    var nil_bool: String = is_nil_raw
                    if (op == "!=") {
                        nil_bool = this.fresh_local()
                        this.emit_indent(nil_bool + " = xor i1 " + is_nil_raw + ", true")
                    }
                    var raw_bool: String = this.fresh_local()
                    this.emit_indent(raw_bool + " = zext i1 " + nil_bool + " to i64")
                    this.last_type = AST.Type.BoolType
                    var local: String = this.emit_tag_bool(raw_bool)
                    return local
                }
            }

            // Static-String comparison. Requires BOTH sides to be statically known
            // non-Any: __string_eq / __string_ne dereference their operands as char*
            // without inspecting the tag, so an Any operand holding nil (or an int,
            // or a list) segfaults inside strcmp.
            //
            // An `Any` operand must therefore fall through to the __any_eq/__any_ne
            // branch below, which unmasks and routes on the real tag and compares
            // string *contents* when both sides do turn out to be strings. Before
            // this ordering fix, `var x: Any = nil; x != "something"` crashed.
            if ((left_type == "String" or right_type == "String") and left_type != "Any" and right_type != "Any") {
                var raw_bool: String = this.fresh_local()
                if (op == "==") {
                    this.emit_indent(raw_bool + " = call i64 @__string_eq(i64 " + lhs + ", i64 " + rhs + ")")
                } else {
                    this.emit_indent(raw_bool + " = call i64 @__string_ne(i64 " + lhs + ", i64 " + rhs + ")")
                }
                this.last_type = AST.Type.BoolType
                var local: String = this.emit_tag_bool(raw_bool)
                return local
            }

            // Any-typed equality: use __any_eq/__any_ne for deep comparison
            // (handles strings with different pointers but same content)
            if (left_type == "Any" or right_type == "Any") {
                var raw_bool: String = this.fresh_local()
                if (op == "==") {
                    this.emit_indent(raw_bool + " = call i64 @__any_eq(i64 " + lhs + ", i64 " + rhs + ")")
                } else {
                    this.emit_indent(raw_bool + " = call i64 @__any_ne(i64 " + lhs + ", i64 " + rhs + ")")
                }
                this.last_type = AST.Type.BoolType
                var local: String = this.emit_tag_bool(raw_bool)
                return local
            }

            // Float equality: untag both sides as float and compare at double level.
            // Raw icmp eq fails when one value is int-tagged (0x7FF9...) and the
            // other is float-tagged (after arithmetic), even if semantically equal.
            if (left_type == "Float" or right_type == "Float") {
                var lf: String = this.fresh_local()
                this.emit_indent(lf + " = call double @__val_untag_float(i64 " + lhs + ")")
                var rf: String = this.fresh_local()
                this.emit_indent(rf + " = call double @__val_untag_float(i64 " + rhs + ")")
                var cmp_local: String = this.fresh_local()
                if (op == "==") { this.emit_indent(cmp_local + " = fcmp oeq double " + lf + ", " + rf) }
                else { this.emit_indent(cmp_local + " = fcmp une double " + lf + ", " + rf) }
                var raw_bool: String = this.fresh_local()
                this.emit_indent(raw_bool + " = zext i1 " + cmp_local + " to i64")
                this.last_type = AST.Type.BoolType
                var local: String = this.emit_tag_bool(raw_bool)
                return local
            }

            // Enum equality: structural, not by address (BUGS #116).
            //
            // This arm must sit above the integer fall-through, which is where two
            // operands of the same EnumType used to land. A payload variant is a
            // heap `[tag, f0, ...]` array (gen_enum_construct below), so `icmp eq`
            // on the two value slots compared the two *malloc addresses*:
            // `Option.Some(42) == Option.Some(42)` answered false, and so did
            // `Option.None == Option.None`, because as soon as ANY variant of the
            // enum carries a field EVERY variant is heap-allocated — a fieldless
            // one becomes a one-slot `[tag]` array instead of the `tag << 56`
            // immediate. `==` therefore meant value equality for an enum declared
            // without payloads and identity for one declared with them: one
            // spelling, two semantics, chosen by a detail of the declaration that
            // the comparison site cannot see.
            //
            // The comparison is routed to a per-enum `__enum_eq_<Name>` function
            // rather than to a generic runtime helper because variant arity and
            // field types live only in codegen's `enum_variant_fields`, and the
            // heap array carries no GC header or type tag that a runtime helper
            // could read (which is why `__rt_gc_tag_of` cannot identify one, and
            // why #115's enum half wants the header). Everything needed to compare
            // two of these values is known statically, right here.
            //
            // Only fires when both operands are the SAME declared enum and that
            // enum is heap-encoded. A fieldless enum keeps the `icmp eq` below,
            // which is already correct for immediates, and a mismatched pair falls
            // through unchanged.
            var __ee_lbase: String = this.generic_base_name(left_type)
            var __ee_rbase: String = this.generic_base_name(right_type)
            if (__ee_lbase == __ee_rbase and this.enum_defs.has(__ee_lbase) and this.get_max_fields(__ee_lbase) > 0) {
                var ee_sym: String = this.ensure_enum_eq(__ee_lbase)
                var ee_raw: String = this.fresh_local()
                this.emit_indent(ee_raw + " = call i64 @" + ee_sym + "(i64 " + lhs + ", i64 " + rhs + ")")
                // `!=` is the negation of the same call, so the two operators
                // cannot drift apart.
                var ee_cmp: String = this.fresh_local()
                if (op == "==") { this.emit_indent(ee_cmp + " = icmp ne i64 " + ee_raw + ", 0") }
                else { this.emit_indent(ee_cmp + " = icmp eq i64 " + ee_raw + ", 0") }
                var ee_bool: String = this.fresh_local()
                this.emit_indent(ee_bool + " = zext i1 " + ee_cmp + " to i64")
                this.last_type = AST.Type.BoolType
                return this.emit_tag_bool(ee_bool)
            }

            // List and Map equality: structural, not by address.
            //
            // These are the last two builtin aggregates that reached the integer
            // fall-through below, where `icmp eq` on two heap values compares the
            // two malloc addresses: `[1,2] == [1,2]` and `{"a":1} == {"a":1}` both
            // answered false while IO.println showed the operands identical. It is
            // the enum defect above in a different shape, and the same argument
            // applies — one spelling must not mean value equality for a String and
            // identity for a List.
            //
            // A user-level `eq` overload cannot close this: the operator-overload
            // dispatch at the top of gen_binary keys off class_methods, and List
            // and Map are runtime primitives with no Saffron class to hang a
            // method on. So the comparison routes to the runtime.
            //
            // __rt_val_eq, not __any_eq: __any_eq's body is hand-written IR that
            // exists only in base_nanbox.ll and wasm_base_32.ll, so an arm keyed on
            // it would emit an unresolvable symbol under --identity-mode (base.ll)
            // and on wasm64 (wasm_base.ll), which have neither. __rt_val_eq is
            // compiled from runtime.sf and is present wherever runtime.ll links,
            // which is every target. It is also the body __any_eq itself delegates
            // to, so the two spellings cannot disagree.
            //
            // Both operands must be statically List/Map. A single such operand
            // means the other is Any (already handled above) or a genuine type
            // mismatch, which is the checker's to report, not ours to guess at.
            var lm_lbase: String = this.generic_base_name(left_type)
            var lm_rbase: String = this.generic_base_name(right_type)
            var lhs_is_aggregate: Bool = lm_lbase == "List" or lm_lbase == "Map"
            var rhs_is_aggregate: Bool = lm_rbase == "List" or lm_rbase == "Map"
            if (lhs_is_aggregate and rhs_is_aggregate) {
                var lm_raw: String = this.fresh_local()
                this.emit_indent(lm_raw + " = call i64 @__rt_val_eq(i64 " + lhs + ", i64 " + rhs + ")")
                // `!=` is the negation of the same call, so the two operators
                // cannot drift apart.
                var lm_cmp: String = this.fresh_local()
                if (op == "==") { this.emit_indent(lm_cmp + " = icmp ne i64 " + lm_raw + ", 0") }
                else { this.emit_indent(lm_cmp + " = icmp eq i64 " + lm_raw + ", 0") }
                var lm_bool: String = this.fresh_local()
                this.emit_indent(lm_bool + " = zext i1 " + lm_cmp + " to i64")
                this.last_type = AST.Type.BoolType
                return this.emit_tag_bool(lm_bool)
            }

            // Integer comparison (tagged values compare equal correctly)
            var cmp_local: String = this.fresh_local()
            if (op == "==") { this.emit_indent(cmp_local + " = icmp eq i64 " + lhs + ", " + rhs) }
            else { this.emit_indent(cmp_local + " = icmp ne i64 " + lhs + ", " + rhs) }
            var raw_bool: String = this.fresh_local()
            this.emit_indent(raw_bool + " = zext i1 " + cmp_local + " to i64")
            // LLVM lib parallel path: track Value for == / != integer comparison
            if (this.use_llvm_lib and !this.identity_mode and this.llvm_values.has(lhs) and this.llvm_values.has(rhs)) {
                var lhs_v: Any = this.llvm_values.get(lhs)
                var rhs_v: Any = this.llvm_values.get(rhs)
                var cmp_v: Any = lhs_v
                if (op == "==") { cmp_v = this.llvm_block_builder.icmp_eq(lhs_v, rhs_v) }
                else { cmp_v = this.llvm_block_builder.icmp_ne(lhs_v, rhs_v) }
                var zext_v: Any = this.llvm_block_builder.zext(cmp_v, LLVMTypes.Type.I64)
                this.llvm_values.set(raw_bool, zext_v)
            }
            this.last_type = AST.Type.BoolType
            var local: String = this.emit_tag_bool(raw_bool)
            return local
        }

        if (op == "+") {
            // Type-directed: check types before generating code
            var left_type: String = this.get_expr_type(left)
            var right_type: String = this.get_expr_type(right)
            var lhs: String = this.gen_arg_value(left)
            if (left_type == "Any") { left_type = this.type_to_string(this.last_type) }
            var rhs: String = this.gen_arg_value(right)
            if (right_type == "Any") { right_type = this.type_to_string(this.last_type) }

            if (left_type == "String" or right_type == "String") {
                // String concatenation
                this.last_type = AST.Type.StringType
                var lptr: String = this.emit_untag_ptr(lhs)
                var rptr: String = this.emit_untag_ptr(rhs)
                var llen: String = this.fresh_local()
                this.emit_indent(llen + " = call i64 @strlen(i8* " + lptr + ")")
                var rlen: String = this.fresh_local()
                this.emit_indent(rlen + " = call i64 @strlen(i8* " + rptr + ")")
                var total: String = this.fresh_local()
                this.emit_indent(total + " = add i64 " + llen + ", " + rlen)
                var total1: String = this.fresh_local()
                this.emit_indent(total1 + " = add i64 " + total + ", 1")
                var buf: String = this.fresh_local()
                this.emit_indent(buf + " = call i8* @__sf_malloc(" + this.malloc_size_type() + " " + this.malloc_size_arg(total1) + ")")
                this.emit_indent("call i8* @strcpy(i8* " + buf + ", i8* " + lptr + ")")
                this.emit_indent("call i8* @strcat(i8* " + buf + ", i8* " + rptr + ")")
                var raw_result: String = this.ptr_to_val(buf)
                var result: String = this.fresh_local()
                this.emit_indent(result + " = call i64 @__string_intern(i64 " + raw_result + ")")
                // Tag the interned pointer for NaN-boxing
                var intern_ptr: String = this.fresh_local()
                this.emit_indent(intern_ptr + " = inttoptr i64 " + result + " to i8*")
                var tagged_result: String = this.emit_tag_ptr(intern_ptr)
                // LLVM lib parallel path: track string concatenation result
                if (!this.identity_mode) {
                    var sc_res: LLVMTypes.Value = this.llvm_block_builder.call("__string_concat", LLVMTypes.Type.I64, [])
                    this.llvm_values.set(tagged_result, sc_res)
                }
                return tagged_result
            }

            if (left_type == "Float" or right_type == "Float") {
                this.last_type = AST.Type.FloatType
                var ld: String = this.emit_untag_float(lhs)
                var rd: String = this.emit_untag_float(rhs)
                var fd: String = this.fresh_local()
                this.emit_indent(fd + " = fadd double " + ld + ", " + rd)
                return this.emit_tag_float(fd)
            }

            // Integer addition
            this.last_type = AST.Type.IntType
            var lhs_raw: String = this.emit_untag_int(lhs)
            var rhs_raw: String = this.emit_untag_int(rhs)
            var add_result: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("add", add_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for add
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.add(lhs_v, rhs_v)
                    this.llvm_values.set(add_result, res_v)
                }
            } else {
                this.emit_indent(add_result + " = add i64 " + lhs_raw + ", " + rhs_raw)
            }
            var local: String = this.emit_tag_int(add_result)
            return local
        }

        var left_type2: String = this.get_expr_type(left)
        var lhs: String = this.gen_arg_value(left)
        if (left_type2 == "Any") { left_type2 = this.type_to_string(this.last_type) }
        var right_type2: String = this.get_expr_type(right)
        var rhs: String = this.gen_arg_value(right)
        if (right_type2 == "Any") { right_type2 = this.type_to_string(this.last_type) }

        var __is_float_l: Bool = left_type2 == "Float"
        var __is_float_r: Bool = right_type2 == "Float"
        var __either_float: Bool = __is_float_l or __is_float_r
        var __is_sub: Bool = op == "-"
        var __is_mul: Bool = op == "*"
        var __is_div: Bool = op == "/"
        var __is_mod: Bool = op == "%"
        var __any_arith_op: Bool = __is_sub or __is_mul or __is_div or __is_mod
        var __take_float_path: Bool = __either_float and __any_arith_op

        if (__take_float_path) {
            this.last_type = AST.Type.FloatType
            var ld: String = this.emit_untag_float(lhs)
            var rd: String = this.emit_untag_float(rhs)
            var fd: String = this.fresh_local()
            if (op == "-") {
                this.emit_indent(fd + " = fsub double " + ld + ", " + rd)
            } else if (op == "*") {
                this.emit_indent(fd + " = fmul double " + ld + ", " + rd)
            } else if (op == "/") {
                this.emit_indent(fd + " = fdiv double " + ld + ", " + rd)
            } else {
                this.emit_indent(fd + " = frem double " + ld + ", " + rd)
            }
            return this.emit_tag_float(fd)
        }

        // Untag integer operands for arithmetic/comparison
        var lhs_raw: String = this.emit_untag_int(lhs)
        var rhs_raw: String = this.emit_untag_int(rhs)

        // Guard against division/modulo by zero
        if (op == "/" or op == "%") {
            var is_zero: String = this.fresh_local()
            this.emit_indent(is_zero + " = icmp eq i64 " + rhs_raw + ", 0")
            var lbl_err: String = this.fresh_label("div_err")
            var lbl_ok: String = this.fresh_label("div_ok")
            this.emit_terminator("br i1 " + is_zero + ", label %" + lbl_err + ", label %" + lbl_ok)
            this.start_block(lbl_err)
            this.emit_indent("call i64 @__division_error()")
            this.emit_terminator("unreachable")
            this.start_block(lbl_ok)
        }
        var op_result: String = this.fresh_local()
        this.last_type = AST.Type.IntType

        if (op == "-") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("sub", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for sub
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.sub(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = sub i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "*") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("mul", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for mul
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.mul(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = mul i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "/") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("sdiv", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for sdiv
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.sdiv(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = sdiv i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "%") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("srem", op_result, lhs_raw, rhs_raw))
                // LLVM lib parallel path: track Value for srem
                if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                    var lhs_v: Any = this.llvm_values.get(lhs_raw)
                    var rhs_v: Any = this.llvm_values.get(rhs_raw)
                    var res_v: Any = this.llvm_block_builder.srem(lhs_v, rhs_v)
                    this.llvm_values.set(op_result, res_v)
                }
            } else {
                this.emit_indent(op_result + " = srem i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "&") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("and", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = and i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "|") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("or", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = or i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "^") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("xor", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = xor i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "<<") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("shl", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = shl i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == ">>") {
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_binary_op("ashr", op_result, lhs_raw, rhs_raw))
            } else {
                this.emit_indent(op_result + " = ashr i64 " + lhs_raw + ", " + rhs_raw)
            }
        }
        else if (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=") {
            this.last_type = AST.Type.BoolType
            var cmp_local: String = this.fresh_local()
            var __ord_helper: String = this.ordering_helper(op)
            var __ord_static: Bool = this.is_ordered_primitive(left_type2) and this.is_ordered_primitive(right_type2)
            if (__ord_helper.length() > 0 and (left_type2 == "String" or right_type2 == "String")) {
                var strcmp_result: String = this.fresh_local()
                this.emit_indent(strcmp_result + " = call i64 @__safe_strcmp(i64 " + lhs + ", i64 " + rhs + ")")
                if (op == "<") { this.emit_indent(cmp_local + " = icmp slt i64 " + strcmp_result + ", 0") }
                else if (op == "<=") { this.emit_indent(cmp_local + " = icmp sle i64 " + strcmp_result + ", 0") }
                else if (op == ">") { this.emit_indent(cmp_local + " = icmp sgt i64 " + strcmp_result + ", 0") }
                else { this.emit_indent(cmp_local + " = icmp sge i64 " + strcmp_result + ", 0") }
            }
            // Ordering with at least one operand whose static type does not pin
            // down its representation. This is the #104 arm, and it must sit
            // ABOVE the Float and integer arms: those untag both sides as a
            // number, so reaching them with a TAG_PTR operand compares the bit
            // patterns of two heap pointers. The comparison then depended on heap
            // layout, which is how the same program answered differently at -O0
            // and -O2 while `run_tests.sh` (which builds -O2) stayed green.
            //
            // `Any` is not a rare annotation to sprinkle a special case on: it is
            // what every generic container's elements are, so `_bisect(value: Any)`
            // in sorted_set.sf, heap.sf's default comparators and test.sf's
            // assert_lt all landed here. The dispatch is deferred to __val_cmp,
            // which reads the tags of both operands (BUGS #104).
            //
            // Numeric comparison does NOT regress into a call: when both static
            // types are Int/Number/Float, __ord_static is true and control falls
            // through to the fcmp/icmp arms below exactly as before.
            else if (__ord_helper.length() > 0 and !__ord_static) {
                // Registering the call is what emits `declare i64 @__val_lt(i64,
                // i64)`: output_body's trailing loop declares every
                // called_function that this module does not itself define. That
                // keeps the four helpers out of runtime_declares(), which matters
                // because runtime.sf *defines* them — a declare there would
                // collide with the definition.
                this.called_functions.push(__ord_helper)
                this.called_function_arity.set(__ord_helper, 2)
                var ord_raw: String = this.fresh_local()
                this.emit_indent(ord_raw + " = call i64 @" + __ord_helper + "(i64 " + lhs + ", i64 " + rhs + ")")
                this.emit_indent(cmp_local + " = icmp ne i64 " + ord_raw + ", 0")
            } else if (left_type2 == "Float" or right_type2 == "Float") {
                var cld: String = this.emit_untag_float(lhs)
                var crd: String = this.emit_untag_float(rhs)
                if (op == "==") { this.emit_indent(cmp_local + " = fcmp oeq double " + cld + ", " + crd) }
                else if (op == "!=") { this.emit_indent(cmp_local + " = fcmp one double " + cld + ", " + crd) }
                else if (op == "<") { this.emit_indent(cmp_local + " = fcmp olt double " + cld + ", " + crd) }
                else if (op == "<=") { this.emit_indent(cmp_local + " = fcmp ole double " + cld + ", " + crd) }
                else if (op == ">") { this.emit_indent(cmp_local + " = fcmp ogt double " + cld + ", " + crd) }
                else if (op == ">=") { this.emit_indent(cmp_local + " = fcmp oge double " + cld + ", " + crd) }
            } else if (op == "==") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("eq", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_eq value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_eq(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp eq i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == "!=") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("ne", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_ne value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_ne(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp ne i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == "<") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("slt", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_slt value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_slt(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp slt i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == "<=") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("sle", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_sle value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_sle(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp sle i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == ">") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("sgt", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_sgt value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_sgt(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp sgt i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            else if (op == ">=") {
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_icmp_op("sge", cmp_local, lhs_raw, rhs_raw))
                    // LLVM lib parallel path: track icmp_sge value
                    if (!this.identity_mode and this.llvm_values.has(lhs_raw) and this.llvm_values.has(rhs_raw)) {
                        var lhs_v: Any = this.llvm_values.get(lhs_raw)
                        var rhs_v: Any = this.llvm_values.get(rhs_raw)
                        var cmp_v: Any = this.llvm_block_builder.icmp_sge(lhs_v, rhs_v)
                        this.llvm_values.set(cmp_local, cmp_v)
                    }
                } else {
                    this.emit_indent(cmp_local + " = icmp sge i64 " + lhs_raw + ", " + rhs_raw)
                }
            }
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_zext_op(op_result, cmp_local))
                // LLVM lib parallel path: track zext value
                if (!this.identity_mode and this.llvm_values.has(cmp_local)) {
                    var cmp_v: Any = this.llvm_values.get(cmp_local)
                    var ext_v: Any = this.llvm_block_builder.zext(cmp_v, LLVMTypes.Type.I64)
                    this.llvm_values.set(op_result, ext_v)
                }
            } else {
                this.emit_indent(op_result + " = zext i1 " + cmp_local + " to i64")
            }
        }

        // Tag the result: int for arithmetic/bitwise, bool for comparisons
        var local: String = op_result
        if (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=") {
            local = this.emit_tag_bool(op_result)
        } else {
            local = this.emit_tag_int(op_result)
        }
        return local
    }

    fun gen_string_concat(left: AST.Expr, right: AST.Expr): String {
        // Flatten string concat at compile time
        var combined: String = this.flatten_string_expr(left) + this.flatten_string_expr(right)
        var const_name: String = this.add_string_constant(combined)
        var gep: String = this.fresh_local()
        var len: Float = combined.length() + 1
        this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
        var local: String = this.emit_tag_ptr(gep)
        return local
    }

    fun flatten_string_expr(expr: AST.Expr): String {
        return match (expr) {
            StringLit(s) => s
            Binary(l, o, r) => this.flatten_string_expr(l) + this.flatten_string_expr(r)
            // Every caller guards with is_string_expr, which admits only those
            // two shapes, so this arm is unreachable. It still has to be written:
            // a missing arm yields an indeterminate value rather than a
            // diagnostic (BUGS #76), so a future caller that forgot the guard
            // would silently emit a garbage string constant instead of "".
            _ => ""
        }
    }

    // BUGS #107 (function-value printing): allocate the 16-byte closure pair
    // { fn_ptr@0, env_ptr@8 } through the GC with type tag 4 (the tag gc.ll's
    // trace_closure already expects) instead of a bare __sf_malloc. The pointer
    // stays UNTAGGED — the call path (`inttoptr` on the raw i64, no untag) and
    // trace_closure both read a bare pointer — but it now carries a GC header, so
    // __val_class_tag reads back 4 and __any_to_string can print `<function>`
    // instead of the raw address. Mirrors emit_enum_payload_alloc's identity/
    // wasm64 gate: identity_mode and the unheadered wasm64 __gc_alloc keep the old
    // __sf_malloc, so those targets print the pointer exactly as before (they were
    // never nanbox-correct there anyway — see #131).
    fun emit_closure_alloc(): String {
        if (this.identity_mode or this.target == "wasm64" or this.target == "wasm") {
            var raw: String = this.fresh_local()
            this.emit_indent(raw + " = call i8* @__sf_malloc(i64 16)")
            var ptr: String = this.fresh_local()
            this.emit_indent(ptr + " = bitcast i8* " + raw + " to [2 x i64]*")
            return ptr
        }
        var gc_raw: String = this.fresh_local()
        this.emit_indent(gc_raw + " = call i64 @__gc_alloc(i64 16, i64 4)")
        return this.val_to_typed_ptr(gc_raw, "[2 x i64]*")
    }

    fun gen_func_ref(fn_name: String): String {
        // BUGS #107: a function value's static type is Any, not Int. It used to be
        // IntType, which made string interpolation (`"${greet}"`) format the
        // closure pointer through __int_to_string at compile time — printing the
        // raw address as a decimal — instead of the runtime __any_to_string that
        // now recognises the closure's GC tag 4 and prints `<function>`. The
        // closure pair is an i64 value either way; only the formatter dispatch and
        // an untyped var's inferred type change, and Any is the honest answer for
        // a first-class function whose signature codegen does not track here.
        this.last_type = AST.Type.AnyType
        var nparams: Float = 0
        if (this.func_param_count.has(fn_name)) {
            nparams = this.func_param_count.get(fn_name)
        }

        // Check if this function has captures (nested function with free variables).
        // If so, we must build a closure that packs the captured variable addresses
        // into an environment, and generate a trampoline that unpacks them.
        var has_captures: Bool = this.called_function_arity.has("__captures_" + fn_name)
        var cap_names: List<String> = []
        if (has_captures) {
            var caps_str: String = this.func_prefix_map.get("__caps_" + fn_name)
            if (caps_str.length() > 0) {
                cap_names = caps_str.split(",")
            } else {
                has_captures = false
            }
        }

        if (has_captures and cap_names.length() > 0) {
            // --- Nested function with captures: build a proper closure ---
            // The real function signature is: (cap0_ptr, cap1_ptr, ..., user_arg0, ...)
            // We create:
            //   1. An environment array holding the capture pointer values
            //   2. A trampoline that takes (env, user_args...), unpacks captures from
            //      env, and calls the real function with (caps..., user_args...)

            var num_caps: Float = cap_names.length()

            // Allocate environment: array of i64, one slot per capture
            var env_bytes: Float = num_caps * 8
            var env_raw: String = this.fresh_local()
            this.emit_indent(env_raw + " = call i8* @__sf_malloc(i64 " + env_bytes.floor().to_string() + ")")
            var env_ptr: String = this.fresh_local()
            this.emit_indent(env_ptr + " = bitcast i8* " + env_raw + " to [" + num_caps.floor().to_string() + " x i64]*")

            // Store capture pointer values into the environment
            var ci: Float = 0
            while (ci < num_caps) {
                var cap_val: String = this.typed_ptr_to_val("%" + this.sanitize_name(cap_names[ci]), "i64*")
                var slot: String = this.fresh_local()
                this.emit_indent(slot + " = getelementptr [" + num_caps.floor().to_string() + " x i64], [" + num_caps.floor().to_string() + " x i64]* " + env_ptr + ", i64 0, i64 " + ci.floor().to_string())
                this.emit_indent("store i64 " + cap_val + ", i64* " + slot)
                ci = ci + 1
            }

            // Generate trampoline: takes (i64 env, user_args...) and calls real function
            this.label_counter = this.label_counter + 1
            var wrap_name: String = "__wrap_" + this.label_counter.floor().to_string() + "_" + this.sanitize_name(fn_name)

            var wrap_params: List<String> = []
            wrap_params.push("i64 %__env.arg")
            var pi: Float = 0
            while (pi < nparams) {
                wrap_params.push("i64 %__a" + pi.floor().to_string() + ".arg")
                pi = pi + 1
            }

            var wrap_linkage: String = "define linkonce_odr"
            if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
                wrap_linkage = "define"
            }

            // Trampoline body: unpack captures from env, then call real function
            var wrap_ir: String = "\n" + wrap_linkage + " i64 @" + wrap_name + "(" + wrap_params.join(", ") + ") {\nentry:\n"

            // Cast env to typed array pointer
            if (this.target == "wasm32") {
                wrap_ir = wrap_ir + "  %__env_i32 = trunc i64 %__env.arg to i32\n"
                wrap_ir = wrap_ir + "  %__env_ptr = inttoptr i32 %__env_i32 to [" + num_caps.floor().to_string() + " x i64]*\n"
            } else {
                wrap_ir = wrap_ir + "  %__env_ptr = inttoptr i64 %__env.arg to [" + num_caps.floor().to_string() + " x i64]*\n"
            }

            // Extract each capture from env
            var fwd_args: List<String> = []
            ci = 0
            while (ci < num_caps) {
                var slot_name: String = "%__cap_slot_" + ci.floor().to_string()
                var val_name: String = "%__cap_" + ci.floor().to_string()
                wrap_ir = wrap_ir + "  " + slot_name + " = getelementptr [" + num_caps.floor().to_string() + " x i64], [" + num_caps.floor().to_string() + " x i64]* %__env_ptr, i64 0, i64 " + ci.floor().to_string() + "\n"
                wrap_ir = wrap_ir + "  " + val_name + " = load i64, i64* " + slot_name + "\n"
                fwd_args.push("i64 " + val_name)
                ci = ci + 1
            }

            // Add user args
            pi = 0
            while (pi < nparams) {
                fwd_args.push("i64 %__a" + pi.floor().to_string() + ".arg")
                pi = pi + 1
            }

            // Call the real function. BUGS #186: match the callee's real return
            // type — a coroutine target is `ptr`-returning (presplitcoroutine), so a
            // `call i64` against it is a signature mismatch that traps on wasm32.
            var cap_is_coro: Bool = this.str_in_list(this.coroutine_funcs, fn_name)
            var cap_ret_ty: String = "i64"
            if (cap_is_coro) { cap_ret_ty = "ptr" }
            wrap_ir = wrap_ir + "  %r = call " + cap_ret_ty + " @" + fn_name + "(" + fwd_args.join(", ") + ")\n"
            wrap_ir = wrap_ir + "  ret " + cap_ret_ty + " %r\n}\n"
            this.globals.push(wrap_ir)

            // Build closure pair [trampoline_fn_ptr, env_ptr]
            var num_total_params: Float = nparams + 1
            var fn_type_str: String = cap_ret_ty + " ("
            var tti: Float = 0
            while (tti < num_total_params) {
                if (tti > 0) { fn_type_str = fn_type_str + ", " }
                fn_type_str = fn_type_str + "i64"
                tti = tti + 1
            }
            fn_type_str = fn_type_str + ")*"

            var closure_ptr: String = this.emit_closure_alloc()
            var fn_as_int: String = this.fn_ptr_to_val(fn_type_str, "@" + wrap_name)
            var fn_slot: String = this.fresh_local()
            this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
            var env_as_int: String = this.typed_ptr_to_val(env_ptr, "[" + num_caps.floor().to_string() + " x i64]*")
            var env_slot: String = this.fresh_local()
            this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
            this.emit_indent("store i64 " + env_as_int + ", i64* " + env_slot)
            var result: String = this.typed_ptr_to_val(closure_ptr, "[2 x i64]*")
            return result
        }

        // --- No captures: plain function reference ---
        // Generate a trampoline wrapper that accepts (i64 env, <original params>)
        // and forwards to the real function (dropping env). This ensures the closure
        // calling convention (env first) works for plain function references.
        this.label_counter = this.label_counter + 1
        var wrap_name: String = "__wrap_" + this.label_counter.floor().to_string() + "_" + this.sanitize_name(fn_name)

        // Build trampoline param list: env + original params
        var wrap_params: List<String> = []
        wrap_params.push("i64 %__env.arg")
        var fwd_args: List<String> = []
        var pi: Float = 0
        while (pi < nparams) {
            var pname: String = "%__a" + pi.floor().to_string() + ".arg"
            wrap_params.push("i64 " + pname)
            fwd_args.push("i64 " + pname)
            pi = pi + 1
        }

        // Build the trampoline function IR
        // On WASM targets, use plain define to avoid function table index mismatch
        var wrap_linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            wrap_linkage = "define"
        }
        // BUGS #186: a coroutine is emitted `define ptr @f(...) presplitcoroutine`
        // and returns a *frame handle*, not an i64 value. The trampoline is only a
        // signature adapter (drop the env arg, forward the rest), so it MUST match
        // the callee's real return type: for a coroutine target that is `ptr`, not
        // `i64`. A `call i64 @f()` against a `ptr`-returning presplitcoroutine is a
        // signature mismatch that traps on wasm32's typed call_indirect table (and
        // silently reads the handle as a value on native). Emitting `ptr` here — and
        // storing a `ptr`-returning fn_type_str below — makes `Task.spawn(worker)`
        // lower to the same shape as the working `Task.spawn(fun () => worker())`
        // (whose lambda is forced into a `ptr`-returning coroutine): the spawn
        // handler calls the closure fn ptr as `call ptr fn_ptr(i64 env)` and drives
        // the returned frame through the scheduler.
        var ref_is_coro: Bool = this.str_in_list(this.coroutine_funcs, fn_name)
        var wrap_ret_ty: String = "i64"
        if (ref_is_coro) { wrap_ret_ty = "ptr" }
        var wrap_ir: String = "\n" + wrap_linkage + " " + wrap_ret_ty + " @" + wrap_name + "(" + wrap_params.join(", ") + ") {\nentry:\n"
        if (nparams == 0) {
            wrap_ir = wrap_ir + "  %r = call " + wrap_ret_ty + " @" + fn_name + "()\n"
        } else {
            wrap_ir = wrap_ir + "  %r = call " + wrap_ret_ty + " @" + fn_name + "(" + fwd_args.join(", ") + ")\n"
        }
        wrap_ir = wrap_ir + "  ret " + wrap_ret_ty + " %r\n}\n"
        this.globals.push(wrap_ir)

        // Build closure pair [trampoline_fn_ptr, 0] on the heap
        var num_total_params: Float = nparams + 1
        var fn_type_str: String = wrap_ret_ty + " ("
        var tti: Float = 0
        while (tti < num_total_params) {
            if (tti > 0) { fn_type_str = fn_type_str + ", " }
            fn_type_str = fn_type_str + "i64"
            tti = tti + 1
        }
        fn_type_str = fn_type_str + ")*"

        var closure_ptr: String = this.emit_closure_alloc()
        var fn_as_int: String = this.fn_ptr_to_val(fn_type_str, "@" + wrap_name)
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        // Slot 1 is the closure's env. For a plain (no-capture) function or class
        // ref the trampoline ignores it, so when the referenced declaration has a
        // `///` docstring we store the tagged doc-constant pointer here instead of
        // 0. __reflect_doc reads it back; calling the ref is unaffected. Non-doc'd
        // refs keep the 0, so this is inert everywhere else.
        if (this.func_docs.has(fn_name)) {
            var doc_str: String = this.func_docs.get(fn_name)
            var doc_c: String = this.add_string_constant(doc_str)
            var doc_len: Float = doc_str.length() + 1
            var doc_gep: String = this.fresh_local()
            this.emit_indent(doc_gep + " = getelementptr [" + doc_len.floor().to_string() + " x i8], [" + doc_len.floor().to_string() + " x i8]* " + doc_c + ", i64 0, i64 0")
            var doc_val: String = this.emit_tag_ptr(doc_gep)
            this.emit_indent("store i64 " + doc_val + ", i64* " + env_slot)
        } else {
            this.emit_indent("store i64 0, i64* " + env_slot)
        }
        var result: String = this.typed_ptr_to_val(closure_ptr, "[2 x i64]*")
        return result
    }

    /// Root an already-evaluated argument value as a GC temp root, for the rest of
    /// call setup. BUGS #162: an argument lives only in an LLVM SSA register between
    /// its own evaluation and the `call`, and the collector's roots are all *slot
    /// addresses* (output_body.sf pushes the address of a local's or param's
    /// alloca), so a later argument that allocates could free it. This pushes the
    /// VALUE — sound because the collector does not move, so a root only has to keep
    /// the object marked.
    ///
    /// Returns 1 if a push was emitted, 0 if not, so the caller can accumulate an
    /// exact pop count. Callers must `gen_pop_arg_roots(n)` right after the `call`.
    ///
    /// Skipped in identity_mode (the bootstrap links a base.ll whose GC entry points
    /// are no-ops, and nothing is ever collected there). That is the identity-mode
    /// blind spot again: the bootstrap cannot exercise this, so the coverage is
    /// test/pass/arg_temp_rooted.sf compiled by gen3.
    fun gen_root_arg_temp(val: String): Float {
        if (this.identity_mode) { return 0 }
        // A literal operand ("0", "1", an inttoptr constant expression) is not a
        // heap value and pushing it would only cost a rejected __gc_is_heap_ptr
        // check. Registers are what matter, and they all start with '%'.
        if (!val.starts_with("%")) { return 0 }
        this.emit_indent("call void @__gc_push_temp(i64 " + val + ")")
        return 1
    }

    /// Drop `n` argument temp roots. Emitted immediately after the `call` that
    /// consumes them. A count rather than a saved depth on purpose: a depth would be
    /// an SSA register that must dominate its use, and an argument containing a
    /// short-circuit `and`, a ternary or a `try` expression splits the basic block.
    fun gen_pop_arg_roots(n: Float) {
        if (this.identity_mode) { return nil }
        if (n <= 0) { return nil }
        // .floor() before .to_string(): a bare Float renders as "2.000000", which is
        // not a valid i64 literal. Same convention as the __gc_pop_roots sites.
        this.emit_indent("call void @__gc_pop_temps(i64 " + n.floor().to_string() + ")")
    }

    fun gen_arg_value(expr: AST.Expr): String {
        // Handle function references as values (e.g. passing HomePage to Router.Route)
        var expr_kind: String = this.classify_expr(expr)
        if (expr_kind == "variable") {
            var __vn: String = match (expr) { Variable(n, __vs) => n
                Ref(rk, rn, rs, __rs) => rn
                _ => ""
            }
            // Nested-`fun` binding in this body wins over a like-named module
            // global. Same rule as the Variable arm of gen_expr; this is the copy
            // that `return cl` and `f(cl)` go through, and it was the one actually
            // producing the null closure in BUGS #80.
            if (this.current_fn_locals.has("__nestedfn:" + __vn) and !this.typed_vars.has(__vn) and !this.named_imports.has(__vn)) {
                if (this.str_in_list(this.known_functions,this.current_prefix + __vn)) {
                    return this.gen_func_ref(this.current_prefix + __vn)
                }
                if (this.str_in_list(this.known_functions,__vn)) {
                    return this.gen_func_ref(__vn)
                }
            }
            if (this.str_in_list(this.known_functions,__vn)) {
                if (!this.typed_vars.has(__vn)) {
                    if (!this.module_globals.has(this.current_prefix + __vn)) {
                        if (!this.named_imports.has(__vn)) {
                            return this.gen_func_ref(__vn)
                        }
                    }
                }
            }
            if (this.str_in_list(this.known_functions,this.current_prefix + __vn)) {
                if (!this.typed_vars.has(__vn)) {
                    if (!this.module_globals.has(this.current_prefix + __vn)) {
                        if (!this.named_imports.has(__vn)) {
                            return this.gen_func_ref(this.current_prefix + __vn)
                        }
                    }
                }
            }
        }
        if (expr_kind == "method_call") {
            var mc_obj: AST.Expr = match (expr) { MethodCall(o, m, a, __ks) => o
                _ => AST.Expr.NilLit
            }
            var mc_method: String = match (expr) { MethodCall(o, m, a, __ks) => m
                _ => ""
            }
            var mc_args: List<AST.Expr> = match (expr) { MethodCall(o, m, a, __ks) => a
                _ => []
            }
            return this.gen_method_call(mc_obj, mc_method, mc_args)
        }
        if (expr_kind == "list_lit") {
            var elems: List<AST.Expr> = match (expr) { ListLit(e) => e
                _ => []
            }
            return this.gen_list_lit(elems)
        }
        if (expr_kind == "tuple_lit") {
            var elems: List<AST.Expr> = match (expr) { TupleLit(e) => e
                _ => []
            }
            var result: String = this.gen_list_lit(elems)
            var tuple_type_str: String = "Tuple<"
            var tti: Float = 0
            while (tti < elems.length()) {
                if (tti > 0) { tuple_type_str = tuple_type_str + "," }
                var elem_type: String = this.get_expr_type(elems[tti])
                tuple_type_str = tuple_type_str + elem_type
                tti = tti + 1
            }
            tuple_type_str = tuple_type_str + ">"
            this.last_type = this.str_to_type(tuple_type_str)
            return result
        }
        if (expr_kind == "index_get") {
            var ig_obj: AST.Expr = match (expr) { IndexGet(o, i) => o
                _ => AST.Expr.NilLit
            }
            var ig_idx: AST.Expr = match (expr) { IndexGet(o, i) => i
                _ => AST.Expr.NilLit
            }
            return this.gen_index_get(ig_obj, ig_idx)
        }
        if (expr_kind == "map_lit") {
            this.last_type = this.make_map_type()
            var local: String = this.fresh_local()
            this.emit_indent(local + " = call i64 @__map_new()")
            return local
        }
        if (expr_kind == "match_expr") {
            // Fall through to gen_expr which handles Match(subject, arms) directly
            return this.gen_expr(expr)
        }
        if (expr_kind == "if_expr") {
            return this.gen_expr(expr)
        }
        if (expr_kind == "try_expr") {
            return this.gen_expr(expr)
        }
        if (expr_kind == "block_expr") {
            var be_stmts: List<AST.Stmt> = match (expr) { BlockExpr(s, v) => s
                _ => []
            }
            var be_value: AST.Expr = match (expr) { BlockExpr(s, v) => v
                _ => AST.Expr.NilLit
            }
            this.gen_stmts(be_stmts)
            return this.gen_arg_value(be_value)
        }
        if (expr_kind == "get_field") {
            var gf_obj: AST.Expr = match (expr) { GetField(o, f, __gs) => o
                _ => AST.Expr.NilLit
            }
            var gf_field: String = match (expr) { GetField(o, f, __gs) => f
                _ => ""
            }
            return this.gen_get_field(gf_obj, gf_field)
        }
        if (expr_kind == "this") {
            this.last_type = this.str_to_type(this.current_class)
            var local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_load(local, "i64", "%self"))
            } else {
                this.emit_indent(local + " = load i64, i64* %self")
            }
            return local
        }
        if (expr_kind == "set_field") {
            var sf_obj: AST.Expr = match (expr) { SetField(o, f, v, __ss) => o
                _ => AST.Expr.NilLit
            }
            var sf_field: String = match (expr) { SetField(o, f, v, __ss) => f
                _ => ""
            }
            var sf_val: AST.Expr = match (expr) { SetField(o, f, v, __ss) => v
                _ => AST.Expr.NilLit
            }
            // The LIVE write site — this is the copy every spelling of
            // `Alias.member = value` reaches (BUGS #122). See the `SetField` arm
            // of `gen_expr` for the dead twin and how that was established.
            if (this.report_missing_module_write(sf_obj, sf_field)) {
                return "0"
            }
            return this.gen_set_field(sf_obj, sf_field, sf_val)
        }
        if (expr_kind == "binary") {
            var b_left: AST.Expr = match (expr) { Binary(l, o, r) => l
                _ => AST.Expr.NilLit
            }
            var b_op: String = match (expr) { Binary(l, o, r) => o
                _ => ""
            }
            var b_right: AST.Expr = match (expr) { Binary(l, o, r) => r
                _ => AST.Expr.NilLit
            }
            return this.gen_binary(b_left, b_op, b_right)
        }
        if (expr_kind == "variable") {
            // A resolved Ref already knows local-vs-global, so take it at its
            // word instead of re-deriving from module_globals below. That
            // re-derivation tests the global branch first, so a module global
            // beat a like-named parameter and the parameter became unreachable
            // — BUGS #40, whose repro is `var x` in the main program silently
            // capturing math.sf's `sqrt(x)` parameter.
            var ref_kind: String = match (expr) { Ref(rk, rn, rs, __rs) => rk
                _ => ""
            }
            if (ref_kind == "local" or ref_kind == "param") {
                var pname: String = match (expr) { Ref(rk, rn, rs, __rs) => rn
                    _ => ""
                }
                if (this.typed_vars.has(pname)) {
                    this.last_type = this.typed_vars.get(pname)
                } else {
                    this.last_type = AST.Type.IntType
                }
                var plocal: String = this.fresh_local()
                var pref: String = "%" + this.sanitize_name(pname)
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_load(plocal, "i64", pref))
                    if (!this.identity_mode and this.llvm_values.has(pref)) {
                        this.llvm_values.set(plocal, this.llvm_values.get(pref))
                    }
                } else {
                    this.emit_indent(plocal + " = load i64, i64* " + pref)
                    this.verify_load(plocal, "i64", pref)
                }
                return plocal
            }
            var vname: String = match (expr) { Variable(n, __vs) => n
                Ref(rk, rn, rs, __rs) => rn
                _ => ""
            }
            if (this.typed_vars.has(vname)) {
                this.last_type = this.typed_vars.get(vname)
            } else if (this.global_var_types.has(vname)) {
                this.last_type = this.str_to_type(this.global_var_types.get(vname))
            } else if (this.current_prefix.length() > 0 and this.global_var_types.has(this.current_prefix + vname)) {
                this.last_type = this.str_to_type(this.global_var_types.get(this.current_prefix + vname))
            } else {
                this.last_type = AST.Type.IntType
            }
            // Undefined variable check. Kept as an error (BUGS #37): the load
            // emitted below references %name, which llc rejects anyway, so a
            // warning only delays the same failure into an opaque IR error.
            // BUGS #175: same qualified-symbol exemption as the Variable arm — a
            // nested fun referenced by bare name is known via scope$$vname.
            var __nf_vref_known: Bool = this.current_fn_locals.has("__nestedfn:" + vname) and this.nested_scope.length() > 0 and this.str_in_list(this.known_functions, this.nested_fun_symbol(this.nested_scope, vname))
            if (!__nf_vref_known and !this.typed_vars.has(vname) and !this.module_globals.has(this.current_prefix + vname) and !this.module_globals.has(vname) and !this.str_in_list(this.known_functions,vname) and !this.str_in_list(this.known_functions,this.current_prefix + vname) and vname != "self" and vname != "this" and vname != "super" and vname != "IO" and vname != "OS" and vname != "GC" and vname != "Task" and !this.module_prefixes.has(vname) and !this.enum_defs.has(vname) and !this.class_fields.has(vname)) {
                this.codegen_error("undefined variable '" + vname + "'")
            }
            // BUGS #175/#80: a nested fun referenced as a VALUE (`return collide_b`)
            // reaches this arm, which otherwise emits a plain `load %collide_b` — or,
            // when a module global shares the name, `load @__g_collide_b`, the wrong
            // storage (the #80 shadowing bug). A nested fun in scope SHADOWS a
            // like-named global, so the marker takes precedence over the global
            // diversion below — matching the first Variable arm at :103. Emit a
            // function reference (a closure, if it captures) to @scope$$name. Guarded
            // to fire only when the name is not a local variable (a real local wins).
            if (__nf_vref_known and this.current_fn_locals.has("__nestedfn:" + vname) and !this.typed_vars.has(vname) and !this.named_imports.has(vname)) {
                return this.gen_func_ref(this.nested_fun_symbol(this.nested_scope, vname))
            }
            var local: String = this.fresh_local()
            var var_ref: String = "%" + this.sanitize_name(vname)
            // Same as the Variable arm at :128 — `super` is the receiver
            // pointer, whose alloca is `%self`; there is no `%super` slot, so
            // the load below produced invalid IR (BUGS #70). This copy of the
            // variable-load path is the one arguments take.
            if (vname == "super") {
                var_ref = "%self"
            }
            if (this.module_globals.has(this.current_prefix + vname)) {
                var_ref = "@__g_" + this.current_prefix + this.sanitize_name(vname)
            } else if (this.module_globals.has(vname)) {
                var_ref = "@__g_" + this.sanitize_name(vname)
            }
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_load(local, "i64", var_ref))
                // LLVM lib parallel path: propagate stored Value for this variable
                if (!this.identity_mode and this.llvm_values.has(var_ref)) {
                    this.llvm_values.set(local, this.llvm_values.get(var_ref))
                }
            } else {
                this.emit_indent(local + " = load i64, i64* " + var_ref)
                this.verify_load(local, "i64", var_ref)
            }
            return local
        }
        if (expr_kind == "member") {
            var m_obj: Any = match (expr) { MemberAccess(o, f, __ms) => o
                _ => ""
            }
            var m_field: String = match (expr) { MemberAccess(o, f, __ms) => f
                _ => ""
            }
            // Check if object is This → field access
            var obj_kind: String = this.classify_expr(m_obj)
            if (obj_kind == "this") {
                return this.gen_get_field(m_obj, m_field)
            }
            // Tuple field access: t._0, t._1, etc.
            var mn: String = this.get_variable_name(m_obj)
            if (mn.length() > 0 and m_field.starts_with("_") and m_field.length() >= 2) {
                var tf_vtype2: String = this.get_var_type_str(mn)
                if (tf_vtype2.starts_with("Tuple<")) {
                    var tf_rest2: String = m_field.slice(1, m_field.length())
                    var tf_idx2: Float = tf_rest2.to_number()
                    var tf_obj2: String = this.gen_arg_value(m_obj)
                    var tf_idx_val2: String = this.fresh_local()
                    this.emit_indent(tf_idx_val2 + " = add i64 0, " + tf_idx2.floor().to_string())
                    var tf_result2: String = this.fresh_local()
                    this.emit_indent(tf_result2 + " = call i64 @__list_get(i64 " + tf_obj2 + ", i64 " + tf_idx_val2 + ")")
                    var tf_inner2: String = tf_vtype2.slice(6, tf_vtype2.length() - 1)
                    var tf_args2: List<String> = AST.split_type_args(tf_inner2)
                    if (tf_idx2 >= 0 and tf_idx2 < tf_args2.length()) {
                        this.last_type = this.str_to_type(tf_args2[tf_idx2])
                    } else {
                        this.last_type = AST.Type.AnyType
                    }
                    return tf_result2
                }
            }
            // Handle as field access on class instance or enum
            var vt: String = ""
            if (mn.length() > 0) {
                vt = this.get_var_type_str(mn)
            }
            var vt_resolved: String = this.resolve_class_type(vt)
            if (vt_resolved.length() > 0) {
                    var ov: String = this.gen_arg_value(m_obj)
                    var fi: Float = this.get_field_index(vt_resolved, m_field)
                    var op: String = this.val_to_typed_ptr(ov, "%" + vt_resolved + "*")
                    var fp: String = this.fresh_local()
                    this.emit_indent(fp + " = getelementptr %" + vt_resolved + ", %" + vt_resolved + "* " + op + ", i32 0, i32 " + fi.floor().to_string())
                    var result: String = this.fresh_local()
                    this.emit_indent(result + " = load volatile i64, i64* " + fp)
                    // The declared type may name a class type parameter; the
                    // receiver's own annotation (`vt`, arguments intact) binds it.
                    var vt_ft: String = this.get_field_type(vt_resolved, m_field)
                    this.last_type = this.str_to_type(this.substitute_class_type_params(vt_ft, vt))
                    return result
            }
            if (mn.length() > 0 and this.enum_variant_tags.has(mn + "." + m_field)) {
                return this.gen_enum_construct(mn, m_field, [])
            }
            // Package namespace: check named_imports for "Alias.field" first
            if (mn.length() > 0 and this.named_imports.has(mn + "." + m_field)) {
                var pe_ref2: String = this.named_imports.get(mn + "." + m_field)
                if (this.str_in_list(this.known_functions, pe_ref2)) {
                    return this.gen_func_ref(pe_ref2)
                }
            }
            // Module-prefixed function reference: e.g. Routes.list_packages used as value
            if (mn.length() > 0 and this.has_module_alias(mn)) {
                var mp_resolved: String = this.module_alias_prefix(mn) + m_field
                if (this.str_in_list(this.known_functions, mp_resolved)) {
                    return this.gen_func_ref(mp_resolved)
                }
                // Module-prefixed global variable: e.g. Cache.store
                if (this.module_globals.has(mp_resolved)) {
                    var mg_local: String = this.fresh_local()
                    var mg_ref: String = "@__g_" + this.sanitize_name(mp_resolved)
                    this.emit_indent(mg_local + " = load i64, i64* " + mg_ref)
                    // Publish the type so a method call on this receiver dispatches
                    // (see the matching comment in the MemberAccess handler above).
                    if (this.global_var_types.has(mp_resolved)) {
                        this.last_type = this.str_to_type(this.global_var_types.get(mp_resolved))
                    }
                    return mg_local
                }
                // Neither a function nor a global under this module's prefix.
                // `mn` is known to be a module alias here, so "not found" is
                // expressible at this point and nowhere downstream — which is
                // exactly why the diagnostic belongs here.
                //
                // Falling through instead reached the generic receiver fallback
                // below, which evaluates the *object* — the bare alias `Math` —
                // as if it were a local, emitting `load i64, i64* %Math` from an
                // SSA name that was never defined. The compile exited 0 and the
                // failure surfaced as "the compiler emitted invalid LLVM IR /
                // this is a compiler bug, not an error in your program" for what
                // is a plain typo in the user's source (BUGS #118).
                //
                // The undefined-variable check at the Variable arm above cannot
                // catch it: that check deliberately exempts module_prefixes,
                // because for a *valid* member access the bare alias really is
                // not a variable. So this is the only honest place to report.
                //
                // Eighth instance of one family (#22, #40, #78, #37, #103, #113,
                // #114): a resolver with no way to express "not found" guesses
                // instead of reporting absence.
                //
                // Measured before making the miss fatal: a probe compiler logged
                // every arrival here across 336 files (test/, test/pass/,
                // test/fail/, src/lib/, src/compiler/, examples/, turmeric/,
                // basil/, bazaar/, parsley/, pantry/). Exactly three arrivals,
                // and `opt` rejects the IR for all three — no valid spelling
                // depends on the fall-through. Enum variants, enum/class/actor
                // constructors, @inline functions, named imports, forward
                // references and locals shadowing an alias all resolve before
                // reaching here and were each confirmed unaffected.
                this.codegen_error("no member '" + m_field + "' in module '" + mn + "'")
                return "0"
            }
            // Module-qualified zero-arg enum: AST.Expr.This → try Expr.This
            if (mn.length() == 0) {
                var obj_kind2: String = this.classify_expr(m_obj)
                if (obj_kind2 == "member") {
                    var inner_field: String = match (m_obj) { MemberAccess(o, f, __ms) => f
                        _ => ""
                    }
                    var key: String = inner_field + "." + m_field
                    if (this.enum_variant_tags.has(key)) {
                        return this.gen_enum_construct(inner_field, m_field, [])
                    }
                    // Fallback: maybe the inner MemberAccess root is a module alias
                    // e.g. AST.Type.IntType where AST is module, Type is enum, IntType is variant
                    var inner_obj: AST.Expr = match (m_obj) { MemberAccess(o, f, __ms) => o
                        _ => AST.Expr.NilLit
                    }
                    var root_name: String = this.get_variable_name(inner_obj)
                    if (root_name.length() > 0 and !this.typed_vars.has(root_name)) {
                        if (this.enum_variant_tags.has(inner_field + "." + m_field)) {
                            return this.gen_enum_construct(inner_field, m_field, [])
                        }
                    }
                }
                // Nested field access: obj.field1.field2
                if (obj_kind2 == "get_field" or obj_kind2 == "member" or obj_kind2 == "this") {
                    var inner_val: String = this.gen_arg_value(m_obj)
                    var inner_type: String = this.type_to_string(this.last_type)
                    if (this.class_fields.has(inner_type)) {
                        // Resolve struct name via class_struct_names for module-prefixed types
                        var inner_struct: String = inner_type
                        if (this.class_struct_names.has(inner_type)) {
                            inner_struct = this.class_struct_names.get(inner_type)
                        }
                        var fi: Float = this.get_field_index(inner_type, m_field)
                        var op: String = this.val_to_typed_ptr(inner_val, "%" + inner_struct + "*")
                        var fp: String = this.fresh_local()
                        this.emit_indent(fp + " = getelementptr %" + inner_struct + ", %" + inner_struct + "* " + op + ", i32 0, i32 " + fi.floor().to_string())
                        var result: String = this.fresh_local()
                        this.emit_indent(result + " = load i64, i64* " + fp)
                        var it_ft: String = this.get_field_type(inner_type, m_field)
                        this.last_type = this.str_to_type(this.substitute_class_type_params(it_ft, inner_type))
                        return result
                    }
                }
            }
            // General fallback: evaluate the object expression (e.g. IndexGet) and use last_type
            var fb_val: String = this.gen_arg_value(m_obj)
            var fb_type_str: String = this.type_to_string(this.last_type)
            var fb_resolved: String = this.resolve_class_type(fb_type_str)
            if (fb_resolved.length() > 0 and this.class_fields.has(fb_resolved)) {
                var fb_struct: String = fb_resolved
                if (this.class_struct_names.has(fb_resolved)) {
                    fb_struct = this.class_struct_names.get(fb_resolved)
                }
                var fi: Float = this.get_field_index(fb_resolved, m_field)
                var op: String = this.val_to_typed_ptr(fb_val, "%" + fb_struct + "*")
                var fp: String = this.fresh_local()
                this.emit_indent(fp + " = getelementptr %" + fb_struct + ", %" + fb_struct + "* " + op + ", i32 0, i32 " + fi.floor().to_string())
                var result: String = this.fresh_local()
                this.emit_indent(result + " = load i64, i64* " + fp)
                var fb_ft: String = this.get_field_type(fb_resolved, m_field)
                this.last_type = this.str_to_type(this.substitute_class_type_params(fb_ft, fb_type_str))
                return result
            }
            // Nothing above could establish a class for the receiver, so the
            // field's offset is unknown — and this path answers with the integer
            // zero, emitting no GEP and no load at all.
            //
            // That is how `f(1).v` read 0 (BUGS #56): `Fun` carries no return
            // type, so an indirect call's result has no recoverable class, and
            // codegen handed back a plausible-looking constant rather than
            // admitting it did not know. The object was constructed correctly
            // the whole time; only this fallback was wrong.
            //
            // Report it — but only for that shape. This same fallback is the
            // normal, working route for several unrelated things (a module
            // constant like `Math.PI`, reflective field reads), which either
            // return 0 here legitimately or get resolved by a later stage.
            // Erroring unconditionally traded one silent wrong answer for a
            // batch of false rejections, so the diagnostic is narrowed to a
            // receiver that really is a call — the case that is genuinely
            // unknowable here rather than merely unresolved.
            //
            // The proper fix is a return type on `Fun`, a language change beyond
            // this repair; M2 in docs/design/compiler-rewrite.md ("unknown is
            // never spelled as something concrete") is why this reports instead
            // of guessing an offset.
            var fb_obj_kind: String = this.classify_expr(m_obj)
            if (fb_obj_kind == "call") {
                this.codegen_error("cannot determine the type of the receiver of '." + m_field + "': an indirect call through 'Fun' has no known return type, so the field's offset is unknown. Annotate the result first, e.g. 'var x: T = f(...)' then use 'x." + m_field + "'.")
            }
            this.last_type = AST.Type.AnyType
            return "0"
        }

        // Handle string literals directly
        if (this.is_string_expr(expr)) {
            this.last_type = AST.Type.StringType
            var str_val: String = this.flatten_string_expr(expr)
            var const_name: String = this.add_string_constant(str_val)
            var gep: String = this.fresh_local()
            var slen: Float = str_val.length() + 1
            this.emit_indent(gep + " = getelementptr [" + slen.to_string() + " x i8], [" + slen.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
            var local: String = this.emit_tag_ptr(gep)
            return local
        }
        return this.gen_expr(expr)
    }

    fun gen_string_ptr(expr: AST.Expr): String {
        if (this.is_string_expr(expr)) {
            // String literal: get pointer directly
            var str_val: String = this.flatten_string_expr(expr)
            var const_name: String = this.add_string_constant(str_val)
            var ptr: String = this.fresh_local()
            var slen: Float = str_val.length() + 1
            this.emit_indent(ptr + " = getelementptr [" + slen.to_string() + " x i8], [" + slen.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
            return ptr
        }
        // Variable or expression: gen_expr gives i64 (possibly tagged), convert to i8*
        var val: String = this.gen_arg_value(expr)
        var ptr: String = this.emit_untag_ptr(val)
        return ptr
    }

    fun gen_runtime_string_concat(left: AST.Expr, right: AST.Expr): String {
        var lptr: String = this.gen_string_ptr(left)
        var rptr: String = this.gen_string_ptr(right)
        // Get lengths
        var llen: String = this.fresh_local()
        this.emit_indent(llen + " = call i64 @strlen(i8* " + lptr + ")")
        var rlen: String = this.fresh_local()
        this.emit_indent(rlen + " = call i64 @strlen(i8* " + rptr + ")")
        // Total = llen + rlen + 1
        var total: String = this.fresh_local()
        this.emit_indent(total + " = add i64 " + llen + ", " + rlen)
        var total1: String = this.fresh_local()
        this.emit_indent(total1 + " = add i64 " + total + ", 1")
        // Malloc
        var buf: String = this.fresh_local()
        this.emit_indent(buf + " = call i8* @__sf_malloc(" + this.malloc_size_type() + " " + this.malloc_size_arg(total1) + ")")
        // strcpy + strcat
        this.emit_indent("call i8* @strcpy(i8* " + buf + ", i8* " + lptr + ")")
        this.emit_indent("call i8* @strcat(i8* " + buf + ", i8* " + rptr + ")")
        // Intern the result for O(1) equality
        var raw_result: String = this.ptr_to_val(buf)
        var result: String = this.fresh_local()
        this.emit_indent(result + " = call i64 @__string_intern(i64 " + raw_result + ")")
        return result
    }

    fun gen_unary(op: String, right: AST.Expr): String {
        var right_type: String = this.get_expr_type(right)
        var rhs: String = this.gen_arg_value(right)

        if (op == "-") {
            if (right_type == "Float") {
                // Float negation: untag as double, fsub from 0.0, retag
                var raw_f: String = this.emit_untag_float(rhs)
                var negated: String = this.fresh_local()
                this.emit_indent(negated + " = fsub double 0.0, " + raw_f)
                var local: String = this.emit_tag_float(negated)
                this.last_type = AST.Type.FloatType
                return local
            }
            // NaN-boxed integer negation: untag → negate → retag
            var raw: String = this.emit_untag_int(rhs)
            var negated: String = this.fresh_local()
            this.emit_indent(negated + " = sub i64 0, " + raw)
            var local: String = this.emit_tag_int(negated)
            this.last_type = AST.Type.IntType
            return local
        }
        if (op == "!") {
            // Logical not: untag bool, flip, retag as bool
            var raw: String = this.emit_untag_bool(rhs)
            var flipped: String = this.fresh_local()
            this.emit_indent(flipped + " = xor i64 " + raw + ", 1")
            var local: String = this.emit_tag_bool(flipped)
            this.last_type = AST.Type.BoolType
            return local
        }
        if (op == "~") {
            // Bitwise not: untag int, flip all bits, retag
            var raw: String = this.emit_untag_int(rhs)
            var flipped: String = this.fresh_local()
            this.emit_indent(flipped + " = xor i64 " + raw + ", -1")
            var local: String = this.emit_tag_int(flipped)
            this.last_type = AST.Type.IntType
            return local
        }

        return rhs
    }

    // A callee is variadic when its last registered parameter name carries the
    // `*` marker (BUGS varargs). func_param_names holds the marked names.
    fun is_variadic_callee(name: String): Bool {
        if (!this.func_param_names.has(name)) { return false }
        var pn: List<String> = this.func_param_names.get(name)
        if (pn.length() == 0) { return false }
        var last: String = pn[pn.length() - 1]
        return last.starts_with("*")
    }

    fun gen_call(callee: AST.Expr, args: List<AST.Expr>): String {
        var callee_name: String = this.resolve_callee(callee)

        // Check if this is an enum constructor
        if (callee_name.contains(".")) {
            var parts: List<String> = callee_name.split(".")
            if (parts.length() >= 2) {
                var key: String = parts[0] + "." + parts[1]
                if (this.enum_variant_tags.has(key)) {
                    return this.gen_enum_construct(parts[0], parts[1], args)
                }
            }
            // Module-qualified enum: AST.Stmt.FunDecl → try Stmt.FunDecl
            if (parts.length() >= 3) {
                var key2: String = parts[1] + "." + parts[2]
                if (this.enum_variant_tags.has(key2)) {
                    return this.gen_enum_construct(parts[1], parts[2], args)
                }
            }
        }

        // Task.spawn(fn) — call the coroutine function to get a handle, enqueue it
        if (callee_name == "Task.spawn") {
            var spawn_arg: String = this.gen_arg_value(args[0])
            var hdl: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_inttoptr(hdl, spawn_arg))
            } else {
                this.emit_indent(hdl + " = inttoptr i64 " + spawn_arg + " to ptr")
                this.verify_inttoptr(hdl, spawn_arg)
            }
            var task_hdl: String = this.fresh_local()
            this.emit_indent(task_hdl + " = call ptr " + hdl + "()")
            var task_i64: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_ptrtoint(task_i64, task_hdl))
            } else {
                this.emit_indent(task_i64 + " = ptrtoint ptr " + task_hdl + " to i64")
                this.verify_ptrtoint(task_i64, task_hdl)
            }
            this.emit_indent("call i64 @enqueue(i64 " + task_i64 + ")")
            this.called_functions.push("enqueue")
            this.last_type = AST.Type.IntType
            return task_i64
        }

        // Check if it's a method call on a class instance: obj.method(args)
        if (callee_name.contains(".") and !callee_name.starts_with("IO")) {
            var parts: List<String> = callee_name.split(".")
            if (parts.length() >= 2) {
                var obj_name: String = parts[0]
                var method_name: String = parts[1]
                // Check if any class has this method
                var class_name: String = this.find_class_for_method(method_name)
                if (class_name.length() > 0) {
                    var obj_val: String = this.fresh_local()
                    this.emit_indent(obj_val + " = load i64, i64* %" + this.sanitize_name(obj_name))
                    var arg_strs: List<String> = []
                    arg_strs.push("i64 " + obj_val)
                    var ai: Float = 0
                    while (ai < args.length()) {
                        var val: String = this.gen_arg_value(args[ai])
                        arg_strs.push("i64 " + val)
                        ai = ai + 1
                    }
                    var full_method: String = class_name + "__" + method_name
                    if (this.func_prefix_map.has(full_method)) {
                        full_method = this.func_prefix_map.get(full_method)
                    } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions,this.current_prefix + full_method)) {
                        full_method = this.current_prefix + full_method
                    }
                    this.called_functions.push(full_method)
                    var local: String = this.fresh_local()
                    this.emit_indent(local + " = call i64 @" + full_method + "(" + arg_strs.join(", ") + ")")
                    if (this.func_ret_types.has(full_method)) {
                        this.last_type = this.func_ret_types.get(full_method)
                    } else {
                        this.last_type = AST.Type.IntType
                    }
                    return local
                }
            }
        }

        if (callee_name == "IO.println") {
            var arg: String = this.gen_arg_value(args[0])
            var arg_type: String = this.type_to_string(this.last_type)
            if (this.identity_mode and arg_type == "String") {
                // Identity mode: strings are raw pointers, use __io_println_str directly
                this.emit_indent("call void @__io_println_str(i64 " + arg + ")")
            } else {
                // Runtime dispatch: pass tagged value directly to __io_println_any
                this.emit_indent("call void @__io_println_any(i64 " + arg + ")")
            }
            this.last_type = AST.Type.NilType
            var nil_val: String = this.fresh_local()
            this.emit_indent(nil_val + " = call i64 @__val_nil()")
            return nil_val
        }
        if (callee_name == "IO.print") {
            var arg: String = this.gen_arg_value(args[0])
            var arg_type: String = this.type_to_string(this.last_type)
            if (this.identity_mode and arg_type == "String") {
                // Identity mode: strings are raw pointers, use __io_print_str directly
                this.emit_indent("call void @__io_print_str(i64 " + arg + ")")
            } else {
                // Runtime dispatch: __io_print_any handles all NaN-boxed types
                this.emit_indent("call void @__io_print_any(i64 " + arg + ")")
            }
            this.last_type = AST.Type.NilType
            var nil_val: String = this.fresh_local()
            this.emit_indent(nil_val + " = call i64 @__val_nil()")
            return nil_val
        }

        // Task.spawn(fn) — call the coroutine function to get a handle, enqueue it
        if (callee_name == "Task.spawn") {
            // The argument is a lambda or function reference that is a coroutine
            var spawn_arg: String = this.gen_arg_value(args[0])
            // The lambda was compiled as a coroutine returning ptr.
            // Call it to get the handle, then enqueue to scheduler.
            // For now: the lambda is an indirect call via function pointer.
            // The spawned function returns a ptr handle immediately (at first suspend).
            var hdl: String = this.fresh_local()
            this.emit_indent(hdl + " = inttoptr i64 " + spawn_arg + " to ptr")
            var task_hdl: String = this.fresh_local()
            this.emit_indent(task_hdl + " = call ptr " + hdl + "()")
            // Enqueue to scheduler (convert ptr to i64 for scheduler's List<Int>)
            var task_i64: String = this.fresh_local()
            this.emit_indent(task_i64 + " = ptrtoint ptr " + task_hdl + " to i64")
            this.emit_indent("call i64 @enqueue(i64 " + task_i64 + ")")
            this.called_functions.push("enqueue")
            this.last_type = AST.Type.IntType
            return task_i64
        }

        // Check if it's a known direct function or an indirect call through a variable
        // Check for same-name enum variant: Token(kind, line, col) where enum Token { Token(...) }
        if (this.enum_defs.has(callee_name)) {
            var variants: List = this.enum_defs.get(callee_name)
            if (variants.contains(callee_name)) {
                return this.gen_enum_construct(callee_name, callee_name, args)
            }
        }

        var resolved_callee: String = callee_name
        // Named imports take highest priority: explicit user directive
        if (this.named_imports.has(callee_name)) {
            var ni_target: String = this.named_imports.get(callee_name)
            if (this.str_in_list(this.known_functions,ni_target)) {
                resolved_callee = ni_target
            } else {
                // Trust the named import even if target not yet in known_functions
                resolved_callee = ni_target
            }
        } else if (this.current_prefix.length() > 0) {
            if (this.str_in_list(this.known_functions,this.current_prefix + callee_name)) {
                resolved_callee = this.current_prefix + callee_name
            }
        }
        // BUGS #175: a call to a nested fun of the enclosing scope resolves to its
        // per-scope symbol (scope$$callee). Keyed on nested_scope (the top-level
        // ancestor, correct even inside a sibling nested fun) and on the qualified
        // symbol actually existing in known_functions — so it only ever redirects a
        // genuine nested call and leaves everything else alone.
        if (this.nested_scope.length() > 0) {
            var __nfc: String = this.nested_fun_symbol(this.nested_scope, callee_name)
            if (this.str_in_list(this.known_functions, __nfc)) {
                resolved_callee = __nfc
            }
        }
        // Resolve module-qualified names (e.g. "Async.gather" → "stdlib_async_gather")
        // before intrinsic/extern/coroutine checks
        if (resolved_callee.contains(".")) {
            // Package namespace: check named_imports for dotted key first
            if (this.named_imports.has(resolved_callee)) {
                resolved_callee = this.named_imports.get(resolved_callee)
            } else {
                var dot_parts: List<String> = resolved_callee.split(".")
                if (dot_parts.length() >= 2 and this.has_module_alias(dot_parts[0])) {
                    resolved_callee = this.module_alias_prefix(dot_parts[0]) + dot_parts[1]
                } else if (this.func_prefix_map.has(resolved_callee)) {
                    resolved_callee = this.func_prefix_map.get(resolved_callee)
                }
            }
        }
        // Overload resolution: an overloaded callee resolves to one of its
        // mangled per-definition symbols by matching arity, then (for arity > 0)
        // the normalized static type of the first argument against each
        // candidate's first declared parameter type. Runs before every downstream
        // consumer of resolved_callee (intrinsic/extern/coroutine checks, the
        // arity guard, the direct-call emit) so they all see the concrete symbol.
        // Inert unless resolved_callee names an overload set of 2+ definitions.
        if (this.is_overloaded(resolved_callee)) {
            resolved_callee = this.resolve_overload(resolved_callee, args)
        }
        if (this.str_in_list(this.intrinsic_funcs,resolved_callee)) {
            return this.gen_intrinsic_call(resolved_callee, args)
        }
        if (this.extern_sigs.has(resolved_callee)) {
            return this.gen_extern_call(resolved_callee, args)
        }

        // Coroutine-calls-coroutine: emit await forwarding pattern
        if (this.is_coroutine) {
            var is_coro_callee: Bool = this.str_in_list(this.coroutine_funcs,resolved_callee)
            if (!is_coro_callee and this.str_in_list(this.coroutine_funcs,this.current_prefix + resolved_callee)) {
                is_coro_callee = true
                resolved_callee = this.current_prefix + resolved_callee
            }
            if (is_coro_callee) {
                this.called_functions.push(resolved_callee)
                // Generate arguments
                var coro_arg_strs: List<String> = []
                var cai: Float = 0
                while (cai < args.length()) {
                    var val: String = this.gen_arg_value(args[cai])
                    coro_arg_strs.push("i64 " + val)
                    cai = cai + 1
                }
                // Call the coroutine — returns a handle (ptr)
                var b_hdl: String = this.fresh_local()
                this.emit_indent(b_hdl + " = call ptr @" + resolved_callee + "(" + coro_arg_strs.join(", ") + ")")

                // Await loop: resume child until done, yielding ourselves each iteration
                var await_loop: String = this.fresh_label("await.loop")
                var await_yield: String = this.fresh_label("await.yield")
                var await_cleanup: String = this.fresh_label("await.cleanup")
                var await_done: String = this.fresh_label("await.done")

                // Await pattern using opaque calls (defeats CoroElide):
                // check done → yield → resume child → loop
                // Use __sched_coro_* functions (opaque to LLVM) instead of intrinsics
                var b_hdl_i64: String = this.fresh_local()
                this.emit_indent(b_hdl_i64 + " = ptrtoint ptr " + b_hdl + " to i64")
                var await_check: String = this.fresh_label("await.check")
                this.emit_terminator("br label %" + await_check)

                this.start_block(await_check)
                var b_done: String = this.fresh_local()
                this.emit_indent(b_done + " = call i64 @__sched_coro_done(i64 " + b_hdl_i64 + ")")
                var b_done_cmp: String = this.fresh_local()
                this.emit_indent(b_done_cmp + " = icmp eq i64 " + b_done + ", 1")
                this.emit_terminator("br i1 " + b_done_cmp + ", label %" + await_done + ", label %" + await_yield)

                this.start_block(await_yield)
                var save_tok: String = this.fresh_local()
                this.emit_indent(save_tok + " = call token @llvm.coro.save(ptr %__coro_hdl)")
                var susp_result: String = this.fresh_local()
                this.emit_indent(susp_result + " = call i8 @llvm.coro.suspend(token " + save_tok + ", i1 false)")
                this.emit_terminator("switch i8 " + susp_result + ", label %__coro_suspend [i8 0, label %" + await_loop + " i8 1, label %" + await_cleanup + "]")

                this.start_block(await_cleanup)
                this.emit_terminator("br label %__coro_cleanup")

                this.start_block(await_loop)
                this.emit_indent("call void @__sched_coro_resume(i64 " + b_hdl_i64 + ")")
                this.emit_terminator("br label %" + await_check)

                this.start_block(await_done)
                // Read the child coroutine's return value from @__task_result
                var coro_result: String = this.fresh_local()
                this.emit_indent(coro_result + " = load i64, i64* @__task_result")
                // Use the callee's return type
                if (this.func_ret_types.has(resolved_callee)) {
                    this.last_type = this.func_ret_types.get(resolved_callee)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return coro_result
            }
        }

        // Sync-calls-coro: non-coroutine calling a coroutine directly — drive to completion
        if (!this.is_coroutine) {
            var is_sync_coro_callee: Bool = this.str_in_list(this.coroutine_funcs,resolved_callee)
            if (!is_sync_coro_callee and this.str_in_list(this.coroutine_funcs,this.current_prefix + resolved_callee)) {
                is_sync_coro_callee = true
                resolved_callee = this.current_prefix + resolved_callee
            }
            if (is_sync_coro_callee) {
                this.called_functions.push(resolved_callee)
                var sync_arg_strs: List<String> = []
                var sai: Float = 0
                while (sai < args.length()) {
                    var val: String = this.gen_arg_value(args[sai])
                    sync_arg_strs.push("i64 " + val)
                    sai = sai + 1
                }
                var s_hdl: String = this.fresh_local()
                this.emit_indent(s_hdl + " = call ptr @" + resolved_callee + "(" + sync_arg_strs.join(", ") + ")")
                var s_i64: String = this.fresh_local()
                this.emit_indent(s_i64 + " = ptrtoint ptr " + s_hdl + " to i64")
                var sc: String = this.fresh_label("sync.check")
                var sl: String = this.fresh_label("sync.loop")
                var sd: String = this.fresh_label("sync.done")
                this.emit_terminator("br label %" + sc)
                this.start_block(sc)
                var s_done: String = this.fresh_local()
                this.emit_indent(s_done + " = call i64 @__sched_coro_done(i64 " + s_i64 + ")")
                var s_cmp: String = this.fresh_local()
                this.emit_indent(s_cmp + " = icmp eq i64 " + s_done + ", 1")
                this.emit_terminator("br i1 " + s_cmp + ", label %" + sd + ", label %" + sl)
                this.start_block(sl)
                this.emit_indent("call void @__sched_coro_resume(i64 " + s_i64 + ")")
                this.emit_terminator("br label %" + sc)
                this.start_block(sd)
                var s_result: String = this.fresh_local()
                this.emit_indent(s_result + " = load i64, i64* @__task_result")
                if (this.func_ret_types.has(resolved_callee)) {
                    this.last_type = this.func_ret_types.get(resolved_callee)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return s_result
            }
        }

        // Error check: argument count validation (skip if named args present)
        var has_named_check: Bool = false
        var nac: Float = 0
        while (nac < args.length()) {
            if (this.classify_expr(args[nac]) == "assign") { has_named_check = true }
            nac = nac + 1
        }
        if (!has_named_check) {
            var has_real_defs: Bool = false
            if (this.func_defaults.has(resolved_callee)) {
                var __defs: List<AST.Expr> = this.func_defaults.get(resolved_callee)
                var __di: Float = 0
                while (__di < __defs.length()) {
                    if (this.classify_expr(__defs[__di]) != "nil") { has_real_defs = true }
                    __di = __di + 1
                }
            }
            // Only error on arity for functions defined in same compilation unit
            // (not imported via named imports), to avoid false positives from pipe |>
            var is_named_import: Bool = this.named_imports.has(callee_name)
            if (!is_named_import) {
                // The arity comes from one of two maps, and only ONE of them is a
                // trustworthy record of a *declared* arity.
                //
                //   func_param_count is written only where a declaration is
                //   processed -- gen_fun_decl (both the plain and @inline arms),
                //   gen_class_method, prescan_fun_decl, prescan_class_decl. A 0
                //   there therefore means "this function is declared to take no
                //   arguments", which is a real arity and must be checked.
                //
                //   called_function_arity is overloaded. Declarations write it for
                //   class methods and inheritance forwarders, where the value is
                //   always >= 1 because of the implicit `self`; but CALL SITES
                //   also write args.length() into it (gen_method_call, the package
                //   re-export arms) purely to size the `declare i64 @f(...)` lines
                //   emit_module writes for undefined callees. A 0 in that map thus
                //   cannot have come from a declaration -- it is a 0-argument call
                //   site's leftover, or the key is simply absent.
                //
                // So `expected > 0` is a legitimate "we never recorded a real
                // arity" guard for called_function_arity and pure damage for
                // func_param_count. It used to be applied to both, which exempted
                // every genuinely 0-arity function from arity checking altogether:
                // `fun c() {}` then `c("too", "many")` compiled clean (BUGS #113).
                // Consult the declaration-derived map first; where a key lives in
                // both they agree, so the order only decides who answers.
                //
                // Measured, not assumed: a variant that drops `expected > 0` from
                // BOTH arms and keeps the original order was built and run over the
                // compiler's own source, the stdlib and the whole test corpus (285
                // files). It produced byte-identical diagnostics to this version --
                // no unrecorded-arity case is reachable today, so the exemption
                // below is currently dead weight. It is kept because the call-site
                // writers make 0 unfalsifiable in that map: the moment a
                // gen_method_call path starts feeding this check, `expected > 0`
                // is the only thing standing between a 0-arg call-site leftover
                // and a fabricated "expects 0 arguments" on a function that takes
                // three. Do NOT "simplify" it away without re-running that
                // comparison.
                if (this.func_param_count.has(resolved_callee)) {
                    var expected: Float = this.func_param_count.get(resolved_callee)
                    // A variadic callee (last param `*nums`) accepts >= the fixed
                    // count (expected - 1), including zero trailing args.
                    if (this.is_variadic_callee(resolved_callee)) {
                        var fixed: Float = expected - 1
                        if (args.length() < fixed and !has_real_defs) {
                            this.codegen_error("'" + callee_name + "' expects at least " + fixed.floor().to_string() + " arguments, got " + args.length().floor().to_string())
                        }
                    } else if (args.length() != expected and !has_real_defs) {
                        this.codegen_error("'" + callee_name + "' expects " + expected.floor().to_string() + " arguments, got " + args.length().floor().to_string())
                    }
                } else if (this.called_function_arity.has(resolved_callee)) {
                    var expected: Float = this.called_function_arity.get(resolved_callee)
                    if (args.length() != expected and expected > 0 and !has_real_defs) {
                        this.codegen_error("'" + callee_name + "' expects " + expected.floor().to_string() + " arguments, got " + args.length().floor().to_string())
                    }
                }
            }
        }

        if (this.str_in_list(this.known_functions,resolved_callee) and !this.typed_vars.has(callee_name)) {
            // Direct call to known function (only when callee is NOT a local variable/param)
            var call_target: String = resolved_callee
            // Redirect `main()` to the entry point's emitted name, but ONLY when the
            // callee actually resolved to the unprefixed `main`. Testing callee_name
            // meant a call that resolved to some OTHER module's `main` (e.g.
            // turmeric_prelude_main, the <main> element builder) was rewritten to
            // __saffron_main as well, so the call landed on the wrong function --
            // with the wrong arity, and no diagnostic.
            if (resolved_callee == "main" and this.str_in_list(this.defined_funcs,"__saffron_main")) {
                call_target = "__saffron_main"
            }
            this.called_functions.push(resolved_callee)

            // Check if this is a class constructor call with args
            // Pattern: ClassName(args) → call @ClassName() + call @ClassName__init(instance, args)
            var is_constructor: Bool = false
            // Extract the simple class name from module-qualified callee (e.g. "Func.BasicBlock" → "BasicBlock")
            var simple_callee: String = callee_name
            if (callee_name.contains(".")) {
                var sc_parts: List<String> = callee_name.split(".")
                simple_callee = sc_parts[sc_parts.length() - 1]
            }
            if (this.func_ret_types.has(resolved_callee)) {
                var ret_type_node: AST.Type = this.func_ret_types.get(resolved_callee)
                var ret_type_val: String = this.type_to_string(ret_type_node)
                if (ret_type_val == callee_name or ret_type_val == simple_callee) {
                    is_constructor = true
                }
                if (!is_constructor and ret_type_val == resolved_callee) {
                    if (this.class_fields.has(callee_name) or this.class_fields.has(simple_callee)) {
                        is_constructor = true
                    }
                }
            }

            if (is_constructor) {
                // Constructor: allocate instance, then call init
                var instance: String = this.fresh_local()
                this.emit_indent(instance + " = call i64 @" + resolved_callee + "()")
                // Call init for user-defined classes (not runtime builtins)
                var init_name: String = resolved_callee + "__init"
                if (!this.str_in_list(this.known_functions,init_name)) {
                    init_name = callee_name + "__init"
                }
                // Resolve via func_prefix_map (class methods are emitted with module prefix)
                if (this.func_prefix_map.has(init_name)) {
                    init_name = this.func_prefix_map.get(init_name)
                } else if (this.current_prefix.length() > 0 and this.str_in_list(this.known_functions,this.current_prefix + init_name)) {
                    init_name = this.current_prefix + init_name
                }
                if (this.str_in_list(this.known_functions,init_name)) {
                    var init_args: List<String> = []
                    init_args.push("i64 " + instance)
                    // BUGS #162: `instance` is live across every argument, and an
                    // argument may allocate. Root it (and each argument temp) for
                    // the width of the window, not just the arguments.
                    var ctor_roots: Float = this.gen_root_arg_temp(instance)
                    var i: Float = 0
                    while (i < args.length()) {
                        var val: String = this.gen_arg_value(args[i])
                        ctor_roots = ctor_roots + this.gen_root_arg_temp(val)
                        init_args.push("i64 " + val)
                        i = i + 1
                    }
                    this.called_functions.push(init_name)
                    var discard_init: String = this.fresh_local()
                    this.emit_indent(discard_init + " = call i64 @" + init_name + "(" + init_args.join(", ") + ")")
                    this.gen_pop_arg_roots(ctor_roots)
                }
                // BUGS #161: type the result by the RESOLVED (module-prefixed)
                // class, not the bare simple_callee. The instance was allocated
                // via @resolved_callee (ta_Marker), so its type is ta_Marker. An
                // inferred `var m = TargetA.Marker(x)` records this as m's type;
                // recording the bare `Marker` lost the module identity and let
                // m.describe() dispatch to whichever module registered Marker
                // last. resolved_callee already went through the alias resolution
                // above, so it carries the right prefix; only fall back to the
                // bare name when the resolved symbol names no known class (a
                // builtin constructor, or an unprefixed entry-module class).
                if (this.class_fields.has(resolved_callee)) {
                    this.last_type = this.str_to_type(resolved_callee)
                } else {
                    this.last_type = this.str_to_type(simple_callee)
                }
                return instance
            }

            var arg_strs: List<String> = []
            // If this is a nested function with captures, prepend capture POINTERS as args
            if (this.called_function_arity.has("__captures_" + resolved_callee)) {
                var caps_str: String = this.func_prefix_map.get("__caps_" + resolved_callee)
                if (caps_str.length() > 0) {
                    var cap_names: List<String> = caps_str.split(",")
                    var ci3: Float = 0
                    while (ci3 < cap_names.length()) {
                        var cap_val: String = this.typed_ptr_to_val("%" + this.sanitize_name(cap_names[ci3]), "i64*")
                        arg_strs.push("i64 " + cap_val)
                        ci3 = ci3 + 1
                    }
                }
            }
            // Named argument reordering: if any arg is an Assign node (named arg),
            // reorder args to match parameter order instead of source order
            var reordered_args: List<AST.Expr> = args
            var has_named_args: Bool = false
            var trailing_closure_applied: Bool = false
            // Trailing closure: if last arg is a lambda and fewer args than params,
            // place it at the last param position (Kotlin-style trailing closure)
            if (this.func_param_names.has(resolved_callee) and args.length() > 0) {
                var tc_pnames: List<String> = this.func_param_names.get(resolved_callee)
                var tc_last: AST.Expr = args[args.length() - 1]
                if (this.classify_expr(tc_last) == "lambda" and args.length() < tc_pnames.length()) {
                    // Separate non-trailing args from the trailing closure
                    var tc_args: List<AST.Expr> = []
                    var tc_i: Float = 0
                    while (tc_i < args.length() - 1) {
                        tc_args.push(args[tc_i])
                        tc_i = tc_i + 1
                    }
                    // Check if non-trailing args have named args
                    var tc_has_named: Bool = false
                    var tc_ni: Float = 0
                    while (tc_ni < tc_args.length()) {
                        if (this.classify_expr(tc_args[tc_ni]) == "assign") {
                            tc_has_named = true
                        }
                        tc_ni = tc_ni + 1
                    }
                    // Build reordered args: handle named args among non-trailing args
                    var tc_new: List<AST.Expr> = []
                    if (tc_has_named) {
                        // Named arg reordering for params before the last one
                        var positional_idx: Float = 0
                        var pi: Float = 0
                        while (pi < tc_pnames.length() - 1) {
                            var pname: String = tc_pnames[pi]
                            var found: Bool = false
                            var si: Float = 0
                            while (si < tc_args.length()) {
                                if (this.classify_expr(tc_args[si]) == "assign") {
                                    var arg_name: String = match (tc_args[si]) { Assign(n, v, __as) => n
                                        _ => ""
                                    }
                                    if (arg_name == pname) {
                                        var arg_value: AST.Expr = match (tc_args[si]) { Assign(n, v, __as) => v
                                            _ => AST.Expr.NilLit
                                        }
                                        tc_new.push(arg_value)
                                        found = true
                                    }
                                }
                                si = si + 1
                            }
                            if (!found) {
                                var used_pos: Bool = false
                                while (positional_idx < tc_args.length() and !used_pos) {
                                    if (this.classify_expr(tc_args[positional_idx]) != "assign") {
                                        tc_new.push(tc_args[positional_idx])
                                        positional_idx = positional_idx + 1
                                        used_pos = true
                                    } else {
                                        positional_idx = positional_idx + 1
                                    }
                                }
                                if (!used_pos) {
                                    tc_new.push(AST.Expr.NilLit)
                                }
                            }
                            pi = pi + 1
                        }
                    } else {
                        // No named args, just copy positional args and fill gaps
                        tc_i = 0
                        while (tc_i < tc_args.length()) {
                            tc_new.push(tc_args[tc_i])
                            tc_i = tc_i + 1
                        }
                        while (tc_new.length() < tc_pnames.length() - 1) {
                            tc_new.push(AST.Expr.NilLit)
                        }
                    }
                    // Place trailing closure at the end
                    tc_new.push(tc_last)
                    reordered_args = tc_new
                    has_named_args = true
                    trailing_closure_applied = true
                }
            }
            var nai: Float = 0
            while (nai < args.length()) {
                if (this.classify_expr(args[nai]) == "assign") {
                    has_named_args = true
                }
                nai = nai + 1
            }
            if (has_named_args and this.func_param_names.has(resolved_callee) and !trailing_closure_applied) {
                var param_names: List<String> = this.func_param_names.get(resolved_callee)
                var new_args: List<AST.Expr> = []
                var positional_idx: Float = 0
                var pi: Float = 0
                while (pi < param_names.length()) {
                    var pname: String = param_names[pi]
                    // Search for a named arg matching this param
                    var found: Bool = false
                    var si: Float = 0
                    while (si < args.length()) {
                        if (this.classify_expr(args[si]) == "assign") {
                            var arg_name: String = match (args[si]) { Assign(n, v, __as) => n
                                _ => ""
                            }
                            if (arg_name == pname) {
                                var arg_value: AST.Expr = match (args[si]) { Assign(n, v, __as) => v
                                    _ => AST.Expr.NilLit
                                }
                                new_args.push(arg_value)
                                found = true
                            }
                        }
                        si = si + 1
                    }
                    if (!found) {
                        // Use positional arg (skip over named args in positional counting)
                        var used_positional: Bool = false
                        while (positional_idx < args.length() and !used_positional) {
                            if (this.classify_expr(args[positional_idx]) != "assign") {
                                new_args.push(args[positional_idx])
                                positional_idx = positional_idx + 1
                                used_positional = true
                            } else {
                                positional_idx = positional_idx + 1
                            }
                        }
                        if (!used_positional) {
                            // No positional arg available — use default (will be filled below)
                            // Push a nil placeholder to signal "use default"
                            new_args.push(AST.Expr.NilLit)
                        }
                    }
                    pi = pi + 1
                }
                reordered_args = new_args
            }
            // BUGS #162: each evaluated argument is rooted by value until the call
            // consumes it, because a later argument may allocate and collect. Only
            // meaningful for two-or-more arguments — a single argument is handed
            // straight to the callee's prologue, which gives it an alloca and a root
            // — but rooting unconditionally keeps the accounting local to this loop.
            var arg_roots: Float = 0
            var i: Float = 0
            if (this.is_variadic_callee(resolved_callee)) {
                // Variadic callee (BUGS varargs): emit the `fixed` leading args
                // normally, then collect every trailing arg into one List built
                // with __list_new / __list_push and pass it as the final param.
                // `sum()` with no trailing args yields an empty list, not a nil.
                var vfixed: Float = this.func_param_count.get(resolved_callee) - 1
                var vi: Float = 0
                while (vi < vfixed and vi < reordered_args.length()) {
                    var fval: String = this.gen_arg_value(reordered_args[vi])
                    arg_strs.push("i64 " + fval)
                    arg_roots = arg_roots + this.gen_root_arg_temp(fval)
                    vi = vi + 1
                }
                var vlist: String = this.fresh_local()
                this.emit_indent(vlist + " = call i64 @__list_new()")
                var vlist_roots: Float = this.gen_root_arg_temp(vlist)
                while (vi < reordered_args.length()) {
                    var eval: String = this.gen_arg_value(reordered_args[vi])
                    var epush_root: Float = this.gen_root_arg_temp(eval)
                    var vpush: String = this.fresh_local()
                    this.emit_indent(vpush + " = call i64 @__list_push(i64 " + vlist + ", i64 " + eval + ")")
                    this.gen_pop_arg_roots(epush_root)
                    vi = vi + 1
                }
                arg_strs.push("i64 " + vlist)
                arg_roots = arg_roots + vlist_roots
                var vlocal: String = this.fresh_local()
                if (this.use_llvm_lib) {
                    this.emit_indent(this.lib_call(vlocal, "i64", call_target, arg_strs.join(", ")))
                } else {
                    this.emit_indent(vlocal + " = call i64 @" + call_target + "(" + arg_strs.join(", ") + ")")
                    this.verify_call(vlocal, "i64", call_target, arg_strs.join(", "))
                }
                this.gen_pop_arg_roots(arg_roots)
                if (this.func_ret_types.has(resolved_callee)) {
                    this.last_type = this.func_ret_types.get(resolved_callee)
                    this.apply_ret_type_param_resolution(resolved_callee, args)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return vlocal
            }
            while (i < reordered_args.length()) {
                // Skip nil placeholders that signal "use default"
                var used_default: Bool = false
                if (has_named_args and this.classify_expr(reordered_args[i]) == "nil" and this.func_defaults.has(resolved_callee)) {
                    var defs: List<AST.Expr> = this.func_defaults.get(resolved_callee)
                    if (i < defs.length() and this.classify_expr(defs[i]) != "nil") {
                        var def_val: String = this.gen_arg_value(defs[i])
                        arg_strs.push("i64 " + def_val)
                        arg_roots = arg_roots + this.gen_root_arg_temp(def_val)
                        used_default = true
                    }
                }
                if (!used_default) {
                    var val: String = this.gen_arg_value(reordered_args[i])
                    arg_strs.push("i64 " + val)
                    arg_roots = arg_roots + this.gen_root_arg_temp(val)
                }
                i = i + 1
            }
            // Fill missing args with default values
            if (this.func_defaults.has(resolved_callee)) {
                var defaults: List<AST.Expr> = this.func_defaults.get(resolved_callee)
                var param_count: Float = defaults.length()
                if (this.func_param_names.has(resolved_callee)) {
                    var pc2: Float = this.func_param_names.get(resolved_callee).length()
                    if (pc2 > param_count) { param_count = pc2 }
                }
                while (i < param_count) {
                    if (i < defaults.length()) {
                        var def_expr: AST.Expr = defaults[i]
                        var is_nil: Bool = this.classify_expr(def_expr) == "nil"
                        if (!is_nil) {
                            var def_val: String = this.gen_arg_value(def_expr)
                            arg_strs.push("i64 " + def_val)
                            arg_roots = arg_roots + this.gen_root_arg_temp(def_val)
                        } else {
                            var __nil_fill: String = this.fresh_local()
                            this.emit_indent(__nil_fill + " = call i64 @__val_nil()")
                            arg_strs.push("i64 " + __nil_fill)
                        }
                    } else {
                        var __nil_fill: String = this.fresh_local()
                        this.emit_indent(__nil_fill + " = call i64 @__val_nil()")
                        arg_strs.push("i64 " + __nil_fill)
                    }
                    i = i + 1
                }
            } else if (this.func_param_names.has(resolved_callee)) {
                var param_count: Float = this.func_param_names.get(resolved_callee).length()
                while (arg_strs.length() < param_count) {
                    var __nil_fill: String = this.fresh_local()
                    this.emit_indent(__nil_fill + " = call i64 @__val_nil()")
                    arg_strs.push("i64 " + __nil_fill)
                }
            }
            var local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(local, "i64", call_target, arg_strs.join(", ")))
            } else {
                this.emit_indent(local + " = call i64 @" + call_target + "(" + arg_strs.join(", ") + ")")
                this.verify_call(local, "i64", call_target, arg_strs.join(", "))
            }
            this.gen_pop_arg_roots(arg_roots)
            if (this.func_ret_types.has(resolved_callee)) {
                this.last_type = this.func_ret_types.get(resolved_callee)
                this.apply_ret_type_param_resolution(resolved_callee, args)
            } else if (this.func_ret_types.has(callee_name)) {
                this.last_type = this.func_ret_types.get(callee_name)
                this.apply_ret_type_param_resolution(callee_name, args)
            } else {
                this.last_type = AST.Type.IntType
            }
            return local
        }

        // Check if it looks like a direct function call (not a local variable)
        if (!this.typed_vars.has(callee_name) and callee_name.length() > 0) {
            // Runtime builtin constructors
            if (callee_name == "Map") {
                var local: String = this.fresh_local()
                this.emit_indent(local + " = call i64 @__map_new()")
                this.last_type = this.make_map_type()
                return local
            }
            var emit_callee: String = this.current_prefix + callee_name
            // Named imports take priority over all other resolution
            if (this.named_imports.has(callee_name)) {
                emit_callee = this.named_imports.get(callee_name)
            } else if (!this.str_in_list(this.known_functions,emit_callee)) {
                if (this.str_in_list(this.known_functions,callee_name)) {
                    emit_callee = callee_name
                } else if (this.func_prefix_map.has(callee_name)) {
                    emit_callee = this.func_prefix_map.get(callee_name)
                } else {
                    // BUGS #2: calling a function that no declaration defines. This
                    // used to be a WARNING and the compile continued, so the missing
                    // symbol surfaced as a cryptic `ld: symbol(s) not found` at link
                    // time — or, for a forward reference to a sibling nested `fun`,
                    // it was a FALSE warning on code that in fact linked and ran
                    // (preregister_nested_funcs now registers those before this
                    // check, so a real forward reference no longer reaches here).
                    // Everything that still reaches here is genuinely undefined and
                    // genuinely fails to link, so it is now a hard error with a span,
                    // turning the linker failure into a compile diagnostic.
                    //
                    // Suppress if it's a known class method (ClassName__method
                    // pattern): a bare method name can reach here through dispatch
                    // paths that resolve the receiver separately.
                    var is_known_method: Bool = false
                    var kfi: Float = 0
                    while (kfi < this.known_functions.length()) {
                        if (this.known_functions[kfi].ends_with("__" + callee_name)) {
                            is_known_method = true
                            kfi = this.known_functions.length()
                        }
                        kfi = kfi + 1
                    }
                    if (!is_known_method) {
                        // A builtin container has literal syntax, not a constructor
                        // call: `List("x")` / `Map(...)` never had a callable symbol,
                        // so name the real fix rather than reporting "undefined".
                        if (callee_name == "List" or callee_name == "Map" or callee_name == "Set" or callee_name == "StringBuilder") {
                            this.codegen_error("'" + callee_name + "' has no constructor call; build it with literal syntax instead (e.g. [] or {})")
                        } else {
                            this.codegen_error("call to undefined function '" + callee_name + "'")
                        }
                    }

                }
            }
            this.called_functions.push(emit_callee)
            // Named argument reordering for fallback path
            var reordered_args2: List<AST.Expr> = args
            var has_named2: Bool = false
            var tc_applied2: Bool = false
            // Trailing closure for fallback path
            if (this.func_param_names.has(emit_callee) and args.length() > 0) {
                var tc_pnames2: List<String> = this.func_param_names.get(emit_callee)
                var tc_last2: AST.Expr = args[args.length() - 1]
                if (this.classify_expr(tc_last2) == "lambda" and args.length() < tc_pnames2.length()) {
                    var tc_args2: List<AST.Expr> = []
                    var tc_i2: Float = 0
                    while (tc_i2 < args.length() - 1) {
                        tc_args2.push(args[tc_i2])
                        tc_i2 = tc_i2 + 1
                    }
                    var tc_has_named2: Bool = false
                    var tc_ni2: Float = 0
                    while (tc_ni2 < tc_args2.length()) {
                        if (this.classify_expr(tc_args2[tc_ni2]) == "assign") {
                            tc_has_named2 = true
                        }
                        tc_ni2 = tc_ni2 + 1
                    }
                    var tc_new2: List<AST.Expr> = []
                    if (tc_has_named2) {
                        var positional_idx2: Float = 0
                        var pi2: Float = 0
                        while (pi2 < tc_pnames2.length() - 1) {
                            var pname2: String = tc_pnames2[pi2]
                            var found2: Bool = false
                            var si2: Float = 0
                            while (si2 < tc_args2.length()) {
                                if (this.classify_expr(tc_args2[si2]) == "assign") {
                                    var arg_name2: String = match (tc_args2[si2]) { Assign(n, v, __as) => n
                                        _ => ""
                                    }
                                    if (arg_name2 == pname2) {
                                        var arg_value2: AST.Expr = match (tc_args2[si2]) { Assign(n, v, __as) => v
                                            _ => AST.Expr.NilLit
                                        }
                                        tc_new2.push(arg_value2)
                                        found2 = true
                                    }
                                }
                                si2 = si2 + 1
                            }
                            if (!found2) {
                                var used_pos2: Bool = false
                                while (positional_idx2 < tc_args2.length() and !used_pos2) {
                                    if (this.classify_expr(tc_args2[positional_idx2]) != "assign") {
                                        tc_new2.push(tc_args2[positional_idx2])
                                        positional_idx2 = positional_idx2 + 1
                                        used_pos2 = true
                                    } else {
                                        positional_idx2 = positional_idx2 + 1
                                    }
                                }
                                if (!used_pos2) {
                                    tc_new2.push(AST.Expr.NilLit)
                                }
                            }
                            pi2 = pi2 + 1
                        }
                    } else {
                        tc_i2 = 0
                        while (tc_i2 < tc_args2.length()) {
                            tc_new2.push(tc_args2[tc_i2])
                            tc_i2 = tc_i2 + 1
                        }
                        while (tc_new2.length() < tc_pnames2.length() - 1) {
                            tc_new2.push(AST.Expr.NilLit)
                        }
                    }
                    tc_new2.push(tc_last2)
                    reordered_args2 = tc_new2
                    has_named2 = true
                    tc_applied2 = true
                }
            }
            var nai2: Float = 0
            while (nai2 < args.length()) {
                if (this.classify_expr(args[nai2]) == "assign") {
                    has_named2 = true
                }
                nai2 = nai2 + 1
            }
            if (has_named2 and this.func_param_names.has(emit_callee) and !tc_applied2) {
                var param_names2: List<String> = this.func_param_names.get(emit_callee)
                var new_args2: List<AST.Expr> = []
                var positional_idx2: Float = 0
                var pi2: Float = 0
                while (pi2 < param_names2.length()) {
                    var pname2: String = param_names2[pi2]
                    var found2: Bool = false
                    var si2: Float = 0
                    while (si2 < args.length()) {
                        if (this.classify_expr(args[si2]) == "assign") {
                            var arg_name2: String = match (args[si2]) { Assign(n, v, __as) => n
                                _ => ""
                            }
                            if (arg_name2 == pname2) {
                                var arg_value2: AST.Expr = match (args[si2]) { Assign(n, v, __as) => v
                                    _ => AST.Expr.NilLit
                                }
                                new_args2.push(arg_value2)
                                found2 = true
                            }
                        }
                        si2 = si2 + 1
                    }
                    if (!found2) {
                        var used_pos2: Bool = false
                        while (positional_idx2 < args.length() and !used_pos2) {
                            if (this.classify_expr(args[positional_idx2]) != "assign") {
                                new_args2.push(args[positional_idx2])
                                positional_idx2 = positional_idx2 + 1
                                used_pos2 = true
                            } else {
                                positional_idx2 = positional_idx2 + 1
                            }
                        }
                        if (!used_pos2) {
                            new_args2.push(AST.Expr.NilLit)
                        }
                    }
                    pi2 = pi2 + 1
                }
                reordered_args2 = new_args2
            }
            var arg_strs: List<String> = []
            // BUGS #162, same as the reordered_args loop above.
            var arg_roots2: Float = 0
            var i: Float = 0
            while (i < reordered_args2.length()) {
                var used_default2: Bool = false
                if (has_named2 and this.classify_expr(reordered_args2[i]) == "nil" and this.func_defaults.has(emit_callee)) {
                    var defs2: List<AST.Expr> = this.func_defaults.get(emit_callee)
                    if (i < defs2.length() and this.classify_expr(defs2[i]) != "nil") {
                        var def_val2: String = this.gen_arg_value(defs2[i])
                        arg_strs.push("i64 " + def_val2)
                        arg_roots2 = arg_roots2 + this.gen_root_arg_temp(def_val2)
                        used_default2 = true
                    }
                }
                if (!used_default2) {
                    var val: String = this.gen_arg_value(reordered_args2[i])
                    arg_strs.push("i64 " + val)
                    arg_roots2 = arg_roots2 + this.gen_root_arg_temp(val)
                }
                i = i + 1
            }
            // Fill missing args with default values
            if (this.func_defaults.has(emit_callee)) {
                var defaults2: List<AST.Expr> = this.func_defaults.get(emit_callee)
                var param_count2: Float = defaults2.length()
                if (this.func_param_names.has(emit_callee)) {
                    var pc2b: Float = this.func_param_names.get(emit_callee).length()
                    if (pc2b > param_count2) { param_count2 = pc2b }
                }
                while (i < param_count2) {
                    if (i < defaults2.length()) {
                        var def_expr2: AST.Expr = defaults2[i]
                        var is_nil2: Bool = this.classify_expr(def_expr2) == "nil"
                        if (!is_nil2) {
                            var def_val2b: String = this.gen_arg_value(def_expr2)
                            arg_strs.push("i64 " + def_val2b)
                            arg_roots2 = arg_roots2 + this.gen_root_arg_temp(def_val2b)
                        } else {
                            var __nil_fill2: String = this.fresh_local()
                            this.emit_indent(__nil_fill2 + " = call i64 @__val_nil()")
                            arg_strs.push("i64 " + __nil_fill2)
                        }
                    } else {
                        var __nil_fill2: String = this.fresh_local()
                        this.emit_indent(__nil_fill2 + " = call i64 @__val_nil()")
                        arg_strs.push("i64 " + __nil_fill2)
                    }
                    i = i + 1
                }
            } else if (this.func_param_names.has(emit_callee)) {
                var param_count2: Float = this.func_param_names.get(emit_callee).length()
                while (arg_strs.length() < param_count2) {
                    var __nil_fill2: String = this.fresh_local()
                    this.emit_indent(__nil_fill2 + " = call i64 @__val_nil()")
                    arg_strs.push("i64 " + __nil_fill2)
                }
            }
            var local: String = this.fresh_local()
            if (this.use_llvm_lib) {
                this.emit_indent(this.lib_call(local, "i64", emit_callee, arg_strs.join(", ")))
            } else {
                this.emit_indent(local + " = call i64 @" + emit_callee + "(" + arg_strs.join(", ") + ")")
                this.verify_call(local, "i64", emit_callee, arg_strs.join(", "))
            }
            this.gen_pop_arg_roots(arg_roots2)
            if (this.func_ret_types.has(emit_callee)) {
                this.last_type = this.func_ret_types.get(emit_callee)
                this.apply_ret_type_param_resolution(emit_callee, args)
            } else {
                this.last_type = AST.Type.IntType
            }
            return local
        }

        // Indirect call: callee is a variable or expression holding a function pointer
        //
        // A name can be claimed by BOTH a `var` and a `fun` (`var a = 1` next to
        // `fun a() {...}`). Nothing rejects that, and the direct-call branch above
        // declines it because a binding exists, so `a()` fell through to here and
        // loaded the *variable* as a closure pair. With `var a = 1` that pair
        // pointer is the NaN-boxed integer 0x7FF9000000000001, and unpacking it
        // dereferences that address — the exact fault address observed in
        // test/functions.sf (BUGS #80).
        //
        // The recorded type settles it: an indirect call is only meaningful if the
        // binding could hold a callable. `Fun` (and an unknown/`Any` type, which
        // may be a lambda) stay indirect; anything concretely non-callable means
        // the `fun` is what the programmer named, so dispatch directly and keep the
        // value load out of it entirely.
        if (callee_name.length() > 0 and this.str_in_list(this.known_functions,resolved_callee)) {
            var cty: String = ""
            if (this.typed_vars.has(callee_name)) {
                cty = this.type_to_string(this.typed_vars.get(callee_name))
            } else if (this.global_var_types.has(this.current_prefix + callee_name)) {
                cty = this.global_var_types.get(this.current_prefix + callee_name)
            } else if (this.global_var_types.has(callee_name)) {
                cty = this.global_var_types.get(callee_name)
            }
            var callable: Bool = cty.length() == 0 or cty == "Any" or cty == "Fun" or cty.starts_with("Fun")
            if (!callable) {
                var direct: String = this.fresh_local()
                var d_args: List<String> = []
                var dai: Float = 0
                while (dai < args.length()) {
                    d_args.push("i64 " + this.gen_arg_value(args[dai]))
                    dai = dai + 1
                }
                this.called_functions.push(resolved_callee)
                this.emit_indent(direct + " = call i64 @" + resolved_callee + "(" + d_args.join(", ") + ")")
                if (this.func_ret_types.has(resolved_callee)) {
                    this.last_type = this.func_ret_types.get(resolved_callee)
                    this.apply_ret_type_param_resolution(resolved_callee, args)
                } else {
                    this.last_type = AST.Type.IntType
                }
                return direct
            }
        }
        var ptr_val: String = ""
        if (callee_name.length() == 0) {
            ptr_val = this.gen_arg_value(callee)
        } else {
            ptr_val = this.fresh_local()
            var var_ref: String = "%" + this.sanitize_name(callee_name)
            if (this.module_globals.has(this.current_prefix + callee_name)) {
                var_ref = "@__g_" + this.current_prefix + this.sanitize_name(callee_name)
            }
            this.emit_indent(ptr_val + " = load i64, i64* " + var_ref)
        }
        return this.gen_indirect_call(ptr_val, args)
    }

    fun gen_indirect_call(ptr_val: String, args: List<AST.Expr>): String {
        // ptr_val could be either:
        // 1. A plain function pointer (non-capturing lambda)
        // 2. A closure pair pointer: [fn_ptr, env_ptr]
        // We use the closure calling convention for all indirect calls:
        // Unpack [fn_ptr, env_ptr], call fn(env, args...)
        var closure_ptr: String = this.val_to_typed_ptr(ptr_val, "[2 x i64]*")

        // Load fn_ptr from slot 0
        var fn_slot: String = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        var fn_int: String = this.fresh_local()
        this.emit_indent(fn_int + " = load i64, i64* " + fn_slot)

        // Load env_ptr from slot 1
        var env_slot: String = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        var env_int: String = this.fresh_local()
        this.emit_indent(env_int + " = load i64, i64* " + env_slot)

        // Build args: env first, then user args
        var arg_strs: List<String> = []
        arg_strs.push("i64 " + env_int)
        // BUGS #162. The env pointer is rooted too: it was loaded out of the closure
        // pair before the arguments run, so it is exposed for exactly as long.
        var ind_roots: Float = this.gen_root_arg_temp(env_int)
        var i: Float = 0
        while (i < args.length()) {
            var val: String = this.gen_arg_value(args[i])
            arg_strs.push("i64 " + val)
            ind_roots = ind_roots + this.gen_root_arg_temp(val)
            i = i + 1
        }

        // Build function type: i64 (i64 env, i64 arg1, ...)
        var num_args: Float = args.length() + 1
        var type_parts: List<String> = []
        var ti: Float = 0
        while (ti < num_args) {
            type_parts.push("i64")
            ti = ti + 1
        }
        var fn_type: String = "i64 (" + type_parts.join(", ") + ")*"

        // Cast and call
        var fn_ptr: String = this.val_to_fn_ptr(fn_int, fn_type)
        var local: String = this.fresh_local()
        this.emit_indent(local + " = call i64 " + fn_ptr + "(" + arg_strs.join(", ") + ")")
        this.gen_pop_arg_roots(ind_roots)
        // LLVM lib parallel path: track indirect call result as opaque placeholder
        if (!this.identity_mode) {
            var ic_res: LLVMTypes.Value = this.llvm_block_builder.call("__indirect_call", LLVMTypes.Type.I64, [])
            this.llvm_values.set(local, ic_res)
        }
        // The result type of an indirect call is genuinely unknown: `Fun` carries
        // no return type, so there is nothing here to derive one from. Say so.
        //
        // This function used to leave `last_type` holding whatever the last
        // sub-expression happened to set — usually the type of the final
        // *argument*, or of the callee itself. Callers read that stale value as
        // if it described the result, which is how a field access on a call
        // result silently resolved to offset 0 (BUGS #56): `f(1).v` looked up
        // field `v` on a class inferred from leftover state, and get_field_index
        // answered 0 for a name it could not find. The same staleness made a
        // Float returned through a closure read as an Int and print 0 (the float
        // half of BUGS #51) — `to_string` keys off `last_type`, so it untagged a
        // double as an integer.
        //
        // AnyType is the honest answer, and is already the "unknown" spelling the
        // rest of codegen understands: it routes through the runtime dispatch
        // helpers, which inspect the actual tag instead of trusting a static
        // guess. That turns both silent wrong answers into correct behaviour for
        // to_string/arithmetic, and turns the field case into a diagnostic rather
        // than a wrong offset. (I2/M1 in docs/design/compiler-rewrite.md:
        // unknown is distinct, and codegen must not re-derive a type it lacks.)
        //
        // Annotating the binding (`var x: Box = f(1)`) remains the way to supply
        // the type; the real fix is a return type on `Fun`, a language change.
        this.last_type = AST.Type.AnyType
        return local
    }

    fun has_string_literal(left: AST.Expr, right: AST.Expr): Bool {
        return this.is_string_expr(left) or this.is_string_expr(right) or this.contains_string_lit(left) or this.contains_string_lit(right) or this.is_string_variable(left) or this.is_string_variable(right)
    }

    fun contains_string_lit(expr: AST.Expr): Bool {
        // Only these two shapes can hold a literal that reaches the concat path;
        // everything else is a runtime value. The 26 arms spelled out one per
        // variant, all returning "no", are the `_` arm — and being hand-written
        // they went stale: IndexGet, IndexSet, MethodCall and MapLit were never
        // added, so those four fell through to an indeterminate value instead of
        // false (BUGS #76).
        return match (expr) {
            StringLit(s) => true
            Binary(l, o, r) => this.contains_string_lit(l) or this.contains_string_lit(r)
            _ => false
        }
    }

    fun is_string_variable(expr: AST.Expr): Bool {
        // Same story as contains_string_lit: only a name-shaped expression can be
        // looked up in string_vars, and the 24 hand-written `=> ""` arms had
        // likewise gone stale (MapLit, IndexGet, IndexSet, MethodCall missing).
        var name: String = match (expr) {
            Variable(n, __vs) => n
            Ref(rk, rn, rs, __rs) => rn
            GetField(o, f, __gs) => f
            _ => ""
        }
        if (name.length() > 0) {
            if (this.string_vars.contains(name)) return true
            // Check class fields
            if (this.current_class.length() > 0 and this.class_fields.has(this.current_class)) {
                var fields: String = this.class_fields.get(this.current_class)
                if (fields.contains(name + ":String")) return true
            }
        }
        return false
    }

    fun get_string_lit_value(expr: AST.Expr): String {
        return match (expr) { StringLit(s) => s
            _ => ""
        }
    }

    fun is_string_expr(expr: AST.Expr): Bool {
        // True only for a compile-time-known string: a literal, or a `+` chain of
        // them. flatten_string_expr relies on exactly this: whatever answers true
        // here it must be able to fold to a constant. The 27 remaining arms each
        // named their variant and then all failed the `== "string"` test below, so
        // they were a `_ => false` written the long way — and MapLit had never
        // been added to the list, leaving it indeterminate (BUGS #76).
        return match (expr) {
            StringLit(s) => true
            Binary(l, o, r) => o == "+" and this.is_string_expr(l) and this.is_string_expr(r)
            _ => false
        }
    }

    fun get_format_ptr(fmt: String): String {
        var name: String = this.add_string_constant(fmt)
        var len: Float = fmt.length() + 1
        var local: String = this.fresh_local()
        this.emit_indent(local + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + name + ", i64 0, i64 0")
        return local
    }

    fun gen_enum_construct(enum_name: String, variant: String, args: List<AST.Expr>): String {
        var key: String = enum_name + "." + variant
        var tag: Float = this.enum_variant_tags.get(key)

        // Check if this enum uses simple encoding (no fields) or array encoding
        var max_fields: Float = this.get_max_fields(enum_name)

        if (max_fields == 0) {
            // Enum with no data fields at all. Outside identity mode this is the
            // TAG_ENUM immediate `(0x7FFB<<48)|(type_id<<32)|variant` (BUGS #154),
            // which __val_class_tag decodes to the type_id so a printed element
            // routes to <Enum>__to_string. The value stays an immediate — no
            // allocation, no GC, and bit-identical per variant, so emit_bit_eq's
            // `==` is unchanged. The full base constant 0x7FFB<<48 exceeds a
            // double's exact integer range, so emit shl/or and let LLVM fold it
            // rather than compute it in Float.
            if (args.length() == 0) {
                if (this.identity_mode or !this.enum_type_ids.has(enum_name)) {
                    // identity mode (or an unregistered enum, e.g. the >255
                    // refusal): keep the old `tag << 56` layout. Identity is
                    // untagged and self-consistent — construct and decode agree.
                    var local: String = this.fresh_local()
                    this.emit_indent(local + " = shl i64 " + tag.floor().to_string() + ", 56")
                    this.last_type = AST.Type.EnumType(enum_name); return local
                }
                var etype_id: Float = this.enum_type_ids.get(enum_name)
                var base_tag: String = this.fresh_local()
                this.emit_indent(base_tag + " = shl i64 32763, 48")
                var tid_shifted: String = this.fresh_local()
                this.emit_indent(tid_shifted + " = shl i64 " + etype_id.floor().to_string() + ", 32")
                var enc0: String = this.fresh_local()
                this.emit_indent(enc0 + " = or i64 " + base_tag + ", " + tid_shifted)
                var enc: String = this.fresh_local()
                this.emit_indent(enc + " = or i64 " + enc0 + ", " + tag.floor().to_string())
                this.last_type = AST.Type.EnumType(enum_name); return enc
            }
            // Shouldn't happen (max_fields==0 but args>0), fall through to array encoding
        }

        // Array encoding for enums with multi-field variants: [tag, f0, f1, ...]
        if (args.length() == 0) {
            // No-field variant in a multi-field enum: heap-allocate to outlive function
            var arr_ptr: String = this.emit_enum_payload_alloc(enum_name, 1)
            var tag_slot: String = this.fresh_local()
            this.emit_indent(tag_slot + " = getelementptr [1 x i64], [1 x i64]* " + arr_ptr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + tag_slot)
            var as_int: String = this.typed_ptr_to_val(arr_ptr, "[1 x i64]*")
            this.last_type = AST.Type.EnumType(enum_name); return as_int
        }

        // Multi-field: heap-allocate array [tag, field0, field1, ...]
        // Must be heap (not stack) since enum values may outlive the creating function
        var num_slots: Float = args.length() + 1

        // Evaluate the arguments FIRST, then allocate, then store.
        //
        // This order is load-bearing now that the payload carries a GC header. The
        // old order was alloc-then-evaluate, which was safe only because
        // __sf_malloc memory is never reclaimed: the array was invisible to the
        // collector, and nothing collected it either. Under __gc_alloc the same
        // shape is a dangling pointer — `arr_ptr` sits in an LLVM register while
        // gen_arg_value emits a nested allocating call (for
        // `Pair(build(d-1), build(d-1))`, an entire subtree), so a collection
        // inside an argument reclaims the array being filled. The stores then land
        // in freed memory and the value reads back truncated, or faults, at
        // whatever depth allocation first crosses the 64KB threshold — which is
        // why it presented as a nesting-depth limit rather than as a GC bug.
        //
        // What this does NOT close: __gc_alloc can itself collect (it calls
        // __gc_minor_collect, and __gc_collect on threshold), so an argument value
        // held only in a register is still exposed across that one call. That is
        // BUGS #162, it is not specific to enums, and class construction has the
        // identical window — `CPair(build(d-1), build(d-1))` evaluates its arguments
        // and then calls a constructor that allocates. So this fix deliberately
        // brings enums up to the exposure classes already have and no further,
        // rather than inventing a rooting convention for one node type; #162 is
        // where the general repair lives, and it covers this loop too.
        //
        // (Not #63, which was the *moving* nursery and closed by retiring it. And an
        // earlier version of this comment claimed the blocker was that no
        // entry-block alloca facility exists — it does, at output_body.sf:420, and
        // the non-moving collector means value rooting suffices regardless.)
        //
        // The Int->Float widening stays inline with each argument because it reads
        // `this.last_type`, which the next gen_arg_value would overwrite.
        var arg_vals: List<String> = []
        var ai: Float = 0
        while (ai < args.length()) {
            var av: String = this.gen_arg_value(args[ai])
            // Int -> Float widening at the payload store, the same fix as BUGS #28
            // applied to enum construction instead of variable declaration.
            //
            // A `Number` field stores whatever representation the argument happened
            // to have: `Some(7)` stored a TAG_INT, `Some(7.5)` a double. The
            // declared field type therefore did not describe the bits, so a binding
            // extracted by `let Some(v) = ...` was unreadable either way — typing it
            // Float made `Some(7)` print nan, and typing it Int made
            // `Circle(2.0)` arithmetic produce nan. Neither static choice can be
            // right while construction is inconsistent.
            //
            // Normalising here makes the declared type true: a Float/Number field
            // always holds a double, so get_variant_field_type's "Float" is correct
            // for every construction. Reuses the untag/tag round trip so the sitofp
            // lives in one place.
            //
            // Gated on !identity_mode for the reason given at the declaration site:
            // identity mode has no tags and Float *is* Int there.
            if (!this.identity_mode) {
                var decl_type: String = this.get_variant_field_type(enum_name, variant, ai)
                if (decl_type == "Float" and this.type_to_string(this.last_type) == "Int") {
                    var widened: String = this.emit_untag_float(av)
                    av = this.emit_tag_float(widened)
                }
            }
            arg_vals.push(av)
            ai = ai + 1
        }

        var arr_ptr: String = this.emit_enum_payload_alloc(enum_name, num_slots)
        // Store tag at index 0
        var tag_slot: String = this.fresh_local()
        this.emit_indent(tag_slot + " = getelementptr [" + num_slots.to_string() + " x i64], [" + num_slots.to_string() + " x i64]* " + arr_ptr + ", i64 0, i64 0")
        this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + tag_slot)
        // Store fields at indices 1, 2, ... — no allocation between the alloc above
        // and the last of these, which is the property the comment relies on.
        var i: Float = 0
        while (i < args.length()) {
            var field_idx: Float = i + 1
            var field_slot: String = this.fresh_local()
            this.emit_indent(field_slot + " = getelementptr [" + num_slots.to_string() + " x i64], [" + num_slots.to_string() + " x i64]* " + arr_ptr + ", i64 0, i64 " + field_idx.to_string())
            this.emit_indent("store i64 " + arg_vals[i] + ", i64* " + field_slot)
            i = i + 1
        }
        // Cast pointer to i64 for storage
        var as_int: String = this.typed_ptr_to_val(arr_ptr, "[" + num_slots.to_string() + " x i64]*")
        this.last_type = AST.Type.EnumType(enum_name); return as_int
    }

    /// Emit (once per module) `__enum_eq_<Name>`, the structural equality of a
    /// heap-encoded enum, and return its symbol. See the #116 arm in gen_binary
    /// for why the comparison is a *generated* function rather than a runtime
    /// helper: variant arity and field types live only in `enum_variant_fields`,
    /// and the `[tag, f0, ...]` array carries nothing a runtime helper could read
    /// to recover them.
    ///
    /// Shape of the emitted body: bitwise-identical fast path, a guard that both
    /// operands really are bare heap pointers, null checks, tag equality, then a
    /// switch to a per-variant arm that compares that variant's fields in order.
    /// A fieldless variant's arm is just "the tags matched", which is what makes
    /// `Option.None == Option.None` true.
    fun ensure_enum_eq(enum_name: String): String {
        var sym: String = "__enum_eq_" + this.sanitize_name(enum_name)
        if (this.str_in_list(this.defined_funcs, sym)) { return sym }
        // Registered BEFORE the body is built. A recursive enum — `enum Tree {
        // Leaf, Node(l: Tree, r: Tree) }` — reaches ensure_enum_eq for its own
        // name while emitting its payload compare, and this is what makes that
        // emit a self-call instead of expanding forever.
        this.defined_funcs.push(sym)

        var variants: List<String> = this.enum_defs.get(enum_name)

        // Emit into a scratch buffer and park the result in `globals`, the same
        // save/restore as a nested lambda (closures_body.sf). Doing it this way
        // rather than by string concatenation is what keeps the pointer and
        // untag helpers — and so wasm32's i32 pointers — working here for free.
        // The save/restore nests correctly, which matters because the recursive
        // case above re-enters this function mid-body.
        var saved_sb: StringBuilder = this.sb
        var saved_term: Bool = this.block_terminated
        var saved_counter: Float = this.local_counter
        var saved_in_fn: Bool = this.in_function
        this.sb = StringBuilder()
        this.local_counter = 0
        this.block_terminated = false
        this.in_function = true

        var linkage: String = "define linkonce_odr"
        if (this.target == "wasm" or this.target == "wasm64" or this.target == "wasm32") {
            linkage = "define"
        }

        var l_eq: String = this.fresh_label("eeq.yes")
        var l_ne: String = this.fresh_label("eeq.no")
        var l_shape: String = this.fresh_label("eeq.shape")
        var l_null: String = this.fresh_label("eeq.null")
        var l_tags: String = this.fresh_label("eeq.tags")
        var l_disp: String = this.fresh_label("eeq.disp")

        this.emit("")
        this.emit(linkage + " i64 @" + sym + "(i64 %a, i64 %b) {")
        this.emit("entry:")
        var same: String = this.fresh_local()
        this.emit_indent(same + " = icmp eq i64 %a, %b")
        this.emit_terminator("br i1 " + same + ", label %" + l_eq + ", label %" + l_shape)

        // A well-formed value of a heap-encoded enum is a BARE pointer — the
        // construction path ends at a plain ptrtoint, with no NaN-box tag — so
        // its top 16 bits are zero. Anything else (a nil, an int, a value of
        // another type reaching here through an `Any`) is not a comparable
        // payload, and the loads below would dereference its tag bits. Such an
        // operand answers with the bitwise comparison instead, which is what the
        // fast path above already decided: unequal.
        this.start_block(l_shape)
        var ahi: String = this.fresh_local()
        this.emit_indent(ahi + " = lshr i64 %a, 48")
        var bhi: String = this.fresh_local()
        this.emit_indent(bhi + " = lshr i64 %b, 48")
        var ahi_nz: String = this.fresh_local()
        this.emit_indent(ahi_nz + " = icmp ne i64 " + ahi + ", 0")
        var bhi_nz: String = this.fresh_local()
        this.emit_indent(bhi_nz + " = icmp ne i64 " + bhi + ", 0")
        var not_ptr: String = this.fresh_local()
        this.emit_indent(not_ptr + " = or i1 " + ahi_nz + ", " + bhi_nz)
        this.emit_terminator("br i1 " + not_ptr + ", label %" + l_ne + ", label %" + l_null)

        this.start_block(l_null)
        var a_z: String = this.fresh_local()
        this.emit_indent(a_z + " = icmp eq i64 %a, 0")
        var b_z: String = this.fresh_local()
        this.emit_indent(b_z + " = icmp eq i64 %b, 0")
        var either_z: String = this.fresh_local()
        this.emit_indent(either_z + " = or i1 " + a_z + ", " + b_z)
        this.emit_terminator("br i1 " + either_z + ", label %" + l_ne + ", label %" + l_tags)

        this.start_block(l_tags)
        var pa: String = this.val_to_typed_ptr("%a", "i64*")
        var pb: String = this.val_to_typed_ptr("%b", "i64*")
        var ta: String = this.fresh_local()
        this.emit_indent(ta + " = load i64, i64* " + pa)
        var tb: String = this.fresh_local()
        this.emit_indent(tb + " = load i64, i64* " + pb)
        var tag_eq: String = this.fresh_local()
        this.emit_indent(tag_eq + " = icmp eq i64 " + ta + ", " + tb)
        this.emit_terminator("br i1 " + tag_eq + ", label %" + l_disp + ", label %" + l_ne)

        // Tag first, then payload. Without the tag test a future payload
        // comparison could let `None == Some(0)` answer true, since a fieldless
        // variant has no field to disagree about.
        var arm_labels: List<String> = []
        var ai: Float = 0
        while (ai < variants.length()) {
            arm_labels.push(this.fresh_label("eeq.v"))
            ai = ai + 1
        }
        var cases: String = ""
        ai = 0
        while (ai < variants.length()) {
            cases = cases + " i64 " + ai.floor().to_string() + ", label %" + arm_labels[ai]
            ai = ai + 1
        }
        this.start_block(l_disp)
        // Default arm: the tags agree but name no declared variant, so the value
        // is not one this enum can produce and its shape is unknown. Unequal is
        // the only answer that cannot read past the allocation.
        this.emit_terminator("switch i64 " + ta + ", label %" + l_ne + " [" + cases + " ]")

        ai = 0
        while (ai < variants.length()) {
            var vname: String = variants[ai]
            var vkey: String = enum_name + "." + vname
            var vfields: String = ""
            if (this.enum_variant_fields.has(vkey)) { vfields = this.enum_variant_fields.get(vkey) }
            this.start_block(arm_labels[ai])
            if (vfields.length() == 0) {
                // Fieldless variant of a heap-encoded enum: a one-slot [tag]
                // array. The tags already matched and there is nothing else
                // allocated to read, so these two values ARE equal — the case
                // that made `Option.None == Option.None` false.
                this.emit_terminator("br label %" + l_eq)
            } else {
                var fparts: List<String> = this.split_respecting_generics(vfields, ",")
                var fi: Float = 0
                while (fi < fparts.length()) {
                    var slot_idx: Float = fi + 1
                    var a_slot: String = this.fresh_local()
                    this.emit_indent(a_slot + " = getelementptr i64, i64* " + pa + ", i64 " + slot_idx.floor().to_string())
                    var a_val: String = this.fresh_local()
                    this.emit_indent(a_val + " = load i64, i64* " + a_slot)
                    var b_slot: String = this.fresh_local()
                    this.emit_indent(b_slot + " = getelementptr i64, i64* " + pb + ", i64 " + slot_idx.floor().to_string())
                    var b_val: String = this.fresh_local()
                    this.emit_indent(b_val + " = load i64, i64* " + b_slot)
                    var f_type: String = this.declared_field_type(fparts[fi])
                    var f_eq: String = this.emit_enum_field_eq(f_type, a_val, b_val)
                    // Fields are compared in order and short-circuit to "not
                    // equal", so a difference in the FIRST field and a difference
                    // in the LAST are both detected.
                    var l_next: String = this.fresh_label("eeq.f")
                    this.emit_terminator("br i1 " + f_eq + ", label %" + l_next + ", label %" + l_ne)
                    this.start_block(l_next)
                    fi = fi + 1
                }
                this.emit_terminator("br label %" + l_eq)
            }
            ai = ai + 1
        }

        this.start_block(l_eq)
        this.emit_terminator("ret i64 1")
        this.start_block(l_ne)
        this.emit_terminator("ret i64 0")
        this.emit("}")
        this.block_terminated = false

        var ir: String = this.sb.to_string()
        this.sb = saved_sb
        this.block_terminated = saved_term
        this.local_counter = saved_counter
        this.in_function = saved_in_fn
        this.globals.push(ir)
        return sym
    }

    /// The declared type of one entry of an `enum_variant_fields` string
    /// ("value:Int" → "Int"). Unlike `get_variant_field_type` this does NOT
    /// collapse the answer onto the handful of names codegen lowers with —
    /// equality needs to tell a nested enum and a class apart, and that
    /// distinction is exactly what the collapse discards. An entry without a
    /// type is "Any", the honest answer for "the source did not say".
    fun declared_field_type(field_def: String): String {
        if (!field_def.contains(":")) { return "Any" }
        var parts: List<String> = field_def.split(":")
        if (parts.length() < 2) { return "Any" }
        return parts[1]
    }

    /// Emit the comparison of one enum payload slot and return the `i1` register
    /// holding "equal". The comparison is chosen by the field's DECLARED type,
    /// which is the whole reason this lives in codegen: the slot itself is an
    /// opaque i64 and nothing in it says which of these comparisons is right.
    fun emit_enum_field_eq(decl_type: String, av: String, bv: String): String {
        var base: String = this.generic_base_name(decl_type)

        // Identity mode has no tags, so no representation to interpret: every
        // field is its bits. It also links against base.ll, which has no
        // __any_eq at all, so the runtime fallback below is not available here.
        if (this.identity_mode and base != "String") {
            var idc: String = this.fresh_local()
            this.emit_indent(idc + " = icmp eq i64 " + av + ", " + bv)
            return idc
        }

        if (base == "String") {
            // Two equal strings need not share a pointer, which is the same
            // reason gen_binary routes String == to this helper.
            var sr: String = this.fresh_local()
            this.emit_indent(sr + " = call i64 @__string_eq(i64 " + av + ", i64 " + bv + ")")
            var sc: String = this.fresh_local()
            this.emit_indent(sc + " = icmp ne i64 " + sr + ", 0")
            return sc
        }

        if (base == "Float") {
            // gen_enum_construct normalises a Float payload to a double
            // on construction, so both slots hold the same representation here.
            // Comparing at double level is still the right lowering rather than
            // a bit compare: it is what makes -0.0 equal 0.0, and it matches the
            // Float arm of gen_binary.
            var ad: String = this.emit_untag_float(av)
            var bd: String = this.emit_untag_float(bv)
            var fc: String = this.fresh_local()
            this.emit_indent(fc + " = fcmp oeq double " + ad + ", " + bd)
            return fc
        }

        // A nested value of a heap-encoded enum recurses structurally, so
        // equality is deep for the whole enum tree and not just its top level.
        if (this.enum_defs.has(base) and this.get_max_fields(base) > 0) {
            var sub: String = this.ensure_enum_eq(base)
            var sr2: String = this.fresh_local()
            this.emit_indent(sr2 + " = call i64 @" + sub + "(i64 " + av + ", i64 " + bv + ")")
            var sc2: String = this.fresh_local()
            this.emit_indent(sc2 + " = icmp ne i64 " + sr2 + ", 0")
            return sc2
        }

        // Bit equality covers the cases whose representation the declared type
        // already pins down to a unique pattern per value (a tagged Int, a
        // tagged Bool, a fieldless enum's `tag << 56` immediate), and it is also
        // the deliberate answer for a reference type: two class instances, Lists
        // or Maps compare by identity here for exactly the reason they do
        // everywhere else in the language — value equality for a mutable
        // reference is a separate design question, not something enum equality
        // should decide on its own.
        if (base == "Int" or base == "Bool" or base == "Nil") { return this.emit_bit_eq(av, bv) }
        if (this.enum_defs.has(base)) { return this.emit_bit_eq(av, bv) }
        if (this.class_fields.has(base)) { return this.emit_bit_eq(av, bv) }
        if (base == "List" or base == "Map" or base == "Set" or base == "StringBuilder") {
            return this.emit_bit_eq(av, bv)
        }

        // Anything left is a type this site cannot resolve: an `Any` field, or a
        // generic parameter (`enum Result<T, E> { Ok(value: T) }` — T names
        // nothing at the IR level). A static choice would be a guess, so defer
        // to the one comparison that reads the operands' actual tags. That is
        // the same delegation gen_binary makes for an `Any` operand, and the
        // same one #104 made for ordering.
        var ar: String = this.fresh_local()
        this.emit_indent(ar + " = call i64 @__any_eq(i64 " + av + ", i64 " + bv + ")")
        var ac: String = this.fresh_local()
        this.emit_indent(ac + " = icmp ne i64 " + ar + ", 0")
        return ac
    }

    fun emit_bit_eq(av: String, bv: String): String {
        var c: String = this.fresh_local()
        this.emit_indent(c + " = icmp eq i64 " + av + ", " + bv)
        return c
    }

    /// The write half of the #118 member-read guard: is `object.field = ...` an
    /// assignment to a member that a module alias does not have?
    ///
    /// `gen_set_field` resolves a module write by looking `prefix + field` up in
    /// `module_globals`, and on a miss falls through to the class-instance path,
    /// which evaluates the bare alias as if it were a local and emits
    /// `load i64, i64* %Math` — an SSA name that was never defined. The module
    /// then fails `opt` verification, and the failure is reported as a compiler
    /// bug for what is a typo in the user's program (BUGS #122, the write half of
    /// #118).
    ///
    /// The alias is *known to be a module* here and nowhere downstream, so this
    /// is the only place absence is expressible — same shape as the read guard,
    /// and the same reason each path reaching the fallback needs its own report
    /// (can't-express-unknown family: #22/#40/#78/#37/#103/#113/#114/#118).
    ///
    /// Returns true when it has reported; the caller must then not lower the
    /// store. Every early `return false` is a spelling that must keep working:
    /// a name that merely *looks* like an alias but is shadowed by a local, a
    /// class or enum of that name, and a member that really does exist.
    fun report_missing_module_write(object: AST.Expr, field: String): Bool {
        var obj_name: String = this.get_variable_name(object)
        if (obj_name.length() == 0) { return false }
        if (!this.has_module_alias(obj_name)) { return false }
        // A local, parameter or global of the same name shadows the alias: the
        // write is a field store on that value, not a module write. Checked
        // before the member lookup because a shadowed alias has no members.
        if (this.typed_vars.has(obj_name)) { return false }
        if (this.global_var_types.has(obj_name)) { return false }
        if (this.module_globals.has(obj_name)) { return false }
        if (this.current_prefix.length() > 0 and this.module_globals.has(this.current_prefix + obj_name)) { return false }
        if (this.global_var_types.has(this.current_prefix + obj_name)) { return false }
        // An enum or class spelled like the alias is not a namespace write.
        if (this.enum_defs.has(obj_name)) { return false }
        if (this.class_fields.has(obj_name)) { return false }
        if (this.enum_variant_tags.has(obj_name + "." + field)) { return false }
        if (this.named_imports.has(obj_name + "." + field)) { return false }
        // The member itself: a module global is a legitimate write target
        // (`Math.pi = 3.0`, `Flag.enabled = true` in test/cross_module_global.sf),
        // and this is exactly the lookup `gen_set_field` makes before its
        // fall-through.
        var resolved: String = this.module_alias_prefix(obj_name) + field
        if (this.module_globals.has(resolved)) { return false }
        if (this.global_var_types.has(resolved)) { return false }
        // A member that EXISTS but is not a variable — a function, a class, an
        // enum — reaches the same fall-through and gets the same invalid IR, so
        // reporting only absence would leave the hole open for `Math.abs = 1`.
        // Measured: `Math.abs = 1`, `IO.println = 1`, `Inner.Widget = 1` and
        // `Inner.Colour = 1` each gave exit 0 and `load i64, i64* %Math` with the
        // absence check alone. A second message rather than one, because "you
        // typed a name that does not exist" and "that name exists and is not
        // assignable" are different mistakes.
        var not_assignable: Bool = false
        if (this.str_in_list(this.known_functions, resolved)) { not_assignable = true }
        if (this.class_fields.has(resolved)) { not_assignable = true }
        if (this.class_struct_names.has(resolved)) { not_assignable = true }
        if (this.enum_defs.has(resolved)) { not_assignable = true }
        if (not_assignable) {
            this.codegen_error("cannot assign to '" + field + "' in module '" + obj_name + "' — it is not a variable")
            return true
        }
        this.codegen_error("no member '" + field + "' in module '" + obj_name + "'")
        return true
    }

