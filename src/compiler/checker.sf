// Null-safety type checker for Saffron
// Tracks nullable types and flags operations on potentially-nil values.
// Reports errors but does not block compilation (advisory mode).

import "./ast.sf" as AST

class Scope {
    var vars: Map<String, String>
    var narrowed: Map<String, String>

    fun init() {
        this.vars = {}
        this.narrowed = {}
    }
}

class TypeEnv {
    var scopes: List<Scope>
    var funcs: Map<String, String>
    var enum_variants: Map<String, String>
    var enum_fields: Map<String, String>
    var class_fields: Map<String, String>
    var class_methods: Map<String, String>

    fun init() {
        this.scopes = []
        this.scopes.push(Scope())
        this.funcs = {}
        this.enum_variants = {}
        this.enum_fields = {}
        this.class_fields = {}
        this.class_methods = {}
    }

    fun push_scope() {
        this.scopes.push(Scope())
    }

    fun pop_scope() {
        this.scopes.pop()
    }

    fun current_scope(): Scope {
        return this.scopes[this.scopes.length() - 1]
    }

    fun define_var(name: String, typ: String) {
        this.current_scope().vars.set(name, typ)
    }

    fun get_var(name: String): String {
        // Search from innermost scope outward
        var i = this.scopes.length() - 1
        while (i >= 0) {
            var scope: Scope = this.scopes[i]
            if (scope.narrowed.has(name)) {
                return scope.narrowed.get(name)
            }
            if (scope.vars.has(name)) {
                return scope.vars.get(name)
            }
            i = i - 1
        }
        return "Any"
    }

    fun narrow(name: String, typ: String) {
        this.current_scope().narrowed.set(name, typ)
    }

    fun clear_narrowing() {
        this.current_scope().narrowed = {}
    }

    fun define_func(name: String, ret_type: String) {
        this.funcs.set(name, ret_type)
    }

    fun get_func_ret(name: String): String {
        if (this.funcs.has(name)) {
            return this.funcs.get(name)
        }
        return "Any"
    }
}

class NullChecker {
    var env: TypeEnv
    var errors: List<String>
    var warnings: List<String>
    var current_func_ret: String
    var current_class: String
    var class_parents: Map<String, String>
    var class_method_names: Map<String, String>

    fun init() {
        this.env = TypeEnv()
        this.errors = []
        this.warnings = []
        this.current_func_ret = "Nil"
        this.current_class = ""
        this.class_parents = {}
        this.class_method_names = {}
    }

    fun error(msg: String) {
        this.errors.push(msg)
    }

    fun warn(msg: String) {
        this.warnings.push(msg)
    }

    // --- String → Type node conversion ---

    fun parse_type_node(s: String): AST.Type {
        if (s == "Int" or s == "Number" or s == "Float") return AST.Type.IntType
        if (s == "Bool") return AST.Type.BoolType
        if (s == "String") return AST.Type.StringType
        if (s == "Nil") return AST.Type.NilType
        if (s == "Any") return AST.Type.AnyType
        // Union: "String|Nil" or "Int|String"
        if (s.contains("|")) {
            var parts = s.split("|")
            var types: List<AST.Type> = []
            var i = 0
            while (i < parts.length()) {
                types.push(this.parse_type_node(parts[i]))
                i = i + 1
            }
            return AST.Type.UnionType(types)
        }
        // Generic: "List<String>" or "Map<String,Number>"
        if (s.contains("<")) {
            var lt_pos = 0
            var i = 0
            while (i < s.length()) {
                if (s.char_at(i) == "<") {
                    lt_pos = i
                    i = s.length()
                }
                i = i + 1
            }
            var base = s.slice(0, lt_pos)
            var args_str = s.slice(lt_pos + 1, s.length() - 1)
            var arg_strs = this.split_type_args(args_str)
            var args: List<AST.Type> = []
            var j = 0
            while (j < arg_strs.length()) {
                args.push(this.parse_type_node(arg_strs[j]))
                j = j + 1
            }
            return AST.Type.GenericType(base, args)
        }
        // Class/Enum type
        return AST.Type.ClassType(s)
    }

    fun split_type_args(s: String): List<String> {
        var args: List<String> = []
        var current = ""
        var depth = 0
        var i = 0
        while (i < s.length()) {
            var ch = s.char_at(i)
            if (ch == "<") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "," and depth == 0) {
                args.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            args.push(current)
        }
        return args
    }

    fun type_node_to_string(t: AST.Type): String {
        return AST.type_to_string(t)
    }

    fun is_nullable_type(t: AST.Type): Bool {
        return match (t) {
            NullableType(inner) => true
            UnionType(types) => {
                // Check if any type in the union is Nil
                var has_nil = false
                var i = 0
                while (i < types.length()) {
                    var sub = AST.type_to_string(types[i])
                    if (sub == "Nil") { has_nil = true }
                    i = i + 1
                }
                has_nil
            }
            NilType => true
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(b, a) => false
            FuncType(p, r) => false
        }
    }

    // --- Nullable type helpers (string-based, for backward compat) ---

    fun is_nullable(typ: String): Bool {
        if (typ.contains("|")) {
            if (typ.contains("Nil")) {
                return true
            }
        }
        if (typ == "Nil") {
            return true
        }
        return false
    }

    fun strip_nil(typ: String): String {
        if (typ == "Nil") return "Nil"
        if (!typ.contains("|")) return typ
        var parts = typ.split("|")
        var result = ""
        var i = 0
        while (i < parts.length()) {
            var p = parts[i]
            if (p != "Nil" and p != " Nil" and p != "Nil ") {
                if (result.length() > 0) {
                    result = result + "|" + p
                } else {
                    result = p
                }
            }
            i = i + 1
        }
        if (result.length() == 0) return "Nil"
        return result
    }

    fun make_nullable(typ: String): String {
        if (this.is_nullable(typ)) return typ
        if (typ == "Nil") return "Nil"
        return typ + "|Nil"
    }

    fun is_subtype(child: String, parent: String): Bool {
        if (child == parent) return true
        if (parent == "Any") return true
        if (child == "Any") return true
        // Check inheritance chain
        var current = child
        while (current.length() > 0) {
            if (current == parent) return true
            var parent_key = current + "__parent"
            var next = this.env.get_var(parent_key)
            if (next == "Any" or next == current) return false
            current = next
        }
        return false
    }

    fun requires_non_nil(method: String): Bool {
        if (method == "length") return true
        if (method == "split") return true
        if (method == "contains") return true
        if (method == "starts_with") return true
        if (method == "ends_with") return true
        if (method == "replace") return true
        if (method == "char_at") return true
        if (method == "slice") return true
        if (method == "to_number") return true
        if (method == "to_upper") return true
        if (method == "to_lower") return true
        if (method == "trim") return true
        if (method == "push") return true
        if (method == "pop") return true
        if (method == "join") return true
        if (method == "append") return true
        if (method == "to_string") return true
        return false
    }

    // --- Check program ---

    fun check_program(stmts: List<AST.Stmt>) {
        // First pass: register declarations
        var i = 0
        while (i < stmts.length()) {
            this.register_decl(stmts[i])
            i = i + 1
        }
        // Second pass: check bodies
        i = 0
        while (i < stmts.length()) {
            this.check_stmt(stmts[i])
            i = i + 1
        }
    }

    fun register_decl(stmt: AST.Stmt) {
        match (stmt) {
            FunDecl(name, params, ret_type, body, doc) => {
                this.env.define_func(name, ret_type)
            }
            EnumDecl(name, variants, doc) => {
                this.register_enum(name, variants)
            }
            ClassDecl(name, parent, fields, methods, doc) => {
                this.env.class_fields.set(name, fields)
                if (parent.length() > 0) {
                    this.env.define_var(name + "__parent", parent)
                    this.class_parents.set(name, parent)
                }
            }
            VarDecl(n, t, i, d) => {}
            ExprStmt(e) => {}
            Return(v) => {}
            If(c, t, e) => {}
            While(c, b) => {}
            Block(s) => {}
            Break => {}
            Continue => {}
            TryCatch(tb, cn, cb) => {}
            Throw(v) => {}
        }
    }

    fun register_enum(name: String, variants: List<AST.Variant>) {
        var variant_names: List<String> = []
        var i = 0
        while (i < variants.length()) {
            var v = variants[i]
            var vname = match (v) { Variant(n, f) => n }
            var vfields = match (v) { Variant(n, f) => f }
            variant_names.push(vname)
            if (vfields.length() > 0) {
                this.env.enum_fields.set(name + "." + vname, vfields)
            }
            i = i + 1
        }
        this.env.enum_variants.set(name, variant_names.join(","))
    }


    // --- Statement checking ---

    fun check_stmt(stmt: AST.Stmt) {
        match (stmt) {
            VarDecl(name, type_ann, init, doc) => {
                var init_type = this.infer_expr(init)
                if (type_ann != "Any") {
                    // Check: assigning nullable to non-nullable
                    if (!this.is_nullable(type_ann) and this.is_nullable(init_type)) {
                        this.error(name + ": cannot assign nullable " + init_type + " to non-nullable " + type_ann)
                    }
                    this.env.define_var(name, type_ann)
                } else {
                    this.env.define_var(name, init_type)
                }
            }
            FunDecl(name, params, ret_type, body, doc) => {
                // Register method with class prefix if inside a class
                if (this.current_class.length() > 0) {
                    this.env.define_func(this.current_class + "__" + name, ret_type)
                    // Track method names for conformance checking
                    var existing = ""
                    if (this.class_method_names.has(this.current_class)) {
                        existing = this.class_method_names.get(this.current_class)
                    }
                    if (existing.length() > 0) {
                        existing = existing + "," + name
                    } else {
                        existing = name
                    }
                    this.class_method_names.set(this.current_class, existing)
                }
                var old_ret = this.current_func_ret
                this.current_func_ret = ret_type
                this.env.push_scope()
                if (params.length() > 0) {
                    var parts = params.split(",")
                    var j = 0
                    while (j < parts.length()) {
                        var kv = parts[j].split(":")
                        if (kv.length() >= 2) {
                            this.env.define_var(kv[0], kv[1])
                        }
                        j = j + 1
                    }
                }
                this.check_stmts(body)
                this.env.pop_scope()
                this.current_func_ret = old_ret
            }
            Return(value) => {
                var val_type = this.infer_expr(value)
                if (this.current_func_ret != "Any") {
                    if (!this.is_nullable(this.current_func_ret) and this.is_nullable(val_type)) {
                        this.error("return: cannot return nullable " + val_type + " from function expecting " + this.current_func_ret)
                    }
                }
            }
            If(cond, then_branch, else_branch) => {
                this.infer_expr(cond)
                this.env.push_scope()
                this.apply_narrowing(cond)
                this.check_stmts(then_branch)
                this.env.pop_scope()
                this.env.push_scope()
                this.check_stmts(else_branch)
                this.env.pop_scope()
            }
            While(cond, body) => {
                this.infer_expr(cond)
                this.env.push_scope()
                this.check_stmts(body)
                this.env.pop_scope()
            }
            ExprStmt(expr) => {
                this.infer_expr(expr)
            }
            Block(stmts) => {
                this.env.push_scope()
                this.check_stmts(stmts)
                this.env.pop_scope()
            }
            ClassDecl(name, parent, fields, methods, doc) => {
                this.env.class_fields.set(name, fields)
                if (parent.length() > 0) {
                    this.env.define_var(name + "__parent", parent)
                    this.class_parents.set(name, parent)
                }
            }
            EnumDecl(n, v, d) => {}
            Break => {}
            Continue => {}
            TryCatch(try_body, catch_name, catch_body) => {
                this.env.push_scope()
                this.check_stmts(try_body)
                this.env.pop_scope()
                this.env.push_scope()
                this.env.define_var(catch_name, "String")
                this.check_stmts(catch_body)
                this.env.pop_scope()
            }
            Throw(value) => {
                this.infer_expr(value)
            }
        }
    }

    fun check_stmts(stmts: List<AST.Stmt>) {
        var i = 0
        while (i < stmts.length()) {
            this.check_stmt(stmts[i])
            i = i + 1
        }
    }

    fun apply_narrowing(cond: AST.Expr) {
        // Pattern 1: x.has(...) → map.get() is non-nullable in this scope
        // Pattern 2: x != nil → x is non-nullable in this scope
        // Pattern 3: x (truthy check on variable) → x is non-nullable
        var cond_kind = match (cond) {
            MethodCall(o, m, a) => "method:" + m
            Binary(l, o, r) => "binary:" + o
            Variable(n) => "var:" + n
            Unary(o, r) => "unary"
            IntLit(v) => ""
            FloatLit(v) => ""
            BoolLit(v) => ""
            StringLit(s) => ""
            NilLit => ""
            Call(c, a) => ""
            Assign(n, v) => ""
            Logical(l, o, r) => ""
            MemberAccess(o, f) => ""
            Match(s, a) => ""
            EnumConstruct(e, v, a) => ""
            Lambda(p, r, b) => ""
            GetField(o, f) => ""
            SetField(o, f, v) => ""
            This => ""
            ListLit(e) => ""
            IndexGet(o, i) => ""
            IndexSet(o, i, v) => ""
            MapLit => ""
            BlockExpr(s, v) => ""
        }

        // map.has() guard
        if (cond_kind == "method:has") {
            this.env.narrow("__has_guard", "active")
        }

        // v != nil or nil != v
        if (cond_kind == "binary:!=") {
            var lhs_name = this.get_expr_var_name(cond)
            if (lhs_name.length() > 0) {
                var var_type = this.env.get_var(lhs_name)
                if (this.is_nullable(var_type)) {
                    this.env.narrow(lhs_name, this.strip_nil(var_type))
                }
            }
        }

        // Truthy variable: if (v) { ... }
        if (cond_kind.starts_with("var:")) {
            var name = cond_kind.slice(4, cond_kind.length())
            var var_type = this.env.get_var(name)
            if (this.is_nullable(var_type)) {
                this.env.narrow(name, this.strip_nil(var_type))
            }
        }
    }

    fun get_expr_var_name(expr: AST.Expr): String {
        // For Binary(left, "!=", right), extract variable name if one side is NilLit
        var result = match (expr) {
            Binary(l, o, r) => {
                var left_name = this.extract_var_from_nil_check(l, r)
                if (left_name.length() > 0) {
                    left_name
                } else {
                    this.extract_var_from_nil_check(r, l)
                }
            }
            Variable(n) => ""
            IntLit(v) => ""
            FloatLit(v) => ""
            BoolLit(v) => ""
            StringLit(s) => ""
            NilLit => ""
            Unary(o, r) => ""
            Call(c, a) => ""
            Assign(n, v) => ""
            Logical(l, o, r) => ""
            MemberAccess(o, f) => ""
            Match(s, a) => ""
            EnumConstruct(e, v, a) => ""
            Lambda(p, r, b) => ""
            GetField(o, f) => ""
            SetField(o, f, v) => ""
            This => ""
            ListLit(e) => ""
            IndexGet(o, i) => ""
            IndexSet(o, i, v) => ""
            MethodCall(o, m, a) => ""
            MapLit => ""
            BlockExpr(s, v) => ""
        }
        return result
    }

    fun extract_var_from_nil_check(var_side: AST.Expr, nil_side: AST.Expr): String {
        // Returns variable name if var_side is Variable and nil_side is NilLit
        var is_nil = match (nil_side) {
            NilLit => true
            IntLit(v) => false
            FloatLit(v) => false
            BoolLit(v) => false
            StringLit(s) => false
            Variable(n) => false
            Binary(l, o, r) => false
            Unary(o, r) => false
            Call(c, a) => false
            Assign(n, v) => false
            Logical(l, o, r) => false
            MemberAccess(o, f) => false
            Match(s, a) => false
            EnumConstruct(e, v, a) => false
            Lambda(p, r, b) => false
            GetField(o, f) => false
            SetField(o, f, v) => false
            This => false
            ListLit(e) => false
            IndexGet(o, i) => false
            IndexSet(o, i, v) => false
            MethodCall(o, m, a) => false
            MapLit => false
            BlockExpr(s, v) => false
        }
        if (!is_nil) return ""
        var name = match (var_side) {
            Variable(n) => n
            IntLit(v) => ""
            FloatLit(v) => ""
            BoolLit(v) => ""
            StringLit(s) => ""
            NilLit => ""
            Binary(l, o, r) => ""
            Unary(o, r) => ""
            Call(c, a) => ""
            Assign(n, v) => ""
            Logical(l, o, r) => ""
            MemberAccess(o, f) => ""
            Match(s, a) => ""
            EnumConstruct(e, v, a) => ""
            Lambda(p, r, b) => ""
            GetField(o, f) => ""
            SetField(o, f, v) => ""
            This => ""
            ListLit(e) => ""
            IndexGet(o, i) => ""
            IndexSet(o, i, v) => ""
            MethodCall(o, m, a) => ""
            MapLit => ""
            BlockExpr(s, v) => ""
        }
        return name
    }

    // --- Expression type inference ---

    fun infer_expr(expr: AST.Expr): String {
        return match (expr) {
            IntLit(v) => "Int"
            FloatLit(v) => "Float"
            BoolLit(v) => "Bool"
            StringLit(s) => "String"
            NilLit => "Nil"
            Variable(name) => this.env.get_var(name)
            Binary(left, op, right) => this.infer_binary(left, op, right)
            Unary(op, right) => this.infer_unary(op, right)
            Call(callee, args) => this.infer_call(callee, args)
            Assign(name, value) => this.check_assign(name, value)
            Logical(left, op, right) => "Bool"
            MemberAccess(obj, field) => this.infer_member_access(obj, field)
            Match(subject, arms) => this.infer_match(subject, arms)
            EnumConstruct(e, v, a) => e
            Lambda(p, r, b) => "Fun"
            GetField(obj, field) => "Any"
            SetField(obj, field, value) => this.infer_expr(value)
            This => this.current_class
            ListLit(elements) => "List"
            IndexGet(obj, index) => {
                var list_type = this.infer_expr(obj)
                this.infer_expr(index)
                this.extract_list_element_type(list_type)
            }
            IndexSet(obj, index, value) => this.infer_expr(value)
            MethodCall(obj, method, args) => this.infer_method_call(obj, method, args)
            MapLit => "Map"
            BlockExpr(stmts, value) => {
                this.check_stmts(stmts)
                this.infer_expr(value)
            }
        }
    }

    fun infer_member_access(obj: AST.Expr, field: String): String {
        var obj_type = this.infer_expr(obj)
        // this.field → look up field type from current class
        if (obj_type == this.current_class or obj_type == "This") {
            if (this.env.class_fields.has(this.current_class)) {
                return this.get_class_field_type(this.current_class, field)
            }
        }
        // variable.field → look up from variable's class type
        if (this.env.class_fields.has(obj_type)) {
            return this.get_class_field_type(obj_type, field)
        }
        return "Any"
    }

    fun get_class_field_type(class_name: String, field: String): String {
        var fields_str = this.env.class_fields.get(class_name)
        if (fields_str.length() == 0) return "Any"
        var parts = fields_str.split(",")
        var i = 0
        while (i < parts.length()) {
            var kv = parts[i].split(":")
            if (kv.length() >= 2) {
                if (kv[0] == field) return kv[1]
            }
            i = i + 1
        }
        return "Any"
    }

    fun extract_generic_args(typ: String): String {
        // "List<String>" → "String"
        // "Map<String,Number>" → "String,Number"
        // "Map<String,List<Int>>" → "String,List<Int>"
        if (!typ.contains("<")) return ""
        // Find first < and matching >
        var start = 0
        var i = 0
        while (i < typ.length()) {
            if (typ.char_at(i) == "<") {
                start = i + 1
                i = typ.length()
            }
            i = i + 1
        }
        // Remove trailing >
        var end = typ.length() - 1
        if (end > start) {
            return typ.slice(start, end)
        }
        return ""
    }

    fun extract_nth_generic_arg(typ: String, n: Float): String {
        // Split generic args respecting nested <> depth
        var args_str = this.extract_generic_args(typ)
        if (args_str.length() == 0) return "Any"
        var args: List<String> = []
        var current = ""
        var depth = 0
        var i = 0
        while (i < args_str.length()) {
            var ch = args_str.char_at(i)
            if (ch == "<") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">") {
                depth = depth - 1
                current = current + ch
            } else if (ch == "," and depth == 0) {
                args.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            args.push(current)
        }
        if (n < args.length()) {
            return args[n.floor()]
        }
        return "Any"
    }

    fun extract_map_value_type(typ: String): String {
        // "Map<String,Number>" → "Number" (second arg)
        // "Map<String>" → "String" (fallback: first arg)
        // "Map" → "Any"
        if (!typ.contains("<")) return "Any"
        var second = this.extract_nth_generic_arg(typ, 1)
        if (second != "Any") return second
        return this.extract_nth_generic_arg(typ, 0)
    }

    fun extract_map_key_type(typ: String): String {
        // "Map<String,Number>" → "String"
        if (!typ.contains("<")) return "Any"
        return this.extract_nth_generic_arg(typ, 0)
    }

    fun extract_list_element_type(typ: String): String {
        // "List<String>" → "String"
        if (!typ.contains("<")) return "Any"
        return this.extract_nth_generic_arg(typ, 0)
    }

    fun infer_binary(left: AST.Expr, op: String, right: AST.Expr): String {
        var lt = this.infer_expr(left)
        var rt = this.infer_expr(right)
        if (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=") {
            return "Bool"
        }
        if (op == "+") {
            if (lt == "String" or rt == "String") return "String"
        }
        if (lt == rt) return lt
        if (lt == "Any") return rt
        if (rt == "Any") return lt
        return "Int"
    }

    fun infer_unary(op: String, right: AST.Expr): String {
        if (op == "!") return "Bool"
        return this.infer_expr(right)
    }

    fun infer_call(callee: AST.Expr, args: List<AST.Expr>): String {
        var name = match (callee) {
            Variable(n) => n
            MemberAccess(o, f) => ""
        }
        if (name.length() > 0) {
            return this.env.get_func_ret(name)
        }
        return "Any"
    }

    fun check_assign(name: String, value: AST.Expr): String {
        var val_type = this.infer_expr(value)
        var var_type = this.env.get_var(name)
        if (var_type != "Any" and !this.is_nullable(var_type) and this.is_nullable(val_type)) {
            this.error(name + ": cannot assign nullable " + val_type + " to non-nullable " + var_type)
        }
        return val_type
    }

    // --- Method call inference (the key null-safety check) ---

    fun infer_method_call(obj: AST.Expr, method: String, args: List<AST.Expr>): String {
        var obj_type = this.infer_expr(obj)

        // Check all argument expressions for null-safety too
        var ai = 0
        while (ai < args.length()) {
            this.infer_expr(args[ai])
            ai = ai + 1
        }

        // Map.get returns nullable — unless inside a has() guard
        if (method == "get") {
            if (obj_type == "Map" or obj_type.starts_with("Map<")) {
                var val_type = this.extract_map_value_type(obj_type)
                var has_guard = this.env.get_var("__has_guard")
                if (has_guard == "active") {
                    return val_type
                }
                return this.make_nullable(val_type)
            }
        }
        // Map.has returns Bool
        if (method == "has") {
            return "Bool"
        }
        // Map.keys returns List<String>
        if (method == "keys") {
            return "List<String>"
        }

        // Check: calling method on nullable object
        if (this.is_nullable(obj_type) and this.requires_non_nil(method)) {
            this.error("cannot call ." + method + "() on nullable type " + obj_type)
        }

        // String methods
        if (obj_type == "String") {
            if (method == "length") return "Int"
            if (method == "split") return "List<String>"
            if (method == "contains") return "Bool"
            if (method == "starts_with") return "Bool"
            if (method == "ends_with") return "Bool"
            if (method == "replace") return "String"
            if (method == "char_at") return "String"
            if (method == "slice") return "String"
            if (method == "to_number") return "Int"
            if (method == "trim") return "String"
        }
        // List methods
        if (obj_type == "List" or obj_type.starts_with("List<")) {
            if (method == "length") return "Int"
            if (method == "join") return "String"
            if (method == "contains") return "Bool"
            if (method == "push") return "Nil"
            if (method == "pop") return "Any"
        }
        // StringBuilder
        if (obj_type == "StringBuilder") {
            if (method == "append") return "Nil"
            if (method == "to_string") return "String"
        }
        // Number methods
        if (obj_type == "Int" or obj_type == "Float") {
            if (method == "floor") return "Int"
            if (method == "to_string") return "String"
        }

        // Class method: look up return type from registered functions
        // Methods are registered as "ClassName__method" or just "method"
        if (obj_type != "Any") {
            var full_name = obj_type + "__" + method
            var ret = this.env.get_func_ret(full_name)
            if (ret != "Any") return ret
        }
        var ret = this.env.get_func_ret(method)
        if (ret != "Any") return ret

        return "Any"
    }

    // --- Match type inference + exhaustiveness ---

    fun infer_match(subject: AST.Expr, arms: List<AST.MatchArm>): String {
        var subj_type = this.infer_expr(subject)

        // Check exhaustiveness: collect matched variant names
        var matched_variants: List<String> = []
        var has_wildcard = false

        // Infer each arm body type; unify across arms
        var result_type = "Any"
        var i = 0
        while (i < arms.length()) {
            var arm = arms[i]
            var pattern = match (arm) { Arm(p, b) => p }
            var body = match (arm) { Arm(p, b) => b }

            var variant_name = match (pattern) {
                VariantPattern(v, bindings) => v
            }

            if (variant_name == "_") {
                has_wildcard = true
            } else {
                matched_variants.push(variant_name)
            }

            // Push scope for arm bindings
            this.env.push_scope()
            var bindings = match (pattern) { VariantPattern(v, b) => b }
            var bi = 0
            while (bi < bindings.length()) {
                // Bindings from enum fields — try to get type from enum_fields
                var field_type = this.get_enum_binding_type(subj_type, variant_name, bi)
                this.env.define_var(bindings[bi], field_type)
                bi = bi + 1
            }

            var arm_type = this.infer_expr(body)
            this.env.pop_scope()

            if (i == 0) {
                result_type = arm_type
            } else {
                if (arm_type != result_type and arm_type != "Any" and result_type != "Any") {
                    result_type = result_type + "|" + arm_type
                }
            }
            i = i + 1
        }

        // Exhaustiveness: check if all variants of an enum are covered
        if (!has_wildcard and subj_type != "Any") {
            this.check_exhaustiveness(subj_type, matched_variants)
        }

        return result_type
    }

    fun get_enum_binding_type(enum_type: String, variant: String, field_idx: Float): String {
        // Look up "EnumName.Variant" in enum_fields
        var key = enum_type + "." + variant
        if (this.env.enum_fields.has(key)) {
            var fields_str = this.env.enum_fields.get(key)
            if (fields_str.length() > 0) {
                var parts = fields_str.split(",")
                if (field_idx < parts.length()) {
                    var kv = parts[field_idx.floor()].split(":")
                    if (kv.length() >= 2) {
                        return kv[1]
                    }
                }
            }
        }
        return "Any"
    }

    fun check_exhaustiveness(enum_type: String, matched: List<String>) {
        // Look up all variants of this enum
        if (!this.env.enum_variants.has(enum_type)) return nil
        var all_variants_str = this.env.enum_variants.get(enum_type)
        if (all_variants_str.length() == 0) return nil
        var all_variants = all_variants_str.split(",")
        var i = 0
        while (i < all_variants.length()) {
            var v = all_variants[i]
            if (!matched.contains(v)) {
                this.warn("non-exhaustive match on " + enum_type + ": missing " + v)
            }
            i = i + 1
        }
    }

    // --- Report ---

    fun report(): String {
        if (this.errors.length() == 0 and this.warnings.length() == 0) {
            return ""
        }
        var sb = StringBuilder()
        var i = 0
        while (i < this.errors.length()) {
            sb.append("ERROR: ")
            sb.append(this.errors[i])
            sb.append("\n")
            i = i + 1
        }
        i = 0
        while (i < this.warnings.length()) {
            sb.append("WARN: ")
            sb.append(this.warnings[i])
            sb.append("\n")
            i = i + 1
        }
        return sb.to_string()
    }

    fun has_errors(): Bool {
        return this.errors.length() > 0
    }
}

fun check(program: List<AST.Stmt>): String {
    var checker = NullChecker()
    checker.check_program(program)
    return checker.report()
}

fun check_with_imports(program: List<AST.Stmt>, imports: List<AST.Stmt>): String {
    var checker = NullChecker()
    // Register imported declarations (types, enums, classes, functions)
    // without checking their bodies
    var i = 0
    while (i < imports.length()) {
        checker.register_decl(imports[i])
        i = i + 1
    }
    checker.check_program(program)
    return checker.report()
}
