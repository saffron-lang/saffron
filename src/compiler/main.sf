// Saffron-mini LLVM compiler
// Usage: saffron src/compiler/main.sf <input.sf> [output.ll]

import "os" as OS
import "./lexer.sf" as Lexer
import "./parser.sf" as Parser
import "./codegen.sf" as Codegen

fun main() {
    var args = OS.args()

    if (args.length() < 3) {
        IO.println("Usage: saffron src/compiler/main.sf <input.sf> [output.ll]")
        OS.exit(1)
    }

    var input_path = args[2]
    var output_path = input_path.replace(".sf", ".ll")
    if (args.length() >= 4) {
        output_path = args[3]
    }

    // Read source
    var source = IO.read_file(input_path)

    // Lex
    var tokens = Lexer.lex(source)

    // Parse
    var program = Parser.parse(tokens)

    // Generate LLVM IR
    var ir = Codegen.generate(program)

    // Write output
    IO.write_file(output_path, ir)
    IO.println("Compiled " + input_path + " -> " + output_path)

    // Optionally compile to binary
    var bin_path = output_path.replace(".ll", "")
    var result = OS.exec("clang -O2 -o " + bin_path + " " + output_path + " 2>&1")
    if (result.length() > 0) {
        IO.println("clang: " + result)
    } else {
        IO.println("Linked  " + output_path + " -> " + bin_path)
    }
}

main()
