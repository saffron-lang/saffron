// Saffron LLVM Compiler — entry point
// Usage (on VM): saffron --no-check src/compiler/main.sf <input.sf> [output.ll]
// Usage (native): saffronc [--no-check] <input.sf> [output.ll]
// Type checking is enabled by default; --no-check disables it.

import "os" as OS
import "./lexer.sf" as Lexer
import "./parser.sf" as Parser
import "./checker.sf" as Checker
import "./resolve.sf" as Resolve
import "./codegen.sf" as Codegen

@extern("void exit(i32)")
fun c_exit(code: Int) {}
fun dir_of(path: String): String {
    var last_slash: Float = -1
    var i: Float = 0
    while (i < path.length()) {
        if (path.char_at(i) == "/") {
            last_slash = i
        }
        i = i + 1
    }
    if (last_slash < 0) { return "." }
    return path.slice(0, last_slash)
}

var _lib_paths: List<String> = []

fun _find_in_lib_paths(name: String, stdlib_dir: String): String {
    // 1. Check stdlib: <stdlib>/<name>.sf
    var stdlib_file: String = stdlib_dir + "/" + name + ".sf"
    if (OS.file_exists(stdlib_file)) {
        return stdlib_file
    }

    // 2. Search each --lib-path
    var i: Float = 0
    while (i < _lib_paths.length()) {
        var lib_dir: String = _lib_paths[i]

        // <lib_dir>/<name>.sf
        var single_file: String = lib_dir + "/" + name + ".sf"
        if (OS.file_exists(single_file)) {
            return single_file
        }

        // <lib_dir>/<name>/pantry.toml → read entry
        var pkg_manifest: String = lib_dir + "/" + name + "/pantry.toml"
        if (OS.file_exists(pkg_manifest)) {
            var entry: String = _extract_entry_from_toml(IO.read_file(pkg_manifest))
            return lib_dir + "/" + name + "/" + entry
        }

        // <lib_dir>/<name>/src/lib.sf (convention)
        var convention: String = lib_dir + "/" + name + "/src/lib.sf"
        if (OS.file_exists(convention)) {
            return convention
        }

        i = i + 1
    }

    return stdlib_dir + "/" + name + ".sf"
}

fun _find_submodule_in_lib_paths(pkg_name: String, sub_path: String, stdlib_dir: String): String {
    // Search lib paths for: <lib_dir>/<pkg_name>/src/<sub_path>.sf
    var i: Float = 0
    while (i < _lib_paths.length()) {
        var lib_dir: String = _lib_paths[i]

        var candidate: String = lib_dir + "/" + pkg_name + "/src/" + sub_path + ".sf"
        if (OS.file_exists(candidate)) {
            return candidate
        }

        // Also try without src/ prefix
        var candidate2: String = lib_dir + "/" + pkg_name + "/" + sub_path + ".sf"
        if (OS.file_exists(candidate2)) {
            return candidate2
        }

        i = i + 1
    }

    // Fallback
    return stdlib_dir + "/" + pkg_name + "/" + sub_path + ".sf"
}

fun _extract_entry_from_toml(source: String): String {
    var lines: List<String> = source.split("\n")
    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i].trim()
        if (line.starts_with("entry")) {
            var eq_idx: Float = line.index_of("=")
            if (eq_idx >= 0) {
                var value: String = line.slice(eq_idx + 1, line.length()).trim()
                if (value.starts_with("\"") and value.ends_with("\"")) {
                    return value.slice(1, value.length() - 1)
                }
            }
        }
        i = i + 1
    }
    return "src/lib.sf"
}

fun resolve_import_path(base_path: String, import_path: String, stdlib_dir: String): String {
    if (import_path.starts_with("@")) {
        var name: String = import_path.slice(1, import_path.length())
        return _find_in_lib_paths(name, stdlib_dir)
    }
    if (import_path.starts_with("./")) {
        var dir: String = dir_of(base_path)
        return dir + "/" + import_path.slice(2, import_path.length())
    }
    if (import_path.starts_with("../")) {
        var dir: String = dir_of(base_path)
        var parent: String = dir_of(dir)
        return parent + "/" + import_path.slice(3, import_path.length())
    }
    // Bare import with slash: "turmeric/signal" → package submodule
    if (import_path.contains("/")) {
        var slash_idx: Float = import_path.index_of("/")
        var pkg_name: String = import_path.slice(0, slash_idx)
        var sub_path: String = import_path.slice(slash_idx + 1, import_path.length())
        return _find_submodule_in_lib_paths(pkg_name, sub_path, stdlib_dir)
    }
    // Bare import without slash: "turmeric" → search lib paths
    return _find_in_lib_paths(import_path, stdlib_dir)
}

fun get_stmt_doc(stmt: AST.Stmt): String {
    return match (stmt) {
        VarDecl(n, t, init, d) => d
        FunDecl(n, p, r, b, d) => d
        _ => ""
    }
}

fun get_stmt_name(stmt: AST.Stmt): String {
    return match (stmt) {
        VarDecl(n, t, init, d) => n
        FunDecl(n, p, r, b, d) => n
        _ => ""
    }
}

fun is_import_stmt(stmt: AST.Stmt): Bool {
    var doc: String = get_stmt_doc(stmt)
    if (doc.starts_with("@import:")) { return true }
    var name: String = get_stmt_name(stmt)
    if (name.starts_with("_import_")) { return true }
    return false
}

fun extract_imports_from_ast(program: List<AST.Stmt>): List<String> {
    var imports: List<String> = []
    var i: Float = 0
    while (i < program.length()) {
        var doc: String = get_stmt_doc(program[i])
        if (doc.starts_with("@import:")) {
            var info: String = doc.slice(8, doc.length())
            var pipe_idx: Float = info.index_of("|")
            if (pipe_idx >= 0) {
                var path: String = info.slice(0, pipe_idx)
                if (path.starts_with("./") or path.starts_with("../") or path.starts_with("@")) {
                    imports.push(path)
                }
            }
        }
        i = i + 1
    }
    return imports
}

fun extract_aliases_from_ast(program: List<AST.Stmt>): Map<String, String> {
    var aliases: Map<String, String> = {}
    var i: Float = 0
    while (i < program.length()) {
        var doc: String = get_stmt_doc(program[i])
        if (doc.starts_with("@import:")) {
            var info: String = doc.slice(8, doc.length())
            var pipe_idx: Float = info.index_of("|")
            if (pipe_idx >= 0) {
                var path: String = info.slice(0, pipe_idx)
                var meta: String = info.slice(pipe_idx + 1, info.length())
                if (meta.starts_with("as:")) {
                    var alias: String = meta.slice(3, meta.length())
                    if (alias.length() > 0) {
                        aliases.set(alias, path)
                    }
                }
            }
        }
        i = i + 1
    }
    return aliases
}

fun extract_named_imports_from_ast(program: List<AST.Stmt>): Map<String, String> {
    var named: Map<String, String> = {}
    var i: Float = 0
    while (i < program.length()) {
        var doc: String = get_stmt_doc(program[i])
        if (doc.starts_with("@import:")) {
            var info: String = doc.slice(8, doc.length())
            var pipe_idx: Float = info.index_of("|")
            if (pipe_idx >= 0) {
                var path: String = info.slice(0, pipe_idx)
                var meta: String = info.slice(pipe_idx + 1, info.length())
                if (meta.starts_with("names:")) {
                    var names_str: String = meta.slice(6, meta.length())
                    named.set(path, names_str)
                }
            }
        }
        i = i + 1
    }
    return named
}

fun extract_imports(source: String): List<String> {
    var imports: List<String> = []
    var lines: List<String> = source.split("\n")
    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i]
        if (line.starts_with("import \"")) {
            var start: Float = 8
            var end: Float = start + 1
            while (end < line.length()) {
                if (line.char_at(end) == "\"") {
                    var imp_path: String = line.slice(start, end)
                    if (!is_builtin_module(imp_path)) {
                        imports.push(imp_path)
                    }
                    end = line.length()
                }
                end = end + 1
            }
        }
        // Named imports: import { X, Y } from "path"
        if (line.starts_with("import {")) {
            var from_idx: Float = line.index_of("from ")
            if (from_idx >= 0) {
                var path_start: Float = from_idx + 6
                var path_end: Float = path_start + 1
                while (path_end < line.length()) {
                    if (line.char_at(path_end) == "\"") {
                        break
                    }
                    path_end = path_end + 1
                }
                var imp_path: String = line.slice(path_start, path_end)
                if (!is_builtin_module(imp_path)) {
                    imports.push(imp_path)
                }
            }
        }
        i = i + 1
    }
    return imports
}

fun extract_named_imports(source: String): Map<String, List<String>> {
    var result: Map<String, List<String>> = {}
    var lines: List<String> = source.split("\n")
    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i]
        if (line.starts_with("import {")) {
            // Extract names between { and }
            var brace_start: Float = line.index_of("{")
            var brace_end: Float = line.index_of("}")
            if (brace_start >= 0 and brace_end > brace_start) {
                var names_str: String = line.slice(brace_start + 1, brace_end)
                var names: List<String> = names_str.split(",")
                // Extract path after "from"
                var from_idx: Float = line.index_of("from ")
                if (from_idx >= 0) {
                    var path_start: Float = from_idx + 6
                    var path_end: Float = path_start + 1
                    while (path_end < line.length()) {
                        if (line.char_at(path_end) == "\"") {
                            break
                        }
                        path_end = path_end + 1
                    }
                    var imp_path: String = line.slice(path_start, path_end)
                    // Trim each name and collect
                    var trimmed_names: List<String> = []
                    var ni: Float = 0
                    while (ni < names.length()) {
                        var name: String = names[ni].trim()
                        if (name.length() > 0) {
                            trimmed_names.push(name)
                        }
                        ni = ni + 1
                    }
                    if (trimmed_names.length() > 0) {
                        result.set(imp_path, trimmed_names)
                    }
                }
            }
        }
        i = i + 1
    }
    return result
}

fun extract_import_aliases(source: String): Map<String, String> {
    var aliases: Map<String, String> = {}
    var lines: List<String> = source.split("\n")
    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i]
        if (line.starts_with("import \"")) {
            var path_start: Float = 8
            var path_end: Float = path_start + 1
            while (path_end < line.length()) {
                if (line.char_at(path_end) == "\"") {
                    path_end = path_end
                    break
                }
                path_end = path_end + 1
            }
            var imp_path: String = line.slice(path_start, path_end)
            var as_idx: Float = line.index_of(" as ")
            if (as_idx >= 0) {
                var alias: String = line.slice(as_idx + 4, line.length()).trim()
                aliases.set(alias, imp_path)
            }
        }
        i = i + 1
    }
    return aliases
}

fun module_prefix_from_path(imp_path: String): String {
    var name: String = imp_path
    if (name.starts_with("@")) {
        name = name.slice(1, name.length())
    }
    // Extract basename (last component after /)
    var slash_idx: Float = -1
    var j: Float = 0
    while (j < name.length()) {
        if (name.char_at(j) == "/") { slash_idx = j }
        j = j + 1
    }
    if (slash_idx >= 0) {
        name = name.slice(slash_idx + 1, name.length())
    }
    if (name.ends_with(".sf")) {
        name = name.slice(0, name.length() - 3)
    }
    return name + "_"
}

fun path_based_prefix(imp_path: String, full_path: String, stdlib_dir: String): String {
    // Generate a stable, path-based prefix that uniquely identifies a module
    // regardless of what alias the user gives it.
    //
    // Rules:
    //   @name        → stdlib_name_
    //   ./path/file  → path components joined with _ (relative to project)
    //   pkg/module   → pkg_module_
    //
    // The full_path is the resolved absolute path. We derive prefix from imp_path
    // structure when possible (more readable), falling back to full_path components.

    if (imp_path.starts_with("@")) {
        // stdlib module: @iter → stdlib_iter_
        var name: String = imp_path.slice(1, imp_path.length())
        if (name.ends_with(".sf")) {
            name = name.slice(0, name.length() - 3)
        }
        // Replace / with _ for sub-paths like @foo/bar
        var result: StringBuilder = StringBuilder()
        result.append("stdlib_")
        var i: Float = 0
        while (i < name.length()) {
            var ch: String = name.char_at(i)
            if (ch == "/") { result.append("_") }
            else if (ch == "-") { result.append("_") }
            else { result.append(ch) }
            i = i + 1
        }
        result.append("_")
        return result.to_string()
    }

    // For relative/package imports, use the import path components
    var name: String = imp_path
    // Strip leading ./ or ../
    if (name.starts_with("./")) {
        name = name.slice(2, name.length())
    }
    if (name.starts_with("../")) {
        name = name.slice(3, name.length())
    }
    // Strip .sf extension
    if (name.ends_with(".sf")) {
        name = name.slice(0, name.length() - 3)
    }
    // Replace / and - with _
    var result: StringBuilder = StringBuilder()
    var i: Float = 0
    while (i < name.length()) {
        var ch: String = name.char_at(i)
        if (ch == "/") { result.append("_") }
        else if (ch == "-") { result.append("_") }
        else if (ch == ".") { result.append("_") }
        else { result.append(ch) }
        i = i + 1
    }
    result.append("_")
    return result.to_string()
}

fun check_duplicate_aliases(source: String, file_path: String) {
    // Scan source for duplicate import aliases in the same file.
    // extract_import_aliases uses a Map which deduplicates, so we must
    // check the raw text to catch duplicates.
    var lines: List<String> = source.split("\n")
    var seen: Map<String, Bool> = {}
    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i]
        if (line.starts_with("import \"")) {
            var as_idx: Float = line.index_of(" as ")
            if (as_idx >= 0) {
                var alias: String = line.slice(as_idx + 4, line.length()).trim()
                if (seen.has(alias)) {
                    IO.println("Error: duplicate import alias '" + alias + "' in " + file_path)
                    c_exit(1)
                }
                seen.set(alias, true)
            }
        }
        i = i + 1
    }
}

fun is_builtin_module(imp_path: String): Bool {
    if (imp_path == "@os") { return true }
    if (imp_path == "os") { return true }
    return false
}

fun _is_package_entry(imp_path: String, stdlib_dir: String): Bool {
    // Check if a bare import resolves to a package entry via pantry.toml
    if (imp_path.starts_with("./") or imp_path.starts_with("../") or imp_path.starts_with("@")) {
        return false
    }
    if (imp_path.contains("/")) { return false }
    var i: Float = 0
    while (i < _lib_paths.length()) {
        var lib_dir: String = _lib_paths[i]
        var pkg_manifest: String = lib_dir + "/" + imp_path + "/pantry.toml"
        if (OS.file_exists(pkg_manifest)) { return true }
        i = i + 1
    }
    return false
}

fun _build_package_exports(alias: String, entry_path: String, imp_path: String, stdlib_dir: String, path_to_prefix: Map<String, String>): Map<String, String> {
    // Read the package entry file and extract its named imports.
    // For each re-exported name, compute the actual sub-module prefix.
    // Returns a map: "Alias.name" → "sub_module_prefix_name"
    var exports: Map<String, String> = {}
    var entry_source: String = IO.read_file(entry_path)
    var entry_dir: String = dir_of(entry_path)

    // Extract named imports from entry file: import { X, Y } from "./sub.sf"
    var entry_named: Map<String, List<String>> = extract_named_imports(entry_source)
    var en_paths: List<String> = entry_named.keys()
    var eni: Float = 0
    while (eni < en_paths.length()) {
        var sub_imp_path: String = en_paths[eni]
        var sub_full_path: String = resolve_import_path(entry_path, sub_imp_path, stdlib_dir)
        // Compute the prefix for this sub-module
        var sub_prefix: String = ""
        if (path_to_prefix.has(sub_full_path)) {
            sub_prefix = path_to_prefix.get(sub_full_path)
        } else {
            sub_prefix = path_based_prefix(sub_imp_path, sub_full_path, stdlib_dir)
            path_to_prefix.set(sub_full_path, sub_prefix)
        }
        // Map each re-exported name
        var names: List<String> = entry_named.get(sub_imp_path)
        var ni: Float = 0
        while (ni < names.length()) {
            var name: String = names[ni]
            // "Alias.name" → "sub_prefix + name"
            exports.set(alias + "." + name, sub_prefix + name)
            // Also map bare name for "import { name } from pkg"
            exports.set(name, sub_prefix + name)
            ni = ni + 1
        }
        eni = eni + 1
    }

    // Also check aliased imports in the entry: import "./router.sf" as Router
    // The convention is that all top-level functions/classes in those modules
    // are re-exported. We scan each sub-module for its exports.
    var entry_aliases: Map<String, String> = extract_import_aliases(entry_source)
    var ea_keys: List<String> = entry_aliases.keys()
    var eai: Float = 0
    while (eai < ea_keys.length()) {
        var ea_alias: String = ea_keys[eai]
        var ea_path: String = entry_aliases.get(ea_alias)
        if (!is_builtin_module(ea_path)) {
            var ea_full: String = resolve_import_path(entry_path, ea_path, stdlib_dir)
            var ea_prefix: String = ""
            if (path_to_prefix.has(ea_full)) {
                ea_prefix = path_to_prefix.get(ea_full)
            } else {
                ea_prefix = path_based_prefix(ea_path, ea_full, stdlib_dir)
                path_to_prefix.set(ea_full, ea_prefix)
            }
            // Read the sub-module to find its top-level declarations
            if (OS.file_exists(ea_full)) {
                var sub_source: String = IO.read_file(ea_full)
                var sub_tokens: List = Lexer.lex(sub_source)
                var sub_program: List = Parser.parse_with_source(sub_tokens, sub_source)
                var spi: Float = 0
                while (spi < sub_program.length()) {
                    var sp_name: String = get_stmt_name(sub_program[spi])
                    if (sp_name.length() > 0 and !is_import_stmt(sub_program[spi])) {
                        exports.set(alias + "." + sp_name, ea_prefix + sp_name)
                        exports.set(sp_name, ea_prefix + sp_name)
                    }
                    spi = spi + 1
                }
            }
        }
        eai = eai + 1
    }

    return exports
}

fun collect_modules(file_path: String, stdlib_dir: String, visited: Map<String, Bool>, module_stmts: List<List<AST.Stmt>>, module_prefixes_list: List<String>, all_aliases: Map<String, String>, path_to_prefix: Map<String, String>) {
    if (visited.has(file_path)) { return }
    visited.set(file_path, true)

    var source: String = IO.read_file(file_path)
    var tokens: List = Lexer.lex(source)
    var program: List = Parser.parse_with_source(tokens, source)

    // Collect this module's import aliases from text (robust)
    // Detect duplicate aliases within this file
    check_duplicate_aliases(source, file_path)
    var mod_aliases: Map<String, String> = extract_import_aliases(source)
    var mak: List<String> = mod_aliases.keys()
    var mai: Float = 0
    while (mai < mak.length()) {
        var ma: String = mak[mai]
        var ma_path: String = mod_aliases.get(ma)
        if (!is_builtin_module(ma_path)) {
            var ma_full: String = resolve_import_path(file_path, ma_path, stdlib_dir)
            // Use path-based prefix for the LLVM symbol name
            var ma_prefix: String = ""
            if (path_to_prefix.has(ma_full)) {
                ma_prefix = path_to_prefix.get(ma_full)
            } else {
                ma_prefix = path_based_prefix(ma_path, ma_full, stdlib_dir)
                path_to_prefix.set(ma_full, ma_prefix)
            }
            // Map alias → path-based prefix (alias is just source-level sugar)
            if (!all_aliases.has(ma)) {
                all_aliases.set(ma, ma_prefix)
            }
        }
        mai = mai + 1
    }

    var import_paths: List<String> = extract_imports(source)
    var pi: Float = 0
    while (pi < import_paths.length()) {
        var imp_path: String = import_paths[pi]
        if (!is_builtin_module(imp_path)) {
            var full_path: String = resolve_import_path(file_path, imp_path, stdlib_dir)
            // Ensure path_to_prefix is populated before recursing
            if (!path_to_prefix.has(full_path)) {
                path_to_prefix.set(full_path, path_based_prefix(imp_path, full_path, stdlib_dir))
            }
            collect_modules(full_path, stdlib_dir, visited, module_stmts, module_prefixes_list, all_aliases, path_to_prefix)
        }
        pi = pi + 1
    }

    // Use path-based prefix from path_to_prefix (always populated by caller)
    var prefix: String = ""
    if (path_to_prefix.has(file_path)) {
        prefix = path_to_prefix.get(file_path)
    } else {
        prefix = module_prefix_from_file(file_path)
    }
    module_stmts.push(program)
    module_prefixes_list.push(prefix)
}

fun module_prefix_from_file(file_path: String): String {
    var name: String = file_path
    var slash_idx: Float = -1
    var j: Float = 0
    while (j < name.length()) {
        if (name.char_at(j) == "/") { slash_idx = j }
        j = j + 1
    }
    if (slash_idx >= 0) {
        name = name.slice(slash_idx + 1, name.length())
    }
    if (name.ends_with(".sf")) {
        name = name.slice(0, name.length() - 3)
    }
    return name + "_"
}

fun main(): Int {
    var args: List<String> = OS.args()

    // Parse flags
    var run_checker: Bool = true
    var stdlib_dir: String = ""
    var target: String = "native"
    var identity_mode: Bool = false
    var use_llvm_lib: Bool = true
    var emit_llvm_lib: Bool = false
    // Stage 2 of docs/design/compiler-rewrite.md. On by default; --no-resolve
    // turns it off so a suspected regression can be attributed to the pass
    // itself rather than to whatever else changed.
    var run_resolve: Bool = true
    var lib_path_args: List<String> = []
    var i: Float = 0
    while (i < args.length()) {
        var arg: String = args[i]
        if (arg == "--no-check") {
            run_checker = false
        }
        if (arg == "--no-resolve") {
            run_resolve = false
        }
        if (arg == "--check") {
            run_checker = true
        }
        if (arg == "--identity-mode") {
            identity_mode = true
        }
        if (arg == "--no-llvm-lib") {
            use_llvm_lib = false
        }
        if (arg == "--emit-llvm-lib") {
            emit_llvm_lib = true
        }
        if (arg == "--stdlib") {
            if (i + 1 < args.length()) {
                i = i + 1
                stdlib_dir = args[i]
            }
        }
        if (arg == "--lib-path") {
            if (i + 1 < args.length()) {
                i = i + 1
                lib_path_args.push(args[i])
            }
        }
        if (arg == "--target") {
            if (i + 1 < args.length()) {
                i = i + 1
                target = args[i]
            }
        }
        i = i + 1
    }
    // Also read SAFFRON_LIB_PATH env var (colon-separated, like PATH)
    var env_lib_path: String = OS.env("SAFFRON_LIB_PATH")
    if (env_lib_path.length() > 0) {
        var env_parts: List<String> = env_lib_path.split(":")
        var epi: Float = 0
        while (epi < env_parts.length()) {
            if (env_parts[epi].length() > 0) {
                lib_path_args.push(env_parts[epi])
            }
            epi = epi + 1
        }
    }
    _lib_paths = lib_path_args

    // Find the last .sf arg (input) and anything after it (output)
    var last_sf_idx: Float = -1
    i = 0
    while (i < args.length()) {
        var arg: String = args[i]
        if (arg.contains(".sf") and arg != "--stdlib") {
            last_sf_idx = i
        }
        i = i + 1
    }

    if (last_sf_idx < 0) {
        IO.println("Usage: saffronc [--check] [--stdlib <path>] [--lib-path <path>]... <input.sf> [output.ll]")
        return 1
    }

    var input_path: String = args[last_sf_idx]
    var output_path: String = input_path + ".ll"
    if (args.length() > last_sf_idx + 1) {
        var next_arg: String = args[last_sf_idx + 1]
        if (!next_arg.starts_with("--")) {
            output_path = next_arg
        }
    }

    // Determine stdlib directory
    if (stdlib_dir.length() == 0) {
        // Native mode: args[0] is the executable path
        var exe_path: String = args[0]
        var exe_dir: String = dir_of(exe_path)
        stdlib_dir = exe_dir + "/../src/lib"
    }

    // Lex and parse the main file
    var source: String = IO.read_file(input_path)
    var tokens: List = Lexer.lex(source)
    var program: List = Parser.parse_with_source(tokens, source)

    if (Parser.had_error()) {
        c_exit(1)
    }

    // Use text-based import extraction (robust — doesn't depend on AST field access)
    // Map alias names to path-based prefixes for LLVM symbol uniqueness.
    // The alias is SOURCE-level sugar; the LLVM prefix is derived from the module path.
    var resolved_aliases: Map<String, String> = {}
    var path_to_prefix: Map<String, String> = {}
    var alias_map: Map<String, String> = extract_import_aliases(source)
    var alias_keys: List<String> = alias_map.keys()

    // Duplicate alias detection: check for same alias used twice in one file
    check_duplicate_aliases(source, input_path)

    var ak: Float = 0
    while (ak < alias_keys.length()) {
        var alias: String = alias_keys[ak]
        var imp_path: String = alias_map.get(alias)
        if (!is_builtin_module(imp_path)) {
            var full_imp_path: String = resolve_import_path(input_path, imp_path, stdlib_dir)
            // Compute stable path-based prefix
            var pprefix: String = ""
            if (path_to_prefix.has(full_imp_path)) {
                pprefix = path_to_prefix.get(full_imp_path)
            } else {
                pprefix = path_based_prefix(imp_path, full_imp_path, stdlib_dir)
                path_to_prefix.set(full_imp_path, pprefix)
            }
            resolved_aliases.set(alias, pprefix)
        }
        ak = ak + 1
    }

    // Build package exports for package imports (import "pkg" as Alias).
    // When the entry file re-exports names from sub-modules, we need to map
    // "Alias.name" to the actual sub-module's prefixed function name.
    var package_exports: Map<String, String> = {}
    ak = 0
    while (ak < alias_keys.length()) {
        var pkg_alias: String = alias_keys[ak]
        var pkg_imp_path: String = alias_map.get(pkg_alias)
        if (!is_builtin_module(pkg_imp_path) and _is_package_entry(pkg_imp_path, stdlib_dir)) {
            var pkg_full_path: String = resolve_import_path(input_path, pkg_imp_path, stdlib_dir)
            var pkg_exp: Map<String, String> = _build_package_exports(pkg_alias, pkg_full_path, pkg_imp_path, stdlib_dir, path_to_prefix)
            var pkg_exp_keys: List<String> = pkg_exp.keys()
            var pei: Float = 0
            while (pei < pkg_exp_keys.length()) {
                var pe_key: String = pkg_exp_keys[pei]
                package_exports.set(pe_key, pkg_exp.get(pe_key))
                pei = pei + 1
            }
        }
        ak = ak + 1
    }

    // Register named import module paths so they get correct prefixes
    var named_imports_raw_early: Map<String, List<String>> = extract_named_imports(source)
    var ni_paths_early: List<String> = named_imports_raw_early.keys()
    var npe: Float = 0
    while (npe < ni_paths_early.length()) {
        var ni_path_e: String = ni_paths_early[npe]
        if (!is_builtin_module(ni_path_e)) {
            var ni_full_e: String = resolve_import_path(input_path, ni_path_e, stdlib_dir)
            if (!path_to_prefix.has(ni_full_e)) {
                path_to_prefix.set(ni_full_e, path_based_prefix(ni_path_e, ni_full_e, stdlib_dir))
            }
        }
        npe = npe + 1
    }

    // Also resolve named imports from packages: import { router } from "parsley"
    // needs to map "router" → actual sub-module prefix (not the entry file's prefix).
    var ni_pkg_paths: List<String> = named_imports_raw_early.keys()
    var nppi: Float = 0
    while (nppi < ni_pkg_paths.length()) {
        var npkg_path: String = ni_pkg_paths[nppi]
        if (!is_builtin_module(npkg_path) and _is_package_entry(npkg_path, stdlib_dir)) {
            var npkg_full: String = resolve_import_path(input_path, npkg_path, stdlib_dir)
            // Use a dummy alias to get bare-name exports
            var npkg_exp: Map<String, String> = _build_package_exports("__dummy", npkg_full, npkg_path, stdlib_dir, path_to_prefix)
            var npkg_names: List<String> = named_imports_raw_early.get(npkg_path)
            var npni: Float = 0
            while (npni < npkg_names.length()) {
                var npn: String = npkg_names[npni]
                // Check if package_exports has a mapping for this bare name
                if (npkg_exp.has(npn)) {
                    package_exports.set(npn, npkg_exp.get(npn))
                }
                npni = npni + 1
            }
        }
        nppi = nppi + 1
    }

    // Auto-import prelude (interfaces available in all programs)
    var prelude_path: String = stdlib_dir + "/prelude.sf"
    var visited: Map<String, Bool> = {}
    var module_stmts: List<List<AST.Stmt>> = []
    var module_prefixes_list: List<String> = []
    if (OS.file_exists(prelude_path)) {
        var prelude_src: String = IO.read_file(prelude_path)
        var prelude_tokens: List = Lexer.lex(prelude_src)
        var prelude_program: List = Parser.parse_with_source(prelude_tokens, prelude_src)
        module_stmts.push(prelude_program)
        module_prefixes_list.push("")
        visited.set(prelude_path, true)
    }

    // Auto-import dependency preludes (src/prelude.sf in each lib-path package)
    // Look for prelude files in each lib path directory
    var lpi: Float = 0
    while (lpi < _lib_paths.length()) {
        var lib_dir: String = _lib_paths[lpi]
        // Check for known preludes by import analysis
        // Dependencies that provide src/prelude.sf get auto-imported
        var dep_imports: List<String> = extract_imports(source)
        var di: Float = 0
        while (di < dep_imports.length()) {
            var dep_path: String = dep_imports[di]
            if (!dep_path.starts_with("./") and !dep_path.starts_with("@")) {
                // Bare package name like "turmeric/signal" → package is "turmeric"
                var pkg_name: String = dep_path
                var slash: Float = dep_path.index_of("/")
                if (slash > 0) {
                    pkg_name = dep_path.slice(0, slash)
                }
                var pkg_prelude: String = lib_dir + "/" + pkg_name + "/src/prelude.sf"
                if (OS.file_exists(pkg_prelude) and !visited.has(pkg_prelude)) {
                    var dep_src: String = IO.read_file(pkg_prelude)
                    var dep_tokens: List = Lexer.lex(dep_src)
                    var dep_program: List = Parser.parse_with_source(dep_tokens, dep_src)
                    var dep_prefix: String = pkg_name + "_prelude_"
                    module_stmts.push(dep_program)
                    module_prefixes_list.push(dep_prefix)
                    visited.set(pkg_prelude, true)

                    // A dependency prelude is a normal module: it may import
                    // other modules of its own package. Register its aliases
                    // and pull in what it imports, exactly as collect_modules
                    // does for an ordinary import. Without this, an alias used
                    // in the prelude is an undefined variable at codegen, which
                    // is why turmeric's prelude hand-wrote mangled symbols
                    // (turmeric_signal_effect) instead of importing signal.sf.
                    var dp_aliases: Map<String, String> = extract_import_aliases(dep_src)
                    var dp_keys: List<String> = dp_aliases.keys()
                    var dpi: Float = 0
                    while (dpi < dp_keys.length()) {
                        var dp_alias: String = dp_keys[dpi]
                        var dp_path: String = dp_aliases.get(dp_alias)
                        if (!is_builtin_module(dp_path)) {
                            var dp_full: String = resolve_import_path(pkg_prelude, dp_path, stdlib_dir)
                            if (!path_to_prefix.has(dp_full)) {
                                path_to_prefix.set(dp_full, path_based_prefix(dp_path, dp_full, stdlib_dir))
                            }
                            if (!resolved_aliases.has(dp_alias)) {
                                resolved_aliases.set(dp_alias, path_to_prefix.get(dp_full))
                            }
                        }
                        dpi = dpi + 1
                    }

                    var dp_imports: List<String> = extract_imports(dep_src)
                    var dpj: Float = 0
                    while (dpj < dp_imports.length()) {
                        var dp_imp: String = dp_imports[dpj]
                        if (!is_builtin_module(dp_imp)) {
                            var dp_imp_full: String = resolve_import_path(pkg_prelude, dp_imp, stdlib_dir)
                            if (!path_to_prefix.has(dp_imp_full)) {
                                path_to_prefix.set(dp_imp_full, path_based_prefix(dp_imp, dp_imp_full, stdlib_dir))
                            }
                            collect_modules(dp_imp_full, stdlib_dir, visited, module_stmts, module_prefixes_list, resolved_aliases, path_to_prefix)
                        }
                        dpj = dpj + 1
                    }
                }
            }
            di = di + 1
        }
        lpi = lpi + 1
    }

    // Recursively collect modules (text-based extraction)
    var import_paths: List<String> = extract_imports(source)
    var pi: Float = 0
    while (pi < import_paths.length()) {
        var imp_path: String = import_paths[pi]
        if (!is_builtin_module(imp_path)) {
            var full_path: String = resolve_import_path(input_path, imp_path, stdlib_dir)
            // Ensure path_to_prefix is populated before recursing
            if (!path_to_prefix.has(full_path)) {
                path_to_prefix.set(full_path, path_based_prefix(imp_path, full_path, stdlib_dir))
            }
            collect_modules(full_path, stdlib_dir, visited, module_stmts, module_prefixes_list, resolved_aliases, path_to_prefix)
        }
        pi = pi + 1
    }

    if (Parser.had_error()) {
        c_exit(1)
    }

    // Flatten module_stmts into a single list with boundary markers
    // Encode prefixes as a single joined string to avoid native list issues
    var all_import_stmts: List<AST.Stmt> = []
    var module_boundaries: List<Float> = []
    var prefixes_joined: String = ""
    var mfi: Float = 0
    while (mfi < module_stmts.length()) {
        var mod: List<AST.Stmt> = module_stmts[mfi]
        module_boundaries.push(all_import_stmts.length())
        if (mfi > 0) { prefixes_joined = prefixes_joined + "|" }
        prefixes_joined = prefixes_joined + module_prefixes_list[mfi]
        var msi: Float = 0
        while (msi < mod.length()) {
            all_import_stmts.push(mod[msi])
            msi = msi + 1
        }
        mfi = mfi + 1
    }
    module_boundaries.push(all_import_stmts.length())

    // Build named imports map: bare_name → prefixed_name
    var named_imports_raw: Map<String, List<String>> = extract_named_imports(source)
    var named_imports: Map<String, String> = {}
    var ni_paths: List<String> = named_imports_raw.keys()
    var npi: Float = 0
    while (npi < ni_paths.length()) {
        var ni_path: String = ni_paths[npi]
        var ni_full_path: String = resolve_import_path(input_path, ni_path, stdlib_dir)
        // Determine prefix for this module
        var ni_prefix: String = ""
        if (path_to_prefix.has(ni_full_path)) {
            ni_prefix = path_to_prefix.get(ni_full_path)
        } else {
            ni_prefix = path_based_prefix(ni_path, ni_full_path, stdlib_dir)
        }
        var ni_names: List<String> = named_imports_raw.get(ni_path)
        var nni: Float = 0
        while (nni < ni_names.length()) {
            var ni_name: String = ni_names[nni]
            // Package exports override: if the bare name has a package-resolved target, use it
            if (package_exports.has(ni_name)) {
                named_imports.set(ni_name, package_exports.get(ni_name))
            } else {
                named_imports.set(ni_name, ni_prefix + ni_name)
            }
            nni = nni + 1
        }
        npi = npi + 1
    }

    // Also collect named imports from sub-modules so cross-module bare
    // references (e.g. api.sf importing { mutation } from "basil/mutation") resolve.
    var visited_keys: List<String> = visited.keys()
    var vki: Float = 0
    while (vki < visited_keys.length()) {
        var vk_path: String = visited_keys[vki]
        if (OS.file_exists(vk_path)) {
            var vk_src: String = IO.read_file(vk_path)
            var vk_ni_raw: Map<String, List<String>> = extract_named_imports(vk_src)
            var vk_ni_paths: List<String> = vk_ni_raw.keys()
            var vk_npi: Float = 0
            while (vk_npi < vk_ni_paths.length()) {
                var vk_ni_path: String = vk_ni_paths[vk_npi]
                if (!is_builtin_module(vk_ni_path)) {
                    var vk_ni_full: String = resolve_import_path(vk_path, vk_ni_path, stdlib_dir)
                    var vk_ni_prefix: String = ""
                    if (path_to_prefix.has(vk_ni_full)) {
                        vk_ni_prefix = path_to_prefix.get(vk_ni_full)
                    } else {
                        vk_ni_prefix = path_based_prefix(vk_ni_path, vk_ni_full, stdlib_dir)
                    }
                    var vk_names: List<String> = vk_ni_raw.get(vk_ni_path)
                    var vk_nni: Float = 0
                    while (vk_nni < vk_names.length()) {
                        var vk_name: String = vk_names[vk_nni]
                        if (!named_imports.has(vk_name)) {
                            if (package_exports.has(vk_name)) {
                                named_imports.set(vk_name, package_exports.get(vk_name))
                            } else {
                                named_imports.set(vk_name, vk_ni_prefix + vk_name)
                            }
                        }
                        vk_nni = vk_nni + 1
                    }
                }
                vk_npi = vk_npi + 1
            }
        }
        vki = vki + 1
    }

    // Merge package exports (dotted keys like "Parsley.router") into named_imports
    // so the codegen can resolve module-qualified calls via the same map.
    var pe_keys: List<String> = package_exports.keys()
    var peki: Float = 0
    while (peki < pe_keys.length()) {
        var pe_key: String = pe_keys[peki]
        if (!named_imports.has(pe_key)) {
            named_imports.set(pe_key, package_exports.get(pe_key))
        }
        peki = peki + 1
    }

    // Resolve pass — every Variable(name) becomes a Ref(kind, name, slot), so
    // the checker and codegen read what a name denotes instead of re-deriving
    // it from side tables at each of a dozen sites (invariant I4 of
    // docs/design/compiler-rewrite.md; the re-derivation is BUGS #40).
    // Runs before the checker so both later passes see the same resolution.
    // Imported modules go through the same resolver as the main program: #40's
    // repro shadows math.sf's `sqrt(x)` parameter with a main-program global
    // `x`, so the two must be resolved together or the shadowing is missed.
    if (run_resolve) {
        var resolver: Resolve.Resolver = Resolve.new_resolver()
        if (all_import_stmts.length() > 0) {
            all_import_stmts = Resolve.resolve_imports(resolver, all_import_stmts, module_boundaries, prefixes_joined)
        }
        program = Resolve.resolve_main(resolver, program)
    }

    // Run type checker (blocking by default)
    if (run_checker) {
        var checker_errors: String = ""
        if (all_import_stmts.length() > 0) {
            checker_errors = Checker.check_errors_with_imports(program, all_import_stmts)
        } else {
            checker_errors = Checker.check_errors_only(program)
        }
        if (checker_errors.length() > 0) {
            IO.println(checker_errors)
            c_exit(1)
        }
    }

    var ir: String = ""
    if (all_import_stmts.length() > 0) {
        ir = Codegen.generate_with_modules_flat_opts3(program, all_import_stmts, module_boundaries, prefixes_joined, resolved_aliases, target, named_imports, identity_mode, use_llvm_lib, emit_llvm_lib)
    } else {
        ir = Codegen.generate_with_target_opts3(program, target, identity_mode, use_llvm_lib, emit_llvm_lib)
    }

    if (Codegen.had_error()) {
        IO.println("Compilation failed with codegen errors")
        c_exit(1)
    }

    // Write LLVM IR output
    IO.write_file(output_path, ir)

    return 0
}

main()
