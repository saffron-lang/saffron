// Saffron LLVM Compiler — entry point
// Usage (on VM): saffron --no-check src/compiler/main.sf <input.sf> [output.ll]
// Usage (native): saffronc [--check] <input.sf> [output.ll]

import "os" as OS
import "./lexer.sf" as Lexer
import "./parser.sf" as Parser
import "./checker.sf" as Checker
import "./codegen.sf" as Codegen

fun dir_of(path: String): String {
    var last_slash: Float = -1
    var i: Float = 0
    while (i < path.length()) {
        if (path.char_at(i) == "/") {
            last_slash = i
        }
        i = i + 1
    }
    if (last_slash < 0) { return "." }
    return path.slice(0, last_slash)
}

fun resolve_import_path(base_path: String, import_path: String, stdlib_dir: String): String {
    if (import_path.starts_with("@")) {
        var name: String = import_path.slice(1, import_path.length())
        return stdlib_dir + "/" + name + ".sf"
    }
    if (import_path.starts_with("./")) {
        var dir: String = dir_of(base_path)
        return dir + "/" + import_path.slice(2, import_path.length())
    }
    return import_path
}

fun extract_imports(source: String): List<String> {
    var imports: List<String> = []
    var lines: List<String> = source.split("\n")
    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i]
        if (line.starts_with("import \"./") or line.starts_with("import \"@")) {
            var start: Float = 8
            var end: Float = start + 1
            while (end < line.length()) {
                if (line.char_at(end) == "\"") {
                    imports.push(line.slice(start, end))
                    end = line.length()
                }
                end = end + 1
            }
        }
        i = i + 1
    }
    return imports
}

fun resolve_imports_recursive(file_path: String, stdlib_dir: String, visited: Map<String, Bool>): List<AST.Stmt> {
    if (visited.has(file_path)) { return [] }
    visited.set(file_path, true)

    var source: String = IO.read_file(file_path)
    var import_paths: List<String> = extract_imports(source)

    var all_decls: List<AST.Stmt> = []

    var pi: Float = 0
    while (pi < import_paths.length()) {
        var imp_path: String = import_paths[pi]
        var full_path: String = resolve_import_path(file_path, imp_path, stdlib_dir)
        var sub_decls: List<AST.Stmt> = resolve_imports_recursive(full_path, stdlib_dir, visited)
        var si: Float = 0
        while (si < sub_decls.length()) {
            all_decls.push(sub_decls[si])
            si = si + 1
        }
        pi = pi + 1
    }

    var tokens: List = Lexer.lex(source)
    var program: List = Parser.parse(tokens)
    var j: Float = 0
    while (j < program.length()) {
        all_decls.push(program[j])
        j = j + 1
    }

    return all_decls
}

fun main(): Int {
    var args: List<String> = OS.args()

    // Check for --check flag
    var run_checker: Bool = false
    var i: Float = 1
    while (i < args.length()) {
        var arg: String = args[i]
        if (arg == "--check") {
            run_checker = true
        }
        i = i + 1
    }

    // Find the last .sf arg (input) and anything after it (output)
    var last_sf_idx: Float = 0
    i = 1
    while (i < args.length()) {
        var arg: String = args[i]
        if (arg.contains(".sf")) {
            last_sf_idx = i
        }
        i = i + 1
    }

    if (last_sf_idx == 0) {
        IO.println("Usage: saffronc [--check] <input.sf> [output.ll]")
        return 1
    }

    var input_path: String = args[last_sf_idx]
    var output_path: String = input_path + ".ll"
    if (args.length() > last_sf_idx + 1) {
        output_path = args[last_sf_idx + 1]
    }

    // Determine stdlib directory from executable location
    var exe_path: String = args[0]
    var exe_dir: String = dir_of(exe_path)
    var stdlib_dir: String = exe_dir + "/../src/lib"

    // Recursively resolve all imports (including @module imports)
    var visited: Map<String, Bool> = {}
    var import_decls: List<AST.Stmt> = []
    var source: String = IO.read_file(input_path)
    var import_paths: List<String> = extract_imports(source)
    var pi: Float = 0
    while (pi < import_paths.length()) {
        var imp_path: String = import_paths[pi]
        var full_path: String = resolve_import_path(input_path, imp_path, stdlib_dir)
        var sub_decls: List<AST.Stmt> = resolve_imports_recursive(full_path, stdlib_dir, visited)
        var si: Float = 0
        while (si < sub_decls.length()) {
            import_decls.push(sub_decls[si])
            si = si + 1
        }
        pi = pi + 1
    }

    // Compile: lex → parse → [check] → generate (with import metadata)
    var tokens: List = Lexer.lex(source)
    var program: List = Parser.parse(tokens)

    // Optional type checking (with import context)
    if (run_checker) {
        var check_result: String = Checker.check_with_imports(program, import_decls)
        if (check_result.length() > 0) {
            IO.println(check_result)
        }
    }

    var ir: String = Codegen.generate_with_imports(program, import_decls)

    // Write LLVM IR output
    IO.write_file(output_path, ir)

    return 0
}

main()
