// Saffron LLVM Compiler — native entry point
// Usage: saffronc <input.sf> [output.ll]

import "./lexer.sf" as Lexer
import "./parser.sf" as Parser
import "./codegen.sf" as Codegen

fun main(): Int {
    var args = OS.args()

    if (args.length() < 2) {
        IO.println("Usage: saffronc <input.sf> [output.ll]")
        return 1
    }

    var input_path: String = args[1]
    var output_path: String = input_path + ".ll"
    if (args.length() >= 3) {
        output_path = args[2]
    }

    // Read source file
    var source: String = IO.read_file(input_path)

    // Compile: lex → parse → generate
    var tokens = Lexer.lex(source)
    var program = Parser.parse(tokens)
    var ir: String = Codegen.generate(program)

    // Write LLVM IR output
    IO.write_file(output_path, ir)
    IO.println("Compiled " + input_path + " -> " + output_path)

    return 0
}
