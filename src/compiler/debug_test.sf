import "./lexer.sf" as Lexer

var lex: Lexer.Lexer = Lexer.Lexer("if (true) { 1 }")
lex.scan_tokens()
var tokens: List<Lexer.Token> = lex.tokens

var i: Float = 0
while (i < tokens.length()) {
    var tok: Lexer.Token = tokens[i]
    var kind: Lexer.TokenKind = match (tok) { Token(kind, line, col) => kind }
    var line: Float = match (tok) { Token(kind, line, col) => line }
    var col: Float = match (tok) { Token(kind, line, col) => col }
    var name: String = match (kind) {
        TkPlus => "+"
        TkMinus => "-"
        TkStar => "*"
        TkSlash => "/"
        TkPercent => "%"
        TkAmpersand => "&"
        TkPipe => "|"
        TkCaret => "^"
        TkTilde => "~"
        TkShiftLeft => "<<"
        TkShiftRight => ">>"
        TkBang => "!"
        TkBangEq => "!="
        TkEqEq => "=="
        TkLt => "<"
        TkLtEq => "<="
        TkGt => ">"
        TkGtEq => ">="
        TkLParen => "("
        TkRParen => ")"
        TkLBrace => "{"
        TkRBrace => "}"
        TkLBracket => "["
        TkRBracket => "]"
        TkDot => "."
        TkComma => ","
        TkColon => ":"
        TkSemicolon => ";"
        TkEq => "="
        TkArrow => "->"
        TkFatArrow => "=>"
        TkVar => "var"
        TkLet => "let"
        TkFun => "fun"
        TkReturn => "return"
        TkIf => "if"
        TkElse => "else"
        TkWhile => "while"
        TkOr => "or"
        TkAnd => "and"
        TkTrue => "true"
        TkFalse => "false"
        TkNil => "nil"
        TkImport => "import"
        TkAs => "as"
        TkEnum => "enum"
        TkMatch => "match"
        TkClass => "class"
        TkThis => "this"
        TkFor => "for"
        TkIn => "in"
        TkTry => "try"
        TkCatch => "catch"
        TkThrow => "throw"
        TkFinally => "finally"
        TkIs => "is"
        TkEof => "eof"
        TkInt(v) => "int"
        TkFloat(v) => "float"
        TkString(v) => "string"
        TkIdent(v) => "ident"
        TkDocComment(t) => "doc"
        TkModuleDoc(t) => "moddoc"
        TkNewline => "newline"
    }
    IO.println("token " + i.to_string() + ": " + name + " line=" + line.to_string() + " col=" + col.to_string())
    i = i + 1
}
