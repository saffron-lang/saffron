// LLVM IR code generator for Saffron-mini

import "./ast.sf" as AST
import "./codegen/methods.sf" as Methods

class Codegen {
    var sb: StringBuilder
    var label_counter: Float
    var local_counter: Float
    var globals: List<String>
    var string_constants: List<String>
    var block_terminated: Bool
    var enum_defs: Map<String, List<String>>
    var enum_variant_tags: Map<String, Float>
    var enum_variant_fields: Map<String, String>
    var type_defs: StringBuilder
    var known_functions: List<String>
    var func_ret_types: Map<String, String>
    var class_fields: Map<String, String>
    var class_methods: Map<String, List<String>>
    var current_class: String
    var current_parent: String
    var string_vars: List<String>
    var last_type: AST.Type
    var var_types: Map<String, String>
    var typed_vars: Map<String, AST.Type>
    var loop_end_label: String
    var current_ret_type: String
    var called_functions: List<String>
    var called_function_arity: Map<String, Float>
    var module_prefixes: Map<String, String>
    var func_prefix_map: Map<String, String>
    var func_defaults: Map<String, List<AST.Expr>>
    var func_param_count: Map<String, Float>
    var current_prefix: String
    var module_globals: Map<String, Bool>
    var register_only: Bool
    var in_function: Bool
    var intrinsic_funcs: List<String>
    var extern_sigs: Map<String, String>
    var defined_funcs: List<String>
    var builtin_methods: Map<String, String>
    var extend_map: Map<String, String>
    var pending_extend_class: String

    fun init() {
        this.sb = StringBuilder()
        this.label_counter = 0
        this.local_counter = 0
        this.globals = []
        this.string_constants = []
        this.block_terminated = false
        this.enum_defs = {}
        this.enum_variant_tags = {}
        this.enum_variant_fields = {}
        this.type_defs = StringBuilder()
        this.known_functions = []
        this.func_ret_types = {}
        this.class_fields = {}
        this.class_methods = {}
        this.current_class = ""
        this.current_parent = ""
        this.string_vars = []
        this.last_type = AST.Type.IntType
        this.var_types = {}
        this.typed_vars = {}
        this.loop_end_label = ""
        this.current_ret_type = "i64"
        this.called_functions = []
        this.called_function_arity = {}
        this.module_prefixes = {}
        this.func_prefix_map = {}
        this.func_defaults = {}
        this.func_param_count = {}
        this.current_prefix = ""
        this.module_globals = {}
        this.register_only = false
        this.in_function = false
        this.intrinsic_funcs = []
        this.extern_sigs = {}
        this.defined_funcs = []
        this.builtin_methods = {}
        this.extend_map = {}
        this.pending_extend_class = ""
        this.builtin_methods.set("push", "v2|__list_push|Nil|0")
        this.builtin_methods.set("append", "v2|__sb_append|Nil|0")
        this.builtin_methods.set("set", "v3|__map_set|Nil|0")
        this.builtin_methods.set("pop", "r1|__list_pop|Int|0")
        this.builtin_methods.set("keys", "r1|__map_keys|ListStr|0")
        this.builtin_methods.set("reverse", "r1|rt_list_reverse|List|1")
        this.builtin_methods.set("copy", "r1|rt_list_copy|List|1")
        this.builtin_methods.set("sort", "r1|rt_list_sort|List|1")
        this.builtin_methods.set("trim", "r1|rt_str_trim|String|1")
        this.builtin_methods.set("to_upper", "r1|rt_str_to_upper|String|1")
        this.builtin_methods.set("to_lower", "r1|rt_str_to_lower|String|1")
        this.builtin_methods.set("has", "r2|__map_has|Bool|0")
        this.builtin_methods.set("index_of", "r2|rt_str_index_of|Int|1")
        this.builtin_methods.set("repeat", "r2|rt_str_repeat|String|1")
        this.builtin_methods.set("to_number", "p1|atol|Int|0")
        this.builtin_methods.set("split", "p2|__str_split|ListStr|0")
        this.builtin_methods.set("ends_with", "p2|__str_ends_with|Bool|0")
        this.builtin_methods.set("replace", "p3|__str_replace|String|0")
        this.builtin_methods.set("join", "m2|__list_join|String|0")
    }

    // Helpers to construct AST.Type nodes — avoids cross-module enum resolution
    // issues where AST.Type.GenericType inside a class method gets misresolved.
    fun make_list_type(): AST.Type {
        return AST.Type.GenericType("List", [AST.Type.AnyType])
    }
    fun make_list_str_type(): AST.Type {
        return AST.Type.GenericType("List", [AST.Type.StringType])
    }
    fun make_map_type(): AST.Type {
        return AST.Type.GenericType("Map", [AST.Type.StringType, AST.Type.AnyType])
    }
    fun make_generic_type(base: String, args: List<AST.Type>): AST.Type {
        return AST.Type.GenericType(base, args)
    }

    fun params_to_string(params: List<AST.Param>): String {
        if (!(params is List)) {
            return ""
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < params.length()) {
            if (i > 0) { sb.append(",") }
            var p: AST.Param = params[i]
            var pname: String = match (p) { Param(n, t, d) => n }
            var ptype: String = match (p) { Param(n, t, d) => t }
            sb.append(pname)
            sb.append(":")
            sb.append(ptype)
            i = i + 1
        }
        return sb.to_string()
    }

    fun str_to_type(s: String): AST.Type {
        if (!(s is String)) return AST.Type.AnyType
        if (s == "String") return AST.Type.StringType
        if (s == "Int" or s == "Number" or s == "Float") return AST.Type.IntType
        if (s == "Bool") return AST.Type.BoolType
        if (s == "Nil") return AST.Type.NilType
        if (s == "Any") return AST.Type.AnyType
        if (s.starts_with("Fun(")) {
            return AST.Type.FuncType([], AST.Type.AnyType)
        }
        if (s == "List") return this.make_list_type()
        if (s.starts_with("List<") and s.ends_with(">")) {
            var inner: String = s.slice(5, s.length() - 1)
            return this.make_generic_type("List", [this.str_to_type(inner)])
        }
        if (s == "Map" or s.starts_with("Map<")) return this.make_map_type()
        if (s == "StringBuilder") return AST.Type.ClassType("StringBuilder")
        return AST.Type.ClassType(s)
    }

    fun type_to_string(t: AST.Type): String {
        return match (t) {
            IntType => "Int"
            FloatType => "Float"
            BoolType => "Bool"
            StringType => "String"
            NilType => "Nil"
            AnyType => "Any"
            ClassType(n) => n
            EnumType(n) => n
            GenericType(base, args) => this.generic_type_string(base, args)
            UnionType(types) => "Union"
            FuncType(p, r) => "Fun"
            NullableType(inner) => this.type_to_string(inner)
        }
    }

    fun generic_type_string(base: String, args: List<AST.Type>): String {
        if (args.length() > 0) {
            return base + "<" + this.type_to_string(args[0]) + ">"
        }
        return base
    }

    fun coerce_to_string(val: String, val_type: String): String {
        if (val_type == "String") {
            return val
        }
        if (val_type == "Int" or val_type == "Float") {
            var result: String = this.fresh_local()
            this.emit_indent(result + " = call i64 @__int_to_string(i64 " + val + ")")
            return result
        }
        if (val_type == "Bool") {
            var result: String = this.fresh_local()
            this.emit_indent(result + " = call i64 @__bool_to_string(i64 " + val + ")")
            return result
        }
        if (val_type == "Nil") {
            var result: String = this.fresh_local()
            this.emit_indent(result + " = call i64 @__nil_to_string()")
            return result
        }
        // Class with to_string method
        if (this.class_fields.has(val_type)) {
            var ts_method: String = val_type + "__to_string"
            if (this.func_prefix_map.has(ts_method)) {
                ts_method = this.func_prefix_map.get(ts_method)
            } else if (this.known_functions.contains(this.current_prefix + ts_method)) {
                ts_method = this.current_prefix + ts_method
            }
            if (this.known_functions.contains(ts_method)) {
                var result: String = this.fresh_local()
                this.emit_indent(result + " = call i64 @" + ts_method + "(i64 " + val + ")")
                return result
            }
        }
        // Fallback: convert as int
        var result: String = this.fresh_local()
        this.emit_indent(result + " = call i64 @__int_to_string(i64 " + val + ")")
        return result
    }

    fun is_string_type(t: AST.Type): Bool {
        return match (t) {
            StringType => true
            IntType => false
            FloatType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_int_type(t: AST.Type): Bool {
        return match (t) {
            IntType => true
            FloatType => true
            StringType => false
            BoolType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_bool_type(t: AST.Type): Bool {
        return match (t) {
            BoolType => true
            IntType => false
            FloatType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_nil_type(t: AST.Type): Bool {
        return match (t) {
            NilType => true
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_list_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => base == "List"
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_string_list_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => {
                if (base != "List") return false
                if (args.length() == 0) return false
                return this.is_string_type(args[0])
            }
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_map_type(t: AST.Type): Bool {
        return match (t) {
            GenericType(base, args) => base == "Map"
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            ClassType(n) => false
            EnumType(n) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    fun is_class_type(t: AST.Type, name: String): Bool {
        return match (t) {
            ClassType(n) => n == name
            IntType => false
            FloatType => false
            BoolType => false
            StringType => false
            NilType => false
            AnyType => false
            EnumType(n) => false
            GenericType(base, args) => false
            UnionType(types) => false
            FuncType(p, r) => false
            NullableType(inner) => false
        }
    }

    // Extract the value type string from a Map<K, V> type annotation.
    // e.g. "Map<String,AST.Type>" → "AST.Type"
    //      "Map<String,String>"   → "String"
    //      "Map" or unknown       → "Any"
    fun get_map_value_type(map_type: String): String {
        if (!map_type.starts_with("Map<")) return "Any"
        // Strip "Map<" prefix and trailing ">"
        var inner: String = map_type.slice(4, map_type.length() - 1)
        // Split on first comma respecting nested generics
        var parts: List<String> = this.split_respecting_generics(inner, ",")
        if (parts.length() < 2) return "Any"
        return parts[1]
    }

    fun split_respecting_generics(s: String, delim: String): List<String> {
        var result: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">") {
                depth = depth - 1
                current = current + ch
            } else if (ch == delim and depth == 0) {
                result.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            result.push(current)
        }
        return result
    }

    fun sanitize_name(name: String): String {
        // Prefix reserved LLVM names to avoid collisions with labels
        if (name == "entry" or name == "end" or name == "loop" or name == "body") {
            return "v_" + name
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < name.length()) {
            var ch: String = name.char_at(i)
            if (ch == "." or ch == "(" or ch == ")") {
                sb.append("_")
            } else {
                sb.append(ch)
            }
            i = i + 1
        }
        return sb.to_string()
    }

    fun fresh_label(prefix: String): String {
        this.label_counter = this.label_counter + 1
        return prefix + this.label_counter.floor().to_string()
    }

    fun fresh_local(): String {
        this.local_counter = this.local_counter + 1
        return "%t" + this.local_counter.floor().to_string()
    }

    fun reset_locals() {
        this.local_counter = 0
    }

    fun emit(line: String) {
        this.sb.append(line)
        this.sb.append("\n")
    }

    fun emit_indent(line: String) {
        if (this.block_terminated) return nil
        this.sb.append("  ")
        this.sb.append(line)
        this.sb.append("\n")
    }

    fun emit_terminator(line: String) {
        if (this.block_terminated) return nil
        this.sb.append("  ")
        this.sb.append(line)
        this.sb.append("\n")
        this.block_terminated = true
    }

    fun start_block(label: String) {
        this.emit(label + ":")
        this.block_terminated = false
    }

    // --- Type mapping ---

    fun llvm_type(t: String): String {
        if (t == "Int") return "i64"
        if (t == "Float") return "i64"
        if (t == "Bool") return "i64"
        if (t == "String") return "i64"
        if (t == "Nil") return "i64"
        if (t == "Any") return "i64"
        if (t == "List") return "i64"
        if (t == "Map") return "i64"
        return "i64"
    }

    // --- String constants ---

    fun add_string_constant(s: String): String {
        var idx: Float = this.string_constants.length()
        var name: String = "@.str." + idx.floor().to_string()
        this.string_constants.push(s)
        return name
    }

    fun emit_string_constants() {
        var i: Float = 0
        while (i < this.string_constants.length()) {
            var s: String = this.string_constants[i]
            var name: String = "@.str." + i.floor().to_string()
            var len: Float = s.length() + 1
            this.emit(name + " = private unnamed_addr constant [" + len.to_string() + " x i8] c\"" + this.escape_llvm_string(s) + "\\00\"")
            i = i + 1
        }
    }

    fun escape_llvm_string(s: String): String {
        var result: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "\n") { result.append("\\0A") }
            else if (ch == "\r") { result.append("\\0D") }
            else if (ch == "\t") { result.append("\\09") }
            else if (ch == "\\") { result.append("\\5C") }
            else if (ch == "\"") { result.append("\\22") }
            else { result.append(ch) }
            i = i + 1
        }
        return result.to_string()
    }

    // --- Expression codegen ---
    // Returns the LLVM local name holding the result
    // Sets this.last_type to the Saffron type of the result
    // @codegen-split: expr
    // @codegen-split: match
    // @codegen-split: closures
    // @codegen-split: intrinsics
    fun runtime_declares(): String {
        var rt: StringBuilder = StringBuilder()
        rt.append("; --- Runtime declarations ---\n")
        rt.append("%SB = type { i64, i64, i8* }\n\n")
        var names: List<String> = ["__list_new", "__list_push", "__list_get", "__list_set", "__list_length", "__list_pop", "StringBuilder", "__sb_append", "__sb_to_string", "__safe_strcmp", "__map_new", "__map_set", "__map_get", "__map_has", "__map_keys", "__str_ends_with", "__str_split", "__str_replace", "__int_to_string", "__list_join", "__join_append", "__list_contains", "__io_read_file", "__io_write_file", "__io_file_exists", "__io_mkdir", "__io_walk_dir", "__io_append_file", "__os_exec", "__os_args", "__os_cwd", "__os_path_sep", "__os_platform", "__os_env"]
        var sigs: List<String> = ["i64 @__list_new()", "i64 @__list_push(i64, i64)", "i64 @__list_get(i64, i64)", "i64 @__list_set(i64, i64, i64)", "i64 @__list_length(i64)", "i64 @__list_pop(i64)", "i64 @StringBuilder()", "i64 @__sb_append(i64, i64)", "i64 @__sb_to_string(i64)", "i64 @__safe_strcmp(i64, i64)", "i64 @__map_new()", "i64 @__map_set(i64, i64, i64)", "i64 @__map_get(i64, i64)", "i64 @__map_has(i64, i64)", "i64 @__map_keys(i64)", "i64 @__str_ends_with(i64, i64)", "i64 @__str_split(i64, i64)", "i64 @__str_replace(i64, i64, i64)", "i64 @__int_to_string(i64)", "i64 @__list_join(i64, i64)", "i64 @__join_append(i64, i64, i64, i64, i64)", "i64 @__list_contains(i64, i64)", "i64 @__io_read_file(i64)", "i64 @__io_write_file(i64, i64)", "i64 @__io_file_exists(i64)", "i64 @__io_mkdir(i64)", "i64 @__io_walk_dir(i64)", "i64 @__io_append_file(i64, i64)", "i64 @__os_exec(i64)", "i64 @__os_args()", "i64 @__os_cwd()", "i64 @__os_path_sep()", "i64 @__os_platform()", "i64 @__os_env(i64)"]
        var di: Float = 0
        while (di < names.length()) {
            if (!this.defined_funcs.contains(names[di])) {
                rt.append("declare " + sigs[di] + "\n")
            }
            di = di + 1
        }
        return rt.to_string()
    }
    fun find_enum_for_variant(variant: String): String {
        var keys: List<String> = this.enum_variant_tags.keys()
        var i: Float = 0
        while (i < keys.length()) {
            var key: String = keys[i]
            if (key.ends_with("." + variant)) {
                return key.split(".")[0]
            }
            i = i + 1
        }
        return "Unknown"
    }

    fun resolve_callee(expr: AST.Expr): String {
        return match (expr) {
            Variable(n) => n
            MemberAccess(obj, field) => this.resolve_callee(obj) + "." + field
            x => ""
        }
    }

    fun gen_logical(left: AST.Expr, op: String, right: AST.Expr): String {
        var lhs_raw: String = this.gen_arg_value(left)
        var lhs: String = this.to_i1(lhs_raw)
        var current_block: String = this.fresh_label("logic.entry")
        var rhs_label: String = this.fresh_label("rhs")
        var end_label: String = this.fresh_label("end")

        // We need a label for the current block for phi
        this.emit_terminator("br label %" + current_block)
        this.start_block(current_block)

        if (op == "or") {
            this.emit_terminator("br i1 " + lhs + ", label %" + end_label + ", label %" + rhs_label)
        } else {
            this.emit_terminator("br i1 " + lhs + ", label %" + rhs_label + ", label %" + end_label)
        }

        this.start_block(rhs_label)
        var rhs_raw: String = this.gen_arg_value(right)
        var rhs: String = this.to_i1(rhs_raw)
        this.emit_terminator("br label %" + end_label)

        this.start_block(end_label)
        var phi_result: String = this.fresh_local()
        this.emit_indent(phi_result + " = phi i1 [" + lhs + ", %" + current_block + "], [" + rhs + ", %" + rhs_label + "]")
        // Extend back to i64 for uniform value type
        var result: String = this.fresh_local()
        this.emit_indent(result + " = zext i1 " + phi_result + " to i64")
        this.last_type = AST.Type.IntType
        return result
    }

    // --- Variable collection (for hoisting allocas to entry block) ---

    fun collect_vars(stmts: List<AST.Stmt>, names: List<String>, types: List<String>) {
        var i: Float = 0
        while (i < stmts.length()) {
            this.collect_vars_stmt(stmts[i], names, types)
            i = i + 1
        }
    }

    fun add_var_unique(names: List<String>, types: List<String>, name: String, typ: String) {
        if (!names.contains(name)) {
            names.push(name)
            types.push(typ)
        }
    }

    fun collect_vars_stmt(stmt: AST.Stmt, names: List<String>, types: List<String>) {
        match (stmt) {
            VarDecl(name, type_ann, init, doc) => {
                this.add_var_unique(names, types, name, type_ann)
                this.collect_vars_expr(init, names, types)
            }
            If(cond, then_branch, else_branch) => {
                this.collect_vars(then_branch, names, types)
                this.collect_vars(else_branch, names, types)
            }
            While(cond, body) => {
                this.collect_vars(body, names, types)
            }
            Block(stmts) => {
                this.collect_vars(stmts, names, types)
            }
            ExprStmt(expr) => {
                this.collect_vars_expr(expr, names, types)
            }
            Return(value) => {
                this.collect_vars_expr(value, names, types)
            }
            FunDecl(n, p, r, b, d) => {}
            EnumDecl(n, v, d) => {}
            ClassDecl(n, p, f, m, d) => {}
            Break => {}
            Continue => {}
            TryCatch(try_body, catch_name, catch_body, finally_body) => {
                this.collect_vars(try_body, names, types)
                this.add_var_unique(names, types, catch_name, "String")
                this.collect_vars(catch_body, names, types)
                this.collect_vars(finally_body, names, types)
            }
            Throw(value) => {
                this.collect_vars_expr(value, names, types)
            }
        }
    }

    fun collect_vars_expr(expr: AST.Expr, names: List<String>, types: List<String>) {
        match (expr) {
            Match(s, a) => { this.collect_vars_match(expr, names, types) }
            BlockExpr(stmts, value) => {
                this.collect_vars(stmts, names, types)
                this.collect_vars_expr(value, names, types)
            }
            Binary(left, op, right) => {
                this.collect_vars_expr(left, names, types)
                this.collect_vars_expr(right, names, types)
            }
            Logical(left, op, right) => {
                this.collect_vars_expr(left, names, types)
                this.collect_vars_expr(right, names, types)
            }
            Unary(op, right) => { this.collect_vars_expr(right, names, types) }
            Assign(name, value) => { this.collect_vars_expr(value, names, types) }
            Call(callee, args) => { this.collect_vars_expr(callee, names, types) }
            MethodCall(obj, method, args) => { this.collect_vars_expr(obj, names, types) }
            SetField(obj, field, value) => {
                this.collect_vars_expr(obj, names, types)
                this.collect_vars_expr(value, names, types)
            }
            GetField(obj, field) => { this.collect_vars_expr(obj, names, types) }
            IndexGet(obj, idx) => {
                this.collect_vars_expr(obj, names, types)
                this.collect_vars_expr(idx, names, types)
            }
            IndexSet(obj, idx, value) => {
                this.collect_vars_expr(obj, names, types)
                this.collect_vars_expr(idx, names, types)
                this.collect_vars_expr(value, names, types)
            }
            MemberAccess(obj, field) => { this.collect_vars_expr(obj, names, types) }
            IntLit(v) => {}
            FloatLit(v) => {}
            BoolLit(v) => {}
            StringLit(s) => {}
            NilLit => {}
            Variable(n) => {}
            This => {}
            MapLit => {}
            ListLit(e) => {}
            EnumConstruct(e, v, a) => {}
            Lambda(p, r, b) => {}
            IsCheck(val, t) => { this.collect_vars_expr(val, names, types) }
        }
    }

    fun is_wildcard_in_enum(pattern: AST.Pattern, enum_name: String): Bool {
        var name: String = match (pattern) { VariantPattern(v, b) => v
            _ => ""
        }
        return !this.enum_variant_tags.has(enum_name + "." + name)
    }

    fun get_arm_pattern(arm: AST.MatchArm): AST.Pattern {
        return match (arm) { Arm(p, b) => p
            _ => ""
        }
    }

    fun get_arm_body(arm: AST.MatchArm): AST.Expr {
        return match (arm) { Arm(p, b) => b
            _ => ""
        }
    }

    fun get_pattern_bindings(pattern: AST.Pattern): List<String> {
        return match (pattern) { VariantPattern(v, b) => b
            _ => ""
        }
    }

    fun collect_vars_match(expr: AST.Expr, names: List<String>, types: List<String>) {
        var arms: List<AST.MatchArm> = this.get_match_arms(expr)
        var i: Float = 0
        while (i < arms.length()) {
            var arm: AST.MatchArm = arms[i]
            var bindings: List<String> = this.get_pattern_bindings(this.get_arm_pattern(arm))
            var j: Float = 0
            while (j < bindings.length()) {
                this.add_var_unique(names, types, bindings[j], "Int")
                j = j + 1
            }
            this.collect_vars_expr(this.get_arm_body(arm), names, types)
            i = i + 1
        }
    }

    fun is_match_expr(expr: AST.Expr): Bool {
        var kind: Any = match (expr) {
            Match(s, a) => "match"
            IntLit(v) => "other"
            FloatLit(v) => "other"
            BoolLit(v) => "other"
            StringLit(s) => "other"
            NilLit => "other"
            Variable(n) => "other"
            Binary(l, o, r) => "other"
            Unary(o, r) => "other"
            Call(c, a) => "other"
            Assign(n, v) => "other"
            Logical(l, o, r) => "other"
            MemberAccess(o, f) => "other"
            EnumConstruct(e, v, a) => "other"
            Lambda(p, r, b) => "other"
            GetField(o, f) => "other"
            SetField(o, f, v) => "other"
            This => "other"
            ListLit(e) => "other"
            IndexGet(o, i) => "other"
            IndexSet(o, i, v) => "other"
            MethodCall(o, m, a) => "other"
            MapLit => "other"
            BlockExpr(s, v) => "other"
            IsCheck(val, t) => "other"
        }
        return kind == "match"
    }

    fun get_match_arms(expr: AST.Expr): List<AST.MatchArm> {
        return match (expr) { Match(s, a) => a
            _ => ""
        }
    }

    // --- Statement codegen ---

    // @codegen-split: stmts
    fun gen_function(name: String, params: String, ret_type: String, body: List<AST.Stmt>) {
        var emit_name: String = this.current_prefix + name
        if (name == "main") {
            emit_name = "__saffron_main"
            this.known_functions.push("main")
        }
        this.known_functions.push(emit_name)
        this.func_ret_types.set(emit_name, ret_type)
        if (this.current_prefix.length() > 0) {
            this.func_ret_types.set(name, ret_type)
            this.func_prefix_map.set(name, emit_name)
        }
        if (this.register_only) { return }
        if (this.defined_funcs.contains(emit_name)) { return }
        this.defined_funcs.push(emit_name)
        var is_nested: Bool = this.in_function

        // For nested functions: hoist as regular function with captures as extra params
        if (is_nested) {
            var param_names: List<String> = []
            if (params.length() > 0) {
                var pl: List<String> = this.split_respecting_generics(params, ",")
                var pi2: Float = 0
                while (pi2 < pl.length()) {
                    var pp: List<String> = pl[pi2].split(":")
                    param_names.push(pp[0])
                    pi2 = pi2 + 1
                }
            }
            var captures: List<String> = []
            this.find_free_vars_stmts(body, param_names, captures)

            // Build extended params: captures (with actual types from parent) + original params
            var full_params: String = ""
            var ci2: Float = 0
            while (ci2 < captures.length()) {
                if (full_params.length() > 0) { full_params = full_params + "," }
                var cap_type: String = "Int"
                if (this.typed_vars.has(captures[ci2])) {
                    cap_type = this.type_to_string(this.typed_vars.get(captures[ci2]))
                } else if (this.var_types.has(captures[ci2])) {
                    cap_type = this.var_types.get(captures[ci2])
                }
                full_params = full_params + captures[ci2] + ":" + cap_type
                ci2 = ci2 + 1
            }
            if (params.length() > 0) {
                if (full_params.length() > 0) { full_params = full_params + "," }
                full_params = full_params + params
            }

            // Record capture info for call sites
            this.called_function_arity.set("__captures_" + emit_name, captures.length())
            this.func_prefix_map.set("__caps_" + emit_name, captures.join(","))

            // Save state and emit hoisted function
            var saved_sb2: StringBuilder = this.sb
            var saved_terminated2: Bool = this.block_terminated
            var saved_counter2: Float = this.local_counter
            var saved_var_types2: Map<String, String> = this.var_types
            var saved_typed_vars2: Map<String, AST.Type> = this.typed_vars

            this.sb = StringBuilder()
            this.in_function = true
            this.var_types = {}
            this.typed_vars = {}
            this.string_vars = []
            this.reset_locals()
            var ret_llvm2: String = this.llvm_type(ret_type)
            var all_params: List<String> = []
            if (full_params.length() > 0) {
                all_params = this.split_respecting_generics(full_params, ",")
            }
            var param_strs2: List<String> = []
            var pi3: Float = 0
            while (pi3 < all_params.length()) {
                var pp2: List<String> = all_params[pi3].split(":")
                param_strs2.push("i64 %" + this.sanitize_name(pp2[0]) + ".arg")
                pi3 = pi3 + 1
            }
            var linkage2: String = "define"
            if (this.current_prefix.length() > 0) { linkage2 = "define linkonce_odr" }
            this.emit("")
            this.emit(linkage2 + " " + ret_llvm2 + " @" + emit_name + "(" + param_strs2.join(", ") + ") {")
            this.emit("entry:")
            this.block_terminated = false
            pi3 = 0
            while (pi3 < all_params.length()) {
                var pp2: List<String> = all_params[pi3].split(":")
                if (pi3 < captures.length()) {
                    // Capture params are POINTERS — reconstruct via inttoptr
                    this.emit_indent("%" + this.sanitize_name(pp2[0]) + " = inttoptr i64 %" + this.sanitize_name(pp2[0]) + ".arg to i64*")
                } else {
                    // Regular params — alloca and store
                    this.emit_indent("%" + this.sanitize_name(pp2[0]) + " = alloca i64")
                    this.emit_indent("store i64 %" + this.sanitize_name(pp2[0]) + ".arg, i64* %" + this.sanitize_name(pp2[0]))
                }
                this.var_types.set(pp2[0], pp2[1])
                this.typed_vars.set(pp2[0], this.str_to_type(pp2[1]))
                pi3 = pi3 + 1
            }
            var var_names2: List<String> = []
            var var_types2: List<String> = []
            this.collect_vars(body, var_names2, var_types2)
            pi3 = 0
            while (pi3 < var_names2.length()) {
                if (!captures.contains(var_names2[pi3])) {
                    this.emit_indent("%" + this.sanitize_name(var_names2[pi3]) + " = alloca i64")
                }
                pi3 = pi3 + 1
            }
            this.gen_stmts(body)
            if (!this.block_terminated) { this.emit_indent("ret i64 0") }
            this.emit("}")
            this.block_terminated = false

            var nested_ir: String = this.sb.to_string()
            this.sb = saved_sb2
            this.block_terminated = saved_terminated2
            this.local_counter = saved_counter2
            this.var_types = saved_var_types2
            this.typed_vars = saved_typed_vars2
            this.globals.push(nested_ir)
            return
        }

        this.in_function = true
        var saved_vt: Map<String, String> = this.var_types
        var saved_tv: Map<String, AST.Type> = this.typed_vars
        this.reset_locals()
        this.string_vars = []
        this.var_types = {}
        this.typed_vars = {}
        var ret_llvm: String = this.llvm_type(ret_type)

        // Parse params string "name:type,name:type"
        var param_list: List<String> = []
        if (params.length() > 0) {
            param_list = this.split_respecting_generics(params, ",")
        }

        var param_strs: List<String> = []
        var i: Float = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            param_strs.push(this.llvm_type(ptype) + " %" + this.sanitize_name(pname) + ".arg")
            i = i + 1
        }

        this.emit("")
        var linkage: String = "define"
        if (this.current_prefix.length() > 0) {
            linkage = "define linkonce_odr"
        }
        this.emit(linkage + " " + ret_llvm + " @" + emit_name + "(" + param_strs.join(", ") + ") {")
        this.emit("entry:")
        this.block_terminated = false

        // Collect all local variable declarations from body
        var var_names: List<String> = []
        var var_types: List<String> = []
        this.collect_vars(body, var_names, var_types)

        // Emit all allocas in entry block (params + locals)
        i = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            this.emit_indent("%" + this.sanitize_name(pname) + " = alloca " + this.llvm_type(ptype))
            i = i + 1
        }
        i = 0
        while (i < var_names.length()) {
            var vn: String = var_names[i]
            if (!this.module_globals.has(this.current_prefix + vn)) {
                this.emit_indent("%" + this.sanitize_name(vn) + " = alloca " + this.llvm_type(var_types[i]))
            }
            i = i + 1
        }

        // Store params into their allocas and track types
        i = 0
        while (i < param_list.length()) {
            var parts: List<String> = param_list[i].split(":")
            var pname: String = parts[0]
            var ptype: String = parts[1]
            this.var_types.set(pname, ptype)
            this.typed_vars.set(pname, this.str_to_type(ptype))
            if (ptype == "String") {
                this.string_vars.push(pname)
            }
            this.emit_indent("store i64 %" + this.sanitize_name(pname) + ".arg, i64* %" + this.sanitize_name(pname))
            i = i + 1
        }

        // Generate body statements, treating last ExprStmt as implicit return
        if (body.length() > 0 and ret_type != "Nil" and ret_type != "void") {
            var last_stmt: AST.Stmt = body[body.length() - 1]
            var last_kind: String = this.classify_stmt(last_stmt)
            if (last_kind == "expr") {
                // Generate all but last
                var bi: Float = 0
                while (bi < body.length() - 1) {
                    this.gen_stmt(body[bi])
                    bi = bi + 1
                }
                // Generate last as implicit return
                var last_expr: AST.Expr = match (last_stmt) { ExprStmt(e) => e
                    _ => AST.Expr.NilLit
                }
                var last_val: String = this.gen_arg_value(last_expr)
                if (!this.block_terminated) {
                    this.emit_terminator("ret i64 " + last_val)
                }
            } else {
                this.gen_stmts(body)
            }
        } else {
            this.gen_stmts(body)
        }

        // Ensure block has a terminator
        if (!this.block_terminated) {
            if (ret_llvm == "void") {
                this.emit_terminator("ret void")
            } else {
                this.emit_terminator("ret i64 0")
            }
        }

        this.emit("}")
        this.block_terminated = false
        this.var_types = saved_vt
        this.typed_vars = saved_tv
        this.in_function = false
    }

    // --- Top-level ---

    fun is_nil_expr(e: AST.Expr): Bool {
        var k: String = this.classify_expr(e)
        return k == "nil"
    }

    fun is_decl(stmt: AST.Stmt): Bool {
        return match (stmt) {
            FunDecl(n, p, r, b, d) => true
            EnumDecl(n, v, d) => true
            ClassDecl(n, p, f, m, d) => true
            ExprStmt(e) => this.is_nil_expr(e)
            VarDecl(n, t, i, d) => d.starts_with("@import:")
            Return(v) => false
            If(c, t, e) => false
            While(c, b) => false
            Block(s) => false
            Break => false
            Continue => false
            TryCatch(t, n, c, f) => false
            Throw(v) => false
        }
    }

    fun generate(program: List<AST.Stmt>): String {
        // Register runtime functions (defined in runtime.ll, declared via runtime_declares())
        this.known_functions.push("StringBuilder")
        this.known_functions.push("__list_new")
        this.known_functions.push("__list_push")
        this.known_functions.push("__list_get")
        this.known_functions.push("__list_set")
        this.known_functions.push("__list_length")
        this.known_functions.push("__list_pop")
        this.known_functions.push("__sb_append")
        this.known_functions.push("__sb_to_string")
        this.known_functions.push("__safe_strcmp")
        this.known_functions.push("__map_new")
        this.known_functions.push("__map_set")
        this.known_functions.push("__map_get")
        this.known_functions.push("__map_has")
        this.known_functions.push("__map_keys")
        this.known_functions.push("__str_ends_with")
        this.known_functions.push("__str_split")
        this.known_functions.push("__str_replace")
        this.known_functions.push("__int_to_string")
        this.known_functions.push("__list_join")
        this.known_functions.push("__join_append")
        this.known_functions.push("__list_contains")
        this.known_functions.push("__io_read_file")
        this.known_functions.push("__io_write_file")
        this.known_functions.push("__io_file_exists")
        this.known_functions.push("__io_mkdir")
        this.known_functions.push("__os_exec")
        this.known_functions.push("__os_args")
        this.known_functions.push("__os_cwd")
        this.known_functions.push("__os_path_sep")
        this.known_functions.push("__os_platform")
        this.known_functions.push("__os_env")
        this.func_ret_types.set("StringBuilder", "StringBuilder")

        // Pre-scan: register extension methods before compilation
        var ei: Float = 0
        while (ei < program.length()) {
            var edoc: String = this.get_fun_doc(program[ei])
            if (edoc.starts_with("@extend:")) {
                var ename: String = this.get_fun_name(program[ei])
                var ecls: String = edoc.slice(8, edoc.length())
                this.extend_map.set(this.current_prefix + ename, ecls)
            }
            ei = ei + 1
        }

        // First pass: emit all declarations (functions, enums, classes)
        var i: Float = 0
        while (i < program.length()) {
            var stmt: AST.Stmt = program[i]
            if (this.is_decl(stmt)) {
                // Set pending_extend_class from pre-scanned map before gen_stmt
                var fn_name: String = this.get_fun_name(stmt)
                if (fn_name.length() > 0 and this.extend_map.has(this.current_prefix + fn_name)) {
                    this.pending_extend_class = this.extend_map.get(this.current_prefix + fn_name)
                } else {
                    this.pending_extend_class = ""
                }
                this.gen_stmt(stmt)
            }
            i = i + 1
        }

        // Second pass: wrap top-level statements in __saffron_entry
        var has_top_level: Bool = false
        i = 0
        while (i < program.length()) {
            if (!this.is_decl(program[i])) {
                has_top_level = true
            }
            i = i + 1
        }
        if (has_top_level) {
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            i = 0
            while (i < program.length()) {
                if (!this.is_decl(program[i])) {
                    var stmts: List<AST.Stmt> = []
                    stmts.push(program[i])
                    this.collect_vars(stmts, top_vars, top_var_types)
                }
                i = i + 1
            }
            this.emit("")
            this.emit("define i64 @__saffron_entry() {")
            this.emit("entry:")
            this.block_terminated = false
            this.reset_locals()
            var vi: Float = 0
            while (vi < top_vars.length()) {
                this.emit_indent("%" + this.sanitize_name(top_vars[vi]) + " = alloca i64")
                vi = vi + 1
            }
            i = 0
            while (i < program.length()) {
                if (!this.is_decl(program[i])) {
                    this.gen_stmt(program[i])
                }
                i = i + 1
            }
            if (!this.block_terminated) {
                this.emit_terminator("ret i64 0")
            }
            this.emit("}")
            this.block_terminated = false
        }

        // Build final output with proper ordering
        var out: StringBuilder = StringBuilder()
        out.append("; Generated by Saffron LLVM compiler\n")
        out.append("target triple = \"arm64-apple-macosx15.0.0\"\n\n")

        // String constants
        var j: Float = 0
        while (j < this.string_constants.length()) {
            var s: String = this.string_constants[j]
            var name: String = "@.str." + j.floor().to_string()
            var len: Float = s.length() + 1
            out.append(name + " = private unnamed_addr constant [" + len.to_string() + " x i8] c\"" + this.escape_llvm_string(s) + "\\00\"\n")
            j = j + 1
        }
        if (this.string_constants.length() > 0) {
            out.append("\n")
        }

        // Type definitions (enums as tagged unions)
        var td: String = this.type_defs.to_string()
        if (td.length() > 0) {
            out.append(td)
            out.append("\n")
        }

        // External declarations
        out.append("declare i32 @puts(i8*)\n")
        out.append("declare i32 @printf(i8*, ...)\n")
        out.append("declare i32 @snprintf(i8*, i64, i8*, ...)\n")
        out.append("declare i8* @malloc(i64)\n")
        out.append("declare i8* @realloc(i8*, i64)\n")
        out.append("declare void @free(i8*)\n")
        out.append("declare i64 @strlen(i8*)\n")
        out.append("declare i8* @strcpy(i8*, i8*)\n")
        out.append("declare i8* @strcat(i8*, i8*)\n")
        out.append("declare i8* @strstr(i8*, i8*)\n")
        out.append("declare i32 @strcmp(i8*, i8*)\n")
        out.append("declare i32 @strncmp(i8*, i8*, i64)\n")
        out.append("declare i64 @atol(i8*)\n")
        out.append("declare void @exit(i32)\n")
        out.append("declare i8* @fopen(i8*, i8*)\n")
        out.append("declare i64 @fread(i8*, i64, i64, i8*)\n")
        out.append("declare i64 @fwrite(i8*, i64, i64, i8*)\n")
        out.append("declare i32 @fclose(i8*)\n")
        out.append("declare i32 @fseek(i8*, i64, i32)\n")
        out.append("declare i64 @ftell(i8*)\n")
        out.append("declare i8* @strtok(i8*, i8*)\n")
        out.append("declare i32 @pclose(i8*)\n")
        out.append("declare i8* @popen(i8*, i8*)\n")
        out.append("declare i8* @fgets(i8*, i32, i8*)\n")
        out.append("declare void @llvm.memcpy.p0i8.p0i8.i64(i8*, i8*, i64, i1)\n")
        out.append("declare i32 @setjmp(i8*)\n")
        out.append("declare void @longjmp(i8*, i32)\n")
        out.append("declare void @__io_println_str(i64)\n")
        out.append("declare void @__io_println_int(i64)\n")
        out.append("declare void @__io_println_bool(i64)\n")
        out.append("declare void @__io_println_nil()\n")
        out.append("declare void @__io_print_str(i64)\n")
        out.append("declare void @__io_print_int(i64)\n")
        out.append("declare i64 @__bool_to_string(i64)\n")
        out.append("declare i64 @__nil_to_string()\n\n")

        // Runtime string constants (linkonce_odr for multi-file linking)
        out.append("@.fmt.ld = linkonce_odr unnamed_addr constant [4 x i8] c\"%ld\\00\"\n")
        out.append("@.str.empty = linkonce_odr unnamed_addr constant [1 x i8] c\"\\00\"\n")
        out.append("@.str.rb = linkonce_odr unnamed_addr constant [2 x i8] c\"r\\00\"\n")
        out.append("@.str.wb = linkonce_odr unnamed_addr constant [2 x i8] c\"w\\00\"\n")
        out.append("@.str.r = linkonce_odr unnamed_addr constant [2 x i8] c\"r\\00\"\n")

        // Global argc/argv (set by main) — weak linkage for multi-file
        out.append("@__argc = weak global i32 0\n")
        out.append("@__argv = weak global i8** null\n")
        // Exception handling globals
        out.append("@__exception_value = weak global i64 0\n")
        out.append("@__jmp_buf_current = weak global i8* null\n\n")

        // Struct types + runtime function declarations (bodies in runtime.ll)
        out.append("; List = { count, capacity, data* }\n")
        out.append("%List = type { i64, i64, i64* }\n")
        out.append("; Map = { count, capacity, keys*, values* }\n")
        out.append("%Map = type { i64, i64, i64*, i64* }\n\n")
        out.append(this.runtime_declares())
        var ext_keys: List<String> = this.extern_sigs.keys()
        var ei: Float = 0
        var out_so_far: String = out.to_string()
        while (ei < ext_keys.length()) {
            var decl: String = this.emit_extern_declare(this.extern_sigs.get(ext_keys[ei]))
            var parsed_ext: List<String> = this.parse_extern_sig(this.extern_sigs.get(ext_keys[ei]))
            var c_fn_name: String = parsed_ext[0]
            if (!out_so_far.contains("@" + c_fn_name + "(")) {
                out.append(decl + "\n")
            }
            ei = ei + 1
        }

        // Lambda functions
        var k: Float = 0
        while (k < this.globals.length()) {
            out.append(this.globals[k])
            k = k + 1
        }

        // Function bodies
        out.append(this.sb.to_string())

        // Emit declares for external functions (called but not defined in this file)
        var declared: List<String> = []
        var ci: Float = 0
        while (ci < this.called_functions.length()) {
            var cfname: String = this.called_functions[ci]
            if (!this.known_functions.contains(cfname) and !declared.contains(cfname)) {
                var arity: Float = 1
                if (this.called_function_arity.has(cfname)) {
                    arity = this.called_function_arity.get(cfname)
                }
                var param_str: String = ""
                var pi: Float = 0
                while (pi < arity) {
                    if (pi > 0) { param_str = param_str + ", " }
                    param_str = param_str + "i64"
                    pi = pi + 1
                }
                out.append("declare i64 @" + cfname + "(" + param_str + ")\n")
                declared.push(cfname)
            }
            ci = ci + 1
        }
        if (declared.length() > 0) {
            out.append("\n")
        }

        // Only emit C main wrapper if program defines a main function
        if (this.known_functions.contains("main") or has_top_level) {
            out.append("\ndefine i32 @main(i32 %argc, i8** %argv) {\n")
            out.append("entry:\n")
            out.append("  store i32 %argc, i32* @__argc\n")
            out.append("  store i8** %argv, i8*** @__argv\n")
            if (has_top_level) {
                out.append("  call i64 @__saffron_entry()\n")
            } else {
                out.append("  call i64 @__saffron_main()\n")
            }
            out.append("  ret i32 0\n")
            out.append("}\n")
        }

        return out.to_string()
    }

    // @codegen-split: methods
}

fun generate(program: List<AST.Stmt>): String {
    var gen: Codegen = Codegen()
    return gen.generate(program)
}

fun generate_with_imports(program: List<AST.Stmt>, imports: List<AST.Stmt>): String {
    // Merge imports and program into a single compilation unit
    var all_stmts: List<AST.Stmt> = []
    var i: Float = 0
    while (i < imports.length()) {
        all_stmts.push(imports[i])
        i = i + 1
    }
    i = 0
    while (i < program.length()) {
        all_stmts.push(program[i])
        i = i + 1
    }
    var gen: Codegen = Codegen()
    return gen.generate(all_stmts)
}

fun generate_with_modules(program: List<AST.Stmt>, module_stmts: List<List<AST.Stmt>>, module_prefixes_list: List<String>, alias_map: Map<String, String>): String {
    // Merge all module code + main program into one compilation unit
    // Each module's functions get prefixed via current_prefix during gen_stmt
    var gen: Codegen = Codegen()
    gen.module_prefixes = alias_map

    // Register runtime functions first
    gen.known_functions.push("StringBuilder")
    gen.known_functions.push("__list_new")
    gen.known_functions.push("__list_push")
    gen.known_functions.push("__list_get")
    gen.known_functions.push("__list_set")
    gen.known_functions.push("__list_length")
    gen.known_functions.push("__list_pop")
    gen.known_functions.push("__sb_append")
    gen.known_functions.push("__sb_to_string")
    gen.known_functions.push("__safe_strcmp")
    gen.known_functions.push("__map_new")
    gen.known_functions.push("__map_set")
    gen.known_functions.push("__map_get")
    gen.known_functions.push("__map_has")
    gen.known_functions.push("__map_keys")
    gen.known_functions.push("__str_ends_with")
    gen.known_functions.push("__str_split")
    gen.known_functions.push("__str_replace")
    gen.known_functions.push("__int_to_string")
    gen.known_functions.push("__list_join")
    gen.known_functions.push("__join_append")
    gen.known_functions.push("__list_contains")
    gen.known_functions.push("__io_read_file")
    gen.known_functions.push("__io_write_file")
    gen.known_functions.push("__io_file_exists")
    gen.known_functions.push("__io_mkdir")
    gen.known_functions.push("__io_walk_dir")
    gen.known_functions.push("__io_append_file")
    gen.known_functions.push("__os_exec")
    gen.known_functions.push("__os_args")
    gen.known_functions.push("__os_cwd")
    gen.known_functions.push("__os_path_sep")
    gen.known_functions.push("__os_platform")
    gen.known_functions.push("__os_env")
    gen.func_ret_types.set("StringBuilder", "StringBuilder")

    // Pre-scan: register module-level VarDecls as globals
    var mi2: Float = 0
    while (mi2 < module_stmts.length()) {
        var stmts: List<AST.Stmt> = module_stmts[mi2]
        var prefix: String = module_prefixes_list[mi2]
        var si2: Float = 0
        while (si2 < stmts.length()) {
            if (!gen.is_decl(stmts[si2])) {
                var stmt_kind: String = gen.classify_stmt(stmts[si2])
                if (stmt_kind == "var") {
                    var vname: String = match (stmts[si2]) { VarDecl(n, t, i, d) => n }
                    var vdoc2: String = gen.get_var_doc(stmts[si2])
                    if (!vdoc2.starts_with("@import:")) {
                        gen.module_globals.set(prefix + vname, true)
                        gen.globals.push("@__g_" + prefix + gen.sanitize_name(vname) + " = global i64 0\n")
                    }
                }
            }
            si2 = si2 + 1
        }
        mi2 = mi2 + 1
    }

    // Pre-scan: register extension methods from all modules
    mi2 = 0
    while (mi2 < module_stmts.length()) {
        var stmts: List<AST.Stmt> = module_stmts[mi2]
        var prefix: String = module_prefixes_list[mi2]
        var si2: Float = 0
        while (si2 < stmts.length()) {
            var fdoc: String = gen.get_fun_doc(stmts[si2])
            if (fdoc.starts_with("@extend:")) {
                var fname: String = gen.get_fun_name(stmts[si2])
                var ext_cls: String = fdoc.slice(8, fdoc.length())
                gen.extend_map.set(prefix + fname, ext_cls)
            }
            si2 = si2 + 1
        }
        mi2 = mi2 + 1
    }

    // Compile each module's declarations with its prefix (in dependency order)
    var module_init_names: List<String> = []
    gen.register_only = false
    var mi: Float = 0
    while (mi < module_stmts.length()) {
        var stmts: List<AST.Stmt> = module_stmts[mi]
        var prefix: String = module_prefixes_list[mi]
        gen.current_prefix = prefix

        // Compile declarations (functions, classes, enums)
        var si: Float = 0
        while (si < stmts.length()) {
            if (gen.is_decl(stmts[si])) {
                // Set pending_extend_class from pre-scanned map before gen_stmt
                var fn_name: String = gen.get_fun_name(stmts[si])
                if (fn_name.length() > 0 and gen.extend_map.has(prefix + fn_name)) {
                    gen.pending_extend_class = gen.extend_map.get(prefix + fn_name)
                } else {
                    gen.pending_extend_class = ""
                }
                gen.gen_stmt(stmts[si])
            }
            si = si + 1
        }

        // Check if module has top-level code (VarDecl, ExprStmt, etc.)
        var has_top: Bool = false
        si = 0
        while (si < stmts.length()) {
            if (!gen.is_decl(stmts[si])) {
                has_top = true
            }
            si = si + 1
        }

        // Wrap module's top-level code in an init function
        if (has_top) {
            var init_name: String = "__mod_init_" + prefix.slice(0, prefix.length() - 1)
            gen.known_functions.push(init_name)
            module_init_names.push(init_name)
            gen.emit("")
            gen.emit("define i64 @" + init_name + "() {")
            gen.emit("entry:")
            gen.block_terminated = false
            gen.reset_locals()
            // Alloca vars for module-level VarDecls
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            si = 0
            while (si < stmts.length()) {
                if (!gen.is_decl(stmts[si])) {
                    var single_list: List<AST.Stmt> = []
                    single_list.push(stmts[si])
                    gen.collect_vars(single_list, top_vars, top_var_types)
                }
                si = si + 1
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                var vn: String = top_vars[vi]
                if (!gen.module_globals.has(prefix + vn)) {
                    gen.emit_indent("%" + gen.sanitize_name(vn) + " = alloca i64")
                }
                vi = vi + 1
            }
            si = 0
            while (si < stmts.length()) {
                if (!gen.is_decl(stmts[si])) {
                    gen.gen_stmt(stmts[si])
                }
                si = si + 1
            }
            if (!gen.block_terminated) {
                gen.emit_indent("ret i64 0")
            }
            gen.emit("}")
            gen.block_terminated = false
        }

        mi = mi + 1
    }

    // Then compile the main program without prefix
    gen.current_prefix = ""
    return gen.generate(program)
}

fun generate_with_modules_flat(program: List<AST.Stmt>, all_stmts: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, alias_map: Map<String, String>): String {
    var gen: Codegen = Codegen()
    gen.module_prefixes = alias_map
    gen.register_only = false
    var prefixes: List<String> = prefixes_joined.split("|")
    var dbgi: Float = 0
    while (dbgi < prefixes.length()) {
        dbgi = dbgi + 1
    }

    // Register runtime functions
    gen.known_functions.push("StringBuilder")
    gen.known_functions.push("__list_new")
    gen.known_functions.push("__list_push")
    gen.known_functions.push("__list_get")
    gen.known_functions.push("__list_set")
    gen.known_functions.push("__list_length")
    gen.known_functions.push("__list_pop")
    gen.known_functions.push("__sb_append")
    gen.known_functions.push("__sb_to_string")
    gen.known_functions.push("__safe_strcmp")
    gen.known_functions.push("__map_new")
    gen.known_functions.push("__map_set")
    gen.known_functions.push("__map_get")
    gen.known_functions.push("__map_has")
    gen.known_functions.push("__map_keys")
    gen.known_functions.push("__str_ends_with")
    gen.known_functions.push("__str_split")
    gen.known_functions.push("__str_replace")
    gen.known_functions.push("__int_to_string")
    gen.known_functions.push("__list_join")
    gen.known_functions.push("__join_append")
    gen.known_functions.push("__list_contains")
    gen.known_functions.push("__io_read_file")
    gen.known_functions.push("__io_write_file")
    gen.known_functions.push("__io_file_exists")
    gen.known_functions.push("__io_mkdir")
    gen.known_functions.push("__io_walk_dir")
    gen.known_functions.push("__io_append_file")
    gen.known_functions.push("__os_exec")
    gen.known_functions.push("__os_args")
    gen.known_functions.push("__os_cwd")
    gen.known_functions.push("__os_path_sep")
    gen.known_functions.push("__os_platform")
    gen.known_functions.push("__os_env")
    gen.func_ret_types.set("StringBuilder", "StringBuilder")

    // Pre-scan: register module-level VarDecls as globals
    var mi: Float = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        var si: Float = start
        while (si < end) {
            if (!gen.is_decl(all_stmts[si])) {
                var stmt_kind: String = gen.classify_stmt(all_stmts[si])
                if (stmt_kind == "var") {
                    var vname: String = match (all_stmts[si]) { VarDecl(n, t, i, d) => n
                        _ => ""
                    }
                    var vdoc3: String = gen.get_var_doc(all_stmts[si])
                    if (!vdoc3.starts_with("@import:")) {
                        gen.module_globals.set(prefix + vname, true)
                        gen.globals.push("@__g_" + prefix + gen.sanitize_name(vname) + " = global i64 0\n")
                    }
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-scan: register extension methods from all modules
    // This reads FunDecl doc fields early before potential memory issues
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var fdoc: String = gen.get_fun_doc(all_stmts[si])
            if (fdoc.starts_with("@extend:")) {
                var fname: String = gen.get_fun_name(all_stmts[si])
                var ext_cls: String = fdoc.slice(8, fdoc.length())
                gen.extend_map.set(prefix + fname, ext_cls)
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-register main program's class declarations so imported modules'
    // extend funs can reference class fields without crashing on null map lookups.
    var pri: Float = 0
    while (pri < program.length()) {
        var pr_kind: String = gen.classify_stmt(program[pri])
        if (pr_kind == "class") {
            var pr_name: String = match (program[pri]) { ClassDecl(n, p, f, m, d) => n
                _ => ""
            }
            var pr_parent: String = match (program[pri]) { ClassDecl(n, p, f, m, d) => p
                _ => ""
            }
            var pr_fields: List<AST.Param> = match (program[pri]) { ClassDecl(n, p, f, m, d) => f
                _ => []
            }
            var pr_methods: List<AST.Stmt> = match (program[pri]) { ClassDecl(n, p, f, m, d) => m
                _ => []
            }
            if (pr_name.length() > 0) {
                var pr_fields_str: String = gen.params_to_string(pr_fields)
                var pr_all_fields: String = pr_fields_str
                if (pr_parent.length() > 0 and gen.class_fields.has(pr_parent)) {
                    var pr_parent_fields: String = gen.class_fields.get(pr_parent)
                    if (pr_parent_fields.length() > 0) {
                        if (pr_all_fields.length() > 0) {
                            pr_all_fields = pr_parent_fields + "," + pr_all_fields
                        } else {
                            pr_all_fields = pr_parent_fields
                        }
                    }
                }
                gen.class_fields.set(pr_name, pr_all_fields)
                // Register class methods list
                var pr_method_names: List<String> = []
                var pr_mi2: Float = 0
                while (pr_mi2 < pr_methods.length()) {
                    var mname: String = gen.get_fun_name(pr_methods[pr_mi2])
                    if (mname.length() > 0) {
                        pr_method_names.push(mname)
                    }
                    pr_mi2 = pr_mi2 + 1
                }
                gen.class_methods.set(pr_name, pr_method_names)
            }
        }
        pri = pri + 1
    }

    // Compile each module's declarations
    var module_init_names: List<String> = []
    mi = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        gen.current_prefix = prefix

        var si: Float = start
        while (si < end) {
            if (gen.is_decl(all_stmts[si])) {
                // Set pending_extend_class from pre-scanned map before gen_stmt
                var fn_name: String = gen.get_fun_name(all_stmts[si])
                if (fn_name.length() > 0 and gen.extend_map.has(prefix + fn_name)) {
                    gen.pending_extend_class = gen.extend_map.get(prefix + fn_name)
                } else {
                    gen.pending_extend_class = ""
                }
                gen.gen_stmt(all_stmts[si])
            }
            si = si + 1
        }

        // Module top-level code
        var has_top: Bool = false
        si = start
        while (si < end) {
            if (!gen.is_decl(all_stmts[si])) { has_top = true }
            si = si + 1
        }
        if (has_top) {
            var init_name: String = "__mod_init_" + prefix.slice(0, prefix.length() - 1)
            gen.known_functions.push(init_name)
            module_init_names.push(init_name)
            gen.emit("")
            gen.emit("define i64 @" + init_name + "() {")
            gen.emit("entry:")
            gen.block_terminated = false
            gen.reset_locals()
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            si = start
            while (si < end) {
                if (!gen.is_decl(all_stmts[si])) {
                    var single_list: List<AST.Stmt> = []
                    single_list.push(all_stmts[si])
                    gen.collect_vars(single_list, top_vars, top_var_types)
                }
                si = si + 1
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                var vn: String = top_vars[vi]
                if (!gen.module_globals.has(prefix + vn)) {
                    gen.emit_indent("%" + gen.sanitize_name(vn) + " = alloca i64")
                }
                vi = vi + 1
            }
            si = start
            while (si < end) {
                if (!gen.is_decl(all_stmts[si])) {
                    gen.gen_stmt(all_stmts[si])
                }
                si = si + 1
            }
            if (!gen.block_terminated) {
                gen.emit_indent("ret i64 0")
            }
            gen.emit("}")
            gen.block_terminated = false
        }

        mi = mi + 1
    }

    gen.current_prefix = ""
    return gen.generate(program)
}
