// LLVM IR code generator for Saffron-mini

import "./ast.sf" as AST
import "./diag.sf" as Diag
import "llvm/types" as LLVMTypes
import "llvm/instructions" as LLVMInst
import "llvm/module" as LLVMMod
import "llvm/function" as LLVMFunc
import "llvm/block" as LLVMBlock
import "llvm/nanbox" as LLVMNanBox

// Runtime function prefix — change this to avoid collisions with user code.
// Currently "__" (e.g., __list_new, __map_get). Could become "__sf_" later.
var RT_PREFIX: String = "__"
var __codegen_errors: Bool = false

class Codegen {
    var sb: StringBuilder
    var label_counter: Float
    var local_counter: Float
    var globals: List<String>
    var string_constants: List<String>
    var block_terminated: Bool
    var enum_defs: Map<String, List<String>>
    var enum_variant_tags: Map<String, Float>
    var enum_variant_fields: Map<String, List<AST.Param>>
    var type_defs: StringBuilder
    var known_functions: List<String>
    var func_ret_types: Map<String, AST.Type>
    // Declared class fields as AST.Param nodes (own + inherited + actor-hidden,
    // in struct-layout order). Same pattern as the checker's class_fields and the
    // enum_variant_fields migration: store nodes, render the legacy "name:Type,…"
    // CSV on read via get_class_fields_str. LOSSY render (type_to_string) — a
    // class field's declared type is only ever consumed by name/index/type, never
    // round-tripped, unlike the loss-less enum payload table.
    var class_fields: Map<String, List<AST.Param>>
    var class_field_list: Map<String, List<String>>
    var class_struct_names: Map<String, String>
    var class_methods: Map<String, List<String>>
    // The declared generic parameter names of each class: `class Box<T>` → ["T"].
    // Keyed by the bare class name, like every other class table. A method
    // declared `fun getItem(k: Int): T` registers "T" as its return type, which
    // names nothing at the IR level; substituting the receiver's own type
    // arguments — `Box<String>` says `T` is `String` — is what lets the next
    // dispatch on the result pick the right arm (BUGS #95).
    var class_type_params: Map<String, List<String>>
    // Methods declared with an empty body. Only these are requirements on a
    // subclass; a parent method WITH a body is simply inherited.
    var class_abstract_methods: Map<String, List<String>>
    var current_class: String
    var current_parent: String
    var current_function_name: String
    // BUGS #175: the function whose nested-fun definitions are currently in scope.
    // While emitting a nested fun `step` declared in `run`, current_function_name
    // is `step` but nested_scope stays `run`, because step's *sibling* nested funs
    // belong to run. This is the qualifier for a nested fun's emitted symbol
    // (run$$helper), so sibling/forward calls resolve to the right one. Empty at
    // module top level.
    var nested_scope: String
    var string_vars: List<String>
    var last_type: AST.Type
    var typed_vars: Map<String, AST.Type>
    var loop_break_label: String
    var loop_continue_label: String
    var current_ret_type: String
    var called_functions: List<String>
    var called_function_arity: Map<String, Float>
    var module_prefixes: Map<String, String>
    // File-scoped alias bindings, keyed `<declaring module prefix>|<alias>`.
    // `module_prefixes` above is the flat whole-program union of every alias in
    // every file, first-writer-wins; this map records who wrote each one, so an
    // alias means what the file that declared it says it means. Read through
    // has_module_alias / module_alias_prefix, never directly (BUGS #123).
    var scoped_module_prefixes: Map<String, String>
    var func_prefix_map: Map<String, String>
    var func_defaults: Map<String, List<AST.Expr>>
    var func_param_count: Map<String, Float>
    var func_param_names: Map<String, List<String>>
    // Declared parameter TYPE spellings, parallel to func_param_names. Populated in
    // gen_function from the same param CSV. Used to resolve a free generic
    // function's return type parameter from its call arguments (BUGS #171): given
    // `fun find<T>(xs: List<T>): T`, func_ret_types holds "T" and this holds
    // ["List<T>"], so a call `find(words)` can bind T to the element type of
    // `words` and dispatch on the result.
    var func_param_type_strs: Map<String, List<String>>
    // Function overloading (arity- and first-param-type-based). Keyed by the
    // *emit_name* (module prefix + bare name), value is the list of mangled
    // per-definition symbols `<emit_name>$<arity>$<firstparamtype>`. Only names
    // with >= 2 definitions in a single prescan slice get an entry, so the whole
    // mechanism is inert for every non-overloaded name — which is mandatory:
    // the compiler self-hosts entirely on non-overloaded names, and cross-module
    // same-name free functions (from/new/parse/...) live in different modules,
    // hence different emit_names and different prescan slices, so they never
    // collide here. gen_function mangles the symbol it emits, prescan_fun_decl
    // keys the signature maps by the mangled name, and gen_call resolves an
    // overloaded callee to the mangled symbol by matching arity + first arg type.
    var overload_sets: Map<String, List<String>>
    // Docstrings of top-level functions and classes, keyed by emit_name (module
    // prefix + bare name). Populated in prescan from the FunDecl/ClassDecl
    // docstring field. gen_func_ref reads it: when a named function/class is used
    // as a VALUE and has a docstring, the closure box's second slot (unused env
    // for a no-capture ref) holds the doc-constant pointer instead of 0, so
    // Reflect.doc can read it back. Empty/absent means no docstring.
    var func_docs: Map<String, String>
    // This module's `//!` docstring, threaded from parse_program via main.sf.
    // Emitted as the constant __reflect_module_doc returns. Empty = nil.
    var module_doc_text: String
    var current_prefix: String
    var module_globals: Map<String, Bool>
    var global_var_types: Map<String, String>
    var register_only: Bool
    var in_function: Bool
    // Names bound by `var`/`let` in the body of the function currently being
    // emitted. A name in here is a local, no matter that module_globals holds a
    // same-named module global (BUGS #59): the alloca and store sites consult
    // this before falling back to module_globals. Empty at top level / module
    // init, where a `var` really is a global.
    var current_fn_locals: Map<String, Bool>
    // Locals of the function currently being emitted that live in a heap cell
    // instead of an alloca, because a nested lambda both captures and writes to
    // them (BUGS #51 defect B). gen_lambda consults this to decide whether the
    // env slot gets the cell pointer or a snapshot of its contents. Saved and
    // restored around each function body, like current_fn_locals.
    var boxed_locals: Map<String, Bool>
    var intrinsic_funcs: List<String>
    var extern_sigs: Map<String, String>
    // Saffron-level parameter types of each `@extern`, comma-joined, keyed by
    // emit name. `extern_sigs` only carries the *C* signature, which cannot
    // distinguish "an i64 holding a machine integer" from "an i64 holding an
    // opaque NaN-boxed value" — and gen_extern_call must untag the first and
    // pass the second through untouched. Only `Any` params are read from here;
    // see the `Any` branch in gen_extern_call for why (BUGS #38).
    var extern_param_types: Map<String, String>
    var defined_funcs: List<String>
    var extend_map: Map<String, String>
    var pending_extend_class: String
    var named_imports: Map<String, String>
    var target: String
    var has_errors: Bool
    var module_init_names: List<String>
    var identity_mode: Bool
    var coroutine_funcs: List<String>
    var inline_funcs: List<String>
    var is_coroutine: Bool
    // True once codegen emits anything that makes the ambient scheduler's queues
    // reachable at runtime: a Task.spawn/enqueue, or a boot wrapper that runs the
    // scheduler because the entry (or main) is a coroutine. The scheduler is
    // ALWAYS linked (ambient runtime, BUGS #181), but its module-init — which
    // allocates ~13 global collections — is only CALLED when this is set. A
    // coroutine-free program leaves the scheduler globals at their static `0`
    // (nil), makes zero startup allocations, and -O2 drops the dead scheduler
    // code, so it is byte-for-byte the pre-#181 program. Without this gate every
    // program paid 28 startup allocations, which shifted the GC threshold and
    // broke gc_test/gc_api_test (allocation counts) and enum_payload_any (a
    // collection landing mid-format on an unrooted temporary).
    var scheduler_used: Bool
    var use_llvm_lib: Bool
    var emit_llvm_lib: Bool
    var gc_root_count: Float
    var class_type_ids: Map<String, Float>
    var next_class_type_id: Float
    // GC type tag of each payload-carrying enum, drawn from the SAME counter as
    // class_type_ids. Sharing the counter is the point, not an economy:
    // __val_class_tag answers with one number space, so an enum tag that
    // duplicated a class tag would make __val_to_string call the wrong
    // to_string. Fieldless enums are absent — their value is the immediate
    // `tag << 56`, which has no allocation to hang a header on (BUGS #154).
    var enum_type_ids: Map<String, Float>
    // Parent of each class that has one. gen_class_decl_with_parents is *handed*
    // the parent name and used to discard it after inheriting fields and
    // methods, which made the hierarchy look unavailable to codegen (it is not
    // — only checker.sf recorded it). Writing it down here is what lets
    // __class_is_a answer `d is Animal` for a Dog, which no amount of
    // compile-time folding can (BUGS #61, #50).
    var class_parent_of: Map<String, String>
    // Every declared base of each class, struct-keyed like class_parent_of.
    // class_parent_of above deliberately stays the *primary* base — parents[0] —
    // because that is the one whose field layout the child extends and whose
    // `init` it forwards to; __class_parent_tag still reports exactly it. This
    // map is the full set, and it is what __class_is_a is built from, so
    // `duck is Swimmable` answers true for `class Duck extends Flyable,
    // Swimmable, Walkable` instead of stopping at Flyable.
    var class_parents_of: Map<String, List<String>>
    // Methods a class declares *itself* (real symbols, not inherited forwarders),
    // and the bare (unprefixed) name for each struct name. Both keyed by struct
    // name and populated in the generate() pre-registration pass, before the
    // forwarder logic in gen_class_decl_with_parents pushes inherited names into
    // class_methods — that mixing is why class_methods can't answer "does this
    // class override the method" on its own. gen_virtual_dispatch (BUGS #50)
    // needs exactly that: to switch a call on the receiver's runtime tag it must
    // know which descendants change the method's behaviour.
    var class_own_methods: Map<String, List<String>>
    // The methods a class DECLARES abstractly (bodyless). Deliberately disjoint
    // from class_own_methods, which means "has a callable symbol of its own" —
    // an abstract method has no body to dispatch to, so it must not be an
    // answer to "who implements this". But gen_virtual_dispatch also used
    // class_own_methods to decide "does the receiver's type know this method at
    // all", and an interface answered no to that, so it bailed and left the
    // static call to the interface's empty stub in place: every call through an
    // interface-typed receiver was a silent no-op (BUGS #150). This table
    // separates the two questions, keyed on the struct name like its sibling.
    var class_own_abstract: Map<String, List<String>>
    var class_bare_of: Map<String, String>
    var llvm_module: LLVMMod.Module
    var llvm_func_builder: LLVMFunc.FunctionBuilder
    var llvm_block_builder: LLVMBlock.BlockBuilder
    var llvm_values: Map<String, Any>
    var actor_classes: Map<String, Bool>
    var force_next_lambda_coro: Bool
    var check_spawn_sendable: Bool

    fun init() {
        this.sb = StringBuilder()
        this.label_counter = 0
        this.local_counter = 0
        this.globals = []
        this.string_constants = []
        this.block_terminated = false
        this.enum_defs = {}
        this.enum_variant_tags = {}
        this.enum_variant_fields = {}
        this.type_defs = StringBuilder()
        this.known_functions = []
        this.func_ret_types = {}
        this.class_fields = {}
        this.class_field_list = {}
        this.class_struct_names = {}
        this.class_methods = {}
        this.class_type_params = {}
        this.class_abstract_methods = {}
        this.current_class = ""
        this.current_parent = ""
        this.current_function_name = ""
        this.nested_scope = ""
        this.string_vars = []
        this.last_type = AST.Type.IntType
        this.typed_vars = {}
        this.loop_break_label = ""
        this.loop_continue_label = ""
        this.current_ret_type = "i64"
        this.called_functions = []
        this.called_function_arity = {}
        this.module_prefixes = {}
        this.scoped_module_prefixes = {}
        this.func_prefix_map = {}
        this.func_defaults = {}
        this.func_param_count = {}
        this.func_param_names = {}
        this.func_param_type_strs = {}
        this.overload_sets = {}
        this.func_docs = {}
        this.module_doc_text = ""
        this.current_prefix = ""
        this.module_globals = {}
        this.global_var_types = {}
        this.register_only = false
        this.in_function = false
        this.current_fn_locals = {}
        this.boxed_locals = {}
        this.intrinsic_funcs = []
        this.extern_sigs = {}
        this.extern_param_types = {}
        this.defined_funcs = []
        this.extend_map = {}
        this.pending_extend_class = ""
        this.named_imports = {}
        this.target = "native"
        this.has_errors = false
        this.module_init_names = []
        this.identity_mode = false
        this.coroutine_funcs = []
        this.inline_funcs = []
        this.is_coroutine = false
        this.scheduler_used = false
        this.use_llvm_lib = true
        this.emit_llvm_lib = false
        this.gc_root_count = 0
        this.class_type_ids = {}
        this.next_class_type_id = 10
        this.enum_type_ids = {}
        this.class_parent_of = {}
        this.class_parents_of = {}
        this.class_own_methods = {}
        this.class_own_abstract = {}
        this.class_bare_of = {}
        this.actor_classes = {}
        this.force_next_lambda_coro = false
        this.check_spawn_sendable = false
        this.llvm_module = LLVMMod.Module("saffron_program")
        // Workaround: gen2 doesn't emit init calls for cross-module class constructors.
        // Explicitly call init to set up internal lists/fields.
        this.llvm_module.init("saffron_program")
        var dummy_params: List<LLVMFunc.Param> = []
        this.llvm_func_builder = LLVMFunc.FunctionBuilder("__dummy", LLVMTypes.Type.I64, dummy_params)
        this.llvm_func_builder.init("__dummy", LLVMTypes.Type.I64, dummy_params)
        var dummy_bb: LLVMFunc.BasicBlock = LLVMFunc.BasicBlock("entry")
        dummy_bb.init("entry")
        this.llvm_block_builder = LLVMBlock.BlockBuilder(this.llvm_func_builder, dummy_bb)
        this.llvm_block_builder.init(this.llvm_func_builder, dummy_bb)
        this.llvm_values = {}
        // String methods are dispatched via class_methods (see methods_body.sf)

        // Register built-in type classes in class_methods so method resolution
        // finds them. These mirror the type class definitions in src/lib/*.sf.
        // Methods listed here will be resolved via gen_namespace_call when the
        // receiver's type is known — keeping inline emission for primitives while
        // enabling proper dispatch for user-visible .to_string(), .abs(), etc.
        this.class_methods.set("String", ["length", "char_at", "contains", "starts_with", "ends_with", "index_of", "trim", "to_upper", "to_lower", "slice", "split", "replace", "repeat", "to_string", "to_number"])
        this.class_methods.set("List", ["length", "push", "pop", "get", "set", "remove", "contains", "reverse", "copy", "sort", "slice", "join", "to_string"])
        this.class_methods.set("Map", ["length", "has", "get", "set", "keys", "values", "to_string"])
        this.class_methods.set("Int", ["to_string", "to_float", "abs", "floor", "ceil"])
        this.class_methods.set("Float", ["to_string", "floor", "ceil", "abs"])
        this.class_methods.set("Bool", ["to_string"])

        // HTML element functions (provided by turmeric runtime library)
        this.known_functions.push("div")
        this.known_functions.push("span")
        this.known_functions.push("h1")
        this.known_functions.push("h2")
        this.known_functions.push("h3")
        this.known_functions.push("h4")
        this.known_functions.push("h5")
        this.known_functions.push("h6")
        this.known_functions.push("p")
        this.known_functions.push("button")
        this.known_functions.push("input")
        this.known_functions.push("ul")
        this.known_functions.push("ol")
        this.known_functions.push("li")
        this.known_functions.push("a")
        this.known_functions.push("nav")
        this.known_functions.push("header")
        this.known_functions.push("footer")
        this.known_functions.push("main")
        this.known_functions.push("section")
        this.known_functions.push("form")
        this.known_functions.push("label")
        this.known_functions.push("table")
        this.known_functions.push("tr")
        this.known_functions.push("td")
        this.known_functions.push("th")
        this.known_functions.push("textarea")
        this.known_functions.push("select")
        this.known_functions.push("option")
        this.known_functions.push("pre")
        this.known_functions.push("code")
        this.known_functions.push("br")
        this.known_functions.push("hr")
        this.known_functions.push("img")
        this.known_functions.push("text")
    }

    // Split a string by delimiter, respecting nested <>, () and [] brackets.
    //
    // All three pairs nest, and all three appear in the type strings this splits.
    // Angle brackets were the only pair tracked, which was enough only while no
    // populated function type could reach a parameter list: `type_to_string`
    // renders a FuncType via `func_type_string` as "Fun(A,B):R" — with a PLAIN
    // comma between the parameter types — and `params_to_string` joins parameters
    // with a plain comma too. So `gen_function` splitting "b:Box,f:Fun(Box,Int):String"
    // on top-level commas cut the function type in half and manufactured a fourth
    // "parameter" named "Int)", which `sanitize_name` turned into %Int_ (BUGS #114).
    //
    // That was a silent wrong answer, not a crash: the phantom parameter lands
    // between the real ones, so every later argument is read from the wrong slot.
    // `src/lib/iter.sf`'s `reduce(iterable, func: (R, T) => R, initial)` returned
    // 12 instead of 10 for a sum over [1,2,3,4] because `initial` shifted.
    //
    // `[]` is tracked for the receiver spelling "Fun[Recv](A,B):R", which nests the
    // same way. This mirrors parser.sf's `split_type_args`, with one deliberate
    // difference: a closer only decrements a depth that is actually positive. An
    // unbalanced closer would otherwise drive depth negative, and since the split
    // is gated on `depth == 0`, a single stray ")" would silently disable ALL
    // splitting for the rest of the string — a worse failure than the one being
    // fixed. Clamping degrades to the old paren-blind behaviour instead.
    fun split_respecting_generics(s: String, delim: String): List<String> {
        var result: List<String> = []
        var current: String = ""
        var depth: Float = 0
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "<" or ch == "(" or ch == "[") {
                depth = depth + 1
                current = current + ch
            } else if (ch == ">" or ch == ")" or ch == "]") {
                if (depth > 0) { depth = depth - 1 }
                current = current + ch
            } else if (ch == delim and depth == 0) {
                result.push(current)
                current = ""
            } else {
                current = current + ch
            }
            i = i + 1
        }
        if (current.length() > 0) {
            result.push(current)
        }
        return result
    }

    fun sanitize_name(name: String): String {
        // Prefix reserved LLVM names to avoid collisions with labels
        if (name == "entry" or name == "end" or name == "loop" or name == "body") {
            return "v_" + name
        }
        // ...and with fresh_local()'s temporaries, which are `%t<counter>`. A
        // user variable named `t1` emitted `%t1` alongside codegen's own `%t1`
        // and the module failed to assemble with "multiple definition of local
        // value named 't1'" — no source location, no hint that the *name* was
        // the problem. `t1`/`t2` are ordinary names for tasks or temporaries, so
        // this was easy to hit; it is what blocked the #38 async repro.
        //
        // Renaming here rather than changing fresh_local()'s prefix keeps it to
        // one edit: sanitize_name is the single funnel every local name goes
        // through, whereas `%t` is baked into thousands of lines of expected IR.
        if (this.is_temp_local_name(name)) {
            return "v_" + name
        }
        var sb: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < name.length()) {
            var ch: String = name.char_at(i)
            if (ch == "." or ch == "(" or ch == ")") {
                sb.append("_")
            } else if (ch == "*") {
                // Variadic marker (`*nums`) — dropped from the emitted register
                // name so `%nums.arg` / `%nums` are valid LLVM. The marker is kept
                // in func_param_names for call-site variadic detection.
                sb.append("")
            } else {
                sb.append(ch)
            }
            i = i + 1
        }
        return sb.to_string()
    }

    /// True for exactly the names fresh_local() can produce: `t` followed by one
    /// or more digits. `t`, `t1x` and `tone` are left alone — only the shapes
    /// that can actually collide are renamed, so ordinary names keep the
    /// spelling that appears in diagnostics and IR.
    fun is_temp_local_name(name: String): Bool {
        if (name.length() < 2) { return false }
        if (name.char_at(0) != "t") { return false }
        var i: Float = 1
        while (i < name.length()) {
            // Same digit test the lexer uses (lexer.sf:128), rather than a `<`
            // comparison on Strings.
            if (!"0123456789".contains(name.char_at(i))) { return false }
            i = i + 1
        }
        return true
    }

    fun fresh_label(prefix: String): String {
        this.label_counter = this.label_counter + 1
        return prefix + this.label_counter.floor().to_string()
    }

    fun fresh_local(): String {
        this.local_counter = this.local_counter + 1
        return "%t" + this.local_counter.floor().to_string()
    }

    fun reset_locals() {
        this.local_counter = 0
    }

    fun set_last_type(t: AST.Type) {
        this.last_type = t
    }

    fun set_current_class(c: String) {
        this.current_class = c
    }

    fun set_current_prefix(p: String) {
        this.current_prefix = p
    }

    fun emit(line: String) {
        this.sb.append(line)
        this.sb.append("\n")
    }

    /// Report a codegen error: print the `[codegen] Error: ...` line exactly as
    /// before, set the has_errors flag, and record it into the shared Diag sink so
    /// --json and the LSP can read it as data. `msg` is the full message minus the
    /// `[codegen] Error: ` prefix, which this adds — so the console output is
    /// byte-for-byte what it was, and the sink stores the clean message.
    ///
    /// The span is span_none(): codegen errors are about expressions, and
    /// expression nodes do not carry spans yet (that is the next stage). When they
    /// do, this gains a located sibling and these calls pass the offending node's
    /// span.
    fun codegen_error(msg: String) {
        // The sink record is unconditional; the console line is suppressed in
        // --json mode so stdout stays parseable JSON. See Diag.set_quiet.
        if (!Diag.is_quiet()) { IO.println("[codegen] Error: " + msg) }
        this.has_errors = true
        Diag.record_error("codegen", AST.span_none(), msg)
    }

    fun emit_indent(line: String) {
        if (this.block_terminated) return nil
        this.sb.append("  ")
        this.sb.append(line)
        this.sb.append("\n")
    }

    fun emit_terminator(line: String) {
        if (this.block_terminated) return nil
        this.sb.append("  ")
        this.sb.append(line)
        this.sb.append("\n")
        this.block_terminated = true
    }

    // --- Pointer ↔ value helpers (wasm32-aware) ---
    // On wasm32, pointers are i32 but value slots are i64.
    // These helpers insert the necessary i32↔i64 conversions.

    fun ptr_to_val(ptr_reg: String): String {
        // Convert an i8* pointer register to an i64 value
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = ptrtoint i8* " + ptr_reg + " to i32")
            var i64_reg: String = this.fresh_local()
            this.emit_indent(i64_reg + " = zext i32 " + i32_reg + " to i64")
            return i64_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = ptrtoint i8* " + ptr_reg + " to i64")
        return reg
    }

    fun val_to_ptr(val_reg: String): String {
        // Convert an i64 value to an i8* pointer register
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = trunc i64 " + val_reg + " to i32")
            var ptr_reg: String = this.fresh_local()
            this.emit_indent(ptr_reg + " = inttoptr i32 " + i32_reg + " to i8*")
            return ptr_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = inttoptr i64 " + val_reg + " to i8*")
        return reg
    }

    fun typed_ptr_to_val(ptr_reg: String, ptr_type: String): String {
        // Convert a typed pointer (e.g. [2 x i64]*) to an i64 value
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = ptrtoint " + ptr_type + " " + ptr_reg + " to i32")
            var i64_reg: String = this.fresh_local()
            this.emit_indent(i64_reg + " = zext i32 " + i32_reg + " to i64")
            return i64_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = ptrtoint " + ptr_type + " " + ptr_reg + " to i64")
        return reg
    }

    fun val_to_typed_ptr(val_reg: String, ptr_type: String): String {
        // Convert an i64 value to a typed pointer (e.g. [2 x i64]*)
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = trunc i64 " + val_reg + " to i32")
            var ptr_reg: String = this.fresh_local()
            this.emit_indent(ptr_reg + " = inttoptr i32 " + i32_reg + " to " + ptr_type)
            return ptr_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = inttoptr i64 " + val_reg + " to " + ptr_type)
        return reg
    }

    fun fn_ptr_to_val(fn_type_str: String, fn_name: String): String {
        // Convert a function pointer (@name with type) to an i64 value
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = ptrtoint " + fn_type_str + " " + fn_name + " to i32")
            var i64_reg: String = this.fresh_local()
            this.emit_indent(i64_reg + " = zext i32 " + i32_reg + " to i64")
            return i64_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = ptrtoint " + fn_type_str + " " + fn_name + " to i64")
        return reg
    }

    fun val_to_fn_ptr(val_reg: String, fn_type: String): String {
        // Convert an i64 value to a function pointer
        if (this.target == "wasm32") {
            var i32_reg: String = this.fresh_local()
            this.emit_indent(i32_reg + " = trunc i64 " + val_reg + " to i32")
            var ptr_reg: String = this.fresh_local()
            this.emit_indent(ptr_reg + " = inttoptr i32 " + i32_reg + " to " + fn_type)
            return ptr_reg
        }
        var reg: String = this.fresh_local()
        this.emit_indent(reg + " = inttoptr i64 " + val_reg + " to " + fn_type)
        return reg
    }

    fun malloc_size_arg(size_reg: String): String {
        // malloc always takes i64 (runtime truncates internally for wasm32)
        return size_reg
    }

    fun malloc_size_type(): String {
        return "i64"
    }

    fun start_block(label: String) {
        this.emit(label + ":")
        this.block_terminated = false
    }

    // --- Type mapping ---

    fun llvm_type(t: String): String {
        if (t == "Int") return "i64"
        if (t == "Float") return "i64"
        if (t == "Bool") return "i64"
        if (t == "String") return "i64"
        if (t == "Nil") return "i64"
        if (t == "Any") return "i64"
        if (t == "List") return "i64"
        if (t == "Map") return "i64"
        return "i64"
    }

    // --- String constants ---

    fun add_string_constant(s: String): String {
        var idx: Float = this.string_constants.length()
        var name: String = "@.str." + idx.floor().to_string()
        this.string_constants.push(s)
        return name
    }

    fun emit_string_constants() {
        var i: Float = 0
        while (i < this.string_constants.length()) {
            var s: String = this.string_constants[i]
            var name: String = "@.str." + i.floor().to_string()
            var len: Float = s.length() + 1
            this.emit(name + " = private unnamed_addr constant [" + len.to_string() + " x i8] c\"" + this.escape_llvm_string(s) + "\\00\"")
            i = i + 1
        }
    }

    fun escape_llvm_string(s: String): String {
        var result: StringBuilder = StringBuilder()
        var i: Float = 0
        while (i < s.length()) {
            var ch: String = s.char_at(i)
            if (ch == "\n") { result.append("\\0A") }
            else if (ch == "\r") { result.append("\\0D") }
            else if (ch == "\t") { result.append("\\09") }
            else if (ch == "\\") { result.append("\\5C") }
            else if (ch == "\"") { result.append("\\22") }
            else { result.append(ch) }
            i = i + 1
        }
        return result.to_string()
    }

    // --- Expression codegen ---
    // Returns the LLVM local name holding the result
    // Sets this.last_type to the Saffron type of the result
    // @codegen-split: types
    // @codegen-split: expr
    // @codegen-split: match
    // @codegen-split: closures
    // @codegen-split: intrinsics
    // @codegen-split: stmts
    // @codegen-split: utils
    // @codegen-split: output
    // @codegen-split: methods
}

fun generate(program: List<AST.Stmt>): String {
    var gen: Codegen = Codegen()
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

// BUGS #188: `module_doc` is the entry file's `//!` text (Parser.module_doc()),
// so Reflect.module_doc() returns it instead of nil. Additive `opts4` wrapper;
// the older arities delegate with "" (they have no module doc to pass).
fun generate_with_target_opts4(program: List<AST.Stmt>, target: String, identity_mode: Bool, use_llvm_lib: Bool, emit_llvm_lib: Bool, module_doc: String): String {
    var gen: Codegen = Codegen()
    gen.target = target
    gen.identity_mode = identity_mode
    gen.use_llvm_lib = use_llvm_lib
    gen.emit_llvm_lib = emit_llvm_lib
    gen.module_doc_text = module_doc
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

/// BUGS #188: `module_doc` is the entry file's `//!` text (Parser.module_doc()),
/// threaded to gen.module_doc_text so Reflect.module_doc() returns it instead of
/// nil. Additive `opts5` wrapper; older arities delegate with "".
fun generate_with_modules_flat_opts5(program: List<AST.Stmt>, all_stmts: List<AST.Stmt>, boundaries: List<Float>, prefixes_joined: String, alias_map: Map<String, String>, target: String, named_imports: Map<String, String>, identity_mode: Bool, use_llvm_lib: Bool, emit_llvm_lib: Bool, scoped_aliases: Map<String, String>, module_doc: String): String {
    var gen: Codegen = Codegen()
    gen.scoped_module_prefixes = scoped_aliases
    gen.target = target
    gen.identity_mode = identity_mode
    gen.use_llvm_lib = use_llvm_lib
    gen.emit_llvm_lib = emit_llvm_lib
    gen.module_doc_text = module_doc
    // Reflect runtime functions (generated at end of compilation)
    gen.known_functions.push("__reflect_get_fields")
    gen.known_functions.push("__reflect_class_name")
    gen.known_functions.push("__reflect_is_class")
    gen.known_functions.push("__reflect_construct_from_map")
    gen.known_functions.push("__reflect_number_to_string")
    gen.known_functions.push("__reflect_doc")
    gen.known_functions.push("__reflect_module_doc")
    gen.known_functions.push("__gc_get_type_tag")
    gen.module_prefixes = alias_map
    // `IO` keeps a hard-wired prefix because it is implicit: a file with no
    // imports at all can still call IO.println, so there is no import statement
    // to derive an alias from. But the hard-wiring must not overwrite one that
    // IS there. `import "@io" as IO` used to be clobbered back to "__io_" here,
    // which sent every call to a runtime symbol — so `IO.open(p, m)` became
    // `@__io_open`, a function that does not exist, and the program failed at
    // link time with an undefined symbol and no diagnostic. The same held for
    // `bytes_alloc`, `bytes_from_string`, `read_file_bytes` and
    // `write_file_bytes`: all four are written in Saffron in src/lib/io.sf and
    // no runtime symbol backs them. Deferring to alias_map lets an explicit
    // import reach the module, exactly as any other alias does.
    if (!alias_map.has("IO")) {
        gen.module_prefixes.set("IO", "__io_")
    }
    // No hard-wired "OS" prefix. src/lib/os.sf is an ordinary stdlib module, so
    // its alias comes from alias_map like every other import; wiring OS here made
    // it a reserved name and shadowed the module's own Saffron functions.
    // Same deferral as IO/OS above (BUGS #88). Hard-wiring GC to the runtime
    // prefix routed `GC.set_threshold(4096)` straight at @__gc_set_threshold
    // with the argument still NaN-boxed, so 4096 arrived as ~9.2e18; the
    // matching getter re-masked it and read back 4096, hiding the corruption
    // (BUGS #74). src/lib/gc.sf's wrappers untag properly, and deferring to
    // alias_map is what reaches them.
    if (!alias_map.has("GC")) {
        gen.module_prefixes.set("GC", "__gc_")
    }
    // Task is handled by dedicated dispatch (Task.spawn, task.await, etc.)
    // and is NOT a real module prefix — don't register it here.
    gen.module_prefixes.set("Reflect", "stdlib_reflect_")
    gen.named_imports = named_imports
    gen.register_only = false
    var prefixes: List<String> = prefixes_joined.split("|")
    var dbgi: Float = 0
    while (dbgi < prefixes.length()) {
        dbgi = dbgi + 1
    }

    // Register runtime functions
    gen.known_functions.push("StringBuilder")
    gen.known_functions.push("__list_new")
    gen.known_functions.push("__list_push")
    gen.known_functions.push("__list_get")
    gen.known_functions.push("__list_set")
    gen.known_functions.push("__list_length")
    gen.known_functions.push("__list_pop")
    gen.known_functions.push("__sb_append")
    gen.known_functions.push("__sb_to_string")
    gen.known_functions.push("__safe_strcmp")
    gen.known_functions.push("__map_new")
    gen.known_functions.push("__map_set")
    gen.known_functions.push("__map_get")
    gen.known_functions.push("__map_has")
    gen.known_functions.push("__map_keys")
    gen.known_functions.push("__str_ends_with")
    gen.known_functions.push("__str_split")
    gen.known_functions.push("__str_replace")
    gen.known_functions.push("__int_to_string")
    gen.known_functions.push("__list_join")
    gen.known_functions.push("__join_append")
    gen.known_functions.push("__list_contains")
    gen.known_functions.push("__io_read_file")
    gen.known_functions.push("__io_write_file")
    gen.known_functions.push("__io_file_exists")
    gen.known_functions.push("__io_mkdir")
    gen.known_functions.push("__io_walk_dir")
    gen.known_functions.push("__io_append_file")
    // Without these two the bare-call path prefixes them with the module name
    // (stdlib_io___io_file_size), so the stdlib wrappers in src/lib/io.sf that
    // call them link against an undefined symbol. Both are defined in the
    // runtime (runtime.sf __io_file_size / __io_read_binary) — BUGS #85.
    gen.known_functions.push("__io_file_size")
    gen.known_functions.push("__io_read_binary")
    gen.known_functions.push("__io_is_dir")
    gen.known_functions.push("__io_rename")
    gen.known_functions.push("__io_delete_file")
    gen.known_functions.push("__os_set_env")
    gen.known_functions.push("__os_home")
    gen.known_functions.push("__io_read_stdin")
    gen.known_functions.push("__io_readline")
    gen.known_functions.push("__os_exec")
    gen.known_functions.push("__os_args")
    gen.known_functions.push("__os_cwd")
    gen.known_functions.push("__os_path_sep")
    gen.known_functions.push("__os_platform")
    gen.known_functions.push("__os_env")
    gen.known_functions.push("__os_system")
    // The io.sf wrappers `println`/`print` call these by bare name (they cannot
    // use an extern: an i64 extern param is untagged, which destroys the NaN-box
    // tag `__io_println_any` dispatches on). Without them here the bare-call path
    // prefixes them with the module name (stdlib_io___io_println) and the wrapper
    // links against an undefined symbol — the same shape as BUGS #85. Both are
    // already in runtime_declares().
    gen.known_functions.push("__io_println")
    gen.known_functions.push("__io_print")
    // The for-in element read (BUGS #62). Needed here for the same reason as the
    // two above: without it the auto-declare loop in output_body.sf emits a
    // `declare i64 @__any_iter_get(i64)` at its default arity of 1, which
    // redefines the two-argument declare runtime_declares() already emitted, and
    // the module fails to link. Same shape as BUGS #85. It IS in
    // runtime_declares(), so nothing is lost by suppressing the auto-declare.
    gen.known_functions.push("__any_iter_get")
    gen.func_ret_types.set("StringBuilder", gen.str_to_type("StringBuilder"))

    // Pre-scan: register module-level VarDecls as globals
    var mi: Float = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        var si: Float = start
        while (si < end) {
            if (!gen.is_decl(all_stmts[si])) {
                var stmt_kind: String = gen.classify_stmt(all_stmts[si])
                if (stmt_kind == "var") {
                    var vname: String = match (all_stmts[si]) { VarDecl(n, t, i, d, v_vis, __ns, __fs) => n
                        _ => ""
                    }
                    var vdoc3: String = gen.get_var_doc(all_stmts[si])
                    if (!vdoc3.starts_with("@import:")) {
                        gen.module_globals.set(prefix + vname, true)
                        gen.globals.push("@__g_" + prefix + gen.sanitize_name(vname) + " = global i64 0\n")
                        // Pre-register global variable type so functions compiled
                        // before the module init can resolve list/map/string dispatch
                        var vann3: AST.Type = gen.get_var_type(all_stmts[si])
                        var vtype3: String = ""
                        if (!gen.is_unknown_type(vann3)) {
                            vtype3 = gen.type_to_string(vann3)
                        }
                        // Infer from the initializer when unannotated (BUGS #36) —
                        // see the note at the first module-global pre-scan, including
                        // why this asks only whether an annotation exists (#160).
                        if (gen.is_unknown_type(vann3)) {
                            var vinit3: String = gen.get_expr_type(gen.get_var_init(all_stmts[si]))
                            if (vinit3.starts_with("List") or vinit3.starts_with("Map") or vinit3 == "String") {
                                vtype3 = vinit3
                            }
                        }
                        // Including "Any" — see the note at the first pre-scan.
                        if (vtype3.length() > 0) {
                            gen.global_var_types.set(vname, vtype3)
                            gen.global_var_types.set(prefix + vname, vtype3)
                        }
                    }
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-scan: register extension methods from all modules
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var fdoc: String = gen.get_fun_doc(all_stmts[si])
            if (fdoc.starts_with("@extend:")) {
                var fname: String = gen.get_fun_name(all_stmts[si])
                var ext_cls: String = fdoc.slice(8, fdoc.length())
                gen.extend_map.set(prefix + fname, ext_cls)
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-register class declarations from ALL modules
    mi = 0
    while (mi < prefixes.length()) {
        prefix = prefixes[mi]
        start = boundaries[mi]
        end = boundaries[mi + 1]
        si = start
        while (si < end) {
            var mod_kind: String = gen.classify_stmt(all_stmts[si])
            if (mod_kind == "class") {
                var mod_name: String = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => n
                    _ => ""
                }
                // Only the primary base contributes fields — see the layout rule in
                // gen_class_decl_with_parents. parents[0] is that base.
                var mod_parent_all: List<String> = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => ps
                    _ => []
                }
                var mod_parent: String = ""
                if (mod_parent_all.length() > 0) { mod_parent = mod_parent_all[0] }
                var mod_fields: List<AST.Param> = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => f
                    _ => []
                }
                var mod_methods: List<AST.Stmt> = match (all_stmts[si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => m
                    _ => []
                }
                if (mod_name.length() > 0) {
                    // Merge parent + own fields as nodes (parent first), matching
                    // gen_class_decl_with_parents. No actor fields here — those are
                    // added only in the real gen pass, which re-sets these keys.
                    var mod_all_fields: List<AST.Param> = gen.concat_params(gen.get_class_field_params(mod_parent), mod_fields)
                    gen.class_fields.set(mod_name, mod_all_fields)
                    gen.class_fields.set(prefix + mod_name, mod_all_fields)
                    var mod_sn: String = mod_name
                    if (prefix.length() > 0) { mod_sn = prefix + mod_name }
                    gen.class_struct_names.set(mod_name, mod_sn)
                    if (prefix.length() > 0) {
                        gen.class_struct_names.set(prefix + mod_name, mod_sn)
                    }
                    var mod_method_names: List<String> = []
                    var mod_mi2: Float = 0
                    while (mod_mi2 < mod_methods.length()) {
                        var mname: String = gen.get_fun_name(mod_methods[mod_mi2])
                        if (mname.length() > 0) {
                            mod_method_names.push(mname)
                        }
                        mod_mi2 = mod_mi2 + 1
                    }
                    gen.class_methods.set(mod_name, mod_method_names)
                    // Declared generic parameter names, kept alongside the method list
                    // so a method returning a class type parameter can be typed at a
                    // call site: `Box<String>` states that `T` is `String` (BUGS #95).
                    var tpm_names: List<String> = match (all_stmts[si]) { ClassDecl(n, tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => tps
                        _ => []
                    }
                    if (tpm_names.length() > 0) {
                        gen.class_type_params.set(mod_name, tpm_names)
                    }
                }
            }
            si = si + 1
        }
        mi = mi + 1
    }

    // Pre-register every imported module's extension-method SYMBOLS (BUGS #103).
    // See Codegen.prescan_extend_symbols for why. Runs AFTER the class
    // pre-registration loop above and not merged into the extend_map pre-scan
    // further up, because extend_class_prefix reads class_struct_names and that
    // loop is what fills it.
    //
    // The main program's own `extend fun`s are registered further down, after its
    // class pre-registration loop — main-program classes are not in
    // class_struct_names yet at this point.
    mi = 0
    while (mi < prefixes.length()) {
        gen.prescan_extend_symbols(all_stmts, boundaries[mi], boundaries[mi + 1], prefixes[mi])
        mi = mi + 1
    }

    // Pre-scan: register main program top-level VarDecls as globals
    var gvi: Float = 0
    while (gvi < program.length()) {
        var gvk: String = gen.classify_stmt(program[gvi])
        if (gvk == "var") {
            var gvname: String = match (program[gvi]) { VarDecl(n, t, ii, d, v_vis, __ns, __fs) => n
                _ => ""
            }
            if (gvname.length() > 0) {
                // A top-level name can be declared more than once (`var b = 6` then
                // `var b = Doughnut()`); both re-use one slot. module_globals dedupes,
                // but the globals LIST did not, so a second decl emitted a duplicate
                // `@__g_b = global i64 0` — `redefinition of global` (BUGS #80). Guard
                // the emission with has() BEFORE set().
                if (!gen.module_globals.has(gvname)) {
                    gen.globals.push("@__g_" + gen.sanitize_name(gvname) + " = global i64 0\n")
                }
                gen.module_globals.set(gvname, true)
                // Pre-register global variable type for method dispatch
                var gvann: AST.Type = gen.get_var_type(program[gvi])
                var gvtype: String = ""
                if (!gen.is_unknown_type(gvann)) {
                    gvtype = gen.type_to_string(gvann)
                }
                // Infer from the initializer when unannotated, exactly as the
                // module-level pre-scan does (BUGS #36). This copy only ever read
                // the annotation, so `var _order = "abc"` in the main program
                // stayed untyped and every method on it misdispatched (#37).
                if (gen.is_unknown_type(gvann)) {
                    var gvinit: String = gen.get_expr_type(gen.get_var_init(program[gvi]))
                    if (gvinit.starts_with("List") or gvinit.starts_with("Map") or gvinit == "String") {
                        gvtype = gvinit
                    }
                }
                // Including "Any" — see the note at the first pre-scan.
                if (gvtype.length() > 0) {
                    gen.global_var_types.set(gvname, gvtype)
                }
            }
        }
        gvi = gvi + 1
    }

    // Pre-register main program's class declarations
    var pri: Float = 0
    while (pri < program.length()) {
        var pr_kind: String = gen.classify_stmt(program[pri])
        if (pr_kind == "class") {
            var pr_name: String = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => n
                _ => ""
            }
            // Only the primary base contributes fields — see the layout rule in
            // gen_class_decl_with_parents. parents[0] is that base.
            var pr_parent_all: List<String> = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => ps
                _ => []
            }
            var pr_parent: String = ""
            if (pr_parent_all.length() > 0) { pr_parent = pr_parent_all[0] }
            var pr_fields: List<AST.Param> = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => f
                _ => []
            }
            var pr_methods: List<AST.Stmt> = match (program[pri]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => m
                _ => []
            }
            if (pr_name.length() > 0) {
                // Merge parent + own fields as nodes (parent first), matching
                // gen_class_decl_with_parents; actor fields are added later in the
                // real gen pass, which re-sets this key.
                var pr_all_fields: List<AST.Param> = gen.concat_params(gen.get_class_field_params(pr_parent), pr_fields)
                gen.class_fields.set(pr_name, pr_all_fields)
                gen.class_struct_names.set(pr_name, pr_name)
                var pr_method_names: List<String> = []
                var pr_mi2: Float = 0
                while (pr_mi2 < pr_methods.length()) {
                    var mname: String = gen.get_fun_name(pr_methods[pr_mi2])
                    if (mname.length() > 0) {
                        pr_method_names.push(mname)
                    }
                    pr_mi2 = pr_mi2 + 1
                }
                gen.class_methods.set(pr_name, pr_method_names)
                // Declared generic parameter names, kept alongside the method list
                // so a method returning a class type parameter can be typed at a
                // call site: `Box<String>` states that `T` is `String` (BUGS #95).
                var tpp_names: List<String> = match (program[pri]) { ClassDecl(n, tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => tps
                    _ => []
                }
                if (tpp_names.length() > 0) {
                    gen.class_type_params.set(pr_name, tpp_names)
                }
            }
        }
        pri = pri + 1
    }

    // The main program's own extension methods (BUGS #103), now that its classes
    // are in class_struct_names. Prefix "" — main program symbols are unprefixed —
    // but the class being extended may live in an imported module, in which case
    // extend_class_prefix returns that module's prefix rather than "". That is the
    // case `extend fun Ctx2.cz()` written in main.sf against a `Ctx2` from
    // core2.sf, which linked against @Ctx2__cz while the definition was
    // @core2_Ctx2__cz.
    gen.prescan_extend_symbols(program, 0, program.length(), "")

    // Coroutine detection
    var cmi: Float = 0
    while (cmi < prefixes.length()) {
        gen.current_prefix = prefixes[cmi]
        var cmi_start: Float = boundaries[cmi]
        var cmi_end: Float = boundaries[cmi + 1]
        var cmi_stmts: List<AST.Stmt> = []
        var cmi_si: Float = cmi_start
        while (cmi_si < cmi_end) {
            cmi_stmts.push(all_stmts[cmi_si])
            cmi_si = cmi_si + 1
        }
        gen.mark_coroutines(cmi_stmts)
        cmi = cmi + 1
    }
    gen.current_prefix = ""
    gen.mark_coroutines(program)

    // Pre-registration pass
    var pr_mi: Float = 0
    while (pr_mi < prefixes.length()) {
        var pr_prefix: String = prefixes[pr_mi]
        var pr_start: Float = boundaries[pr_mi]
        var pr_end: Float = boundaries[pr_mi + 1]
        var pr_si: Float = pr_start
        while (pr_si < pr_end) {
            var pr_kind2: String = gen.classify_stmt(all_stmts[pr_si])
            if (pr_kind2 == "fun") {
                var pr_fname: String = gen.get_fun_name(all_stmts[pr_si])
                if (pr_fname.length() > 0) {
                    var pr_emit: String = pr_prefix + pr_fname
                    if (!gen.str_in_list(gen.known_functions,pr_emit)) {
                        gen.known_functions.push(pr_emit)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname)) {
                        gen.known_functions.push(pr_fname)
                    }
                }
            } else if (pr_kind2 == "class") {
                var pr_cname: String = match (all_stmts[pr_si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => n
                    _ => ""
                }
                if (pr_cname.length() > 0) {
                    var pr_type_name: String = pr_cname
                    if (pr_prefix.length() > 0) {
                        pr_type_name = pr_prefix + pr_cname
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_type_name)) {
                        gen.known_functions.push(pr_type_name)
                    }
                    if (!gen.str_in_list(gen.known_functions,pr_cname)) {
                        gen.known_functions.push(pr_cname)
                    }
                    var pr_methods: List<AST.Stmt> = match (all_stmts[pr_si]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => m
                        _ => []
                    }
                    // The main program's classes get class_own_methods /
                    // class_own_abstract / class_bare_of / a type tag in
                    // generate()'s pre-pass (output_body.sf), but module classes
                    // reach codegen only through THIS loop, which registered method
                    // NAMES and nothing else — so no stdlib class was ever a BUGS
                    // #50 dispatch candidate. A call through an interface- or
                    // base-typed receiver whose type lives in an imported module
                    // (e.g. @log's `List<Handler>`) found no owner and left the
                    // static call to the abstract stub in place, silently
                    // returning 0 (BUGS #150). Fill the same tables here, keyed on
                    // the prefixed struct name — the same key class_struct_names
                    // maps the bare name to further up in this function, which is
                    // what gen_virtual_dispatch resolves the receiver through.
                    // All writes are idempotent with the emit-time ones.
                    var pr_own: List<String> = []
                    var pr_abs: List<String> = []
                    gen.class_bare_of.set(pr_type_name, pr_cname)
                    // An interface is never instantiated, so gen_class_constructor
                    // — the only other place a module class is tagged — is never
                    // reached for it, and gen_virtual_dispatch bails when the
                    // RECEIVER's type has no tag. Assign one here so the switch can
                    // key on the interface.
                    if (!gen.class_type_ids.has(pr_type_name)) {
                        gen.class_type_ids.set(pr_type_name, gen.next_class_type_id)
                        gen.next_class_type_id = gen.next_class_type_id + 1
                    }
                    var pr_mj: Float = 0
                    while (pr_mj < pr_methods.length()) {
                        var pr_mname: String = gen.get_fun_name(pr_methods[pr_mj])
                        if (pr_mname.length() > 0) {
                            if (gen.get_fun_body(pr_methods[pr_mj]).length() > 0) {
                                pr_own.push(pr_mname)
                            } else {
                                pr_abs.push(pr_mname)
                            }
                            var pr_full: String = pr_cname + "__" + pr_mname
                            var pr_prefixed: String = pr_prefix + pr_full
                            if (!gen.str_in_list(gen.known_functions,pr_full)) {
                                gen.known_functions.push(pr_full)
                            }
                            if (!gen.str_in_list(gen.known_functions,pr_prefixed)) {
                                gen.known_functions.push(pr_prefixed)
                            }
                        }
                        pr_mj = pr_mj + 1
                    }
                    gen.class_own_methods.set(pr_type_name, pr_own)
                    gen.class_own_abstract.set(pr_type_name, pr_abs)
                }
            } else if (pr_kind2 == "enum") {
                var pr_ename: String = match (all_stmts[pr_si]) { EnumDecl(n, v, d, e_vis, __ns, __fs) => n
                    _ => ""
                }
                var pr_variants: List<AST.Variant> = match (all_stmts[pr_si]) { EnumDecl(n, v, d, e_vis, __ns, __fs) => v
                    _ => []
                }
                if (pr_ename.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_ename)) {
                        gen.known_functions.push(pr_ename)
                    }
                    if (pr_prefix.length() > 0 and !gen.str_in_list(gen.known_functions,pr_prefix + pr_ename)) {
                        gen.known_functions.push(pr_prefix + pr_ename)
                    }
                }
                var pr_vi: Float = 0
                while (pr_vi < pr_variants.length()) {
                    var pr_vname: String = gen.get_variant_name(pr_variants[pr_vi])
                    if (pr_vname.length() > 0 and !gen.str_in_list(gen.known_functions,pr_vname)) {
                        gen.known_functions.push(pr_vname)
                    }
                    pr_vi = pr_vi + 1
                }
            }
            pr_si = pr_si + 1
        }
        pr_mi = pr_mi + 1
    }
    // Also pre-register main program's declarations
    var pr_pi: Float = 0
    while (pr_pi < program.length()) {
        var pr_pk: String = gen.classify_stmt(program[pr_pi])
        if (pr_pk == "fun") {
            var pr_fname2: String = gen.get_fun_name(program[pr_pi])
            if (pr_fname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_fname2)) {
                gen.known_functions.push(pr_fname2)
            }
        } else if (pr_pk == "class") {
            var pr_cname2: String = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => n
                _ => ""
            }
            var pr_cdoc2: String = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => d
                _ => ""
            }
            if (pr_cdoc2.starts_with("@actor") and pr_cname2.length() > 0) {
                gen.actor_classes.set(pr_cname2, true)
            }
            if (pr_cname2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_cname2)) {
                gen.known_functions.push(pr_cname2)
            }
            var pr_methods2: List<AST.Stmt> = match (program[pr_pi]) { ClassDecl(n, __tps, ps, f, m, d, c_vis, __ns, __fs, __intro) => m
                _ => []
            }
            var pr_mj2: Float = 0
            while (pr_mj2 < pr_methods2.length()) {
                var pr_mname2: String = gen.get_fun_name(pr_methods2[pr_mj2])
                if (pr_mname2.length() > 0) {
                    var pr_full2: String = pr_cname2 + "__" + pr_mname2
                    if (!gen.str_in_list(gen.known_functions,pr_full2)) {
                        gen.known_functions.push(pr_full2)
                    }
                }
                pr_mj2 = pr_mj2 + 1
            }
        } else if (pr_pk == "enum") {
            var pr_ename2: String = match (program[pr_pi]) { EnumDecl(n, v, d, e_vis, __ns, __fs) => n
                _ => ""
            }
            var pr_variants2: List<AST.Variant> = match (program[pr_pi]) { EnumDecl(n, v, d, e_vis, __ns, __fs) => v
                _ => []
            }
            if (pr_ename2.length() > 0 and !gen.str_in_list(gen.known_functions,pr_ename2)) {
                gen.known_functions.push(pr_ename2)
            }
            var pr_vnames2: List<String> = []
            var pr_vi2: Float = 0
            while (pr_vi2 < pr_variants2.length()) {
                var pr_vname2: String = gen.get_variant_name(pr_variants2[pr_vi2])
                // Store AST.Param nodes directly — enum_variant_fields is
                // List<AST.Param> and every reader consumes the nodes.
                var pr_vfields2: List<AST.Param> = gen.get_variant_field_nodes(pr_variants2[pr_vi2])
                if (pr_vname2.length() > 0) {
                    if (!gen.str_in_list(gen.known_functions,pr_vname2)) {
                        gen.known_functions.push(pr_vname2)
                    }
                    pr_vnames2.push(pr_vname2)
                    gen.enum_variant_tags.set(pr_ename2 + "." + pr_vname2, pr_vi2)
                    gen.enum_variant_fields.set(pr_ename2 + "." + pr_vname2, pr_vfields2)
                }
                pr_vi2 = pr_vi2 + 1
            }
            gen.enum_defs.set(pr_ename2, pr_vnames2)
            gen.register_enum_tag(pr_ename2)
        }
        pr_pi = pr_pi + 1
    }

    // Pre-scan: register every module declaration's signature (defaults, param
    // names AND return type) BEFORE any IR generation. One shared implementation
    // — see Codegen.prescan_decls (BUGS #33/#36 had to patch four copies).
    var pre_mi: Float = 0
    while (pre_mi < prefixes.length()) {
        gen.prescan_decls(all_stmts, boundaries[pre_mi], boundaries[pre_mi + 1], prefixes[pre_mi])
        pre_mi = pre_mi + 1
    }
    // Pre-scan the main program's own declarations through the same path.
    // This copy previously omitted func_ret_types entirely, leaving BUGS #33
    // live for top-level functions: a caller declared above its callee inferred
    // Int for the result and every method on it silently fell through (#37).
    gen.prescan_decls(program, 0, program.length(), "")
    // Second global pass, now that func_ret_types exists: type the globals whose
    // initializer is a call (BUGS #146). Modules first, then the main program, in
    // the same order as the prescan above.
    var pg_mi: Float = 0
    while (pg_mi < prefixes.length()) {
        gen.prescan_global_call_types(all_stmts, boundaries[pg_mi], boundaries[pg_mi + 1], prefixes[pg_mi])
        pg_mi = pg_mi + 1
    }
    gen.prescan_global_call_types(program, 0, program.length(), "")

    // Compile each module's declarations
    var module_init_names: List<String> = []
    mi = 0
    while (mi < prefixes.length()) {
        var prefix: String = prefixes[mi]
        var start: Float = boundaries[mi]
        var end: Float = boundaries[mi + 1]
        gen.current_prefix = prefix

        var si: Float = start
        while (si < end) {
            var sk: String = gen.classify_stmt(all_stmts[si])
            if (sk == "fun" or sk == "enum" or sk == "class") {
                var fn_name: String = gen.get_fun_name(all_stmts[si])
                if (fn_name.length() > 0 and gen.extend_map.has(prefix + fn_name)) {
                    gen.pending_extend_class = gen.extend_map.get(prefix + fn_name)
                } else {
                    gen.pending_extend_class = ""
                }
                gen.gen_stmt(all_stmts[si])
            }
            si = si + 1
        }

        // Module top-level code
        var has_top: Bool = false
        si = start
        while (si < end) {
            var sk2: String = gen.classify_stmt(all_stmts[si])
            if (sk2 == "var" or sk2 == "let_pattern") {
                has_top = true
            } else if (sk2 == "expr") {
                if (!gen.is_nil_expr_stmt(all_stmts[si])) {
                    has_top = true
                }
            } else if (sk2 != "fun" and sk2 != "enum" and sk2 != "class") {
                has_top = true
            }
            si = si + 1
        }
        if (has_top) {
            var init_suffix2: String = "prelude_" + mi.to_string()
            if (prefix.length() > 0) {
                init_suffix2 = prefix.slice(0, prefix.length() - 1)
            }
            var init_name: String = "__mod_init_" + init_suffix2
            gen.known_functions.push(init_name)
            module_init_names.push(init_name)
            gen.emit("")
            gen.emit("define i64 @" + init_name + "() {")
            gen.emit("entry:")
            gen.block_terminated = false
            gen.reset_locals()
            var top_vars: List<String> = []
            var top_var_types: List<String> = []
            si = start
            while (si < end) {
                var sk3: String = gen.classify_stmt(all_stmts[si])
                if (sk3 == "var" or sk3 == "let_pattern" or (sk3 == "expr" and !gen.is_nil_expr_stmt(all_stmts[si])) or (sk3 != "fun" and sk3 != "enum" and sk3 != "class" and sk3 != "expr")) {
                    var single_list: List<AST.Stmt> = []
                    single_list.push(all_stmts[si])
                    gen.collect_vars(single_list, top_vars, top_var_types)
                }
                si = si + 1
            }
            var vi: Float = 0
            while (vi < top_vars.length()) {
                var vn: String = top_vars[vi]
                if (!gen.module_globals.has(prefix + vn)) {
                    gen.emit_indent("%" + gen.sanitize_name(vn) + " = alloca i64")
                }
                vi = vi + 1
            }
            si = start
            while (si < end) {
                var sk4: String = gen.classify_stmt(all_stmts[si])
                if (sk4 == "var" or sk4 == "let_pattern") {
                    gen.gen_stmt(all_stmts[si])
                } else if (sk4 == "expr" and !gen.is_nil_expr_stmt(all_stmts[si])) {
                    gen.gen_stmt(all_stmts[si])
                }
                si = si + 1
            }
            // Register module globals as permanent GC roots
            if (!gen.identity_mode and !gen.block_terminated) {
                vi = 0
                while (vi < top_vars.length()) {
                    var gv_name: String = top_vars[vi]
                    var gv_type: String = top_var_types[vi]
                    if (gen.module_globals.has(prefix + gv_name) and gen.is_gc_root_type(gv_type)) {
                        var gv_int: String = gen.typed_ptr_to_val("@__g_" + prefix + gen.sanitize_name(gv_name), "i64*")
                        gen.emit_indent("call void @__gc_push_root(i64 " + gv_int + ")")
                    }
                    vi = vi + 1
                }
            }
            if (!gen.block_terminated) {
                gen.emit_indent("ret i64 0")
            }
            gen.emit("}")
            gen.block_terminated = false
        }

        mi = mi + 1
    }

    gen.current_prefix = ""
    gen.module_init_names = module_init_names
    var result: String = gen.generate(program)
    if (gen.has_errors) { __codegen_errors = true }
    return result
}

fun had_error(): Bool {
    return __codegen_errors
}
