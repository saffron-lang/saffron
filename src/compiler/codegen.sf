// LLVM IR code generator for Saffron-mini

import "./ast.sf" as AST

class Codegen {
    var sb: StringBuilder
    var label_counter: Float
    var local_counter: Float
    var globals: List<String>
    var string_constants: List<String>
    var block_terminated: Bool
    var enum_defs: Map<String, List<String>>
    var enum_variant_tags: Map<String, Float>
    var enum_variant_fields: Map<String, String>
    var type_defs: StringBuilder
    var known_functions: List<String>
    var func_ret_types: Map<String, String>
    var class_fields: Map<String, String>
    var class_methods: Map<String, List<String>>
    var current_class: String
    var string_vars: List<String>
    var last_type: String
    var var_types: Map<String, String>

    fun init() {
        this.sb = StringBuilder()
        this.label_counter = 0
        this.local_counter = 0
        this.globals = []
        this.string_constants = []
        this.block_terminated = false
        this.enum_defs = {}
        this.enum_variant_tags = {}
        this.enum_variant_fields = {}
        this.type_defs = StringBuilder()
        this.known_functions = []
        this.func_ret_types = {}
        this.class_fields = {}
        this.class_methods = {}
        this.current_class = ""
        this.string_vars = []
        this.last_type = "Int"
        this.var_types = {}
    }

    fun fresh_label(prefix: String): String {
        this.label_counter = this.label_counter + 1
        return prefix + this.label_counter.floor().to_string()
    }

    fun fresh_local(): String {
        this.local_counter = this.local_counter + 1
        return "%t" + this.local_counter.floor().to_string()
    }

    fun reset_locals() {
        this.local_counter = 0
    }

    fun emit(line: String) {
        this.sb.append(line)
        this.sb.append("\n")
    }

    fun emit_indent(line: String) {
        if (this.block_terminated) return nil
        this.sb.append("  ")
        this.sb.append(line)
        this.sb.append("\n")
    }

    fun emit_terminator(line: String) {
        if (this.block_terminated) return nil
        this.sb.append("  ")
        this.sb.append(line)
        this.sb.append("\n")
        this.block_terminated = true
    }

    fun start_block(label: String) {
        this.emit(label + ":")
        this.block_terminated = false
    }

    // --- Type mapping ---

    fun llvm_type(t: String): String {
        if (t == "Int") return "i64"
        if (t == "Float") return "double"
        if (t == "Bool") return "i1"
        if (t == "String") return "i64"
        if (t == "Nil") return "void"
        if (t == "Any") return "i64"
        return "i64"
    }

    // --- String constants ---

    fun add_string_constant(s: String): String {
        var idx = this.string_constants.length()
        var name = "@.str." + idx.floor().to_string()
        this.string_constants.push(s)
        return name
    }

    fun emit_string_constants() {
        var i = 0
        while (i < this.string_constants.length()) {
            var s = this.string_constants[i]
            var name = "@.str." + i.floor().to_string()
            var len = s.length() + 1
            this.emit(name + " = private unnamed_addr constant [" + len.to_string() + " x i8] c\"" + this.escape_llvm_string(s) + "\\00\"")
            i = i + 1
        }
    }

    fun escape_llvm_string(s: String): String {
        var result = StringBuilder()
        var i = 0
        while (i < s.length()) {
            var ch = s.char_at(i)
            if (ch == "\n") { result.append("\\0A") }
            else if (ch == "\t") { result.append("\\09") }
            else if (ch == "\\") { result.append("\\5C") }
            else if (ch == "\"") { result.append("\\22") }
            else { result.append(ch) }
            i = i + 1
        }
        return result.to_string()
    }

    // --- Expression codegen ---
    // Returns the LLVM local name holding the result
    // Sets this.last_type to the Saffron type of the result

    fun gen_expr(expr: AST.Expr): String {
        return match (expr) {
            IntLit(v) => {
                this.last_type = "Int"
                var local = this.fresh_local()
                this.emit_indent(local + " = add i64 0, " + v.floor().to_string())
                local
            }
            FloatLit(v) => {
                this.last_type = "Float"
                var local = this.fresh_local()
                this.emit_indent(local + " = fadd double 0.0, " + v.to_string())
                local
            }
            BoolLit(v) => {
                this.last_type = "Bool"
                var local = this.fresh_local()
                var val_str = "0"
                if (v) { val_str = "1" }
                this.emit_indent(local + " = add i1 0, " + val_str)
                local
            }
            StringLit(s) => {
                this.last_type = "String"
                var const_name = this.add_string_constant(s)
                var gep = this.fresh_local()
                var len = s.length() + 1
                this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
                var local = this.fresh_local()
                this.emit_indent(local + " = ptrtoint i8* " + gep + " to i64")
                local
            }
            NilLit => {
                this.last_type = "Nil"
                "0"
            }
            Variable(name) => {
                if (this.var_types.has(name)) {
                    this.last_type = this.var_types.get(name)
                } else {
                    this.last_type = "Int"
                }
                var local = this.fresh_local()
                this.emit_indent(local + " = load i64, i64* %" + name)
                local
            }
            Binary(left, op, right) => {
                this.gen_binary(left, op, right)
            }
            Unary(op, right) => {
                this.gen_unary(op, right)
            }
            Call(callee, args) => {
                this.gen_call(callee, args)
            }
            Assign(name, value) => {
                var val = this.gen_arg_value(value)
                this.emit_indent("store i64 " + val + ", i64* %" + name)
                val
            }
            Logical(left, op, right) => {
                this.gen_logical(left, op, right)
            }
            MemberAccess(object, field) => {
                // Check if object is This -> field access
                if (this.is_this_expr(object)) {
                    return this.gen_get_field(object, field)
                }
                // Check if object is a variable of class type -> field access
                var obj_name = this.get_variable_name(object)
                if (obj_name.length() > 0) {
                    // Check enum first
                    var key = obj_name + "." + field
                    if (this.enum_variant_tags.has(key)) {
                        return this.gen_enum_construct(obj_name, field, [])
                    }
                    // Check if variable holds a class instance
                    if (this.var_types.has(obj_name)) {
                        var vtype = this.var_types.get(obj_name)
                        if (this.class_fields.has(vtype)) {
                            // It's a class instance — do field access
                            var obj_val = this.gen_arg_value(object)
                            var saved_class = this.current_class
                            this.current_class = vtype
                            var field_idx = this.get_field_index(vtype, field)
                            var obj_ptr = this.fresh_local()
                            this.emit_indent(obj_ptr + " = inttoptr i64 " + obj_val + " to %" + vtype + "*")
                            var field_ptr = this.fresh_local()
                            this.emit_indent(field_ptr + " = getelementptr %" + vtype + ", %" + vtype + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
                            var result = this.fresh_local()
                            this.emit_indent(result + " = load i64, i64* " + field_ptr)
                            this.last_type = this.get_field_type(vtype, field)
                            this.current_class = saved_class
                            return result
                        }
                    }
                }
                "0"
            }
            EnumConstruct(enum_name, variant, args) => {
                this.gen_enum_construct(enum_name, variant, args)
            }
            Match(subject, arms) => {
                this.gen_match(subject, arms)
            }
            Lambda(params, ret_type, body) => {
                this.gen_lambda(params, ret_type, body)
            }
            This => {
                this.last_type = this.current_class
                var local = this.fresh_local()
                this.emit_indent(local + " = load i64, i64* %self")
                local
            }
            GetField(object, field) => {
                this.gen_get_field(object, field)
            }
            SetField(object, field, value) => {
                this.gen_set_field(object, field, value)
            }
            ListLit(elements) => {
                this.gen_list_lit(elements)
            }
            IndexGet(object, index) => {
                this.gen_index_get(object, index)
            }
            IndexSet(object, index, value) => {
                this.gen_index_set(object, index, value)
            }
            MethodCall(object, method, args) => {
                this.gen_method_call(object, method, args)
            }
            MapLit => {
                this.last_type = "Map"
                var local = this.fresh_local()
                this.emit_indent(local + " = call i64 @__map_new()")
                local
            }
        }
    }

    fun gen_binary(left: AST.Expr, op: String, right: AST.Expr): String {
        if (op == "+") {
            // Evaluate left to determine its type
            var lhs = this.gen_arg_value(left)
            var left_type = this.last_type
            var rhs = this.gen_arg_value(right)
            var right_type = this.last_type

            if (left_type == "String" or right_type == "String") {
                // String concatenation
                this.last_type = "String"
                var lptr = this.fresh_local()
                this.emit_indent(lptr + " = inttoptr i64 " + lhs + " to i8*")
                var rptr = this.fresh_local()
                this.emit_indent(rptr + " = inttoptr i64 " + rhs + " to i8*")
                var llen = this.fresh_local()
                this.emit_indent(llen + " = call i64 @strlen(i8* " + lptr + ")")
                var rlen = this.fresh_local()
                this.emit_indent(rlen + " = call i64 @strlen(i8* " + rptr + ")")
                var total = this.fresh_local()
                this.emit_indent(total + " = add i64 " + llen + ", " + rlen)
                var total1 = this.fresh_local()
                this.emit_indent(total1 + " = add i64 " + total + ", 1")
                var buf = this.fresh_local()
                this.emit_indent(buf + " = call i8* @malloc(i64 " + total1 + ")")
                this.emit_indent("call i8* @strcpy(i8* " + buf + ", i8* " + lptr + ")")
                this.emit_indent("call i8* @strcat(i8* " + buf + ", i8* " + rptr + ")")
                var result = this.fresh_local()
                this.emit_indent(result + " = ptrtoint i8* " + buf + " to i64")
                return result
            }

            // Integer addition
            this.last_type = "Int"
            var local = this.fresh_local()
            this.emit_indent(local + " = add i64 " + lhs + ", " + rhs)
            return local
        }

        var lhs = this.gen_arg_value(left)
        var rhs = this.gen_arg_value(right)
        var local = this.fresh_local()
        this.last_type = "Int"

        if (op == "-") { this.emit_indent(local + " = sub i64 " + lhs + ", " + rhs) }
        else if (op == "*") { this.emit_indent(local + " = mul i64 " + lhs + ", " + rhs) }
        else if (op == "/") { this.emit_indent(local + " = sdiv i64 " + lhs + ", " + rhs) }
        else if (op == "%") { this.emit_indent(local + " = srem i64 " + lhs + ", " + rhs) }
        else if (op == "&") { this.emit_indent(local + " = and i64 " + lhs + ", " + rhs) }
        else if (op == "|") { this.emit_indent(local + " = or i64 " + lhs + ", " + rhs) }
        else if (op == "^") { this.emit_indent(local + " = xor i64 " + lhs + ", " + rhs) }
        else if (op == "<<") { this.emit_indent(local + " = shl i64 " + lhs + ", " + rhs) }
        else if (op == ">>") { this.emit_indent(local + " = ashr i64 " + lhs + ", " + rhs) }
        else if (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=") {
            this.last_type = "Int"
            var cmp_local = this.fresh_local()
            if (op == "==") { this.emit_indent(cmp_local + " = icmp eq i64 " + lhs + ", " + rhs) }
            else if (op == "!=") { this.emit_indent(cmp_local + " = icmp ne i64 " + lhs + ", " + rhs) }
            else if (op == "<") { this.emit_indent(cmp_local + " = icmp slt i64 " + lhs + ", " + rhs) }
            else if (op == "<=") { this.emit_indent(cmp_local + " = icmp sle i64 " + lhs + ", " + rhs) }
            else if (op == ">") { this.emit_indent(cmp_local + " = icmp sgt i64 " + lhs + ", " + rhs) }
            else if (op == ">=") { this.emit_indent(cmp_local + " = icmp sge i64 " + lhs + ", " + rhs) }
            this.emit_indent(local + " = zext i1 " + cmp_local + " to i64")
        }

        return local
    }

    fun gen_string_concat(left: AST.Expr, right: AST.Expr): String {
        // Flatten string concat at compile time
        var combined = this.flatten_string_expr(left) + this.flatten_string_expr(right)
        var const_name = this.add_string_constant(combined)
        var gep = this.fresh_local()
        var len = combined.length() + 1
        this.emit_indent(gep + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
        var local = this.fresh_local()
        this.emit_indent(local + " = ptrtoint i8* " + gep + " to i64")
        return local
    }

    fun flatten_string_expr(expr: AST.Expr): String {
        var kind = match (expr) {
            StringLit(s) => s
            Binary(l, o, r) => this.flatten_string_expr(l) + this.flatten_string_expr(r)
        }
        return kind
    }

    fun gen_arg_value(expr: AST.Expr): String {
        // Handle specific expression types that don't match reliably in gen_expr
        var expr_kind = this.classify_expr(expr)
        if (expr_kind == "method_call") {
            var mc_obj = match (expr) { MethodCall(o, m, a) => o }
            var mc_method = match (expr) { MethodCall(o, m, a) => m }
            var mc_args = match (expr) { MethodCall(o, m, a) => a }
            return this.gen_method_call(mc_obj, mc_method, mc_args)
        }
        if (expr_kind == "list_lit") {
            var elems = match (expr) { ListLit(e) => e }
            return this.gen_list_lit(elems)
        }
        if (expr_kind == "index_get") {
            var ig_obj = match (expr) { IndexGet(o, i) => o }
            var ig_idx = match (expr) { IndexGet(o, i) => i }
            return this.gen_index_get(ig_obj, ig_idx)
        }
        if (expr_kind == "map_lit") {
            this.last_type = "Map"
            var local = this.fresh_local()
            this.emit_indent(local + " = call i64 @__map_new()")
            return local
        }
        if (expr_kind == "get_field") {
            var gf_obj = match (expr) { GetField(o, f) => o }
            var gf_field = match (expr) { GetField(o, f) => f }
            return this.gen_get_field(gf_obj, gf_field)
        }
        if (expr_kind == "this") {
            this.last_type = this.current_class
            var local = this.fresh_local()
            this.emit_indent(local + " = load i64, i64* %self")
            return local
        }
        if (expr_kind == "set_field") {
            var sf_obj = match (expr) { SetField(o, f, v) => o }
            var sf_field = match (expr) { SetField(o, f, v) => f }
            var sf_val = match (expr) { SetField(o, f, v) => v }
            return this.gen_set_field(sf_obj, sf_field, sf_val)
        }
        if (expr_kind == "binary") {
            var b_left = match (expr) { Binary(l, o, r) => l }
            var b_op = match (expr) { Binary(l, o, r) => o }
            var b_right = match (expr) { Binary(l, o, r) => r }
            return this.gen_binary(b_left, b_op, b_right)
        }
        if (expr_kind == "variable") {
            var vname = match (expr) { Variable(n) => n }
            if (this.var_types.has(vname)) {
                this.last_type = this.var_types.get(vname)
            } else {
                this.last_type = "Int"
            }
            var local = this.fresh_local()
            this.emit_indent(local + " = load i64, i64* %" + vname)
            return local
        }
        if (expr_kind == "member") {
            var m_obj = match (expr) { MemberAccess(o, f) => o }
            var m_field = match (expr) { MemberAccess(o, f) => f }
            // Check if object is This → field access
            var obj_kind = this.classify_expr(m_obj)
            if (obj_kind == "this") {
                return this.gen_get_field(m_obj, m_field)
            }
            // Handle as field access on class instance or enum
            var mn = this.get_variable_name(m_obj)
            if (mn.length() > 0 and this.var_types.has(mn)) {
                var vt = this.var_types.get(mn)
                if (this.class_fields.has(vt)) {
                    var ov = this.gen_arg_value(m_obj)
                    var fi = this.get_field_index(vt, m_field)
                    var op = this.fresh_local()
                    this.emit_indent(op + " = inttoptr i64 " + ov + " to %" + vt + "*")
                    var fp = this.fresh_local()
                    this.emit_indent(fp + " = getelementptr %" + vt + ", %" + vt + "* " + op + ", i32 0, i32 " + fi.floor().to_string())
                    var result = this.fresh_local()
                    this.emit_indent(result + " = load i64, i64* " + fp)
                    this.last_type = this.get_field_type(vt, m_field)
                    return result
                }
            }
            if (mn.length() > 0 and this.enum_variant_tags.has(mn + "." + m_field)) {
                return this.gen_enum_construct(mn, m_field, [])
            }
            return "0"
        }

        // Handle string literals directly
        if (this.is_string_expr(expr)) {
            this.last_type = "String"
            var str_val = this.flatten_string_expr(expr)
            var const_name = this.add_string_constant(str_val)
            var gep = this.fresh_local()
            var slen = str_val.length() + 1
            this.emit_indent(gep + " = getelementptr [" + slen.to_string() + " x i8], [" + slen.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
            var local = this.fresh_local()
            this.emit_indent(local + " = ptrtoint i8* " + gep + " to i64")
            return local
        }
        return this.gen_expr(expr)
    }

    fun gen_string_ptr(expr: AST.Expr): String {
        if (this.is_string_expr(expr)) {
            // String literal: get pointer directly
            var str_val = this.flatten_string_expr(expr)
            var const_name = this.add_string_constant(str_val)
            var ptr = this.fresh_local()
            var slen = str_val.length() + 1
            this.emit_indent(ptr + " = getelementptr [" + slen.to_string() + " x i8], [" + slen.to_string() + " x i8]* " + const_name + ", i64 0, i64 0")
            return ptr
        }
        // Variable or expression: gen_expr gives i64, convert to i8*
        var val = this.gen_arg_value(expr)
        var ptr = this.fresh_local()
        this.emit_indent(ptr + " = inttoptr i64 " + val + " to i8*")
        return ptr
    }

    fun gen_runtime_string_concat(left: AST.Expr, right: AST.Expr): String {
        var lptr = this.gen_string_ptr(left)
        var rptr = this.gen_string_ptr(right)
        // Get lengths
        var llen = this.fresh_local()
        this.emit_indent(llen + " = call i64 @strlen(i8* " + lptr + ")")
        var rlen = this.fresh_local()
        this.emit_indent(rlen + " = call i64 @strlen(i8* " + rptr + ")")
        // Total = llen + rlen + 1
        var total = this.fresh_local()
        this.emit_indent(total + " = add i64 " + llen + ", " + rlen)
        var total1 = this.fresh_local()
        this.emit_indent(total1 + " = add i64 " + total + ", 1")
        // Malloc
        var buf = this.fresh_local()
        this.emit_indent(buf + " = call i8* @malloc(i64 " + total1 + ")")
        // strcpy + strcat
        this.emit_indent("call i8* @strcpy(i8* " + buf + ", i8* " + lptr + ")")
        this.emit_indent("call i8* @strcat(i8* " + buf + ", i8* " + rptr + ")")
        // Return as i64
        var result = this.fresh_local()
        this.emit_indent(result + " = ptrtoint i8* " + buf + " to i64")
        return result
    }

    fun gen_unary(op: String, right: AST.Expr): String {
        var rhs = this.gen_arg_value(right)
        var local = this.fresh_local()

        if (op == "-") { this.emit_indent(local + " = sub i64 0, " + rhs) }
        else if (op == "!") { this.emit_indent(local + " = xor i1 " + rhs + ", true") }
        else if (op == "~") { this.emit_indent(local + " = xor i64 " + rhs + ", -1") }

        return local
    }

    fun gen_call(callee: AST.Expr, args: List<AST.Expr>): String {
        var callee_name = this.resolve_callee(callee)

        // Check if this is an enum constructor
        if (callee_name.contains(".")) {
            var parts = callee_name.split(".")
            if (parts.length() >= 2) {
                var key = parts[0] + "." + parts[1]
                if (this.enum_variant_tags.has(key)) {
                    return this.gen_enum_construct(parts[0], parts[1], args)
                }
            }
        }

        // Check if it's a method call on a class instance: obj.method(args)
        if (callee_name.contains(".") and !callee_name.starts_with("IO")) {
            var parts = callee_name.split(".")
            if (parts.length() >= 2) {
                var obj_name = parts[0]
                var method_name = parts[1]
                // Check if any class has this method
                var class_name = this.find_class_for_method(method_name)
                if (class_name.length() > 0) {
                    var obj_val = this.fresh_local()
                    this.emit_indent(obj_val + " = load i64, i64* %" + obj_name)
                    var arg_strs: List<String> = []
                    arg_strs.push("i64 " + obj_val)
                    var ai = 0
                    while (ai < args.length()) {
                        var val = this.gen_arg_value(args[ai])
                        arg_strs.push("i64 " + val)
                        ai = ai + 1
                    }
                    var full_method = class_name + "__" + method_name
                    var local = this.fresh_local()
                    if (this.get_method_ret(class_name, method_name) == "void") {
                        this.emit_indent("call void @" + full_method + "(" + arg_strs.join(", ") + ")")
                        return "0"
                    }
                    this.emit_indent(local + " = call i64 @" + full_method + "(" + arg_strs.join(", ") + ")")
                    return local
                }
            }
        }

        if (callee_name == "IO.println") {
            var arg_expr = args[0]
            var arg = this.gen_arg_value(arg_expr)
            var arg_type = this.last_type
            var local = this.fresh_local()
            if (arg_type == "String") {
                var str_ptr = this.fresh_local()
                this.emit_indent(str_ptr + " = inttoptr i64 " + arg + " to i8*")
                this.emit_indent(local + " = call i32 @puts(i8* " + str_ptr + ")")
            } else {
                var fmt = this.get_format_ptr("%ld\n")
                this.emit_indent(local + " = call i32 (i8*, ...) @printf(i8* " + fmt + ", i64 " + arg + ")")
            }
            return local
        }
        if (callee_name == "IO.print") {
            var arg_expr = args[0]
            var arg = this.gen_arg_value(arg_expr)
            var arg_type = this.last_type
            var local = this.fresh_local()
            if (arg_type == "String") {
                var str_ptr = this.fresh_local()
                this.emit_indent(str_ptr + " = inttoptr i64 " + arg + " to i8*")
                this.emit_indent(local + " = call i32 (i8*, ...) @printf(i8* " + str_ptr + ")")
            } else {
                var fmt = this.get_format_ptr("%ld")
                this.emit_indent(local + " = call i32 (i8*, ...) @printf(i8* " + fmt + ", i64 " + arg + ")")
            }
            return local
        }

        // Check if it's a known direct function or an indirect call through a variable
        if (this.known_functions.contains(callee_name)) {
            // Direct call to known function
            var arg_strs: List<String> = []
            var i = 0
            while (i < args.length()) {
                var val = this.gen_arg_value(args[i])
                arg_strs.push("i64 " + val)
                i = i + 1
            }
            var local = this.fresh_local()
            this.emit_indent(local + " = call i64 @" + callee_name + "(" + arg_strs.join(", ") + ")")
            // Set last_type from function return type
            if (this.func_ret_types.has(callee_name)) {
                this.last_type = this.func_ret_types.get(callee_name)
            } else {
                this.last_type = "Int"
            }
            return local
        }

        // Indirect call: callee is a variable holding a function pointer
        var ptr_val = this.fresh_local()
        this.emit_indent(ptr_val + " = load i64, i64* %" + callee_name)
        return this.gen_indirect_call(ptr_val, args)
    }

    fun gen_indirect_call(ptr_val: String, args: List<AST.Expr>): String {
        // ptr_val could be either:
        // 1. A plain function pointer (non-capturing lambda)
        // 2. A closure pair pointer: [fn_ptr, env_ptr]
        // We use the closure calling convention for all indirect calls:
        // Unpack [fn_ptr, env_ptr], call fn(env, args...)
        var closure_ptr = this.fresh_local()
        this.emit_indent(closure_ptr + " = inttoptr i64 " + ptr_val + " to [2 x i64]*")

        // Load fn_ptr from slot 0
        var fn_slot = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        var fn_int = this.fresh_local()
        this.emit_indent(fn_int + " = load i64, i64* " + fn_slot)

        // Load env_ptr from slot 1
        var env_slot = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        var env_int = this.fresh_local()
        this.emit_indent(env_int + " = load i64, i64* " + env_slot)

        // Build args: env first, then user args
        var arg_strs: List<String> = []
        arg_strs.push("i64 " + env_int)
        var i = 0
        while (i < args.length()) {
            var val = this.gen_arg_value(args[i])
            arg_strs.push("i64 " + val)
            i = i + 1
        }

        // Build function type: i64 (i64 env, i64 arg1, ...)
        var num_args = args.length() + 1
        var type_parts: List<String> = []
        var ti = 0
        while (ti < num_args) {
            type_parts.push("i64")
            ti = ti + 1
        }
        var fn_type = "i64 (" + type_parts.join(", ") + ")*"

        // Cast and call
        var fn_ptr = this.fresh_local()
        this.emit_indent(fn_ptr + " = inttoptr i64 " + fn_int + " to " + fn_type)
        var local = this.fresh_local()
        this.emit_indent(local + " = call i64 " + fn_ptr + "(" + arg_strs.join(", ") + ")")
        return local
    }

    fun has_string_literal(left: AST.Expr, right: AST.Expr): Bool {
        return this.is_string_expr(left) or this.is_string_expr(right) or this.contains_string_lit(left) or this.contains_string_lit(right) or this.is_string_variable(left) or this.is_string_variable(right)
    }

    fun contains_string_lit(expr: AST.Expr): Bool {
        var kind = match (expr) {
            StringLit(s) => "yes"
            Binary(l, o, r) => {
                if (this.contains_string_lit(l) or this.contains_string_lit(r)) { "yes" } else { "no" }
            }
            IntLit(v) => "no"
            FloatLit(v) => "no"
            BoolLit(v) => "no"
            Variable(n) => "no"
            Unary(o, r) => "no"
            Call(c, a) => "no"
            Assign(n, v) => "no"
            Logical(l, o, r) => "no"
            MemberAccess(o, f) => "no"
            NilLit => "no"
            Match(s, a) => "no"
            EnumConstruct(e, v, a) => "no"
            Lambda(p, r, b) => "no"
            GetField(o, f) => "no"
            SetField(o, f, v) => "no"
            This => "no"
        }
        return kind == "yes"
    }

    fun is_string_variable(expr: AST.Expr): Bool {
        var name = match (expr) {
            Variable(n) => n
            GetField(o, f) => f
            IntLit(v) => ""
            FloatLit(v) => ""
            BoolLit(v) => ""
            StringLit(s) => ""
            NilLit => ""
            Binary(l, o, r) => ""
            Unary(o, r) => ""
            Call(c, a) => ""
            Assign(n, v) => ""
            Logical(l, o, r) => ""
            MemberAccess(o, f) => ""
            Match(s, a) => ""
            EnumConstruct(e, v, a) => ""
            Lambda(p, r, b) => ""
            SetField(o, f, v) => ""
            This => ""
        }
        if (name.length() > 0) {
            if (this.string_vars.contains(name)) return true
            // Check class fields
            if (this.current_class.length() > 0 and this.class_fields.has(this.current_class)) {
                var fields = this.class_fields.get(this.current_class)
                if (fields.contains(name + ":String")) return true
            }
        }
        return false
    }

    fun get_string_lit_value(expr: AST.Expr): String {
        return match (expr) { StringLit(s) => s }
    }

    fun is_string_expr(expr: AST.Expr): Bool {
        var kind = match (expr) {
            StringLit(s) => "string"
            Binary(l, o, r) => {
                if (o == "+") {
                    if (this.is_string_expr(l) and this.is_string_expr(r)) { "string" } else { "binary" }
                } else { "binary" }
            }
            IntLit(v) => "int"
            FloatLit(v) => "float"
            BoolLit(v) => "bool"
            Variable(n) => "var"
            Unary(o, r) => "unary"
            Call(c, a) => "call"
            Assign(n, v) => "assign"
            Logical(l, o, r) => "logical"
            MemberAccess(o, f) => "member"
            NilLit => "nil"
            Match(s, a) => "match"
            EnumConstruct(e, v, a) => "enum"
            Lambda(p, r, b) => "lambda"
            GetField(o, f) => "field"
            SetField(o, f, v) => "field"
            This => "this"
            ListLit(e) => "list"
            IndexGet(o, i) => "index"
            IndexSet(o, i, v) => "index"
            MethodCall(o, m, a) => "method"
        }
        return kind == "string"
    }

    fun get_format_ptr(fmt: String): String {
        var name = this.add_string_constant(fmt)
        var len = fmt.length() + 1
        var local = this.fresh_local()
        this.emit_indent(local + " = getelementptr [" + len.to_string() + " x i8], [" + len.to_string() + " x i8]* " + name + ", i64 0, i64 0")
        return local
    }

    fun gen_enum_construct(enum_name: String, variant: String, args: List<AST.Expr>): String {
        var key = enum_name + "." + variant
        var tag = this.enum_variant_tags.get(key)

        // Check if this enum uses simple encoding (max 1 field) or array encoding
        var max_fields = this.get_max_fields(enum_name)

        if (max_fields <= 1) {
            // Simple encoding: (tag << 56) | value
            if (args.length() == 0) {
                var local = this.fresh_local()
                this.emit_indent(local + " = shl i64 " + tag.floor().to_string() + ", 56")
                return local
            }
            var val = this.gen_arg_value(args[0])
            var tag_shifted = this.fresh_local()
            this.emit_indent(tag_shifted + " = shl i64 " + tag.floor().to_string() + ", 56")
            var combined = this.fresh_local()
            this.emit_indent(combined + " = or i64 " + tag_shifted + ", " + val)
            return combined
        }

        // Array encoding for enums with multi-field variants: [tag, f0, f1, ...]
        if (args.length() == 0) {
            // No-field variant in a multi-field enum: just store tag
            var arr_ptr = this.fresh_local()
            this.emit_indent(arr_ptr + " = alloca [1 x i64]")
            var tag_slot = this.fresh_local()
            this.emit_indent(tag_slot + " = getelementptr [1 x i64], [1 x i64]* " + arr_ptr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + tag_slot)
            var as_int = this.fresh_local()
            this.emit_indent(as_int + " = ptrtoint [1 x i64]* " + arr_ptr + " to i64")
            return as_int
        }

        // Multi-field: allocate array [tag, field0, field1, ...] on stack
        // Return pointer as i64 (ptrtoint)
        var num_slots = args.length() + 1
        var arr_ptr = this.fresh_local()
        this.emit_indent(arr_ptr + " = alloca [" + num_slots.to_string() + " x i64]")
        // Store tag at index 0
        var tag_slot = this.fresh_local()
        this.emit_indent(tag_slot + " = getelementptr [" + num_slots.to_string() + " x i64], [" + num_slots.to_string() + " x i64]* " + arr_ptr + ", i64 0, i64 0")
        this.emit_indent("store i64 " + tag.floor().to_string() + ", i64* " + tag_slot)
        // Store fields at indices 1, 2, ...
        var i = 0
        while (i < args.length()) {
            var val = this.gen_arg_value(args[i])
            var field_idx = i + 1
            var field_slot = this.fresh_local()
            this.emit_indent(field_slot + " = getelementptr [" + num_slots.to_string() + " x i64], [" + num_slots.to_string() + " x i64]* " + arr_ptr + ", i64 0, i64 " + field_idx.to_string())
            this.emit_indent("store i64 " + val + ", i64* " + field_slot)
            i = i + 1
        }
        // Cast pointer to i64 for storage
        var as_int = this.fresh_local()
        this.emit_indent(as_int + " = ptrtoint [" + num_slots.to_string() + " x i64]* " + arr_ptr + " to i64")
        return as_int
    }

    fun gen_match(subject: AST.Expr, arms: List<AST.MatchArm>): String {
        var subj = this.gen_arg_value(subject)
        var result_ptr = this.fresh_local()
        this.emit_indent(result_ptr + " = alloca i64")

        // Determine which enum from first arm's pattern
        var first_arm = arms[0]
        var first_pattern = match (first_arm) { Arm(p, b) => p }
        var first_variant = match (first_pattern) { VariantPattern(v, b) => v }
        var enum_name = this.find_enum_for_variant(first_variant)

        // Determine max fields across variants to pick encoding
        var max_fields = this.get_max_fields(enum_name)

        // Extract tag based on encoding
        var tag_val = this.fresh_local()
        if (max_fields <= 1) {
            // Single-field or no-field: (tag << 56) | value encoding
            var tag_shifted = this.fresh_local()
            this.emit_indent(tag_shifted + " = lshr i64 " + subj + ", 56")
            this.emit_indent(tag_val + " = trunc i64 " + tag_shifted + " to i8")
        } else {
            // Multi-field: ptrtoint encoding, tag at array[0]
            var arr_ptr = this.fresh_local()
            this.emit_indent(arr_ptr + " = inttoptr i64 " + subj + " to i64*")
            var tag_i64 = this.fresh_local()
            this.emit_indent(tag_i64 + " = load i64, i64* " + arr_ptr)
            this.emit_indent(tag_val + " = trunc i64 " + tag_i64 + " to i8")
        }

        // Build switch
        var end_label = this.fresh_label("match.end")
        var arm_labels: List<String> = []
        var i = 0
        while (i < arms.length()) {
            arm_labels.push(this.fresh_label("match.arm"))
            i = i + 1
        }

        var switch_str = "switch i8 " + tag_val + ", label %" + end_label + " ["
        i = 0
        while (i < arms.length()) {
            var arm = arms[i]
            var pattern = match (arm) { Arm(p, b) => p }
            var variant_name = match (pattern) { VariantPattern(v, b) => v }
            var tag_idx = this.enum_variant_tags.get(enum_name + "." + variant_name)
            switch_str = switch_str + " i8 " + tag_idx.floor().to_string() + ", label %" + arm_labels[i]
            i = i + 1
        }
        switch_str = switch_str + " ]"
        this.emit_terminator(switch_str)

        // Generate each arm
        i = 0
        while (i < arms.length()) {
            this.start_block(arm_labels[i])
            var arm = arms[i]
            var pattern = match (arm) { Arm(p, b) => p }
            var body_expr = match (arm) { Arm(p, b) => b }

            // Extract bindings from payload
            var arm_variant = match (pattern) { VariantPattern(v, b) => v }
            var bindings = match (pattern) { VariantPattern(v, b) => b }
            var bind_count = 0
            if (bindings is List) {
                bind_count = bindings.length()
            }
            if (bind_count > 0) {
                if (max_fields <= 1) {
                    // Simple encoding: extract value with AND mask
                    var bname = bindings[0]
                    var extracted = this.fresh_local()
                    this.emit_indent(extracted + " = and i64 " + subj + ", 72057594037927935")
                    this.emit_indent("store i64 " + extracted + ", i64* %" + bname)
                } else {
                    // Array encoding: inttoptr and GEP to extract fields
                    var total = bind_count + 1
                    var total_str = total.floor().to_string()
                    var arr_ptr = this.fresh_local()
                    this.emit_indent(arr_ptr + " = inttoptr i64 " + subj + " to [" + total_str + " x i64]*")
                    var j = 0
                    while (j < bind_count) {
                        var bname = bindings[j]
                        var field_idx = j + 1
                        var field_slot = this.fresh_local()
                        this.emit_indent(field_slot + " = getelementptr [" + total_str + " x i64], [" + total_str + " x i64]* " + arr_ptr + ", i64 0, i64 " + field_idx.floor().to_string())
                        var extracted = this.fresh_local()
                        this.emit_indent(extracted + " = load i64, i64* " + field_slot)
                        this.emit_indent("store i64 " + extracted + ", i64* %" + bname)
                        j = j + 1
                    }
                }
            }

            var val = this.gen_arg_value(body_expr)
            this.emit_indent("store i64 " + val + ", i64* " + result_ptr)
            this.emit_terminator("br label %" + end_label)
            i = i + 1
        }

        this.start_block(end_label)
        var result = this.fresh_local()
        this.emit_indent(result + " = load i64, i64* " + result_ptr)
        return result
    }

    fun get_max_fields(enum_name: String): Float {
        var max_f = 0
        var variants = this.enum_defs.get(enum_name)
        var i = 0
        while (i < variants.length()) {
            var vname = variants[i]
            var key = enum_name + "." + vname
            if (this.enum_variant_fields.has(key)) {
                var fields = this.enum_variant_fields.get(key)
                if (fields.length() > 0) {
                    var parts = fields.split(",")
                    // Each part is "name:Type", count them
                    var field_count = parts.length()
                    if (field_count > max_f) {
                        max_f = field_count
                    }
                }
            }
            i = i + 1
        }
        return max_f
    }

    fun find_class_for_method(method: String): String {
        var keys = this.class_methods.keys()
        var i = 0
        while (i < keys.length()) {
            var class_name = keys[i]
            var methods = this.class_methods.get(class_name)
            if (methods.contains(method)) {
                return class_name
            }
            i = i + 1
        }
        return ""
    }

    fun get_method_ret(class_name: String, method: String): String {
        // For simplicity, methods named "init", "increment" etc return void
        // Methods named "get" return i64
        // TODO: track actual return types
        if (method == "init") return "void"
        if (method == "increment") return "void"
        return "i64"
    }

    fun classify_expr(expr: AST.Expr): String {
        return match (expr) {
            MethodCall(o, m, a) => "method_call"
            ListLit(e) => "list_lit"
            IndexGet(o, i) => "index_get"
            IndexSet(o, i, v) => "index_set"
            MapLit => "map_lit"
            StringLit(s) => "string"
            IntLit(v) => "int"
            FloatLit(v) => "float"
            BoolLit(v) => "bool"
            Variable(n) => "variable"
            Binary(l, o, r) => "binary"
            Unary(o, r) => "unary"
            Call(c, a) => "call"
            Assign(n, v) => "assign"
            Logical(l, o, r) => "logical"
            MemberAccess(o, f) => "member"
            NilLit => "nil"
            Match(s, a) => "match_expr"
            EnumConstruct(e, v, a) => "enum"
            Lambda(p, r, b) => "lambda"
            GetField(o, f) => "get_field"
            SetField(o, f, v) => "set_field"
            This => "this"
        }
    }

    fun get_variable_name(expr: AST.Expr): String {
        var name = match (expr) {
            Variable(n) => n
            IntLit(v) => ""
            FloatLit(v) => ""
            BoolLit(v) => ""
            StringLit(s) => ""
            NilLit => ""
            Binary(l, o, r) => ""
            Unary(o, r) => ""
            Call(c, a) => ""
            Assign(n, v) => ""
            Logical(l, o, r) => ""
            MemberAccess(o, f) => ""
            Match(s, a) => ""
            EnumConstruct(e, v, a) => ""
            Lambda(p, r, b) => ""
            GetField(o, f) => ""
            SetField(o, f, v) => ""
            This => ""
            ListLit(e) => ""
            IndexGet(o, i) => ""
            IndexSet(o, i, v) => ""
            MethodCall(o, m, a) => ""
        }
        return name
    }

    fun gen_list_lit(elements: List<AST.Expr>): String {
        var list_val = this.fresh_local()
        this.emit_indent(list_val + " = call i64 @__list_new()")
        var i = 0
        while (i < elements.length()) {
            var elem = this.gen_arg_value(elements[i])
            this.emit_indent("call void @__list_push(i64 " + list_val + ", i64 " + elem + ")")
            i = i + 1
        }
        this.last_type = "List"
        return list_val
    }

    fun gen_index_get(object: AST.Expr, index: AST.Expr): String {
        var obj = this.gen_arg_value(object)
        var idx = this.gen_arg_value(index)
        var local = this.fresh_local()
        this.emit_indent(local + " = call i64 @__list_get(i64 " + obj + ", i64 " + idx + ")")
        this.last_type = "Int"
        return local
    }

    fun gen_index_set(object: AST.Expr, index: AST.Expr, value: AST.Expr): String {
        var obj = this.gen_arg_value(object)
        var idx = this.gen_arg_value(index)
        var val = this.gen_arg_value(value)
        this.emit_indent("call void @__list_set(i64 " + obj + ", i64 " + idx + ", i64 " + val + ")")
        return val
    }

    fun gen_method_call(object: AST.Expr, method: String, args: List<AST.Expr>): String {
        // Check for IO module calls first
        var obj_name = this.get_variable_name(object)
        if (obj_name == "IO") {
            if (method == "println") {
                var arg = this.gen_arg_value(args[0])
                var arg_type = this.last_type
                var local = this.fresh_local()
                if (arg_type == "String") {
                    var str_ptr = this.fresh_local()
                    this.emit_indent(str_ptr + " = inttoptr i64 " + arg + " to i8*")
                    this.emit_indent(local + " = call i32 @puts(i8* " + str_ptr + ")")
                } else {
                    var fmt = this.get_format_ptr("%ld\n")
                    this.emit_indent(local + " = call i32 (i8*, ...) @printf(i8* " + fmt + ", i64 " + arg + ")")
                }
                this.last_type = "Nil"
                return local
            }
            if (method == "print") {
                var arg = this.gen_arg_value(args[0])
                var arg_type = this.last_type
                var local = this.fresh_local()
                if (arg_type == "String") {
                    var str_ptr = this.fresh_local()
                    this.emit_indent(str_ptr + " = inttoptr i64 " + arg + " to i8*")
                    this.emit_indent(local + " = call i32 (i8*, ...) @printf(i8* " + str_ptr + ")")
                } else {
                    var fmt = this.get_format_ptr("%ld")
                    this.emit_indent(local + " = call i32 (i8*, ...) @printf(i8* " + fmt + ", i64 " + arg + ")")
                }
                this.last_type = "Nil"
                return local
            }
        }

        // Check for enum constructor: EnumName.Variant(args)
        if (obj_name.length() > 0) {
            var key = obj_name + "." + method
            if (this.enum_variant_tags.has(key)) {
                return this.gen_enum_construct(obj_name, method, args)
            }
        }

        var obj = this.gen_arg_value(object)
        var obj_type = this.last_type

        // List methods
        if (obj_type == "List") {
            if (method == "push") {
                var val = this.gen_arg_value(args[0])
                this.emit_indent("call void @__list_push(i64 " + obj + ", i64 " + val + ")")
                this.last_type = "Nil"
                return "0"
            }
            if (method == "pop") {
                var local = this.fresh_local()
                this.emit_indent(local + " = call i64 @__list_pop(i64 " + obj + ")")
                this.last_type = "Int"
                return local
            }
            if (method == "length") {
                var local = this.fresh_local()
                this.emit_indent(local + " = call i64 @__list_length(i64 " + obj + ")")
                this.last_type = "Int"
                return local
            }
        }

        // Map methods
        if (obj_type == "Map") {
            if (method == "set") {
                var key = this.gen_arg_value(args[0])
                var val = this.gen_arg_value(args[1])
                this.emit_indent("call void @__map_set(i64 " + obj + ", i64 " + key + ", i64 " + val + ")")
                this.last_type = "Nil"
                return "0"
            }
            if (method == "get") {
                var key = this.gen_arg_value(args[0])
                var local = this.fresh_local()
                this.emit_indent(local + " = call i64 @__map_get(i64 " + obj + ", i64 " + key + ")")
                this.last_type = "Int"
                return local
            }
            if (method == "has") {
                var key = this.gen_arg_value(args[0])
                var local = this.fresh_local()
                this.emit_indent(local + " = call i64 @__map_has(i64 " + obj + ", i64 " + key + ")")
                this.last_type = "Bool"
                return local
            }
        }

        // String methods
        if (obj_type == "String") {
            var str_ptr = this.fresh_local()
            this.emit_indent(str_ptr + " = inttoptr i64 " + obj + " to i8*")

            if (method == "length") {
                var local = this.fresh_local()
                this.emit_indent(local + " = call i64 @strlen(i8* " + str_ptr + ")")
                this.last_type = "Int"
                return local
            }
            if (method == "char_at") {
                var idx = this.gen_arg_value(args[0])
                var char_ptr = this.fresh_local()
                this.emit_indent(char_ptr + " = getelementptr i8, i8* " + str_ptr + ", i64 " + idx)
                // Allocate 2-byte buffer for single char + null
                var buf = this.fresh_local()
                this.emit_indent(buf + " = call i8* @malloc(i64 2)")
                var ch = this.fresh_local()
                this.emit_indent(ch + " = load i8, i8* " + char_ptr)
                this.emit_indent("store i8 " + ch + ", i8* " + buf)
                var null_ptr = this.fresh_local()
                this.emit_indent(null_ptr + " = getelementptr i8, i8* " + buf + ", i64 1")
                this.emit_indent("store i8 0, i8* " + null_ptr)
                var local = this.fresh_local()
                this.emit_indent(local + " = ptrtoint i8* " + buf + " to i64")
                this.last_type = "String"
                return local
            }
            if (method == "contains") {
                var needle = this.gen_arg_value(args[0])
                var needle_ptr = this.fresh_local()
                this.emit_indent(needle_ptr + " = inttoptr i64 " + needle + " to i8*")
                var found = this.fresh_local()
                this.emit_indent(found + " = call i8* @strstr(i8* " + str_ptr + ", i8* " + needle_ptr + ")")
                var local = this.fresh_local()
                this.emit_indent(local + " = icmp ne i8* " + found + ", null")
                var result = this.fresh_local()
                this.emit_indent(result + " = zext i1 " + local + " to i64")
                this.last_type = "Bool"
                return result
            }
            if (method == "slice") {
                var start = this.gen_arg_value(args[0])
                var end = this.gen_arg_value(args[1])
                var slice_len = this.fresh_local()
                this.emit_indent(slice_len + " = sub i64 " + end + ", " + start)
                var buf_size = this.fresh_local()
                this.emit_indent(buf_size + " = add i64 " + slice_len + ", 1")
                var buf = this.fresh_local()
                this.emit_indent(buf + " = call i8* @malloc(i64 " + buf_size + ")")
                var src = this.fresh_local()
                this.emit_indent(src + " = getelementptr i8, i8* " + str_ptr + ", i64 " + start)
                this.emit_indent("call void @llvm.memcpy.p0i8.p0i8.i64(i8* " + buf + ", i8* " + src + ", i64 " + slice_len + ", i1 false)")
                var null_pos = this.fresh_local()
                this.emit_indent(null_pos + " = getelementptr i8, i8* " + buf + ", i64 " + slice_len)
                this.emit_indent("store i8 0, i8* " + null_pos)
                var local = this.fresh_local()
                this.emit_indent(local + " = ptrtoint i8* " + buf + " to i64")
                this.last_type = "String"
                return local
            }
        }

        // Fall back to class method call
        if (this.current_class.length() > 0) {
            var class_name = this.find_class_for_method(method)
            if (class_name.length() > 0) {
                var arg_strs: List<String> = []
                arg_strs.push("i64 " + obj)
                var i = 0
                while (i < args.length()) {
                    var val = this.gen_arg_value(args[i])
                    arg_strs.push("i64 " + val)
                    i = i + 1
                }
                var full_method = class_name + "__" + method
                var local = this.fresh_local()
                this.emit_indent(local + " = call i64 @" + full_method + "(" + arg_strs.join(", ") + ")")
                if (this.func_ret_types.has(full_method)) {
                    this.last_type = this.func_ret_types.get(full_method)
                } else {
                    this.last_type = "Int"
                }
                return local
            }
        }

        this.last_type = "Int"
        return "0"
    }

    fun is_this_expr(expr: AST.Expr): Bool {
        var kind = match (expr) {
            This => "this"
            IntLit(v) => "other"
            FloatLit(v) => "other"
            BoolLit(v) => "other"
            StringLit(s) => "other"
            NilLit => "other"
            Variable(n) => "other"
            Binary(l, o, r) => "other"
            Unary(o, r) => "other"
            Call(c, a) => "other"
            Assign(n, v) => "other"
            Logical(l, o, r) => "other"
            MemberAccess(o, f) => "other"
            Match(s, a) => "other"
            EnumConstruct(e, v, a) => "other"
            Lambda(p, r, b) => "other"
            GetField(o, f) => "other"
            SetField(o, f, v) => "other"
        }
        return kind == "this"
    }

    fun gen_get_field(object: AST.Expr, field: String): String {
        var obj_val = this.gen_arg_value(object)
        var class_name = this.current_class
        var field_idx = this.get_field_index(class_name, field)
        var obj_ptr = this.fresh_local()
        this.emit_indent(obj_ptr + " = inttoptr i64 " + obj_val + " to %" + class_name + "*")
        var field_ptr = this.fresh_local()
        this.emit_indent(field_ptr + " = getelementptr %" + class_name + ", %" + class_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
        var result = this.fresh_local()
        this.emit_indent(result + " = load i64, i64* " + field_ptr)
        // Infer field type from class declaration
        this.last_type = this.get_field_type(class_name, field)
        return result
    }

    fun get_field_type(class_name: String, field: String): String {
        if (!this.class_fields.has(class_name)) return "Int"
        var fields = this.class_fields.get(class_name)
        if (fields.length() == 0) return "Int"
        var parts = fields.split(",")
        var i = 0
        while (i < parts.length()) {
            var fp = parts[i].split(":")
            if (fp[0] == field) return fp[1]
            i = i + 1
        }
        return "Int"
    }

    fun gen_set_field(object: AST.Expr, field: String, value: AST.Expr): String {
        var obj_val = this.gen_arg_value(object)
        var val = this.gen_arg_value(value)
        var class_name = this.current_class
        var field_idx = this.get_field_index(class_name, field)
        var obj_ptr = this.fresh_local()
        this.emit_indent(obj_ptr + " = inttoptr i64 " + obj_val + " to %" + class_name + "*")
        var field_ptr = this.fresh_local()
        this.emit_indent(field_ptr + " = getelementptr %" + class_name + ", %" + class_name + "* " + obj_ptr + ", i32 0, i32 " + field_idx.floor().to_string())
        this.emit_indent("store i64 " + val + ", i64* " + field_ptr)
        return val
    }

    fun get_field_index(class_name: String, field: String): Float {
        var fields = this.class_fields.get(class_name)
        if (fields.length() == 0) return 0
        var parts = fields.split(",")
        var i = 0
        while (i < parts.length()) {
            var fp = parts[i].split(":")
            if (fp[0] == field) return i
            i = i + 1
        }
        return 0
    }

    fun gen_lambda(params: String, ret_type: String, body: List<AST.Stmt>): String {
        // Find captured variables (free variables in body not in params)
        var param_names: List<String> = []
        if (params.length() > 0) {
            var parts = params.split(",")
            var pi = 0
            while (pi < parts.length()) {
                var pparts = parts[pi].split(":")
                param_names.push(pparts[0])
                pi = pi + 1
            }
        }
        var captures: List<String> = []
        this.find_free_vars_stmts(body, param_names, captures)

        // Generate a unique name for this lambda
        this.label_counter = this.label_counter + 1
        var lambda_name = "__lambda_" + this.label_counter.floor().to_string()

        // Build the lambda's params: env pointer (if captures) + original params
        var lambda_params = ""
        if (captures.length() > 0) {
            lambda_params = "__env:Int"
            if (params.length() > 0) {
                lambda_params = lambda_params + "," + params
            }
        } else {
            lambda_params = params
        }

        // Save current state
        var saved_sb = this.sb
        var saved_terminated = this.block_terminated
        var saved_counter = this.local_counter

        // Generate the lambda function
        this.sb = StringBuilder()
        if (captures.length() > 0) {
            // Custom gen: emit function header, extract captures from env, then body
            this.gen_closure_function(lambda_name, lambda_params, ret_type, body, captures)
        } else {
            this.gen_function(lambda_name, params, ret_type, body)
        }
        var lambda_ir = this.sb.to_string()

        // Restore state
        this.sb = saved_sb
        this.block_terminated = saved_terminated
        this.local_counter = saved_counter
        this.globals.push(lambda_ir)

        if (captures.length() > 0) {
            // Heap-allocate environment: [cap0, cap1, ...]
            var env_size = captures.length()
            var env_bytes = env_size * 8
            var env_raw = this.fresh_local()
            this.emit_indent(env_raw + " = call i8* @malloc(i64 " + env_bytes.floor().to_string() + ")")
            var env_ptr = this.fresh_local()
            this.emit_indent(env_ptr + " = bitcast i8* " + env_raw + " to [" + env_size.floor().to_string() + " x i64]*")
            // Store captured values into env
            var ci = 0
            while (ci < captures.length()) {
                var cap_val = this.fresh_local()
                this.emit_indent(cap_val + " = load i64, i64* %" + captures[ci])
                var slot = this.fresh_local()
                this.emit_indent(slot + " = getelementptr [" + env_size.floor().to_string() + " x i64], [" + env_size.floor().to_string() + " x i64]* " + env_ptr + ", i64 0, i64 " + ci.floor().to_string())
                this.emit_indent("store i64 " + cap_val + ", i64* " + slot)
                ci = ci + 1
            }
            // Heap-allocate closure pair: [fn_ptr, env_ptr]
            var closure_raw = this.fresh_local()
            this.emit_indent(closure_raw + " = call i8* @malloc(i64 16)")
            var closure_ptr = this.fresh_local()
            this.emit_indent(closure_ptr + " = bitcast i8* " + closure_raw + " to [2 x i64]*")
            // Store fn ptr
            var fn_as_int = this.fresh_local()
            var num_params = param_names.length() + 1
            var fn_type_str = "i64 ("
            var ti = 0
            while (ti < num_params) {
                if (ti > 0) { fn_type_str = fn_type_str + ", " }
                fn_type_str = fn_type_str + "i64"
                ti = ti + 1
            }
            fn_type_str = fn_type_str + ")*"
            this.emit_indent(fn_as_int + " = ptrtoint " + fn_type_str + " @" + lambda_name + " to i64")
            var fn_slot = this.fresh_local()
            this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
            this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
            // Store env ptr
            var env_as_int = this.fresh_local()
            this.emit_indent(env_as_int + " = ptrtoint [" + env_size.floor().to_string() + " x i64]* " + env_ptr + " to i64")
            var env_slot = this.fresh_local()
            this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
            this.emit_indent("store i64 " + env_as_int + ", i64* " + env_slot)
            // Return closure pointer as i64
            var result = this.fresh_local()
            this.emit_indent(result + " = ptrtoint [2 x i64]* " + closure_ptr + " to i64")
            return result
        }

        // No captures: create closure pair with env=0
        // Lambda needs env param too for uniform calling convention
        // Re-generate with env param
        this.globals.pop() // remove the one we just generated
        var saved_sb2 = this.sb
        var saved_terminated2 = this.block_terminated
        var saved_counter2 = this.local_counter
        this.sb = StringBuilder()
        var full_params = "__env:Int"
        if (params.length() > 0) {
            full_params = full_params + "," + params
        }
        this.gen_function(lambda_name, full_params, ret_type, body)
        this.globals.push(this.sb.to_string())
        this.sb = saved_sb2
        this.block_terminated = saved_terminated2
        this.local_counter = saved_counter2

        // Heap-allocate closure pair: [fn_ptr, 0]
        var closure_raw = this.fresh_local()
        this.emit_indent(closure_raw + " = call i8* @malloc(i64 16)")
        var closure_ptr = this.fresh_local()
        this.emit_indent(closure_ptr + " = bitcast i8* " + closure_raw + " to [2 x i64]*")
        var num_total_params = param_names.length() + 1
        var fn_type_str = "i64 ("
        var tti = 0
        while (tti < num_total_params) {
            if (tti > 0) { fn_type_str = fn_type_str + ", " }
            fn_type_str = fn_type_str + "i64"
            tti = tti + 1
        }
        fn_type_str = fn_type_str + ")*"
        var fn_as_int = this.fresh_local()
        this.emit_indent(fn_as_int + " = ptrtoint " + fn_type_str + " @" + lambda_name + " to i64")
        var fn_slot = this.fresh_local()
        this.emit_indent(fn_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 0")
        this.emit_indent("store i64 " + fn_as_int + ", i64* " + fn_slot)
        var env_slot = this.fresh_local()
        this.emit_indent(env_slot + " = getelementptr [2 x i64], [2 x i64]* " + closure_ptr + ", i64 0, i64 1")
        this.emit_indent("store i64 0, i64* " + env_slot)
        var result = this.fresh_local()
        this.emit_indent(result + " = ptrtoint [2 x i64]* " + closure_ptr + " to i64")
        return result
    }

    fun gen_closure_function(name: String, params: String, ret_type: String, body: List<AST.Stmt>, captures: List<String>) {
        this.known_functions.push(name)
        this.reset_locals()
        var ret_llvm = this.llvm_type(ret_type)

        var param_list: List<String> = []
        if (params.length() > 0) {
            param_list = params.split(",")
        }

        var param_strs: List<String> = []
        var i = 0
        while (i < param_list.length()) {
            var parts = param_list[i].split(":")
            var pname = parts[0]
            var ptype = parts[1]
            param_strs.push(this.llvm_type(ptype) + " %" + pname + ".arg")
            i = i + 1
        }

        this.emit("")
        this.emit("define " + ret_llvm + " @" + name + "(" + param_strs.join(", ") + ") {")
        this.emit("entry:")
        this.block_terminated = false

        // Alloca all params
        i = 0
        while (i < param_list.length()) {
            var parts = param_list[i].split(":")
            var pname = parts[0]
            var ptype = parts[1]
            this.emit_indent("%" + pname + " = alloca " + this.llvm_type(ptype))
            this.emit_indent("store " + this.llvm_type(ptype) + " %" + pname + ".arg, " + this.llvm_type(ptype) + "* %" + pname)
            i = i + 1
        }

        // Extract captures from __env
        var env_size = captures.length()
        var env_int = this.fresh_local()
        this.emit_indent(env_int + " = load i64, i64* %__env")
        var env_ptr = this.fresh_local()
        this.emit_indent(env_ptr + " = inttoptr i64 " + env_int + " to [" + env_size.floor().to_string() + " x i64]*")
        var ci = 0
        while (ci < captures.length()) {
            var cap_name = captures[ci]
            this.emit_indent("%" + cap_name + " = alloca i64")
            var cap_slot = this.fresh_local()
            this.emit_indent(cap_slot + " = getelementptr [" + env_size.floor().to_string() + " x i64], [" + env_size.floor().to_string() + " x i64]* " + env_ptr + ", i64 0, i64 " + ci.floor().to_string())
            var cap_val = this.fresh_local()
            this.emit_indent(cap_val + " = load i64, i64* " + cap_slot)
            this.emit_indent("store i64 " + cap_val + ", i64* %" + cap_name)
            ci = ci + 1
        }

        // Collect and emit remaining var allocas
        var var_names: List<String> = []
        var var_types: List<String> = []
        this.collect_vars(body, var_names, var_types)
        i = 0
        while (i < var_names.length()) {
            var vname = var_names[i]
            if (!captures.contains(vname)) {
                this.emit_indent("%" + vname + " = alloca " + this.llvm_type(var_types[i]))
            }
            i = i + 1
        }

        this.gen_stmts(body)

        if (!this.block_terminated) {
            if (ret_llvm == "void") {
                this.emit_terminator("ret void")
            } else {
                this.emit_terminator("unreachable")
            }
        }
        this.emit("}")
        this.block_terminated = false
    }

    fun find_free_vars_stmts(stmts: List<AST.Stmt>, bound: List<String>, free: List<String>) {
        var i = 0
        while (i < stmts.length()) {
            this.find_free_vars_stmt(stmts[i], bound, free)
            i = i + 1
        }
    }

    fun find_free_vars_stmt(stmt: AST.Stmt, bound: List<String>, free: List<String>) {
        match (stmt) {
            VarDecl(name, typ, init) => {
                this.find_free_vars_expr(init, bound, free)
                bound.push(name)
            }
            ExprStmt(expr) => { this.find_free_vars_expr(expr, bound, free) }
            Return(value) => { this.find_free_vars_expr(value, bound, free) }
            If(cond, then_b, else_b) => {
                this.find_free_vars_expr(cond, bound, free)
                this.find_free_vars_stmts(then_b, bound, free)
                this.find_free_vars_stmts(else_b, bound, free)
            }
            While(cond, body) => {
                this.find_free_vars_expr(cond, bound, free)
                this.find_free_vars_stmts(body, bound, free)
            }
            Block(stmts) => { this.find_free_vars_stmts(stmts, bound, free) }
            FunDecl(n, p, r, b) => {}
            EnumDecl(n, v) => {}
        }
    }

    fun find_free_vars_expr(expr: AST.Expr, bound: List<String>, free: List<String>) {
        match (expr) {
            Variable(name) => {
                if (!bound.contains(name) and !free.contains(name)) {
                    free.push(name)
                }
            }
            Binary(l, o, r) => {
                this.find_free_vars_expr(l, bound, free)
                this.find_free_vars_expr(r, bound, free)
            }
            Unary(o, r) => { this.find_free_vars_expr(r, bound, free) }
            Call(c, args) => {
                this.find_free_vars_expr(c, bound, free)
                var i = 0
                while (i < args.length()) {
                    this.find_free_vars_expr(args[i], bound, free)
                    i = i + 1
                }
            }
            Assign(name, value) => { this.find_free_vars_expr(value, bound, free) }
            Logical(l, o, r) => {
                this.find_free_vars_expr(l, bound, free)
                this.find_free_vars_expr(r, bound, free)
            }
            IntLit(v) => {}
            FloatLit(v) => {}
            BoolLit(v) => {}
            StringLit(s) => {}
            NilLit => {}
            MemberAccess(o, f) => {}
            Match(s, a) => {}
            EnumConstruct(e, v, a) => {}
            Lambda(p, r, b) => {}
        }
    }

    fun list_runtime(): String {
        var rt = StringBuilder()
        // __list_new() -> %List* (as i64)
        rt.append("define i64 @__list_new() {\n")
        rt.append("entry:\n")
        rt.append("  %raw = call i8* @malloc(i64 24)\n")
        rt.append("  %ptr = bitcast i8* %raw to %List*\n")
        rt.append("  %count_ptr = getelementptr %List, %List* %ptr, i32 0, i32 0\n")
        rt.append("  store i64 0, i64* %count_ptr\n")
        rt.append("  %cap_ptr = getelementptr %List, %List* %ptr, i32 0, i32 1\n")
        rt.append("  store i64 8, i64* %cap_ptr\n")
        rt.append("  %data_raw = call i8* @malloc(i64 64)\n")
        rt.append("  %data = bitcast i8* %data_raw to i64*\n")
        rt.append("  %data_ptr = getelementptr %List, %List* %ptr, i32 0, i32 2\n")
        rt.append("  store i64* %data, i64** %data_ptr\n")
        rt.append("  %result = ptrtoint %List* %ptr to i64\n")
        rt.append("  ret i64 %result\n")
        rt.append("}\n\n")

        // __list_push(list: i64, value: i64)
        rt.append("define void @__list_push(i64 %list, i64 %value) {\n")
        rt.append("entry:\n")
        rt.append("  %ptr = inttoptr i64 %list to %List*\n")
        rt.append("  %count_ptr = getelementptr %List, %List* %ptr, i32 0, i32 0\n")
        rt.append("  %count = load i64, i64* %count_ptr\n")
        rt.append("  %cap_ptr = getelementptr %List, %List* %ptr, i32 0, i32 1\n")
        rt.append("  %cap = load i64, i64* %cap_ptr\n")
        rt.append("  %need_grow = icmp sge i64 %count, %cap\n")
        rt.append("  br i1 %need_grow, label %grow, label %store\n")
        rt.append("grow:\n")
        rt.append("  %new_cap = mul i64 %cap, 2\n")
        rt.append("  store i64 %new_cap, i64* %cap_ptr\n")
        rt.append("  %new_bytes = mul i64 %new_cap, 8\n")
        rt.append("  %data_ptr_g = getelementptr %List, %List* %ptr, i32 0, i32 2\n")
        rt.append("  %old_data = load i64*, i64** %data_ptr_g\n")
        rt.append("  %old_raw = bitcast i64* %old_data to i8*\n")
        rt.append("  %new_raw = call i8* @realloc(i8* %old_raw, i64 %new_bytes)\n")
        rt.append("  %new_data = bitcast i8* %new_raw to i64*\n")
        rt.append("  store i64* %new_data, i64** %data_ptr_g\n")
        rt.append("  br label %store\n")
        rt.append("store:\n")
        rt.append("  %data_ptr_s = getelementptr %List, %List* %ptr, i32 0, i32 2\n")
        rt.append("  %data = load i64*, i64** %data_ptr_s\n")
        rt.append("  %slot = getelementptr i64, i64* %data, i64 %count\n")
        rt.append("  store i64 %value, i64* %slot\n")
        rt.append("  %new_count = add i64 %count, 1\n")
        rt.append("  store i64 %new_count, i64* %count_ptr\n")
        rt.append("  ret void\n")
        rt.append("}\n\n")

        // __list_get(list: i64, index: i64) -> i64
        rt.append("define i64 @__list_get(i64 %list, i64 %index) {\n")
        rt.append("entry:\n")
        rt.append("  %ptr = inttoptr i64 %list to %List*\n")
        rt.append("  %data_ptr = getelementptr %List, %List* %ptr, i32 0, i32 2\n")
        rt.append("  %data = load i64*, i64** %data_ptr\n")
        rt.append("  %slot = getelementptr i64, i64* %data, i64 %index\n")
        rt.append("  %val = load i64, i64* %slot\n")
        rt.append("  ret i64 %val\n")
        rt.append("}\n\n")

        // __list_set(list: i64, index: i64, value: i64)
        rt.append("define void @__list_set(i64 %list, i64 %index, i64 %value) {\n")
        rt.append("entry:\n")
        rt.append("  %ptr = inttoptr i64 %list to %List*\n")
        rt.append("  %data_ptr = getelementptr %List, %List* %ptr, i32 0, i32 2\n")
        rt.append("  %data = load i64*, i64** %data_ptr\n")
        rt.append("  %slot = getelementptr i64, i64* %data, i64 %index\n")
        rt.append("  store i64 %value, i64* %slot\n")
        rt.append("  ret void\n")
        rt.append("}\n\n")

        // __list_length(list: i64) -> i64
        rt.append("define i64 @__list_length(i64 %list) {\n")
        rt.append("entry:\n")
        rt.append("  %ptr = inttoptr i64 %list to %List*\n")
        rt.append("  %count_ptr = getelementptr %List, %List* %ptr, i32 0, i32 0\n")
        rt.append("  %count = load i64, i64* %count_ptr\n")
        rt.append("  ret i64 %count\n")
        rt.append("}\n\n")

        // __list_pop(list: i64) -> i64
        rt.append("define i64 @__list_pop(i64 %list) {\n")
        rt.append("entry:\n")
        rt.append("  %ptr = inttoptr i64 %list to %List*\n")
        rt.append("  %count_ptr = getelementptr %List, %List* %ptr, i32 0, i32 0\n")
        rt.append("  %count = load i64, i64* %count_ptr\n")
        rt.append("  %new_count = sub i64 %count, 1\n")
        rt.append("  store i64 %new_count, i64* %count_ptr\n")
        rt.append("  %data_ptr = getelementptr %List, %List* %ptr, i32 0, i32 2\n")
        rt.append("  %data = load i64*, i64** %data_ptr\n")
        rt.append("  %slot = getelementptr i64, i64* %data, i64 %new_count\n")
        rt.append("  %val = load i64, i64* %slot\n")
        rt.append("  ret i64 %val\n")
        rt.append("}\n\n")

        return rt.to_string()
    }

    fun map_runtime(): String {
        var rt = StringBuilder()

        // __map_new() -> i64
        rt.append("define i64 @__map_new() {\n")
        rt.append("entry:\n")
        rt.append("  %raw = call i8* @malloc(i64 32)\n")
        rt.append("  %ptr = bitcast i8* %raw to %Map*\n")
        rt.append("  %cp = getelementptr %Map, %Map* %ptr, i32 0, i32 0\n")
        rt.append("  store i64 0, i64* %cp\n")
        rt.append("  %cap = getelementptr %Map, %Map* %ptr, i32 0, i32 1\n")
        rt.append("  store i64 16, i64* %cap\n")
        rt.append("  %kr = call i8* @malloc(i64 128)\n")
        rt.append("  %keys = bitcast i8* %kr to i64*\n")
        rt.append("  %kp = getelementptr %Map, %Map* %ptr, i32 0, i32 2\n")
        rt.append("  store i64* %keys, i64** %kp\n")
        rt.append("  %vr = call i8* @malloc(i64 128)\n")
        rt.append("  %vals = bitcast i8* %vr to i64*\n")
        rt.append("  %vp = getelementptr %Map, %Map* %ptr, i32 0, i32 3\n")
        rt.append("  store i64* %vals, i64** %vp\n")
        rt.append("  %result = ptrtoint %Map* %ptr to i64\n")
        rt.append("  ret i64 %result\n")
        rt.append("}\n\n")

        // __map_set(map: i64, key: i64, value: i64)
        rt.append("define void @__map_set(i64 %map, i64 %key, i64 %value) {\n")
        rt.append("entry:\n")
        rt.append("  %ptr = inttoptr i64 %map to %Map*\n")
        rt.append("  %cp = getelementptr %Map, %Map* %ptr, i32 0, i32 0\n")
        rt.append("  %count = load i64, i64* %cp\n")
        rt.append("  %kp = getelementptr %Map, %Map* %ptr, i32 0, i32 2\n")
        rt.append("  %keys = load i64*, i64** %kp\n")
        rt.append("  %vp = getelementptr %Map, %Map* %ptr, i32 0, i32 3\n")
        rt.append("  %vals = load i64*, i64** %vp\n")
        rt.append("  %key_ptr = inttoptr i64 %key to i8*\n")
        // Search for existing key
        rt.append("  br label %loop\n")
        rt.append("loop:\n")
        rt.append("  %i = phi i64 [0, %entry], [%next, %cont]\n")
        rt.append("  %done = icmp sge i64 %i, %count\n")
        rt.append("  br i1 %done, label %insert, label %check\n")
        rt.append("check:\n")
        rt.append("  %kslot = getelementptr i64, i64* %keys, i64 %i\n")
        rt.append("  %kval = load i64, i64* %kslot\n")
        rt.append("  %kstr = inttoptr i64 %kval to i8*\n")
        rt.append("  %cmp = call i32 @strcmp(i8* %key_ptr, i8* %kstr)\n")
        rt.append("  %eq = icmp eq i32 %cmp, 0\n")
        rt.append("  br i1 %eq, label %update, label %cont\n")
        rt.append("cont:\n")
        rt.append("  %next = add i64 %i, 1\n")
        rt.append("  br label %loop\n")
        rt.append("update:\n")
        rt.append("  %vslot_u = getelementptr i64, i64* %vals, i64 %i\n")
        rt.append("  store i64 %value, i64* %vslot_u\n")
        rt.append("  ret void\n")
        rt.append("insert:\n")
        rt.append("  %kslot_i = getelementptr i64, i64* %keys, i64 %count\n")
        rt.append("  store i64 %key, i64* %kslot_i\n")
        rt.append("  %vslot_i = getelementptr i64, i64* %vals, i64 %count\n")
        rt.append("  store i64 %value, i64* %vslot_i\n")
        rt.append("  %new_count = add i64 %count, 1\n")
        rt.append("  store i64 %new_count, i64* %cp\n")
        rt.append("  ret void\n")
        rt.append("}\n\n")

        // __map_get(map: i64, key: i64) -> i64
        rt.append("define i64 @__map_get(i64 %map, i64 %key) {\n")
        rt.append("entry:\n")
        rt.append("  %ptr = inttoptr i64 %map to %Map*\n")
        rt.append("  %cp = getelementptr %Map, %Map* %ptr, i32 0, i32 0\n")
        rt.append("  %count = load i64, i64* %cp\n")
        rt.append("  %kp = getelementptr %Map, %Map* %ptr, i32 0, i32 2\n")
        rt.append("  %keys = load i64*, i64** %kp\n")
        rt.append("  %vp = getelementptr %Map, %Map* %ptr, i32 0, i32 3\n")
        rt.append("  %vals = load i64*, i64** %vp\n")
        rt.append("  %key_ptr = inttoptr i64 %key to i8*\n")
        rt.append("  br label %loop\n")
        rt.append("loop:\n")
        rt.append("  %i = phi i64 [0, %entry], [%next, %cont]\n")
        rt.append("  %done = icmp sge i64 %i, %count\n")
        rt.append("  br i1 %done, label %notfound, label %check\n")
        rt.append("check:\n")
        rt.append("  %kslot = getelementptr i64, i64* %keys, i64 %i\n")
        rt.append("  %kval = load i64, i64* %kslot\n")
        rt.append("  %kstr = inttoptr i64 %kval to i8*\n")
        rt.append("  %cmp = call i32 @strcmp(i8* %key_ptr, i8* %kstr)\n")
        rt.append("  %eq = icmp eq i32 %cmp, 0\n")
        rt.append("  br i1 %eq, label %found, label %cont\n")
        rt.append("cont:\n")
        rt.append("  %next = add i64 %i, 1\n")
        rt.append("  br label %loop\n")
        rt.append("found:\n")
        rt.append("  %vslot = getelementptr i64, i64* %vals, i64 %i\n")
        rt.append("  %val = load i64, i64* %vslot\n")
        rt.append("  ret i64 %val\n")
        rt.append("notfound:\n")
        rt.append("  ret i64 0\n")
        rt.append("}\n\n")

        // __map_has(map: i64, key: i64) -> i64 (0 or 1)
        rt.append("define i64 @__map_has(i64 %map, i64 %key) {\n")
        rt.append("entry:\n")
        rt.append("  %ptr = inttoptr i64 %map to %Map*\n")
        rt.append("  %cp = getelementptr %Map, %Map* %ptr, i32 0, i32 0\n")
        rt.append("  %count = load i64, i64* %cp\n")
        rt.append("  %kp = getelementptr %Map, %Map* %ptr, i32 0, i32 2\n")
        rt.append("  %keys = load i64*, i64** %kp\n")
        rt.append("  %key_ptr = inttoptr i64 %key to i8*\n")
        rt.append("  br label %loop\n")
        rt.append("loop:\n")
        rt.append("  %i = phi i64 [0, %entry], [%next, %cont]\n")
        rt.append("  %done = icmp sge i64 %i, %count\n")
        rt.append("  br i1 %done, label %no, label %check\n")
        rt.append("check:\n")
        rt.append("  %kslot = getelementptr i64, i64* %keys, i64 %i\n")
        rt.append("  %kval = load i64, i64* %kslot\n")
        rt.append("  %kstr = inttoptr i64 %kval to i8*\n")
        rt.append("  %cmp = call i32 @strcmp(i8* %key_ptr, i8* %kstr)\n")
        rt.append("  %eq = icmp eq i32 %cmp, 0\n")
        rt.append("  br i1 %eq, label %yes, label %cont\n")
        rt.append("cont:\n")
        rt.append("  %next = add i64 %i, 1\n")
        rt.append("  br label %loop\n")
        rt.append("yes:\n")
        rt.append("  ret i64 1\n")
        rt.append("no:\n")
        rt.append("  ret i64 0\n")
        rt.append("}\n\n")

        return rt.to_string()
    }

    fun find_enum_for_variant(variant: String): String {
        var keys = this.enum_variant_tags.keys()
        var i = 0
        while (i < keys.length()) {
            var key = keys[i]
            if (key.ends_with("." + variant)) {
                return key.split(".")[0]
            }
            i = i + 1
        }
        return "Unknown"
    }

    fun resolve_callee(expr: AST.Expr): String {
        return match (expr) {
            Variable(n) => n
            MemberAccess(obj, field) => this.resolve_callee(obj) + "." + field
        }
    }

    fun gen_logical(left: AST.Expr, op: String, right: AST.Expr): String {
        var lhs = this.gen_arg_value(left)
        var rhs_label = this.fresh_label("rhs")
        var end_label = this.fresh_label("end")
        var result = this.fresh_local()

        if (op == "or") {
            this.emit_indent("br i1 " + lhs + ", label %" + end_label + ", label %" + rhs_label)
        } else {
            this.emit_indent("br i1 " + lhs + ", label %" + rhs_label + ", label %" + end_label)
        }

        this.emit(rhs_label + ":")
        var rhs = this.gen_arg_value(right)
        this.emit_indent("br label %" + end_label)

        this.emit(end_label + ":")
        this.emit_indent(result + " = phi i1 [" + lhs + ", %entry], [" + rhs + ", %" + rhs_label + "]")
        return result
    }

    // --- Variable collection (for hoisting allocas to entry block) ---

    fun collect_vars(stmts: List<AST.Stmt>, names: List<String>, types: List<String>) {
        var i = 0
        while (i < stmts.length()) {
            this.collect_vars_stmt(stmts[i], names, types)
            i = i + 1
        }
    }

    fun add_var_unique(names: List<String>, types: List<String>, name: String, typ: String) {
        if (!names.contains(name)) {
            names.push(name)
            types.push(typ)
        }
    }

    fun collect_vars_stmt(stmt: AST.Stmt, names: List<String>, types: List<String>) {
        match (stmt) {
            VarDecl(name, type_ann, init) => {
                this.add_var_unique(names, types, name, type_ann)
                this.collect_vars_expr(init, names, types)
            }
            If(cond, then_branch, else_branch) => {
                this.collect_vars(then_branch, names, types)
                this.collect_vars(else_branch, names, types)
            }
            While(cond, body) => {
                this.collect_vars(body, names, types)
            }
            Block(stmts) => {
                this.collect_vars(stmts, names, types)
            }
            ExprStmt(expr) => {
                this.collect_vars_expr(expr, names, types)
            }
            Return(value) => {
                this.collect_vars_expr(value, names, types)
            }
            FunDecl(name, params, ret_type, body) => {}
            EnumDecl(name, variants) => {}
            ClassDecl(name, fields, methods) => {}
        }
    }

    fun collect_vars_expr(expr: AST.Expr, names: List<String>, types: List<String>) {
        if (!this.is_match_expr(expr)) return nil
        // It's a match expression — collect bindings from patterns
        var arms = this.get_match_arms(expr)
        var i = 0
        while (i < arms.length()) {
            var arm = arms[i]
            var pattern = match (arm) { Arm(p, b) => p }
            var bindings = match (pattern) { VariantPattern(v, b) => b }
            var j = 0
            while (j < bindings.length()) {
                this.add_var_unique(names, types, bindings[j], "Int")
                j = j + 1
            }
            i = i + 1
        }
    }

    fun is_match_expr(expr: AST.Expr): Bool {
        var kind = match (expr) {
            Match(s, a) => "match"
            IntLit(v) => "other"
            FloatLit(v) => "other"
            BoolLit(v) => "other"
            StringLit(s) => "other"
            NilLit => "other"
            Variable(n) => "other"
            Binary(l, o, r) => "other"
            Unary(o, r) => "other"
            Call(c, a) => "other"
            Assign(n, v) => "other"
            Logical(l, o, r) => "other"
            MemberAccess(o, f) => "other"
            EnumConstruct(e, v, a) => "other"
        }
        return kind == "match"
    }

    fun get_match_arms(expr: AST.Expr): List<AST.MatchArm> {
        return match (expr) { Match(s, a) => a }
    }

    // --- Statement codegen ---

    fun gen_stmt(stmt: AST.Stmt) {
        match (stmt) {
            ExprStmt(expr) => { this.gen_arg_value(expr) }
            VarDecl(name, type_ann, init) => {
                var val = this.gen_arg_value(init)
                // Infer type: use annotation if present, else use last_type from init
                var vtype = type_ann
                if (vtype == "Any") {
                    vtype = this.last_type
                }
                this.var_types.set(name, vtype)
                if (vtype == "String") {
                    this.string_vars.push(name)
                }
                this.emit_indent("store i64 " + val + ", i64* %" + name)
            }
            Return(value) => {
                var val = this.gen_arg_value(value)
                this.emit_terminator("ret i64 " + val)
            }
            If(cond, then_branch, else_branch) => {
                this.gen_if(cond, then_branch, else_branch)
            }
            While(cond, body) => {
                this.gen_while(cond, body)
            }
            Block(stmts) => {
                this.gen_stmts(stmts)
            }
            FunDecl(name, params, ret_type, body) => {
                this.gen_function(name, params, ret_type, body)
            }
            EnumDecl(name, variants) => {
                this.gen_enum_decl(name, variants)
            }
            ClassDecl(name, fields, methods) => {
                this.gen_class_decl(name, fields, methods)
            }
        }
    }

    fun gen_class_decl(name: String, fields: String, methods: List<AST.Stmt>) {
        // Register class info
        this.class_fields.set(name, fields)

        // Parse field names for struct layout
        var field_list: List<String> = []
        if (fields.length() > 0) {
            var parts = fields.split(",")
            var i = 0
            while (i < parts.length()) {
                var fp = parts[i].split(":")
                field_list.push(fp[0])
                i = i + 1
            }
        }

        // Emit struct type: { i64 field0, i64 field1, ... }
        var num_fields = field_list.length()
        var field_types_str = ""
        var i = 0
        while (i < num_fields) {
            if (i > 0) { field_types_str = field_types_str + ", " }
            field_types_str = field_types_str + "i64"
            i = i + 1
        }
        this.type_defs.append("%" + name + " = type { " + field_types_str + " }\n")

        // Register method names
        var method_names: List<String> = []
        i = 0
        while (i < methods.length()) {
            var method = methods[i]
            var mname = match (method) { FunDecl(n, p, r, b) => n }
            method_names.push(mname)
            i = i + 1
        }
        this.class_methods.set(name, method_names)

        // Generate methods as functions with name prefix: ClassName__method
        // Methods get 'self' (i64 pointer to instance) as first param
        this.current_class = name
        i = 0
        while (i < methods.length()) {
            var method = methods[i]
            var mname = match (method) { FunDecl(n, p, r, b) => n }
            var mparams = match (method) { FunDecl(n, p, r, b) => p }
            var mret = match (method) { FunDecl(n, p, r, b) => r }
            var mbody = match (method) { FunDecl(n, p, r, b) => b }
            var full_name = name + "__" + mname
            var full_params = "self:Int"
            if (mparams.length() > 0) {
                full_params = full_params + "," + mparams
            }
            this.gen_function(full_name, full_params, mret, mbody)
            i = i + 1
        }

        // Generate constructor function: ClassName(args...) -> instance ptr
        this.gen_class_constructor(name, fields, field_list)
    }

    fun gen_class_constructor(name: String, fields: String, field_list: List<String>) {
        var num_fields = field_list.length()
        var struct_size = num_fields * 8
        this.known_functions.push(name)
        this.emit("")
        this.emit("define i64 @" + name + "() {")
        this.emit("entry:")
        this.block_terminated = false
        // Allocate instance on heap
        var raw = this.fresh_local()
        this.emit_indent(raw + " = call i8* @malloc(i64 " + struct_size.floor().to_string() + ")")
        var ptr = this.fresh_local()
        this.emit_indent(ptr + " = bitcast i8* " + raw + " to %" + name + "*")
        // Zero-initialize fields
        var i = 0
        while (i < num_fields) {
            var field_ptr = this.fresh_local()
            this.emit_indent(field_ptr + " = getelementptr %" + name + ", %" + name + "* " + ptr + ", i32 0, i32 " + i.floor().to_string())
            this.emit_indent("store i64 0, i64* " + field_ptr)
            i = i + 1
        }
        // Return as i64
        var result = this.fresh_local()
        this.emit_indent(result + " = ptrtoint %" + name + "* " + ptr + " to i64")
        this.emit_terminator("ret i64 " + result)
        this.emit("}")
        this.block_terminated = false
    }

    fun gen_enum_decl(name: String, variants: List<AST.Variant>) {
        var variant_names: List<String> = []
        var i = 0
        while (i < variants.length()) {
            var v = variants[i]
            var vname = match (v) { Variant(n, f) => n }
            var vfields = match (v) { Variant(n, f) => f }
            variant_names.push(vname)
            this.enum_variant_tags.set(name + "." + vname, i)
            this.enum_variant_fields.set(name + "." + vname, vfields)
            i = i + 1
        }
        this.enum_defs.set(name, variant_names)
        // Emit type definition: { i8 tag, [max_payload x i8] }
        this.type_defs.append("%" + name + " = type { i8, [16 x i8] }\n")
    }

    fun gen_stmts(stmts: List<AST.Stmt>) {
        var i = 0
        while (i < stmts.length()) {
            this.gen_stmt(stmts[i])
            i = i + 1
        }
    }

    fun to_i1(val: String): String {
        var local = this.fresh_local()
        this.emit_indent(local + " = trunc i64 " + val + " to i1")
        return local
    }

    fun gen_if(cond: AST.Expr, then_branch: List<AST.Stmt>, else_branch: List<AST.Stmt>) {
        var cond_val = this.to_i1(this.gen_arg_value(cond))
        var then_label = this.fresh_label("then")
        var else_label = this.fresh_label("else")
        var end_label = this.fresh_label("endif")

        this.emit_terminator("br i1 " + cond_val + ", label %" + then_label + ", label %" + else_label)

        this.start_block(then_label)
        this.gen_stmts(then_branch)
        this.emit_terminator("br label %" + end_label)

        this.start_block(else_label)
        if (else_branch.length() > 0) {
            this.gen_stmts(else_branch)
        }
        this.emit_terminator("br label %" + end_label)

        this.start_block(end_label)
    }

    fun gen_while(cond: AST.Expr, body: List<AST.Stmt>) {
        var cond_label = this.fresh_label("while.cond")
        var body_label = this.fresh_label("while.body")
        var end_label = this.fresh_label("while.end")

        this.emit_terminator("br label %" + cond_label)

        this.start_block(cond_label)
        var cond_val = this.to_i1(this.gen_arg_value(cond))
        this.emit_terminator("br i1 " + cond_val + ", label %" + body_label + ", label %" + end_label)

        this.start_block(body_label)
        this.gen_stmts(body)
        this.emit_terminator("br label %" + cond_label)

        this.start_block(end_label)
    }

    fun gen_function(name: String, params: String, ret_type: String, body: List<AST.Stmt>) {
        this.known_functions.push(name)
        this.func_ret_types.set(name, ret_type)
        this.reset_locals()
        this.string_vars = []
        this.var_types = {}
        var ret_llvm = this.llvm_type(ret_type)

        // Parse params string "name:type,name:type"
        var param_list: List<String> = []
        if (params.length() > 0) {
            param_list = params.split(",")
        }

        var param_strs: List<String> = []
        var i = 0
        while (i < param_list.length()) {
            var parts = param_list[i].split(":")
            var pname = parts[0]
            var ptype = parts[1]
            param_strs.push(this.llvm_type(ptype) + " %" + pname + ".arg")
            i = i + 1
        }

        this.emit("")
        this.emit("define " + ret_llvm + " @" + name + "(" + param_strs.join(", ") + ") {")
        this.emit("entry:")
        this.block_terminated = false

        // Collect all local variable declarations from body
        var var_names: List<String> = []
        var var_types: List<String> = []
        this.collect_vars(body, var_names, var_types)

        // Emit all allocas in entry block (params + locals)
        i = 0
        while (i < param_list.length()) {
            var parts = param_list[i].split(":")
            var pname = parts[0]
            var ptype = parts[1]
            this.emit_indent("%" + pname + " = alloca " + this.llvm_type(ptype))
            i = i + 1
        }
        i = 0
        while (i < var_names.length()) {
            this.emit_indent("%" + var_names[i] + " = alloca " + this.llvm_type(var_types[i]))
            i = i + 1
        }

        // Store params into their allocas and track types
        i = 0
        while (i < param_list.length()) {
            var parts = param_list[i].split(":")
            var pname = parts[0]
            var ptype = parts[1]
            this.var_types.set(pname, ptype)
            if (ptype == "String") {
                this.string_vars.push(pname)
            }
            this.emit_indent("store i64 %" + pname + ".arg, i64* %" + pname)
            i = i + 1
        }

        this.gen_stmts(body)

        // Ensure block has a terminator
        if (!this.block_terminated) {
            if (ret_llvm == "void") {
                this.emit_terminator("ret void")
            } else {
                this.emit_terminator("unreachable")
            }
        }

        this.emit("}")
        this.block_terminated = false
    }

    // --- Top-level ---

    fun generate(program: List<AST.Stmt>): String {
        // Generate all top-level declarations into sb
        var i = 0
        while (i < program.length()) {
            this.gen_stmt(program[i])
            i = i + 1
        }

        // Build final output with proper ordering
        var out = StringBuilder()
        out.append("; Generated by Saffron LLVM compiler\n")
        out.append("target triple = \"arm64-apple-macosx14.0.0\"\n\n")

        // String constants
        var j = 0
        while (j < this.string_constants.length()) {
            var s = this.string_constants[j]
            var name = "@.str." + j.floor().to_string()
            var len = s.length() + 1
            out.append(name + " = private unnamed_addr constant [" + len.to_string() + " x i8] c\"" + this.escape_llvm_string(s) + "\\00\"\n")
            j = j + 1
        }
        if (this.string_constants.length() > 0) {
            out.append("\n")
        }

        // Type definitions (enums as tagged unions)
        var td = this.type_defs.to_string()
        if (td.length() > 0) {
            out.append(td)
            out.append("\n")
        }

        // External declarations
        out.append("declare i32 @puts(i8*)\n")
        out.append("declare i32 @printf(i8*, ...)\n")
        out.append("declare i8* @malloc(i64)\n")
        out.append("declare i8* @realloc(i8*, i64)\n")
        out.append("declare void @free(i8*)\n")
        out.append("declare i64 @strlen(i8*)\n")
        out.append("declare i8* @strcpy(i8*, i8*)\n")
        out.append("declare i8* @strcat(i8*, i8*)\n")
        out.append("declare i8* @strstr(i8*, i8*)\n")
        out.append("declare i32 @strcmp(i8*, i8*)\n")
        out.append("declare void @llvm.memcpy.p0i8.p0i8.i64(i8*, i8*, i64, i1)\n\n")

        // List runtime
        out.append("; List = { count, capacity, data* }\n")
        out.append("%List = type { i64, i64, i64* }\n")
        out.append("; Map = { count, capacity, keys*, values* }\n")
        out.append("%Map = type { i64, i64, i64*, i64* }\n\n")
        out.append(this.list_runtime())
        out.append(this.map_runtime())

        // Lambda functions
        var k = 0
        while (k < this.globals.length()) {
            out.append(this.globals[k])
            k = k + 1
        }

        // Function bodies
        out.append(this.sb.to_string())

        return out.to_string()
    }
}

fun generate(program: List<AST.Stmt>): String {
    var gen = Codegen()
    return gen.generate(program)
}
