// Saffron Runtime: Non-blocking Socket Primitives
// ================================================
// Low-level TCP + TLS networking for compiled Saffron programs.
//
// These functions wrap the C shim (socket_native.c) which provides
// non-blocking POSIX socket operations + OpenSSL TLS.
//
// Async story:
//   The C layer is fully non-blocking — reads/writes return immediately
//   with a "would_block" sentinel if no data is available. Currently,
//   this Saffron wrapper does synchronous poll-loops (blocking the caller
//   until data arrives). When the cooperative I/O scheduler lands, these
//   loops will be replaced with yield points:
//     1. Attempt I/O
//     2. If would_block, register fd with the event loop and yield
//     3. Scheduler resumes the task when the fd is ready
//   The C API is already designed for this — no changes needed there.
//
// External C functions (declared in LLVM IR, linked from socket_native.c):
//   void    sf_socket_init()
//   i64     sf_tcp_connect(i8* host, i64 port)
//   i64     sf_tcp_poll(i64 fd, i64 events, i64 timeout_ms)
//   i64     sf_tcp_read(i64 fd, i8* buf, i64 len)
//   i64     sf_tcp_write(i64 fd, i8* buf, i64 len)
//   void    sf_tcp_close(i64 fd)
//   i64     sf_tls_connect(i64 fd, i8* hostname)
//   i64     sf_tls_read(i64 handle, i8* buf, i64 len)
//   i64     sf_tls_write(i64 handle, i8* buf, i64 len)
//   void    sf_tls_close(i64 handle)

// --- Module initialization ---

// Called once at program startup to initialize OpenSSL and internal tables.
fun socket_init() {
    // EXTERNAL: call void @sf_socket_init()
}

// --- Socket class ---

// A TCP connection handle. Wraps a file descriptor and optional TLS state.
// Created via connect() or connect_tls() — not instantiated directly.
class Socket {
    var fd: Int       // underlying OS file descriptor
    var tls_handle: Int  // TLS handle (0 = plaintext, >0 = TLS active)

    fun init(fd: Int, tls_handle: Int) {
        this.fd = fd
        this.tls_handle = tls_handle
    }

    // Read up to n bytes from the connection.
    // Blocks (poll-loops) until at least 1 byte is available.
    // Returns the data as a String, or empty string on connection close.
    fun read(n: Int): Int {
        // EXTERNAL: var buf: Int = call i8* @malloc(i64 n)
        var buf: Int = 0  // placeholder

        var bytes_read: Int = 0
        while (true) {
            if (this.tls_handle > 0) {
                // EXTERNAL: bytes_read = call i64 @sf_tls_read(i64 tls_handle, i8* buf, i64 n)
            } else {
                // EXTERNAL: bytes_read = call i64 @sf_tcp_read(i64 fd, i8* buf, i64 n)
            }

            if (bytes_read > 0) {
                // Got data — wrap in String and return
                // EXTERNAL: var result: Int = String_new_with_length(buf, bytes_read)
                // EXTERNAL: call void @free(i8* buf)
                var result: Int = 0  // placeholder
                return result
            }
            if (bytes_read == 0) {
                // Connection closed
                // EXTERNAL: call void @free(i8* buf)
                // Return empty string
                // EXTERNAL: var empty: Int = String_new("")
                var empty: Int = 0  // placeholder
                return empty
            }
            if (bytes_read == -2) {
                // Hard error
                // EXTERNAL: call void @free(i8* buf)
                var empty: Int = 0  // placeholder
                return empty
            }

            // bytes_read == -1: would_block — poll and retry
            // EXTERNAL: call i64 @sf_tcp_poll(i64 fd, i64 0, i64 1000)
            // TODO: When async scheduler exists, yield here instead of polling
        }

        var empty: Int = 0  // unreachable placeholder
        return empty
    }

    // Write all data to the connection.
    // Blocks (poll-loops) until all bytes are written.
    // Returns number of bytes written, or -1 on error.
    fun write(data: Int): Int {
        // data is a String object pointer
        // EXTERNAL: var data_ptr: Int = load from (data + 32)  — raw char*
        // EXTERNAL: var data_len: Int = load from (data + 24)  — length
        var data_ptr: Int = 0  // placeholder
        var data_len: Int = 0  // placeholder

        var total_written: Int = 0

        while (total_written < data_len) {
            var remaining: Int = data_len - total_written
            var written: Int = 0

            if (this.tls_handle > 0) {
                // EXTERNAL: written = call i64 @sf_tls_write(i64 tls_handle, i8* (data_ptr + total_written), i64 remaining)
            } else {
                // EXTERNAL: written = call i64 @sf_tcp_write(i64 fd, i8* (data_ptr + total_written), i64 remaining)
            }

            if (written > 0) {
                total_written = total_written + written
            } else if (written == -1) {
                // Would block — poll for writability and retry
                // EXTERNAL: call i64 @sf_tcp_poll(i64 fd, i64 1, i64 1000)
                // TODO: When async scheduler exists, yield here instead of polling
            } else {
                // Error
                return -1
            }
        }

        return total_written
    }

    // Poll for readability with a timeout in milliseconds.
    // Returns true if data is available to read, false on timeout.
    fun poll_read(timeout_ms: Int): Int {
        // EXTERNAL: var result: Int = call i64 @sf_tcp_poll(i64 fd, i64 0, i64 timeout_ms)
        var result: Int = 0  // placeholder
        if (result == 1) {
            return 1  // true: data available
        }
        return 0  // false: timeout or error
    }

    // Close the connection. Closes TLS first if active, then the socket.
    fun close() {
        if (this.tls_handle > 0) {
            // EXTERNAL: call void @sf_tls_close(i64 tls_handle)
            this.tls_handle = 0
        }
        if (this.fd >= 0) {
            // EXTERNAL: call void @sf_tcp_close(i64 fd)
            this.fd = -1
        }
    }
}

// --- Connection functions ---

// Connect to a host:port via TCP (plaintext).
// Blocks until connection is established or fails.
// Returns a Socket on success, or nil (0) on failure.
fun connect(host: Int, port: Int): Int {
    // host is a String object pointer
    // EXTERNAL: var host_str: Int = load from (host + 32)  — raw char*
    var host_str: Int = 0  // placeholder

    // EXTERNAL: var fd: Int = call i64 @sf_tcp_connect(i8* host_str, i64 port)
    var fd: Int = 0  // placeholder

    if (fd < 0) {
        return 0  // nil — connection failed
    }

    // Create a Socket instance with no TLS
    // EXTERNAL: var socket: Int = Socket_new(fd, 0)
    var socket: Int = 0  // placeholder
    return socket
}

// Connect to a host:port via TCP + TLS (for HTTPS, etc).
// Performs TCP connection followed by TLS handshake.
// Returns a Socket on success, or nil (0) on failure.
fun connect_tls(host: Int, port: Int): Int {
    // host is a String object pointer
    // EXTERNAL: var host_str: Int = load from (host + 32)  — raw char*
    var host_str: Int = 0  // placeholder

    // EXTERNAL: var fd: Int = call i64 @sf_tcp_connect(i8* host_str, i64 port)
    var fd: Int = 0  // placeholder

    if (fd < 0) {
        return 0  // nil — TCP connection failed
    }

    // Perform TLS handshake
    // EXTERNAL: var tls_handle: Int = call i64 @sf_tls_connect(i64 fd, i8* host_str)
    var tls_handle: Int = 0  // placeholder

    if (tls_handle < 0) {
        // TLS handshake failed — clean up the socket
        // EXTERNAL: call void @sf_tcp_close(i64 fd)
        return 0  // nil
    }

    // Create a Socket instance with TLS
    // EXTERNAL: var socket: Int = Socket_new(fd, tls_handle)
    var socket: Int = 0  // placeholder
    return socket
}
