// Saffron Runtime: Map Type (Enhanced)
// ================================================
// Maps are GC-managed key-value stores using parallel arrays with
// string-key comparison (strcmp). This matches the existing codegen
// implementation but adds GC tracking and higher-level operations.
//
// Object layout (after GC header at offset 0-23):
//   Offset 24: count (i64)     — number of entries
//   Offset 32: capacity (i64)  — allocated slots in keys/values arrays
//   Offset 40: keys (i64*)     — pointer to keys array (each key is a String ptr)
//   Offset 48: values (i64*)   — pointer to values array (each value is i64)
//
// Keys are compared using strcmp on their underlying i8* data.
// This is a simple linear-scan implementation suitable for small-to-medium maps.
// A hash table implementation can replace this later for O(1) lookups.
//
// PAYLOAD_SIZE = 32 (count + capacity + keys ptr + values ptr)

var MAP_PAYLOAD_SIZE: Int = 32
var MAP_INITIAL_CAPACITY: Int = 16

// --- Construction ---

// Create a new empty Map (GC-tracked version).
fun Map_new(): Int {
    // EXTERNAL: var obj: Int = GC_alloc(3, MAP_PAYLOAD_SIZE)
    var obj: Int = 0  // placeholder

    // EXTERNAL: store 0 at (obj + 24)  — count = 0
    // EXTERNAL: store MAP_INITIAL_CAPACITY at (obj + 32)  — capacity = 16

    // Allocate keys and values arrays
    // EXTERNAL: var keys: Int = malloc(MAP_INITIAL_CAPACITY * 8)
    // EXTERNAL: var values: Int = malloc(MAP_INITIAL_CAPACITY * 8)
    var keys: Int = 0    // placeholder
    var values: Int = 0  // placeholder

    // EXTERNAL: store keys at (obj + 40)
    // EXTERNAL: store values at (obj + 48)

    return obj
}

// --- Internal accessors ---

fun Map_count(map: Int): Int {
    // EXTERNAL: var count: Int = load from (map + 24)
    var count: Int = 0  // placeholder
    return count
}

fun Map_capacity_get(map: Int): Int {
    // EXTERNAL: var cap: Int = load from (map + 32)
    var cap: Int = 0  // placeholder
    return cap
}

fun Map_keys_array(map: Int): Int {
    // EXTERNAL: var keys: Int = load from (map + 40)
    var keys: Int = 0  // placeholder
    return keys
}

fun Map_values_array(map: Int): Int {
    // EXTERNAL: var values: Int = load from (map + 48)
    var values: Int = 0  // placeholder
    return values
}

// --- Growth ---

// Ensure there is room for at least one more entry.
fun Map_ensure_capacity(map: Int) {
    var count: Int = Map_count(map)
    var cap: Int = Map_capacity_get(map)

    if (count < cap) {
        return nil
    }

    var new_cap: Int = cap * 2
    var keys: Int = Map_keys_array(map)
    var values: Int = Map_values_array(map)

    // EXTERNAL: var new_keys: Int = realloc(keys, new_cap * 8)
    // EXTERNAL: var new_values: Int = realloc(values, new_cap * 8)
    var new_keys: Int = 0    // placeholder
    var new_values: Int = 0  // placeholder

    // EXTERNAL: store new_cap at (map + 32)
    // EXTERNAL: store new_keys at (map + 40)
    // EXTERNAL: store new_values at (map + 48)
}

// --- Lookup ---

// Find the index of a key in the map. Returns the index or -1 if not found.
// Key comparison is done via strcmp on the underlying char data.
fun Map_find_key(map: Int, key: Int): Int {
    var count: Int = Map_count(map)
    var keys: Int = Map_keys_array(map)

    // Get the raw char* from the key String object
    // EXTERNAL: var key_data: Int = String_data(key)  or load from (key + 32)
    var key_data: Int = 0  // placeholder

    var i: Int = 0
    while (i < count) {
        // EXTERNAL: var k: Int = load from (keys + i*8)
        var k: Int = 0  // placeholder

        // Get raw char* from stored key
        // EXTERNAL: var k_data: Int = String_data(k)  or load from (k + 32)
        var k_data: Int = 0  // placeholder

        // EXTERNAL: var cmp: Int = strcmp(key_data, k_data)
        var cmp: Int = 0  // placeholder
        if (cmp == 0) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// --- Core operations ---

// Get the value associated with a key. Returns 0 (nil) if not found.
fun Map_get(map: Int, key: Int): Int {
    var idx: Int = Map_find_key(map, key)
    if (idx < 0) {
        return 0
    }

    var values: Int = Map_values_array(map)
    // EXTERNAL: var val: Int = load from (values + idx*8)
    var val: Int = 0  // placeholder
    return val
}

// Set a key-value pair. If the key exists, update the value.
// If it doesn't exist, append a new entry.
fun Map_set(map: Int, key: Int, value: Int) {
    var idx: Int = Map_find_key(map, key)

    if (idx >= 0) {
        // Update existing entry
        var values: Int = Map_values_array(map)
        // EXTERNAL: store value at (values + idx*8)
        return nil
    }

    // Insert new entry
    Map_ensure_capacity(map)
    var count: Int = Map_count(map)
    var keys: Int = Map_keys_array(map)
    var values: Int = Map_values_array(map)

    // EXTERNAL: store key at (keys + count*8)
    // EXTERNAL: store value at (values + count*8)
    // EXTERNAL: store (count + 1) at (map + 24)
}

// Check if a key exists in the map. Returns 1 or 0.
fun Map_has(map: Int, key: Int): Int {
    var idx: Int = Map_find_key(map, key)
    if (idx >= 0) {
        return 1
    }
    return 0
}

// --- New operations ---

// Delete a key from the map. Shifts the last entry into the deleted slot
// to maintain a compact array (order is not preserved).
fun Map_delete(map: Int, key: Int) {
    var idx: Int = Map_find_key(map, key)
    if (idx < 0) {
        return nil
    }

    var count: Int = Map_count(map)
    var last: Int = count - 1

    if (idx != last) {
        // Move last entry into the deleted slot
        var keys: Int = Map_keys_array(map)
        var values: Int = Map_values_array(map)

        // EXTERNAL: var last_key: Int = load from (keys + last*8)
        // EXTERNAL: var last_val: Int = load from (values + last*8)
        // EXTERNAL: store last_key at (keys + idx*8)
        // EXTERNAL: store last_val at (values + idx*8)
    }

    // Decrement count
    // EXTERNAL: store (count - 1) at (map + 24)
}

// Return a List containing all keys in the map.
fun Map_keys(map: Int): Int {
    var count: Int = Map_count(map)
    var keys_arr: Int = Map_keys_array(map)

    // EXTERNAL: var result: Int = List_new()  or __list_new()
    var result: Int = 0  // placeholder

    var i: Int = 0
    while (i < count) {
        // EXTERNAL: var k: Int = load from (keys_arr + i*8)
        var k: Int = 0  // placeholder
        // EXTERNAL: __list_push(result, k)
        i = i + 1
    }

    return result
}

// Return a List containing all values in the map.
fun Map_values(map: Int): Int {
    var count: Int = Map_count(map)
    var vals_arr: Int = Map_values_array(map)

    // EXTERNAL: var result: Int = List_new()  or __list_new()
    var result: Int = 0  // placeholder

    var i: Int = 0
    while (i < count) {
        // EXTERNAL: var v: Int = load from (vals_arr + i*8)
        var v: Int = 0  // placeholder
        // EXTERNAL: __list_push(result, v)
        i = i + 1
    }

    return result
}

// Return the number of entries (public API).
fun Map_size(map: Int): Int {
    return Map_count(map)
}

// Remove all entries from the map.
fun Map_clear(map: Int) {
    // EXTERNAL: store 0 at (map + 24)  — count = 0
    // Note: we don't shrink the arrays, just reset the count.
    // The GC will reclaim the map when it becomes unreachable.
}
