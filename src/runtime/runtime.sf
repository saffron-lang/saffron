// Saffron Runtime Library
// Provides List, Map, StringBuilder, String ops, I/O, and OS primitives.
// Compiled to LLVM IR and linked with every native program.

// --- C Library Bindings ---

// rt_malloc/rt_realloc/rt_free bind to the cap-aware wrappers in gc.ll rather
// than libc directly, so that --max-memory / SAFFRON_MAX_MEMORY covers all ~60
// rt_malloc sites in this file. The wrappers are pass-throughs (one load and a
// branch) when no limit is set. See the "Memory Cap" section of gc.ll.
@extern("void* __sf_malloc(i64)") fun rt_malloc(size: Int): Int
@extern("void* __sf_realloc(void*, i64)") fun rt_realloc(ptr: Int, size: Int): Int
@extern("void __sf_free(void*)") fun rt_free(ptr: Int)
@extern("i64 strlen(void*)") fun rt_strlen(s: Int): Int
@extern("void* strcpy(void*, void*)") fun rt_strcpy(dst: Int, src: Int): Int
@extern("void* strcat(void*, void*)") fun rt_strcat(dst: Int, src: Int): Int
@extern("void* strstr(void*, void*)") fun rt_strstr(haystack: Int, needle: Int): Int
@extern("i32 strcmp(void*, void*)") fun rt_strcmp(a: Int, b: Int): Int
@extern("void* strdup(void*)") fun rt_strdup(s: Int): Int
@extern("void* memcpy(void*, void*, i64)") fun rt_memcpy(dst: Int, src: Int, n: Int): Int
@extern("i32 snprintf(void*, i64, void*, ...)") fun rt_snprintf(buf: Int, size: Int, fmt: Int, val: Int): Int
@extern("void* fopen(void*, void*)") fun rt_fopen(path: Int, mode: Int): Int
@extern("i64 fread(void*, i64, i64, void*)") fun rt_fread(buf: Int, size: Int, count: Int, fp: Int): Int
@extern("i64 fwrite(void*, i64, i64, void*)") fun rt_fwrite(buf: Int, size: Int, count: Int, fp: Int): Int
@extern("i32 fclose(void*)") fun rt_fclose(fp: Int): Int
@extern("i32 fseek(void*, i64, i32)") fun rt_fseek(fp: Int, offset: Int, whence: Int): Int
@extern("i64 ftell(void*)") fun rt_ftell(fp: Int): Int
@extern("void* fgets(void*, i32, void*)") fun rt_fgets(buf: Int, size: Int, fp: Int): Int
@extern("void* popen(void*, void*)") fun rt_popen(cmd: Int, mode: Int): Int
@extern("i32 pclose(void*)") fun rt_pclose(fp: Int): Int
@extern("i32 access(void*, i32)") fun rt_access(path: Int, mode: Int): Int
@extern("i32 mkdir(void*, i32)") fun rt_mkdir(path: Int, mode: Int): Int
@extern("i32 rename(void*, void*)") fun rt_rename(from: Int, to: Int): Int
@extern("i32 remove(void*)") fun rt_remove(path: Int): Int
// is_dir is probed with opendir rather than stat: `struct stat` has no stable
// layout to hand-offset into from Saffron, and its size differs across the four
// IR bases. opendir succeeds only on a directory, which is exactly the question.
@extern("void* opendir(void*)") fun rt_opendir(path: Int): Int
@extern("i32 closedir(void*)") fun rt_closedir(dp: Int): Int
@extern("void* getcwd(void*, i64)") fun rt_getcwd(buf: Int, size: Int): Int
@extern("void* getenv(void*)") fun rt_getenv(name: Int): Int
@extern("i32 setenv(void*, void*, i32)") fun rt_setenv(name: Int, value: Int, overwrite: Int): Int
@extern("i64 write(i32, void*, i64)") fun rt_write(fd: Int, buf: Int, len: Int): Int
@extern("i64 read(i32, void*, i64)") fun rt_read(fd: Int, buf: Int, count: Int): Int
@extern("void exit(i32)") fun rt_exit(code: Int)
@extern("void __print_debug_location()") fun __print_debug_location()

// --- GC Functions (defined in gc.ll, linked alongside) ---

@extern("i64 __gc_alloc(i64, i64)") fun __gc_alloc(size: Int, type_tag: Int): Int
@extern("i64 __gc_realloc(i64, i64, i64)") fun __gc_realloc(old_ptr: Int, new_size: Int, type_tag: Int): Int
@extern("i64 __gc_alloc_safe(i64, i64)") fun __gc_alloc_safe(size: Int, type_tag: Int): Int
@extern("i64 __val_untag_int(i64)") fun __rt_untag_int(v: Int): Int

// --- Intrinsics ---

@intrinsic fun load64(addr: Int): Int
@intrinsic fun store64(addr: Int, val: Int)
@intrinsic fun load8(addr: Int): Int
@intrinsic fun store8(addr: Int, val: Int)


// =============================================================================
// List: { count@0, capacity@8, data*@16 } — 24 bytes
// =============================================================================

fun __list_new(): Int {
    var raw: Int = __gc_alloc(24, 2)
    store64(raw, 0)                              // count = 0
    store64(raw + 8, 8)                  // capacity = 8
    store64(raw + 16, __gc_alloc(64, 7))  // data ptr
    return raw
}

fun __list_push(list: Int, value: Int) {
    if (list == 0) { __null_pointer_error() }
    var count: Int = load64(list)
    var cap: Int = load64(list + 8)
    if (count >= cap) {
        var new_cap: Int = cap * 2
        var old_data: Int = load64(list + 16)
        var new_data: Int = __gc_realloc(old_data, new_cap * 8, 7)
        if (new_data != 0) {
            store64(list + 8, new_cap)
            store64(list + 16, new_data)
        }
    }
    var data: Int = load64(list + 16)
    store64(data + count * 8, value)
    store64(list, count + 1)
}

// Like __list_push but uses __gc_alloc_safe to grow (no GC triggered).
// Used by __str_split to avoid nursery invalidation.
fun __split_push(list: Int, value: Int) {
    var count: Int = load64(list)
    var cap: Int = load64(list + 8)
    if (count >= cap) {
        var new_cap: Int = cap * 2
        var old_data: Int = load64(list + 16)
        var new_data: Int = __gc_alloc_safe(new_cap * 8, 7)
        if (new_data != 0) {
            rt_memcpy(new_data, old_data, cap * 8)
            store64(list + 8, new_cap)
            store64(list + 16, new_data)
        }
    }
    var data: Int = load64(list + 16)
    store64(data + count * 8, value)
    store64(list, count + 1)
}

fun __list_get(list: Int, index: Int): Int {
    if (list == 0) { __null_pointer_error() }
    var count: Int = load64(list)
    var actual_idx: Int = index
    if (actual_idx < 0) {
        actual_idx = count + actual_idx
    }
    if (actual_idx < 0 or actual_idx >= count) {
        __index_error(actual_idx, count)
        return 0
    }
    var data: Int = load64(list + 16)
    return load64(data + actual_idx * 8)
}

fun __list_set(list: Int, index: Int, value: Int) {
    if (list == 0) { __null_pointer_error() }
    var count: Int = load64(list)
    var actual_idx: Int = index
    if (actual_idx < 0) {
        actual_idx = count + actual_idx
    }
    if (actual_idx < 0 or actual_idx >= count) {
        __index_error(actual_idx, count)
        return
    }
    var data: Int = load64(list + 16)
    store64(data + actual_idx * 8, value)
}

fun __list_length(list: Int): Int {
    if (list == 0) { return 0 }
    return load64(list)
}

fun __list_pop(list: Int): Int {
    if (list == 0) { __null_pointer_error() }
    var count: Int = load64(list)
    if (count <= 0) {
        __index_error(0, 0)
        return 0
    }
    var new_count: Int = count - 1
    store64(list, new_count)
    var data: Int = load64(list + 16)
    return load64(data + new_count * 8)
}

fun __list_remove(list: Int, index: Int): Int {
    if (list == 0) { return __rt_nil() }
    var count: Int = load64(list)
    var idx: Int = index
    if (idx < 0 or idx >= count) { return __rt_nil() }
    var data: Int = load64(list + 16)
    var removed: Int = load64(data + idx * 8)
    var i: Int = idx
    while (i < count - 1) {
        store64(data + i * 8, load64(data + (i + 1) * 8))
        i = i + 1
    }
    store64(list, count - 1)
    return removed
}

fun __list_slice(list: Int, start: Int, end: Int): Int {
    var result: Int = __list_new()
    if (list == 0) { return result }
    var len: Int = __list_length(list)
    var s: Int = start
    var e: Int = end
    if (s < 0) { s = 0 }
    if (e > len) { e = len }
    while (s < e) {
        __list_push(result, __list_get(list, s))
        s = s + 1
    }
    return result
}

// =============================================================================
// StringBuilder: { len@0, cap@8, buf*@16 } — 24 bytes
// =============================================================================

fun StringBuilder(): Int {
    var raw: Int = __gc_alloc(24, 6)
    store64(raw, 0)
    store64(raw + 8, 1024)
    var buf: Int = __gc_alloc(1024, 0)
    store8(buf, 0)
    store64(raw + 16, buf)
    return raw
}

fun __sb_append(sb: Int, str: Int) {
    if (str == 0) { return }
    var len: Int = load64(sb)
    var cap: Int = load64(sb + 8)
    var buf: Int = load64(sb + 16)
    var slen: Int = rt_strlen(str)
    var needed: Int = len + slen + 1
    if (needed >= cap) {
        var new_cap: Int = needed * 2
        var new_buf: Int = __gc_realloc(buf, new_cap, 0)
        if (new_buf != 0) {
            buf = new_buf
            store64(sb + 8, new_cap)
            store64(sb + 16, buf)
        }
    }
    rt_memcpy(buf + len, str, slen)
    var new_len: Int = len + slen
    store64(sb, new_len)
    store8(buf + new_len, 0)
}

fun __sb_to_string(sb: Int): Int {
    return load64(sb + 16)
}

// =============================================================================
// Map: { count@0, capacity@8, keys*@16, values*@24 } — 32 bytes
// =============================================================================

@extern("void* __val_untag_ptr(i64)") fun __rt_untag_ptr(val: Int): Int
@extern("i64 __val_untag_int(i64)") fun __rt_untag_int(val: Int): Int

// Runtime-dispatched value->string (defined in base*.ll). Inspects the
// NaN-box tag to pick int/float/bool/nil/string formatting. Returns raw char*.
@extern("i64 __any_to_string(i64)") fun __any_to_string(val: Int): Int
// Read the GC type tag from a raw (untagged) GC pointer. TYPE_LIST == 2.
@extern("i64 __gc_get_type_tag(i64)") fun __rt_gc_type_tag(ptr: Int): Int

// NaN-boxed nil sentinel (0x7FFA000000000002 = 9221683186994511874).
// Cannot use `nil` keyword here: identity-mode compiles nil to raw 0.
fun __rt_nil(): Int {
    return 9221683186994511874
}

fun __safe_strcmp(a: Int, b: Int): Int {
    var ra: Int = __rt_untag_ptr(a)
    var rb: Int = __rt_untag_ptr(b)
    if (ra == 0) { return 1 }
    if (rb == 0) { return 1 }
    return rt_strcmp(ra, rb)
}

// Reinterpret a value as a double and hand back the raw IEEE-754 bit pattern.
//
// The `double` return is deliberate and load-bearing. runtime.sf is compiled
// with --identity-mode, where codegen lowers a double-returning extern with a
// plain `bitcast double to i64` (types_body.sf emit_tag_float), so this yields
// the *bits* rather than a re-boxed value — the only way to get at a double from
// runtime.sf, which has no float arithmetic of its own in identity mode.
//
// __val_untag_float also normalises the two numeric representations for free: a
// TAG_INT value is converted (sitofp) and a bare double passes through, so one
// call covers Int and Float without the caller having to branch on the tag.
@extern("double __val_untag_float(i64)") fun __rt_float_bits(val: Int): Int

// Map an IEEE-754 bit pattern to an i64 whose *signed integer* order is the same
// as the double's numeric order, so a plain `<` on the keys sorts the doubles.
//
// Positive doubles already sort by bit pattern (the exponent sits above the
// mantissa, and the sign bit is clear so the i64 is non-negative). Negative
// doubles sort backwards — a larger magnitude means a more negative number — so
// strip the sign bit to recover the magnitude and negate it. -0.0 and +0.0 both
// map to 0, which is the answer `==` gives too.
fun __rt_dbl_key(bits: Int): Int {
    if (bits >= 0) { return bits }
    var mag: Int = bits & 9223372036854775807
    return 0 - mag
}

// Three-way ordering comparison for two values of unknown static type.
// Returns -1 when a < b, 1 when a > b, 0 when neither (equal or incomparable),
// i.e. the strcmp convention, so callers read `< 0` / `> 0`.
//
// This exists because codegen cannot always know the operand types. `<`, `<=`,
// `>` and `>=` used to be gated on a *static* test for String, and every generic
// container declares its elements `Any`, so `this._items[mid] < value` fell
// through to the integer path and compared the bit patterns of two heap
// pointers. That is not merely wrong, it is wrong *by heap layout*: the same
// source through the same compiler answered differently at -O0 and -O2, because
// at -O2 the interned literals happened to land in addresses whose order agreed
// with alphabetical order (BUGS #104).
//
// The dispatch is on the NaN-box tag of BOTH operands, which is the only
// authority available at the point the comparison actually happens:
//
//   both TAG_PTR (0x7FF8)  → heap pointers; compare contents with strcmp. This
//                            is the same conservative choice __any_eq makes:
//                            string literals are plain malloc'd char* with no GC
//                            header, so the GC type tag cannot be consulted (see
//                            __rt_as_string_ptr) and TAG_PTR is all there is.
//   anything else          → compare numerically through the double key above,
//                            which handles Int vs Float mixtures correctly.
//
// Untagged pointers (upper == 0), which is what identity mode and a raw
// constructor result look like, are deliberately NOT treated as strings. The
// `> 65536` heuristic __map_key_str uses to guess "this is a pointer" is safe
// there because a mis-guess only costs a failed key match; here it would hand a
// large integer to strcmp and segfault. Ordering is defined for strings and
// numbers, and identity mode has no strings to order.
fun __val_cmp(a: Int, b: Int): Int {
    if (a == b) { return 0 }
    var ua: Int = a >> 48
    var ub: Int = b >> 48
    if (ua == 32760 and ub == 32760) {
        var ra: Int = __rt_untag_ptr(a)
        var rb: Int = __rt_untag_ptr(b)
        if (ra != 0 and rb != 0) {
            var c: Int = rt_strcmp(ra, rb)
            if (c < 0) { return 0 - 1 }
            if (c > 0) { return 1 }
            return 0
        }
        return 0
    }
    var ka: Int = __rt_dbl_key(__rt_float_bits(a))
    var kb: Int = __rt_dbl_key(__rt_float_bits(b))
    if (ka < kb) { return 0 - 1 }
    if (ka > kb) { return 1 }
    return 0
}

// The four relational operators, as the runtime entry points codegen calls when
// the static types do not settle the comparison. Separate symbols rather than
// one plus a codegen-side icmp so the call site stays a single instruction and
// the operator is legible in the emitted IR.
fun __val_lt(a: Int, b: Int): Int {
    if (__val_cmp(a, b) < 0) { return 1 }
    return 0
}

fun __val_le(a: Int, b: Int): Int {
    if (__val_cmp(a, b) <= 0) { return 1 }
    return 0
}

fun __val_gt(a: Int, b: Int): Int {
    if (__val_cmp(a, b) > 0) { return 1 }
    return 0
}

fun __val_ge(a: Int, b: Int): Int {
    if (__val_cmp(a, b) >= 0) { return 1 }
    return 0
}

// Is this map key safe to hand to strcmp?
//
// Map keys reach the runtime in two forms, because the compiler compiles
// *itself* in identity mode (base.ll), where tagging is a no-op, while user
// programs run against base_nanbox.ll, where it is not. So a key is either a
// NaN-boxed value or a bare pointer, and this has to accept both.
//
//   TAG_PTR (0x7FF8)  → NaN-boxed heap pointer; strcmp the payload
//   upper == 0        → identity mode / bare pointer. Small values cannot be
//                       pointers, so the same >65536 guard used by
//                       __rt_as_list_ptr keeps numeric keys out of the deref.
//   anything else     → TAG_INT, TAG_SPEC, or a float: never a string
//
// Returns the raw char* to compare, or 0 when the key is not a string.
fun __map_key_str(v: Int): Int {
    if (v == 0) { return 0 }
    var upper: Int = v >> 48
    if (upper == 32760) { return __rt_untag_ptr(v) }
    if (upper == 0 and v > 65536) { return v }
    return 0
}

// Compare two map keys. Returns 0 when equal, non-zero otherwise (same
// convention as strcmp, so callers read `== 0`).
//
// __map_set used to hand every stored key straight to __safe_strcmp, which
// untags and calls strcmp unconditionally. For a NaN-boxed Int the low 48 bits
// ARE the number, so `m.set(10, ...)` followed by `m.set(20, ...)` called
// strcmp(0xA, 0x14) and segfaulted on the second insertion. A single-entry map
// never enters the comparison loop at all, which is why the crash needed two
// keys to appear.
//
// Only two string keys are compared by content; everything else is compared by
// exact bit pattern, which is right for ints, bools, nil, and floats alike
// (keys come from literals and stored values, not from arithmetic that could
// produce -0.0 or NaN).
fun __map_key_cmp(a: Int, b: Int): Int {
    if (a == b) { return 0 }
    var ra: Int = __map_key_str(a)
    if (ra == 0) { return 1 }
    var rb: Int = __map_key_str(b)
    if (rb == 0) { return 1 }
    return rt_strcmp(ra, rb)
}

// Tag a stored map key for handing back out to Saffron code (__map_keys).
//
// Identity-mode keys are bare pointers and must be tagged on the way out, the
// way __map_keys always did. NaN-boxed keys already carry their tag and must be
// passed through untouched — re-tagging stamped TAG_PTR onto numeric keys and
// turned `for (k in m.keys())` on a Map<Int, _> into a pointer built out of the
// number itself.
fun __map_key_box(v: Int): Int {
    if (v == 0) { return v }
    var upper: Int = v >> 48
    if (upper == 0) { return __rt_tag_ptr(v) }
    return v
}

fun __string_contains_str(haystack: Int, needle: Int): Int {
    var h: Int = __rt_untag_ptr(haystack)
    var n: Int = __rt_untag_ptr(needle)
    if (h == 0 or n == 0) { return 0 }
    var result: Int = rt_strstr(h, n)
    if (result == 0) { return 0 }
    return 1
}

fun __list_contains_str(list: Int, val: Int): Int {
    if (list == 0) { return 0 }
    var raw_val: Int = __rt_untag_ptr(val)
    var count: Int = load64(list)
    var data: Int = load64(list + 16)
    var i: Int = 0
    while (i < count) {
        var elem: Int = load64(data + i * 8)
        var raw_elem: Int = __rt_untag_ptr(elem)
        if (raw_val == 0 and raw_elem == 0) { return 1 }
        if (raw_val == 0 or raw_elem == 0) { i = i + 1; continue }
        if (rt_strcmp(raw_val, raw_elem) == 0) { return 1 }
        i = i + 1
    }
    return 0
}

fun __map_new(): Int {
    var raw: Int = __gc_alloc(32, 3)
    store64(raw, 0)
    store64(raw + 8, 16)
    store64(raw + 16, __gc_alloc(128, 8))
    store64(raw + 24, __gc_alloc(128, 8))
    return raw
}

fun __map_set(map: Int, key: Int, value: Int) {
    if (map == 0) { __null_pointer_error() }
    var count: Int = load64(map)
    var cap: Int = load64(map + 8)
    var keys: Int = load64(map + 16)
    var vals: Int = load64(map + 24)
    var i: Int = 0
    while (i < count) {
        var kval: Int = load64(keys + i * 8)
        if (__map_key_cmp(key, kval) == 0) {
            store64(vals + i * 8, value)
            return
        }
        i = i + 1
    }
    if (count >= cap) {
        var new_cap: Int = cap * 2
        var new_bytes: Int = new_cap * 8
        var new_keys: Int = __gc_realloc(keys, new_bytes, 8)
        var new_vals: Int = __gc_realloc(vals, new_bytes, 8)
        if (new_keys != 0 and new_vals != 0) {
            store64(map + 8, new_cap)
            store64(map + 16, new_keys)
            store64(map + 24, new_vals)
        }
    }
    var cur_keys: Int = load64(map + 16)
    var cur_vals: Int = load64(map + 24)
    store64(cur_keys + count * 8, key)
    store64(cur_vals + count * 8, value)
    store64(map, count + 1)
}

fun __map_get(map: Int, key: Int): Int {
    if (map == 0) { return __rt_nil() }
    var count: Int = load64(map)
    var keys: Int = load64(map + 16)
    var vals: Int = load64(map + 24)
    var i: Int = 0
    while (i < count) {
        var kval: Int = load64(keys + i * 8)
        if (__map_key_cmp(key, kval) == 0) {
            return load64(vals + i * 8)
        }
        i = i + 1
    }
    return __rt_nil()
}

fun __map_has(map: Int, key: Int): Int {
    if (map == 0) { return 0 }
    var count: Int = load64(map)
    var keys: Int = load64(map + 16)
    var i: Int = 0
    while (i < count) {
        var kval: Int = load64(keys + i * 8)
        if (__map_key_cmp(key, kval) == 0) {
            return 1
        }
        i = i + 1
    }
    return 0
}

fun __map_keys(map: Int): Int {
    if (map == 0) { return __list_new() }
    var count: Int = load64(map)
    var kp: Int = load64(map + 16)
    var list: Int = __list_new()
    var i: Int = 0
    while (i < count) {
        // Keys are stored already NaN-boxed, so push them through unchanged.
        // This used to call __rt_tag_ptr on every key, which stamped TAG_PTR
        // onto numeric keys and made `for (k in m.keys())` on a Map<Int, _>
        // hand consumers a pointer built out of the number itself.
        __list_push(list, __map_key_box(load64(kp + i * 8)))
        i = i + 1
    }
    return list
}

fun __map_values(map: Int): Int {
    if (map == 0) { return __list_new() }
    var count: Int = load64(map)
    var vp: Int = load64(map + 24)
    var list: Int = __list_new()
    var i: Int = 0
    while (i < count) {
        __list_push(list, load64(vp + i * 8))
        i = i + 1
    }
    return list
}

// =============================================================================
// String Utilities
// =============================================================================

fun __int_to_string(val: Int): Int {
    var buf: Int = __gc_alloc(32, 1)
    var fmt: Int = rt_malloc(4)
    store8(fmt, 37)
    store8(fmt + 1, 108)
    store8(fmt + 2, 100)
    store8(fmt + 3, 0)
    rt_snprintf(buf, 32, fmt, val)
    rt_free(fmt)
    return buf
}

// If `v` refers to a GC-managed list, return its raw (untagged) pointer.
// Returns 0 for anything that is not a list. Accepts both NaN-boxed pointer
// values (0x7FF8 tag) and bare raw pointers, since list values reach the
// runtime in both forms depending on where they were produced.
fun __rt_as_list_ptr(v: Int): Int {
    if (v == 0) { return 0 }
    var upper: Int = v >> 48
    var raw: Int = 0
    if (upper == 32760) {
        // NaN-boxed heap pointer (TAG_PTR)
        raw = __rt_untag_ptr(v)
    } else if (upper == 0 and v > 65536) {
        // Plausible bare heap pointer (identity mode / untagged runtime value).
        // The >65536 guard keeps small ints out of the pointer-deref path.
        raw = v
    } else {
        // Int tag (0x7FF9), special tag (0x7FFA), or a float: never a list.
        return 0
    }
    if (raw == 0) { return 0 }
    // Verify the GC header magic sentinel before trusting the type tag.
    var magic: Int = load64(raw - 8)
    if (magic != 6557403441622859503) { return 0 }
    if (__rt_gc_type_tag(raw) != 2) { return 0 }
    return raw
}

// If `v` refers to a GC-managed string, return its raw (untagged) pointer.
// Returns 0 for anything else. Same shape as __rt_as_list_ptr/__rt_as_map_ptr.
//
// Only GC-allocated strings are recognised: the header sentinel is what makes
// this safe to attempt on a bare integer at all. A plain malloc'd char* has no
// header to check, so it cannot be told apart from a float bit pattern here and
// is deliberately not claimed.
fun __rt_as_string_ptr(v: Int): Int {
    if (v == 0) { return 0 }
    var upper: Int = v >> 48
    var raw: Int = 0
    if (upper == 32760) {
        raw = __rt_untag_ptr(v)
    } else if (upper == 0 and v > 65536) {
        raw = v
    } else {
        return 0
    }
    if (raw == 0) { return 0 }
    var magic: Int = load64(raw - 8)
    if (magic != 6557403441622859503) { return 0 }
    if (__rt_gc_type_tag(raw) != 1) { return 0 }
    return raw
}

// Format a single collection element. Dispatches on the NaN-box tag via
// __any_to_string (the same path that makes `IO.println(xs[0])` correct),
// recursing for nested lists and maps. Returns a raw char*.
//
// __any_to_string handles lists itself now, but the explicit check stays: it
// keeps the recursion local and avoids depending on which base*.ll the program
// happens to link against — base.ll's identity-mode stub does no dispatch.
fun __rt_elem_to_string(elem: Int): Int {
    var as_list: Int = __rt_as_list_ptr(elem)
    if (as_list != 0) {
        return __list_to_string(as_list)
    }
    var as_map: Int = __rt_as_map_ptr(elem)
    if (as_map != 0) {
        return __map_to_string(as_map)
    }
    var as_str: Int = __rt_as_string_ptr(elem)
    if (as_str != 0) {
        return as_str
    }
    return __any_to_string(elem)
}

fun __list_to_string(list: Int): Int {
    if (list == 0) {
        var nil_s: Int = __gc_alloc(3, 1)
        store8(nil_s, 91)      // [
        store8(nil_s + 1, 93)  // ]
        store8(nil_s + 2, 0)
        return nil_s
    }
    var count: Int = load64(list)
    var data: Int = load64(list + 16)
    // Growable buffer: element strings are unbounded (strings, nested lists),
    // so a fixed per-element estimate is not safe.
    var buf_p: Int = rt_malloc(8)
    var len_p: Int = rt_malloc(8)
    var cap_p: Int = rt_malloc(8)
    var init_buf: Int = rt_malloc(64)
    store8(init_buf, 0)
    store64(buf_p, init_buf)
    store64(len_p, 0)
    store64(cap_p, 64)
    var open_b: Int = rt_malloc(2)
    store8(open_b, 91)     // [
    store8(open_b + 1, 0)
    var close_b: Int = rt_malloc(2)
    store8(close_b, 93)    // ]
    store8(close_b + 1, 0)
    var sep_b: Int = rt_malloc(3)
    store8(sep_b, 44)      // ,
    store8(sep_b + 1, 32)  // (space)
    store8(sep_b + 2, 0)
    __join_append(buf_p, len_p, cap_p, open_b, 1)
    var i: Int = 0
    while (i < count) {
        if (i > 0) {
            __join_append(buf_p, len_p, cap_p, sep_b, 2)
        }
        var elem: Int = load64(data + i * 8)
        var elem_str: Int = __rt_elem_to_string(elem)
        if (elem_str != 0) {
            __join_append(buf_p, len_p, cap_p, elem_str, rt_strlen(elem_str))
        }
        i = i + 1
    }
    __join_append(buf_p, len_p, cap_p, close_b, 1)
    var result: Int = load64(buf_p)
    rt_free(open_b)
    rt_free(close_b)
    rt_free(sep_b)
    rt_free(buf_p)
    rt_free(len_p)
    rt_free(cap_p)
    return result
}

// If `v` refers to a GC-managed map, return its raw (untagged) pointer.
// Returns 0 for anything that is not a map. Mirrors __rt_as_list_ptr: map
// values also reach the runtime both NaN-boxed and bare, since __map_new
// returns a raw pointer.
fun __rt_as_map_ptr(v: Int): Int {
    if (v == 0) { return 0 }
    var upper: Int = v >> 48
    var raw: Int = 0
    if (upper == 32760) {
        raw = __rt_untag_ptr(v)
    } else if (upper == 0 and v > 65536) {
        // Plausible bare heap pointer. The >65536 guard keeps small ints out
        // of the pointer-deref path.
        raw = v
    } else {
        return 0
    }
    if (raw == 0) { return 0 }
    // Verify the GC header magic sentinel before trusting the type tag.
    var magic: Int = load64(raw - 8)
    if (magic != 6557403441622859503) { return 0 }
    if (__rt_gc_type_tag(raw) != 3) { return 0 }
    return raw
}

// Element at *position* i of an iteration over `v` — the `for-in` desugaring's
// element read, distinct from an index/key lookup (BUGS #62).
//
// `for (x in coll)` desugars to an index-driven while loop, and the element read
// used to be an ordinary `coll[i]`. For a List or a String that is the same thing
// as "the i'th element", but for a Map it is not: `m[k]` is a *key* lookup, so on
// a Map the loop passed its integer cursor to __map_get as a key. On a
// Map<String,_> that missed every time and yielded nil; on a Map<Int,_> it would
// silently look up the keys 0, 1, 2... instead of walking the entries. The two
// operations only looked alike because Lists happen to be indexable.
//
// Dispatching here rather than in codegen is what makes `for-in` work over an
// `Any`-typed or generic receiver, where the static type is unavailable — the
// same reason __any_length exists. A Map yields a two-element `[key, value]`
// list, which is what `for ([k, v] in m)` destructures and what CLAUDE.md has
// always documented.
fun __any_iter_get(v: Int, index: Int): Int {
    var as_map: Int = __rt_as_map_ptr(v)
    if (as_map != 0) {
        var count: Int = load64(as_map)
        if (index < 0 or index >= count) {
            __index_error(index, count)
            return __rt_nil()
        }
        var keys: Int = load64(as_map + 16)
        var vals: Int = load64(as_map + 24)
        var pair: Int = __list_new()
        // Keys are stored already NaN-boxed; __map_key_box tags only the ones
        // that need it, the same treatment __map_keys gives them.
        __list_push(pair, __map_key_box(load64(keys + index * 8)))
        __list_push(pair, load64(vals + index * 8))
        // Returned RAW, not __rt_tag_ptr'd. Containers travel untagged
        // everywhere (__list_new and __map_keys both hand back a bare pointer)
        // because __gc_is_heap_ptr rejects any NaN-tagged value as a heap
        // pointer, so tagging this would get the pair swept while it is live
        // (BUGS #23). Elements get tagged; the container holding them does not.
        return pair
    }
    var as_list: Int = __rt_as_list_ptr(v)
    if (as_list != 0) {
        return __list_get(as_list, index)
    }
    // Not a List or a Map. A String is the remaining iterable, and __str_get
    // does its own bounds check, but do not fall through to it blindly: a class
    // instance is also a GC pointer, and reading one as a C string prints raw
    // struct bytes and then trips a bogus IndexError. Reject it instead.
    //
    // This is reachable from user code: `for (x in Bag())` over a class that
    // defines its own `length()` gets past codegen, since there is no iterator
    // protocol and `length()` is all the desugaring requires (BUGS #62). A class
    // without `length()` is still the cleaner compile error.
    // The pointer-plausibility guard is the same one __rt_as_list_ptr uses, and
    // it is load-bearing rather than defensive: __rt_untag_ptr only masks off the
    // low 48 bits, so a float's mantissa would come back as a wild address and
    // the `raw - 8` magic read would fault. Only a TAG_PTR value or a bare heap
    // pointer may be dereferenced here.
    var upper: Int = v >> 48
    var raw: Int = 0
    if (upper == 32760) {
        raw = __rt_untag_ptr(v)
    } else if (upper == 0 and v > 65536) {
        raw = v
    }
    if (raw != 0) {
        var magic: Int = load64(raw - 8)
        if (magic == 6557403441622859503 and __rt_gc_type_tag(raw) != 1) {
            // A verified GC object that is neither string (1), list (2) nor map
            // (3) — class instances get per-class tags starting at 10.
            __not_iterable_error()
            return __rt_nil()
        }
    }
    return __str_get(v, index)
}

// `for (x in obj)` where obj is neither a List, a String nor a Map. Fatal, like
// every other runtime error (they route to __runtime_error_fatal and are not
// catchable).
fun __not_iterable_error() {
    // "TypeError: for-in requires a List, String or Map"
    var msg: Int = rt_malloc(49)
    store8(msg, 84)       // T
    store8(msg + 1, 121)  // y
    store8(msg + 2, 112)  // p
    store8(msg + 3, 101)  // e
    store8(msg + 4, 69)   // E
    store8(msg + 5, 114)  // r
    store8(msg + 6, 114)  // r
    store8(msg + 7, 111)  // o
    store8(msg + 8, 114)  // r
    store8(msg + 9, 58)   // :
    store8(msg + 10, 32)  // (space)
    store8(msg + 11, 102) // f
    store8(msg + 12, 111) // o
    store8(msg + 13, 114) // r
    store8(msg + 14, 45)  // -
    store8(msg + 15, 105) // i
    store8(msg + 16, 110) // n
    store8(msg + 17, 32)  // (space)
    store8(msg + 18, 114) // r
    store8(msg + 19, 101) // e
    store8(msg + 20, 113) // q
    store8(msg + 21, 117) // u
    store8(msg + 22, 105) // i
    store8(msg + 23, 114) // r
    store8(msg + 24, 101) // e
    store8(msg + 25, 115) // s
    store8(msg + 26, 32)  // (space)
    store8(msg + 27, 97)  // a
    store8(msg + 28, 32)  // (space)
    store8(msg + 29, 76)  // L
    store8(msg + 30, 105) // i
    store8(msg + 31, 115) // s
    store8(msg + 32, 116) // t
    store8(msg + 33, 44)  // ,
    store8(msg + 34, 32)  // (space)
    store8(msg + 35, 83)  // S
    store8(msg + 36, 116) // t
    store8(msg + 37, 114) // r
    store8(msg + 38, 105) // i
    store8(msg + 39, 110) // n
    store8(msg + 40, 103) // g
    store8(msg + 41, 32)  // (space)
    store8(msg + 42, 111) // o
    store8(msg + 43, 114) // r
    store8(msg + 44, 32)  // (space)
    store8(msg + 45, 77)  // M
    store8(msg + 46, 97)  // a
    store8(msg + 47, 112) // p
    store8(msg + 48, 0)
    __runtime_error_fatal(msg)
}

// Format a map as {key: value, ...}. Keys are always strings; values go
// through __rt_elem_to_string so nested lists and maps render properly.
fun __map_to_string(map: Int): Int {
    if (map == 0) {
        var nil_s: Int = __gc_alloc(3, 1)
        store8(nil_s, 123)     // {
        store8(nil_s + 1, 125) // }
        store8(nil_s + 2, 0)
        return nil_s
    }
    var count: Int = load64(map)
    var keys: Int = load64(map + 16)
    var vals: Int = load64(map + 24)
    var buf_p: Int = rt_malloc(8)
    var len_p: Int = rt_malloc(8)
    var cap_p: Int = rt_malloc(8)
    var init_buf: Int = rt_malloc(64)
    store8(init_buf, 0)
    store64(buf_p, init_buf)
    store64(len_p, 0)
    store64(cap_p, 64)
    var open_b: Int = rt_malloc(2)
    store8(open_b, 123)    // {
    store8(open_b + 1, 0)
    var close_b: Int = rt_malloc(2)
    store8(close_b, 125)   // }
    store8(close_b + 1, 0)
    var sep_b: Int = rt_malloc(3)
    store8(sep_b, 44)      // ,
    store8(sep_b + 1, 32)  // (space)
    store8(sep_b + 2, 0)
    var colon_b: Int = rt_malloc(3)
    store8(colon_b, 58)    // :
    store8(colon_b + 1, 32) // (space)
    store8(colon_b + 2, 0)
    __join_append(buf_p, len_p, cap_p, open_b, 1)
    var i: Int = 0
    while (i < count) {
        if (i > 0) {
            __join_append(buf_p, len_p, cap_p, sep_b, 2)
        }
        // Keys are stored already NaN-boxed. __map_key_box tags only the
        // identity-mode bare-pointer case and passes real NaN-boxed keys
        // through untouched — an unconditional __rt_tag_ptr here stamped
        // TAG_PTR onto numeric keys and printed a garbage string pointer.
        var key: Int = __map_key_box(load64(keys + i * 8))
        var key_str: Int = __rt_elem_to_string(key)
        if (key_str != 0) {
            __join_append(buf_p, len_p, cap_p, key_str, rt_strlen(key_str))
        }
        __join_append(buf_p, len_p, cap_p, colon_b, 2)
        var val: Int = load64(vals + i * 8)
        var val_str: Int = __rt_elem_to_string(val)
        if (val_str != 0) {
            __join_append(buf_p, len_p, cap_p, val_str, rt_strlen(val_str))
        }
        i = i + 1
    }
    __join_append(buf_p, len_p, cap_p, close_b, 1)
    var result: Int = load64(buf_p)
    rt_free(open_b)
    rt_free(close_b)
    rt_free(sep_b)
    rt_free(colon_b)
    rt_free(buf_p)
    rt_free(len_p)
    rt_free(cap_p)
    return result
}

// =============================================================================
// Runtime Error Handling
// =============================================================================
// Error type constants for future typed error values
// IndexError = 1, TypeError = 2, DivisionError = 3, NullError = 4

fun __runtime_error(msg: Int) {
    // Write error message to stderr (fd 2)
    var prefix: Int = rt_malloc(16)
    // "Runtime Error: "
    store8(prefix, 82)       // R
    store8(prefix + 1, 117)  // u
    store8(prefix + 2, 110)  // n
    store8(prefix + 3, 116)  // t
    store8(prefix + 4, 105)  // i
    store8(prefix + 5, 109)  // m
    store8(prefix + 6, 101)  // e
    store8(prefix + 7, 32)   // (space)
    store8(prefix + 8, 69)   // E
    store8(prefix + 9, 114)  // r
    store8(prefix + 10, 114) // r
    store8(prefix + 11, 111) // o
    store8(prefix + 12, 114) // r
    store8(prefix + 13, 58)  // :
    store8(prefix + 14, 32)  // (space)
    store8(prefix + 15, 0)   // null terminator
    var prefix_len: Int = rt_strlen(prefix)
    rt_write(2, prefix, prefix_len)
    var msg_len: Int = rt_strlen(msg)
    rt_write(2, msg, msg_len)
    var newline: Int = rt_malloc(2)
    store8(newline, 10)      // \n
    store8(newline + 1, 0)
    rt_write(2, newline, 1)
    rt_free(prefix)
    rt_free(newline)
}

fun __runtime_error_fatal(msg: Int) {
    __runtime_error(msg)
    __print_debug_location()
    rt_exit(1)
}

fun __index_error(index: Int, count: Int) {
    var sb: Int = StringBuilder()
    // "IndexError: index "
    var p1: Int = rt_malloc(32)
    store8(p1, 73)       // I
    store8(p1 + 1, 110)  // n
    store8(p1 + 2, 100)  // d
    store8(p1 + 3, 101)  // e
    store8(p1 + 4, 120)  // x
    store8(p1 + 5, 69)   // E
    store8(p1 + 6, 114)  // r
    store8(p1 + 7, 114)  // r
    store8(p1 + 8, 111)  // o
    store8(p1 + 9, 114)  // r
    store8(p1 + 10, 58)  // :
    store8(p1 + 11, 32)  // (space)
    store8(p1 + 12, 105) // i
    store8(p1 + 13, 110) // n
    store8(p1 + 14, 100) // d
    store8(p1 + 15, 101) // e
    store8(p1 + 16, 120) // x
    store8(p1 + 17, 32)  // (space)
    store8(p1 + 18, 0)
    __sb_append(sb, p1)
    __sb_append(sb, __int_to_string(index))
    // " out of bounds (length "
    var p2: Int = rt_malloc(32)
    store8(p2, 32)       // (space)
    store8(p2 + 1, 111)  // o
    store8(p2 + 2, 117)  // u
    store8(p2 + 3, 116)  // t
    store8(p2 + 4, 32)   // (space)
    store8(p2 + 5, 111)  // o
    store8(p2 + 6, 102)  // f
    store8(p2 + 7, 32)   // (space)
    store8(p2 + 8, 98)   // b
    store8(p2 + 9, 111)  // o
    store8(p2 + 10, 117) // u
    store8(p2 + 11, 110) // n
    store8(p2 + 12, 100) // d
    store8(p2 + 13, 115) // s
    store8(p2 + 14, 32)  // (space)
    store8(p2 + 15, 40)  // (
    store8(p2 + 16, 108) // l
    store8(p2 + 17, 101) // e
    store8(p2 + 18, 110) // n
    store8(p2 + 19, 103) // g
    store8(p2 + 20, 116) // t
    store8(p2 + 21, 104) // h
    store8(p2 + 22, 32)  // (space)
    store8(p2 + 23, 0)
    __sb_append(sb, p2)
    __sb_append(sb, __int_to_string(count))
    // ")"
    var p3: Int = rt_malloc(2)
    store8(p3, 41)       // )
    store8(p3 + 1, 0)
    __sb_append(sb, p3)
    __runtime_error_fatal(__sb_to_string(sb))
}

fun __division_error() {
    // "DivisionError: division by zero"
    var msg: Int = rt_malloc(32)
    store8(msg, 68)       // D
    store8(msg + 1, 105)  // i
    store8(msg + 2, 118)  // v
    store8(msg + 3, 105)  // i
    store8(msg + 4, 115)  // s
    store8(msg + 5, 105)  // i
    store8(msg + 6, 111)  // o
    store8(msg + 7, 110)  // n
    store8(msg + 8, 69)   // E
    store8(msg + 9, 114)  // r
    store8(msg + 10, 114) // r
    store8(msg + 11, 111) // o
    store8(msg + 12, 114) // r
    store8(msg + 13, 58)  // :
    store8(msg + 14, 32)  // (space)
    store8(msg + 15, 100) // d
    store8(msg + 16, 105) // i
    store8(msg + 17, 118) // v
    store8(msg + 18, 105) // i
    store8(msg + 19, 115) // s
    store8(msg + 20, 105) // i
    store8(msg + 21, 111) // o
    store8(msg + 22, 110) // n
    store8(msg + 23, 32)  // (space)
    store8(msg + 24, 98)  // b
    store8(msg + 25, 121) // y
    store8(msg + 26, 32)  // (space)
    store8(msg + 27, 122) // z
    store8(msg + 28, 101) // e
    store8(msg + 29, 114) // r
    store8(msg + 30, 111) // o
    store8(msg + 31, 0)
    __runtime_error_fatal(msg)
}

fun __null_pointer_error() {
    // "NullError: null pointer dereference"
    var msg: Int = rt_malloc(36)
    store8(msg, 78)       // N
    store8(msg + 1, 117)  // u
    store8(msg + 2, 108)  // l
    store8(msg + 3, 108)  // l
    store8(msg + 4, 69)   // E
    store8(msg + 5, 114)  // r
    store8(msg + 6, 114)  // r
    store8(msg + 7, 111)  // o
    store8(msg + 8, 114)  // r
    store8(msg + 9, 58)   // :
    store8(msg + 10, 32)  // (space)
    store8(msg + 11, 110) // n
    store8(msg + 12, 117) // u
    store8(msg + 13, 108) // l
    store8(msg + 14, 108) // l
    store8(msg + 15, 32)  // (space)
    store8(msg + 16, 112) // p
    store8(msg + 17, 111) // o
    store8(msg + 18, 105) // i
    store8(msg + 19, 110) // n
    store8(msg + 20, 116) // t
    store8(msg + 21, 101) // e
    store8(msg + 22, 114) // r
    store8(msg + 23, 32)  // (space)
    store8(msg + 24, 100) // d
    store8(msg + 25, 101) // e
    store8(msg + 26, 114) // r
    store8(msg + 27, 101) // e
    store8(msg + 28, 102) // f
    store8(msg + 29, 101) // e
    store8(msg + 30, 114) // r
    store8(msg + 31, 101) // e
    store8(msg + 32, 110) // n
    store8(msg + 33, 99)  // c
    store8(msg + 34, 101) // e
    store8(msg + 35, 0)
    __runtime_error_fatal(msg)
}

fun __str_ends_with(str: Int, suffix: Int): Int {
    var rs: Int = __rt_untag_ptr(str)
    var rx: Int = __rt_untag_ptr(suffix)
    if (rs == 0 or rx == 0) { return 0 }
    var slen: Int = rt_strlen(rs)
    var plen: Int = rt_strlen(rx)
    if (plen > slen) { return 0 }
    var offset: Int = slen - plen
    var cmp: Int = rt_strcmp(rs + offset, rx)
    if (cmp == 0) { return 1 }
    return 0
}

fun __str_split(input: Int, delim: Int): Int {
    // Allocate list struct and data in old gen (no GC triggered).
    // This prevents nursery collection from invalidating local pointers.
    var list: Int = __gc_alloc_safe(24, 2)
    store64(list, 0)
    store64(list + 8, 64)
    store64(list + 16, __gc_alloc_safe(64 * 8, 7))
    var ri: Int = __rt_untag_ptr(input)
    var rd: Int = __rt_untag_ptr(delim)
    if (ri == 0 or rd == 0) { return list }
    var slen: Int = rt_strlen(ri)
    var buf: Int = rt_malloc(slen + 1)
    rt_strcpy(buf, ri)
    var dlen: Int = rt_strlen(rd)
    var pos: Int = buf
    while (rt_strlen(pos) > 0) {
        var m: Int = rt_strstr(pos, rd)
        if (m == 0) {
            var lb: Int = __gc_alloc_safe(rt_strlen(pos) + 1, 1)
            rt_strcpy(lb, pos)
            __split_push(list, __rt_tag_ptr(lb))
            rt_free(buf)
            return list
        }
        store8(m, 0)
        var tb: Int = __gc_alloc_safe(rt_strlen(pos) + 1, 1)
        rt_strcpy(tb, pos)
        __split_push(list, __rt_tag_ptr(tb))
        pos = m + dlen
    }
    rt_free(buf)
    return list
}

fun __join_append(buf_p: Int, len_p: Int, cap_p: Int, src: Int, src_len: Int) {
    var len: Int = load64(len_p)
    var cap: Int = load64(cap_p)
    var buf: Int = load64(buf_p)
    var needed: Int = len + src_len + 1
    if (needed >= cap) {
        var new_cap: Int = needed * 2
        var new_buf: Int = rt_realloc(buf, new_cap)
        if (new_buf != 0) {
            store64(cap_p, new_cap)
            store64(buf_p, new_buf)
        }
    }
    var cur_buf: Int = load64(buf_p)
    rt_memcpy(cur_buf + len, src, src_len)
    var new_len: Int = len + src_len
    store64(len_p, new_len)
    store8(cur_buf + new_len, 0)
}

fun __str_replace(str: Int, old: Int, replacement: Int): Int {
    var rs: Int = __rt_untag_ptr(str)
    var ro: Int = __rt_untag_ptr(old)
    var rr: Int = __rt_untag_ptr(replacement)
    if (rs == 0) {
        var empty: Int = __gc_alloc(1, 1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    if (ro == 0 or rr == 0) { return __rt_tag_ptr(rt_strdup(rs)) }
    var slen: Int = rt_strlen(rs)
    var olen: Int = rt_strlen(ro)
    var nlen: Int = rt_strlen(rr)
    var init_cap: Int = (slen + 1) * 2
    var buf_p: Int = rt_malloc(8)
    var len_p: Int = rt_malloc(8)
    var cap_p: Int = rt_malloc(8)
    var init_buf: Int = rt_malloc(init_cap)
    store8(init_buf, 0)
    store64(buf_p, init_buf)
    store64(len_p, 0)
    store64(cap_p, init_cap)
    var src: Int = rs
    while (rt_strlen(src) > 0) {
        var found: Int = rt_strstr(src, ro)
        if (found == 0) {
            __join_append(buf_p, len_p, cap_p, src, rt_strlen(src))
            return __rt_tag_ptr(load64(buf_p))
        }
        var plen: Int = found - src
        __join_append(buf_p, len_p, cap_p, src, plen)
        __join_append(buf_p, len_p, cap_p, rr, nlen)
        src = found + olen
    }
    return __rt_tag_ptr(load64(buf_p))
}

fun __list_join(list: Int, sep: Int): Int {
    if (list == 0) {
        var empty: Int = __gc_alloc(1, 1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    var rs: Int = __rt_untag_ptr(sep)
    var count: Int = load64(list)
    var data: Int = load64(list + 16)
    var sep_len: Int = 0
    if (rs != 0) {
        sep_len = rt_strlen(rs)
    }
    var buf_p: Int = rt_malloc(8)
    var len_p: Int = rt_malloc(8)
    var cap_p: Int = rt_malloc(8)
    var init_buf: Int = rt_malloc(1024)
    store8(init_buf, 0)
    store64(buf_p, init_buf)
    store64(len_p, 0)
    store64(cap_p, 1024)
    var i: Int = 0
    while (i < count) {
        if (i > 0) {
            __join_append(buf_p, len_p, cap_p, rs, sep_len)
        }
        var elem: Int = load64(data + i * 8)
        // This used to be a bare __rt_untag_ptr + rt_strlen, which is only
        // valid when the element really is a string pointer. For
        // `[1, 2, 3].join(", ")` it untagged a boxed *number* and walked
        // whatever address the mantissa happened to name — a segfault.
        //
        // Dispatch on the NaN-box tag instead. Only non-pointer tags are
        // rerouted through __rt_elem_to_string; anything pointer-shaped keeps
        // the original path verbatim. That distinction matters: interned and
        // static string constants (which the compiler's own IR emission is
        // built out of) carry no GC header, so __rt_as_string_ptr rejects them
        // and __any_to_string would render the pointer as an integer —
        // producing IR like `call @__list_push(105553139554416, ...)`.
        var upper: Int = elem >> 48
        if (upper == 32760 or upper == 0) {
            var re: Int = __rt_untag_ptr(elem)
            if (re != 0) {
                __join_append(buf_p, len_p, cap_p, re, rt_strlen(re))
            }
        } else {
            var elem_str: Int = __rt_elem_to_string(elem)
            if (elem_str != 0) {
                __join_append(buf_p, len_p, cap_p, elem_str, rt_strlen(elem_str))
            }
        }
        i = i + 1
    }
    return __rt_tag_ptr(load64(buf_p))
}

fun __list_contains(list: Int, val: Int): Int {
    if (list == 0) { return 0 }
    var rv: Int = __rt_untag_ptr(val)
    var count: Int = load64(list)
    var data: Int = load64(list + 16)
    var i: Int = 0
    while (i < count) {
        var elem: Int = load64(data + i * 8)
        var re: Int = __rt_untag_ptr(elem)
        if (rv == 0 and re == 0) { return 1 }
        if (rv == 0 or re == 0) { i = i + 1; continue }
        if (rt_strcmp(rv, re) == 0) {
            return 1
        }
        i = i + 1
    }
    return 0
}

/// s[i] — one-character String at byte offset i.
///
/// Indexing a String used to fall through to the list path, which read a
/// character as if it were a list header and segfaulted (BUGS #29). Because the
/// `for-in` desugaring is index-based, that also made `for (c in "ab")`
/// impossible.
///
/// Bounds and negative indices behave exactly as `__list_get`: `s[-1]` is the
/// last character, and out of range raises a fatal IndexError rather than
/// reading past the terminator — `char_at` does neither, which is why `s[5]` on
/// a 2-char string must not silently mirror it.
fun __str_get(str: Int, index: Int): Int {
    var rs: Int = __rt_untag_ptr(str)
    if (rs == 0) { __null_pointer_error() }
    var count: Int = rt_strlen(rs)
    var actual_idx: Int = index
    if (actual_idx < 0) {
        actual_idx = count + actual_idx
    }
    if (actual_idx < 0 or actual_idx >= count) {
        __index_error(actual_idx, count)
        return 0
    }
    // rt_malloc, not __gc_alloc: per BUGS #23, __gc_is_heap_ptr rejects a
    // NaN-tagged value, so tagging GC-allocated memory makes the collector
    // sweep it while live. __list_join is safe for the same reason. The
    // 2-byte buffer therefore leaks, exactly as `char_at` already does.
    var buf: Int = rt_malloc(2)
    store8(buf, load8(rs + actual_idx))
    store8(buf + 1, 0)
    return __rt_tag_ptr(buf)
}

// =============================================================================
// I/O
// =============================================================================

fun __io_read_file(path: Int): Int {
    var rp: Int = __rt_untag_ptr(path)
    if (rp == 0) {
        var empty: Int = rt_malloc(1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    var mode: Int = rt_malloc(2)
    store8(mode, 114)
    store8(mode + 1, 0)
    var fp: Int = rt_fopen(rp, mode)
    rt_free(mode)
    if (fp == 0) {
        var empty: Int = rt_malloc(1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    rt_fseek(fp, 0, 2)
    var size: Int = rt_ftell(fp)
    rt_fseek(fp, 0, 0)
    var buf: Int = rt_malloc(size + 1)
    rt_fread(buf, 1, size, fp)
    store8(buf + size, 0)
    rt_fclose(fp)
    return __rt_tag_ptr(buf)
}

fun __io_file_size(path: Int): Int {
    var rp: Int = __rt_untag_ptr(path)
    if (rp == 0) { return 0 }
    var mode: Int = rt_malloc(3)
    store8(mode, 114)
    store8(mode + 1, 98)
    store8(mode + 2, 0)
    var fp: Int = rt_fopen(rp, mode)
    rt_free(mode)
    if (fp == 0) { return 0 }
    rt_fseek(fp, 0, 2)
    var size: Int = rt_ftell(fp)
    rt_fclose(fp)
    return size
}

fun __io_read_binary(path: Int, buf: Int, max_size: Int): Int {
    var rp: Int = __rt_untag_ptr(path)
    var rb: Int = __rt_untag_ptr(buf)
    if (rp == 0) { return 0 }
    if (rb == 0) { return 0 }
    var mode: Int = rt_malloc(3)
    store8(mode, 114)
    store8(mode + 1, 98)
    store8(mode + 2, 0)
    var fp: Int = rt_fopen(rp, mode)
    rt_free(mode)
    if (fp == 0) { return 0 }
    var n: Int = rt_fread(rb, 1, max_size, fp)
    rt_fclose(fp)
    return n
}

fun __io_write_file(path: Int, content: Int) {
    var rp: Int = __rt_untag_ptr(path)
    var rc: Int = __rt_untag_ptr(content)
    if (rp == 0) { return }
    var mode: Int = rt_malloc(2)
    store8(mode, 119)
    store8(mode + 1, 0)
    var fp: Int = rt_fopen(rp, mode)
    rt_free(mode)
    if (fp == 0) { return }
    if (rc == 0) {
        rt_fclose(fp)
        return
    }
    var len: Int = rt_strlen(rc)
    rt_fwrite(rc, 1, len, fp)
    rt_fclose(fp)
}

fun __io_file_exists(path: Int): Int {
    var rp: Int = __rt_untag_ptr(path)
    if (rp == 0) { return 0 }
    var rc: Int = rt_access(rp, 0)
    if (rc == 0) { return 1 }
    return 0
}

fun __io_mkdir(path: Int) {
    var rp: Int = __rt_untag_ptr(path)
    if (rp == 0) { return }
    rt_mkdir(rp, 493)
}

fun __io_append_file(path: Int, content: Int) {
    var rp: Int = __rt_untag_ptr(path)
    var rc: Int = __rt_untag_ptr(content)
    if (rp == 0) { return }
    var mode: Int = rt_malloc(2)
    store8(mode, 97)
    store8(mode + 1, 0)
    var fp: Int = rt_fopen(rp, mode)
    rt_free(mode)
    if (fp == 0) { return }
    if (rc == 0) {
        rt_fclose(fp)
        return
    }
    var len: Int = rt_strlen(rc)
    rt_fwrite(rc, 1, len, fp)
    rt_fclose(fp)
}

fun __io_walk_dir(path: Int): Int {
    var list: Int = __list_new()
    var rp: Int = __rt_untag_ptr(path)
    if (rp == 0) { return list }
    var path_len: Int = rt_strlen(rp)
    var cmd: Int = rt_malloc(path_len + 16)
    store8(cmd, 108)
    store8(cmd + 1, 115)
    store8(cmd + 2, 32)
    store8(cmd + 3, 45)
    store8(cmd + 4, 49)
    store8(cmd + 5, 32)
    store8(cmd + 6, 0)
    rt_strcat(cmd, rp)
    var mode: Int = rt_malloc(2)
    store8(mode, 114)
    store8(mode + 1, 0)
    var fp: Int = rt_popen(cmd, mode)
    rt_free(mode)
    rt_free(cmd)
    if (fp == 0) { return list }
    var buf: Int = rt_malloc(4096)
    var line: Int = rt_fgets(buf, 4096, fp)
    while (line != 0) {
        var len: Int = rt_strlen(buf)
        if (len > 0) {
            if (load8(buf + len - 1) == 10) {
                store8(buf + len - 1, 0)
                len = len - 1
            }
        }
        if (len > 0) {
            // Tag the entry, not the list. Each element is a string handed into
            // NaN-boxed value space, so it needs TAG_PTR — `__os_args` and
            // `__str_split` both do this and were the precedent; this function
            // was the outlier, so `IO.list_dir(d)[0]` read back as a subnormal
            // double. The list itself must stay untagged: `__gc_is_heap_ptr`
            // (gc.ll:615) refuses to trace a NaN-tagged pointer, so tagging the
            // container gets it swept while live (BUGS #23's caveat) — that was
            // tried here first and segfaulted.
            var entry: Int = __rt_tag_ptr(rt_strdup(buf))
            __list_push(list, entry)
        }
        line = rt_fgets(buf, 4096, fp)
    }
    rt_free(buf)
    rt_pclose(fp)
    return list
}

fun __io_read_stdin(n: Int): Int {
    var rn: Int = __rt_untag_int(n)
    if (rn <= 0) {
        var empty: Int = rt_malloc(1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    var buf: Int = rt_malloc(rn + 1)
    var total: Int = 0
    while (total < rn) {
        var got: Int = rt_read(0, buf + total, rn - total)
        if (got <= 0) { break }
        total = total + got
    }
    store8(buf + total, 0)
    return __rt_tag_ptr(buf)
}

fun __io_readline(): Int {
    var buf: Int = rt_malloc(4096)
    var len: Int = 0
    while (len < 4095) {
        var got: Int = rt_read(0, buf + len, 1)
        if (got <= 0) { break }
        var ch: Int = load8(buf + len)
        if (ch == 10) { break }
        len = len + 1
    }
    store8(buf + len, 0)
    return __rt_tag_ptr(buf)
}

fun __io_is_dir(path: Int): Int {
    var rp: Int = __rt_untag_ptr(path)
    if (rp == 0) { return 0 }
    var dp: Int = rt_opendir(rp)
    if (dp == 0) { return 0 }
    rt_closedir(dp)
    return 1
}

fun __io_rename(from: Int, to: Int): Int {
    var rf: Int = __rt_untag_ptr(from)
    var rt2: Int = __rt_untag_ptr(to)
    if (rf == 0) { return 0 }
    if (rt2 == 0) { return 0 }
    var rc: Int = rt_rename(rf, rt2)
    if (rc == 0) { return 1 }
    return 0
}

fun __io_delete_file(path: Int): Int {
    var rp: Int = __rt_untag_ptr(path)
    if (rp == 0) { return 0 }
    var rc: Int = rt_remove(rp)
    if (rc == 0) { return 1 }
    return 0
}

// =============================================================================
// OS
// =============================================================================

fun __os_set_env(name: Int, value: Int): Int {
    var rn: Int = __rt_untag_ptr(name)
    var rv: Int = __rt_untag_ptr(value)
    if (rn == 0) { return 0 }
    if (rv == 0) { return 0 }
    // overwrite=1: OS.set_env is documented as a set, not a set-if-absent.
    var rc: Int = rt_setenv(rn, rv, 1)
    if (rc == 0) { return 1 }
    return 0
}

fun __os_home(): Int {
    var name: Int = rt_malloc(5)
    store8(name, 72)      // H
    store8(name + 1, 79)  // O
    store8(name + 2, 77)  // M
    store8(name + 3, 69)  // E
    store8(name + 4, 0)
    var val: Int = rt_getenv(name)
    rt_free(name)
    if (val == 0) {
        var empty: Int = rt_malloc(1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    return __rt_tag_ptr(rt_strdup(val))
}

fun __os_cwd(): Int {
    var buf: Int = rt_malloc(4096)
    var result: Int = rt_getcwd(buf, 4096)
    if (result == 0) {
        store8(buf, 0)
    }
    return __rt_tag_ptr(buf)
}

fun __os_path_sep(): Int {
    var s: Int = rt_malloc(2)
    store8(s, 47)
    store8(s + 1, 0)
    return __rt_tag_ptr(s)
}

// "darwin", not "macos". Everything that consumes this expects the uname
// spelling: docs/src/stdlib/os.md documents it as "darwin", src/lib/tar.sf's
// `is_macos()` compares against "darwin" (so it was dead code, always false),
// and both stdlib_os tests assert it. "macos" matched nothing.
//
// Still hardcoded, so still wrong on Linux — this fixes the spelling, not the
// detection. Real detection needs `uname(2)`, whose `struct utsname` has no
// layout Saffron can hand-offset into portably (the same reason `__io_is_dir`
// probes with `opendir` instead of `stat`); it wants a C helper alongside
// socket_native.c, which is its own change.
fun __os_platform(): Int {
    var s: Int = rt_malloc(7)
    store8(s, 100)      // d
    store8(s + 1, 97)   // a
    store8(s + 2, 114)  // r
    store8(s + 3, 119)  // w
    store8(s + 4, 105)  // i
    store8(s + 5, 110)  // n
    store8(s + 6, 0)
    return __rt_tag_ptr(s)
}

fun __os_env(name: Int): Int {
    var rn: Int = __rt_untag_ptr(name)
    var val: Int = rt_getenv(rn)
    if (val == 0) {
        var empty: Int = rt_malloc(1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    return __rt_tag_ptr(rt_strdup(val))
}

@extern("i32 system(i8*)") fun __rt_system(cmd: Int): Int

/// Run a command with stdout/stderr inherited, returning its exit code.
/// C `system()` yields a packed `wait()` status (a child exiting 1 comes back
/// as 256), so decode it here: callers expect a shell-style exit code. A child
/// killed by a signal has no exit status, so report 128 + signal as shells do.
fun __os_system(cmd: Int): Int {
    var rc: Int = __rt_untag_ptr(cmd)
    if (rc == 0) { return -1 }
    var status: Int = __rt_system(rc)
    if (status < 0) { return status }
    var signal: Int = status % 128
    if (signal != 0) { return 128 + signal }
    return status / 256
}

fun __os_exec(cmd: Int): Int {
    var rc: Int = __rt_untag_ptr(cmd)
    if (rc == 0) {
        var empty: Int = rt_malloc(1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    var mode: Int = rt_malloc(2)
    store8(mode, 114)
    store8(mode + 1, 0)
    var fp: Int = rt_popen(rc, mode)
    rt_free(mode)
    if (fp == 0) {
        var empty: Int = rt_malloc(1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    var buf_p: Int = rt_malloc(8)
    var len_p: Int = rt_malloc(8)
    var cap_p: Int = rt_malloc(8)
    var init_buf: Int = rt_malloc(4096)
    store8(init_buf, 0)
    store64(buf_p, init_buf)
    store64(len_p, 0)
    store64(cap_p, 4096)
    var tmp: Int = rt_malloc(4096)
    var line: Int = rt_fgets(tmp, 4096, fp)
    while (line != 0) {
        var chunk_len: Int = rt_strlen(tmp)
        __join_append(buf_p, len_p, cap_p, tmp, chunk_len)
        line = rt_fgets(tmp, 4096, fp)
    }
    rt_free(tmp)
    rt_pclose(fp)
    return __rt_tag_ptr(load64(buf_p))
}

@intrinsic fun load_argc(): Int
@intrinsic fun load_argv(): Int

fun __os_args(): Int {
    var argc: Int = load_argc()
    var argv: Int = load_argv()
    var list: Int = __list_new()
    var i: Int = 0
    while (i < argc) {
        var raw_ptr: Int = load64(argv + i * 8)
        var arg: Int = __rt_tag_ptr(raw_ptr)
        __list_push(list, arg)
        i = i + 1
    }
    return list
}

fun __os_file_exists(path: Int): Int {
    return __io_file_exists(path)
}

fun __os_mkdir(path: Int): Int {
    __io_mkdir(path)
    return 0
}

fun __os_list_dir(path: Int): Int {
    return __io_walk_dir(path)
}

// Aliases for prefix convention (IO.list_dir -> __io_list_dir, etc.)
fun __io_list_dir(path: Int): Int {
    return __io_walk_dir(path)
}

fun __io_readln(): Int {
    return __io_readline()
}

fun __io_read_line(): Int {
    return __io_readline()
}

// =============================================================================
// Runtime String Methods
// =============================================================================

fun rt_str_trim(s: Int): Int {
    var rs: Int = __rt_untag_ptr(s)
    if (rs == 0) {
        var empty: Int = __gc_alloc(1, 1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    var len: Int = rt_strlen(rs)
    var start: Int = 0
    var end: Int = len
    while (start < end) {
        var ch: Int = load8(rs + start)
        if (ch == 32 or ch == 9 or ch == 10 or ch == 13) {
            start = start + 1
        } else {
            break
        }
    }
    while (end > start) {
        var ch: Int = load8(rs + end - 1)
        if (ch == 32 or ch == 9 or ch == 10 or ch == 13) {
            end = end - 1
        } else {
            break
        }
    }
    var new_len: Int = end - start
    var buf: Int = __gc_alloc(new_len + 1, 1)
    rt_memcpy(buf, rs + start, new_len)
    store8(buf + new_len, 0)
    return __rt_tag_ptr(buf)
}

fun rt_str_index_of(s: Int, needle: Int): Int {
    var rs: Int = __rt_untag_ptr(s)
    var rn: Int = __rt_untag_ptr(needle)
    if (rs == 0 or rn == 0) { return 0 - 1 }
    var found: Int = rt_strstr(rs, rn)
    if (found == 0) { return 0 - 1 }
    return found - rs
}

fun rt_str_repeat(s: Int, count: Int): Int {
    var rs: Int = __rt_untag_ptr(s)
    var rc: Int = __rt_untag_int(count)
    if (rs == 0 or rc <= 0) {
        var empty: Int = __gc_alloc(1, 1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    var len: Int = rt_strlen(rs)
    var total: Int = len * rc
    var buf: Int = __gc_alloc(total + 1, 1)
    store8(buf, 0)
    var i: Int = 0
    while (i < rc) {
        rt_strcat(buf, rs)
        i = i + 1
    }
    return __rt_tag_ptr(buf)
}

fun rt_str_to_upper(s: Int): Int {
    var rs: Int = __rt_untag_ptr(s)
    if (rs == 0) {
        var empty: Int = __gc_alloc(1, 1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    var len: Int = rt_strlen(rs)
    var buf: Int = __gc_alloc(len + 1, 1)
    var i: Int = 0
    while (i < len) {
        var ch: Int = load8(rs + i)
        if (ch >= 97 and ch <= 122) {
            store8(buf + i, ch - 32)
        } else {
            store8(buf + i, ch)
        }
        i = i + 1
    }
    store8(buf + len, 0)
    return __rt_tag_ptr(buf)
}

fun rt_str_to_lower(s: Int): Int {
    var rs: Int = __rt_untag_ptr(s)
    if (rs == 0) {
        var empty: Int = __gc_alloc(1, 1)
        store8(empty, 0)
        return __rt_tag_ptr(empty)
    }
    var len: Int = rt_strlen(rs)
    var buf: Int = __gc_alloc(len + 1, 1)
    var i: Int = 0
    while (i < len) {
        var ch: Int = load8(rs + i)
        if (ch >= 65 and ch <= 90) {
            store8(buf + i, ch + 32)
        } else {
            store8(buf + i, ch)
        }
        i = i + 1
    }
    store8(buf + len, 0)
    return __rt_tag_ptr(buf)
}

// =============================================================================
// Runtime List Methods
// =============================================================================

fun rt_list_reverse(list: Int): Int {
    if (list == 0) { return __list_new() }
    var len: Int = __list_length(list)
    var new_list: Int = __list_new()
    var i: Int = len - 1
    while (i >= 0) {
        __list_push(new_list, __list_get(list, i))
        i = i - 1
    }
    return new_list
}

fun rt_list_copy(list: Int): Int {
    if (list == 0) { return __list_new() }
    var len: Int = __list_length(list)
    var new_list: Int = __list_new()
    var i: Int = 0
    while (i < len) {
        __list_push(new_list, __list_get(list, i))
        i = i + 1
    }
    return new_list
}

// Bubble sort, ordering elements with __val_cmp.
//
// The comparison used to be `if (a > b)` on two `Int`-declared locals that
// actually hold NaN-boxed values, so for TAG_PTR elements it was comparing
// pointer bit patterns. `>` between two large positive pointers is essentially
// never true in the direction the sort needs, so this returned string lists
// completely untouched, at every optimization level, with no error — making the
// idiomatic `var ks = m.keys(); ks.sort()` a silent no-op (BUGS #104).
//
// __val_cmp dispatches on the tag, so one call orders strings by content and
// numbers numerically, and this is the same helper `<` itself now compiles to —
// `.sort()` and `<` cannot disagree about order.
fun rt_list_sort(list: Int): Int {
    if (list == 0) { return __list_new() }
    var len: Int = __list_length(list)
    var outer: Int = 0
    while (outer < len - 1) {
        var inner: Int = 0
        while (inner < len - 1 - outer) {
            var a: Int = __list_get(list, inner)
            var b: Int = __list_get(list, inner + 1)
            if (__val_cmp(a, b) > 0) {
                __list_set(list, inner, b)
                __list_set(list, inner + 1, a)
            }
            inner = inner + 1
        }
        outer = outer + 1
    }
    return list
}
