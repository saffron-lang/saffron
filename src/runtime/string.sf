// Saffron Core Runtime: String methods
// Compiled to .ll and linked with every native program.
// Method calls like s.trim() desugar to rt_str_trim(s).

fun rt_str_trim(s: String): String {
    var start: Int = 0
    var end: Int = s.length()
    while (start < end) {
        var ch = s.char_at(start)
        if (ch == " " or ch == "\t" or ch == "\n") {
            start = start + 1
        } else {
            break
        }
    }
    while (end > start) {
        var ch = s.char_at(end - 1)
        if (ch == " " or ch == "\t" or ch == "\n") {
            end = end - 1
        } else {
            break
        }
    }
    return s.slice(start, end)
}

fun rt_str_to_upper(s: String): String {
    var lower: String = "abcdefghijklmnopqrstuvwxyz"
    var upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var result = ""
    var i: Int = 0
    while (i < s.length()) {
        var ch = s.char_at(i)
        var pos: Int = rt_str_index_of(lower, ch)
        if (pos >= 0) {
            result = result + upper.char_at(pos)
        } else {
            result = result + ch
        }
        i = i + 1
    }
    return result
}

fun rt_str_to_lower(s: String): String {
    var upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var lower: String = "abcdefghijklmnopqrstuvwxyz"
    var result = ""
    var i: Int = 0
    while (i < s.length()) {
        var ch = s.char_at(i)
        var pos: Int = rt_str_index_of(upper, ch)
        if (pos >= 0) {
            result = result + lower.char_at(pos)
        } else {
            result = result + ch
        }
        i = i + 1
    }
    return result
}

fun rt_str_index_of(s: String, needle: String): Int {
    var slen: Int = s.length()
    var nlen: Int = needle.length()
    if (nlen > slen) { return -1 }
    var i: Int = 0
    var limit: Int = slen - nlen
    while (i <= limit) {
        if (s.slice(i, i + nlen) == needle) {
            return i
        }
        i = i + 1
    }
    return -1
}

fun rt_str_repeat(s: String, count: Int): String {
    var result = ""
    var i: Int = 0
    while (i < count) {
        result = result + s
        i = i + 1
    }
    return result
}

fun rt_str_ends_with(s: String, suffix: String): Int {
    var slen: Int = s.length()
    var plen: Int = suffix.length()
    if (plen > slen) { return 0 }
    var tail: String = s.slice(slen - plen, slen)
    if (tail == suffix) { return 1 }
    return 0
}
