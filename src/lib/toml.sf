//! TOML parser and serializer — pure Saffron implementation.
//!
//! Parses TOML configuration files into nested Maps and Lists.
//! Supports key-value pairs, tables, dotted keys, strings, integers,
//! floats, booleans, arrays, inline tables, array of tables, and comments.

/// Parse a TOML string into a nested Map.
///
/// ```saffron
/// import "@toml" as TOML
/// var config = TOML.parse("[package]\nname = \"saffron\"\nversion = \"0.1.0\"")
/// config.get("package").get("name")  // "saffron"
/// ```
fun parse(source: String): Map<String, Any> {
    var pos = 0
    var root = Map()

    fun peek(): String {
        if (pos >= source.length()) { return "" }
        return source.char_at(pos)
    }

    fun peek_at(offset: Number): String {
        var idx = pos + offset
        if (idx >= source.length()) { return "" }
        return source.char_at(idx)
    }

    fun advance(): String {
        var c = source.char_at(pos)
        pos = pos + 1
        return c
    }

    fun is_at_end(): Bool {
        return pos >= source.length()
    }

    fun is_digit(c: String): Bool {
        return c == "0" or c == "1" or c == "2" or c == "3" or c == "4" or
               c == "5" or c == "6" or c == "7" or c == "8" or c == "9"
    }

    fun is_bare_key_char(c: String): Bool {
        return c == "a" or c == "b" or c == "c" or c == "d" or c == "e" or
               c == "f" or c == "g" or c == "h" or c == "i" or c == "j" or
               c == "k" or c == "l" or c == "m" or c == "n" or c == "o" or
               c == "p" or c == "q" or c == "r" or c == "s" or c == "t" or
               c == "u" or c == "v" or c == "w" or c == "x" or c == "y" or
               c == "z" or c == "A" or c == "B" or c == "C" or c == "D" or
               c == "E" or c == "F" or c == "G" or c == "H" or c == "I" or
               c == "J" or c == "K" or c == "L" or c == "M" or c == "N" or
               c == "O" or c == "P" or c == "Q" or c == "R" or c == "S" or
               c == "T" or c == "U" or c == "V" or c == "W" or c == "X" or
               c == "Y" or c == "Z" or is_digit(c) or c == "-" or c == "_"
    }

    fun is_whitespace(c: String): Bool {
        return c == " " or c == "\t"
    }

    fun is_newline(c: String): Bool {
        return c == "\n" or c == "\r"
    }

    // Skip whitespace (spaces and tabs only, not newlines)
    fun skip_ws() {
        while (pos < source.length()) {
            var c = peek()
            if (is_whitespace(c)) {
                pos = pos + 1
            } else {
                return nil
            }
        }
    }

    // Skip whitespace and newlines, including comments
    fun skip_ws_and_newlines() {
        while (pos < source.length()) {
            var c = peek()
            if (is_whitespace(c) or is_newline(c)) {
                pos = pos + 1
            } else if (c == "#") {
                while (pos < source.length() and !is_newline(peek())) {
                    pos = pos + 1
                }
            } else {
                return nil
            }
        }
    }

    // Skip the rest of the line (comment or whitespace)
    fun skip_comment() {
        skip_ws()
        if (peek() == "#") {
            while (pos < source.length() and !is_newline(peek())) {
                pos = pos + 1
            }
        }
    }

    // Skip to end of line (whitespace + optional comment + newline)
    fun skip_to_newline() {
        skip_comment()
        if (pos < source.length()) {
            var c = peek()
            if (c == "\n") {
                pos = pos + 1
            } else if (c == "\r") {
                pos = pos + 1
                if (peek() == "\n") { pos = pos + 1 }
            } else if (!is_at_end()) {
                throw "TOML: expected newline at position ${pos}, got '${peek()}'"
            }
        }
    }

    // Parse a bare key (alphanumeric, dash, underscore)
    fun parse_bare_key(): String {
        var sb = StringBuilder()
        while (pos < source.length() and is_bare_key_char(peek())) {
            sb.append(advance())
        }
        var key = sb.to_string()
        if (key.length() == 0) {
            throw "TOML: expected key at position ${pos}"
        }
        return key
    }

    // Parse a basic string (double-quoted, with escape sequences)
    fun parse_basic_string(): String {
        var sb = StringBuilder()
        while (pos < source.length()) {
            var c = advance()
            if (c == "\"") { return sb.to_string() }
            if (c == "\\") {
                var esc = advance()
                if (esc == "n") { sb.append("\n") }
                else if (esc == "t") { sb.append("\t") }
                else if (esc == "r") { sb.append("\r") }
                else if (esc == "\\") { sb.append("\\") }
                else if (esc == "\"") { sb.append("\"") }
                else if (esc == "b") { sb.append("\b") }
                else if (esc == "f") { sb.append("\f") }
                else {
                    throw "TOML: unknown escape sequence '\\${esc}' at position ${pos}"
                }
            } else {
                sb.append(c)
            }
        }
        throw "TOML: unterminated basic string"
    }

    // Parse a multi-line basic string (triple double-quoted)
    fun parse_multiline_basic_string(): String {
        if (peek() == "\n") { pos = pos + 1 }
        else if (peek() == "\r") {
            pos = pos + 1
            if (peek() == "\n") { pos = pos + 1 }
        }
        var sb = StringBuilder()
        while (pos < source.length()) {
            var c = peek()
            if (c == "\"" and peek_at(1) == "\"" and peek_at(2) == "\"") {
                pos = pos + 3
                return sb.to_string()
            }
            var ch = advance()
            if (ch == "\\") {
                var esc = peek()
                if (esc == "\n" or esc == "\r" or esc == " " or esc == "\t") {
                    while (pos < source.length() and (is_whitespace(peek()) or is_newline(peek()))) {
                        pos = pos + 1
                    }
                } else {
                    var e = advance()
                    if (e == "n") { sb.append("\n") }
                    else if (e == "t") { sb.append("\t") }
                    else if (e == "r") { sb.append("\r") }
                    else if (e == "\\") { sb.append("\\") }
                    else if (e == "\"") { sb.append("\"") }
                    else {
                        throw "TOML: unknown escape in multi-line string '\\${e}'"
                    }
                }
            } else {
                sb.append(ch)
            }
        }
        throw "TOML: unterminated multi-line basic string"
    }

    // Parse a literal string (single-quoted, no escapes)
    fun parse_literal_string(): String {
        var sb = StringBuilder()
        while (pos < source.length()) {
            var c = advance()
            if (c == "'") { return sb.to_string() }
            sb.append(c)
        }
        throw "TOML: unterminated literal string"
    }

    // Parse a multi-line literal string (triple single-quoted)
    fun parse_multiline_literal_string(): String {
        if (peek() == "\n") { pos = pos + 1 }
        else if (peek() == "\r") {
            pos = pos + 1
            if (peek() == "\n") { pos = pos + 1 }
        }
        var sb = StringBuilder()
        while (pos < source.length()) {
            if (peek() == "'" and peek_at(1) == "'" and peek_at(2) == "'") {
                pos = pos + 3
                return sb.to_string()
            }
            sb.append(advance())
        }
        throw "TOML: unterminated multi-line literal string"
    }

    // Parse a key (bare or quoted)
    fun parse_key(): String {
        var c = peek()
        if (c == "\"") {
            advance()
            return parse_basic_string()
        }
        if (c == "'") {
            advance()
            return parse_literal_string()
        }
        return parse_bare_key()
    }

    // Parse a dotted key into a list of key parts
    fun parse_dotted_key(): List<String> {
        var parts = []
        parts.push(parse_key())
        while (peek() == ".") {
            advance()
            parts.push(parse_key())
        }
        return parts
    }

    // Navigate into nested maps, creating intermediate maps as needed,
    // and set the final value.
    fun set_nested(table: Any, keys: Any, value: Any) {
        var current = table
        var i = 0
        while (i < keys.length() - 1) {
            var k = keys[i]
            if (!current.has(k)) {
                current.set(k, Map())
            }
            current = current.get(k)
            i = i + 1
        }
        current.set(keys[keys.length() - 1], value)
    }

    // Parse a value — all sub-parsers inlined to avoid forward references
    fun parse_value() {
        skip_ws()
        var c = peek()

        // String values
        if (c == "\"") {
            advance()
            if (peek() == "\"" and peek_at(1) == "\"") {
                pos = pos + 2
                return parse_multiline_basic_string()
            }
            return parse_basic_string()
        }
        if (c == "'") {
            advance()
            if (peek() == "'" and peek_at(1) == "'") {
                pos = pos + 2
                return parse_multiline_literal_string()
            }
            return parse_literal_string()
        }

        // Boolean
        if (c == "t" and peek_at(1) == "r" and peek_at(2) == "u" and peek_at(3) == "e") {
            pos = pos + 4
            return true
        }
        if (c == "f" and peek_at(1) == "a" and peek_at(2) == "l" and peek_at(3) == "s" and peek_at(4) == "e") {
            pos = pos + 5
            return false
        }

        // Number (integer or float)
        if (is_digit(c) or c == "+" or c == "-") {
            var sb = StringBuilder()

            if (c == "+" or c == "-") {
                sb.append(advance())
            }

            // Special values: inf, nan
            if (peek() == "i" and peek_at(1) == "n" and peek_at(2) == "f") {
                pos = pos + 3
                var sign_str = sb.to_string()
                if (sign_str == "-") {
                    return 0 - (1 / 0)
                }
                return 1 / 0
            }
            if (peek() == "n" and peek_at(1) == "a" and peek_at(2) == "n") {
                pos = pos + 3
                return 0 / 0
            }

            var has_dot = false
            var has_exp = false
            var num_done = false
            while (pos < source.length() and !num_done) {
                var ch = peek()
                if (is_digit(ch)) {
                    sb.append(advance())
                } else if (ch == "_") {
                    advance()
                } else if (ch == "." and !has_dot and !has_exp) {
                    has_dot = true
                    sb.append(advance())
                } else if ((ch == "e" or ch == "E") and !has_exp) {
                    has_exp = true
                    sb.append(advance())
                    if (peek() == "+" or peek() == "-") {
                        sb.append(advance())
                    }
                } else {
                    num_done = true
                }
            }

            return sb.to_string().to_number()
        }

        // Array
        if (c == "[") {
            advance()
            var arr = []
            skip_ws_and_newlines()
            if (peek() == "]") {
                advance()
                return arr
            }
            var arr_done = false
            while (!arr_done) {
                skip_ws_and_newlines()
                arr.push(parse_value())
                skip_ws_and_newlines()
                if (peek() == ",") {
                    advance()
                    skip_ws_and_newlines()
                }
                if (peek() == "]") {
                    advance()
                    arr_done = true
                }
            }
            return arr
        }

        // Inline table
        if (c == "{") {
            advance()
            var tbl = Map()
            skip_ws()
            if (peek() == "}") {
                advance()
                return tbl
            }
            var tbl_done = false
            while (!tbl_done) {
                skip_ws()
                var key_parts = parse_dotted_key()
                skip_ws()
                if (peek() != "=") {
                    throw "TOML: expected '=' in inline table at position ${pos}"
                }
                advance()
                skip_ws()
                var val = parse_value()
                set_nested(tbl, key_parts, val)
                skip_ws()
                if (peek() == ",") {
                    advance()
                } else if (peek() == "}") {
                    advance()
                    tbl_done = true
                } else {
                    throw "TOML: expected ',' or '}' in inline table at position ${pos}"
                }
            }
            return tbl
        }

        throw "TOML: unexpected character '${c}' at position ${pos}"
    }

    // Navigate into nested maps, creating intermediate maps as needed,
    // and return the final map.
    fun ensure_table(table: Any, keys: Any) {
        var current = table
        var i = 0
        while (i < keys.length()) {
            var k = keys[i]
            if (!current.has(k)) {
                current.set(k, Map())
            }
            var next = current.get(k)
            if (next is List) {
                current = next[next.length() - 1]
            } else {
                current = next
            }
            i = i + 1
        }
        return current
    }

    // Navigate for array of tables: ensures the final key holds a List,
    // appends a new Map to it, and returns it.
    fun ensure_array_table(table: Any, keys: Any) {
        var current = table
        var i = 0
        while (i < keys.length() - 1) {
            var k = keys[i]
            if (!current.has(k)) {
                current.set(k, Map())
            }
            var next = current.get(k)
            if (next is List) {
                current = next[next.length() - 1]
            } else {
                current = next
            }
            i = i + 1
        }
        var last_key = keys[keys.length() - 1]
        if (!current.has(last_key)) {
            current.set(last_key, [])
        }
        var arr = current.get(last_key)
        var new_table = Map()
        arr.push(new_table)
        return new_table
    }

    // Parse a table header: [key.path]
    fun parse_table_header(): List<String> {
        advance()  // consume '['
        skip_ws()
        var keys = parse_dotted_key()
        skip_ws()
        if (peek() != "]") {
            throw "TOML: expected ']' at position ${pos}"
        }
        advance()
        return keys
    }

    // Parse an array of tables header: [[key.path]]
    fun parse_array_table_header(): List<String> {
        advance()  // consume first '['
        advance()  // consume second '['
        skip_ws()
        var keys = parse_dotted_key()
        skip_ws()
        if (peek() != "]" or peek_at(1) != "]") {
            throw "TOML: expected ']]' at position ${pos}"
        }
        advance()
        advance()
        return keys
    }

    // Main parsing loop
    var current_table = root

    while (!is_at_end()) {
        skip_ws()
        var c = peek()

        if (is_newline(c)) {
            pos = pos + 1
        } else if (c == "#") {
            skip_comment()
            if (!is_at_end() and is_newline(peek())) {
                pos = pos + 1
            }
        } else if (c == "[") {
            if (peek_at(1) == "[") {
                var keys = parse_array_table_header()
                skip_to_newline()
                current_table = ensure_array_table(root, keys)
            } else {
                var keys = parse_table_header()
                skip_to_newline()
                current_table = ensure_table(root, keys)
            }
        } else {
            var key_parts = parse_dotted_key()
            skip_ws()
            if (peek() != "=") {
                throw "TOML: expected '=' after key at position ${pos}, got '${peek()}'"
            }
            advance()
            skip_ws()
            var val = parse_value()
            set_nested(current_table, key_parts, val)
            skip_to_newline()
        }
    }

    return root
}

/// Parse a TOML file by path.
///
/// ```saffron
/// import "@toml" as TOML
/// var config = TOML.parse_file("config.toml")
/// config.get("package").get("name")
/// ```
fun parse_file(path: String): Map<String, Any> {
    var source = IO.read_file(path)
    return parse(source)
}

/// Serialize a Map to TOML format.
///
/// ```saffron
/// import "@toml" as TOML
/// var cfg = {"package": {"name": "saffron", "version": "0.1.0"}}
/// IO.println(TOML.stringify(cfg))
/// // [package]
/// // name = "saffron"
/// // version = "0.1.0"
/// ```
fun stringify(table_data: Any): String {
    var sb = StringBuilder()

    fun is_bare_char(c: String): Bool {
        return c == "a" or c == "b" or c == "c" or c == "d" or c == "e" or
               c == "f" or c == "g" or c == "h" or c == "i" or c == "j" or
               c == "k" or c == "l" or c == "m" or c == "n" or c == "o" or
               c == "p" or c == "q" or c == "r" or c == "s" or c == "t" or
               c == "u" or c == "v" or c == "w" or c == "x" or c == "y" or
               c == "z" or c == "A" or c == "B" or c == "C" or c == "D" or
               c == "E" or c == "F" or c == "G" or c == "H" or c == "I" or
               c == "J" or c == "K" or c == "L" or c == "M" or c == "N" or
               c == "O" or c == "P" or c == "Q" or c == "R" or c == "S" or
               c == "T" or c == "U" or c == "V" or c == "W" or c == "X" or
               c == "Y" or c == "Z" or c == "0" or c == "1" or c == "2" or
               c == "3" or c == "4" or c == "5" or c == "6" or c == "7" or
               c == "8" or c == "9" or c == "-" or c == "_"
    }

    fun needs_quoting(key: String): Bool {
        if (key.length() == 0) { return true }
        var i = 0
        while (i < key.length()) {
            var c = key.char_at(i)
            if (!is_bare_char(c)) { return true }
            i = i + 1
        }
        return false
    }

    fun escape_basic_string(str: String): String {
        var result = StringBuilder()
        result.append("\"")
        var i = 0
        while (i < str.length()) {
            var c = str.char_at(i)
            if (c == "\"") { result.append("\\\"") }
            else if (c == "\\") { result.append("\\\\") }
            else if (c == "\n") { result.append("\\n") }
            else if (c == "\t") { result.append("\\t") }
            else if (c == "\r") { result.append("\\r") }
            else { result.append(c) }
            i = i + 1
        }
        result.append("\"")
        return result.to_string()
    }

    fun format_key(key: Any): String {
        if (needs_quoting(key)) {
            return escape_basic_string(key)
        }
        return key
    }

    fun format_value(value: Any): String {
        if (value == nil) { return "\"\"" }
        if (value == true) { return "true" }
        if (value == false) { return "false" }
        if (value is Number) { return value.to_string() }
        if (value is String) { return escape_basic_string(value) }
        if (value is List) {
            var result = StringBuilder()
            result.append("[")
            var i = 0
            while (i < value.length()) {
                if (i > 0) { result.append(", ") }
                result.append(format_value(value[i]))
                i = i + 1
            }
            result.append("]")
            return result.to_string()
        }
        if (value is Map) {
            var keys = value.keys()
            var result = StringBuilder()
            result.append("{")
            var i = 0
            while (i < keys.length()) {
                if (i > 0) { result.append(", ") }
                result.append(format_key(keys[i]))
                result.append(" = ")
                result.append(format_value(value.get(keys[i])))
                i = i + 1
            }
            result.append("}")
            return result.to_string()
        }
        return "\"\""
    }

    fun is_table_value(value: Any): Bool {
        if (value is Map) { return true }
        if (value is List) {
            if (value.length() > 0 and value[0] is Map) { return true }
        }
        return false
    }

    fun make_full_key(prefix: String, key: Any): String {
        if (prefix.length() > 0) {
            return prefix + "." + key
        }
        return "" + key
    }

    fun write_table(table: Any, prefix: String) {
        var keys = table.keys()

        // First pass: write simple key-value pairs
        var i = 0
        while (i < keys.length()) {
            var key = keys[i]
            var val = table.get(key)
            if (!is_table_value(val)) {
                sb.append(format_key(key))
                sb.append(" = ")
                sb.append(format_value(val))
                sb.append("\n")
            }
            i = i + 1
        }

        // Second pass: write sub-tables and array of tables
        i = 0
        while (i < keys.length()) {
            var key = keys[i]
            var val = table.get(key)
            var full_key = make_full_key(prefix, key)

            if (val is Map) {
                sb.append("\n[")
                sb.append(full_key)
                sb.append("]\n")
                write_table(val, full_key)
            } else if (val is List and val.length() > 0 and val[0] is Map) {
                var j = 0
                while (j < val.length()) {
                    sb.append("\n[[")
                    sb.append(full_key)
                    sb.append("]]\n")
                    write_table(val[j], full_key)
                    j = j + 1
                }
            }
            i = i + 1
        }
    }

    write_table(table_data, "")
    return sb.to_string()
}
