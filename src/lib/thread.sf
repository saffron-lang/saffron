//! OS threads (native only) — spawn, join, detach, sleep.
//!
//! ```saffron
//! import "@thread" as Thread
//!
//! var t = Thread.spawn(fun (): Int => expensive_blocking_call())
//! // ... do other work on this thread ...
//! var result = t.join()
//! ```
//!
//! ## The model: one runtime lock (v1)
//!
//! Saffron's garbage collector is not thread-safe (a single global heap and
//! shadow stack, no locking). So v1 runs under a **Global Runtime Lock**: only
//! one thread executes managed Saffron code at a time, and the lock is released
//! only around genuinely-blocking native calls — `join`, `sleep`, and (later)
//! mutex/channel waits. That buys **blocking-I/O and blocking-FFI concurrency**
//! (a synchronous C call on a worker no longer freezes everything else), but not
//! multi-core CPU parallelism for pure-Saffron compute. See
//! `docs/design/threading-module-plan.md`.
//!
//! Because of the lock, this is not a way to make CPU-bound Saffron faster; it is
//! a way to keep the program responsive while a thread is blocked in the OS or in
//! C. For serialized shared state across concurrent tasks, actors remain the
//! right tool.
//!
//! ## Sharing values
//!
//! A thread closure may freely capture immutable scalars and Strings. Capturing a
//! mutable List/Map/Fun draws the same non-Sendable warning as `Task.spawn`:
//! prefer passing data in and reading the result back out via `join()`.
//!
//! Native only. On wasm32 there are no OS threads; `spawn` runs the closure
//! synchronously and returns an already-finished handle (see the wasm note in the
//! design plan) — single-file source stays portable, with no parallelism.

// Signatures are C `i64`, so a passed closure box (a tagged pointer) is untagged
// to its raw address at the FFI boundary — exactly what the C trampoline reads as
// [fn_ptr, env]. The Saffron-level `Fun`/`Int` annotations drive that untagging;
// see gen_extern_call.
@extern("i64 sf_thread_spawn(i64)")  fun _spawn(closure: Fun): Int
@extern("i64 sf_thread_join(i64)")   fun _join(handle: Int): Any
@extern("i64 sf_thread_detach(i64)") fun _detach(handle: Int): Int
@extern("void sf_thread_sleep(double)") fun _sleep(seconds: Float)

@extern("i64 sf_mutex_new()")          fun _mutex_new(): Int
@extern("void sf_mutex_lock(i64)")     fun _mutex_lock(handle: Int)
@extern("i64 sf_mutex_trylock(i64)")   fun _mutex_trylock(handle: Int): Int
@extern("void sf_mutex_unlock(i64)")   fun _mutex_unlock(handle: Int)
@extern("void sf_mutex_free(i64)")     fun _mutex_free(handle: Int)

@extern("i64 sf_atomic_new(i64)")          fun _atomic_new(initial: Int): Int
@extern("i64 sf_atomic_load(i64)")         fun _atomic_load(handle: Int): Int
@extern("void sf_atomic_store(i64, i64)")  fun _atomic_store(handle: Int, v: Int)
@extern("i64 sf_atomic_add(i64, i64)")     fun _atomic_add(handle: Int, delta: Int): Int
@extern("i64 sf_atomic_cas(i64, i64, i64)") fun _atomic_cas(handle: Int, expected: Int, desired: Int): Int
@extern("void sf_atomic_free(i64)")        fun _atomic_free(handle: Int)

/// A running (or finished) OS thread. Returned by `Thread.spawn`; `join()` waits
/// for it and yields the closure's return value.
class ThreadHandle {
    private var _handle: Int
    // 1 once join() has run, so a second join returns nil rather than blocking on
    // a freed handle. Detach also sets it (a detached thread is not joinable).
    private var _consumed: Int

    fun init(handle: Int) {
        this._handle = handle
        this._consumed = 0
    }

    /// True if the spawn actually created a thread. A false handle means the OS
    /// refused (thread table full or pthread_create failed); `join()` on it is nil.
    fun ok(): Bool {
        return this._handle > 0
    }

    /// Block until the thread finishes and return the closure's result. The GRL
    /// is released while blocked, so other threads run meanwhile. A second join,
    /// or a join on a detached/failed handle, returns nil.
    fun join(): Any {
        if (this._consumed == 1 or this._handle <= 0) { return nil }
        this._consumed = 1
        return _join(this._handle)
    }

    /// Give up the right to join. The thread runs to completion on its own and
    /// its slot is reclaimed automatically. After detach, `join()` returns nil.
    fun detach() {
        if (this._consumed == 1 or this._handle <= 0) { return }
        this._consumed = 1
        _detach(this._handle)
    }
}

/// Start `fn` on a new OS thread and return a handle to it. `fn` takes no
/// arguments; whatever it returns is delivered by `join()`. Check `handle.ok()`
/// if you need to distinguish a real thread from an OS refusal.
fun spawn(fn: Fun): ThreadHandle {
    return ThreadHandle(_spawn(fn))
}

/// Spawn `fn` and immediately detach it — fire-and-forget. The thread runs to
/// completion; its result is discarded. Returns nothing.
fun detach(fn: Fun) {
    var h: ThreadHandle = spawn(fn)
    h.detach()
}

/// Sleep the CURRENT thread for `seconds` (a real OS sleep, releasing the GRL so
/// other threads run). Distinct from `Async.sleep`, which yields a coroutine
/// within the cooperative scheduler on a single thread.
fun sleep(seconds: Float) {
    _sleep(seconds)
}

/// A mutual-exclusion lock for serializing a critical section across threads.
///
/// You need this — separately from the GRL — whenever a critical section spans a
/// point where the GRL is dropped (a `join`, a `sleep`, another `lock`). The GRL
/// alone serializes only *uninterrupted* managed execution; the moment a thread
/// blocks, another can run, and a read-modify-write straddling that gap races
/// unless a Mutex guards it.
///
/// ```saffron
/// var m = Thread.Mutex()
/// m.lock()
/// // ... exclusive section ...
/// m.unlock()
/// ```
///
/// Non-recursive: locking twice on one thread without unlocking deadlocks. Call
/// `free()` when done, or let it be dropped (the OS reclaims the mutex at exit).
class Mutex {
    private var _handle: Int

    fun init() {
        this._handle = _mutex_new()
    }

    /// Acquire the lock, blocking until it is available. Releases the GRL while
    /// blocked so the holder can make progress and release it.
    fun lock() {
        _mutex_lock(this._handle)
    }

    /// Try to acquire without blocking. Returns true if the lock was taken, false
    /// if another thread holds it.
    fun try_lock(): Bool {
        return _mutex_trylock(this._handle) == 1
    }

    /// Release the lock. Must be called by the thread that holds it.
    fun unlock() {
        _mutex_unlock(this._handle)
    }

    /// Run `body` with the lock held, releasing it even if `body` throws. The
    /// structured way to use a mutex — there is no path that leaves it locked.
    ///
    /// Written as try/catch-rethrow rather than try/finally because the parser
    /// requires a `catch` clause (there is no bare try/finally). The catch
    /// unlocks and re-throws so an exception still propagates; the normal path
    /// unlocks after `body` returns.
    fun with(body: Fun): Any {
        this.lock()
        try {
            var result: Any = body()
            this.unlock()
            return result
        } catch (e) {
            this.unlock()
            throw e
        }
    }

    /// Destroy the underlying OS mutex. Using this Mutex afterward is undefined.
    fun free() {
        _mutex_free(this._handle)
    }
}

/// A single integer with atomic operations — a lock-free counter or flag shared
/// across threads. Its value lives off the managed heap, so it is safe to touch
/// while the GRL is dropped (which is the whole point: an atomic increment around
/// a `sleep` needs no lock).
///
/// ```saffron
/// var n = Thread.Atomic(0)
/// n.add(1)          // returns the new value
/// n.load()          // read
/// ```
///
/// Values are the usual Saffron Int range (48-bit); intended for counters and
/// flags, not for packing full 64-bit words.
class Atomic {
    private var _handle: Int

    fun init(initial: Int) {
        this._handle = _atomic_new(initial)
    }

    /// The current value.
    fun load(): Int {
        return _atomic_load(this._handle)
    }

    /// Set the value.
    fun store(v: Int) {
        _atomic_store(this._handle, v)
    }

    /// Atomically add `delta` and return the NEW value. `add(1)` is an atomic
    /// increment; pass a negative delta to decrement.
    fun add(delta: Int): Int {
        return _atomic_add(this._handle, delta)
    }

    /// Compare-and-swap: if the current value equals `expected`, set it to
    /// `desired` and return true; otherwise leave it and return false. The
    /// primitive for lock-free update loops.
    fun compare_and_set(expected: Int, desired: Int): Bool {
        return _atomic_cas(this._handle, expected, desired) == 1
    }

    /// Release the slot. Using this Atomic afterward is undefined.
    fun free() {
        _atomic_free(this._handle)
    }
}
