//! Saffron Language Tools — full access to the compiler pipeline.
//!
//! Provides lexing, parsing, type checking, code generation, and AST manipulation.
//!
//! ```saffron
//! import "@lang" as Lang
//!
//! var ast = Lang.parse("var x = 42")
//! var ir = Lang.compile("IO.println(\"hello\")")
//! var errors = Lang.check(source)
//! ```

import "@ast" as PubAst
import "@lexer" as Lex
import "@parser" as Parse

// Re-export core types for convenience. `type`, not `var` — see the note in
// src/lib/ast.sf. These are re-exports of re-exports (@ast already aliases the
// compiler's own definitions), so the alias has to survive two hops.
type Expr = PubAst.Expr
type Stmt = PubAst.Stmt
type Type = PubAst.Type
type Token = Lex.Token
type TokenKind = Lex.TokenKind

// =============================================================================
// Pipeline Functions
// =============================================================================

/// Tokenize source code into a list of tokens.
fun lex(source: String): List<Any> {
    return Lex.tokenize(source)
}

/// Parse source code into an AST (list of statements).
fun parse(source: String): List<Any> {
    return Parse.parse(source)
}

/// Parse a single expression from source.
fun parse_expr(source: String): Any {
    return Parse.parse_expr(source)
}

/// Parse a file by path into an AST.
fun parse_file(path: String): List<Any> {
    return Parse.parse_file(path)
}

// =============================================================================
// AST Helpers
// =============================================================================

/// Get the name of a declaration (function, class, enum, var).
fun name_of(stmt: Any): String {
    return PubAst.stmt_name(stmt)
}

/// Get the docstring of a declaration.
fun doc_of(stmt: Any): String {
    return PubAst.stmt_doc(stmt)
}

/// Find all function declarations in an AST.
fun functions(stmts: List<Any>): List<Any> {
    return PubAst.find_functions(stmts)
}

/// Find all class declarations in an AST.
fun classes(stmts: List<Any>): List<Any> {
    return PubAst.find_classes(stmts)
}

/// Find all enum declarations in an AST.
fun enums(stmts: List<Any>): List<Any> {
    return PubAst.find_enums(stmts)
}

/// Walk all statements recursively, calling visitor on each.
fun walk(stmts: List<Any>, visitor: Any) {
    PubAst.walk_stmts(stmts, visitor)
}

// =============================================================================
// AST Construction
// =============================================================================

/// Create a string literal expression.
fun string_lit(value: String): Any {
    return PubAst.Expr.StringLit(value)
}

/// Create an integer literal expression.
fun int_lit(value: Int): Any {
    return PubAst.Expr.IntLit(value)
}

/// Create a boolean literal expression.
fun bool_lit(value: Bool): Any {
    return PubAst.Expr.BoolLit(value)
}

/// Create a variable reference expression.
///
/// The node gets `span_none()`: these builders assemble an AST from scratch
/// rather than from parsed text, so there is no source region to record. That is
/// the same rule the parser follows for its own desugarings — a synthetic node
/// has no span, and inventing one would point an editor at nothing.
fun variable(name: String): Any {
    return PubAst.Expr.Variable(name, PubAst.span_none())
}

/// Create a binary operation expression.
fun binary(left: Any, op: String, right: Any): Any {
    return PubAst.Expr.Binary(left, op, right)
}

/// Create a function call expression.
fun call(callee: Any, args: List<Any>): Any {
    return PubAst.Expr.Call(callee, args, PubAst.span_none())
}

/// Create a method call expression.
fun method_call(object: Any, method: String, args: List<Any>): Any {
    return PubAst.Expr.MethodCall(object, method, args, PubAst.span_none())
}

// =============================================================================
// Source Generation (AST → String)
// =============================================================================

/// Convert an expression back to source code.
fun expr_to_source(expr: Any): String {
    return match (expr) {
        StringLit(s) => "\"" + s + "\""
        IntLit(n) => n.to_string()
        FloatLit(n) => n.to_string()
        BoolLit(b) => b.to_string()
        NilLit => "nil"
        Variable(name, __vs) => name
        Binary(l, op, r) => expr_to_source(l) + " " + op + " " + expr_to_source(r)
        Unary(op, right) => op + expr_to_source(right)
        Call(callee, args, __cs) => expr_to_source(callee) + "(" + _join_exprs(args) + ")"
        MethodCall(obj, method, args, __ks) => expr_to_source(obj) + "." + method + "(" + _join_exprs(args) + ")"
        Assign(name, value, __as) => name + " = " + expr_to_source(value)
        x => "<expr>"
    }
}

/// A `var`'s declared type as a source suffix — `": Int"`, or `""` when the
/// declaration carried no annotation.
fun var_type_suffix(t: Any): String {
    if (PubAst.type_is_unknown(t)) { return "" }
    return ": " + PubAst.type_to_source(t)
}

/// Convert a statement back to source code.
fun stmt_to_source(stmt: Any): String {
    return match (stmt) {
        // The annotation is optional, and this printed `": " + type_ann`
        // unconditionally — so an unannotated `var x = 1` rendered as
        // `var x:  = 1`, which is not source this compiler would accept back. It
        // could not be spotted from the field alone while the omission was spelled
        // "", since concatenating "" produces exactly that stray colon; the node
        // makes the absence a case you have to handle.
        VarDecl(name, type_ann, init, doc, v_vis, __ns, __fs) => "var " + name + var_type_suffix(type_ann) + " = " + expr_to_source(init)
        FunDecl(name, params, ret, body, doc, f_vis, __ns, __fs) => "fun " + name + "(...) { ... }"
        ClassDecl(name, type_params, parents, fields, methods, doc, c_vis, __ns, __fs, __intro) => "class " + name + " { ... }"
        EnumDecl(name, variants, doc, e_vis, __ns, __fs) => "enum " + name + " { ... }"
        ExprStmt(expr) => expr_to_source(expr)
        Return(value) => "return " + expr_to_source(value)
        x => "<stmt>"
    }
}

private fun _join_exprs(exprs: List<Any>): String {
    var parts: List<String> = []
    var i = 0
    while (i < exprs.length()) {
        parts.push(expr_to_source(exprs[i]))
        i = i + 1
    }
    return parts.join(", ")
}
