//! Async-aware synchronization primitives for cooperative concurrency.
//! All primitives use cooperative yielding — they suspend the current task
//! until the condition is met, allowing other tasks to run.
//!
//! Usage:
//!   import "@sync" as Sync
//!   var lock = Sync.Mutex()
//!   lock.acquire()
//!   // critical section
//!   lock.release()

// ---------------------------------------------------------------------------
// Mutex — async-aware mutual exclusion lock
// ---------------------------------------------------------------------------

/// A cooperative mutex. Only one task can hold the lock at a time.
/// Other tasks that call acquire() will yield until the lock is released.
///
/// ```saffron
/// import "@sync" as Sync
/// var lock = Sync.Mutex()
/// lock.acquire()
/// // critical section — only one task at a time
/// lock.release()
/// ```
class Mutex {
    var _locked: Bool

    fun init() {
        this._locked = false
    }

    /// Acquire the lock. Suspends the current task if already held.
    fun acquire() {
        while (this._locked) {
            yield;
        }
        this._locked = true
    }

    /// Release the lock, allowing the next waiting task to acquire it.
    fun release() {
        this._locked = false
    }

    /// Returns true if the lock is currently held.
    fun is_locked(): Bool {
        return this._locked
    }
}

// ---------------------------------------------------------------------------
// Semaphore — counting semaphore
// ---------------------------------------------------------------------------

/// A cooperative counting semaphore. Allows up to N concurrent accessors.
///
/// ```saffron
/// import "@sync" as Sync
/// var sem = Sync.Semaphore(3)
/// sem.acquire()   // decrements permits, suspends if 0
/// // limited-concurrency section
/// sem.release()   // increments permits, wakes a waiter
/// ```
class Semaphore {
    var _permits: Int

    fun init(permits: Int) {
        this._permits = permits
    }

    /// Acquire one permit. Suspends if no permits are available.
    fun acquire() {
        while (this._permits <= 0) {
            yield;
        }
        this._permits = this._permits - 1
    }

    /// Release one permit, potentially waking a waiting task.
    fun release() {
        this._permits = this._permits + 1
    }

    /// Returns the number of currently available permits.
    fun available(): Int {
        return this._permits
    }
}

// ---------------------------------------------------------------------------
// WaitGroup — wait for a group of tasks to complete
// ---------------------------------------------------------------------------

/// A cooperative wait group. Add a count, spawn tasks that call done(),
/// then wait() until all have finished.
///
/// ```saffron
/// import "@sync" as Sync
/// var wg = Sync.WaitGroup()
/// wg.add(3)
/// // spawn 3 tasks that each call wg.done() when finished
/// wg.wait()  // suspends until counter reaches 0
/// ```
class WaitGroup {
    var _counter: Int

    fun init() {
        this._counter = 0
    }

    /// Add delta to the counter (typically called before spawning tasks).
    fun add(delta: Int) {
        this._counter = this._counter + delta
    }

    /// Decrement the counter by 1. Called by each task when it finishes.
    fun done() {
        this._counter = this._counter - 1
        if (this._counter < 0) {
            this._counter = 0
        }
    }

    /// Suspend the current task until the counter reaches 0.
    fun wait() {
        while (this._counter > 0) {
            yield;
        }
    }

    /// Returns the current counter value.
    fun count(): Int {
        return this._counter
    }
}

// ---------------------------------------------------------------------------
// Once — run-once guard
// ---------------------------------------------------------------------------

/// A cooperative run-once guard. The function passed to do() is only
/// executed the first time; subsequent calls are no-ops and return
/// the cached result.
///
/// ```saffron
/// import "@sync" as Sync
/// var once = Sync.Once()
/// once.do(fun () => expensive_init())  // runs the function
/// once.do(fun () => expensive_init())  // no-op, returns cached result
/// ```
class Once {
    var _done: Bool
    var _result: Any

    fun init() {
        this._done = false
        this._result = nil
    }

    /// Execute fn only if this is the first call. Returns the result
    /// of the first execution on all subsequent calls.
    fun do(fn: Any): Any {
        if (this._done) {
            return this._result
        }
        this._done = true
        this._result = fn()
        return this._result
    }

    /// Returns true if the guarded function has already been executed.
    fun is_done(): Bool {
        return this._done
    }

    /// Returns the cached result (nil if not yet executed).
    fun result(): Any {
        return this._result
    }
}

// ---------------------------------------------------------------------------
// Channel — bounded async channel for message passing
// ---------------------------------------------------------------------------

/// A bounded, typed channel for cooperative message passing between tasks.
/// send() suspends if the buffer is full; recv() suspends if empty.
///
/// The type parameter T specifies the message type carried by the channel.
/// Once the checker supports generic class type enforcement, send/recv will
/// be statically checked against T.
///
/// ```saffron
/// import "@sync" as Sync
/// var ch = Sync.Channel<String>(10)
/// ch.send("hello")        // OK: String matches T=String
/// var msg: String = ch.recv()     // "hello"
/// ch.close()
/// ```
class Channel<T> {
    var _buffer: List<T>
    var _capacity: Int
    var _closed: Bool

    fun init(capacity: Int) {
        this._buffer = []
        this._capacity = capacity
        this._closed = false
    }

    /// Send a value into the channel. Suspends if the buffer is full.
    /// Throws if the channel is closed.
    fun send(value: T) {
        if (this._closed) {
            throw "send on closed channel"
        }
        // Wait until there is room in the buffer
        while (this._buffer.length() >= this._capacity) {
            if (this._closed) {
                throw "send on closed channel"
            }
            yield;
        }
        this._buffer.push(value)
    }

    /// Receive a value from the channel. Suspends if the buffer is empty.
    /// Returns nil if the channel is closed and empty.
    fun recv(): T {
        // Wait until there is a value or channel is closed
        while (this._buffer.length() == 0) {
            if (this._closed) {
                return nil
            }
            yield;
        }
        return this._dequeue()
    }

    /// Try to receive without blocking. Returns nil if empty.
    fun try_recv(): T {
        if (this._buffer.length() == 0) {
            return nil
        }
        return this._dequeue()
    }

    /// Try to send without blocking. Returns true if sent, false if full.
    fun try_send(value: T): Bool {
        if (this._closed) {
            return false
        }
        if (this._buffer.length() >= this._capacity) {
            return false
        }
        this._buffer.push(value)
        return true
    }

    // Dequeue the first element from the buffer (FIFO).
    fun _dequeue(): T {
        this._buffer.reverse()
        var value = this._buffer.pop()
        this._buffer.reverse()
        return value
    }

    /// Close the channel. No more sends are allowed.
    /// Pending recv() calls will return nil once the buffer drains.
    fun close() {
        this._closed = true
    }

    /// Returns true if the channel has been closed.
    fun is_closed(): Bool {
        return this._closed
    }

    /// Returns the number of values currently buffered.
    fun len(): Int {
        return this._buffer.length()
    }

    /// Returns the channel's maximum capacity.
    fun capacity(): Int {
        return this._capacity
    }
}
