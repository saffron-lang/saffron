//! String formatting utilities for templates, padding, and alignment.

/// Format a template string by replacing {0}, {1}, etc. with values from the list.
///
/// ```saffron
/// import "@fmt" as Fmt
/// Fmt.format("{0} + {1} = {2}", [1, 2, 3])  // "1 + 2 = 3"
/// ```
fun format(template: String, values: List<Any>): String {
    var sb = StringBuilder()
    var i = 0
    while (i < template.length()) {
        var c = template.char_at(i)
        if (c == "{") {
            var end = i + 1
            while (end < template.length()) {
                if (template.char_at(end) == "}") {
                    break
                }
                end = end + 1
            }
            var idx_str = template.slice(i + 1, end)
            var idx = idx_str.to_number()
            if (idx < values.length()) {
                var val = values[idx]
                if (val == nil) {
                    sb.append("nil")
                } else if (val == true) {
                    sb.append("true")
                } else if (val == false) {
                    sb.append("false")
                } else if (val is Number) {
                    sb.append(val.to_string())
                } else if (val is String) {
                    sb.append(val)
                } else {
                    sb.append("<value>")
                }
            }
            i = end + 1
        } else {
            sb.append(c)
            i = i + 1
        }
    }
    return sb.to_string()
}

/// Pad text on the left to reach the given width using the fill character.
///
/// ```saffron
/// import "@fmt" as Fmt
/// Fmt.pad_left("42", 5, "0")  // "00042"
/// ```
fun pad_left(text: String, width: Number, fill: String): String {
    var sb = StringBuilder()
    var needed = width - text.length()
    var i = 0
    while (i < needed) {
        sb.append(fill)
        i = i + 1
    }
    sb.append(text)
    return sb.to_string()
}

/// Pad text on the right to reach the given width using the fill character.
///
/// ```saffron
/// import "@fmt" as Fmt
/// Fmt.pad_right("hi", 5, ".")  // "hi..."
/// ```
fun pad_right(text: String, width: Number, fill: String): String {
    var sb = StringBuilder()
    sb.append(text)
    var needed = width - text.length()
    var i = 0
    while (i < needed) {
        sb.append(fill)
        i = i + 1
    }
    return sb.to_string()
}

/// Center text within the given width, padding both sides with the fill character.
///
/// ```saffron
/// import "@fmt" as Fmt
/// Fmt.center("hi", 6, "-")  // "--hi--"
/// ```
fun center(text: String, width: Number, fill: String): String {
    var total = width - text.length()
    if (total <= 0) { return text }
    var left = total / 2
    var right = total - left
    var sb = StringBuilder()
    var i = 0
    while (i < left) { sb.append(fill); i = i + 1 }
    sb.append(text)
    i = 0
    while (i < right) { sb.append(fill); i = i + 1 }
    return sb.to_string()
}

/// Repeat a string n times.
///
/// ```saffron
/// import "@fmt" as Fmt
/// Fmt.repeat("ha", 3)  // "hahaha"
/// ```
fun repeat(text: String, n: Number): String {
    return text.repeat(n)
}
