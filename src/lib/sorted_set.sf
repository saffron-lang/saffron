//! Sorted set — unique elements maintained in sorted order via binary search.
//! O(log n) lookup, O(n) insert/remove due to array shifting.
//! Elements must support < and == operators (Numbers, Strings).

/// An ordered set of unique elements kept in sorted order.
/// Elements are compared using the < operator directly.
///
/// ```saffron
/// import "@sorted_set" as SortedSet
///
/// var ss = SortedSet.new()
/// ss.add(5).add(1).add(3)
/// ss.to_list()  // [1, 3, 5]
/// ```
class SortedSet {
    var _items: List<Any>

    fun init() {
        this._items = []
    }

    /// Binary search for the insertion index of value.
    /// Uses < operator for comparison.
    /// Returns the index where value is or would be inserted.
    fun _bisect(value: Any): Number {
        var lo: Number = 0
        var hi: Number = this._items.length()
        while (lo < hi) {
            var mid: Number = ((lo + hi) / 2).floor()
            if (this._items[mid] < value) {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return lo
    }

    /// Add a value to the set. No-op if already present.
    fun add(value: Any): SortedSet {
        var idx = this._bisect(value)
        if (idx < this._items.length() and this._items[idx] == value) {
            // Already present
            return this
        }
        // Insert at idx — shift elements right
        this._items.push(nil)
        var i = this._items.length() - 1
        while (i > idx) {
            this._items[i] = this._items[i - 1]
            i = i - 1
        }
        this._items[idx] = value
        return this
    }

    /// Remove a value from the set. No-op if not present.
    fun remove(value: Any): SortedSet {
        var idx = this._bisect(value)
        if (idx < this._items.length() and this._items[idx] == value) {
            // Shift elements left
            var i = idx
            while (i < this._items.length() - 1) {
                this._items[i] = this._items[i + 1]
                i = i + 1
            }
            this._items.pop()
        }
        return this
    }

    /// Check whether a value is in the set.
    fun has(value: Any): Bool {
        var idx = this._bisect(value)
        return idx < this._items.length() and this._items[idx] == value
    }

    /// Return the minimum (first) element, or nil if empty.
    fun min(): Any {
        if (this._items.length() == 0) { return nil }
        return this._items[0]
    }

    /// Return the maximum (last) element, or nil if empty.
    fun max(): Any {
        if (this._items.length() == 0) { return nil }
        return this._items[this._items.length() - 1]
    }

    /// Return the number of elements.
    fun length(): Number {
        return this._items.length()
    }

    /// Return true if the set is empty.
    fun is_empty(): Bool {
        return this._items.length() == 0
    }

    /// Return elements as a sorted list.
    fun to_list(): List<Any> {
        var result: List<Any> = []
        var i = 0
        while (i < this._items.length()) {
            result.push(this._items[i])
            i = i + 1
        }
        return result
    }

    /// Return elements in [from, to).
    fun range(from: Any, to: Any): List<Any> {
        var result: List<Any> = []
        var lo = this._bisect(from)
        var hi = this._bisect(to)
        var i = lo
        while (i < hi) {
            result.push(this._items[i])
            i = i + 1
        }
        return result
    }

    fun to_string(): String {
        var sb = StringBuilder()
        sb.append("SortedSet{")
        var i = 0
        while (i < this._items.length()) {
            if (i > 0) { sb.append(", ") }
            var item = this._items[i]
            if (item is String) {
                sb.append("\"")
                sb.append(item)
                sb.append("\"")
            } else if (item is Number) {
                var n: Number = item
                sb.append(n.to_string())
            } else {
                sb.append("<value>")
            }
            i = i + 1
        }
        sb.append("}")
        return sb.to_string()
    }
}

/// Create a new empty SortedSet.
fun new(): SortedSet {
    return SortedSet()
}

/// Create a SortedSet from a list of items (duplicates removed).
///
/// ```saffron
/// import "@sorted_set" as SortedSet
/// var ss = SortedSet.from([3, 1, 2, 1])
/// ss.to_list()  // [1, 2, 3]
/// ```
fun from(items: List<Any>): SortedSet {
    var ss = SortedSet()
    var i = 0
    while (i < items.length()) {
        ss.add(items[i])
        i = i + 1
    }
    return ss
}

/// Return a new SortedSet containing all elements from both sets.
fun union(a: SortedSet, b: SortedSet): SortedSet {
    var result = SortedSet()
    // Merge-style linear scan over two sorted lists
    var ai = 0
    var bi = 0
    var a_items = a.to_list()
    var b_items = b.to_list()
    while (ai < a_items.length() and bi < b_items.length()) {
        if (a_items[ai] < b_items[bi]) {
            result._items.push(a_items[ai])
            ai = ai + 1
        } else if (b_items[bi] < a_items[ai]) {
            result._items.push(b_items[bi])
            bi = bi + 1
        } else {
            // Equal — take one
            result._items.push(a_items[ai])
            ai = ai + 1
            bi = bi + 1
        }
    }
    while (ai < a_items.length()) {
        result._items.push(a_items[ai])
        ai = ai + 1
    }
    while (bi < b_items.length()) {
        result._items.push(b_items[bi])
        bi = bi + 1
    }
    return result
}

/// Return a new SortedSet containing only elements present in both sets.
fun intersection(a: SortedSet, b: SortedSet): SortedSet {
    var result = SortedSet()
    var ai = 0
    var bi = 0
    var a_items = a.to_list()
    var b_items = b.to_list()
    while (ai < a_items.length() and bi < b_items.length()) {
        if (a_items[ai] < b_items[bi]) {
            ai = ai + 1
        } else if (b_items[bi] < a_items[ai]) {
            bi = bi + 1
        } else {
            result._items.push(a_items[ai])
            ai = ai + 1
            bi = bi + 1
        }
    }
    return result
}

/// Return a new SortedSet containing elements in a that are not in b.
fun difference(a: SortedSet, b: SortedSet): SortedSet {
    var result = SortedSet()
    var ai = 0
    var bi = 0
    var a_items = a.to_list()
    var b_items = b.to_list()
    while (ai < a_items.length() and bi < b_items.length()) {
        if (a_items[ai] < b_items[bi]) {
            result._items.push(a_items[ai])
            ai = ai + 1
        } else if (b_items[bi] < a_items[ai]) {
            bi = bi + 1
        } else {
            // Equal — skip both
            ai = ai + 1
            bi = bi + 1
        }
    }
    while (ai < a_items.length()) {
        result._items.push(a_items[ai])
        ai = ai + 1
    }
    return result
}
