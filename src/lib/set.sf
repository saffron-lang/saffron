//! Set data structure backed by a Map, with union, intersection, and difference operations.

/// An unordered collection of unique values.
///
/// ```saffron
/// import "@set" as Sets
/// var s = Sets.Set()
/// s.add(1).add(2).add(3)
/// s.has(2)      // true
/// s.size()      // 3
/// s.values()    // [1, 2, 3]
/// ```
class Set {
    private var _map: Map<Any, Bool>

    fun init() {
        this._map = Map()
    }

    fun add(value: Any): Set {
        this._map.set(value, true)
        return this
    }

    fun has(value: Any): Bool {
        return this._map.has(value)
    }

    fun remove(value: Any): Set {
        this._map.set(value, nil)
        return this
    }

    fun size(): Int {
        return this._map.keys().length()
    }

    fun values(): List<Any> {
        return this._map.keys()
    }

    fun to_string(): String {
        var sb = StringBuilder()
        sb.append("Set{")
        var keys = this._map.keys()
        var i = 0
        while (i < keys.length()) {
            if (i > 0) { sb.append(", ") }
            var k = keys[i]
            if (k is String) {
                sb.append("\"")
                sb.append(k)
                sb.append("\"")
            } else if (k is Int or k is Float) {
                sb.append(k.to_string())
            } else {
                sb.append("<value>")
            }
            i = i + 1
        }
        sb.append("}")
        return sb.to_string()
    }
}

/// Create a Set from a list of items.
///
/// ```saffron
/// import "@set" as Sets
/// var s = Sets.from([1, 2, 3, 2, 1])
/// s.size()  // 3
/// ```
fun from(items: List<Any>): Set {
    var s = Set()
    var i = 0
    while (i < items.length()) {
        s.add(items[i])
        i = i + 1
    }
    return s
}

/// Return a new Set containing all elements from both sets.
///
/// ```saffron
/// import "@set" as Sets
/// var a = Sets.from([1, 2, 3])
/// var b = Sets.from([3, 4, 5])
/// Sets.union(a, b).values()  // [1, 2, 3, 4, 5]
/// ```
fun union(a: Set, b: Set): Set {
    var result = Set()
    var av = a.values()
    var i = 0
    while (i < av.length()) {
        result.add(av[i])
        i = i + 1
    }
    var bv = b.values()
    i = 0
    while (i < bv.length()) {
        result.add(bv[i])
        i = i + 1
    }
    return result
}

/// Return a new Set containing only elements present in both sets.
///
/// ```saffron
/// import "@set" as Sets
/// var a = Sets.from([1, 2, 3, 4])
/// var b = Sets.from([3, 4, 5, 6])
/// Sets.intersect(a, b).values()  // [3, 4]
/// ```
fun intersect(a: Set, b: Set): Set {
    var result = Set()
    var av = a.values()
    var i = 0
    while (i < av.length()) {
        if (b.has(av[i])) {
            result.add(av[i])
        }
        i = i + 1
    }
    return result
}

/// Return a new Set containing elements in a that are not in b.
///
/// ```saffron
/// import "@set" as Sets
/// var a = Sets.from([1, 2, 3, 4])
/// var b = Sets.from([3, 4, 5])
/// Sets.diff(a, b).values()  // [1, 2]
/// ```
fun diff(a: Set, b: Set): Set {
    var result = Set()
    var av = a.values()
    var i = 0
    while (i < av.length()) {
        if (b.has(av[i]) == false) {
            result.add(av[i])
        }
        i = i + 1
    }
    return result
}
