//! Int — 64-bit signed integer type.
//! Wraps a raw i64 value and provides numeric methods.

@extern("i64 __int_to_string(i64)") private fun _int_to_string(val: Int): Int

/// The Int class — wraps a raw 64-bit signed integer.
class Int {
    private var _val: Int

    /// Convert this integer to its string representation.
    fun to_string(): String {
        return _int_to_string(this._val)
    }

    /// Convert this integer to a floating-point value.
    fun to_float(): Float {
        return this._val
    }

    /// Return the absolute value of this integer.
    fun abs(): Int {
        if (this._val < 0) {
            return 0 - this._val
        }
        return this._val
    }

    /// No-op for integers — returns self.
    fun floor(): Int {
        return this._val
    }

    /// No-op for integers — returns self.
    fun ceil(): Int {
        return this._val
    }

    // --- Operator methods (Phase E preparation) ---

    /// Addition operator.
    @inline
    fun add(other: Int): Int { return this._val + other._val }

    /// Subtraction operator.
    @inline
    fun sub(other: Int): Int { return this._val - other._val }

    /// Multiplication operator.
    @inline
    fun mul(other: Int): Int { return this._val * other._val }

    /// Division operator.
    @inline
    fun div(other: Int): Int { return this._val / other._val }

    /// Modulo operator.
    @inline
    fun mod(other: Int): Int { return this._val % other._val }

    /// Less-than operator.
    @inline
    fun lt(other: Int): Bool { return this._val < other._val }

    /// Greater-than operator.
    @inline
    fun gt(other: Int): Bool { return this._val > other._val }

    /// Equality operator.
    @inline
    fun eq(other: Int): Bool { return this._val == other._val }
}
