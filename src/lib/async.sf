//! Async primitives for cooperative concurrency.
//! Importing this module also imports the scheduler automatically.
//! Users only need: import "@async" as Async

import "@scheduler" as Scheduler
import "@thread" as Thread

@intrinsic fun __suspend(reason: Int, arg: Int)

/// Suspend the current task for the given duration in seconds.
fun sleep(duration: Float) {
    __suspend(1, duration)
}

/// Await a single task and return its result. The functional spelling of
/// `task.await()`, for symmetry with `gather`/`race` and for use in expression
/// position where a method call reads awkwardly.
///
/// This was documented in CLAUDE.md and called from `promise.sf` and
/// `test/async_coop.sf` long before it existed — those failed to link
/// (`_stdlib_async_await` undefined). Adding it was blocked on BUGS #38: it
/// would have linked and then silently returned frame handles instead of
/// results, which is a worse failure than a link error.
fun await(task: Int): Any {
    return task.await()
}

/// Await all tasks in a list, return their results as a list.
/// Like Python's asyncio.gather() — runs all concurrently, collects results in order.
fun gather(tasks: List<Int>): List<Int> {
    // __suspend(0,0) ensures this function is detected as a coroutine
    // even by compilers that don't have the m=="await" detection yet
    __suspend(0, 0)
    var results: List<Int> = []
    var i: Int = 0
    while (i < tasks.length()) {
        var task: Int = tasks[i]
        var r: Int = task.await()
        results.push(r)
        i = i + 1
    }
    return results
}

/// Await the first task to complete from a list. Returns its result.
/// Remaining tasks continue running in the background.
fun race(tasks: List<Int>): Int {
    while (true) {
        var i: Int = 0
        while (i < tasks.length()) {
            if (tasks[i].isReady()) {
                return tasks[i].getResult()
            }
            i = i + 1
        }
        __suspend(0, 0)
    }
    return 0
}

/// Run a function with a timeout. Returns the result if it completes
/// within the deadline, or nil if it times out.
/// Usage: var result = Async.timeout(fun () => Http.get(url), 5.0)
fun timeout(fn: Fun, seconds: Float): Int {
    var task = Task.spawn(fn)
    var elapsed: Float = 0.0
    var step: Float = 0.01
    while (elapsed < seconds) {
        if (task.isReady()) {
            return task.getResult()
        }
        sleep(step)
        elapsed = elapsed + step
        // Exponential backoff on polling interval (up to 100ms)
        if (step < 0.1) { step = step * 1.5 }
    }
    return 0
}

/// Run multiple functions concurrently with bounded parallelism.
/// Like Python's asyncio.TaskGroup or Elixir's Task.async_stream.
fun parallel(fns: List<Fun>, max_concurrent: Int): List<Int> {
    var results: List<Int> = []
    var i: Int = 0
    while (i < fns.length()) {
        // Launch a batch of max_concurrent
        var batch: List<Int> = []
        var j: Int = 0
        while (j < max_concurrent and i + j < fns.length()) {
            batch.push(Task.spawn(fns[i + j]))
            j = j + 1
        }
        // Await the batch
        var bi: Int = 0
        while (bi < batch.length()) {
            results.push(batch[bi].await())
            bi = bi + 1
        }
        i = i + j
    }
    return results
}

/// Run `fn` on a real OS thread and return a handle to await. This is how you
/// call a BLOCKING function (a synchronous C call, heavy CPU work, a slow FFI)
/// from inside a coroutine without freezing the event loop: the work runs on a
/// worker thread while other coroutines keep making progress on the main thread.
///
/// The returned handle is passed to `await_thread`. Spawn it, do other async
/// work, then await when you need the result:
///
/// ```saffron
/// var t = Async.spawn_blocking(fun () => slow_c_call())
/// // ... other coroutines run here ...
/// var result = Async.await_thread(t)
/// ```
///
/// ## What `fn` may and may not do (v1 constraint)
///
/// `fn` is for work that BLOCKS IN C or COMPUTES — a synchronous FFI call, a
/// slow syscall, a tight numeric loop. It must NOT, in v1, call a Saffron
/// primitive that releases the Global Runtime Lock while the async scheduler is
/// running: `Thread.sleep`, `Thread.Mutex.lock`, another `Thread.join`, or a
/// channel wait. Doing so lets the worker and the main-thread scheduler execute
/// managed code at the same time, and they share scheduler globals
/// (`@__task_result`, the yield registers) — the result comes back corrupted.
/// Keeping `fn` to pure C/compute keeps the worker off those globals entirely.
/// (Lifting this needs true scheduler/worker isolation — a v2 item; see
/// docs/design/threading-module-plan.md.)
///
/// Native only (it uses @thread). On wasm there are no OS threads.
fun spawn_blocking(fn: Fun): Thread.ThreadHandle {
    return Thread.spawn_piped(fn)
}

/// Await a handle from `spawn_blocking`, parking THIS coroutine until the worker
/// finishes — without blocking the runtime. Returns the worker's result.
///
/// The result is `Any` on purpose. Do NOT stash it in an intermediate variable
/// annotated with a concrete type across a suspension point, e.g.
/// `var r: Int = Async.await_thread(h)` — annotating an already-boxed Any as Int
/// re-tags it, and once the coroutine actually suspends (another task runs), the
/// re-tagged value is read back wrong (a Float came out as a denormal). This is
/// BUGS #38, not specific to the bridge. Either return it directly
/// (`return Async.await_thread(h)`) or keep the local typed `Any`.
///
/// It parks on the worker's completion self-pipe via yield reason 2 (IO-read),
/// the same mechanism a socket read uses, so the scheduler keeps running every
/// other coroutine while this one waits. When the worker finishes it writes a
/// byte to the pipe; the scheduler's fd poll wakes this coroutine, which then
/// joins (already complete, so instant) to collect the result. If the worker
/// finished before we parked, the byte is already buffered and the poll sees the
/// fd readable at once — no lost wakeup.
fun await_thread(handle: Thread.ThreadHandle): Any {
    var fd: Int = handle.done_fd()
    if (fd < 0) {
        // Not a piped handle (or already invalid): fall back to a direct join.
        return handle.join()
    }
    // Park until the completion pipe is readable. `__suspend(2, fd)` is the
    // IO-read yield the scheduler already parks sockets on.
    __suspend(2, fd)
    // Woken: the worker has published its result and written the wake byte.
    // join() returns it immediately and closes the pipe.
    return handle.join()
}
