//! Cooperative task scheduler for native async.

@extern("double sf_time_now()") fun time_now(): Number
@extern("void __sched_coro_resume(i64)") fun coro_resume(handle: Int)
@extern("i64 __sched_coro_done(i64)") fun coro_done(handle: Int): Int
@extern("void __sched_coro_destroy(i64)") fun coro_destroy(handle: Int)
@extern("i64 __sched_get_yield_reason()") fun get_yield_reason(): Int
@extern("i64 __sched_get_yield_arg()") fun get_yield_arg(): Int
@extern("i64 __sched_get_task_result()") fun get_task_result_global(): Int
@extern("void __sched_reset_yield()") fun reset_yield()
@extern("void __sched_store_result(i64, i64)") fun store_result(handle: Int, value: Int)
@extern("i64 __sched_has_stored_result(i64)") fun has_stored_result(handle: Int): Int
@extern("i64 sf_tcp_poll(i64, i64, i64)") fun tcp_poll(fd: Int, events: Int, timeout_ms: Int): Int

var run_queue: List<Int> = []
var sleep_queue: List<Int> = []
var sleep_times: List<Number> = []
var result_handles: List<Int> = []
var result_values: List<Int> = []

// Await waiters: task waiting for another task to complete
var await_targets: List<Int> = []
var await_waiters: List<Int> = []

// IO waiters: tasks suspended on socket readiness
var io_handles: List<Int> = []
var io_fds: List<Int> = []
var io_modes: List<Int> = []  // 0=read, 1=write

// Actor waiters: tasks suspended waiting for an actor to become idle
var actor_wait_handles: List<Int> = []
var actor_wait_targets: List<Int> = []

// Set to 1 when the scheduler stopped because the only work left was tasks
// parked on an actor that can never become idle. See the idle check in
// `scheduler_tick()` for why that state is unrecoverable rather than transient.
var deadlock_detected: Int = 0

fun get_result(handle: Int): Int {
    var i: Int = 0
    while (i < result_handles.length()) {
        if (result_handles[i] == handle) {
            return result_values[i]
        }
        i = i + 1
    }
    return 0
}

fun enqueue(handle: Int) {
    run_queue.push(handle)
}

/// True (1) when a task is parked on a condition that fires *on its own*: a
/// timer expiring, an fd becoming ready, or an awaited task finishing. These
/// justify another tick even with an empty run queue, because the outside world
/// (or a task the scheduler itself will resume) will eventually revive them.
///
/// This is the single source of truth for that list. `_has_parked_work()` and
/// `scheduler_tick()`'s idle check both delegate here so they cannot drift
/// apart; a new self-reviving park reason is added here and nowhere else.
fun _has_self_reviving_work(): Int {
    if (sleep_queue.length() > 0) { return 1 }
    if (await_waiters.length() > 0) { return 1 }
    if (io_handles.length() > 0) { return 1 }
    return 0
}

/// True (1) when at least one task is parked in any wait queue, including tasks
/// parked on a busy actor. Actor waiters count as pending work — they are owed a
/// resume — but unlike the queues above they cannot revive themselves, which is
/// why `scheduler_tick()` treats an actor-only queue as a deadlock rather than a
/// reason to keep spinning.
fun _has_parked_work(): Int {
    if (_has_self_reviving_work() == 1) { return 1 }
    if (actor_wait_handles.length() > 0) { return 1 }
    return 0
}

/// True (1) when the scheduler still has work: something runnable now, or
/// something parked that may become runnable later.
fun _has_pending(): Int {
    if (run_queue.length() > 0) { return 1 }
    return _has_parked_work()
}

/// Park `handle` as if it had suspended with yield reason 5 (waiting on the
/// actor at `actor_ptr`). `scheduler_tick()` does this itself for real
/// coroutines; this is exposed so the scheduler's own liveness tests can build
/// the "only actor waiters remain" state directly instead of trying to race two
/// coroutines into contention.
fun _park_on_actor(handle: Int, actor_ptr: Int) {
    actor_wait_handles.push(handle)
    actor_wait_targets.push(actor_ptr)
}

/// 1 if the scheduler ever stopped with tasks still parked on a busy actor.
fun deadlock_flag(): Int {
    return deadlock_detected
}

/// Clear all scheduler state. Test-only: lets the liveness tests return the
/// scheduler to a known-empty state between cases without depending on
/// `List.remove()`, which is currently a no-op (see the note in
/// `wake_actor_waiters`).
fun _reset_for_test() {
    run_queue = []
    sleep_queue = []
    sleep_times = []
    await_targets = []
    await_waiters = []
    io_handles = []
    io_fds = []
    io_modes = []
    actor_wait_handles = []
    actor_wait_targets = []
    deadlock_detected = 0
}

fun _wake_waiters(finished_handle: Int) {
    var i: Int = await_targets.length() - 1
    while (i >= 0) {
        if (await_targets[i] == finished_handle) {
            run_queue.push(await_waiters[i])
            await_targets.remove(i)
            await_waiters.remove(i)
        }
        i = i - 1
    }
}

// Poll all parked IO fds for readiness.
// Moves ready tasks back to the run queue.
// timeout_ms: how long to block if nothing is immediately ready.
fun _poll_io(timeout_ms: Int) {
    // First pass: check each fd with 0ms timeout (non-blocking)
    var i: Int = io_handles.length() - 1
    while (i >= 0) {
        var ready: Int = tcp_poll(io_fds[i], io_modes[i], 0)
        if (ready == 1) {
            run_queue.push(io_handles[i])
            io_handles.remove(i)
            io_fds.remove(i)
            io_modes.remove(i)
        }
        i = i - 1
    }
    // If nothing was ready and we still have waiting tasks, do a blocking
    // poll on the first fd to avoid busy-spinning
    if (run_queue.length() == 0 and io_handles.length() > 0 and timeout_ms > 0) {
        var ready: Int = tcp_poll(io_fds[0], io_modes[0], timeout_ms)
        if (ready == 1) {
            run_queue.push(io_handles[0])
            io_handles.remove(0)
            io_fds.remove(0)
            io_modes.remove(0)
        }
    }
}

fun scheduler_tick(): Int {
    var now: Number = time_now()
    var i: Int = sleep_queue.length() - 1
    while (i >= 0) {
        if (sleep_times[i] <= now) {
            run_queue.push(sleep_queue[i])
            sleep_queue.remove(i)
            sleep_times.remove(i)
        }
        i = i - 1
    }

    // Poll IO fds when run queue is empty but IO tasks are waiting
    if (run_queue.length() == 0 and io_handles.length() > 0) {
        _poll_io(10)
    }

    if (run_queue.length() == 0) {
        // Delegate to the shared list rather than re-listing the queues here —
        // that duplication is what let `actor_wait_handles` be silently dropped.
        if (_has_self_reviving_work() == 1) { return 1 }

        // Only actor waiters left. A busy actor is released by a *runnable*
        // task, and there is none: the run queue is empty and no timer, fd or
        // awaited task can produce one. No future tick can change this state, so
        // returning 1 would spin hot forever. Report the deadlock and stop
        // instead of dropping the parked tasks on the floor.
        if (actor_wait_handles.length() > 0) {
            deadlock_detected = 1
            IO.println("saffron: deadlock — " + actor_wait_handles.length().to_string() + " task(s) parked on a busy actor with no runnable task left to release it")
        }
        return 0
    }

    var hdl: Int = run_queue.remove(0)
    coro_resume(hdl)

    if (coro_done(hdl) == 1) {
        var res: Int = get_task_result_global()
        result_handles.push(hdl)
        result_values.push(res)
        store_result(hdl, res)
        _wake_waiters(hdl)
        // Note: do NOT coro_destroy here — other coroutines may still
        // call coro_done(hdl) to check completion (e.g. gather/await).
        // The GC will reclaim the coroutine frame when no longer referenced.
    } else {
        var reason: Int = get_yield_reason()
        if (reason == 0) {
            run_queue.push(hdl)
        } else if (reason == 1) {
            var duration: Number = get_yield_arg()
            sleep_queue.push(hdl)
            sleep_times.push(now + duration)
        } else if (reason == 2) {
            // IO read: park until fd is readable
            var fd: Int = get_yield_arg()
            io_handles.push(hdl)
            io_fds.push(fd)
            io_modes.push(0)
        } else if (reason == 3) {
            // Await: park this task until the target task finishes
            var target: Int = get_yield_arg()
            if (has_stored_result(target) == 1) {
                // Target already completed (result in C table) — resume immediately
                run_queue.push(hdl)
            } else {
                await_targets.push(target)
                await_waiters.push(hdl)
            }
        } else if (reason == 4) {
            // IO write: park until fd is writable
            var fd: Int = get_yield_arg()
            io_handles.push(hdl)
            io_fds.push(fd)
            io_modes.push(1)
        } else if (reason == 5) {
            // Actor wait: park until actor is idle
            var actor_ptr: Int = get_yield_arg()
            actor_wait_handles.push(hdl)
            actor_wait_targets.push(actor_ptr)
        }
        reset_yield()
    }

    return _has_pending()
}

fun scheduler_run() {
    while (scheduler_tick() == 1) {}
}

// WARNING: the `.remove(i)` calls below are currently no-ops. The codegen for
// `List.remove` passes a NaN-boxed index to the runtime's `__list_remove`, which
// expects a raw i64, so the bounds check rejects it and returns nil without
// shifting or shrinking the list (src/compiler/codegen/methods_body.sf:1661
// omits the `emit_untag_int` that the index-get path at :418 performs). Every
// queue-draining loop in this file is affected: woken tasks are pushed to
// `run_queue` but never removed from their wait queue, so they are resumed
// repeatedly and the wait queues grow without bound. This is a pre-existing
// codegen bug — identical IR is produced by the checked-in gen2 — and fixing it
// is out of scope here (src/compiler/** is owned elsewhere right now).
fun wake_actor_waiters(actor_ptr: Int) {
    var i: Int = actor_wait_handles.length() - 1
    while (i >= 0) {
        if (actor_wait_targets[i] == actor_ptr) {
            run_queue.push(actor_wait_handles[i])
            actor_wait_handles.remove(i)
            actor_wait_targets.remove(i)
        }
        i = i - 1
    }
}
