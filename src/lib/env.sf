//! Build environment access.
//! Values are set by Pantry based on the active environment.
//!
//! ```saffron
//! import "@env" as Env
//! if (Env.is_prod()) {
//!     IO.println("Running in production")
//! }
//! ```

import "@os" as OS

/// Get an environment constant. Returns empty string if not set.
fun get(key: String): String {
    return OS.env(key)
}

/// Return the current build environment name ("dev", "test", "prod", etc.)
fun current(): String {
    var e: String = OS.env("SAFFRON_ENV")
    if (e == "") { return "dev" }
    return e
}

/// Check if currently in a specific environment.
fun is_env(name: String): Bool {
    return current() == name
}

/// True if in dev environment.
fun is_dev(): Bool { return is_env("dev") }

/// True if in test environment.
fun is_test(): Bool { return is_env("test") }

/// True if in prod environment.
fun is_prod(): Bool { return is_env("prod") }
