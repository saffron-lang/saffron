//! AST node types and utilities for working with Saffron syntax trees.
//! Re-exports the internal AST definitions and adds traversal helpers.

import "../compiler/ast.sf" as Internal

// Re-export core types
var Expr = Internal.Expr
var Stmt = Internal.Stmt
var Pattern = Internal.Pattern
var MatchArm = Internal.MatchArm
var Variant = Internal.Variant
var Type = Internal.Type

/// Walk all statements in a program, calling `visitor` on each.
fun walk_stmts(stmts: List<Internal.Stmt>, visitor: (Internal.Stmt) => Nil) {
    for (stmt in stmts) {
        visitor(stmt)
        walk_children(stmt, visitor)
    }
}

/// Recursively visit child statements within a statement.
fun walk_children(stmt: Internal.Stmt, visitor: (Internal.Stmt) => Nil) {
    match (stmt) {
        FunDecl(name, params, ret_type, body, docstring) => {
            walk_stmts(body, visitor)
        },
        ClassDecl(name, fields, methods, docstring) => {
            walk_stmts(methods, visitor)
        },
        If(condition, then_branch, else_branch) => {
            walk_stmts(then_branch, visitor)
            walk_stmts(else_branch, visitor)
        },
        While(condition, body) => {
            walk_stmts(body, visitor)
        },
        Block(stmts) => {
            walk_stmts(stmts, visitor)
        }
    }
}

/// Extract all function declarations from a list of statements.
fun find_functions(stmts: List<Internal.Stmt>): List<Internal.Stmt> {
    var results: List<Internal.Stmt> = []
    walk_stmts(stmts, fun (stmt: Internal.Stmt) {
        match (stmt) {
            FunDecl(name, params, ret_type, body, docstring) => {
                results.push(stmt)
            }
        }
    })
    return results
}

/// Extract all class declarations from a list of statements.
fun find_classes(stmts: List<Internal.Stmt>): List<Internal.Stmt> {
    var results: List<Internal.Stmt> = []
    walk_stmts(stmts, fun (stmt: Internal.Stmt) {
        match (stmt) {
            ClassDecl(name, fields, methods, docstring) => {
                results.push(stmt)
            }
        }
    })
    return results
}

/// Extract all enum declarations from a list of statements.
fun find_enums(stmts: List<Internal.Stmt>): List<Internal.Stmt> {
    var results: List<Internal.Stmt> = []
    walk_stmts(stmts, fun (stmt: Internal.Stmt) {
        match (stmt) {
            EnumDecl(name, variants, docstring) => {
                results.push(stmt)
            }
        }
    })
    return results
}

/// Get the name of a statement (for declarations that have names).
fun stmt_name(stmt: Internal.Stmt): String {
    return match (stmt) {
        FunDecl(name, params, ret_type, body, docstring) => name,
        ClassDecl(name, fields, methods, docstring) => name,
        EnumDecl(name, variants, docstring) => name,
        VarDecl(name, type_ann, initializer, docstring) => name
    }
}

/// Get the docstring of a statement (for declarations that have them).
fun stmt_doc(stmt: Internal.Stmt): String {
    return match (stmt) {
        FunDecl(name, params, ret_type, body, docstring) => docstring,
        ClassDecl(name, fields, methods, docstring) => docstring,
        EnumDecl(name, variants, docstring) => docstring,
        VarDecl(name, type_ann, initializer, docstring) => docstring
    }
}
