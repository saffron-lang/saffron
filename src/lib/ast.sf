//! AST node types and utilities for working with Saffron syntax trees.
//! Re-exports the internal AST definitions and adds traversal/inspection helpers.
//!
//! ```saffron
//! import "@ast" as AST
//! import "@parser" as Parser
//!
//! var stmts = Parser.parse("fun hello() { IO.println(\"hi\") }")
//! var fns = AST.find_functions(stmts)
//! IO.println(AST.stmt_name(fns[0]))  // "hello"
//! ```

import "../compiler/ast.sf" as InternalAst

// Re-export core types.
//
// `type X = ...`, not `var X = ...`. The `var` form reads like a type
// re-export and is not one: it binds the name in the *value* namespace, so
// codegen resolves it as a function reference and emits a call to a symbol
// nothing defines. Every program that so much as imported this module then
// died in `opt` with "use of undefined value '@compiler_ast_Expr'" — reported
// as a compiler bug, because that is what it looked like. `type` is the real
// alias form and puts the name where an annotation can find it, which is why
// the signatures below name `Stmt`/`Span` instead of falling back to `Any`.
type Expr = InternalAst.Expr
type Stmt = InternalAst.Stmt
type Pattern = InternalAst.Pattern
type MatchArm = InternalAst.MatchArm
type Variant = InternalAst.Variant
type Type = InternalAst.Type
type Param = InternalAst.Param
// Declaration nodes carry source regions, so a consumer of `@ast` needs the
// Span type and its accessors to read them. Matching on `Span(...)` directly
// works, but going through the accessors means a future field on Span does not
// break every caller.
type Span = InternalAst.Span

/// The source region of a declaration's *name* — the go-to-definition and rename
/// target. `span_none()` for a node the parser synthesized rather than read;
/// guard with `span_is_real` before trusting it.
fun stmt_name_span(stmt: Stmt): Span {
    return match (stmt) {
        FunDecl(name, params, ret_type, body, docstring, f_vis, __ns, __fs) => __ns
        ClassDecl(name, type_params, parents, fields, methods, docstring, c_vis, __ns, __fs, __intro) => __ns
        EnumDecl(name, variants, docstring, e_vis, __ns, __fs) => __ns
        VarDecl(name, type_ann, initializer, docstring, v_vis, __ns, __fs) => __ns
        _ => InternalAst.span_none()
    }
}

/// The source region of the whole declaration, first token through last — the
/// foldable extent.
fun stmt_full_span(stmt: Stmt): Span {
    return match (stmt) {
        FunDecl(name, params, ret_type, body, docstring, f_vis, __ns, __fs) => __fs
        ClassDecl(name, type_params, parents, fields, methods, docstring, c_vis, __ns, __fs, __intro) => __fs
        EnumDecl(name, variants, docstring, e_vis, __ns, __fs) => __fs
        VarDecl(name, type_ann, initializer, docstring, v_vis, __ns, __fs) => __fs
        _ => InternalAst.span_none()
    }
}

/// The keyword that introduced a ClassDecl: "class", "interface" or "actor".
/// All three parse through the same node, so this is the only way to tell them
/// apart — `""` for a statement that is not a ClassDecl.
fun class_introducer(stmt: Stmt): String {
    return match (stmt) {
        ClassDecl(name, type_params, parents, fields, methods, docstring, c_vis, __ns, __fs, __intro) => __intro
        _ => ""
    }
}

/// The source region of the *identifier* an expression references — the
/// go-to-definition, find-references and rename target.
///
/// Which identifier depends on the node, and the choice is deliberate:
///
///   Variable / Ref / Assign      the bare name
///   MemberAccess / GetField / SetField
///                                the `.field`, NOT the object it hangs off
///   MethodCall                   the `.method`, NOT the receiver or the args
///
/// So on `holder.slot`, this returns the span of `slot` alone. Renaming through
/// a span that covered `holder.slot` would rewrite `holder` too. To locate the
/// object instead, destructure the node and ask about its child.
///
/// `Call` has no identifier of its own — its callee carries one — so it answers
/// with `span_none()` here; use `expr_full_span` for its extent.
fun expr_name_span(expr: Expr): Span {
    return match (expr) {
        Variable(name, __vs) => __vs
        Ref(kind, name, slot, __rs) => __rs
        Assign(name, value, __as) => __as
        MemberAccess(object, field, __ms) => __ms
        GetField(object, field, __gs) => __gs
        SetField(object, field, value, __ss) => __ss
        MethodCall(object, method, args, __ks) => __ks
        _ => InternalAst.span_none()
    }
}

/// The full extent of a call expression, callee through the closing paren — what
/// a wrong-arity or wrong-argument-type diagnostic underlines. `span_none()` for
/// any node that is not a `Call`; only `Call` records an extent, because it is
/// the only expression whose *shape* rather than whose name can be at fault.
fun expr_full_span(expr: Expr): Span {
    return match (expr) {
        Call(callee, args, __cs) => __cs
        _ => InternalAst.span_none()
    }
}

fun span_none(): Span { return InternalAst.span_none() }
fun span_is_real(s: Span): Bool { return InternalAst.span_is_real(s) }
fun span_line(s: Span): Float { return InternalAst.span_line(s) }
fun span_col(s: Span): Float { return InternalAst.span_col(s) }
fun span_offset(s: Span): Float { return InternalAst.span_offset(s) }
fun span_len(s: Span): Float { return InternalAst.span_len(s) }
fun span_merge(a: Span, b: Span): Span { return InternalAst.span_merge(a, b) }
fun span_to_string(s: Span): String { return InternalAst.span_to_string(s) }

// =============================================================================
// AST Traversal
// =============================================================================

/// Walk all statements in a program, calling `visitor` on each.
fun walk_stmts(stmts: List<Stmt>, visitor: Any) {
    var i: Float = 0
    while (i < stmts.length()) {
        visitor(stmts[i])
        walk_children(stmts[i], visitor)
        i = i + 1
    }
}

/// Recursively visit child statements within a statement.
fun walk_children(stmt: Stmt, visitor: Any) {
    match (stmt) {
        FunDecl(name, params, ret_type, body, docstring, f_vis, __ns, __fs) => {
            walk_stmts(body, visitor)
        }
        ClassDecl(name, type_params, parents, fields, methods, docstring, c_vis, __ns, __fs, __intro) => {
            walk_stmts(methods, visitor)
        }
        If(condition, then_branch, else_branch) => {
            walk_stmts(then_branch, visitor)
            walk_stmts(else_branch, visitor)
        }
        While(condition, body) => {
            walk_stmts(body, visitor)
        }
        Block(stmts) => {
            walk_stmts(stmts, visitor)
        }
        TryCatch(try_body, catch_name, catch_body, finally_body) => {
            walk_stmts(try_body, visitor)
            walk_stmts(catch_body, visitor)
            walk_stmts(finally_body, visitor)
        }
        _ => {}
    }
}

// =============================================================================
// AST Queries
// =============================================================================

/// Extract all function declarations from a list of statements.
fun find_functions(stmts: List<Stmt>): List<Stmt> {
    var results: List<Stmt> = []
    var i: Float = 0
    while (i < stmts.length()) {
        match (stmts[i]) {
            FunDecl(name, params, ret_type, body, docstring, f_vis, __ns, __fs) => {
                results.push(stmts[i])
            }
            _ => {}
        }
        i = i + 1
    }
    return results
}

/// Extract all class declarations from a list of statements.
fun find_classes(stmts: List<Stmt>): List<Stmt> {
    var results: List<Stmt> = []
    var i: Float = 0
    while (i < stmts.length()) {
        match (stmts[i]) {
            ClassDecl(name, type_params, parents, fields, methods, docstring, c_vis, __ns, __fs, __intro) => {
                results.push(stmts[i])
            }
            _ => {}
        }
        i = i + 1
    }
    return results
}

/// Extract all enum declarations from a list of statements.
fun find_enums(stmts: List<Stmt>): List<Stmt> {
    var results: List<Stmt> = []
    var i: Float = 0
    while (i < stmts.length()) {
        match (stmts[i]) {
            EnumDecl(name, variants, docstring, e_vis, __ns, __fs) => {
                results.push(stmts[i])
            }
            _ => {}
        }
        i = i + 1
    }
    return results
}

/// Get the name of a declaration statement.
fun stmt_name(stmt: Stmt): String {
    return match (stmt) {
        FunDecl(name, params, ret_type, body, docstring, f_vis, __ns, __fs) => name
        ClassDecl(name, type_params, parents, fields, methods, docstring, c_vis, __ns, __fs, __intro) => name
        EnumDecl(name, variants, docstring, e_vis, __ns, __fs) => name
        VarDecl(name, type_ann, initializer, docstring, v_vis, __ns, __fs) => name
        _ => ""
    }
}

/// Get the docstring of a declaration statement.
fun stmt_doc(stmt: Stmt): String {
    return match (stmt) {
        FunDecl(name, params, ret_type, body, docstring, f_vis, __ns, __fs) => docstring
        ClassDecl(name, type_params, parents, fields, methods, docstring, c_vis, __ns, __fs, __intro) => docstring
        EnumDecl(name, variants, docstring, e_vis, __ns, __fs) => docstring
        VarDecl(name, type_ann, initializer, docstring, v_vis, __ns, __fs) => docstring
        _ => ""
    }
}

/// Get the declared return type of a function declaration, as a `Type` node.
///
/// This was a `String` and returned "" for a non-FunDecl. Both facts changed with
/// the field: the type is a node, and the not-a-function answer is `UnknownType`
/// — which is also what a FunDecl with *no* declared return type carries. A caller
/// that needs to tell those two apart should ask `is_fun` first; a caller that
/// wants a string should render with `type_to_source`, which round-trips, rather
/// than `type_to_string`, which collapses generics and unions for diagnostics.
fun fun_ret_type(stmt: Stmt): Type {
    return match (stmt) {
        FunDecl(name, params, ret_type, body, docstring, f_vis, __ns, __fs) => ret_type
        _ => InternalAst.Type.UnknownType
    }
}

/// Get the params of a function declaration.
fun fun_params(stmt: Stmt): List<Param> {
    return match (stmt) {
        FunDecl(name, params, ret_type, body, docstring, f_vis, __ns, __fs) => params
        _ => []
    }
}

/// Get the body of a function declaration.
fun fun_body(stmt: Stmt): List<Stmt> {
    return match (stmt) {
        FunDecl(name, params, ret_type, body, docstring, f_vis, __ns, __fs) => body
        _ => []
    }
}

/// Check if a statement is a function declaration.
fun is_fun(stmt: Stmt): Bool {
    return match (stmt) {
        FunDecl(name, params, ret_type, body, docstring, f_vis, __ns, __fs) => true
        _ => false
    }
}

/// Check if a statement is a class declaration.
fun is_class(stmt: Stmt): Bool {
    return match (stmt) {
        ClassDecl(name, type_params, parents, fields, methods, docstring, c_vis, __ns, __fs, __intro) => true
        _ => false
    }
}

/// Check if a statement is an enum declaration.
fun is_enum(stmt: Stmt): Bool {
    return match (stmt) {
        EnumDecl(name, variants, docstring, e_vis, __ns, __fs) => true
        _ => false
    }
}
