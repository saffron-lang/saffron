//! Command-line argument parsing with support for flags, options, and positional arguments.

import "@os" as OS

/// Holds parsed command-line arguments split into flags, key=value options, and positional args.
class ParsedArgs {
    var flags: Map<String, Bool> = {}
    var options: Map<String, String> = {}
    var positional: List<String> = []

    fun init() {
        this.flags = {}
        this.options = {}
        this.positional = []
    }

    // Check if a flag or option with the given name was provided.
    fun has(name: String): Bool {
        return this.flags.has(name) or this.options.has(name)
    }

    // Get the value of a named option, or empty string if not set.
    fun get(name: String): String {
        if (this.options.has(name)) {
            return this.options.get(name)
        }
        return ""
    }

    // Check if a boolean flag was set.
    fun flag(name: String): Bool {
        if (this.flags.has(name)) { return true }
        return false
    }
}

private fun _is_long_flag(arg: String): Bool {
    if (arg.length() < 2) { return false }
    if (arg.char_at(0) == "-") {
        if (arg.char_at(1) == "-") { return true }
    }
    return false
}

private fun _is_short_flag(arg: String): Bool {
    if (arg.length() < 2) { return false }
    if (arg.char_at(0) == "-") {
        if (arg.char_at(1) == "-") { return false }
        return true
    }
    return false
}

private fun _process_arg(result: ParsedArgs, arg: String) {
    if (_is_long_flag(arg)) {
        var rest = arg.slice(2, arg.length())
        var eq_pos = rest.index_of("=")
        if (eq_pos >= 0) {
            var key = rest.slice(0, eq_pos)
            var val = rest.slice(eq_pos + 1, rest.length())
            result.options.set(key, val)
        } else {
            result.flags.set(rest, true)
        }
        return
    }
    if (_is_short_flag(arg)) {
        var rest = arg.slice(1, arg.length())
        var ci = 0
        while (ci < rest.length()) {
            result.flags.set(rest.char_at(ci), true)
            ci = ci + 1
        }
        return
    }
    result.positional.push(arg)
}

/// Parse a raw list of argument strings into a ParsedArgs.
fun parse_list(raw: List<String>): ParsedArgs {
    var result = ParsedArgs()
    var i = 0
    while (i < raw.length()) {
        var arg: String = raw[i]
        _process_arg(result, arg)
        i = i + 1
    }
    return result
}

/// Parse the process command-line arguments and return a ParsedArgs.
fun parse(): ParsedArgs {
    var raw = OS.args()
    return parse_list(raw)
}
