//! File discovery utilities for recursively searching directories by name, extension, or content.

import "@path" as Path
import "@os" as OS

/// Holds a recursive directory listing for querying files and subdirectories.
///
/// `file_paths` and `dir_paths` are both full paths under `base_dir`, collected
/// eagerly at construction.
///
/// This used to store `IO.walk_dir(dir)` as a `List<List<Any>>` and read each
/// entry as a Python `os.walk` `[root, dirs, files]` triple. `IO.walk_dir` is
/// really `ls -1` — bare names, one level, no descent — so `entry[0]` indexed into
/// a *filename string* and produced single characters. `files()` returned garbage
/// and nothing was recursive despite the docs. See the same defect and the same fix
/// in `@glob`'s `find_in`, and BUGS #153 for why it crashed instead of just
/// returning nothing.
class FileFinder {
    var file_paths: List<String>
    var dir_paths: List<String>
    var base_dir: String

    fun init(dir: String) {
        this.base_dir = dir
        this.file_paths = []
        this.dir_paths = []
        this._scan(dir)
    }

    /// Depth-first descent, pushing full paths into the two flat lists.
    fun _scan(dir: String) {
        var names: List<String> = IO.walk_dir(dir)
        var i = 0
        while (i < names.length()) {
            var full: String = Path.join([dir, names[i]])
            if (IO.is_dir(full)) {
                this.dir_paths.push(full)
                this._scan(full)
            } else {
                this.file_paths.push(full)
            }
            i = i + 1
        }
    }
}

/// Create a FileFinder rooted at the given directory.
fun from(dir: String): FileFinder {
    return FileFinder(dir)
}

/// Return all file paths found recursively under the finder's root directory.
fun files(finder: FileFinder): List<String> {
    return finder.file_paths
}

/// Return all subdirectory paths found recursively under the finder's root directory.
fun dirs(finder: FileFinder): List<String> {
    return finder.dir_paths
}

/// Filter files by file extension (e.g. ".sf").
fun by_ext(finder: FileFinder, extension: String): List<String> {
    var all = files(finder)
    var result = []
    var i = 0
    while (i < all.length()) {
        var file: String = all[i]
        if (Path.ext(file) == extension) {
            result.push(file)
        }
        i = i + 1
    }
    return result
}

/// Filter files by exact basename match.
fun by_name(finder: FileFinder, name: String): List<String> {
    var all = files(finder)
    var result = []
    var i = 0
    while (i < all.length()) {
        var file: String = all[i]
        if (Path.basename(file) == name) {
            result.push(file)
        }
        i = i + 1
    }
    return result
}

/// Return files whose content contains the given text.
fun containing(finder: FileFinder, text: String): List<String> {
    var all = files(finder)
    var result = []
    var i = 0
    while (i < all.length()) {
        var file: String = all[i]
        var content: String = IO.read_file(file)
        if (content.contains(text)) {
            result.push(file)
        }
        i = i + 1
    }
    return result
}

/// Return the first file found, or an empty string if none.
fun first(finder: FileFinder): String {
    var all = files(finder)
    if (all.length() > 0) {
        return all[0]
    }
    return ""
}

/// Return the total number of files found.
fun count(finder: FileFinder): Int {
    var all = files(finder)
    return all.length()
}
