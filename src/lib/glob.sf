//! File glob pattern matching and file discovery.
//!
//! Supports standard glob syntax: `*`, `**`, `?`, `[abc]`, `[!abc]`.
//!
//! ```saffron
//! import "@glob" as Glob
//!
//! // Find all Saffron files recursively
//! var sf_files = Glob.find("src/**/*.sf")
//!
//! // Check if a filename matches a pattern
//! Glob.matches("*.sf", "main.sf")  // true
//! ```

import "@path" as Path

// ASCII characters in order for range comparisons
var _ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// Get the ordinal position of a single character for range comparison.
fun _char_ord(c: String): Number {
    return _ascii.index_of(c)
}

/// Check if character ch falls within the range [lo, hi] inclusive.
fun _char_in_range(ch: String, lo: String, hi: String): Bool {
    var ch_ord = _char_ord(ch)
    var lo_ord = _char_ord(lo)
    var hi_ord = _char_ord(hi)
    if (ch_ord == -1 or lo_ord == -1 or hi_ord == -1) {
        return false
    }
    return ch_ord >= lo_ord and ch_ord <= hi_ord
}

/// Check if a character is a glob separator.
fun _is_sep(c: String): Bool {
    return c == "/"
}

/// Match a character class pattern like [abc] or [!abc].
/// pi points to the character after '['.
/// Returns [match_result, new_pattern_index].
/// match_result: 1 = matched, 0 = not matched, -1 = malformed.
fun _match_class(pattern: String, pi: Number, ch: String): List<Number> {
    var negate = false
    var i = pi
    if (i < pattern.length() and (pattern.char_at(i) == "!" or pattern.char_at(i) == "^")) {
        negate = true
        i = i + 1
    }

    var matched = false
    var start = i
    while (i < pattern.length()) {
        var c = pattern.char_at(i)
        if (c == "]" and i > start) {
            if (negate) {
                if (matched) { return [0, i + 1] }
                return [1, i + 1]
            }
            if (matched) { return [1, i + 1] }
            return [0, i + 1]
        }
        // Check for range: a-z
        if (i + 2 < pattern.length() and pattern.char_at(i + 1) == "-" and pattern.char_at(i + 2) != "]") {
            var lo = c
            var hi = pattern.char_at(i + 2)
            if (_char_in_range(ch, lo, hi)) {
                matched = true
            }
            i = i + 3
        } else {
            if (c == ch) {
                matched = true
            }
            i = i + 1
        }
    }
    // Unterminated bracket — treat as malformed
    return [-1, pi]
}

/// Internal recursive match implementation.
fun _matches_from(pattern: String, pi: Number, text: String, ti: Number): Bool {
    while (pi < pattern.length()) {
        var pc = pattern.char_at(pi)

        if (pc == "*") {
            // Check for **
            if (pi + 1 < pattern.length() and pattern.char_at(pi + 1) == "*") {
                // ** — matches everything including separators
                var next_pi = pi + 2
                // Skip trailing separator after **
                if (next_pi < pattern.length() and _is_sep(pattern.char_at(next_pi))) {
                    next_pi = next_pi + 1
                }
                // If ** is at end of pattern, match everything
                if (next_pi >= pattern.length()) {
                    return true
                }
                // Try matching the rest from every position in text
                var k = ti
                while (k <= text.length()) {
                    if (_matches_from(pattern, next_pi, text, k)) {
                        return true
                    }
                    k = k + 1
                }
                return false
            } else {
                // * — matches any non-separator sequence
                var next_pi = pi + 1
                // If * is at end of pattern, text must have no more separators
                if (next_pi >= pattern.length()) {
                    var k = ti
                    while (k < text.length()) {
                        if (_is_sep(text.char_at(k))) {
                            return false
                        }
                        k = k + 1
                    }
                    return true
                }
                // Try matching rest from every position until separator
                var k = ti
                while (k <= text.length()) {
                    if (_matches_from(pattern, next_pi, text, k)) {
                        return true
                    }
                    if (k < text.length() and _is_sep(text.char_at(k))) {
                        break
                    }
                    k = k + 1
                }
                return false
            }
        } else if (pc == "?") {
            // ? — match exactly one non-separator character
            if (ti >= text.length()) { return false }
            if (_is_sep(text.char_at(ti))) { return false }
            pi = pi + 1
            ti = ti + 1
        } else if (pc == "[") {
            // Character class
            if (ti >= text.length()) { return false }
            var result = _match_class(pattern, pi + 1, text.char_at(ti))
            var matched: Number = result[0]
            var new_pi: Number = result[1]
            if (matched != 1) {
                return false
            }
            pi = new_pi
            ti = ti + 1
        } else {
            // Literal character
            if (ti >= text.length()) { return false }
            if (pc != text.char_at(ti)) { return false }
            pi = pi + 1
            ti = ti + 1
        }
    }
    return ti >= text.length()
}

/// Check if a string matches a glob pattern.
/// Supports: * (any chars except /), ** (any chars including /),
/// ? (single char), [abc] (character class), [!abc] (negated class)
///
/// ```saffron
/// import "@glob" as Glob
/// Glob.matches("*.sf", "main.sf")         // true
/// Glob.matches("src/**/*.sf", "src/lib/path.sf")  // true
/// Glob.matches("test_?", "test_1")        // true
/// Glob.matches("[abc].txt", "b.txt")      // true
/// ```
fun matches(pattern: String, text: String): Bool {
    return _matches_from(pattern, 0, text, 0)
}

/// Split a glob pattern into its fixed prefix and dynamic suffix.
/// The prefix is the longest leading path that contains no glob characters.
/// Useful for optimizing directory traversal.
///
/// ```saffron
/// import "@glob" as Glob
/// Glob.split_prefix("src/lib/**/*.sf")   // ["src/lib", "**/*.sf"]
/// Glob.split_prefix("*.sf")             // [".", "*.sf"]
/// Glob.split_prefix("src/main.sf")      // ["src", "main.sf"]
/// ```
fun split_prefix(pattern: String): List<String> {
    var parts = pattern.split("/")
    var prefix_parts: List<String> = []
    var i = 0

    while (i < parts.length()) {
        var part: String = parts[i]
        // Check if this segment has any glob characters
        var has_glob = false
        var j = 0
        while (j < part.length()) {
            var c = part.char_at(j)
            if (c == "*" or c == "?" or c == "[") {
                has_glob = true
                break
            }
            j = j + 1
        }
        if (has_glob) {
            break
        }
        prefix_parts.push(part)
        i = i + 1
    }

    // Build the dynamic suffix from remaining parts
    var suffix_parts: List<String> = []
    while (i < parts.length()) {
        suffix_parts.push(parts[i])
        i = i + 1
    }

    var prefix = ""
    if (prefix_parts.length() > 0) {
        prefix = prefix_parts.join("/")
    } else {
        prefix = "."
    }

    var suffix = ""
    if (suffix_parts.length() > 0) {
        suffix = suffix_parts.join("/")
    } else {
        // No glob at all — split into dirname and basename
        if (prefix_parts.length() > 1) {
            suffix = prefix_parts[prefix_parts.length() - 1]
            prefix_parts.pop()
            prefix = prefix_parts.join("/")
        } else {
            suffix = prefix
            prefix = "."
        }
    }

    return [prefix, suffix]
}

/// Internal helper for .gitignore-style matching.
/// If pattern has no slash, match against basename only.
/// If pattern has a slash, match against the full path.
fun _ignore_matches(pattern: String, path: String): Bool {
    // Strip trailing slash (directory indicator)
    var pat = pattern
    if (pat.length() > 0 and pat.char_at(pat.length() - 1) == "/") {
        pat = pat.slice(0, pat.length() - 1)
    }

    // If pattern contains a slash, match against full path
    if (pat.contains("/")) {
        return matches(pat, path)
    }

    // Otherwise match against basename only
    var base = Path.basename(path)
    return matches(pat, base)
}

/// Find files matching a pattern under a specific base directory.
/// The pattern is matched against paths relative to the base directory.
///
/// ```saffron
/// import "@glob" as Glob
/// var configs = Glob.find_in("/etc", "**/*.conf")
/// ```
fun find_in(base: String, pattern: String): List<String> {
    // Optimize: use split_prefix to narrow the search directory
    var split = split_prefix(pattern)
    var prefix: String = split[0]
    var suffix: String = split[1]

    var search_dir = ""

    if (prefix == ".") {
        search_dir = base
    } else {
        search_dir = Path.join([base, prefix])
    }

    var results: List<String> = []
    var entries = IO.walk_dir(search_dir)
    var i = 0

    while (i < entries.length()) {
        var entry = entries[i]
        var root: String = entry[0]
        var file_list = entry[2]
        var j = 0

        while (j < file_list.length()) {
            var name: String = file_list[j]
            var full_path = Path.join([root, name])

            // Compute the relative path from the search dir
            var rel = ""
            if (search_dir == ".") {
                rel = full_path
                // Remove leading "./" if present
                if (rel.length() > 2 and rel.starts_with("./")) {
                    rel = rel.slice(2, rel.length())
                }
            } else {
                // Strip the search_dir prefix
                if (full_path.starts_with(search_dir)) {
                    var start = search_dir.length()
                    if (start < full_path.length() and full_path.char_at(start) == "/") {
                        start = start + 1
                    }
                    rel = full_path.slice(start, full_path.length())
                } else {
                    rel = full_path
                }
            }

            // Match the relative path against the glob suffix
            if (matches(suffix, rel)) {
                // Return path relative to base
                if (prefix == ".") {
                    results.push(rel)
                } else {
                    results.push(Path.join([prefix, rel]))
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return results
}

/// Find all files matching a glob pattern relative to the current directory.
/// Returns a list of relative paths that match the pattern.
///
/// ```saffron
/// import "@glob" as Glob
/// var sf_files = Glob.find("src/**/*.sf")
/// var tests = Glob.find("test/test_*.sf")
/// ```
fun find(pattern: String): List<String> {
    return find_in(".", pattern)
}

/// Check if a path should be ignored based on a list of glob patterns.
/// Matches the behavior of .gitignore: if any pattern matches, the path is ignored.
/// Patterns starting with ! negate a previous match.
///
/// ```saffron
/// import "@glob" as Glob
/// var patterns = ["*.log", "build/**", "!build/keep.txt"]
/// Glob.is_ignored("debug.log", patterns)      // true
/// Glob.is_ignored("src/main.sf", patterns)    // false
/// Glob.is_ignored("build/out.o", patterns)    // true
/// Glob.is_ignored("build/keep.txt", patterns) // false
/// ```
fun is_ignored(path: String, patterns: List<String>): Bool {
    var ignored = false
    var i = 0

    while (i < patterns.length()) {
        var pat: String = patterns[i]

        if (pat.length() == 0) {
            i = i + 1
            continue
        }

        // Handle negation patterns
        if (pat.char_at(0) == "!") {
            var neg_pat = pat.slice(1, pat.length())
            if (_ignore_matches(neg_pat, path)) {
                ignored = false
            }
        } else {
            if (_ignore_matches(pat, path)) {
                ignored = true
            }
        }
        i = i + 1
    }
    return ignored
}
