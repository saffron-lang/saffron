//! Float — 64-bit IEEE 754 double-precision floating point.
//! Wraps a raw f64 value (stored as i64 bits) and provides numeric methods.

@extern("i64 __float_to_string(i64)") private fun _float_to_string(val: Int): Int
@extern("double llvm.floor.f64(double)") private fun _llvm_floor(val: Float): Float
@extern("double llvm.ceil.f64(double)") private fun _llvm_ceil(val: Float): Float
@extern("double llvm.fabs.f64(double)") private fun _llvm_fabs(val: Float): Float
@extern("double llvm.sqrt.f64(double)") private fun _llvm_sqrt(val: Float): Float

/// The Float class — wraps a raw 64-bit double-precision float.
class Float {
    var _val: Float

    /// Convert this float to its string representation.
    fun to_string(): String {
        return _float_to_string(this._val)
    }

    /// Truncate this float to an integer (round toward zero).
    fun to_int(): Int {
        return this._val.floor()
    }

    /// Return the largest integer less than or equal to this value.
    fun floor(): Int {
        var f: Float = _llvm_floor(this._val)
        return f
    }

    /// Return the smallest integer greater than or equal to this value.
    fun ceil(): Int {
        var f: Float = _llvm_ceil(this._val)
        return f
    }

    /// Return the absolute value of this float.
    fun abs(): Float {
        return _llvm_fabs(this._val)
    }

    /// Return the square root of this float.
    fun sqrt(): Float {
        return _llvm_sqrt(this._val)
    }

    // --- Operator methods (Phase E preparation) ---

    /// Addition operator.
    @inline
    fun add(other: Float): Float { return this._val + other._val }

    /// Subtraction operator.
    @inline
    fun sub(other: Float): Float { return this._val - other._val }

    /// Multiplication operator.
    @inline
    fun mul(other: Float): Float { return this._val * other._val }

    /// Division operator.
    @inline
    fun div(other: Float): Float { return this._val / other._val }

    /// Modulo operator.
    @inline
    fun mod(other: Float): Float { return this._val % other._val }

    /// Less-than operator.
    @inline
    fun lt(other: Float): Bool { return this._val < other._val }

    /// Greater-than operator.
    @inline
    fun gt(other: Float): Bool { return this._val > other._val }

    /// Equality operator.
    @inline
    fun eq(other: Float): Bool { return this._val == other._val }
}
