//! HTTP/1.1 client built on the non-blocking socket layer.
//! Supports GET, POST, PUT, DELETE with headers, body, redirects, and TLS.
//!
//! ```saffron
//! import "@http" as Http
//!
//! var resp = Http.get("https://api.example.com/users")
//! IO.println(resp.status)  // 200
//! IO.println(resp.body)    // response body
//!
//! var data = Http.post_json("https://api.example.com/users", {"name": "alice"})
//! ```

import "@url" as URL
import "@json" as JSON

// ---------------------------------------------------------------------------
// Response
// ---------------------------------------------------------------------------

/// An HTTP response.
class Response {
    var status: Number
    var status_text: String
    var headers: Map<String, String>
    var body: String
    var url: String

    fun init(status: Number, status_text: String, headers: Map<String, String>, body: String, url: String) {
        this.status = status
        this.status_text = status_text
        this.headers = headers
        this.body = body
        this.url = url
    }

    /// True if the status code is 2xx.
    fun ok(): Bool {
        return this.status >= 200 and this.status < 300
    }

    /// Parse the body as JSON.
    fun json() {
        return JSON.parse(this.body)
    }

    /// Get a header value (case-insensitive).
    fun header(name: String): String {
        var lower = name.to_lower()
        var keys = this.headers.keys()
        var i = 0
        while (i < keys.length()) {
            if (keys[i].to_lower() == lower) {
                return this.headers.get(keys[i])
            }
            i = i + 1
        }
        return ""
    }
}

// ---------------------------------------------------------------------------
// Request options
// ---------------------------------------------------------------------------

/// Configuration for an HTTP request.
class RequestOptions {
    var method: String
    var url: String
    var headers: Map<String, String>
    var body: String
    var timeout: Number
    var follow_redirects: Bool
    var max_redirects: Number

    fun init(method: String, url: String) {
        this.method = method
        this.url = url
        this.headers = {}
        this.body = ""
        this.timeout = 30000
        this.follow_redirects = true
        this.max_redirects = 10
    }
}

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

/// Perform a full HTTP request with options.
///
/// ```saffron
/// import "@http" as Http
///
/// var opts = Http.RequestOptions("POST", "https://api.example.com/data")
/// opts.headers.set("Content-Type", "application/json")
/// opts.body = "{\"key\": \"value\"}"
/// var resp = Http.request(opts)
/// ```
fun request(opts: RequestOptions): Response {
    return _do_request(opts, 0)
}

/// Perform a GET request.
///
/// ```saffron
/// import "@http" as Http
/// var resp = Http.get("https://example.com")
/// IO.println(resp.status)
/// ```
fun get(url: String): Response {
    var opts = RequestOptions("GET", url)
    return request(opts)
}

/// Perform a GET request with custom headers.
fun get_with_headers(url: String, headers: Map<String, String>): Response {
    var opts = RequestOptions("GET", url)
    opts.headers = headers
    return request(opts)
}

/// Perform a POST request with a string body.
///
/// ```saffron
/// import "@http" as Http
/// var resp = Http.post("https://api.example.com/data", "raw body content")
/// ```
fun post(url: String, body: String): Response {
    var opts = RequestOptions("POST", url)
    opts.body = body
    if (!(opts.headers.has("Content-Type"))) {
        opts.headers.set("Content-Type", "text/plain")
    }
    return request(opts)
}

/// Perform a POST request with a JSON body.
///
/// ```saffron
/// import "@http" as Http
/// var resp = Http.post_json("https://api.example.com/users", {"name": "alice", "age": 30})
/// ```
fun post_json(url: String, data): Response {
    var opts = RequestOptions("POST", url)
    opts.body = JSON.to_string(data)
    opts.headers.set("Content-Type", "application/json")
    return request(opts)
}

/// Perform a PUT request with a string body.
fun put(url: String, body: String): Response {
    var opts = RequestOptions("PUT", url)
    opts.body = body
    return request(opts)
}

/// Perform a PUT request with a JSON body.
fun put_json(url: String, data): Response {
    var opts = RequestOptions("PUT", url)
    opts.body = JSON.to_string(data)
    opts.headers.set("Content-Type", "application/json")
    return request(opts)
}

/// Perform a DELETE request.
fun delete(url: String): Response {
    var opts = RequestOptions("DELETE", url)
    return request(opts)
}

/// Perform a PATCH request with a JSON body.
fun patch_json(url: String, data): Response {
    var opts = RequestOptions("PATCH", url)
    opts.body = JSON.to_string(data)
    opts.headers.set("Content-Type", "application/json")
    return request(opts)
}

/// GET a URL and parse the response body as JSON.
///
/// ```saffron
/// import "@http" as Http
/// var users = Http.get_json("https://api.example.com/users")
/// ```
fun get_json(url: String) {
    var resp = get(url)
    if (!(resp.ok())) {
        throw "http: GET ${url} returned ${resp.status}"
    }
    return resp.json()
}

/// Download a URL to a file path. Returns true on success.
///
/// ```saffron
/// import "@http" as Http
/// Http.download("https://example.com/archive.tar.gz", "archive.tar.gz")
/// ```
fun download(url: String, dest_path: String): Bool {
    var resp = get(url)
    if (!(resp.ok())) {
        return false
    }
    IO.write_file(dest_path, resp.body)
    return true
}

// ---------------------------------------------------------------------------
// Internal: HTTP/1.1 protocol implementation
// ---------------------------------------------------------------------------

fun _do_request(opts: RequestOptions, redirect_count: Number): Response {
    if (redirect_count > opts.max_redirects) {
        throw "http: too many redirects (max ${opts.max_redirects})"
    }

    var parsed = URL.parse(opts.url)
    var host = parsed.host
    var port = URL.effective_port(parsed)
    var use_tls = (parsed.scheme == "https")

    // Connect
    var socket = _connect(host, port, use_tls)

    // Build request
    var request_line = _build_request(opts, parsed, host, port)

    // Send
    socket.write(request_line)

    // Read response
    var raw_response = _read_response(socket)
    socket.close()

    // Parse response
    var response = _parse_response(raw_response, opts.url)

    // Handle redirects
    if (opts.follow_redirects and _is_redirect(response.status)) {
        var location = response.header("Location")
        if (location == "") {
            throw "http: redirect with no Location header"
        }
        // Resolve relative redirects
        if (!(location.contains("://"))) {
            location = URL.join(opts.url, location)
        }
        var new_opts = RequestOptions(opts.method, location)
        new_opts.headers = opts.headers
        new_opts.body = opts.body
        new_opts.timeout = opts.timeout
        new_opts.follow_redirects = opts.follow_redirects
        new_opts.max_redirects = opts.max_redirects
        // POST redirects become GET (303, or 301/302 in practice)
        if (response.status == 303 or ((response.status == 301 or response.status == 302) and opts.method == "POST")) {
            new_opts.method = "GET"
            new_opts.body = ""
        }
        return _do_request(new_opts, redirect_count + 1)
    }

    return response
}

fun _connect(host: String, port: Number, use_tls: Bool): Socket {
    // RUNTIME: This calls into the socket layer
    // When the bootstrapped runtime is fully wired:
    //   if (use_tls) { return Socket.connect_tls(host, port) }
    //   else { return Socket.connect(host, port) }
    //
    // For now, this is the interface contract:
    if (use_tls) {
        return _socket_connect_tls(host, port)
    }
    return _socket_connect(host, port)
}

fun _socket_connect(host: String, port: Number): Socket {
    // EXTERNAL: connects to host:port via TCP
    // Returns a Socket instance
    throw "http: socket layer not yet wired — cannot connect to ${host}:${port}"
}

fun _socket_connect_tls(host: String, port: Number): Socket {
    // EXTERNAL: connects to host:port via TCP+TLS
    // Returns a Socket instance
    throw "http: socket layer not yet wired — cannot connect (TLS) to ${host}:${port}"
}

/// A minimal Socket interface matching the runtime socket.
/// This will be replaced by importing the actual runtime Socket once wired.
class Socket {
    var _connected: Bool

    fun init() {
        this._connected = true
    }

    fun write(data: String): Number {
        // EXTERNAL: write data to socket
        return data.length()
    }

    fun read(n: Number): String {
        // EXTERNAL: read up to n bytes
        return ""
    }

    fun read_all(): String {
        // EXTERNAL: read until connection closes
        return ""
    }

    fun close() {
        this._connected = false
    }
}

fun _build_request(opts: RequestOptions, parsed: URL.URL, host: String, port: Number): String {
    var path = parsed.path
    if (path == "") { path = "/" }
    if (parsed.query != "") {
        path = path + "?" + parsed.query
    }

    var lines: List<String> = []
    lines.push("${opts.method} ${path} HTTP/1.1")

    // Host header
    var host_header = host
    var default_port = URL.effective_port(parsed)
    if (port != 80 and port != 443 and parsed.port > 0) {
        host_header = "${host}:${port}"
    }
    lines.push("Host: ${host_header}")

    // Content-Length for bodies
    if (opts.body.length() > 0) {
        lines.push("Content-Length: ${opts.body.length()}")
    }

    // Connection: close (we don't do keep-alive yet)
    lines.push("Connection: close")

    // User-Agent
    if (!(opts.headers.has("User-Agent"))) {
        lines.push("User-Agent: saffron-http/1.0")
    }

    // Custom headers
    var keys = opts.headers.keys()
    var i = 0
    while (i < keys.length()) {
        var k = keys[i]
        lines.push("${k}: ${opts.headers.get(k)}")
        i = i + 1
    }

    // End of headers
    lines.push("")

    // Body
    if (opts.body.length() > 0) {
        lines.push(opts.body)
    } else {
        lines.push("")
    }

    return _join_crlf(lines)
}

fun _read_response(socket: Socket): String {
    // Read all data until connection closes
    // HTTP/1.1 with Connection: close means server closes after response
    var buf = ""
    var chunk = socket.read_all()
    return chunk
}

fun _parse_response(raw: String, request_url: String): Response {
    // Split headers from body on \r\n\r\n
    var header_end = raw.index_of("\r\n\r\n")
    if (header_end < 0) {
        // Try \n\n as fallback
        header_end = raw.index_of("\n\n")
        if (header_end < 0) {
            throw "http: malformed response — no header/body separator"
        }
        var header_section = raw.slice(0, header_end)
        var body = raw.slice(header_end + 2, raw.length())
        return _parse_header_section(header_section, body, request_url, "\n")
    }

    var header_section = raw.slice(0, header_end)
    var body = raw.slice(header_end + 4, raw.length())
    return _parse_header_section(header_section, body, request_url, "\r\n")
}

fun _parse_header_section(header_section: String, body: String, request_url: String, line_sep: String): Response {
    var lines = header_section.split(line_sep)
    if (lines.length() == 0) {
        throw "http: empty response"
    }

    // Parse status line: "HTTP/1.1 200 OK"
    var status_line = lines[0]
    var first_space = status_line.index_of(" ")
    if (first_space < 0) {
        throw "http: malformed status line"
    }
    var after_version = status_line.slice(first_space + 1, status_line.length())
    var second_space = after_version.index_of(" ")
    var status_code = 0
    var status_text = ""
    if (second_space >= 0) {
        status_code = after_version.slice(0, second_space).to_number()
        status_text = after_version.slice(second_space + 1, after_version.length())
    } else {
        status_code = after_version.to_number()
    }

    // Parse headers
    var headers: Map<String, String> = {}
    var i = 1
    while (i < lines.length()) {
        var line = lines[i]
        var colon = line.index_of(":")
        if (colon > 0) {
            var key = line.slice(0, colon).trim()
            var value = line.slice(colon + 1, line.length()).trim()
            headers.set(key, value)
        }
        i = i + 1
    }

    // Handle chunked transfer encoding
    var final_body = body
    var te = ""
    if (headers.has("Transfer-Encoding")) {
        te = headers.get("Transfer-Encoding")
    }
    if (te.to_lower().contains("chunked")) {
        final_body = _decode_chunked(body)
    }

    return Response(status_code, status_text, headers, final_body, request_url)
}

fun _decode_chunked(body: String): String {
    var result = ""
    var pos = 0
    while (pos < body.length()) {
        // Find end of chunk size line
        var line_end = _index_of_from(body, "\r\n", pos)
        if (line_end < 0) {
            line_end = _index_of_from(body, "\n", pos)
            if (line_end < 0) { break }
        }

        var size_str = body.slice(pos, line_end).trim()
        if (size_str == "" or size_str == "0") { break }

        var chunk_size = _parse_hex(size_str)
        if (chunk_size <= 0) { break }

        var data_start = line_end + 2
        if (body.char_at(line_end) == "\n") {
            data_start = line_end + 1
        }

        var data_end = data_start + chunk_size
        if (data_end > body.length()) { data_end = body.length() }
        result = result + body.slice(data_start, data_end)

        pos = data_end + 2  // skip trailing \r\n after chunk
    }
    return result
}

fun _parse_hex(s: String): Number {
    var hex_chars = "0123456789abcdef"
    var result = 0
    var i = 0
    while (i < s.length()) {
        var c = s.char_at(i).to_lower()
        var val = hex_chars.index_of(c)
        if (val < 0) { break }
        result = result * 16 + val
        i = i + 1
    }
    return result
}

fun _index_of_from(s: String, sub: String, start: Number): Number {
    var remaining = s.slice(start, s.length())
    var idx = remaining.index_of(sub)
    if (idx < 0) { return -1 }
    return start + idx
}

fun _is_redirect(status: Number): Bool {
    return status == 301 or status == 302 or status == 303 or status == 307 or status == 308
}

fun _join_crlf(lines: List<String>): String {
    var result = ""
    var i = 0
    while (i < lines.length()) {
        if (i > 0) {
            result = result + "\r\n"
        }
        result = result + lines[i]
        i = i + 1
    }
    return result
}
