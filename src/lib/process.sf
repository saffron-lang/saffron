//! Full subprocess control — spawn, stream, and manage child processes.
//!
//! Provides Python-like subprocess support with full pipe control over stdin,
//! stdout, and stderr. Built on posix_spawn via native C runtime.
//!
//! ```saffron
//! import "@process" as Process
//!
//! // Simple run (captures output)
//! var result = Process.run("ls -la")
//! if (result.success) {
//!     IO.println(result.stdout)
//! } else {
//!     IO.println("failed (exit ${result.exit_code}): ${result.stderr}")
//! }
//!
//! // Live process with pipe access
//! var proc = Process.open("cat")
//! proc.stdin.write("hello world\n")
//! proc.stdin.close()
//! var output = proc.stdout.read_all()
//! proc.wait()
//!
//! // Real-time output streaming
//! var proc2 = Process.open("ping -c 3 localhost")
//! while (proc2.is_alive()) {
//!     var data = proc2.stdout.read_available()
//!     if (data.length() > 0) { IO.print(data) }
//! }
//! IO.print(proc2.stdout.read_all())
//! ```

import "os" as OS

// =============================================================================
// FFI declarations — native process primitives (process_native.c)
// =============================================================================

@extern("i64 sf_process_spawn(i8*, i8*, i8*, i8*, i64)") fun _spawn(program: String, argv: Int, envp: Int, cwd: String, flags: Int): Int
@extern("i64 sf_process_write_stdin(i64, i8*, i64)") fun _write_stdin(handle: Int, data: Int, len: Int): Int
@extern("i64 sf_process_read_stdout(i64, i8*, i64)") fun _read_stdout(handle: Int, buf: Int, max_len: Int): Int
@extern("i64 sf_process_read_stderr(i64, i8*, i64)") fun _read_stderr(handle: Int, buf: Int, max_len: Int): Int
@extern("i64 sf_process_read_nonblock(i64, i64, i8*, i64)") fun _read_nonblock(handle: Int, stream: Int, buf: Int, max_len: Int): Int
@extern("i64 sf_process_poll(i64)") fun _poll(handle: Int): Int
@extern("i64 sf_process_wait(i64)") fun _wait(handle: Int): Int
@extern("void sf_process_kill(i64, i64)") fun _kill(handle: Int, signal: Int)
@extern("void sf_process_close(i64)") fun _close(handle: Int)
@extern("void sf_process_close_stdin(i64)") fun _close_stdin(handle: Int)
@extern("i64 sf_process_pid(i64)") fun _pid(handle: Int): Int

// Memory management
@extern("void* malloc(i64)") fun _proc_malloc(size: Int): Int
@extern("void free(void*)") fun _proc_free(ptr: Int)
@extern("i64 strlen(void*)") fun _proc_strlen(s: Int): Int

// Intrinsic for null-termination
@intrinsic fun store8(addr: Int, val: Int)
@intrinsic fun load8(addr: Int): Int

// =============================================================================
// Constants
// =============================================================================

var _PIPE_STDIN: Int = 1
var _PIPE_STDOUT: Int = 2
var _PIPE_STDERR: Int = 4
var _SHELL: Int = 8
var _BUF_SIZE: Int = 8192

// =============================================================================
// ProcessResult — the outcome of a completed process
// =============================================================================

/// Result of a completed process, containing stdout, stderr, and exit code.
class ProcessResult {
    var stdout: String
    var stderr: String
    var exit_code: Int
    var success: Bool

    fun init(stdout: String, stderr: String, exit_code: Int) {
        this.stdout = stdout
        this.stderr = stderr
        this.exit_code = exit_code
        this.success = (exit_code == 0)
    }

    /// Return a human-readable summary of the result.
    fun to_string(): String {
        if (this.success) {
            return "ProcessResult(ok, stdout=${this.stdout.length()} bytes)"
        }
        return "ProcessResult(exit=${this.exit_code}, stderr=${this.stderr.length()} bytes)"
    }
}

// =============================================================================
// ProcessPipe — read/write handle to a child process pipe
// =============================================================================

/// A pipe endpoint for communicating with a child process.
/// Wraps a native process handle + stream direction.
class ProcessPipe {
    var _handle: Int
    var _stream: Int   // 0=stdin(write), 1=stdout(read), 2=stderr(read)
    var _closed: Bool

    fun init(handle: Int, stream: Int) {
        this._handle = handle
        this._stream = stream
        this._closed = false
    }

    /// Write data to the pipe (only valid for stdin pipes).
    /// Returns the number of bytes written.
    fun write(data: String): Int {
        if (this._closed) { throw "ProcessPipe: write to closed pipe" }
        if (this._stream != 0) { throw "ProcessPipe: cannot write to a read pipe" }
        var ptr: Int = data
        var len: Int = _proc_strlen(ptr)
        if (len == 0) { return 0 }
        var written: Int = _write_stdin(this._handle, ptr, len)
        if (written < 0) { throw "ProcessPipe: write failed" }
        return written
    }

    /// Blocking read up to max_bytes from the pipe.
    /// Returns the data read as a string. Returns empty string on EOF.
    fun read(max_bytes: Int): String {
        if (this._closed) { return "" }
        if (this._stream == 0) { throw "ProcessPipe: cannot read from a write pipe" }

        var buf: Int = _proc_malloc(max_bytes + 1)
        var n: Int = 0
        if (this._stream == 1) {
            n = _read_stdout(this._handle, buf, max_bytes)
        } else {
            n = _read_stderr(this._handle, buf, max_bytes)
        }

        if (n <= 0) {
            _proc_free(buf)
            return ""
        }
        store8(buf + n, 0)
        return buf
    }

    /// Read until a newline character is found. Returns the line including newline.
    /// Returns empty string on EOF.
    fun read_line(): String {
        if (this._closed) { return "" }
        if (this._stream == 0) { throw "ProcessPipe: cannot read from a write pipe" }

        var result: String = ""
        var one_buf: Int = _proc_malloc(2)
        while (true) {
            var n: Int = 0
            if (this._stream == 1) {
                n = _read_stdout(this._handle, one_buf, 1)
            } else {
                n = _read_stderr(this._handle, one_buf, 1)
            }
            if (n <= 0) { break }
            store8(one_buf + 1, 0)
            var ch: String = one_buf
            result = result + ch
            if (ch == "\n") { break }
        }
        _proc_free(one_buf)
        return result
    }

    /// Read all remaining data until EOF. Blocks until the pipe closes.
    fun read_all(): String {
        if (this._closed) { return "" }
        if (this._stream == 0) { throw "ProcessPipe: cannot read from a write pipe" }

        var result: String = ""
        var buf: Int = _proc_malloc(_BUF_SIZE + 1)
        while (true) {
            var n: Int = 0
            if (this._stream == 1) {
                n = _read_stdout(this._handle, buf, _BUF_SIZE)
            } else {
                n = _read_stderr(this._handle, buf, _BUF_SIZE)
            }
            if (n <= 0) { break }
            store8(buf + n, 0)
            var chunk: String = buf
            result = result + chunk
        }
        _proc_free(buf)
        return result
    }

    /// Non-blocking read: return whatever data is available right now.
    /// Returns empty string if no data is ready (does not block).
    fun read_available(): String {
        if (this._closed) { return "" }
        if (this._stream == 0) { throw "ProcessPipe: cannot read from a write pipe" }

        var buf: Int = _proc_malloc(_BUF_SIZE + 1)
        var n: Int = _read_nonblock(this._handle, this._stream, buf, _BUF_SIZE)
        if (n <= 0) {
            _proc_free(buf)
            return ""
        }
        store8(buf + n, 0)
        return buf
    }

    /// Close this pipe endpoint.
    fun close() {
        if (this._closed) { return }
        this._closed = true
        if (this._stream == 0) {
            _close_stdin(this._handle)
        }
        // stdout/stderr are closed when the handle is closed
    }
}

// =============================================================================
// Subprocess — a live child process with pipe access
// =============================================================================

/// A running child process with full pipe control.
/// Create via Process.open() or Process.open_args().
class Subprocess {
    var _handle: Int
    var pid: Int
    var stdin: ProcessPipe
    var stdout: ProcessPipe
    var stderr: ProcessPipe
    var returncode: Int

    fun init(handle: Int) {
        this._handle = handle
        this.pid = _pid(handle)
        this.stdin = ProcessPipe(handle, 0)
        this.stdout = ProcessPipe(handle, 1)
        this.stderr = ProcessPipe(handle, 2)
        this.returncode = -1
    }

    /// Check if the process has exited. Returns -1 if still running,
    /// otherwise returns the exit code.
    fun poll(): Int {
        var code: Int = _poll(this._handle)
        if (code >= 0) {
            this.returncode = code
        }
        return code
    }

    /// Block until the process exits. Returns the exit code.
    fun wait(): Int {
        var code: Int = _wait(this._handle)
        this.returncode = code
        return code
    }

    /// Send stdin data, close stdin, wait for exit, and return result.
    /// Like Python's Popen.communicate().
    fun communicate(input: String): ProcessResult {
        if (input.length() > 0) {
            this.stdin.write(input)
        }
        this.stdin.close()

        var out: String = this.stdout.read_all()
        var err: String = this.stderr.read_all()
        var code: Int = this.wait()

        return ProcessResult(out, err, code)
    }

    /// Send SIGKILL to the process.
    fun kill() {
        _kill(this._handle, 9)
    }

    /// Send SIGTERM to the process.
    fun terminate() {
        _kill(this._handle, 15)
    }

    /// Check if the process is still running.
    fun is_alive(): Bool {
        return this.poll() < 0
    }

    /// Close all pipes and release the handle.
    /// Call this when you're done with the process.
    fun close() {
        _close(this._handle)
    }

    /// Return a human-readable description.
    fun to_string(): String {
        return "Subprocess(pid=${this.pid}, returncode=${this.returncode})"
    }
}

// =============================================================================
// Internal helpers
// =============================================================================

/// Parse exit code from a string. Returns 0 if parsing fails.
fun _parse_exit_code(s: String): Int {
    if (s.length() == 0) { return 0 }
    try {
        return s.to_number()
    } catch (e) {
        return 0
    }
}

/// Escape a string for safe use in single-quoted shell context.
fun _escape_single_quotes(s: String): String {
    return s.replace("'", "'\\''")
}

/// Shell-escape a value by wrapping in single quotes.
fun _shell_escape(s: String): String {
    return "'" + _escape_single_quotes(s) + "'"
}

// =============================================================================
// Public API — Module-level functions
// =============================================================================

/// Run a command via the shell and wait for completion.
/// Returns a ProcessResult with stdout, stderr, and exit code.
///
/// This is the primary entry point for simple command execution.
/// Captures stdout and stderr, waits for exit.
///
/// ```saffron
/// var result = Process.run("cargo build 2>&1")
/// if (!result.success) {
///     IO.println("Build failed: ${result.stderr}")
/// }
/// ```
fun run(cmd: String): ProcessResult {
    // Use native subprocess with all pipes + shell mode
    var flags: Int = _PIPE_STDIN | _PIPE_STDOUT | _PIPE_STDERR | _SHELL
    var handle: Int = _spawn(cmd, 0, 0, "", flags)
    if (handle < 0) {
        return ProcessResult("", "process: failed to spawn command", -1)
    }
    var proc: Subprocess = Subprocess(handle)
    // Close stdin immediately (no input)
    proc.stdin.close()
    // Read all output
    var out: String = proc.stdout.read_all()
    var err: String = proc.stderr.read_all()
    var code: Int = proc.wait()
    proc.close()
    return ProcessResult(out, err, code)
}

/// Run a command with explicit arguments (no shell interpretation).
/// Safer than run() for user-provided input.
///
/// ```saffron
/// var result = Process.exec("git", ["commit", "-m", "my message with spaces"])
/// ```
fun exec(program: String, args: List<String>): ProcessResult {
    // Build a shell command with proper escaping
    var cmd: String = _shell_escape(program)
    var i: Int = 0
    while (i < args.length()) {
        cmd = cmd + " " + _shell_escape(args[i])
        i = i + 1
    }
    return run(cmd)
}

/// Open a subprocess with full pipe control (shell mode).
/// Returns immediately with a live Subprocess handle.
///
/// All three pipes (stdin, stdout, stderr) are connected.
/// The command is run through /bin/sh -c.
///
/// ```saffron
/// var proc = Process.open("cat")
/// proc.stdin.write("hello\n")
/// proc.stdin.close()
/// IO.println(proc.stdout.read_all())
/// proc.wait()
/// proc.close()
/// ```
fun open(cmd: String): Subprocess {
    var flags: Int = _PIPE_STDIN | _PIPE_STDOUT | _PIPE_STDERR | _SHELL
    var handle: Int = _spawn(cmd, 0, 0, "", flags)
    if (handle < 0) {
        throw "process: failed to spawn: ${cmd}"
    }
    return Subprocess(handle)
}

/// Open a subprocess with a specific working directory.
///
/// ```saffron
/// var proc = Process.open_in("ls -la", "/tmp")
/// IO.print(proc.stdout.read_all())
/// proc.wait()
/// proc.close()
/// ```
fun open_in(cmd: String, cwd: String): Subprocess {
    var flags: Int = _PIPE_STDIN | _PIPE_STDOUT | _PIPE_STDERR | _SHELL
    var handle: Int = _spawn(cmd, 0, 0, cwd, flags)
    if (handle < 0) {
        throw "process: failed to spawn: ${cmd}"
    }
    return Subprocess(handle)
}

/// Open a subprocess with explicit arguments (no shell).
/// Uses posix_spawnp to search PATH for the program.
///
/// ```saffron
/// var proc = Process.open_args("grep", ["-r", "TODO", "src/"])
/// IO.print(proc.stdout.read_all())
/// proc.wait()
/// proc.close()
/// ```
fun open_args(program: String, args: List<String>): Subprocess {
    // For non-shell mode, build a shell-escaped command and use shell mode
    // because passing argv arrays through the FFI boundary is complex.
    // This gives us proper argument separation via shell quoting.
    var cmd: String = _shell_escape(program)
    var i: Int = 0
    while (i < args.length()) {
        cmd = cmd + " " + _shell_escape(args[i])
        i = i + 1
    }
    var flags: Int = _PIPE_STDIN | _PIPE_STDOUT | _PIPE_STDERR | _SHELL
    var handle: Int = _spawn(cmd, 0, 0, "", flags)
    if (handle < 0) {
        throw "process: failed to spawn: ${program}"
    }
    return Subprocess(handle)
}

/// Run a command and return just its stdout.
/// Throws on non-zero exit code (like Python's subprocess.check_output).
///
/// ```saffron
/// var output = Process.check_output("git rev-parse HEAD")
/// IO.println(output.trim())
/// ```
fun check_output(cmd: String): String {
    var result: ProcessResult = run(cmd)
    if (!result.success) {
        var msg: String = "process: command failed (exit ${result.exit_code}): ${cmd}"
        if (result.stderr.length() > 0) {
            msg = msg + "\n" + result.stderr
        }
        throw msg
    }
    return result.stdout
}

/// Run a command and return the exit code.
/// Throws on non-zero exit code (like Python's subprocess.check_call).
///
/// ```saffron
/// Process.check_call("make test")
/// ```
fun check_call(cmd: String): Int {
    var result: ProcessResult = run(cmd)
    if (!result.success) {
        var msg: String = "process: command failed (exit ${result.exit_code}): ${cmd}"
        if (result.stderr.length() > 0) {
            msg = msg + "\n" + result.stderr
        }
        throw msg
    }
    return result.exit_code
}

/// Spawn a background process (shell mode, no pipes).
/// Returns immediately with a Subprocess handle for monitoring/killing.
/// stdout and stderr go to /dev/null unless you read from the pipes.
///
/// ```saffron
/// var server = Process.spawn("python3 -m http.server 8080")
/// // ... do work ...
/// server.terminate()
/// server.wait()
/// server.close()
/// ```
fun spawn(cmd: String): Subprocess {
    // Use only stdout/stderr pipes (no stdin needed for background)
    var flags: Int = _PIPE_STDOUT | _PIPE_STDERR | _SHELL
    var handle: Int = _spawn(cmd, 0, 0, "", flags)
    if (handle < 0) {
        throw "process: failed to spawn: ${cmd}"
    }
    return Subprocess(handle)
}

/// Run a command and return just the exit code (does not throw).
///
/// ```saffron
/// var code = Process.status("test -f pantry.toml")
/// if (code == 0) { IO.println("file exists") }
/// ```
fun status(cmd: String): Int {
    var result: ProcessResult = run(cmd)
    return result.exit_code
}

/// Run a command, abort if it fails (non-zero exit).
/// Throws an error containing stderr on failure.
///
/// ```saffron
/// Process.run_or_fail("saffron build src/main.sf -o build/app")
/// ```
fun run_or_fail(cmd: String): ProcessResult {
    var result: ProcessResult = run(cmd)
    if (!result.success) {
        var msg: String = "process: command failed (exit ${result.exit_code}): ${cmd}"
        if (result.stderr.length() > 0) {
            msg = msg + "\n" + result.stderr
        }
        throw msg
    }
    return result
}

/// Run a command with additional environment variables.
/// The provided env map is exported before running the command.
///
/// ```saffron
/// var result = Process.run_with_env("node server.js", {"PORT": "3000", "DEBUG": "true"})
/// ```
fun run_with_env(cmd: String, env: Map<String, String>): ProcessResult {
    var exports: String = ""
    var keys: List<String> = env.keys()
    var i: Int = 0
    while (i < keys.length()) {
        var k: String = "" + keys[i]
        var v: String = "" + env.get(k)
        exports = exports + "export " + k + "='" + _escape_single_quotes(v) + "'; "
        i = i + 1
    }
    return run(exports + cmd)
}

/// Run a command in a specific working directory.
///
/// ```saffron
/// var result = Process.run_in("npm install", "../frontend")
/// ```
fun run_in(cmd: String, dir: String): ProcessResult {
    var flags: Int = _PIPE_STDIN | _PIPE_STDOUT | _PIPE_STDERR | _SHELL
    var handle: Int = _spawn(cmd, 0, 0, dir, flags)
    if (handle < 0) {
        return ProcessResult("", "process: failed to spawn in dir: ${dir}", -1)
    }
    var proc: Subprocess = Subprocess(handle)
    proc.stdin.close()
    var out: String = proc.stdout.read_all()
    var err: String = proc.stderr.read_all()
    var code: Int = proc.wait()
    proc.close()
    return ProcessResult(out, err, code)
}

/// Pipe: run the first command, feed its stdout as stdin to the second.
///
/// ```saffron
/// var result = Process.pipe("cat data.txt", "grep error")
/// ```
fun pipe(cmd1: String, cmd2: String): ProcessResult {
    return run("${cmd1} | ${cmd2}")
}

/// Check if a program is available on PATH.
/// Returns the full path if found, or an empty string if not.
///
/// ```saffron
/// if (Process.which("git") != "") {
///     IO.println("git is available")
/// }
/// ```
fun which(program: String): String {
    var result: ProcessResult = run("which " + _shell_escape(program) + " 2>/dev/null")
    if (result.success) {
        return result.stdout.trim()
    }
    return ""
}
