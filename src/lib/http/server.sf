//! HTTP/1.1 server with async I/O and streaming support.
//!
//! ```saffron
//! import "@http/server" as Http
//!
//! var app = Http.server(8080)
//!
//! app.get("/", fun (req) => Response.html("<h1>Hello!</h1>"))
//!
//! app.get("/api/users", fun (req) =>
//!     Response.json("{\"users\": []}")
//!         .header("Cache-Control", "max-age=60"))
//!
//! app.get("/events", fun (req) =>
//!     Response.event_stream(fun (send) => {
//!         while (true) {
//!             send("heartbeat")
//!             Async.sleep(5.0)
//!         }
//!     }))
//!
//! app.serve()
//! ```

import "@net" as Net
import "@async" as Async
import "@path" as Path
import "@ssl" as SSL
import "@io" as FileIO

// Byte-exact socket write. `Net.TcpConnection.write` takes a `String` and sizes
// it with `strlen`, so it cannot send a body containing an interior NUL byte —
// it stops at the first one. These bind the socket primitives directly so a
// response body can be written from an explicit (pointer, length) pair.
@extern("i64 sf_tcp_write(i64, i8*, i64)") private fun _srv_tcp_write(fd: Int, buf: Int, len: Int): Int
@extern("i64 sf_tls_write(i64, i8*, i64)") private fun _srv_tls_write(handle: Int, buf: Int, len: Int): Int
@intrinsic fun __suspend(reason: Int, arg: Int)

/// Default cap on a single request (headers + body). Requests larger than this
/// are answered 413 and the connection is closed, instead of being parsed
/// truncated. Override per-server with `app.max_request_bytes`.
var DEFAULT_MAX_REQUEST_BYTES: Int = 8388608

// =============================================================================
// Byte-exact writing
// =============================================================================

/// Write exactly `len` bytes from `ptr` to a plain (non-TLS) connection,
/// suspending on EWOULDBLOCK. Unlike a String write this never consults
/// `strlen`, so NUL bytes inside the range are sent like any other byte.
private fun _write_bytes_plain(handle: Int, ptr: Int, len: Int): Int {
    var fd: Int = handle & 0xFFFFFFFF
    var written: Int = 0
    while (written < len) {
        var n: Int = _srv_tcp_write(fd, ptr + written, len - written)
        if (n > 0) {
            written = written + n
        } else if (n == -1) {
            __suspend(4, fd)
        } else {
            break
        }
    }
    return written
}

/// Byte-exact counterpart for a TLS connection. `handle` is the packed
/// `fd | (tls_handle << 32)` used throughout @net / @ssl.
private fun _write_bytes_tls(handle: Int, ptr: Int, len: Int): Int {
    var fd: Int = handle & 0xFFFFFFFF
    var tls: Int = handle >> 32
    var written: Int = 0
    while (written < len) {
        var n: Int = _srv_tls_write(tls, ptr + written, len - written)
        if (n > 0) {
            written = written + n
        } else if (n == -1) {
            __suspend(4, fd)
        } else {
            break
        }
    }
    return written
}

// =============================================================================
// Request
// =============================================================================

class Stream {
    private var _conn: Net.TcpConnection
    internal var _tls_conn: Any
    private var _headers_sent: Bool
    private var _extra_headers: List<String>
    private var _extra_values: List<String>

    fun init(conn: Net.TcpConnection) {
        this._conn = conn
        this._tls_conn = nil
        this._headers_sent = false
        this._extra_headers = []
        this._extra_values = []
    }

    fun header(name: String, value: String): Stream {
        this._extra_headers.push(name)
        this._extra_values.push(value)
        return this
    }

    private fun _write_raw(data: String) {
        if (this._tls_conn != nil) {
            this._tls_conn.write(data)
        } else {
            this._conn.write(data)
        }
    }

    private fun _send_headers() {
        if (this._headers_sent) { return }
        this._headers_sent = true
        var sb = StringBuilder()
        sb.append("HTTP/1.1 200 OK\r\n")
        sb.append("Content-Type: text/event-stream\r\n")
        sb.append("Cache-Control: no-cache\r\n")
        sb.append("Connection: keep-alive\r\n")
        var i = 0
        while (i < this._extra_headers.length()) {
            sb.append(this._extra_headers[i])
            sb.append(": ")
            sb.append(this._extra_values[i])
            sb.append("\r\n")
            i = i + 1
        }
        sb.append("\r\n")
        this._write_raw(sb.to_string())
    }

    fun send(data: String) {
        this._send_headers()
        this._write_raw("data: " + data + "\n\n")
    }

    fun send_event(event: String, data: String) {
        this._send_headers()
        this._write_raw("event: " + event + "\ndata: " + data + "\n\n")
    }

    fun write(raw: String) {
        this._send_headers()
        this._write_raw(raw)
    }

    fun close() {
        if (this._tls_conn != nil) {
            this._tls_conn.close()
        } else {
            this._conn.close()
        }
    }
}

class Request {
    var method: String
    var path: String
    var headers: Map<String, String>
    var body: String
    var query: String
    var params: Map<String, String>
    var context: Map<String, String>
    internal var _conn: Net.TcpConnection
    internal var _tls_conn: Any

    fun init(method: String, path: String, headers: Map<String, String>, body: String, query: String) {
        this.method = method
        this.path = path
        this.headers = headers
        this.body = body
        this.query = query
        this.params = {}
        this.context = {}
        this._conn = nil
        this._tls_conn = nil
    }

    fun param(name: String): String {
        return this.params.get(name)
    }

    fun header(name: String): String {
        var lower = name.to_lower()
        var keys = this.headers.keys()
        var i = 0
        while (i < keys.length()) {
            if (keys[i].to_lower() == lower) {
                return this.headers.get(keys[i])
            }
            i = i + 1
        }
        return ""
    }

    fun stream(handler: Fun): Response {
        var s = Stream(this._conn)
        s._tls_conn = this._tls_conn
        handler(s)
        s.close()
        // Return a sentinel response that tells _handle not to write/close
        var resp = Response(0, "")
        resp._is_stream = true
        return resp
    }
}

// =============================================================================
// Response — immutable builder pattern
// =============================================================================

class Response {
    var status: Int
    var status_text: String
    internal var _headers: List<String>
    internal var _header_values: List<String>
    var body: String
    internal var _is_stream: Bool
    internal var _stream_fn: Fun
    /// Byte-exact body, set instead of `body` for binary content. When non-nil
    /// this takes precedence: `Content-Length` comes from `_body_bytes.length()`
    /// and the payload is written straight from its pointer, so interior NUL
    /// bytes survive. `body` stays "" in that case, since a String simply cannot
    /// hold the content (see BUGS #66).
    internal var _body_bytes: FileIO.Bytes

    fun init(status: Int, body: String) {
        this.status = status
        this.status_text = "OK"
        if (status == 404) { this.status_text = "Not Found" }
        if (status == 500) { this.status_text = "Internal Server Error" }
        if (status == 301) { this.status_text = "Moved Permanently" }
        if (status == 302) { this.status_text = "Found" }
        if (status == 413) { this.status_text = "Payload Too Large" }
        if (status == 400) { this.status_text = "Bad Request" }
        this._headers = []
        this._header_values = []
        this.body = body
        this._is_stream = false
        this._stream_fn = fun () => {}
        this._body_bytes = nil
    }

    fun header(name: String, value: String): Response {
        this._headers.push(name)
        this._header_values.push(value)
        return this
    }

    fun status_code(code: Int): Response {
        this.status = code
        return this
    }

    /// Replace the body with a byte-exact payload. Use for any content that may
    /// contain a NUL byte (wasm, images, gzip); a String body would truncate.
    fun bytes(data: FileIO.Bytes): Response {
        this._body_bytes = data
        this.body = ""
        return this
    }

    /// Body length in bytes — the value that goes in `Content-Length`. Reads the
    /// byte body's real length when present, and falls back to the String
    /// body's `strlen` otherwise.
    fun body_length(): Int {
        if (this._body_bytes != nil) {
            return this._body_bytes.length()
        }
        return this.body.length()
    }
}

// --- Response builders ---

fun text(body: String): Response {
    return Response(200, body).header("Content-Type", "text/plain; charset=utf-8")
}

fun html(body: String): Response {
    return Response(200, body).header("Content-Type", "text/html; charset=utf-8")
}

fun json(body: String): Response {
    return Response(200, body).header("Content-Type", "application/json")
}

fun file(content: String, mime: String): Response {
    return Response(200, content).header("Content-Type", mime)
}

/// Build a 200 response with a byte-exact body. Use this for any content that
/// may contain a NUL byte — `file()` takes a String and would truncate.
///
/// ```saffron
/// import "@io" as FileIO
/// var wasm = FileIO.read_file_bytes("app.wasm")
/// return Http.file_bytes(wasm, "application/wasm")
/// ```
fun file_bytes(content: FileIO.Bytes, mime: String): Response {
    return Response(200, "").bytes(content).header("Content-Type", mime)
}

fun redirect(url: String): Response {
    return Response(302, "").header("Location", url)
}

fun not_found(): Response {
    return Response(404, "Not Found").header("Content-Type", "text/plain")
}

fun error(message: String): Response {
    return Response(500, message).header("Content-Type", "text/plain")
}

fun event_stream(handler: Fun): Response {
    var resp = Response(200, "")
    resp._is_stream = true
    resp._stream_fn = handler
    resp = resp.header("Content-Type", "text/event-stream")
    resp = resp.header("Cache-Control", "no-cache")
    resp = resp.header("Connection", "keep-alive")
    return resp
}

// =============================================================================
// Internal — HTTP serialization
// =============================================================================

/// Serialize the status line and headers, up to and including the blank line
/// that ends the header block. The body is written separately by
/// `_write_response`, because a byte body cannot pass through a StringBuilder.
internal fun _serialize_headers(resp: Response): String {
    var sb = StringBuilder()
    sb.append("HTTP/1.1 ")
    sb.append(resp.status.to_string())
    sb.append(" ")
    sb.append(resp.status_text)
    sb.append("\r\n")
    // Content-Length (only for non-stream). Uses body_length(), which reports
    // the byte body's true length when one is set — resp.body.length() would be
    // a strlen and truncate at the first NUL.
    if (!resp._is_stream) {
        sb.append("Content-Length: ")
        sb.append(resp.body_length().to_string())
        sb.append("\r\n")
    }
    // Custom headers
    var i = 0
    while (i < resp._headers.length()) {
        sb.append(resp._headers[i])
        sb.append(": ")
        sb.append(resp._header_values[i])
        sb.append("\r\n")
        i = i + 1
    }
    if (!resp._is_stream) {
        sb.append("Connection: close\r\n")
    }
    sb.append("\r\n")
    return sb.to_string()
}

/// Serialize a full response into a single String.
///
/// Retained for callers that want the bytes in hand (and for tests). NOTE: this
/// is lossy for a byte body — a String cannot represent interior NUL bytes, so
/// the payload truncates. Use `_write_response` to actually send a response.
internal fun _serialize_response(resp: Response): String {
    var head: String = _serialize_headers(resp)
    if (resp._is_stream) {
        return head
    }
    return head + resp.body
}

/// Write a complete response to a connection: headers as a String, then the body
/// byte-exactly. This is the only correct way to send a binary body — it writes
/// from the byte body's (pointer, length) pair rather than handing a String to
/// `strlen`.
private fun _write_response(conn: Net.TcpConnection, tls_conn: Any, resp: Response) {
    var head: String = _serialize_headers(resp)
    if (tls_conn != nil) {
        tls_conn.write(head)
    } else {
        conn.write(head)
    }
    if (resp._is_stream) {
        return
    }
    if (resp._body_bytes != nil) {
        var len: Int = resp._body_bytes.length()
        if (len > 0) {
            if (tls_conn != nil) {
                var packed: Int = tls_conn.fd | (tls_conn.tls_handle << 32)
                _write_bytes_tls(packed, resp._body_bytes.ptr(), len)
            } else {
                _write_bytes_plain(conn._handle, resp._body_bytes.ptr(), len)
            }
        }
    } else {
        if (resp.body.length() > 0) {
            if (tls_conn != nil) {
                tls_conn.write(resp.body)
            } else {
                conn.write(resp.body)
            }
        }
    }
}

// =============================================================================
// Router
// =============================================================================

class Route {
    var method: String
    var path: String
    var handler: Fun

    fun init(method: String, path: String, handler: Fun) {
        this.method = method
        this.path = path
        this.handler = handler
    }
}

private fun _match_route(pattern: String, path: String): Map<String, String> {
    var pattern_parts: List<String> = pattern.split("/")
    var path_parts: List<String> = path.split("/")
    if (pattern_parts.length() != path_parts.length()) {
        return nil
    }
    var params: Map<String, String> = {}
    var i: Int = 0
    while (i < pattern_parts.length()) {
        var pat: String = pattern_parts[i]
        var seg: String = path_parts[i]
        if (pat.length() > 0 and pat.slice(0, 1) == ":") {
            var name: String = pat.slice(1, pat.length())
            params.set(name, seg)
        } else {
            if (pat != seg) {
                return nil
            }
        }
        i = i + 1
    }
    return params
}

class App {
    var host: String
    var port: Int
    var routes: List<Route>
    private var _middlewares: List<Fun>
    private var _after_middlewares: List<Fun>
    private var _tls_ctx: Any
    /// Maximum accepted request size (headers + body) in bytes. A request that
    /// exceeds it is answered 413 rather than parsed truncated. Enforced while
    /// reading, which is the only place it can be enforced — an application-level
    /// check runs after the request has already been (mis)parsed.
    var max_request_bytes: Int

    fun init(port: Int) {
        this.host = "0.0.0.0"
        this.port = port
        this.routes = []
        this._middlewares = []
        this._after_middlewares = []
        this._tls_ctx = nil
        this.max_request_bytes = DEFAULT_MAX_REQUEST_BYTES
    }

    /// Enable TLS on this server. Pass a SSL.Context created via SSL.server_context().
    /// When set, all accepted connections will be wrapped with TLS before processing.
    fun tls(ctx: SSL.Context) {
        this._tls_ctx = ctx
    }

    /// Register a middleware that runs before route handlers.
    /// The middleware receives a Request and returns either a Response
    /// (to short-circuit) or nil (to continue to the next middleware/handler).
    fun use(middleware: Fun) {
        this._middlewares.push(middleware)
    }

    /// Register an after-response middleware that can modify the response.
    /// The function receives (Request, Response) and must return a Response.
    fun after(middleware: Fun) {
        this._after_middlewares.push(middleware)
    }

    fun get(path: String, handler: Fun) {
        this.routes.push(Route("GET", path, handler))
    }

    fun post(path: String, handler: Fun) {
        this.routes.push(Route("POST", path, handler))
    }

    fun put(path: String, handler: Fun) {
        this.routes.push(Route("PUT", path, handler))
    }

    fun delete(path: String, handler: Fun) {
        this.routes.push(Route("DELETE", path, handler))
    }

    fun all(path: String, handler: Fun) {
        this.routes.push(Route("*", path, handler))
    }

    fun serve() {
        var bind_host: String = this.host
        var bind_port: Int = this.port
        var listener: Net.TcpListener = Net.listen(bind_host, bind_port)
        var proto: String = "http"
        if (this._tls_ctx != nil) {
            proto = "https"
        }
        IO.println("Listening on " + proto + "://" + bind_host + ":" + bind_port.to_string())
        while (true) {
            var conn: Net.TcpConnection = listener.accept()
            var app = this
            Task.spawn(fun () => app._handle(conn))
        }
    }

    private fun _handle(conn: Net.TcpConnection) {
        var tls_conn: Any = nil

        // If TLS is configured, perform the TLS handshake
        if (this._tls_ctx != nil) {
            try {
                tls_conn = SSL.wrap_server(conn.raw_fd(), this._tls_ctx)
            } catch (e) {
                IO.println("TLS handshake failed: " + e.to_string())
                conn.close()
                return
            }
        }

        // Read the request: drain until the header block is complete, then read
        // exactly Content-Length more bytes. See _read_request for why a single
        // read (or a single retry) is not enough.
        var rr: _RawRequest = this._read_request(conn, tls_conn)

        if (rr.too_large) {
            var big: Response = Response(413, "request too large")
            big = big.header("Content-Type", "text/plain")
            _write_response(conn, tls_conn, big)
            if (tls_conn != nil) {
                tls_conn.close()
            } else {
                conn.close()
            }
            return
        }

        if (rr.raw.length() == 0) {
            if (tls_conn != nil) {
                tls_conn.close()
            } else {
                conn.close()
            }
            return
        }

        var req: Request = _parse_request(rr.raw)

        // A short read is now an explicit error rather than a silent truncated
        // parse: answer 400 instead of handing the application a partial body.
        if (rr.incomplete) {
            var bad: Response = Response(400, "incomplete request body")
            bad = bad.header("Content-Type", "text/plain")
            _write_response(conn, tls_conn, bad)
            if (tls_conn != nil) {
                tls_conn.close()
            } else {
                conn.close()
            }
            return
        }

        req._conn = conn
        req._tls_conn = tls_conn

        // Run before-middlewares in order
        var resp: Response = nil
        try {
            resp = this._run_middlewares(req)
            if (resp == nil) {
                // No middleware short-circuited, proceed to route matching
                resp = this._route(req)
            }

            // Run after-middlewares on the response (skip for streams)
            if (!resp._is_stream) {
                resp = this._run_after_middlewares(req, resp)
            }
        } catch (e) {
            resp = Response(500, "{\"error\":\"internal server error\"}")
            resp = resp.header("Content-Type", "application/json")
        }

        if (resp._is_stream) {
            // For streams with TLS, set the TLS connection on the stream
            // (handled via req.stream which creates a Stream with _tls_conn)
        } else {
            _write_response(conn, tls_conn, resp)
            if (tls_conn != nil) {
                tls_conn.close()
            } else {
                conn.close()
            }
        }
    }

    /// Read one complete HTTP request off the connection.
    ///
    /// Two things the old single `conn.read(8192)` could not do:
    ///
    /// 1. **Drain.** `Net._raw_read` returns after its *first* successful
    ///    `recv` (it `break`s on `n > 0`, net.sf:102), so one call yields at most
    ///    one TCP segment regardless of the size asked for. The previous code
    ///    then did exactly one retry, which covered a body spanning two segments
    ///    and no more — that is why ~8-32 KB happened to work on loopback and
    ///    larger bodies did not. This loops until the headers are in hand and
    ///    then until Content-Length bytes of body have actually arrived.
    /// 2. **Detect a short read.** Truncation was indistinguishable from a
    ///    complete request. Here a body that never reaches Content-Length sets
    ///    `incomplete`, and the caller answers 400 instead of handing the
    ///    application a half body.
    ///
    /// The size cap is enforced here, while reading, so it can actually fire.
    private fun _read_request(conn: Net.TcpConnection, tls_conn: Any): _RawRequest {
        var out: _RawRequest = _RawRequest()
        var chunk_size: Int = 65536
        var buf: String = ""
        var limit: Int = this.max_request_bytes

        // Phase 1: read until the end of the header block ("\r\n\r\n").
        var header_end: Int = -1
        while (header_end < 0) {
            var chunk: String = ""
            if (tls_conn != nil) {
                chunk = tls_conn.read(chunk_size)
            } else {
                chunk = conn.read(chunk_size)
            }
            if (chunk.length() == 0) {
                // EOF. Either a bare connection probe (buf empty) or headers
                // that never terminated.
                out.raw = buf
                if (buf.length() > 0) {
                    out.incomplete = true
                }
                return out
            }
            buf = buf + chunk
            if (buf.length() > limit) {
                out.too_large = true
                return out
            }
            header_end = buf.index_of("\r\n\r\n")
        }

        var body_start: Int = header_end + 4
        var head: String = buf.slice(0, body_start)
        var have_body: Int = buf.length() - body_start

        // Phase 2: read exactly Content-Length more body bytes.
        var content_length: Int = _content_length_of(head)
        if (content_length > limit) {
            out.too_large = true
            return out
        }
        while (have_body < content_length) {
            var want: Int = content_length - have_body
            if (want > chunk_size) { want = chunk_size }
            var more: String = ""
            if (tls_conn != nil) {
                more = tls_conn.read(want)
            } else {
                more = conn.read(want)
            }
            if (more.length() == 0) {
                // Peer stopped sending before Content-Length was satisfied.
                out.raw = buf
                out.incomplete = true
                return out
            }
            buf = buf + more
            have_body = buf.length() - body_start
            if (buf.length() > limit) {
                out.too_large = true
                return out
            }
        }

        out.raw = buf
        return out
    }

    private fun _run_middlewares(req: Request): Response {
        var i: Int = 0
        while (i < this._middlewares.length()) {
            var mw: Fun = this._middlewares[i]
            var result: Response = mw(req)
            if (result != nil) {
                return result
            }
            i = i + 1
        }
        return nil
    }

    private fun _run_after_middlewares(req: Request, resp: Response): Response {
        var i: Int = 0
        var current: Response = resp
        while (i < this._after_middlewares.length()) {
            var mw: Fun = this._after_middlewares[i]
            current = mw(req, current)
            i = i + 1
        }
        return current
    }

    private fun _route(req: Request): Response {
        // First pass: exact matches take priority
        var i: Int = 0
        while (i < this.routes.length()) {
            var route: Route = this.routes[i]
            if ((route.method == req.method or route.method == "*") and (route.path == req.path or route.path == "*")) {
                var h: Fun = route.handler
                return h(req)
            }
            i = i + 1
        }
        // Second pass: parameterized route matching
        i = 0
        while (i < this.routes.length()) {
            var route: Route = this.routes[i]
            if (route.method == req.method or route.method == "*") {
                var matched: Map<String, String> = _match_route(route.path, req.path)
                if (matched != nil) {
                    var keys: List<String> = matched.keys()
                    var k: Int = 0
                    while (k < keys.length()) {
                        req.params.set(keys[k], matched.get(keys[k]))
                        k = k + 1
                    }
                    var h: Fun = route.handler
                    return h(req)
                }
            }
            i = i + 1
        }
        return not_found()
    }
}

// =============================================================================
// Constructor
// =============================================================================

fun server(port: Int): App {
    return App(port)
}

/// Create a server with TLS enabled.
/// Shorthand for creating an App and calling .tls() on it.
///
/// ```saffron
/// import "@http/server" as Http
/// import "@ssl" as SSL
///
/// var tls_ctx = SSL.server_context({"cert": "cert.pem", "key": "key.pem"})
/// var app = Http.server_tls(443, tls_ctx)
/// app.get("/") { req => Http.text("Hello over HTTPS!") }
/// app.serve()
/// ```
fun server_tls(port: Int, tls_ctx: SSL.Context): App {
    var app = App(port)
    app.tls(tls_ctx)
    return app
}

/// Create a server with a receiver-closure configuration block.
/// The block receives the App as implicit `this` (once receiver closures land).
/// For now, uses explicit callback parameter.
///
/// ```saffron
/// var app = Http.configure(3000) { app =>
///     app.use(Http.cors())
///     app.use(Http.logger())
///     app.get("/api/hello") { req =>
///         Http.json("{\"message\": \"world\"}")
///     }
/// }
/// app.serve()
/// ```
fun configure(port: Int, setup: Fun): App {
    var app: App = App(port)
    setup(app)
    return app
}

// Alias for backward compat
fun create(port: Int): App {
    return App(port)
}

// =============================================================================
// Middleware helpers
// =============================================================================

/// CORS middleware that allows all origins.
/// Adds Access-Control-Allow-Origin, Methods, and Headers to every response.
/// Handles OPTIONS preflight requests with a 204 short-circuit.
fun cors(): Fun {
    return fun (req: Request): Response {
        if (req.method == "OPTIONS") {
            return Response(204, "")
                .header("Access-Control-Allow-Origin", "*")
                .header("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
                .header("Access-Control-Allow-Headers", "Content-Type, Authorization")
                .header("Access-Control-Max-Age", "86400")
        }
        return nil
    }
}

/// After-response middleware that adds CORS headers to every response.
/// Use with app.after(cors_headers()) for non-preflight responses.
fun cors_headers(): Fun {
    return fun (req: Request, resp: Response): Response {
        resp.header("Access-Control-Allow-Origin", "*")
        resp.header("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
        resp.header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        return resp
    }
}

/// Logging middleware that prints method + path for each request.
/// Always returns nil (never short-circuits).
fun logger(): Fun {
    return fun (req: Request): Response {
        IO.println(req.method + " " + req.path)
        return nil
    }
}

/// Static file serving middleware.
/// Maps URLs with the given prefix to files in the given directory.
/// Returns nil (falls through) if the file does not exist.
fun static_files(url_prefix: String, dir: String): Fun {
    return fun (req: Request): Response {
        if (req.method != "GET") {
            return nil
        }
        // Check if path starts with the url_prefix
        if (req.path.length() < url_prefix.length()) {
            return nil
        }
        if (req.path.slice(0, url_prefix.length()) != url_prefix) {
            return nil
        }
        // Extract the relative file path after the prefix
        var rel: String = req.path.slice(url_prefix.length(), req.path.length())
        if (rel.length() == 0) {
            rel = "index.html"
        }
        if (rel.slice(0, 1) == "/") {
            rel = rel.slice(1, rel.length())
        }
        // Prevent directory traversal
        if (rel.contains("..")) {
            return nil
        }
        // Build full filesystem path
        var full_path: String = Path.join([dir, rel])
        if (!IO.file_exists(full_path)) {
            return nil
        }
        // Read byte-exactly, not via IO.read_file: a String body strlen-truncates
        // at the first NUL, which served every wasm module as 0 bytes (BUGS #66).
        var content: FileIO.Bytes = FileIO.read_file_bytes(full_path)
        var mime: String = _guess_mime(full_path)
        return file_bytes(content, mime)
    }
}

private fun _guess_mime(path: String): String {
    if (path.ends_with(".html")) { return "text/html" }
    if (path.ends_with(".js")) { return "application/javascript" }
    if (path.ends_with(".css")) { return "text/css" }
    if (path.ends_with(".wasm")) { return "application/wasm" }
    if (path.ends_with(".json")) { return "application/json" }
    if (path.ends_with(".sf")) { return "text/plain" }
    if (path.ends_with(".png")) { return "image/png" }
    if (path.ends_with(".jpg")) { return "image/jpeg" }
    if (path.ends_with(".svg")) { return "image/svg+xml" }
    if (path.ends_with(".ico")) { return "image/x-icon" }
    if (path.ends_with(".txt")) { return "text/plain" }
    return "application/octet-stream"
}

// =============================================================================
// Request parsing
// =============================================================================

/// Result of draining one request off a socket: the raw bytes plus whether the
/// read ended badly. `incomplete` means the peer stopped before Content-Length
/// was satisfied; `too_large` means the request exceeded max_request_bytes.
class _RawRequest {
    var raw: String
    var incomplete: Bool
    var too_large: Bool

    fun init() {
        this.raw = ""
        this.incomplete = false
        this.too_large = false
    }
}

/// Parse Content-Length out of a raw header block. Returns 0 when absent.
/// Case-insensitive on the field name, as HTTP requires.
internal fun _content_length_of(head: String): Int {
    var lines: List<String> = head.split("\r\n")
    var i: Int = 1
    while (i < lines.length()) {
        var line: String = lines[i]
        var colon: Int = line.index_of(":")
        if (colon > 0) {
            var name: String = line.slice(0, colon).to_lower().trim()
            if (name == "content-length") {
                var value: String = line.slice(colon + 1, line.length()).trim()
                if (value.length() > 0) {
                    var n: Int = value.to_number()
                    if (n > 0) { return n }
                }
                return 0
            }
        }
        i = i + 1
    }
    return 0
}

private fun _parse_request(raw: String): Request {
    var lines: List<String> = raw.split("\r\n")
    if (lines.length() == 0) {
        return Request("GET", "/", {}, "", "")
    }
    var first_line: String = lines[0]
    var parts: List<String> = first_line.split(" ")
    var method: String = "GET"
    var full_path: String = "/"
    if (parts.length() >= 2) {
        method = parts[0]
        full_path = parts[1]
    }
    // Split path and query
    var path: String = full_path
    var query: String = ""
    var qidx = full_path.index_of("?")
    if (qidx >= 0) {
        path = full_path.slice(0, qidx)
        query = full_path.slice(qidx + 1, full_path.length())
    }
    // Parse headers
    var headers: Map<String, String> = {}
    var i = 1
    var body_start = lines.length()
    while (i < lines.length()) {
        if (lines[i].length() == 0) {
            body_start = i + 1
            i = lines.length()
        } else {
            var colon = lines[i].index_of(":")
            if (colon > 0) {
                var name = lines[i].slice(0, colon)
                var value = lines[i].slice(colon + 2, lines[i].length())
                headers.set(name, value)
            }
        }
        i = i + 1
    }
    // Body
    var body: String = ""
    if (body_start < lines.length()) {
        var body_lines: List<String> = []
        i = body_start
        while (i < lines.length()) {
            body_lines.push(lines[i])
            i = i + 1
        }
        body = body_lines.join("\r\n")
    }
    return Request(method, path, headers, body, query)
}
