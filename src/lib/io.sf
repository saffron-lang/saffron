//! IO module — standard input/output operations.
//! Available implicitly in every file as IO.println(), IO.read_file(), etc.
//!
//! Also provides the File class for incremental file I/O:
//!   var f = IO.open("data.txt", "r")
//!   var line = f.read_line()
//!   f.close()

@extern("i32 puts(void*)") private fun _puts(s: Int): Int
@extern("void __io_print_str(i64)") private fun _print_str(s: Int)
@extern("i64 __any_to_string(i64)") private fun _any_to_string(val: Int): Int
@extern("void __io_println_any(i64)") private fun _println_any(val: Int)

// --- C Library Bindings for File I/O ---

@extern("void* fopen(void*, void*)") private fun _fopen(path: Int, mode: Int): Int
@extern("i32 fclose(void*)") private fun _fclose(fp: Int): Int
@extern("i64 fread(void*, i64, i64, void*)") private fun _fread(buf: Int, size: Int, count: Int, fp: Int): Int
@extern("i64 fwrite(void*, i64, i64, void*)") private fun _fwrite(buf: Int, size: Int, count: Int, fp: Int): Int
@extern("i32 fseek(void*, i64, i32)") private fun _fseek(fp: Int, offset: Int, whence: Int): Int
@extern("i64 ftell(void*)") private fun _ftell(fp: Int): Int
@extern("void* fgets(void*, i32, void*)") private fun _fgets(buf: Int, size: Int, fp: Int): Int
@extern("i32 feof(void*)") private fun _feof(fp: Int): Int
@extern("i32 fflush(void*)") private fun _fflush(fp: Int): Int
@extern("void* malloc(i64)") private fun _io_malloc(size: Int): Int
@extern("void free(void*)") private fun _io_free(ptr: Int)
@extern("i64 strlen(void*)") private fun _io_strlen(s: Int): Int
@extern("void* memcpy(void*, void*, i64)") private fun _io_memcpy(dst: Int, src: Int, n: Int): Int

@intrinsic fun load8(addr: Int): Int
@intrinsic fun store8(addr: Int, val: Int)

// --- Byte-path stdio bindings ---
//
// Deliberately declared with an `i64` FILE* instead of `void*`, unlike the
// `_fopen`/`_fclose`/... group above. A `void*`-returning extern has its result
// NaN-box *pointer*-tagged, so the returned handle can never compare equal to
// the integer literal 0: `if (fp == 0)` compares TAG_PTR|0 against TAG_INT|0 and
// is unconditionally false, silently taking the success branch on a failed open.
// (`IO.open` has exactly that latent defect — see BUGS.) An `i64` return is
// tagged as an integer, so a genuine NULL compares equal to 0 as written.
@extern("i64 fopen(void*, void*)") private fun _b_fopen(path: Int, mode: Int): Int
@extern("i64 fclose(i64)") private fun _b_fclose(fp: Int): Int
@extern("i64 fseek(i64, i64, i64)") private fun _b_fseek(fp: Int, offset: Int, whence: Int): Int
@extern("i64 ftell(i64)") private fun _b_ftell(fp: Int): Int
@extern("i64 fread(void*, i64, i64, i64)") private fun _b_fread(buf: Int, size: Int, count: Int, fp: Int): Int
@extern("i64 fwrite(void*, i64, i64, i64)") private fun _b_fwrite(buf: Int, size: Int, count: Int, fp: Int): Int

// Seek whence constants (inlined to avoid duplicate globals when runtime imports io):
// 0 = 0, SEEK_CUR = 1, 2 = 2

// =============================================================================
// Bytes — a length-carrying raw byte range
// =============================================================================

/// A raw byte range: a heap pointer plus an explicit byte count.
///
/// This exists because a Saffron `String` is a NUL-terminated C string, so
/// `String.length()` is a `strlen` that stops at the first embedded NUL. Any
/// content with a 0 byte in it (a wasm module starts with `\0asm`, every PNG,
/// every gzip stream) is therefore unrepresentable as a `String` — the bytes are
/// in memory but the length is wrong. `Bytes` carries the length out of band so
/// the full range stays addressable.
///
/// The buffer is always allocated with one extra trailing NUL, so `ptr()` may
/// still be passed where a C string is expected — it will simply appear
/// truncated at the first interior 0 byte. Use `ptr()` together with `length()`
/// for anything that must see every byte (e.g. a socket write).
///
/// ```saffron
/// import "@io" as FileIO
///
/// var b = FileIO.read_file_bytes("app.wasm")
/// b.length()      // 19569 — the true size on disk
/// b.get(0)        // 0     — the leading NUL of the wasm magic
/// ```
class Bytes {
    private var _ptr: Int
    private var _len: Int

    /// Wrap an existing heap pointer and byte count. Takes ownership: the
    /// pointer must remain valid for the lifetime of this object and must have
    /// at least `len + 1` bytes allocated.
    fun init(ptr: Int, len: Int) {
        this._ptr = ptr
        this._len = len
    }

    /// Number of bytes in this range. Unlike `String.length()` this is exact
    /// even when the content contains interior NUL bytes.
    fun length(): Int {
        return this._len
    }

    /// Raw heap pointer to the first byte. Pair with `length()`.
    fun ptr(): Int {
        return this._ptr
    }

    /// Read the byte at `index` (0-255). Negative indices count from the end.
    fun get(index: Int): Int {
        var idx: Int = index
        if (idx < 0) { idx = idx + this._len }
        if (idx < 0 or idx >= this._len) {
            throw "IO.Bytes: index out of bounds"
        }
        // The `& 255` is load-bearing, not just a range clamp: the `load8`
        // intrinsic yields a raw untagged i64, and returning it directly leaks an
        // untagged value into NaN-boxed code, where it reads back as a denormal
        // double. Masking forces the result through integer arithmetic, which
        // re-tags it as an Int.
        return load8(this._ptr + idx) & 255
    }

    /// Overwrite the byte at `index`. Negative indices count from the end.
    fun set(index: Int, value: Int) {
        var idx: Int = index
        if (idx < 0) { idx = idx + this._len }
        if (idx < 0 or idx >= this._len) {
            throw "IO.Bytes: index out of bounds"
        }
        store8(this._ptr + idx, value & 255)
    }

    /// True when there are no bytes.
    fun is_empty(): Bool {
        return this._len == 0
    }

    /// Reinterpret the range as a String. Lossy whenever the content has an
    /// interior NUL — the result strlen-truncates there. Provided for text
    /// content that merely arrived through a byte path.
    fun to_string(): String {
        return this._ptr
    }

    /// Copy the bytes into a `List<Int>`. O(n) and allocation-heavy; intended
    /// for small ranges and for tests, not for whole files.
    fun to_list(): List<Int> {
        var out: List<Int> = []
        var i: Int = 0
        while (i < this._len) {
            // `& 255` re-tags the raw intrinsic result — see get().
            out.push(load8(this._ptr + i) & 255)
            i = i + 1
        }
        return out
    }
}

/// Allocate a zero-filled `Bytes` of the given size.
fun bytes_alloc(size: Int): Bytes {
    var n: Int = size
    if (n < 0) { n = 0 }
    var buf: Int = _io_malloc(n + 1)
    var i: Int = 0
    while (i < n) {
        store8(buf + i, 0)
        i = i + 1
    }
    store8(buf + n, 0)
    return Bytes(buf, n)
}

/// Copy a String's bytes (up to its NUL terminator) into a `Bytes`.
fun bytes_from_string(s: String): Bytes {
    var n: Int = _io_strlen(s)
    var buf: Int = _io_malloc(n + 1)
    _io_memcpy(buf, s, n)
    store8(buf + n, 0)
    return Bytes(buf, n)
}

// =============================================================================
// File class — wraps a C FILE* for incremental I/O
// =============================================================================

class File {
    private var _fp: Int
    private var _path: String
    private var _mode: String
    private var _closed: Bool

    fun init(fp: Int, path: String, mode: String) {
        this._fp = fp
        this._path = path
        this._mode = mode
        this._closed = false
    }

    /// Read up to max_bytes bytes from the file. Returns "" at EOF.
    fun read(max_bytes: Int): String {
        if (this._closed) {
            throw "IO: file is closed"
        }
        if (max_bytes <= 0) { return "" }
        var buf: Int = _io_malloc(max_bytes + 1)
        var n: Int = _fread(buf, 1, max_bytes, this._fp)
        store8(buf + n, 0)
        if (n == 0) {
            _io_free(buf)
            return ""
        }
        return buf
    }

    /// Read one line from the file (including trailing newline).
    /// Returns "" at EOF.
    fun read_line(): String {
        if (this._closed) {
            throw "IO: file is closed"
        }
        var buf_size: Int = 4096
        var buf: Int = _io_malloc(buf_size)
        var result: Int = _fgets(buf, buf_size, this._fp)
        if (result == 0) {
            _io_free(buf)
            return ""
        }
        return buf
    }

    /// Read the entire remaining content of the file as a string.
    fun read_all(): String {
        if (this._closed) {
            throw "IO: file is closed"
        }
        // Save current position, seek to end, compute remaining
        var cur: Int = _ftell(this._fp)
        _fseek(this._fp, 0, 2)
        var end: Int = _ftell(this._fp)
        _fseek(this._fp, cur, 0)
        var remaining: Int = end - cur
        if (remaining <= 0) { return "" }
        var buf: Int = _io_malloc(remaining + 1)
        var n: Int = _fread(buf, 1, remaining, this._fp)
        store8(buf + n, 0)
        return buf
    }

    /// Write a string to the file.
    fun write(data: String) {
        if (this._closed) {
            throw "IO: file is closed"
        }
        var len: Int = _io_strlen(data)
        if (len > 0) {
            _fwrite(data, 1, len, this._fp)
        }
    }

    /// Write a string followed by a newline to the file.
    fun write_line(data: String) {
        if (this._closed) {
            throw "IO: file is closed"
        }
        var len: Int = _io_strlen(data)
        if (len > 0) {
            _fwrite(data, 1, len, this._fp)
        }
        // Write newline
        var nl: Int = _io_malloc(2)
        store8(nl, 10)
        store8(nl + 1, 0)
        _fwrite(nl, 1, 1, this._fp)
        _io_free(nl)
    }

    /// Seek to a byte offset from the beginning of the file.
    fun seek(offset: Int) {
        if (this._closed) {
            throw "IO: file is closed"
        }
        _fseek(this._fp, offset, 0)
    }

    /// Seek to a byte offset from the end of the file.
    fun seek_end(offset: Int) {
        if (this._closed) {
            throw "IO: file is closed"
        }
        _fseek(this._fp, offset, 2)
    }

    /// Return the current byte offset in the file.
    fun tell(): Int {
        if (this._closed) {
            throw "IO: file is closed"
        }
        return _ftell(this._fp)
    }

    /// Rewind to the beginning of the file.
    fun rewind() {
        if (this._closed) {
            throw "IO: file is closed"
        }
        _fseek(this._fp, 0, 0)
    }

    /// Flush any buffered data to disk.
    fun flush() {
        if (this._closed) {
            throw "IO: file is closed"
        }
        _fflush(this._fp)
    }

    /// Close the file handle.
    fun close() {
        if (this._closed) { return }
        _fclose(this._fp)
        this._fp = 0
        this._closed = true
    }

    /// Return true if the file is still open.
    fun is_open(): Bool {
        return !this._closed
    }

    /// Return the path this file was opened with.
    fun path(): String {
        return this._path
    }

    /// Return the mode this file was opened with.
    fun mode(): String {
        return this._mode
    }

    /// Return the file size in bytes.
    /// Seeks to end and restores the current position.
    fun size(): Int {
        if (this._closed) {
            throw "IO: file is closed"
        }
        var cur: Int = _ftell(this._fp)
        _fseek(this._fp, 0, 2)
        var end: Int = _ftell(this._fp)
        _fseek(this._fp, cur, 0)
        return end
    }

    /// Return true if the file is at EOF.
    fun eof(): Bool {
        if (this._closed) { return true }
        return _feof(this._fp) != 0
    }
}

// =============================================================================
// File open function
// =============================================================================

/// Open a file at the given path with the given mode.
/// Modes: "r", "w", "a", "rb", "wb", "ab", "r+", "w+".
/// Throws if the file cannot be opened.
fun open(path: String, mode: String): File {
    var fp: Int = _fopen(path, mode)
    if (fp == 0) {
        throw "IO: cannot open file '${path}' with mode '${mode}'"
    }
    return File(fp, path, mode)
}

// =============================================================================
// Original convenience functions
// =============================================================================

/// Print a value followed by a newline to stdout.
/// Accepts Any type — runtime dispatch converts to string via __any_to_string.
///
/// Calls the runtime symbol by bare name rather than through the `_println_any`
/// extern above, and that is load-bearing. `__io_println_any` dispatches on the
/// argument's NaN-box tag, but every `i64` extern parameter is untagged on the
/// way out (`gen_extern_call`, deliberately — BUGS #24), so routing through the
/// extern stripped the very tag the callee reads. The tag bits then landed in
/// the payload and `println("hello")` printed `2.12529e-314`. The same held for
/// `print`. Only `println_str` can use an extern (`puts` is typed `void*`, so
/// it untags a pointer, which is correct).
fun println(value: Any) {
    __io_println(value)
}

/// Print a string followed by a newline to stdout (typed variant).
fun println_str(value: String) {
    _puts(value)
}

/// Print a value to stdout without a trailing newline.
fun print(value: String) {
    __io_print(value)
}

/// Read the entire contents of a file as a string.
///
/// WARNING: lossy for binary content. A String is NUL-terminated, so the
/// returned value's `length()` strlen-stops at the first 0 byte in the file —
/// a wasm module (magic `\0asm`) reads back as `""`. Use `read_file_bytes` for
/// anything that is not known to be NUL-free text.
fun read_file(path: String): String {
    return __io_read_file(path)
}

/// Read the entire contents of a file as raw bytes, NUL-safe.
///
/// Returns a `Bytes` whose `length()` is the true size on disk. This is the
/// byte-correct counterpart to `read_file`: it sizes the file first, then reads
/// exactly that many bytes, and carries the count out of band instead of
/// relying on a NUL terminator. Returns an empty `Bytes` if the file cannot be
/// opened.
///
/// Implemented on the `_b_*` stdio externs rather than on the runtime's
/// `__io_file_size` / `__io_read_binary`. That was originally forced — both were
/// absent from codegen's known-function table, so calling them from inside this
/// module got them module-prefix-mangled to `@io___io_file_size` and they failed
/// to link (BUGS #85, since fixed; `file_size` below calls the runtime directly).
/// It stays on the `_b_*` path because that path also carries the byte count out
/// of band, which is the point of this function.
fun read_file_bytes(path: String): Bytes {
    var n: Int = 0
    var buf: Int = _io_malloc(1)
    store8(buf, 0)
    var fp: Int = _b_fopen(path, "rb")
    if (fp != 0) {
        _b_fseek(fp, 0, 2)
        var size: Int = _b_ftell(fp)
        _b_fseek(fp, 0, 0)
        if (size > 0) {
            buf = _io_malloc(size + 1)
            n = _b_fread(buf, 1, size, fp)
            if (n < 0) { n = 0 }
            store8(buf + n, 0)
        }
        _b_fclose(fp)
    }
    return Bytes(buf, n)
}

/// Write raw bytes to a file, creating or overwriting it. NUL-safe.
fun write_file_bytes(path: String, data: Bytes) {
    var fp: Int = _b_fopen(path, "wb")
    if (fp == 0) {
        throw "IO: cannot open file '${path}' for writing"
    }
    if (data.length() > 0) {
        _b_fwrite(data.ptr(), 1, data.length(), fp)
    }
    _b_fclose(fp)
}

// Re-tag a raw i64 coming back from the runtime.
//
// `src/runtime/runtime.sf` is compiled with --identity-mode, where the tag
// helpers are no-ops, so an int-returning `__io_*` hands back an untagged i64
// into NaN-boxed value space (BUGS #23). It reads back as a subnormal double:
// `file_size` printed `5.43e-323` for an 11-byte file, and `file_exists` was
// `false` for a file that existed, because a raw `1` does not compare equal to
// a NaN-boxed `1`. Arithmetic forces the value back through the int path and
// re-tags it — the same trick `Bytes.get` uses with `& 255`, and the reason it
// is spelled as a call here rather than inlined at each site is so the next
// wrapper added does not silently omit it.
//
// This is a boundary patch, not a fix: BUGS #23 is that the runtime should tag
// on the way out. Remove this when it does.
private fun _retag(n: Int): Int {
    return n + 0
}

/// Get the size of a file in bytes. Returns 0 if the file doesn't exist.
fun file_size(path: String): Int {
    return _retag(__io_file_size(path))
}

/// Read a file as raw binary into a pre-allocated buffer.
/// Returns the number of bytes read.
fun read_binary(path: String, buf: Int, max_size: Int): Int {
    return _retag(__io_read_binary(path, buf, max_size))
}

/// Write content to a file, creating or overwriting it.
fun write_file(path: String, content: String) {
    __io_write_file(path, content)
}

/// Append content to a file, creating it if it doesn't exist.
fun append_file(path: String, content: String) {
    __io_append_file(path, content)
}

/// Return true if a file exists at the given path.
fun file_exists(path: String): Bool {
    return _retag(__io_file_exists(path)) == 1
}

/// Create a directory (and parents) at the given path.
fun mkdir(path: String) {
    __io_mkdir(path)
}

/// Walk a directory tree and return all file paths.
fun walk_dir(path: String): List<String> {
    return __io_walk_dir(path)
}

/// List the contents of a directory (alias for walk_dir).
fun list_dir(path: String): List<String> {
    return __io_walk_dir(path)
}

/// Return true if the path exists and is a directory.
///
/// A path that does not exist, or that exists as a regular file, is false — the
/// two are not distinguished. Use `file_exists` to tell them apart.
fun is_dir(path: String): Bool {
    return _retag(__io_is_dir(path)) == 1
}

/// Rename or move a file. Returns true on success.
///
/// Fails (returns false) across filesystems, since it is a `rename(2)`, not a
/// copy-then-delete.
fun rename(from: String, to: String): Bool {
    return _retag(__io_rename(from, to)) == 1
}

/// Delete a file. Returns true on success, false if it did not exist or could
/// not be removed.
fun delete_file(path: String): Bool {
    return _retag(__io_delete_file(path)) == 1
}

