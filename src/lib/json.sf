//! JSON parser and serializer — pure Saffron implementation.
import "@reflect" as Reflect

/// Parse a JSON string into native Saffron values (maps, lists, strings, numbers, bools, nil).
///
/// ```saffron
/// import "@json" as JSON
/// var data = JSON.parse("{\"name\": \"saffron\", \"version\": 1}")
/// data.get("name")     // "saffron"
/// data.get("version")  // 1
/// ```
fun parse(source: String): Any {
    var pos = 0

    fun peek(): String {
        if (pos >= source.length()) return ""
        return source.char_at(pos)
    }

    fun advance(): String {
        var c = source.char_at(pos)
        pos = pos + 1
        return c
    }

    fun skip_ws() {
        while (pos < source.length()) {
            var c = peek()
            if (c == " " or c == "\t" or c == "\n" or c == "\r") {
                pos = pos + 1
            } else {
                return nil
            }
        }
    }

    fun consume(c: String): Bool {
        if (peek() == c) {
            pos = pos + 1
            return true
        }
        return false
    }

    fun is_digit(c: String): Bool {
        return c == "0" or c == "1" or c == "2" or c == "3" or c == "4" or
               c == "5" or c == "6" or c == "7" or c == "8" or c == "9"
    }

    fun parse_string(): String {
        var result = ""
        while (pos < source.length()) {
            var c = advance()
            if (c == "\"") { return result }
            if (c == "\\") {
                var esc = advance()
                if (esc == "n") { result = result + "\n" }
                if (esc == "t") { result = result + "\t" }
                if (esc == "r") { result = result + "\r" }
                if (esc == "\\") { result = result + "\\" }
                if (esc == "\"") { result = result + "\"" }
                if (esc == "/") { result = result + "/" }
            } else {
                result = result + c
            }
        }
        return result
    }

    /// Convert a JSON number literal to Int or Float depending on its spelling.
    /// `to_number` is integer-only (it calls `atol`), so routing "3.5" through
    /// it silently yielded 3. Anything with a fraction or an exponent has to go
    /// through `to_float`; plain digit runs stay Int so they round-trip exactly.
    fun _number_of(text: String): Any {
        if (text.contains(".") or text.contains("e") or text.contains("E")) {
            return text.to_float()
        }
        return text.to_number()
    }

    fun parse_number(): Any {
        var start = pos - 1
        while (pos < source.length()) {
            var c = peek()
            if (is_digit(c) or c == "." or c == "e" or c == "E" or c == "+" or c == "-") {
                pos = pos + 1
            } else {
                return _number_of(source.slice(start, pos))
            }
        }
        return _number_of(source.slice(start, pos))
    }

    fun parse_value() {
        skip_ws()
        var c = advance()

        if (c == "\"") { return parse_string() }
        if (c == "t") { pos = pos + 3; return true }
        if (c == "f") { pos = pos + 4; return false }
        if (c == "n") { pos = pos + 3; return nil }
        if (c == "-" or is_digit(c)) { return parse_number() }

        if (c == "[") {
            var arr = []
            skip_ws()
            if (consume("]")) { return arr }
            var arr_done = false
            while (!arr_done) {
                skip_ws()
                arr.push(parse_value())
                skip_ws()
                if (consume("]")) { arr_done = true }
                else { consume(",") }
            }
            return arr
        }

        if (c == "{") {
            var map = Map()
            skip_ws()
            if (consume("}")) { return map }
            var map_done = false
            while (!map_done) {
                skip_ws()
                consume("\"")
                var key = parse_string()
                skip_ws()
                consume(":")
                skip_ws()
                var val = parse_value()
                map.set(key, val)
                skip_ws()
                if (consume("}")) { map_done = true }
                else { consume(",") }
            }
            return map
        }

        return nil
    }

    return parse_value()
}

/// Escape a string for safe inclusion in JSON output.
fun escape_string(str: String): String {
    var result = "\""
    var i = 0
    while (i < str.length()) {
        var c = str.char_at(i)
        if (c == "\"") { result = result + "\\\"" }
        else if (c == "\\") { result = result + "\\\\" }
        else if (c == "\n") { result = result + "\\n" }
        else if (c == "\t") { result = result + "\\t" }
        else if (c == "\r") { result = result + "\\r" }
        else { result = result + c }
        i = i + 1
    }
    return result + "\""
}

/// Serialize a value to a compact JSON string.
///
/// ```saffron
/// import "@json" as JSON
/// var data = {"name": "saffron", "tags": ["lang", "typed"]}
/// JSON.to_string(data)
/// // {"name":"saffron","tags":["lang","typed"]}
/// ```
fun to_string(value: Any): String {
    if (value == nil) { return "null" }
    if (value == true) { return "true" }
    if (value == false) { return "false" }
    if (value is Int or value is Float) { return Reflect.number_to_string(value) }
    if (value is String) { return escape_string(value) }

    if (value is List) {
        var result = "["
        var i = 0
        while (i < value.length()) {
            if (i > 0) { result = result + "," }
            result = result + to_string(value[i])
            i = i + 1
        }
        return result + "]"
    }

    if (value is Map) {
        var keys = value.keys()
        var result = "{"
        var i = 0
        while (i < keys.length()) {
            if (i > 0) { result = result + "," }
            result = result + to_string(keys[i]) + ":" + to_string(value.get(keys[i]))
            i = i + 1
        }
        return result + "}"
    }

    if (Reflect.is_instance(value)) {
        var fields = Reflect.fields(value)
        var keys = fields.keys()
        var result = "{"
        var i = 0
        while (i < keys.length()) {
            if (i > 0) { result = result + "," }
            result = result + to_string(keys[i]) + ":" + to_string(fields.get(keys[i]))
            i = i + 1
        }
        return result + "}"
    }

    return "null"
}

/// Parse JSON and construct an instance of the given class from the result.
///
/// ```saffron
/// import "@json" as JSON
/// var config = JSON.parse(IO.read_file("config.json"))
/// var port = config.get("port")
/// ```
fun parse_into(klass: Any, source: String): Any {
    var parsed = parse(source)
    return Reflect.construct(klass, parsed)
}

/// Serialize a value to a pretty-printed JSON string with indentation.
///
/// ```saffron
/// import "@json" as JSON
/// IO.println(JSON.pretty({"name": "saffron"}))
/// // {
/// //   "name": "saffron"
/// // }
/// ```
fun pretty(value: Any): String {
    fun pad(depth: Number): String {
        return "  ".repeat(depth)
    }

    fun fmt(val: Any, depth: Number): String {
        if (val == nil) { return "null" }
        if (val == true) { return "true" }
        if (val == false) { return "false" }
        if (val is Int or val is Float) { return Reflect.number_to_string(val) }
        if (val is String) { return escape_string(val) }

        if (val is List) {
            if (val.length() == 0) { return "[]" }
            var result = "[\n"
            var i = 0
            while (i < val.length()) {
                if (i > 0) { result = result + ",\n" }
                result = result + pad(depth + 1) + fmt(val[i], depth + 1)
                i = i + 1
            }
            return result + "\n" + pad(depth) + "]"
        }

        if (val is Map) {
            var keys = val.keys()
            if (keys.length() == 0) { return "{}" }
            var result = "{\n"
            var i = 0
            while (i < keys.length()) {
                if (i > 0) { result = result + ",\n" }
                result = result + pad(depth + 1) + escape_string(keys[i]) + ": " + fmt(val.get(keys[i]), depth + 1)
                i = i + 1
            }
            return result + "\n" + pad(depth) + "}"
        }

        if (Reflect.is_instance(val)) {
            var fields = Reflect.fields(val)
            var keys = fields.keys()
            if (keys.length() == 0) { return "{}" }
            var result = "{\n"
            var i = 0
            while (i < keys.length()) {
                if (i > 0) { result = result + ",\n" }
                result = result + pad(depth + 1) + escape_string(keys[i]) + ": " + fmt(fields.get(keys[i]), depth + 1)
                i = i + 1
            }
            return result + "\n" + pad(depth) + "}"
        }

        return "null"
    }

    return fmt(value, 0)
}
