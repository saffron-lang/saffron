// Iterator utilities — works with any type that has .iter(), .next(), .next?()
// Lists and Maps both provide native .iter() methods.

fun map(iterable: Any, func: Any) {
    var result = []
    var iter = iterable.iter()
    while (iter.next?()) {
        result.push(func(iter.next()))
    }
    return result
}

fun filter(iterable: Any, func: Any) {
    var result = []
    var iter = iterable.iter()
    while (iter.next?()) {
        var item = iter.next()
        if (func(item)) {
            result.push(item)
        }
    }
    return result
}

fun reduce(iterable: Any, func: Any, initial: Any) {
    var acc = initial
    var iter = iterable.iter()
    while (iter.next?()) {
        acc = func(acc, iter.next())
    }
    return acc
}

fun sum(iterable: Any) {
    return reduce(iterable, fun (a, b) => a + b, 0)
}

fun any(iterable: Any, func: Any) {
    var iter = iterable.iter()
    while (iter.next?()) {
        if (func(iter.next())) { return true }
    }
    return false
}

fun all(iterable: Any, func: Any) {
    var iter = iterable.iter()
    while (iter.next?()) {
        if (!func(iter.next())) { return false }
    }
    return true
}

fun each(iterable: Any, func: Any) {
    var iter = iterable.iter()
    while (iter.next?()) {
        func(iter.next())
    }
}

fun count(iterable: Any, func: Any) {
    var n = 0
    var iter = iterable.iter()
    while (iter.next?()) {
        if (func(iter.next())) { n = n + 1 }
    }
    return n
}

fun find(iterable: Any, func: Any) {
    var iter = iterable.iter()
    while (iter.next?()) {
        var item = iter.next()
        if (func(item)) { return item }
    }
    return nil
}

fun flat_map(iterable: Any, func: Any) {
    var result = []
    var iter = iterable.iter()
    while (iter.next?()) {
        var items = func(iter.next())
        var inner = items.iter()
        while (inner.next?()) {
            result.push(inner.next())
        }
    }
    return result
}

fun zip(a: Any, b: Any) {
    var result = []
    var iter_a = a.iter()
    var iter_b = b.iter()
    while (iter_a.next?() and iter_b.next?()) {
        result.push([iter_a.next(), iter_b.next()])
    }
    return result
}

fun enumerate(iterable: Any) {
    var result = []
    var iter = iterable.iter()
    var i = 0
    while (iter.next?()) {
        result.push([i, iter.next()])
        i = i + 1
    }
    return result
}

fun take(iterable: Any, n: Number) {
    var result = []
    var iter = iterable.iter()
    var i = 0
    while (i < n and iter.next?()) {
        result.push(iter.next())
        i = i + 1
    }
    return result
}

fun skip(iterable: Any, n: Number) {
    var result = []
    var iter = iterable.iter()
    var i = 0
    while (iter.next?()) {
        var item = iter.next()
        if (i >= n) { result.push(item) }
        i = i + 1
    }
    return result
}
