//! Iterator utilities — higher-order functions over any Iterable<T>.
//!
//! These all iterate with `for (x in iterable)`, which handles both builtin
//! collections (List / String / Map) and user types implementing the iterator
//! protocol (`.iter()` -> `.has_next()` / `.next()`).

/// Materialize any iterable into a list.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.to_list("abc")  // ["a", "b", "c"]
/// ```
fun to_list<T>(iterable: Iterable<T>): List<T> {
    var result: List<T> = []
    for (item in iterable) {
        result.push(item)
    }
    return result
}

/// Apply a function to each element and return a new list of results.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.map([1, 2, 3], fun (x: Int): Int => x * 2)
/// // [2, 4, 6]
/// ```
fun map<T, R>(iterable: Iterable<T>, func: (T) => R): List<R> {
    var result: List<R> = []
    for (item in iterable) {
        result.push(func(item))
    }
    return result
}

/// Return only elements for which the predicate returns true.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.filter([1, 2, 3, 4], fun (x: Int): Bool => x % 2 == 0)
/// // [2, 4]
/// ```
fun filter<T>(iterable: Iterable<T>, func: (T) => Bool): List<T> {
    var result: List<T> = []
    for (item in iterable) {
        if (func(item)) {
            result.push(item)
        }
    }
    return result
}

/// Fold elements into a single value using an accumulator function and initial value.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.reduce([1, 2, 3, 4], fun (acc: Int, x: Int): Int => acc + x, 0)
/// // 10
/// ```
fun reduce<T, R>(iterable: Iterable<T>, func: (R, T) => R, initial: R): R {
    var acc: R = initial
    for (item in iterable) {
        acc = func(acc, item)
    }
    return acc
}

/// Sum all numeric elements in the iterable.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.sum([1, 2, 3])  // 6
/// ```
fun sum(iterable: Iterable<Number>): Number {
    return reduce(iterable, fun (a: Number, b: Number): Number => a + b, 0)
}

/// Return true if any element satisfies the predicate.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.any([1, 2, 3], fun (x: Int): Bool => x > 2)  // true
/// ```
fun any<T>(iterable: Iterable<T>, func: (T) => Bool): Bool {
    for (item in iterable) {
        if (func(item)) { return true }
    }
    return false
}

/// Return true if all elements satisfy the predicate.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.all([2, 4, 6], fun (x: Int): Bool => x % 2 == 0)  // true
/// ```
fun all<T>(iterable: Iterable<T>, func: (T) => Bool): Bool {
    for (item in iterable) {
        if (!func(item)) { return false }
    }
    return true
}

/// Execute a side-effecting function on each element.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.each(["a", "b", "c"], IO.println)
/// ```
fun each<T>(iterable: Iterable<T>, func: (T) => Nil): Nil {
    for (item in iterable) {
        func(item)
    }
}

/// Count elements that satisfy the predicate.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.count([1, 2, 3, 4], fun (x: Int): Bool => x > 2)
/// // 2
/// ```
fun count<T>(iterable: Iterable<T>, func: (T) => Bool): Number {
    var n = 0
    for (item in iterable) {
        if (func(item)) { n = n + 1 }
    }
    return n
}

/// Return the first element satisfying the predicate, or nil if none found.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.find([1, 2, 3], fun (x: Int): Bool => x > 1)
/// // 2
/// ```
fun find<T>(iterable: Iterable<T>, func: (T) => Bool): T {
    for (item in iterable) {
        if (func(item)) { return item }
    }
    return nil
}

/// Map each element to an iterable and flatten the results into a single list.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.flat_map([[1, 2], [3, 4]], fun (x: List<Int>): List<Int> => x)
/// // [1, 2, 3, 4]
/// ```
fun flat_map<T, R>(iterable: Iterable<T>, func: (T) => Iterable<R>): List<R> {
    var result: List<R> = []
    for (item in iterable) {
        var inner = func(item)
        for (sub in inner) {
            result.push(sub)
        }
    }
    return result
}

/// Combine two iterables into a list of [a, b] pairs, stopping at the shorter one.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.zip([1, 2, 3], ["a", "b", "c"])
/// // [[1, "a"], [2, "b"], [3, "c"]]
/// ```
// Both sides are materialized first: advancing two iterators in lockstep needs
// `has_next()` on each before either `next()`, which the single-pass for-in
// desugaring can't express directly.
fun zip<A, B>(a: Iterable<A>, b: Iterable<B>): List<List<Any>> {
    var list_a: List<A> = to_list(a)
    var list_b: List<B> = to_list(b)
    var len = list_a.length()
    if (list_b.length() < len) { len = list_b.length() }
    var result: List<List<Any>> = []
    var i = 0
    while (i < len) {
        result.push([list_a[i], list_b[i]])
        i = i + 1
    }
    return result
}

/// Pair each element with its index as [index, element].
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.enumerate(["a", "b", "c"])
/// // [[0, "a"], [1, "b"], [2, "c"]]
/// ```
fun enumerate<T>(iterable: Iterable<T>): List<List<Any>> {
    var result: List<List<Any>> = []
    var i = 0
    for (item in iterable) {
        result.push([i, item])
        i = i + 1
    }
    return result
}

/// Take the first n elements from the iterable.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.take([1, 2, 3, 4, 5], 3)  // [1, 2, 3]
/// ```
fun take<T>(iterable: Iterable<T>, n: Number): List<T> {
    var result: List<T> = []
    var i = 0
    for (item in iterable) {
        if (i >= n) { break }
        result.push(item)
        i = i + 1
    }
    return result
}

/// Skip the first n elements and return the rest.
///
/// ```saffron
/// import "@iter" as Iter
/// Iter.skip([1, 2, 3, 4, 5], 2)  // [3, 4, 5]
/// ```
fun skip<T>(iterable: Iterable<T>, n: Number): List<T> {
    var result: List<T> = []
    var i = 0
    for (item in iterable) {
        if (i >= n) { result.push(item) }
        i = i + 1
    }
    return result
}

// --- Additional utilities ---

fun drop(list: List, n: Number): List {
    return skip(list, n)
}

fun chunk(list: List, size: Number): List {
    var result: List = []
    var current: List = []
    var i = 0
    while (i < list.length()) {
        current.push(list[i])
        if (current.length() == size) {
            result.push(current)
            current = []
        }
        i = i + 1
    }
    if (current.length() > 0) {
        result.push(current)
    }
    return result
}

fun zip_with(a: List, b: List, func: Fun): List {
    var result: List = []
    var len = a.length()
    if (b.length() < len) { len = b.length() }
    var i = 0
    while (i < len) {
        result.push(func(a[i], b[i]))
        i = i + 1
    }
    return result
}

fun sort_by(list: List, func: Fun): List {
    var result: List = []
    var i = 0
    while (i < list.length()) {
        result.push(list[i])
        i = i + 1
    }
    // Insertion sort by key
    i = 1
    while (i < result.length()) {
        var key = func(result[i])
        var val = result[i]
        var j = i - 1
        while (j >= 0 and func(result[j]) > key) {
            result[j + 1] = result[j]
            j = j - 1
        }
        result[j + 1] = val
        i = i + 1
    }
    return result
}

fun group_by(list: List, func: Fun): Map {
    var result: Map = {}
    var i = 0
    while (i < list.length()) {
        var key = func(list[i])
        if (result.has(key)) {
            result.get(key).push(list[i])
        } else {
            result.set(key, [list[i]])
        }
        i = i + 1
    }
    return result
}

fun frequencies(list: List): Map {
    var result: Map = {}
    var i = 0
    while (i < list.length()) {
        var item = list[i]
        if (result.has(item)) {
            result.set(item, result.get(item) + 1)
        } else {
            result.set(item, 1)
        }
        i = i + 1
    }
    return result
}

fun unique(list: List): List {
    var seen: Map = {}
    var result: List = []
    var i = 0
    while (i < list.length()) {
        var item = list[i]
        if (!seen.has(item)) {
            seen.set(item, true)
            result.push(item)
        }
        i = i + 1
    }
    return result
}

fun max(list: List): Any {
    if (list.length() == 0) { return nil }
    var best = list[0]
    var i = 1
    while (i < list.length()) {
        if (list[i] > best) { best = list[i] }
        i = i + 1
    }
    return best
}

fun min(list: List): Any {
    if (list.length() == 0) { return nil }
    var best = list[0]
    var i = 1
    while (i < list.length()) {
        if (list[i] < best) { best = list[i] }
        i = i + 1
    }
    return best
}

fun reverse(list: List): List {
    var result: List = []
    var i = list.length() - 1
    while (i >= 0) {
        result.push(list[i])
        i = i - 1
    }
    return result
}

fun join(list: List, sep: String): String {
    var result = ""
    var i = 0
    while (i < list.length()) {
        if (i > 0) { result = result + sep }
        result = result + list[i].to_string()
        i = i + 1
    }
    return result
}
