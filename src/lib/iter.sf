// Iterator utilities — works with any type implementing Iterable<T>

fun map<T, R>(iterable: Iterable<T>, func: (T) => R): List<R> {
    var result: List<R> = []
    var iter = iterable.iter()
    while (iter.next?()) {
        result.push(func(iter.next()))
    }
    return result
}

fun filter<T>(iterable: Iterable<T>, func: (T) => Bool): List<T> {
    var result: List<T> = []
    var iter = iterable.iter()
    while (iter.next?()) {
        var item = iter.next()
        if (func(item)) {
            result.push(item)
        }
    }
    return result
}

fun reduce<T, R>(iterable: Iterable<T>, func: (R, T) => R, initial: R): R {
    var acc: R = initial
    var iter = iterable.iter()
    while (iter.next?()) {
        acc = func(acc, iter.next())
    }
    return acc
}

fun sum(iterable: Iterable<Number>): Number {
    return reduce(iterable, fun (a: Number, b: Number): Number => a + b, 0)
}

fun any<T>(iterable: Iterable<T>, func: (T) => Bool): Bool {
    var iter = iterable.iter()
    while (iter.next?()) {
        if (func(iter.next())) { return true }
    }
    return false
}

fun all<T>(iterable: Iterable<T>, func: (T) => Bool): Bool {
    var iter = iterable.iter()
    while (iter.next?()) {
        if (!func(iter.next())) { return false }
    }
    return true
}

fun each<T>(iterable: Iterable<T>, func: (T) => Nil): Nil {
    var iter = iterable.iter()
    while (iter.next?()) {
        func(iter.next())
    }
}

fun count<T>(iterable: Iterable<T>, func: (T) => Bool): Number {
    var n = 0
    var iter = iterable.iter()
    while (iter.next?()) {
        if (func(iter.next())) { n = n + 1 }
    }
    return n
}

fun find<T>(iterable: Iterable<T>, func: (T) => Bool): T {
    var iter = iterable.iter()
    while (iter.next?()) {
        var item = iter.next()
        if (func(item)) { return item }
    }
    return nil
}

fun flat_map<T, R>(iterable: Iterable<T>, func: (T) => Iterable<R>): List<R> {
    var result: List<R> = []
    var iter = iterable.iter()
    while (iter.next?()) {
        var items = func(iter.next())
        var inner = items.iter()
        while (inner.next?()) {
            result.push(inner.next())
        }
    }
    return result
}

fun zip<A, B>(a: Iterable<A>, b: Iterable<B>): List<List<Any>> {
    var result: List<List<Any>> = []
    var iter_a = a.iter()
    var iter_b = b.iter()
    while (iter_a.next?() and iter_b.next?()) {
        result.push([iter_a.next(), iter_b.next()])
    }
    return result
}

fun enumerate<T>(iterable: Iterable<T>): List<List<Any>> {
    var result: List<List<Any>> = []
    var iter = iterable.iter()
    var i = 0
    while (iter.next?()) {
        result.push([i, iter.next()])
        i = i + 1
    }
    return result
}

fun take<T>(iterable: Iterable<T>, n: Number): List<T> {
    var result: List<T> = []
    var iter = iterable.iter()
    var i = 0
    while (i < n and iter.next?()) {
        result.push(iter.next())
        i = i + 1
    }
    return result
}

fun skip<T>(iterable: Iterable<T>, n: Number): List<T> {
    var result: List<T> = []
    var iter = iterable.iter()
    var i = 0
    while (iter.next?()) {
        var item = iter.next()
        if (i >= n) { result.push(item) }
        i = i + 1
    }
    return result
}
