// Saffron Test Framework
// Decorator-based test discovery with assertions and reporting
//
// Usage:
//   import "@test" as T
//
//   @T.test
//   fun test_math() {
//       T.assert_eq(1 + 1, 2, "addition")
//   }
//
//   @T.skip("not ready")
//   fun test_todo() { ... }
//
//   @T.only
//   fun test_focused() { ... }
//
//   T.run_all()

// --- Internal State ---
var _tests = []
var _only_tests = []
var _passed = 0
var _failed = 0
var _skipped = 0
var _total = 0

// --- Test Discovery Decorators ---

fun test(fn: Any): Any {
    _tests.push({"name": fn, "fn": fn})
    return fn
}

fun skip(reason: String): Any {
    return fun (fn: Any) => {
        _skipped = _skipped + 1
        return fn;
    }
}

fun only(fn: Any): Any {
    _only_tests.push({"name": fn, "fn": fn})
    _tests.push({"name": fn, "fn": fn})
    return fn
}

// --- Assertions ---

fun assert(condition: Bool, msg: String) {
    _total = _total + 1
    if (condition) { _passed = _passed + 1 }
    else {
        _failed = _failed + 1
        IO.println("    FAIL: ${msg}")
    }
}

fun assert_eq(actual: Any, expected: Any, msg: String) {
    _total = _total + 1
    if (actual == expected) { _passed = _passed + 1 }
    else {
        _failed = _failed + 1
        IO.println("    FAIL: ${msg}")
        IO.println("      expected: ${expected}")
        IO.println("      actual:   ${actual}")
    }
}

fun assert_neq(actual: Any, expected: Any, msg: String) {
    _total = _total + 1
    if (actual != expected) { _passed = _passed + 1 }
    else {
        _failed = _failed + 1
        IO.println("    FAIL: ${msg} (should not equal ${expected})")
    }
}

fun assert_gt(actual: Number, expected: Number, msg: String) {
    _total = _total + 1
    if (actual > expected) { _passed = _passed + 1 }
    else { _failed = _failed + 1; IO.println("    FAIL: ${msg} (${actual} not > ${expected})") }
}

fun assert_lt(actual: Number, expected: Number, msg: String) {
    _total = _total + 1
    if (actual < expected) { _passed = _passed + 1 }
    else { _failed = _failed + 1; IO.println("    FAIL: ${msg} (${actual} not < ${expected})") }
}

fun assert_throws(body: Any, msg: String) {
    _total = _total + 1
    var threw = false
    try { body() } catch (e) { threw = true }
    if (threw) { _passed = _passed + 1 }
    else { _failed = _failed + 1; IO.println("    FAIL: ${msg} (expected throw)") }
}

fun assert_throws_with(body: Any, expected_msg: String, msg: String) {
    _total = _total + 1
    var caught_msg = nil
    try { body() } catch (e) { caught_msg = e }
    if (caught_msg == expected_msg) { _passed = _passed + 1 }
    else {
        _failed = _failed + 1
        if (caught_msg == nil) {
            IO.println("    FAIL: ${msg} (no throw)")
        } else {
            IO.println("    FAIL: ${msg} (got '${caught_msg}', want '${expected_msg}')")
        }
    }
}

fun assert_contains(haystack: String, needle: String, msg: String) {
    _total = _total + 1
    if (haystack.contains(needle)) { _passed = _passed + 1 }
    else { _failed = _failed + 1; IO.println("    FAIL: ${msg} ('${haystack}' missing '${needle}')") }
}

// --- Runner ---

fun section(name: String) {
    IO.println("  ${name}")
}

fun run_all() {
    var to_run = _only_tests
    if (_only_tests.length() == 0) {
        to_run = _tests
    }

    IO.println("Running ${to_run.length()} tests (${_skipped} skipped)")
    IO.println("")

    for (entry in to_run) {
        var fn = entry["fn"]
        try {
            fn()
        } catch (e) {
            _failed = _failed + 1
            _total = _total + 1
            IO.println("    CRASH: ${e}")
        }
    }

    IO.println("")
    if (_failed == 0) {
        IO.println("  All ${_total} assertions passed")
    } else {
        IO.println("  ${_passed}/${_total} passed, ${_failed} failed")
    }

    if (_failed > 0) {
        throw "Test suite failed"
    }
}

fun summary() {
    IO.println("")
    if (_failed == 0) {
        IO.println("  All ${_total} assertions passed")
    } else {
        IO.println("  ${_passed}/${_total} passed, ${_failed} failed")
    }
}
