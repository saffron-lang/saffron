//! Promise-style combinators for working with multiple async tasks.

import "@async" as Async

/// Await all tasks and return their results as a list.
fun all(tasks: List<Task>): List<Any> {
    var results = []
    var i = 0
    while (i < tasks.length()) {
        results.push(Async.await(tasks[i]))
        i = i + 1
    }
    return results
}

/// Return the result of the first task that is ready.
fun race(tasks: List<Task>): Any {
    var i = 0
    while (i < tasks.length()) {
        if (tasks[i].isReady()) {
            return tasks[i].getResult()
        }
        i = i + 1
    }
    if (tasks.length() > 0) {
        return Async.await(tasks[0])
    }
    return nil
}

/// Alias for race — return the first completed task result.
fun any(tasks: List<Task>): Any {
    return race(tasks)
}

/// Spawn a task that sleeps for the given number of milliseconds.
fun delay(ms: Float): Task {
    // 1000.0, not 1000 — `Async.sleep` wants fractional seconds, and integer
    // division would floor every delay under a second to 0.
    var secs: Float = ms / 1000.0
    return Task.spawn(fun () => Async.sleep(secs))
}
