class Future {
    var result: Any

    fun init() {
        this.result = nil
    }

    fun setResult(result: Any) {
        this.result = result
    }

    fun getResult() {
        return this.result
    }

    fun isReady() {
        return this.result != nil
    }

    fun join() {
        while (!this.isReady()) {
            yield;
        }

        return this.getResult()
    }
}