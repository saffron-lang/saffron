//! A simple future/promise primitive for cooperative async result passing.

/// Represents an eventually-available value that can be awaited via yield.
class Future {
    var result: Any

    fun init() {
        this.result = nil
    }

    fun set_result(result: Any) {
        this.result = result
    }

    fun get_result() {
        return this.result
    }

    fun is_ready() {
        return this.result != nil
    }

    fun join() {
        while (!this.is_ready()) {
            yield;
        }

        return this.get_result()
    }
}