//! Async TCP socket API.
//! All I/O operations yield to the scheduler when they would block,
//! allowing other tasks to run while waiting for data.

@extern("void sf_socket_init()") fun socket_init()
@extern("i64 sf_tcp_connect(i8*, i64)") fun tcp_connect_raw(host: Int, port: Int): Int
@extern("i64 sf_tcp_read(i64, i8*, i64)") fun tcp_read_raw(fd: Int, buf: Int, len: Int): Int
@extern("i64 sf_tcp_write(i64, i8*, i64)") fun tcp_write_raw(fd: Int, buf: Int, len: Int): Int
@extern("void sf_tcp_close(i64)") fun tcp_close_raw(fd: Int)
@extern("i64 sf_tls_connect(i64, i8*)") fun tls_connect_raw(fd: Int, hostname: Int): Int
@extern("i64 sf_tls_read(i64, i8*, i64)") fun tls_read_raw(handle: Int, buf: Int, len: Int): Int
@extern("i64 sf_tls_write(i64, i8*, i64)") fun tls_write_raw(handle: Int, buf: Int, len: Int): Int
@extern("void sf_tls_close(i64)") fun tls_close_raw(handle: Int)
@extern("void* malloc(i64)") fun sock_malloc(size: Int): Int
@extern("void free(void*)") fun sock_free(ptr: Int)
@extern("i64 strlen(void*)") fun sock_strlen(s: Int): Int

@intrinsic fun __suspend(reason: Int, arg: Int)

// Connect to a TCP host:port. Returns fd or -1 on error.
fun connect(host: String, port: Int): Int {
    socket_init()
    return tcp_connect_raw(host, port)
}

// Connect with TLS. Returns a socket handle (fd in low bits, tls handle in high bits).
// Packed as: fd | (tls_handle << 32)
fun connect_tls(host: String, port: Int): Int {
    socket_init()
    var fd: Int = tcp_connect_raw(host, port)
    if (fd < 0) { return -1 }
    var tls_handle: Int = tls_connect_raw(fd, host)
    if (tls_handle < 0) {
        tcp_close_raw(fd)
        return -1
    }
    // Pack fd + tls_handle
    return fd | (tls_handle << 32)
}

// Async read: yields to scheduler when socket would block.
// Returns the data as a string, or empty string on EOF/error.
fun read(fd: Int, max_bytes: Int): String {
    var buf: Int = sock_malloc(max_bytes + 1)
    var total: Int = 0
    while (total < max_bytes) {
        var n: Int = tcp_read_raw(fd, buf + total, max_bytes - total)
        if (n > 0) {
            total = total + n
            break
        }
        if (n == 0) { break }
        if (n == -2) { break }
        // n == -1: would block — suspend for read readiness
        __suspend(2, fd)
    }
    // Null-terminate
    @intrinsic fun store8(addr: Int, val: Int)
    store8(buf + total, 0)
    return buf
}

// Async write: yields to scheduler when socket would block.
// Returns number of bytes written.
fun write(fd: Int, data: String): Int {
    var len: Int = sock_strlen(data)
    var written: Int = 0
    while (written < len) {
        var n: Int = tcp_write_raw(fd, data + written, len - written)
        if (n > 0) {
            written = written + n
        } else if (n == -1) {
            // Would block — suspend for write readiness
            __suspend(4, fd)
        } else {
            // Error
            break
        }
    }
    return written
}

// Async TLS read
fun tls_read(handle: Int, max_bytes: Int): String {
    var fd: Int = handle & 0xFFFFFFFF
    var tls: Int = handle >> 32
    var buf: Int = sock_malloc(max_bytes + 1)
    var total: Int = 0
    while (total < max_bytes) {
        var n: Int = tls_read_raw(tls, buf + total, max_bytes - total)
        if (n > 0) {
            total = total + n
            break
        }
        if (n == 0) { break }
        if (n == -2) { break }
        // Would block — suspend for read readiness on underlying fd
        __suspend(2, fd)
    }
    @intrinsic fun store8(addr: Int, val: Int)
    store8(buf + total, 0)
    return buf
}

// Async TLS write
fun tls_write(handle: Int, data: String): Int {
    var fd: Int = handle & 0xFFFFFFFF
    var tls: Int = handle >> 32
    var len: Int = sock_strlen(data)
    var written: Int = 0
    while (written < len) {
        var n: Int = tls_write_raw(tls, data + written, len - written)
        if (n > 0) {
            written = written + n
        } else if (n == -1) {
            __suspend(4, fd)
        } else {
            break
        }
    }
    return written
}

// Close a socket (plain or TLS)
fun close(handle: Int) {
    var fd: Int = handle & 0xFFFFFFFF
    var tls: Int = handle >> 32
    if (tls > 0) {
        tls_close_raw(tls)
    }
    tcp_close_raw(fd)
}
