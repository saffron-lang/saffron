//! Base64 encoding and decoding (RFC 4648).

var _alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
var _url_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// ASCII table for char_at (byte value -> character). Starts at \x00.
var _ascii_full = "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f"

// ASCII table for index_of (character -> byte value). Starts at \x01 to avoid
// null-byte issues with strstr; index_of result + 1 gives the byte value.
var _ascii_lookup = "\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f"

/// Return the byte value (0–127) of a single ASCII character.
fun _byte_val(ch: String): Number {
    var val = _ascii_lookup.index_of(ch)
    if (val == -1) {
        throw "base64: non-ASCII character encountered"
    }
    return val + 1
}

/// Return the ASCII character for a given byte value (0–127).
fun _byte_char(val: Number): String {
    return _ascii_full.char_at(val)
}

/// Internal: look up a character's 6-bit value in the alphabet.
fun _lookup(alphabet: String, ch: String): Number {
    var idx = alphabet.index_of(ch)
    if (idx == -1) {
        throw "base64: invalid character '" + ch + "'"
    }
    return idx
}

/// Internal: encode with a given alphabet, optionally adding padding.
fun _encode_with(alphabet: String, input: String, pad: Bool): String {
    if (input.length() == 0) { return "" }
    var result = ""
    var i = 0
    var len = input.length()

    while (i < len) {
        // Read up to 3 bytes
        var b0 = _byte_val(input.char_at(i))
        var b1 = 0
        var b2 = 0
        var remaining = len - i

        if (remaining >= 2) {
            b1 = _byte_val(input.char_at(i + 1))
        }
        if (remaining >= 3) {
            b2 = _byte_val(input.char_at(i + 2))
        }

        // Combine into a 24-bit number: (b0 << 16) | (b1 << 8) | b2
        var combined = b0 * 65536 + b1 * 256 + b2

        // Extract four 6-bit groups
        // group0 = (combined >> 18) & 63
        var group0 = (combined / 262144) % 64
        // group1 = (combined >> 12) & 63
        var group1 = (combined / 4096) % 64
        // group2 = (combined >> 6) & 63
        var group2 = (combined / 64) % 64
        // group3 = combined & 63
        var group3 = combined % 64

        // Always output first two characters
        result = result + alphabet.char_at(group0) + alphabet.char_at(group1)

        if (remaining >= 2) {
            result = result + alphabet.char_at(group2)
        } else if (pad) {
            result = result + "="
        }

        if (remaining >= 3) {
            result = result + alphabet.char_at(group3)
        } else if (pad) {
            result = result + "="
        }

        i = i + 3
    }

    return result
}

/// Internal: decode with a given alphabet, optionally expecting padding.
fun _decode_with(alphabet: String, input: String, expect_padding: Bool): String {
    if (input.length() == 0) { return "" }

    // Strip padding for processing
    var str = input
    var pad_count = 0
    while (str.length() > 0 and str.char_at(str.length() - 1) == "=") {
        pad_count = pad_count + 1
        str = str.slice(0, str.length() - 1)
    }

    if (pad_count > 2) {
        throw "base64: invalid padding"
    }

    var len = str.length()
    // Validate length: after removing padding, check consistency
    var total_chars = len + pad_count
    if (expect_padding and pad_count > 0 and total_chars % 4 != 0) {
        throw "base64: invalid input length"
    }

    var result = ""
    var i = 0

    while (i < len) {
        var remaining = len - i

        // Read up to 4 base64 characters
        var v0 = _lookup(alphabet, str.char_at(i))
        var v1 = 0
        var v2 = 0
        var v3 = 0

        if (remaining >= 2) {
            v1 = _lookup(alphabet, str.char_at(i + 1))
        }
        if (remaining >= 3) {
            v2 = _lookup(alphabet, str.char_at(i + 2))
        }
        if (remaining >= 4) {
            v3 = _lookup(alphabet, str.char_at(i + 3))
        }

        // Combine into a 24-bit number: (v0 << 18) | (v1 << 12) | (v2 << 6) | v3
        var combined = v0 * 262144 + v1 * 4096 + v2 * 64 + v3

        // Extract 3 bytes
        // byte0 = (combined >> 16) & 255
        var byte0 = (combined / 65536) % 256
        result = result + _byte_char(byte0)

        // byte1 = (combined >> 8) & 255
        if (remaining >= 3) {
            var byte1 = (combined / 256) % 256
            result = result + _byte_char(byte1)
        }

        // byte2 = combined & 255
        if (remaining >= 4) {
            var byte2 = combined % 256
            result = result + _byte_char(byte2)
        }

        i = i + 4
    }

    return result
}

/// Encode a string to base64.
///
/// ```saffron
/// import "@base64" as Base64
/// Base64.encode("Hello")    // "SGVsbG8="
/// Base64.encode("foobar")   // "Zm9vYmFy"
/// Base64.encode("")          // ""
/// ```
fun encode(input: String): String {
    return _encode_with(_alphabet, input, true)
}

/// Decode a base64 string back to the original.
///
/// ```saffron
/// import "@base64" as Base64
/// Base64.decode("SGVsbG8=")  // "Hello"
/// Base64.decode("Zm9vYmFy") // "foobar"
/// Base64.decode("")           // ""
/// ```
fun decode(input: String): String {
    return _decode_with(_alphabet, input, true)
}

/// Encode using URL-safe alphabet (+ replaced by -, / replaced by _, no padding).
///
/// ```saffron
/// import "@base64" as Base64
/// Base64.encode_url_safe("Hello")  // "SGVsbG8"
/// ```
fun encode_url_safe(input: String): String {
    return _encode_with(_url_alphabet, input, false)
}

/// Decode URL-safe base64 (- replaced by +, _ replaced by /, no padding expected).
///
/// ```saffron
/// import "@base64" as Base64
/// Base64.decode_url_safe("SGVsbG8")  // "Hello"
/// ```
fun decode_url_safe(input: String): String {
    return _decode_with(_url_alphabet, input, false)
}

/// Check if a string is valid standard base64.
///
/// ```saffron
/// import "@base64" as Base64
/// Base64.is_valid("SGVsbG8=")  // true
/// Base64.is_valid("SGVsbG8!")  // false
/// Base64.is_valid("")           // true
/// ```
fun is_valid(input: String): Bool {
    if (input.length() == 0) { return true }
    // Length must be a multiple of 4 for standard base64
    if (input.length() % 4 != 0) { return false }
    var i = 0
    var padding_started = false
    while (i < input.length()) {
        var ch = input.char_at(i)
        if (ch == "=") {
            padding_started = true
        } else if (padding_started) {
            // No non-padding characters allowed after padding
            return false
        } else if (_alphabet.index_of(ch) == -1) {
            return false
        }
        i = i + 1
    }
    // Padding can only be 0, 1, or 2 characters at the end
    var pad_count = 0
    var j = input.length() - 1
    while (j >= 0 and input.char_at(j) == "=") {
        pad_count = pad_count + 1
        j = j - 1
    }
    if (pad_count > 2) { return false }
    return true
}
