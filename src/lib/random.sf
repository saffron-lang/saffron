import "random" as _Random

fun float(): Number {
    return _Random.float()
}

fun int(min: Number, max: Number): Number {
    return _Random.int(min, max)
}

fun seed(n: Number) {
    _Random.seed(n)
}

fun choice(list: List<Any>): Any {
    var idx = _Random.int(0, list.length() - 1)
    return list[idx]
}

fun shuffle(list: List<Any>): List<Any> {
    var result = list.copy()
    var i = result.length() - 1
    while (i > 0) {
        var j = _Random.int(0, i)
        var temp = result[i]
        result[i] = result[j]
        result[j] = temp
        i = i - 1
    }
    return result
}

fun sample(list: List<Any>, count: Number): List<Any> {
    var pool = list.copy()
    var result: List<Any> = []
    var n = count
    while (n > 0 and pool.length() > 0) {
        var idx = _Random.int(0, pool.length() - 1)
        result.push(pool[idx])
        var last = pool[pool.length() - 1]
        pool[idx] = last
        pool.pop()
        n = n - 1
    }
    return result
}
