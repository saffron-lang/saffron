// Test 1: paren-free trailing closure
fun greet(block: Any) {
    IO.println("before")
    block()
    IO.println("after")
}

greet {
    IO.println("1: paren-free trailing closure")
}

// Test 2: with parens + trailing closure
fun repeat(n: Float, block: Any) {
    var i: Float = 0
    while (i < n) {
        block()
        i = i + 1
    }
}

repeat(3) {
    IO.println("2: repeated")
}

// Test 3: empty parens + trailing closure
fun apply(block: Any) {
    block()
}

apply() {
    IO.println("3: parens + trailing closure")
}

// Test 4: method call trailing closure
class Builder {
    var name: String
    fun init(name: String) {
        this.name = name
    }
    fun with(block: Any) {
        IO.println("4: builder " + this.name)
        block()
    }
}

var b = Builder("test")
b.with() {
    IO.println("4: in builder block")
}

// Test 5: ensure regular blocks still work
var x: Float = 10
if (x > 5) {
    IO.println("5: regular block works")
}
