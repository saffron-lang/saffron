// Test Kotlin-style trailing closure semantics
// Trailing closure ALWAYS maps to the LAST parameter

fun render(cls: String = "", id: String = "", block: Any = nil) {
    IO.println("cls=" + cls)
    if (block != nil) { block() }
}

// Test 1: render() { block } - block goes to last param, others get defaults
render() { IO.println("in block!") }

// Test 2: render("x") { block } - "x" is first positional, block to last
render("test") { IO.println("with cls!") }

// Test 3: render(cls="x") { block } - cls matched by name, block to last
render(cls="named") { IO.println("with named cls!") }

// Test 4: h1-like pattern with 5 params, only trailing closure
fun h1(cls: String = "", id: String = "", style: String = "", attrs: String = "", block: Any = nil) {
    IO.println("h1 cls=" + cls + " id=" + id)
    if (block != nil) { block() }
}

h1 { IO.println("Counter") }
h1(cls="title") { IO.println("Title") }
