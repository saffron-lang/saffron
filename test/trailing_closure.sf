// Test: trailing closure with no other args
fun apply(block: Any) {
    block()
}

apply() {
    IO.println("1: basic trailing closure")
}

// Test: trailing closure with args before it
fun repeat(n: Float, block: Any) {
    var i: Float = 0
    while (i < n) {
        block()
        i = i + 1
    }
}

repeat(3) {
    IO.println("2: repeated")
}

// Test: method call trailing closure
class Builder {
    var name: String
    fun init(name: String) {
        this.name = name
    }
    fun with(block: Any) {
        IO.println("3: builder " + this.name)
        block()
    }
}

var b = Builder("test")
b.with() {
    IO.println("3: in builder block")
}
