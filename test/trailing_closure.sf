// Test 1: paren-free, no params
fun greet(block: Any) {
    block()
}

greet {
    IO.println("1: paren-free")
}

// Test 2: with args + trailing closure
fun repeat(n: Float, block: Any) {
    var i: Float = 0
    while (i < n) {
        block()
        i = i + 1
    }
}

repeat(3) {
    IO.println("2: repeated")
}

// Test 3: single param trailing closure
fun each(items: Any, block: Any) {
    var i: Float = 0
    var len: Float = items.length()
    while (i < len) {
        block(items[i])
        i = i + 1
    }
}

each(["a", "b", "c"]) { item =>
    IO.println("3: " + item)
}

// Test 4: multi-param trailing closure
fun map_pairs(keys: Any, vals: Any, block: Any) {
    var i: Float = 0
    while (i < keys.length()) {
        block(keys[i], vals[i])
        i = i + 1
    }
}

map_pairs(["x", "y"], [1, 2]) { key, val =>
    IO.println("4: " + key + "=" + val.to_string())
}

// Test 5: paren-free with param
fun with_value(block: Any) {
    block(42)
}

with_value { v =>
    IO.println("5: got " + v.to_string())
}

// Test 6: method trailing closure with param
class Builder {
    var items: Any
    fun init() {
        this.items = [10, 20, 30]
    }
    fun each(block: Any) {
        var i: Float = 0
        while (i < this.items.length()) {
            block(this.items[i])
            i = i + 1
        }
    }
}

var b = Builder()
b.each() { item =>
    IO.println("6: " + item.to_string())
}
