//! Tests for the @buffer module.
//! Covers: alloc, from_list, from_string, from_hex, to_hex, slice, concat,
//! multi-byte read/write, signed reads, bitwise ops, BufferReader, BufferWriter.
//!
//! Note: This test is kept small to avoid a codegen size limitation that causes
//! segfaults on large compiled programs. For comprehensive coverage, split into
//! multiple test files.

import "@test" as T
import "@buffer" as Buffer

T.section("Basic access")
var buf = Buffer.alloc(4)
T.assert_eq(buf.length(), 4, "alloc")
buf.set(0, 42)
T.assert_eq(buf.get(0), 42, "set/get")
buf.set(-1, 99)
T.assert_eq(buf.get(-1), 99, "neg idx")

T.section("Construction")
var b2 = Buffer.from_list([72, 101])
T.assert_eq(b2.get(0), 72, "from_list")
var b3 = Buffer.from_string("He")
T.assert_eq(b3.get(0), 72, "from_string")
var b4 = Buffer.from_hex("4865")
T.assert(b4.equals(b3), "from_hex eq")

T.section("Hex roundtrip")
var hb = Buffer.from_list([222, 173, 190])
T.assert(hb.equals(Buffer.from_hex(hb.to_hex())), "hex rt")

T.section("Slice + concat")
var sl = Buffer.from_list([10, 20, 30, 40])
T.assert_eq(sl.slice(1, 3).get(0), 20, "slice")
var cc = Buffer.from_list([1]).concat(Buffer.from_list([2]))
T.assert_eq(cc.get(1), 2, "concat")

T.section("Multi-byte read/write")
var u = Buffer.alloc(4)
u.write_u16_le(0, 4660)
T.assert_eq(u.read_u16_le(0), 4660, "u16le rt")
u.write_u32_be(0, 305419896)
T.assert_eq(u.read_u32_be(0), 305419896, "u32be rt")

T.section("Signed reads")
var si = Buffer.from_list([255, 128, 127])
T.assert_eq(si.read_i8(0), -1, "i8 neg")
T.assert_eq(si.read_i8(2), 127, "i8 pos")

T.section("Bitwise")
var xa = Buffer.from_list([255, 0])
var xb = Buffer.from_list([15, 240])
T.assert_eq(xa.xor(xb).get(0), 240, "xor")
T.assert_eq(xa.and_buf(xb).get(0), 15, "and")

T.section("Reader")
var r = Buffer.reader(Buffer.from_list([1, 52, 18]))
T.assert_eq(r.read_u8(), 1, "ru8")
T.assert_eq(r.read_u16_le(), 4660, "ru16")
T.assert(r.eof(), "eof")

T.section("Writer")
var w = Buffer.writer(8)
w.write_u8(170)
w.write_u16_le(4660)
var wb = w.to_buffer()
T.assert_eq(wb.get(0), 170, "wu8")
T.assert_eq(wb.read_u16_le(1), 4660, "wu16")

T.summary()
