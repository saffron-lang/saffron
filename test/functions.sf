// First class functions
import "@test" as T

fun areWeHavingItYet() {
  IO.print("Yes we are!");
}

IO.print(areWeHavingItYet);

// Arguments
fun sum(a: Int, b: Int, c: Int) {
  return a + b + c;
}

IO.print(4 + sum(5, 6, 7));
T.assert_eq(sum(5, 6, 7), 18, "sum(5,6,7)")
T.assert_eq(4 + sum(5, 6, 7), 22, "4 + sum(5,6,7)")

// Recursion
fun fib(n: Int) {
  if (n < 2) return n;
  return fib(n - 2) + fib(n - 1);
}
T.assert_eq(fib(10), 55, "fib(10)")

// Native Functions
import "time" as Time
var start = Time.clock();
IO.print(fib(10));
IO.print(Time.clock() - start);
T.assert(Time.clock() - start >= 0, "clock delta non-negative")

// Closures
fun makeClosure() {
  var local = "local";
  fun closure() {
    IO.print(local);
  }
  return closure;
}

var closure = makeClosure();
closure();

// Middle Closures
fun outer() {
  var a = 1;
  var b = 2;
  fun middle() {
    var c = 3;
    var d = 4;
    fun inner() {
      IO.print(a + c + b + d);
    }
  }
}

// Sibling Closures
{
  var a = 1;
  fun f() {
    IO.print(a);
  }
  var b = 2;
  fun g() {
    IO.print(b);
  }
  var c = 3;
  fun h() {
    IO.print(c);
  }
}



// Call chains
fun a() { b(); }
fun b() { c(); }
fun c() { IO.print("chain reached c"); }

a();

T.summary()

// This block used to read:
//
//   fun c() { c("too", "many"); }
//   a();
//
// a Crafting Interpreters stack-trace test, inherited from the C VM where
// over-applying a function was a catchable RUNTIME error that printed a trace.
// It has no runtime meaning under the native compiler -- arity is a compile-time
// check -- and it was silently mis-serving as neither. `expected > 0` in the
// codegen arity check exempted every 0-arity function from checking (BUGS #113),
// so the over-application was accepted, `c` recursed into itself forever, and
// this file was a `timeout -- hung for >10s` failure in the main suite rather
// than the diagnostic test it was written to be. The compile-time half now lives
// in test/fail/arity_zero_overapplied.sf, where a clean compile is the failure.
