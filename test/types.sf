var a: Int = 5
var b: String | Int = "asd"
var d: Atom = :asd
var c: (Int) => Int = fun (x: Int): Int => { return x + 1; }
var l: List<List<Int>> = [[1,2],[3,4]]
IO.println(l[1])

type A<T> = List<T>
//var b: A<Int> = [1,2,3] // TODO: make this not error

interface PogInterface<T> {
    fun myfunc(a: T): T
}

class PogClass {
    fun myfunc(a: Int): Int {
        return a + 1
    }
}

var cls: PogInterface<Int> = PogClass()

interface MyInterface {
    fun myfunc(a: Int, b: String)
}

class MyClass {
    fun myfunc(a: Int, b: String) {
        IO.println(a)
        IO.println(b)
    }
}

var my_var: MyInterface = MyClass()
my_var.myfunc(5, "WOW!")

fun myfunc<T>(a: T): T {
    return a
}

fun myfunc<T extends MyInterface>(a: T, b: List<T>): T {
    IO.println(b)
    a.myfunc(1, "ASD")
    return a
}

myfunc(my_var, [my_var])

