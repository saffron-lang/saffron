// Imports: a stdlib `@` module, a relative .sf module, and a builtin C module.
//
// THREE COMPILER BUGS SHAPE THIS FILE. All are reported separately; the file is
// written to test imports rather than to re-derive them.
//
// 1. The `as <alias>` clause must NOT be followed by `;`.
//    `import "./x.sf" as helper;` parses and compiles, then fails codegen with
//    "undefined variable 'helper'": extract_import_aliases in
//    src/compiler/main.sf slices the alias off the raw source line and keeps the
//    `;`, so the alias it registers is `helper;` and every use of `helper` is
//    unbound. Every import below is therefore semicolon-free.
//
// 2. This used to import test/inheritance.sf. It cannot. A module declaring a
//    subclass with an inherited-but-not-overridden method emits an inheritance
//    forwarder under an unprefixed name, and merely importing such a module
//    fails LLVM verification. See test/imports_helper.sf, which exists for this
//    reason and carries the detail.
//
// 3. `IO.println(a, b)` silently DROPS every argument after the first: the old
//    version of this file was four `IO.println("label: ", value)` calls, so it
//    printed four labels and checked no value at all. Everything below builds
//    one string with `+` instead, which is the spelling that actually prints the
//    value.

import "@future" as future
import "./imports_helper.sf" as helper

// A class from a relative .sf module: construct it and call a method.
var g = helper.Gadget("widget")
IO.println(g.describe())

// A free function and a top-level var from the same module.
IO.println(helper.make_gadget("bolt").describe())
IO.println("helper version: " + helper.HELPER_VERSION.to_string())

// A class exported from a stdlib @ module: constructed and used, rather than
// printed. `IO.println(future.Future)` prints a raw pointer value that changes
// run to run, which is unstable to pin and proves only that a name resolved.
// `is_ready()`/`get_result()` are declared with no return type, so the checker
// infers Nil and rejects `.to_string()` on them — hence the `== nil` compare and
// the bare concat, which are the spellings that do type check.
var f = future.Future()
IO.println("future starts unready: " + (f.get_result() == nil).to_string())
f.set_result("done")
IO.println("future result: " + f.get_result())

// A builtin C module. clock() must come back numeric and non-negative rather
// than nil — printing it bare would pass even if the call returned nothing.
import "time" as time
var t = time.clock()
IO.println("time is non-negative: " + (t >= 0).to_string())
