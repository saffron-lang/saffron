// A class instance reaching a *formatter* must not print its raw bit pattern.
//
// BUGS #115, fixed. This file was written while the bug was live and asserted
// the broken paths only NEGATIVELY — "whatever it produces, it must not be
// bit-pattern garbage" — because the garbage was an address reinterpreted as a
// subnormal double, which varies between runs and between optimization levels.
// Recording `5.21502e-310` as expected output would have made the fix look like
// a regression (#107 discipline). Now that the answer is stable, the negative
// invariants are kept AND the positive answers are asserted beside them: the
// negative form is what catches a future regression that produces some *other*
// garbage, which an equality check alone would report less legibly.
//
// The mechanism, worth keeping because it is the reason this needed its own test
// rather than #105's fix reaching it:
//
//   #105 was cured for enums by codegen inserting an explicit
//   `<Enum>__to_string()` call on the IO.println argument when the argument's
//   static type is a known enum. That fix is static-type-driven, so it covered
//   `IO.println(Color.Red)` and missed everything the checker cannot see
//   through — a list element, most of all. A class instance was not covered
//   even at top level, because the println path had no class arm at all.
//
//   The runtime could not recover the answer on its own. A class instance DOES
//   carry a GC header (`__gc_alloc(size, class_tag)`, tags from 10 up) and
//   `__val_class_tag` can read it safely — so, unlike a fieldless enum, the
//   value is identifiable. What was missing was the other half: nothing mapped a
//   class tag to that class's `to_string()`. `__any_to_string` in
//   base_nanbox.ll had no class arm because it had nothing to call. So the fix
//   was a codegen change — `emit_val_to_string` emits a tag-switch
//   `__val_to_string` beside the `__class_parent_tag` / `__class_is_a` switches
//   that `emit_class_hierarchy_helpers` already generates from the same tables —
//   plus one call to it from `__any_to_string`.
//
// A class that declares no `to_string` at all still prints its bit pattern, on
// purpose: inventing `<Pt object>` would be a new output format decided by a bug
// fix. See the #115 entry.
import "@test" as Test

class Pt {
    var x: Number
    fun init(x: Number) { this.x = x }
    fun to_string(): String { return "Pt(${this.x})" }
}

class Base {
    var n: Number
    fun init(n: Number) { this.n = n }
    fun to_string(): String { return "Base(${this.n})" }
}
class Mid extends Base {
    fun to_string(): String { return "Mid(${this.n})" }
}
class Leaf extends Mid {}

fun main() {
    var p: Pt = Pt(3)

    // --- The paths that always worked. These are the reference answer.
    Test.assert_eq("${p}", "Pt(3)", "interpolation calls the class to_string")
    Test.assert_eq(p.to_string(), "Pt(3)", "an explicit to_string call works")

    // Same for an element pulled back out of a list: the value survives the
    // round trip, so nothing about list storage destroys it.
    //
    // The annotation was REQUIRED when this was written and is not decoration.
    // Written `var ps = [Pt(1), Pt(2)]`, the element type was not inferred, so
    // `ps[0].to_string()` dispatched on an untyped receiver and returned the raw
    // pointer — it printed `5.21502e-310` too, from a *different* cause (the
    // untyped-dispatch hazard, not the formatter). That was BUGS #117, since
    // fixed; the annotation stays so these assertions keep isolating the
    // formatter, and `test/pass/list_lit_elem_type.sf` covers the inference.
    var ps: List<Pt> = [Pt(1), Pt(2)]
    Test.assert_eq(ps[0].to_string(), "Pt(1)", "explicit to_string on an element")
    Test.assert_eq(ps[1].to_string(), "Pt(2)", "explicit to_string on element 1")

    // --- The paths that were broken, now asserted both ways.
    //
    // Every garbage rendering seen was a subnormal double printed in exponential
    // form, so "e-" is a sound detector for it and cannot fire on "Pt(3)".
    var s_interp: String = "${p}"
    Test.assert(!s_interp.contains("e-"),
        "an interpolated instance is not a raw float")

    // The list formatter renders each element via __rt_elem_to_string ->
    // __any_to_string. This is the assertion that failed before #115.
    var s_list: String = "${ps}"
    Test.assert(!s_list.contains("e-"),
        "a list of instances is not a list of raw floats")
    Test.assert_eq(s_list, "[Pt(1), Pt(2)]",
        "each element formats through its own to_string")

    // A weaker, encoding-independent form of the same invariant: two instances
    // with different field values must not format identically. Before the fix
    // they did — the address was what got printed, and both addresses
    // reinterpreted to the same 6-digit float.
    Test.assert_eq(ps[0].to_string() == ps[1].to_string(), false,
        "distinct instances stringify differently via to_string")

    // And the invariant that ties the formatter to the explicit call: whatever
    // the list formatter produces for element 0 must contain what the explicit
    // call produces for element 0.
    Test.assert(s_list.contains(ps[0].to_string()),
        "the list rendering contains each element's own to_string")

    // A value in an Any-typed slot has no static type for the checker to key
    // on, so it is the case that ONLY the runtime switch can answer — the
    // strongest evidence the fix is where it claims to be, not a static-type
    // patch that happens to cover the examples above.
    var anys: List<Any> = [Pt(4)]
    Test.assert_eq("${anys}", "[Pt(4)]",
        "an instance in an Any slot formats through the runtime tag switch")

    // Inheritance: Mid overrides, Leaf inherits Mid's without redeclaring it, so
    // no `Leaf__to_string` forwarder is emitted. The switch arm for Leaf's tag
    // must therefore call Mid's symbol — deriving it from the concrete class
    // would name a symbol that does not exist (the BUGS #135 shape).
    var insts: List<Any> = [Base(1), Mid(2), Leaf(3)]
    Test.assert_eq("${insts}", "[Base(1), Mid(2), Mid(3)]",
        "the tag switch honours overrides and inherited implementations")

    // Non-class values must be untouched by the new arm: __val_to_string returns
    // 0 for anything it cannot name, and 0 is the sentinel that falls through to
    // the arms that were already there.
    var others: List<Any> = [42, 3.5, "str", true, nil]
    Test.assert_eq("${others}", "[42, 3.5, str, true, nil]",
        "scalars still format through their original arms")

    Test.summary()
}
