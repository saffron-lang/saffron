// `internal` is recognised syntax with unimplemented semantics, and the compiler
// must say so rather than quietly treating it as `public`.
//
// Accepting it as public would compile a program whose stated intent the compiler
// is ignoring — the author asked for a restriction and got none, with no
// diagnostic to notice. `internal` is package-scoped and needs the pantry.toml
// boundary (Phase 5 of docs/design/access-modifiers.md); until that lands,
// refusing the word is the only honest answer.
internal fun packaged_helper(): Int {
    return 1
}

var result: Int = packaged_helper()
IO.println(result)
