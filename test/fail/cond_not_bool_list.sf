// BUGS #143, a List condition. See test/fail/cond_not_bool.sf for the mechanism.
//
// Worth its own file because a List is not a scalar, so it does not travel
// through check_condition's is_scalar_name clause — it needs the separate
// generic_base List/Map clause, which a fix written against `if (42)` alone would
// not have. Same allocator-dependent non-determinism as the String case.
fun main(): Int {
    var xs: List<Int> = [1, 2]
    if (xs) {
        IO.println("taken")
    }
    return 0
}
