import "@test" as T
import "@sorted_set" as SortedSet

// --- SortedSet ---

T.section("SortedSet basics")
var ss = SortedSet.new()
T.assert(ss.is_empty(), "new set empty")
ss.add(5)
ss.add(1)
ss.add(3)
T.assert_eq(ss.length(), 3, "length 3")
T.assert(ss.is_empty() == false, "not empty")
T.assert_eq(ss.to_list()[0], 1, "sorted 0")
T.assert_eq(ss.to_list()[1], 3, "sorted 1")
T.assert_eq(ss.to_list()[2], 5, "sorted 2")

ss.add(3)
ss.add(1)
T.assert_eq(ss.length(), 3, "dedup")
T.assert(ss.has(1), "has 1")
T.assert(ss.has(3), "has 3")
T.assert(ss.has(5), "has 5")
T.assert(ss.has(2) == false, "no 2")
T.assert(ss.has(99) == false, "no 99")
T.assert_eq(ss.min(), 1, "min")
T.assert_eq(ss.max(), 5, "max")

var empty_set = SortedSet.new()
T.assert_eq(empty_set.min(), nil, "empty min")
T.assert_eq(empty_set.max(), nil, "empty max")

T.section("SortedSet remove+range")
ss.remove(3)
T.assert_eq(ss.length(), 2, "after remove")
T.assert(ss.has(3) == false, "3 gone")
T.assert_eq(ss.to_list()[0], 1, "still 1")
T.assert_eq(ss.to_list()[1], 5, "still 5")

var rs = SortedSet.from([1, 2, 3, 4, 5, 6, 7, 8, 9])
var rr = rs.range(3, 7)
T.assert_eq(rr.length(), 4, "range [3,7) len")
T.assert_eq(rr[0], 3, "range start")
T.assert_eq(rr[3], 6, "range end")

T.section("SortedSet operations")
var a = SortedSet.from([1, 3, 5])
var b = SortedSet.from([2, 3, 4])
var u = SortedSet.union(a, b)
T.assert_eq(u.length(), 5, "union len")
T.assert(u.has(3), "union has 3")
T.assert_eq(u.to_list()[0], 1, "union first")
T.assert_eq(u.to_list()[4], 5, "union last")

var inter = SortedSet.intersection(a, b)
T.assert_eq(inter.length(), 1, "inter len")
T.assert_eq(inter.to_list()[0], 3, "inter val")

var diff = SortedSet.difference(a, b)
T.assert_eq(diff.length(), 2, "diff len")
T.assert(diff.has(1), "diff has 1")
T.assert(diff.has(5), "diff has 5")
T.assert(diff.has(3) == false, "diff no 3")

T.summary()
