// Saffron Language Goals
// This file demonstrates the target syntax for the language.
// Some features are implemented, some are aspirational.
// The file should parse cleanly even if runtime behavior is incomplete.

import "time" as Time
import "@iter" as Iter
import "task" as Task

// --- Pipe operator with iterators ---
var epic_sum = [1,3,5,7,9]
    |> Iter.map(fun (x: Number) => x + 1)
    |> Iter.filter(fun (x: Number) => x % 2 == 0)
    |> Iter.sum()

// --- Enums with generics ---
enum Result<T, E> {
    Ok(value: T),
    Err(error: E)
}

// --- Interfaces with default methods ---
interface Container<T> {
    var capacity: Number

    fun add_item(item: T): Bool

    fun get_size(): Number

    fun is_full(): Bool {
        return this.get_size() >= capacity
    }
}

// --- Class implementing interface (extends keyword, comma-separated) ---
class Backpack extends Container {
    var capacity: Number
    var items: List<Number>

    fun init() {
        this.capacity = 16
        this.items = List()
    }

    fun to_string(): String {
        return "Backpack(${this.items})"
    }

    fun iter() {
        return this.items.iter()
    }

    fun add_item(item: Number): Bool {
        if (this.items.length() >= this.capacity) {
            throw "Attempted to add to a full container!"
        }
        this.items.push(item)
        return true
    }

    fun get_size(): Number {
        return this.items.length()
    }
}

var container = Backpack()

// --- Exception handling ---
try {
    container.add_item(5)
    IO.println("Successfully added the item!")
} catch (error) {
    IO.println("Failed to add the item: ${error}")
}

// --- Pattern matching on enums ---
var success = match (Result.Ok(42)) {
    Ok(value) => value
    Err(error) => -1
}

// --- Destructuring ---
let [head, *middle, tail] = [1, 2, 3, 4, 5]
IO.println(head)    // 1
IO.println(tail)    // 5
IO.println(middle)  // [2, 3, 4]

let [first, *rest] = [1, 2, 3, 4, 5]
let [*init, last] = [1, 2, 3, 4, 5]

// --- Dataclasses (structural types) ---
data class User {
    var username: String
    var age: Number
}

var henry = User("henry", 10)

// --- Cooperative async ---
fun get_dogs(): List<String> {
    var dogs: List<String> = []
    // Simulated async work
    yield [1, 0.1]
    dogs.push("Rex")
    IO.println("We found the dogs: ${dogs}")
    return dogs
}

Task.spawn(get_dogs)

// --- Decorators ---
fun logged(fn: (Number) => Number): (Number) => Number {
    return fun (x: Number) => {
        IO.println("calling...")
        return fn(x)
    }
}

@logged
fun double(x: Number): Number {
    return x * 2
}

IO.println(double(5))

// --- String interpolation and methods ---
var greeting = "Hello, ${henry.username}!"
IO.println(greeting.to_upper())
IO.println(greeting.contains("Hello"))

// --- For-in iteration ---
for (item in [10, 20, 30]) {
    IO.println("item: ${item}")
}

// --- Map iteration ---
var scores: Map<String, Number> = {"alice": 95, "bob": 87}
var iter = scores.iter()
while (iter.has_next()) {
    IO.println(iter.next())
}

