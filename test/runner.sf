// Comprehensive test runner using decorator-based @test framework

import "@test" as T

enum Option { Some(v: Number), None }

@T.test
fun test_arithmetic() {
    T.assert_eq(1 + 2, 3, "addition")
    T.assert_eq(10 - 3, 7, "subtraction")
    T.assert_eq(4 * 5, 20, "multiplication")
    T.assert_eq(10 / 2, 5, "division")
    T.assert_eq(7 % 3, 1, "modulo")
}

@T.test
fun test_strings() {
    T.assert_eq("hello" + " world", "hello world", "concatenation")
    var name = "saffron"
    T.assert_eq("hello ${name}", "hello saffron", "interpolation")
    T.assert_eq("abc".to_upper(), "ABC", "to_upper")
    T.assert_eq("  hi  ".trim(), "hi", "trim")
    T.assert("hello".starts_with("he"), "starts_with")
    T.assert("hello".ends_with("lo"), "ends_with")
    T.assert_eq("ha".repeat(3), "hahaha", "repeat")
}

@T.test
fun test_lists() {
    var list = [1, 2, 3]
    T.assert_eq(list.length(), 3, "length")
    list.push(4)
    T.assert_eq(list[3], 4, "push")
    T.assert_eq(list[-1], 4, "negative index")
    T.assert_eq([1, 2, 3], [1, 2, 3], "list equality")
}

@T.test
fun test_for_in() {
    var sum = 0
    for (x in [1, 2, 3, 4, 5]) { sum = sum + x }
    T.assert_eq(sum, 15, "for-in sum")

    var evens = []
    for (x in [1, 2, 3, 4, 5, 6]) {
        if (x % 2 == 0) { evens.push(x) }
    }
    T.assert_eq(evens, [2, 4, 6], "filter evens")
}

@T.test
fun test_break_continue() {
    var items = []
    for (x in [1, 2, 3, 4, 5]) {
        if (x == 2) { continue }
        if (x == 4) { break }
        items.push(x)
    }
    T.assert_eq(items, [1, 3], "break and continue")
}

// Enum test runs at top level (enums use OP_INVOKE on class which
// doesn't work through nested call frames yet)
var enum_result = match (Option.Some(42)) {
    Some(v) => v * 2
    None => 0
}
var none_result = match (Option.None) {
    Some(v) => v
    None => -1
}

@T.test
fun test_enums() {
    T.assert_eq(enum_result, 84, "match extract")
    T.assert_eq(none_result, -1, "match none")
}

@T.test
fun test_list_access() {
    var list = [10, 20, 30, 40, 50]
    T.assert_eq(list[0], 10, "first element")
    T.assert_eq(list[2], 30, "middle element")
    T.assert_eq(list[-1], 50, "negative index")
    T.assert_eq(list.length(), 5, "length")
}

@T.test
fun test_exceptions() {
    // NOTE: assert_throws uses nested try/catch which currently segfaults
    // Testing basic catch only until nested exception bug is fixed
    var caught = ""
    try { throw "hello" } catch (e) { caught = e }
    T.assert_eq(caught, "hello", "catch value")
}

@T.test
fun test_closures() {
    fun counter() {
        var n = 0
        return fun () => { n = n + 1; return n }
    }
    var c = counter()
    T.assert_eq(c(), 1, "closure first")
    T.assert_eq(c(), 2, "closure second")
    T.assert_eq(c(), 3, "closure third")
}

@T.test
fun test_string_interpolation() {
    var x = 42
    T.assert_eq("val: ${x}", "val: 42", "number interp")
    T.assert_eq("list: ${[1,2,3]}", "list: [1, 2, 3]", "list interp")
    T.assert_eq("bool: ${true}", "bool: true", "bool interp")
    T.assert_eq("nil: ${nil}", "nil: nil", "nil interp")
}

T.run_all()
