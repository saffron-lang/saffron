// Comprehensive test runner using @test framework
// Blocked by import bug — will pass once type checker is fixed

import "@test" as T
import "@async" as Async

T.run("Saffron Test Suite", fun () => {

    T.section("Arithmetic")
    T.assert_eq(1 + 2, 3, "addition")
    T.assert_eq(10 - 3, 7, "subtraction")
    T.assert_eq(4 * 5, 20, "multiplication")
    T.assert_eq(10 / 2, 5, "division")
    T.assert_eq(7 % 3, 1, "modulo")

    T.section("Strings")
    T.assert_eq("hello" + " world", "hello world", "concatenation")
    var name = "saffron"
    T.assert_eq("hello ${name}", "hello saffron", "interpolation")
    T.assert_eq("abc".to_upper(), "ABC", "to_upper")
    T.assert_eq("  hi  ".trim(), "hi", "trim")
    T.assert("hello".starts_with("he"), "starts_with")
    T.assert("hello".ends_with("lo"), "ends_with")
    T.assert_eq("hello".replace("l", "L"), "heLLo", "replace")
    T.assert_eq("ha".repeat(3), "hahaha", "repeat")

    T.section("Lists")
    var list = [1, 2, 3]
    T.assert_eq(list.length(), 3, "length")
    list.push(4)
    T.assert_eq(list[3], 4, "push")
    T.assert_eq(list[-1], 4, "negative index")
    T.assert_eq(list[0], 1, "first element")

    T.section("For-in & Iterators")
    var sum = 0
    for (x in [1, 2, 3, 4, 5]) { sum = sum + x }
    T.assert_eq(sum, 15, "for-in sum")

    var evens = []
    for (x in [1, 2, 3, 4, 5, 6]) {
        if (x % 2 == 0) { evens.push(x) }
    }
    T.assert_eq(evens, [2, 4, 6], "filter evens")

    T.section("Break & Continue")
    var items = []
    for (x in [1, 2, 3, 4, 5]) {
        if (x == 2) { continue }
        if (x == 4) { break }
        items.push(x)
    }
    T.assert_eq(items, [1, 3], "break and continue")

    T.section("Enums & Match")
    enum Option { Some(v: Number), None }
    var result = match (Option.Some(42)) {
        Some(v) => v * 2
        None => 0
    }
    T.assert_eq(result, 84, "match extract and compute")

    var none_result = match (Option.None) {
        Some(v) => v
        None => -1
    }
    T.assert_eq(none_result, -1, "match none")

    T.section("Destructuring")
    let [a, b, c] = [10, 20, 30]
    T.assert_eq(a, 10, "destructure first")
    T.assert_eq(c, 30, "destructure last")

    let [head, *middle, tail] = [1, 2, 3, 4, 5]
    T.assert_eq(head, 1, "splat head")
    T.assert_eq(middle, [2, 3, 4], "splat middle")
    T.assert_eq(tail, 5, "splat tail")

    T.section("Exceptions")
    T.assert_throws(fun () => { throw "error" }, "basic throw")
    T.assert_throws_with(fun () => { throw "specific" }, "specific", "throw message")

    var caught = ""
    try { throw "hello" } catch (e) { caught = e }
    T.assert_eq(caught, "hello", "catch assigns value")

    // Runtime errors are catchable
    var rt_caught = ""
    try {
        var list2 = [1, 2]
        list2[99]
    } catch (e) {
        rt_caught = e
    }
    T.assert_contains(rt_caught, "out of bounds", "runtime error caught")

    T.section("Closures")
    fun counter() {
        var n = 0
        return fun () => { n = n + 1; return n }
    }
    var c1 = counter()
    T.assert_eq(c1(), 1, "closure first")
    T.assert_eq(c1(), 2, "closure second")
    T.assert_eq(c1(), 3, "closure third")

    T.section("Classes")
    class Point {
        var x: Number
        var y: Number
        fun init(x: Number, y: Number) {
            this.x = x
            this.y = y
        }
    }
    var p = Point(3, 4)
    T.assert_eq(p.x, 3, "class field x")
    T.assert_eq(p.y, 4, "class field y")

    T.section("Mocking")
    var m = T.mock("service")
    m["returns"](99)
    var mock_fn = m["fn1"]
    T.assert_eq(mock_fn("test"), 99, "mock returns configured value")
    T.assert(m["called"](), "mock records call")
    T.assert_eq(m["call_count"](), 1, "mock counts calls")
    T.assert_eq(m["last_args"](), ["test"], "mock records args")
    m["reset"]()
    T.assert_eq(m["call_count"](), 0, "reset clears calls")

    T.section("Async")
    T.async_test("concurrent tasks complete", fun () => {
        var t1 = Task.spawn(fun () => { Async.sleep(0.01); return 1 })
        var t2 = Task.spawn(fun () => { Async.sleep(0.02); return 2 })
        var r1 = Async.await(t1)
        var r2 = Async.await(t2)
        return r1 + r2 == 3
    }, 1.0)
})
