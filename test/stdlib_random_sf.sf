import "@random" as Random
import "@test" as T

Random.seed(123)

// float
var f = Random.float()
T.assert(f >= 0, "float >= 0")
T.assert(f < 1, "float < 1")

// int
var i = Random.int(5, 10)
T.assert(i >= 5, "int >= 5")
T.assert(i <= 10, "int <= 10")

// choice
var items = ["a", "b", "c"]
var c = Random.choice(items)
T.assert(c == "a" or c == "b" or c == "c", "choice picks from list")

// shuffle
var nums = [1, 2, 3, 4, 5]
var shuffled = Random.shuffle(nums)
T.assert_eq(shuffled.length(), 5, "shuffle preserves length")
T.assert_eq(nums[0], 1, "shuffle does not mutate original")

// sample
var s = Random.sample([10, 20, 30, 40, 50], 3)
T.assert_eq(s.length(), 3, "sample returns correct count")

T.summary()
