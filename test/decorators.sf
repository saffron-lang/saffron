// Decorator test — wrapping functions with @syntax
// @decorator is sugar for: fun f() { ... }; f = decorator(f)

// Simple wrapper decorator
fun logged(fn: Any): Any {
    return fun (x: Int) => {
        IO.println("calling with ${x}")
        var result = fn(x)
        IO.println("returned ${result}")
        return result
    }
}

@logged
fun double(x: Int): Int {
    return x * 2
}

IO.println(double(5))
// Expected:
//   calling with 5
//   returned 10
//   10

// Parameterized decorator (decorator factory)
fun multiply_by(factor: Int) {
    return fun (fn: Any) => {
        return fun (x: Int) => fn(x) * factor
    }
}

@multiply_by(3)
fun add_one(x: Int): Int {
    return x + 1
}

IO.println(add_one(4))
// Expected: (4 + 1) * 3 = 15

// Multiple decorators (applied bottom-up)
fun exclaim(fn: Any): Any {
    return fun () => fn() + "!"
}

fun uppercase(fn: Any): Any {
    return fun () => fn().to_upper()
}

@uppercase
@exclaim
fun greet(): String {
    return "hello"
}

IO.println(greet())
// Expected: HELLO!
// (exclaim applies first: "hello" -> "hello!", then uppercase: "HELLO!")

// Decorator for metadata/registration
var registered_tests = []

fun test(fn: Any): Any {
    registered_tests.push(fn)
    return fn
}

@test
fun test_math(): Bool {
    return 1 + 1 == 2
}

@test
fun test_strings(): Bool {
    return "hi".length() == 2
}

IO.println("Registered ${registered_tests.length()} tests")
for (t in registered_tests) {
    IO.println("  ${t()}")
}
