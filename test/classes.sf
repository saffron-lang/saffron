fun my_func(a: String): Int {
    IO.println(a)
    return 5 + 2
}

class Pair {
    var first: Int
    var second: Int
}

var pair = Pair();
pair.first = 1;
pair.second = 2;
IO.println(pair.first + pair.second); // 3.

class Brunch {
  fun eggs() {
    IO.println("10")
  }

  var egg2: String = "woah!"
}

var brunch = Brunch();
var eggs = brunch.eggs;

class Scone {
  fun topping(first: String, second: String) {
    IO.println("scone with " + first + " and " + second);
  }
}

var scone = Scone();
scone.topping("berries", "cream");

class CoffeeMaker {
  var coffee: String | Nil
  var tube: (Number) => String

  fun init(coffee: String) {
    this.tube = fun (a: Int) => { return "beans" }
    this.coffee = coffee;
  }

  fun brew() {
    IO.println("Enjoy your cup of " + this.coffee);

    // No reusing the grounds!
    this.coffee = nil;
  }
}

var maker = CoffeeMaker("coffee and chicory");
maker.brew();
maker.tube(5);
