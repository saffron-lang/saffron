class Token {
    var kind: String
    var text: String
    fun init(kind: String, text: String) {
        this.kind = kind
        this.text = text
    }
    fun to_string(): String {
        return this.kind + ":" + this.text
    }
}

enum Result {
    Ok(value: Number),
    Err(msg: String)
}

fun make_token(kind: String, text: String): Token {
    return Token(kind, text)
}
