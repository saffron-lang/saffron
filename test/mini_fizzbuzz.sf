fun fizzbuzz(n: Int): Int {
    var i: Int = 1
    while (i <= n) {
        if (i % 15 == 0) {
            IO.println("FizzBuzz")
        } else {
            if (i % 3 == 0) {
                IO.println("Fizz")
            } else {
                if (i % 5 == 0) {
                    IO.println("Buzz")
                } else {
                    IO.println(".")
                }
            }
        }
        i = i + 1
    }
    return 0
}

fun main(): Int {
    return fizzbuzz(20)
}
