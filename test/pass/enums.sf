// Enum construction, printing and pattern matching.
//
// This file used to be graded on "exit 0 and no Runtime Error:" alone (BUGS
// #107), which is how it came to print subnormal doubles on four of its six lines
// while counting as a passing test. No `.expected` file is recorded here for
// exactly that reason: `IO.println(enum_value)` is BUGS #105 — the direct print
// path emits `shl i64 tag, 56` with no `to_string()` call and no int tag, so the
// runtime finds no NaN-box tag, decides the value is an unboxed double, and
// formats the raw bits. `Color.Red` prints `0` and `Color.Green` prints
// `7.29112e-304`. Freezing that as expected output would convert an open bug into
// the documented answer and make the eventual fix look like a regression.
//
// The IO.println calls are kept, unchanged, so the #105 output stays visible.
// What is added is assertions over the parts that are NOT #105: interpolation
// (which goes through an explicit .to_string() and is correct) and the match
// arms. Those are the file's actual semantic content, and they were never checked.
import "@test" as Test

enum Color {
    Red,
    Green,
    Blue
}

var c = Color.Red
IO.println(c)

var g = Color.Green
IO.println(g)

enum Shape {
    Circle(radius: Int),
    Rect(width: Int, height: Int)
}

var s = Shape.Circle(5)
IO.println(s)

var r = Shape.Rect(3, 4)
IO.println(r)

// Pattern matching
var area = match (s) {
    Circle(radius) => radius * radius * 3
    Rect(w, h) => w * h
}
IO.println(area)

var area2 = match (r) {
    Circle(radius) => radius * radius * 3
    Rect(w, h) => w * h
}
IO.println(area2)

// --- checks ---------------------------------------------------------------
// The match arms: a Circle(5) must select the Circle arm and bind radius=5,
// and a Rect(3,4) must select the Rect arm and bind both fields in order.
// Before this, `area` could have been any value at all and the test still passed.
Test.assert_eq(area, 75, "Circle(5) selects the Circle arm: 5*5*3")
Test.assert_eq(area2, 12, "Rect(3,4) selects the Rect arm: 3*4")

// Interpolation is the path that DOES call to_string(), so it is correct today
// and is the strongest statement this file can make about identity while #105 is
// open. If #105 is fixed, IO.println above should agree with these.
Test.assert_eq("${c}", "Red", "interpolating a no-payload variant")
Test.assert_eq("${g}", "Green", "interpolating a second no-payload variant")
Test.assert_eq("${Color.Blue}", "Blue", "interpolating the third variant")

// Distinct variants of the same enum must not stringify alike — the failure
// shape of BUGS #102, where every value read as its first variant.
Test.assert_neq("${c}", "${g}", "distinct variants stringify differently")

// Payload variants, and that the payload survives construction.
Test.assert_eq("${s}", "Circle(5)", "payload variant keeps its field")
Test.assert_eq("${r}", "Rect(3, 4)", "two-field payload keeps both fields in order")

// Stringification must be a pure function of the value: the same value twice, and
// two equal values built separately. These hold whatever the correct rendering
// is, so they stay valid even if the format above is revised.
Test.assert_eq("${s}", "${s}", "stringifying one value twice agrees")
Test.assert_eq("${Shape.Rect(3, 4)}", "${r}", "equal values stringify equally")

Test.summary()
