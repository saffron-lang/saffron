// Function overloading (pass/overloading): several top-level `fun`s may share a
// name, resolved at the call site by argument count and first-argument type.
// Implemented as a no-op for non-overloaded names — a name is only mangled when
// it has >= 2 definitions. Asserted, not just printed, so a mis-resolution fails
// rather than passing silently.
import "@test" as Test

// Arity-based: same first-arg type, different counts.
fun add(a: Int, b: Int): Int { return a + b }
fun add(a: Int, b: Int, c: Int): Int { return a + b + c }
Test.assert_eq(add(1, 2), 3, "two-arg overload")
Test.assert_eq(add(1, 2, 3), 6, "three-arg overload")

// Type-based across three shapes, including a container. This resolves because
// at least one overload (List<Any>) is non-scalar: the checker validates a call
// against the last-registered signature via scalar_mismatch, and an Int-vs-List
// or String-vs-List pair is not two scalars, so it passes to codegen which picks
// the right variant. An ALL-scalar overload set (e.g. show(Int)/show(String))
// does not yet work — the checker rejects it against the wrong signature; that
// gap is BUGS #176.
fun format(n: Int): String { return "num: " + n.to_string() }
fun format(s: String): String { return "str: " + s }
fun format(items: List<Any>): String { return "list of " + items.length().to_string() }
Test.assert_eq(format(42), "num: 42", "Int arm")
Test.assert_eq(format("hello"), "str: hello", "String arm")
Test.assert_eq(format([1, 2, 3]), "list of 3", "List arm")

// Resolution reads a variable's static type, not just literals.
var k: Int = 7
var lst: List<Any> = ["a", "b"]
Test.assert_eq(format(k), "num: 7", "overload resolved from a variable's Int type")
Test.assert_eq(format(lst), "list of 2", "overload resolved from a variable's List type")

// A non-overloaded name in the same file is untouched (the no-op path).
fun solo(x: Int): Int { return x + 1 }
Test.assert_eq(solo(41), 42, "a single-definition name still works normally")

Test.summary()
