var b = 6;

class Doughnut {
  fun finish(ingredient: String) {
    IO.println("Finish with " + ingredient);
  }

  fun cook() {
    IO.println("Dunk in the fryer.");
    this.finish("sprinkles");
  }
}

var b = Doughnut();
b.finish("cheese");

class Cruller extends Doughnut {
  fun finish() {
    // No sprinkles, always icing.
    IO.println(super.finish);
    super.finish("icing");
  }
}

var a = Cruller();
a.finish();
IO.println(a.finish);