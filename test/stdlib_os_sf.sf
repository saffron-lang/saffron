import "@os" as OS
import "@test" as T

// platform
var p = OS.platform()
T.assert(p == "darwin" or p == "linux" or p == "windows", "platform is valid")

// cwd
var cwd = OS.cwd()
T.assert(cwd.length() > 0, "cwd is non-empty")

// env
OS.set_env("SAFFRON_TEST_VAR", "hello")
T.assert_eq(OS.env("SAFFRON_TEST_VAR"), "hello", "set_env + env")

// exec
var result = OS.exec("echo hi")
T.assert_eq(result, "hi\n", "exec echo")

// args
var a = OS.args()
T.assert(a is List, "args returns list")
T.assert(a.length() > 0, "args has entries")

// home
var h = OS.home()
T.assert(h.length() > 0, "home is non-empty")

// path_sep
var sep = OS.path_sep()
T.assert(sep == "/" or sep == "\\", "path_sep valid")

// join_path
var joined = OS.join_path(["usr", "local", "bin"])
T.assert_eq(joined, "usr/local/bin", "join_path")

T.summary()
