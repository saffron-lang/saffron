    var expected: String = "  br label %while.cond1"
    if (ir == expected) {
        IO.println("PASS: br terminator")
        return true
    }
    IO.println("FAIL: br terminator")
    IO.println("  expected: " + expected)
    IO.println("  got:      " + ir)
    return false
}

