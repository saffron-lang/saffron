//! Integration test: import the @llvm types and instructions, and verify
//! that the instruction formatting matches expected codegen output.
//!
//! This only imports types.sf and instructions.sf (which works without
//! transitive import crashes) to verify the core formatting logic.
//!
//! Run: build/saffronc test/llvm_lib/test_lib_emit.sf test/llvm_lib/test_lib_emit.ll
//!      Then link and run to see output.

import "../../src/lib/llvm/types.sf" as Types
import "../../src/lib/llvm/instructions.sf" as Instructions

// ============================================================================
// Test: Verify instruction formatting matches expected patterns
// ============================================================================

fun test_add_instruction(): Bool {
    // Simulate what the BlockBuilder would produce for: a + b (i64)
    var lhs: Types.Value = Types.Value.Instruction("%t1", Types.Type.I64)
    var rhs: Types.Value = Types.Value.Instruction("%t2", Types.Type.I64)
    var result: Types.Value = Types.Value.Instruction("%t3", Types.Type.I64)
    var inst: Instructions.Instruction = Instructions.Instruction.Add(result, lhs, rhs)
    var ir: String = Instructions.format_instruction(inst)

    var expected: String = "  %t3 = add i64 %t1, %t2"
    if (ir == expected) {
        IO.println("PASS: add instruction")
        return true
    }
    IO.println("FAIL: add instruction")
    IO.println("  expected: " + expected)
    IO.println("  got:      " + ir)
    return false
}

