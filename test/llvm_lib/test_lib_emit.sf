fun test_alloca_instruction(): Bool {
    var result: Types.Value = Types.Value.Instruction("%a", Types.Type.Ptr)
    var inst: Instructions.Instruction = Instructions.Instruction.Alloca(result, Types.Type.I64, "a")
    var ir: String = Instructions.format_instruction(inst)

    var expected: String = "  %a = alloca i64"
    if (ir == expected) {
        IO.println("PASS: alloca i64 instruction")
        return true
    }
    IO.println("FAIL: alloca i64 instruction")
    IO.println("  expected: " + expected)
    IO.println("  got:      " + ir)
    return false
}

fun test_load_instruction(): Bool {
    var ptr: Types.Value = Types.Value.Instruction("%a", Types.Type.Ptr)
    var result: Types.Value = Types.Value.Instruction("%t1", Types.Type.I64)
    var inst: Instructions.Instruction = Instructions.Instruction.Load(result, Types.Type.I64, ptr)
    var ir: String = Instructions.format_instruction(inst)

    // Library uses opaque pointers: "load i64, ptr %a"
    // Codegen uses typed pointers: "load i64, i64* %a"
    // Both are valid LLVM IR (LLVM 15+ accepts both)
    var expected: String = "  %t1 = load i64, ptr %a"
    if (ir == expected) {
        IO.println("PASS: load i64 instruction (opaque ptr)")
        return true
    }
    IO.println("FAIL: load i64 instruction")
    IO.println("  expected: " + expected)
    IO.println("  got:      " + ir)
    return false
}

fun test_store_instruction(): Bool {
    var val: Types.Value = Types.Value.Instruction("%t1", Types.Type.I64)
    var ptr: Types.Value = Types.Value.Instruction("%a", Types.Type.Ptr)
    var inst: Instructions.Instruction = Instructions.Instruction.Store(val, ptr)
    var ir: String = Instructions.format_instruction(inst)

    // Library: "store i64 %t1, ptr %a"
    // Codegen: "store i64 %t1, i64* %a"
    var expected: String = "  store i64 %t1, ptr %a"
    if (ir == expected) {
        IO.println("PASS: store i64 instruction (opaque ptr)")
        return true
    }
    IO.println("FAIL: store i64 instruction")
    IO.println("  expected: " + expected)
    IO.println("  got:      " + ir)
    return false
}

fun test_call_instruction(): Bool {
    var arg1: Types.Value = Types.Value.Instruction("%t1", Types.Type.I64)
    var arg2: Types.Value = Types.Value.Instruction("%t2", Types.Type.I64)
    var result: Types.Value = Types.Value.Instruction("%t3", Types.Type.I64)
    var args: List<Types.Value> = []
    args.push(arg1)
    args.push(arg2)
    var inst: Instructions.Instruction = Instructions.Instruction.Call(result, "add", Types.Type.I64, args)
    var ir: String = Instructions.format_instruction(inst)

    var expected: String = "  %t3 = call i64 @add(i64 %t1, i64 %t2)"
    if (ir == expected) {
        IO.println("PASS: call instruction")
        return true
    }
    IO.println("FAIL: call instruction")
    IO.println("  expected: " + expected)
    IO.println("  got:      " + ir)
    return false
}

fun test_call_void_instruction(): Bool {
    var arg: Types.Value = Types.Value.Instruction("%t1", Types.Type.I64)
    var args: List<Types.Value> = []
    args.push(arg)
    var inst: Instructions.Instruction = Instructions.Instruction.CallVoid("__io_println_str", args)
    var ir: String = Instructions.format_instruction(inst)

    var expected: String = "  call void @__io_println_str(i64 %t1)"
    if (ir == expected) {
        IO.println("PASS: call void instruction")
        return true
    }
    IO.println("FAIL: call void instruction")
    IO.println("  expected: " + expected)
    IO.println("  got:      " + ir)
    return false
}

