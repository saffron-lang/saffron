    var ir: String = Instructions.format_instruction(inst)

    var expected: String = "  %t4 = zext i1 %t3 to i64"
    if (ir == expected) {
        IO.println("PASS: zext i1->i64 instruction")
        return true
    }
    IO.println("FAIL: zext i1->i64 instruction")
    IO.println("  expected: " + expected)
    IO.println("  got:      " + ir)
    return false
}

