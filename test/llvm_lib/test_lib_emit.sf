fun test_icmp_instruction(): Bool {
    var lhs: Types.Value = Types.Value.Instruction("%t1", Types.Type.I64)
    var rhs: Types.Value = Types.Value.Instruction("%t2", Types.Type.I64)
    var result: Types.Value = Types.Value.Instruction("%t3", Types.Type.I1)
    var inst: Instructions.Instruction = Instructions.Instruction.ICmp(result, Types.CmpPred.Sgt, lhs, rhs)
    var ir: String = Instructions.format_instruction(inst)

    var expected: String = "  %t3 = icmp sgt i64 %t1, %t2"
    if (ir == expected) {
        IO.println("PASS: icmp sgt instruction")
        return true
    }
    IO.println("FAIL: icmp sgt instruction")
    IO.println("  expected: " + expected)
    IO.println("  got:      " + ir)
    return false
}

fun test_zext_instruction(): Bool {
