// GC Deep Structure Test
// Verifies iterative mark worklist handles wide object graphs (Bug #6 fix).
// The recursive mark phase crashed at ~4000 objects (stack overflow).
// With the iterative worklist + alignment guard, we handle 20000+ objects.

@extern("void __gc_enable()") fun gc_enable()
@extern("void __gc_collect()") fun gc_collect()
@extern("i64 __gc_stat_alloc_count()") fun gc_alloc_count(): Int
@extern("i64 __gc_stat_collections()") fun gc_collections(): Int
@extern("void __gc_set_threshold(i64)") fun gc_set_threshold(bytes: Int)

IO.println("=== GC Deep Structure Test ===")
gc_enable()
gc_set_threshold(104857600)

// Test: 10000 nested lists survive collection
// (Old recursive approach crashed at ~4000 due to stack overflow)
IO.println("")
IO.println("Test: 10000 inner lists survive mark+sweep")
var outer: List<List<String>> = []
var i: Int = 0
while (i < 10000) {
    var inner: List<String> = []
    inner.push("item")
    outer.push(inner)
    i = i + 1
}
IO.println("  Built: ${outer.length()}")
gc_collect()
IO.println("  After collect: ${outer.length()}")
if (outer.length() == 10000) {
    IO.println("  PASS: Iterative worklist handles wide object graph")
} else {
    IO.println("  FAIL: length=${outer.length()}")
}

IO.println("")
IO.println("=== GC Deep Structure Test Complete ===")
