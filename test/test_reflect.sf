//! Test for the Reflect module.
//!
//! NOTE: This test requires the codegen to emit per-class reflection helpers.
//! The codegen changes (class_type_ids, emit_reflect_helpers) need to be
//! re-applied to stmts_body.sf and output_body.sf for this test to link.
//! The gc.ll infrastructure (per-class type tags, __gc_get_type_tag) is ready.
//!
//! Once codegen changes are in place, run with:
//!   tools/saffron run test/test_reflect.sf

import "@reflect" as Reflect
import "@test" as T

class Point {
    var x: Int
    var y: Int
    fun init(x: Int, y: Int) {
        this.x = x
        this.y = y
    }
}

class Person {
    var name: String
    var age: Int
    fun init(name: String, age: Int) {
        this.name = name
        this.age = age
    }
}

// --- fields tests ---
var p: Point = Point(10, 20)
var fields: Map<String, Any> = Reflect.fields(p)
IO.println(fields.get("x"))   // Expected: 10
IO.println(fields.get("y"))   // Expected: 20
T.assert_eq(fields.get("x"), 10, "fields.get(x)")
T.assert_eq(fields.get("y"), 20, "fields.get(y)")

var alice: Person = Person("Alice", 30)
var alice_fields: Map<String, Any> = Reflect.fields(alice)
IO.println(alice_fields.get("name"))  // Expected: Alice
IO.println(alice_fields.get("age"))   // Expected: 30
T.assert_eq(alice_fields.get("name"), "Alice", "fields.get(name)")
T.assert_eq(alice_fields.get("age"), 30, "fields.get(age)")

// --- construct tests ---
// NOTE: the receiver MUST be annotated (var bob: Person = ...). Without the
// annotation the checker fails to infer the type, dispatch on the result
// misfires, and every field read prints 0 (this is the shape BUGS #107's survey
// warns about — an unannotated Reflect.construct silently returns wrong values).
var data: Map<String, Any> = {"name": "Bob", "age": 25}
var bob: Person = Reflect.construct(Person, data)
IO.println(bob.name)   // Expected: Bob
IO.println(bob.age)    // Expected: 25
T.assert_eq(bob.name, "Bob", "construct Person.name")
T.assert_eq(bob.age, 25, "construct Person.age")

var pt_data: Map<String, Any> = {"x": 5, "y": 15}
var pt: Point = Reflect.construct(Point, pt_data)
IO.println(pt.x)   // Expected: 5
IO.println(pt.y)    // Expected: 15
T.assert_eq(pt.x, 5, "construct Point.x")
T.assert_eq(pt.y, 15, "construct Point.y")

// --- number_to_string ---
IO.println(Reflect.number_to_string(42))   // Expected: 42
IO.println(Reflect.number_to_string(0))    // Expected: 0
IO.println(Reflect.number_to_string(-5))   // Expected: -5
T.assert_eq(Reflect.number_to_string(42), "42", "number_to_string(42)")
T.assert_eq(Reflect.number_to_string(0), "0", "number_to_string(0)")
T.assert_eq(Reflect.number_to_string(-5), "-5", "number_to_string(-5)")

// --- type_name (class instances) ---
// KNOWN BUG: Reflect.type_name returns a subnormal double (e.g. 2.14e-314)
// instead of "Point". __reflect_class_name in codegen/stmts_body.sf returns the
// class-name string pointer via ptr_to_val (a bare ptrtoint) instead of
// emit_tag_ptr, so the returned i64 is an untagged pointer that formats as a
// garbage double. Left as a bare IO.println (NOT asserted) so the wrong output
// stays visible rather than frozen.
IO.println(Reflect.type_name(p))    // Expected: Point (currently prints garbage)

// --- is_instance ---
IO.println(Reflect.is_instance(p))     // Expected: true
IO.println(Reflect.is_instance(42))    // Expected: false
T.assert_eq(Reflect.is_instance(p), true, "is_instance(Point)")
T.assert_eq(Reflect.is_instance(42), false, "is_instance(Int)")

T.summary()
