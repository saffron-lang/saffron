import "@time" as Time
import "@test" as T

// clock returns a positive number
var c = Time.clock()
T.assert(c > 0, "clock > 0")

// timestamp returns Unix epoch
var ts = Time.timestamp()
T.assert(ts > 1700000000, "timestamp is recent")

// to_iso returns a string
var iso = Time.to_iso(1700000000)
T.assert(iso is String, "to_iso returns String")

// Date components
var y = Time.year(ts)
T.assert(y >= 2024, "year >= 2024")

var m = Time.month(ts)
T.assert(m >= 1, "month >= 1")
T.assert(m <= 12, "month <= 12")

// now() returns a map with all fields
var n = Time.now()
T.assert(n.has("year"), "now has year")
T.assert(n.has("month"), "now has month")
T.assert(n.has("day"), "now has day")
T.assert(n.has("hour"), "now has hour")
T.assert(n.has("minute"), "now has minute")
T.assert(n.has("second"), "now has second")
T.assert(n.has("timestamp"), "now has timestamp")

// elapsed
var start = Time.clock()
var e = Time.elapsed(start)
T.assert(e >= 0, "elapsed >= 0")

// measure
var duration = Time.measure(fun () => {
    var x = 0
    for (i in [1, 2, 3, 4, 5]) {
        x = x + i
    }
})
T.assert(duration >= 0, "measure >= 0")

T.summary()
