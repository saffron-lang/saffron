// JSON serialization and parsing.
//
// Originally written against the dead C VM's `data class` form, which does not
// exist in the self-hosted compiler (no token, no AST node, no parse rule) — it
// was lexed as an identifier and the file died with
// "[codegen] Error: undefined variable 'data'". The classes below are plain
// classes with an explicit `init`, which is what `@json`/`@reflect` actually
// key off (they dispatch on the GC type tag, not on any data-class flag).
//
// The `parse_into` half of this file currently SEGFAULTS, and that is a real
// compiler bug, not a defect in this file. Two independent causes:
//
//   1. Passing a bare class name as a value emits a closure box ([2 x i64] of
//      {trampoline, env}), but `__reflect_construct_from_map` compares its
//      argument against a raw ctor function pointer. Every arm misses, so it
//      falls through to `ret i64 0`, and the first field read dereferences nil.
//   2. `__reflect_construct_from_map` builds its map keys with `ptr_to_val`
//      (a bare `ptrtoint`) instead of `emit_tag_ptr`, so the keys are untagged
//      and never match the tagged keys `__map_set` stored.
//
// Both are verified fixable; patching only the emitted IR makes every line
// below print correctly. This file should be listed in run_tests.sh's
// KNOWN_FAIL until those two codegen fixes land.

import "@json" as Json

class Point {
    var x: Int
    var y: Int
    fun init(x: Int, y: Int) { this.x = x; this.y = y }
}

class User {
    var name: String
    var age: Int
    var active: Bool
    fun init(name: String, age: Int, active: Bool) {
        this.name = name
        this.age = age
        this.active = active
    }
}

class Config {
    var host: String
    var port: Int
    var debug: Bool
    fun init(host: String, port: Int, debug: Bool) {
        this.host = host
        this.port = port
        this.debug = debug
    }
}

// --- Test: class construction ---
var p = Point(3, 4)
IO.println(p.x)
IO.println(p.y)

var u = User("alice", 30, true)
IO.println(u.name)
IO.println(u.age)
IO.println(u.active)

// --- Test: Json.to_string ---
IO.println(Json.to_string(p))
IO.println(Json.to_string(u))

// --- Test: Json.parse (untyped) ---
var nums: List<Any> = Json.parse("[1, 2, 3, 4, 5]")
IO.println(nums)

IO.println(Json.parse("true"))
IO.println(Json.parse("null"))
IO.println(Json.parse("42"))

// --- Test: Json.parse_into (typed deserialization) ---
var p2: Point = Json.parse_into(Point, "{\"x\":10,\"y\":20}")
IO.println(p2.x)
IO.println(p2.y)

var u2: User = Json.parse_into(User, "{\"name\":\"bob\",\"age\":25,\"active\":false}")
IO.println(u2.name)
IO.println(u2.age)
IO.println(u2.active)

// --- Test: roundtrip (stringify -> parse_into) ---
var cfg = Config("localhost", 8080, true)
var json = Json.to_string(cfg)
IO.println(json)

var cfg2: Config = Json.parse_into(Config, json)
IO.println(cfg2.host)
IO.println(cfg2.port)
IO.println(cfg2.debug)
