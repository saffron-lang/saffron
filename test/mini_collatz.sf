// Collatz conjecture: count steps to reach 1
fun main(): Int {
    var n: Int = 27
    var steps: Int = 0
    IO.print(n)
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2
        } else {
            n = n * 3 + 1
        }
        IO.print(n)
        steps = steps + 1
    }
    IO.println("")
    IO.println(steps)
    return 0
}
