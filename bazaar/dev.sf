//! Bazaar dev runner — builds frontend + backend, runs both in parallel.
//! Frontend: static file server on port 3000
//! Backend: API server subprocess on port 3001
//! API requests (/api/*) are proxied to the backend.

import "@process" as Process

@extern("void sf_socket_init()") fun _socket_init()
@extern("i64 sf_tcp_bind(i8*, i64)") fun _tcp_bind(host: String, port: Int): Int
@extern("i64 sf_tcp_listen(i64, i64)") fun _tcp_listen(fd: Int, backlog: Int): Int
@extern("i64 sf_tcp_accept(i64)") fun _tcp_accept(listener_fd: Int): Int
@extern("i64 sf_tcp_poll(i64, i64, i64)") fun _tcp_poll(fd: Int, events: Int, timeout_ms: Int): Int
@extern("i64 sf_tcp_read(i64, i8*, i64)") fun _tcp_read(fd: Int, buf: Int, len: Int): Int
@extern("i64 sf_tcp_write(i64, i8*, i64)") fun _tcp_write(fd: Int, buf: Int, len: Int): Int
@extern("void sf_tcp_close(i64)") fun _tcp_close(fd: Int)
@extern("void* malloc(i64)") fun _malloc(size: Int): Int
@extern("void free(void*)") fun _free(ptr: Int)

var FRONTEND_PORT: Int = 3000
var BACKEND_PORT: Int = 3001

// =============================================================================
// Build
// =============================================================================

fun build_frontend(): Bool {
    var result = Process.run("cd frontend && saffron build --target wasm32 --lib-path .pantry/packages src/main.sf -o ../static/app.wasm")
    if (!result.success) {
        IO.println("  [frontend] FAILED")
        IO.println(result.stderr)
        return false
    }
    Process.run("cp frontend/public/* static/ 2>/dev/null")
    Process.run("cp frontend/.pantry/packages/turmeric/runtime/app_template.js static/app.js 2>/dev/null")
    IO.println("  [frontend] ✓ static/app.wasm")
    return true
}

fun build_backend(): Bool {
    var result = Process.run("saffron build --lib-path .pantry/packages src/main.sf -o build/bazaar")
    if (!result.success) {
        IO.println("  [backend]  FAILED")
        IO.println(result.stderr)
        return false
    }
    IO.println("  [backend]  ✓ build/bazaar")
    return true
}

// =============================================================================
// Static file serving
// =============================================================================

fun mime_for(path: String): String {
    if (path.ends_with(".html")) { return "text/html; charset=utf-8" }
    if (path.ends_with(".js")) { return "application/javascript" }
    if (path.ends_with(".css")) { return "text/css" }
    if (path.ends_with(".wasm")) { return "application/wasm" }
    if (path.ends_with(".json")) { return "application/json" }
    if (path.ends_with(".png")) { return "image/png" }
    if (path.ends_with(".svg")) { return "image/svg+xml" }
    return "application/octet-stream"
}

fun read_request(fd: Int): String {
    var buf: Int = _malloc(8192)
    var n: Int = _tcp_read(fd, buf, 8191)
    if (n <= 0) { _free(buf); return "" }
    return buf
}

fun send_response(fd: Int, status: String, mime: String, body: String) {
    var headers: String = "HTTP/1.1 " + status + "\r\nContent-Type: " + mime + "\r\nContent-Length: " + body.length().to_string() + "\r\nConnection: close\r\n\r\n"
    var full: String = headers + body
    _tcp_write(fd, full, full.length())
}

fun send_file(fd: Int, mime: String, path: String) {
    var size: Int = IO.file_size(path)
    if (size <= 0) {
        send_response(fd, "404 Not Found", "text/plain", "Not Found")
        return
    }
    var buf: Int = _malloc(size)
    IO.read_binary(path, buf, size)
    var headers: String = "HTTP/1.1 200 OK\r\nContent-Type: " + mime + "\r\nContent-Length: " + size.to_string() + "\r\nConnection: close\r\n\r\n"
    _tcp_write(fd, headers, headers.length())
    _tcp_write(fd, buf, size)
    _free(buf)
}

fun proxy_to_backend(fd: Int, raw: String) {
    var lines: List<String> = raw.split("\r\n")
    var parts: List<String> = lines[0].split(" ")
    var method: String = parts[0]
    var path: String = parts[1]
    var url: String = "http://localhost:" + BACKEND_PORT.to_string() + path

    // Build curl args in a temp file to avoid shell quoting issues
    var curl_cmd: String = "curl -s -X " + method + " -H 'Content-Type: application/json'"

    // Extract auth header if present
    var i: Int = 0
    while (i < lines.length()) {
        if (lines[i].starts_with("Authorization:")) {
            curl_cmd = curl_cmd + " -H \"" + lines[i].trim() + "\""
        }
        i = i + 1
    }

    // For POST/PUT, write body to temp file to avoid quoting issues
    if (method == "POST" or method == "PUT") {
        var body_start: Int = raw.index_of("\r\n\r\n")
        if (body_start >= 0) {
            var body: String = raw.slice(body_start + 4, raw.length())
            if (body.length() > 0) {
                IO.write_file("/tmp/_bazaar_proxy_body.json", body)
                curl_cmd = curl_cmd + " -d @/tmp/_bazaar_proxy_body.json"
            }
        }
    }

    curl_cmd = curl_cmd + " \"" + url + "\""

    var result = Process.run(curl_cmd)
    if (result.success and result.stdout.length() > 0) {
        send_response(fd, "200 OK", "application/json", result.stdout)
    } else {
        send_response(fd, "502 Bad Gateway", "application/json", "{\"error\":\"backend unavailable\"}")
    }
}

fun handle_request(fd: Int) {
    var raw: String = read_request(fd)
    if (raw.length() == 0) { _tcp_close(fd); return }

    var lines: List<String> = raw.split("\r\n")
    if (lines.length() == 0) { _tcp_close(fd); return }
    var parts: List<String> = lines[0].split(" ")
    if (parts.length() < 2) { _tcp_close(fd); return }
    var req_path: String = parts[1]

    // Proxy API requests to backend
    if (req_path.starts_with("/api/")) {
        proxy_to_backend(fd, raw)
        _tcp_close(fd)
        return
    }

    // Strip query string for static file lookup
    var qidx: Int = req_path.index_of("?")
    if (qidx >= 0) { req_path = req_path.slice(0, qidx) }

    // Serve static files
    var file_path: String = "static" + req_path
    if (req_path == "/" or req_path == "") {
        file_path = "static/index.html"
    }
    if (!IO.file_exists(file_path) or file_path.ends_with("/")) {
        file_path = "static/index.html"
    }
    if (!IO.file_exists(file_path)) {
        send_response(fd, "404 Not Found", "text/plain", "Not Found")
        _tcp_close(fd)
        return
    }

    var mime: String = mime_for(file_path)
    send_file(fd, mime, file_path)
    _tcp_close(fd)
}

// =============================================================================
// Main
// =============================================================================

// Build both
build_frontend()
build_backend()

// Start backend API server as subprocess
var backend_proc = Process.spawn("BAZAAR_PORT=3001 ./build/bazaar")
IO.println("  [backend]  http://localhost:" + BACKEND_PORT.to_string() + " (API)")

// Start frontend static server
_socket_init()
var listen_fd: Int = _tcp_bind("0.0.0.0", FRONTEND_PORT)
if (listen_fd < 0) {
    IO.println("  [server]   failed to bind to port " + FRONTEND_PORT.to_string())
    backend_proc.kill()
    return
}
_tcp_listen(listen_fd, 128)
IO.println("  [server]   http://localhost:" + FRONTEND_PORT.to_string() + " (app)")
IO.println("")

while (true) {
    _tcp_poll(listen_fd, 1, 1000)
    var client_fd: Int = _tcp_accept(listen_fd)
    if (client_fd >= 0) {
        _tcp_poll(client_fd, 1, 5000)
        handle_request(client_fd)
    }
}
