//! Bazaar Frontend — Package registry SPA
//! Built with Turmeric + Basil (auto-caching queries)

import { signal, computed, effect } from "turmeric/signal"
import { Event } from "turmeric/events"
import "turmeric/router" as Router
import { div, span, p, a, b, strong, pre, h1, h2, nav, footer, section, form, input, button, code, text, main, aside, article, mount, event_target_value } from "turmeric/prelude"
import "./api.sf" as Api

// =============================================================================
// State
// =============================================================================

var router = Router.hash()
var search_query = signal("")

// Basil queries — auto-caching, signal-based
var packages_query = Api.getPackages()
var search_q = signal("")
var detail_name_sig = signal("")

// Derived queries (re-created when params change)
var search_results_query = signal(nil)
var detail_query = signal(nil)

// =============================================================================
// Actions
// =============================================================================

fun do_search() {
    var q: String = search_query.get()
    if (q.length() == 0) {
        packages_query.refetch()
        router.go("/")
        return
    }
    router.go("/search?q=" + q)
    search_results_query.set(Api.searchPackages(q))
}

fun search_category(cat: String) {
    search_query.set(cat)
    do_search()
}

fun load_package_detail(name: String) {
    detail_name_sig.set(name)
    detail_query.set(Api.getPackage(name))
    router.go("/packages/" + name)
}

fun navigate_home() {
    router.go("/")
    search_query.set("")
    packages_query.refetch()
}

// =============================================================================
// Components — Shared
// =============================================================================

fun NavBar() {
    <nav cls="nav">
        {Router.Link(router, "/", cls="nav-brand") { text("Bazaar") }}
        {Router.Link(router, "/search?q=", cls="nav-link") { text("Browse") }}
        <a cls="nav-link">Docs</a>
        <div cls="nav-r">
            <a cls="btn-g">Sign in</a>
            <a cls="btn-a">Publish</a>
        </div>
    </nav>
}

fun NavBarWithSearch() {
    <nav cls="nav">
        {Router.Link(router, "/", cls="nav-brand") { text("Bazaar") }}
        {Router.Link(router, "/search?q=", cls="nav-link on") { text("Browse") }}
        <a cls="nav-link">Docs</a>
        <form cls="nav-search" on_submit={fun (e: Event) => do_search()}>
            <input type="text" placeholder="Search packages..." on_input={fun (e: Event) => search_query.set(event_target_value())} />
            <button cls="nav-search-btn" type="submit">→</button>
        </form>
        <div cls="nav-r">
            <a cls="btn-g">Sign in</a>
            <a cls="btn-a">Publish</a>
        </div>
    </nav>
}

fun Footer() {
    <footer cls="footer">
        {Router.Link(router, "/", cls="footer-brand") { text("Bazaar") }}
        <div cls="footer-links">
            <a cls="footer-link">Docs</a>
            <a cls="footer-link">Status</a>
            <a cls="footer-link" href="https://github.com/henry232323/saffron">GitHub</a>
            <a cls="footer-link">Terms</a>
        </div>
        <span cls="footer-t">© 2026 Bazaar Registry</span>
    </footer>
}

fun LoadingIndicator(query: Any) {
    if (query != nil and query.isLoading.get()) {
        <div cls="loading">
            <div cls="spinner"></div>
            <span>Loading...</span>
        </div>
    }
}

// =============================================================================
// Components — Package Cards
// =============================================================================

fun PackageCard(pkg: Map<String, String>) {
    var name: String = pkg.get("name")
    var version: String = ""
    if (pkg.has("latest")) { version = pkg.get("latest") }
    var description: String = ""
    if (pkg.has("description")) { description = pkg.get("description") }

    {Router.Link(router, "/packages/" + name, cls="pkg-card") {
        <div cls="pkg-card-top">
            <div cls="pkg-ico">{name.char_at(0)}</div>
            <div>
                <div cls="pkg-name">{name}</div>
                <div cls="pkg-meta">
                    {if (version.length() > 0) {
                        <span cls="ver">v{version}</span>
                    }}
                </div>
            </div>
        </div>
        if (description.length() > 0) {
            <p cls="pkg-desc">{description}</p>
        }
        <div cls="pkg-footer">
            <div cls="pkg-tags">
                <span cls="tag">saffron</span>
            </div>
            <code cls="pkg-cmd">pantry add {name}</code>
        </div>
    }}
}

fun PackageRow(pkg: Map<String, String>) {
    var name: String = pkg.get("name")
    var version: String = ""
    if (pkg.has("latest")) { version = pkg.get("latest") }
    var description: String = ""
    if (pkg.has("description")) { description = pkg.get("description") }

    {Router.Link(router, "/packages/" + name, cls="pkg-row") {
        <div cls="pkg-row-top">
            <div cls="pkg-ico">{name.char_at(0)}</div>
            <div cls="pkg-row-info">
                <div cls="pkg-row-title">
                    <span cls="pkg-row-name">{name}</span>
                    {if (version.length() > 0) {
                        <span cls="ver">{version}</span>
                    }}
                </div>
                if (description.length() > 0) {
                    <p cls="pkg-row-desc">{description}</p>
                }
                <div cls="pkg-row-footer">
                    <div cls="pkg-row-tags">
                        <span cls="tag">saffron</span>
                    </div>
                    <code cls="pkg-row-cmd">pantry add {name}</code>
                </div>
            </div>
        </div>
    }}
}

// =============================================================================
// Pages — Landing
// =============================================================================

fun HomePage() {
    <div>
        {NavBar()}

        <section cls="hero">
            <div cls="hero-inner">
                <span cls="kicker">OPEN PACKAGE REGISTRY</span>
                <h1 cls="hero-h">Find the right package. Build something lasting.</h1>
                <p cls="hero-sub">Browse packages from the Saffron community. Open source, forever free.</p>
                <form cls="hero-form" on_submit={fun (e: Event) => do_search()}>
                    <input cls="hero-input" type="text" placeholder="Search packages, tools, components..." on_input={fun (e: Event) => search_query.set(event_target_value())} />
                    <button cls="hero-btn" type="submit">Search</button>
                </form>
                <div cls="hero-pills">
                    <span cls="pill" on_click={fun (e: Event) => search_category("ui")}>UI components</span>
                    <span cls="pill" on_click={fun (e: Event) => search_category("cli")}>CLI tools</span>
                    <span cls="pill" on_click={fun (e: Event) => search_category("auth")}>Authentication</span>
                    <span cls="pill" on_click={fun (e: Event) => search_category("data")}>Data parsing</span>
                    <span cls="pill" on_click={fun (e: Event) => search_category("test")}>Testing</span>
                </div>
            </div>
        </section>

        {LoadingIndicator(packages_query)}

        <div cls="section wrap">
            <div cls="section-hd">
                <h2 cls="section-title">All packages</h2>
                {Router.Link(router, "/search?q=", cls="section-more") { text("View all →") }}
            </div>
            <div cls="pkg-grid">
                {var data = packages_query.data.get()
                if (data != nil and data.has("packages")) {
                    var pkgs = data.get("packages")
                    var i: Float = 0
                    while (i < pkgs.length()) {
                        PackageCard(pkgs[i])
                        i = i + 1
                    }
                    if (pkgs.length() == 0 and !packages_query.isLoading.get()) {
                        <div cls="empty-state">No packages published yet. Be the first!</div>
                    }
                }}
            </div>
        </div>

        {Footer()}
    </div>
}

// =============================================================================
// Pages — Search Results
// =============================================================================

fun SearchResultsPage() {
    var query = search_results_query.get()

    <div>
        {NavBarWithSearch()}

        <div cls="tab-strip">
            <div cls="tab on">All</div>
            <div cls="tab-r">
                <span cls="result-ct">
                    {if (query != nil and query.data.get() != nil) {
                        text(query.data.get().get("total").to_string() + " results")
                    }}
                </span>
            </div>
        </div>

        {LoadingIndicator(query)}

        <div cls="layout">
            <main cls="results">
                <p cls="result-hd">
                    Results for "<strong>{search_query.get()}</strong>"
                </p>
                {if (query != nil) {
                    var data = query.data.get()
                    if (data != nil and data.has("packages")) {
                        var pkgs = data.get("packages")
                        var i: Float = 0
                        while (i < pkgs.length()) {
                            PackageRow(pkgs[i])
                            i = i + 1
                        }
                        if (pkgs.length() == 0 and !query.isLoading.get()) {
                            <div cls="empty-state">No packages found matching your query.</div>
                        }
                    }
                }}
            </main>
        </div>

        {Footer()}
    </div>
}

// =============================================================================
// Pages — Package Detail
// =============================================================================

fun PackageDetailPage() {
    var query = detail_query.get()
    var name: String = detail_name_sig.get()

    <div>
        {NavBarWithSearch()}

        {if (query != nil and query.data.get() != nil) {
            var data = query.data.get()
            var latest: String = ""
            var description: String = ""
            var versions = []
            if (data.has("description")) { description = data.get("description") }
            if (data.has("versions")) {
                versions = data.get("versions")
                if (versions.length() > 0) {
                    latest = versions[versions.length() - 1].get("vers")
                }
            }

            <div cls="pkg-header">
                <div cls="pkg-header-inner">
                    <div cls="pkg-header-top">
                        <div cls="pkg-header-ico">{name.char_at(0)}</div>
                        <div>
                            <div cls="pkg-header-title-row">
                                <h1 cls="pkg-header-title">{name}</h1>
                                <span cls="ver">{latest}</span>
                            </div>
                            if (description.length() > 0) {
                                <p cls="pkg-header-desc">{description}</p>
                            }
                            <div cls="pkg-header-stats">
                                <span cls="pkg-hstat">License: <strong>{data.get("license")}</strong></span>
                                <span cls="pkg-hstat-sep">·</span>
                                <span cls="pkg-hstat"><strong>{versions.length().to_string()}</strong> versions</span>
                                <span cls="pkg-hstat-sep">·</span>
                                <span cls="pkg-hstat"><strong>{data.get("total_downloads")}</strong> downloads</span>
                            </div>
                            <div cls="pkg-install">
                                <code><b>pantry</b> add {name}</code>
                                <button cls="pkg-copy">COPY</button>
                            </div>
                        </div>
                    </div>
                    <div cls="pkg-tabs">
                        <div cls="pkg-tab on">Readme</div>
                        <div cls="pkg-tab">Versions</div>
                        <div cls="pkg-tab">Dependencies</div>
                    </div>
                </div>
            </div>

            <div cls="detail-layout">
                <article cls="readme">
                    <h2>Installation</h2>
                    <pre><code>pantry add {name}</code></pre>
                    if (description.length() > 0) {
                        <div>
                            <h2>About</h2>
                            <p>{description}</p>
                        </div>
                    }
                </article>

                <aside cls="meta-sidebar">
                    <div cls="meta-card">
                        <span cls="meta-title">About</span>
                        <div cls="meta-row">
                            <span cls="meta-key">Version</span>
                            <span cls="meta-val mono">{latest}</span>
                        </div>
                        <div cls="meta-row">
                            <span cls="meta-key">License</span>
                            <span cls="meta-val">{data.get("license")}</span>
                        </div>
                        <div cls="meta-row">
                            <span cls="meta-key">Downloads</span>
                            <span cls="meta-val">{data.get("total_downloads")}</span>
                        </div>
                        <div cls="meta-row">
                            <span cls="meta-key">Versions</span>
                            <span cls="meta-val">{versions.length().to_string()}</span>
                        </div>
                        {if (data.has("repository") and data.get("repository").length() > 0) {
                            <div cls="meta-row">
                                <span cls="meta-key">Repository</span>
                                <span cls="meta-val">{data.get("repository")}</span>
                            </div>
                        }}
                    </div>

                    if (versions.length() > 0) {
                        <div cls="meta-card">
                            <span cls="meta-title">Version history</span>
                            {var i: Float = versions.length() - 1
                            while (i >= 0 and i > versions.length() - 6) {
                                var v = versions[i]
                                <div cls="ver-row">
                                    <span cls="ver-row-num">{v.get("vers")}</span>
                                    {if (i == versions.length() - 1) {
                                        <span cls="ver-row-cur">CURRENT</span>
                                    }}
                                </div>
                                i = i - 1
                            }}
                        </div>
                    }
                </aside>
            </div>
        } else {
            LoadingIndicator(query)
        }}

        {Footer()}
    </div>
}

// =============================================================================
// App + Routes
// =============================================================================

fun App() {
    router.render()
}

router.route("/", fun (p: Router.RouteParams) => HomePage())
router.route("/search", fun (p: Router.RouteParams) => {
    var q: String = p.query_get("q")
    if (q.length() > 0) {
        search_query.set(q)
        search_results_query.set(Api.searchPackages(q))
    }
    SearchResultsPage()
})
router.route("/packages/:name", fun (p: Router.RouteParams) => {
    var name: String = p.get("name")
    detail_name_sig.set(name)
    detail_query.set(Api.getPackage(name))
    PackageDetailPage()
})

// =============================================================================
// Entry
// =============================================================================

mount("#app", fun () => App())
