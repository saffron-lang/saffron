//! Bazaar Frontend — Package registry SPA
//! Built with Turmeric + Tailwind CSS (inline HTML syntax)

import { signal, computed, effect } from "turmeric/signal"
import { Event } from "turmeric/events"
import "turmeric/router" as Router

// =============================================================================
// FFI — fetch from same-origin API
// =============================================================================

@extern("void js_fetch_json(void*, i64)") fun _fetch_json(url: String, callback_id: Float)

var _fetch_next_id: Float = 0
var _fetch_callbacks: Map<Float, (String) => Nil> = {}

fun fetch_json(url: String, callback: (String) => Nil) {
    _fetch_next_id = _fetch_next_id + 1
    var id: Float = _fetch_next_id
    _fetch_callbacks.set(id, callback)
    _fetch_json(url, id)
}

fun __on_fetch_complete(id: Float, json_str: String) {
    if (_fetch_callbacks.has(id)) {
        _fetch_callbacks.get(id)(json_str)
        _fetch_callbacks.set(id, nil)
    }
}

// =============================================================================
// State
// =============================================================================

var router = Router.hash()
var search_query = signal("")
var search_results = signal([])
var is_loading = signal(false)
var detail_name = signal("")
var detail_versions = signal([])
var detail_description = signal("")
var detail_latest = signal("")
var featured_packages = signal([])

// =============================================================================
// API
// =============================================================================

fun load_featured() {
    is_loading.set(true)
    fetch_json("/api/v1/packages", fun (json_str: String) => {
        var data = JSON.parse(json_str)
        if (data != nil and data.has("packages")) {
            featured_packages.set(data.get("packages"))
        }
        is_loading.set(false)
    })
}

fun do_search() {
    var q: String = search_query.get()
    if (q.length() == 0) {
        load_featured()
        current_page.set("home")
        return
    }
    is_loading.set(true)
    router.go("/search?q=" + q)
    fetch_json("/api/v1/search?q=" + q, fun (json_str: String) => {
        var data = JSON.parse(json_str)
        if (data != nil and data.has("packages")) {
            search_results.set(data.get("packages"))
        }
        is_loading.set(false)
    })
}

fun load_package_detail(name: String) {
    detail_name.set(name)
    router.go("/packages/" + name)
    is_loading.set(true)
    fetch_json("/api/v1/packages/" + name, fun (json_str: String) => {
        var data = JSON.parse(json_str)
        if (data != nil) {
            detail_name.set(data.get("name"))
            var versions = data.get("versions")
            detail_versions.set(versions)
            if (versions.length() > 0) {
                var latest = versions[versions.length() - 1]
                detail_latest.set(latest.get("vers"))
                if (latest.has("description")) {
                    detail_description.set(latest.get("description"))
                } else {
                    detail_description.set("")
                }
            }
        }
        is_loading.set(false)
    })
}

fun navigate_home() {
    router.go("/")
    search_query.set("")
    load_featured()
}

// =============================================================================
// Components
// =============================================================================

fun PackageCard(pkg: Map<String, String>) {
    var name: String = pkg.get("name")
    var version: String = ""
    if (pkg.has("latest")) { version = pkg.get("latest") }
    if (pkg.has("vers")) { version = pkg.get("vers") }
    var description: String = ""
    if (pkg.has("description")) { description = pkg.get("description") }

    <div class="bg-navy-800 border border-gray-700 rounded-lg p-5 hover:border-saffron-400 hover:-translate-y-0.5 transition-all cursor-pointer" on_click={fun (e: Event) => load_package_detail(name)}>
        <div class="flex items-center justify-between mb-2">
            <h2 class="text-lg font-bold text-white">{name}</h2>
            <span class="text-xs font-mono bg-gray-700 text-saffron-400 px-2 py-0.5 rounded">v{version}</span>
        </div>
        {if (description.length() > 0) {
            <p class="text-sm text-gray-400 mb-3">{description}</p>
        }}
        <div class="font-mono text-xs bg-navy-950 text-gray-300 px-3 py-2 rounded border border-gray-700">
            <code>pantry add {name}</code>
        </div>
    </div>
}

fun SearchBar() {
    <form class="w-full max-w-2xl mx-auto mb-8" on_submit={fun (e: Event) => do_search()}>
        <div class="flex gap-2">
            <input
                class="flex-1 px-4 py-3 bg-navy-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-saffron-400 focus:ring-1 focus:ring-saffron-400 transition-all"
                type="text"
                placeholder="Search packages..."
                on_input={fun (e: Event) => search_query.set(e.target_value)}
            />
            <button class="px-6 py-3 bg-saffron-500 hover:bg-saffron-400 text-navy-900 font-bold rounded-lg transition-colors" type="submit">
                Search
            </button>
        </div>
    </form>
}

fun NavBar() {
    <nav class="sticky top-0 z-50 bg-navy-900/80 backdrop-blur border-b border-gray-800">
        <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
            <a class="text-xl font-extrabold bg-gradient-to-r from-saffron-400 to-orange-500 bg-clip-text text-transparent cursor-pointer" on_click={fun (e: Event) => navigate_home()}>
                Bazaar
            </a>
            <div class="flex items-center gap-5">
                <a class="text-sm text-gray-400 hover:text-white transition-colors" href="https://saffron-lang.org/docs">Docs</a>
                <a class="text-sm text-gray-400 hover:text-white transition-colors" href="https://github.com/henry232323/saffron">GitHub</a>
                <a class="text-sm font-medium bg-saffron-500/10 text-saffron-400 hover:bg-saffron-500/20 px-3 py-1.5 rounded-md transition-colors cursor-pointer">Publish</a>
                <a class="text-sm text-gray-400 hover:text-white transition-colors cursor-pointer">Login</a>
            </div>
        </div>
    </nav>
}

fun HomePage() {
    <div class="min-h-screen">
        <header class="text-center py-16">
            <h1 class="text-5xl font-extrabold bg-gradient-to-r from-saffron-400 to-orange-500 bg-clip-text text-transparent mb-3">Bazaar</h1>
            <p class="text-lg text-gray-400">The Saffron package registry</p>
        </header>
        {SearchBar()}
        <section class="max-w-4xl mx-auto px-6">
            <h3 class="text-sm uppercase tracking-wider text-gray-500 mb-4">All Packages</h3>
            <div class="grid gap-4">
                {var pkgs = featured_packages.get()
                var i: Float = 0
                while (i < pkgs.length()) {
                    PackageCard(pkgs[i])
                    i = i + 1
                }
                if (pkgs.length() == 0 and !is_loading.get()) {
                    <p class="text-center text-gray-500 py-12">No packages published yet. Be the first!</p>
                }}
            </div>
        </section>
    </div>
}

fun SearchResultsPage() {
    <div class="min-h-screen max-w-4xl mx-auto px-6 py-8">
        {SearchBar()}
        <section>
            <h3 class="text-sm uppercase tracking-wider text-gray-500 mb-4">
                Search results for "{search_query.get()}"
            </h3>
            <div class="grid gap-4">
                {var pkgs = search_results.get()
                var i: Float = 0
                while (i < pkgs.length()) {
                    PackageCard(pkgs[i])
                    i = i + 1
                }
                if (pkgs.length() == 0 and !is_loading.get()) {
                    <p class="text-center text-gray-500 py-12">No packages found matching your query.</p>
                }}
            </div>
        </section>
    </div>
}

fun PackageDetailPage() {
    var name: String = detail_name.get()
    var latest: String = detail_latest.get()
    var description: String = detail_description.get()
    var versions = detail_versions.get()

    <div class="min-h-screen max-w-4xl mx-auto px-6 py-8">
        <a class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-saffron-400 transition-colors mb-6 cursor-pointer" on_click={fun (e: Event) => navigate_home()}>
            ← Back to packages
        </a>

        <div class="flex items-center gap-4 mb-4">
            <h1 class="text-3xl font-bold text-white">{name}</h1>
            <span class="text-sm font-mono bg-gray-700 text-saffron-400 px-3 py-1 rounded">v{latest}</span>
        </div>

        {if (description.length() > 0) {
            <p class="text-gray-400 text-lg mb-6">{description}</p>
        }}

        <div class="mb-8">
            <h3 class="text-sm uppercase tracking-wider text-gray-500 mb-2">Install</h3>
            <div class="bg-navy-800 border border-gray-700 rounded-lg p-4 font-mono text-sm text-gray-200">
                <code>pantry add {name}</code>
            </div>
        </div>

        {if (versions.length() > 0) {
            <section>
                <h3 class="text-sm uppercase tracking-wider text-gray-500 mb-3">
                    Versions ({versions.length().to_string()})
                </h3>
                <div class="space-y-2">
                    {var i: Float = versions.length() - 1
                    while (i >= 0) {
                        var v = versions[i]
                        <div class="flex items-center justify-between py-2 px-4 bg-navy-800 rounded border border-gray-700/50">
                            <span class="font-mono text-sm text-white">{v.get("vers")}</span>
                            {if (v.has("yanked") and v.get("yanked") == "true") {
                                <span class="text-xs bg-red-900/50 text-red-400 px-2 py-0.5 rounded">yanked</span>
                            }}
                        </div>
                        i = i - 1
                    }}
                </div>
            </section>
        }}
    </div>
}

fun LoadingIndicator() {
    if (is_loading.get()) {
        <div class="flex items-center justify-center py-12 gap-3">
            <div class="w-5 h-5 border-2 border-saffron-400 border-t-transparent rounded-full animate-spin"></div>
            <span class="text-gray-400 text-sm">Loading...</span>
        </div>
    }
}

// =============================================================================
// App
// =============================================================================

fun App() {
    <div id="bazaar-app" class="min-h-screen flex flex-col">
        {NavBar()}
        <div class="flex-1">
            {LoadingIndicator()}
            {router.render()}
        </div>
        <footer class="border-t border-gray-800 py-6 text-center">
            <p class="text-sm text-gray-500">Bazaar — the Saffron package registry</p>
            <p class="text-xs text-gray-600 mt-1">Built with Saffron + Turmeric</p>
        </footer>
    </div>
}

// =============================================================================
// Routes
// =============================================================================

router.route("/", fun (p: Router.RouteParams) => HomePage())
router.route("/search", fun (p: Router.RouteParams) => SearchResultsPage())
router.route("/packages/:name", fun (p: Router.RouteParams) => {
    load_package_detail(p.get("name"))
    PackageDetailPage()
})

// =============================================================================
// Entry
// =============================================================================

load_featured()
App()
