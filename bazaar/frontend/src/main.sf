fun SearchResultsPage() {
    var query = search_results_query.get()
    var total_str: String = "0"
    var pkg_count: Float = 0
    if (query != nil and query.data.get() != nil) {
        var qdata = query.data.get()
        if (qdata.has("total")) { total_str = qdata.get("total").to_string() }
    }

    <div>
        {NavBarWithSearch()}

        <div cls="tab-strip">
            <div cls="tab on" on_click={fun (e: Event) => search_category("")}>All</div>
            <div cls="tab" on_click={fun (e: Event) => search_category("library")}>Libraries</div>
            <div cls="tab" on_click={fun (e: Event) => search_category("cli")}>CLI Tools</div>
            <div cls="tab" on_click={fun (e: Event) => search_category("util")}>Utilities</div>
            <div cls="tab-r">
                <span cls="result-ct">{total_str} results</span>
            </div>
        </div>

        {LoadingIndicator(query)}

        <div cls="layout">
            {SearchSidebar()}

            <main cls="results">
                <p cls="result-hd">
                    {text("Showing results for \"")}
                    <strong>{text(search_query.get())}</strong>
                    {text("\"")}
                </p>
                {if (query != nil) {
                    var data = query.data.get()
                    if (data != nil and data.has("packages")) {
                        var pkgs = data.get("packages")
                        var i: Float = 0
                        while (i < pkgs.length()) {
                            PackageRow(pkgs[i])
                            i = i + 1
                        }
                        if (pkgs.length() == 0 and !query.isLoading.get()) {
                            <div cls="empty-state">No packages found matching your query.</div>
                        }
                    }
                }}

                <div cls="pager">
                    <div cls="page-btn on">1</div>
                </div>
            </main>
        </div>

        {Footer()}
    </div>
}

// =============================================================================
// Pages — Package Detail
// =============================================================================

fun PackageDetailContent(pkg_name: String, data: Any, description: String, latest: String, versions: List<Any>) {
    var display_name: String = pkg_name
    if (display_name.length() == 0) { display_name = "unknown-pkg" }
    var license_str: String = ""
    if (data.has("license")) { license_str = data.get("license").to_string() }
    var downloads_str: String = ""
    if (data.has("total_downloads")) { downloads_str = data.get("total_downloads").to_string() }
    var ver_count_str: String = versions.length().to_string()

    <div cls="pkg-header">
        <div cls="pkg-header-inner">
            <div cls="pkg-header-top">
                <div cls="pkg-header-ico">{text(display_name.char_at(0))}</div>
                <div>
                    <div cls="pkg-header-title-row">
                        <h1 cls="pkg-header-title">{text(display_name)}</h1>
                        <span cls="ver">{text(latest)}</span>
                    </div>
                    {if (description.length() > 0) {
                        <p cls="pkg-header-desc">{text(description)}</p>
                    }}
                    <div cls="pkg-header-stats">
                        <span cls="pkg-hstat">{text("License: " + license_str)}</span>
                        <span cls="pkg-hstat-sep">{text("·")}</span>
                        <span cls="pkg-hstat">{text(ver_count_str + " versions")}</span>
                        <span cls="pkg-hstat-sep">{text("·")}</span>
                        <span cls="pkg-hstat">{text(downloads_str + " downloads")}</span>
                    </div>
                    <div cls="pkg-install">
                        <code>{text("pantry add " + display_name)}</code>
                        <button cls="pkg-copy">COPY</button>
                    </div>
                </div>
            </div>
            <div cls="pkg-tabs">
                <div cls="pkg-tab on">Readme</div>
                <div cls="pkg-tab">Versions</div>
                <div cls="pkg-tab">Dependencies</div>
            </div>
        </div>
    </div>

    <div cls="detail-layout">
        <article cls="readme">
            <h2>Installation</h2>
            <pre><code>{text("pantry add " + display_name)}</code></pre>
            {if (description.length() > 0) {
                <div>
                    <h2>About</h2>
                    <p>{text(description)}</p>
                </div>
            }}
        </article>

        <aside cls="meta-sidebar">
            <div cls="meta-card">
                <span cls="meta-title">About</span>
                <div cls="meta-row">
                    <span cls="meta-key">Version</span>
                    <span cls="meta-val mono">{text(latest)}</span>
                </div>
                <div cls="meta-row">
                    <span cls="meta-key">License</span>
                    <span cls="meta-val">{text(license_str)}</span>
                </div>
                <div cls="meta-row">
                    <span cls="meta-key">Downloads</span>
                    <span cls="meta-val">{text(downloads_str)}</span>
                </div>
                <div cls="meta-row">
                    <span cls="meta-key">Versions</span>
                    <span cls="meta-val">{text(ver_count_str)}</span>
                </div>
                {if (data.has("repository") and data.get("repository").length() > 0) {
                    <div cls="meta-row">
                        <span cls="meta-key">Repository</span>
                        <span cls="meta-val">{text(data.get("repository").to_string())}</span>
                    </div>
                }}
            </div>

            {if (versions.length() > 0) {
                <div cls="meta-card">
                    <span cls="meta-title">Version history</span>
                    {var i: Float = versions.length() - 1
                    while (i >= 0 and i > versions.length() - 6) {
                        var v = versions[i]
                        <div cls="ver-row">
                            <span cls="ver-row-num">{text(v.get("vers"))}</span>
                            {if (i == versions.length() - 1) {
                                <span cls="ver-row-cur">CURRENT</span>
                            }}
                        </div>
                        i = i - 1
                    }}
                </div>
            }}
        </aside>
    </div>
}

fun _extract_pkg_name(path: String): String {
    // Extract name from "/packages/<name>" path
    var parts: List<String> = path.split("/")
    // parts: ["", "packages", "<name>"] or ["packages", "<name>"]
    var i: Float = 0
    while (i < parts.length()) {
        if (parts[i] == "packages" and i + 1 < parts.length()) {
            return parts[i + 1]
        }
        i = i + 1
    }
    return _detail_name_raw
}

fun PackageDetailPage() {
    var query = detail_query.get()

    <div>
        {NavBarWithSearch()}

        {if (query != nil and query.data.get() != nil) {
            var data = query.data.get()
            var name: String = _detail_name_raw
            if (name.length() == 0) { name = detail_name_sig.get() }
            if (name.length() == 0) { name = _extract_pkg_name(router.current()) }
            var latest: String = ""
            var description: String = ""
            var versions = []
            if (data.has("description")) { description = data.get("description") }
            if (data.has("versions")) {
                versions = data.get("versions")
                if (versions.length() > 0) {
                    latest = versions[versions.length() - 1].get("vers")
                }
            }

            {PackageDetailContent(name, data, description, latest, versions)}
        } else {
            LoadingIndicator(query)
        }}

        {Footer()}
    </div>
}

// =============================================================================
// Pages — Login / Register
// =============================================================================

fun LoginPage() {
    var register_mutation = Api.createAuthRegister()

    fun do_register() {
        var username: String = login_username_input.get()
        if (username.length() == 0) {
            login_auth_error.set("Please enter a username")
            return
        }
        login_is_loading.set(true)
        login_auth_error.set("")
        register_mutation.on_success(fun (data: Any) => {
            login_is_loading.set(false)
            if (data.has("token")) {
                var token: String = data.get("token")
                var uname: String = data.get("username")
                auth_token_global.set(token)
                auth_username_global.set(uname)
                login_auth_token_display.set(token)
            } else if (data.has("error")) {
                login_auth_error.set(data.get("error"))
            }
        })
        register_mutation.mutate({"username": username})
    }

    <div>
        {NavBar()}

        <div cls="page-container">
            <div cls="auth-card">
                <div cls="auth-header">
                    <div cls="auth-ico">B</div>
                    <h1 cls="auth-title">Sign in to Bazaar</h1>
                    <p cls="auth-desc">Get a token for publishing packages</p>
                </div>

                {if (login_auth_token_display.get().length() > 0) {
                    <div cls="token-display">
                        <div cls="token-success-ico">&#10003;</div>
                        <p cls="token-label">Your API token:</p>
                        <pre cls="token-value"><code>{login_auth_token_display.get()}</code></pre>
                        <p cls="token-hint">Save this token! Use it with:</p>
                        <pre cls="token-cmd"><code>pantry login {login_auth_token_display.get()}</code></pre>
                        {Router.Link(router, "/", cls="btn-primary") { text("Go to Home") }}
                    </div>
                } else {
                    <form cls="auth-form" on_submit={fun (e: Event) => do_register()}>
                        <div cls="form-group">
                            <label cls="form-label">Username</label>
                            <input cls="form-input" type="text" placeholder="your-username" on_input={fun (e: Event) => login_username_input.set(event_target_value())} />
                        </div>
                        {if (login_auth_error.get().length() > 0) {
                            <div cls="form-error">{login_auth_error.get()}</div>
                        }}
                        <button cls="btn-primary" type="submit">
                            {if (login_is_loading.get()) { text("Registering...") } else { text("Get Token") }}
                        </button>
                    </form>
                }}

                <p cls="auth-footer-text">
                    Bazaar uses token-based authentication. No password needed.
                </p>
            </div>
        </div>

        {Footer()}
    </div>
}

// =============================================================================
// Pages — Publish
// =============================================================================

fun PublishPage() {
    var publish_mutation = Api.createPublish()

    fun do_publish() {
        var name: String = publish_pkg_name.get()
        var vers: String = publish_pkg_version.get()
        var description: String = publish_pkg_description.get()
        var tarball: String = publish_pkg_tarball.get()

        if (name.length() == 0) {
            publish_error.set("Package name is required")
            return
        }
        if (vers.length() == 0) {
            publish_error.set("Version is required")
            return
        }

        publish_is_loading.set(true)
        publish_error.set("")
        publish_success.set("")

        publish_mutation.on_success(fun (data: Any) => {
            publish_is_loading.set(false)
            if (data.has("error")) {
                publish_error.set(data.get("error"))
            } else {
                publish_success.set("Published " + publish_pkg_name.get() + " v" + publish_pkg_version.get() + " successfully!")
                publish_pkg_name.set("")
                publish_pkg_version.set("")
                publish_pkg_description.set("")
                publish_pkg_tarball.set("")
            }
        })

        var token: String = auth_token_global.get()
        publish_mutation.mutate_auth(
            {"name": name, "vers": vers, "description": description, "tarball": tarball},
            token
        )
    }

    <div>
        {NavBar()}

        <div cls="page-container">
            <div cls="publish-card">
                <div cls="auth-header">
                    <h1 cls="auth-title">Publish a Package</h1>
                    <p cls="auth-desc">Share your Saffron package with the community</p>
                </div>

                {if (auth_token_global.get().length() == 0) {
                    <div cls="auth-required">
                        <div cls="auth-required-ico">!</div>
                        <p cls="auth-required-text">You need to sign in before publishing</p>
                        {Router.Link(router, "/login", cls="btn-primary") { text("Sign in") }}
                    </div>
                } else {
                    <div>
                        {if (publish_success.get().length() > 0) {
                            <div cls="publish-success">
                                <div cls="token-success-ico">&#10003;</div>
                                <p>{publish_success.get()}</p>
                                {Router.Link(router, "/", cls="btn-secondary") { text("View packages") }}
                            </div>
                        }}

                        {if (publish_success.get().length() == 0) {
                            <form cls="auth-form" on_submit={fun (e: Event) => do_publish()}>
                                <div cls="form-group">
                                    <label cls="form-label">Package Name</label>
                                    <input cls="form-input" type="text" placeholder="my-package" on_input={fun (e: Event) => publish_pkg_name.set(event_target_value())} />
                                </div>
                                <div cls="form-group">
                                    <label cls="form-label">Version</label>
                                    <input cls="form-input" type="text" placeholder="1.0.0" on_input={fun (e: Event) => publish_pkg_version.set(event_target_value())} />
                                </div>
                                <div cls="form-group">
                                    <label cls="form-label">Description</label>
                                    <input cls="form-input" type="text" placeholder="A useful Saffron package" on_input={fun (e: Event) => publish_pkg_description.set(event_target_value())} />
                                </div>
                                <div cls="form-group">
                                    <label cls="form-label">Tarball (base64)</label>
                                    <input cls="form-input" type="text" placeholder="Base64-encoded package tarball" on_input={fun (e: Event) => publish_pkg_tarball.set(event_target_value())} />
                                    <span cls="form-hint">Paste base64-encoded .tar.gz content</span>
                                </div>
                                {if (publish_error.get().length() > 0) {
                                    <div cls="form-error">{publish_error.get()}</div>
                                }}
                                <button cls="btn-primary" type="submit">
                                    {if (publish_is_loading.get()) { text("Publishing...") } else { text("Publish") }}
                                </button>
                            </form>
                        }}
                    </div>
                }}
            </div>
        </div>

        {Footer()}
    </div>
}

// =============================================================================
// App + Routes
// =============================================================================

fun App() {
    router.render("#app")
}

router.route("/", fun (p: Router.RouteParams) => HomePage())
router.route("/search", fun (p: Router.RouteParams) => {
    var q: String = p.query_get("q")
    if (q.length() > 0) {
        search_query.set(q)
        search_results_query.set(Api.searchPackages(q))
    }
    SearchResultsPage()
})
router.route("/packages/:name", fun (p: Router.RouteParams) => {
    var name: String = p.get("name")
    _detail_name_raw = name
    detail_name_sig.set(name)
    detail_query.set(Api.getPackage(name))
    PackageDetailPage()
})
router.route("/login", fun (p: Router.RouteParams) => LoginPage())
router.route("/publish", fun (p: Router.RouteParams) => PublishPage())

// =============================================================================
// Entry
// =============================================================================

mount("#app", fun () => App())
