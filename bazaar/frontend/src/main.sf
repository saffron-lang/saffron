//! Bazaar Frontend — Single-page app for the Saffron package registry
//! Built with Turmeric (reactive WASM framework)

import { signal, computed, effect, batch } from "turmeric/signal"
import { div, h1, h2, h3, p, span, input, button, ul, li, a, nav, section, header, footer, form, code, pre } from "turmeric/generated_types"
import { class_, id, placeholder, href, type_ } from "turmeric/generated_types"
import { on_click, on_input, on_submit, on_keydown } from "turmeric/generated_types"
import { text, _el } from "turmeric/element"
import { Signal } from "turmeric/signal"

// =============================================================================
// FFI — fetch from the same-origin API
// =============================================================================

@extern("void js_fetch_json(void*, i64)") fun _fetch_json(url: String, callback_id: Float)

// Callback registry for fetch responses
var _fetch_next_id: Float = 0
var _fetch_callbacks: Map<Float, (String) => Nil> = {}

fun fetch_json(url: String, callback: (String) => Nil) {
    _fetch_next_id = _fetch_next_id + 1
    var id: Float = _fetch_next_id
    _fetch_callbacks.set(id, callback)
    _fetch_json(url, id)
}

// Called from JS when fetch completes
fun __on_fetch_complete(id: Float, json_str: String) {
    if (_fetch_callbacks.has(id)) {
        _fetch_callbacks.get(id)(json_str)
        _fetch_callbacks.set(id, nil)
    }
}

// =============================================================================
// Application State
// =============================================================================

// Current page: "home", "search", "detail"
var current_page: Signal<String> = signal("home")

// Search state
var search_query: Signal<String> = signal("")
var search_results: Signal<List<Map<String, String>>> = signal([])
var is_loading: Signal<Bool> = signal(false)

// Package detail state
var detail_name: Signal<String> = signal("")
var detail_versions: Signal<List<Map<String, String>>> = signal([])
var detail_description: Signal<String> = signal("")
var detail_latest: Signal<String> = signal("")

// Featured packages (loaded on home)
var featured_packages: Signal<List<Map<String, String>>> = signal([])

// =============================================================================
// API Calls
// =============================================================================

fun load_featured() {
    is_loading.set(true)
    fetch_json("/api/v1/packages", fun (json_str: String) => {
        var data: Map<String, Any> = JSON.parse(json_str)
        if (data != nil and data.has("packages")) {
            featured_packages.set(data.get("packages"))
        }
        is_loading.set(false)
    })
}

fun do_search() {
    var q: String = search_query.get()
    if (q.length() == 0) {
        load_featured()
        current_page.set("home")
        return
    }
    is_loading.set(true)
    current_page.set("search")
    fetch_json("/api/v1/search?q=" + q, fun (json_str: String) => {
        var data: Map<String, Any> = JSON.parse(json_str)
        if (data != nil and data.has("packages")) {
            search_results.set(data.get("packages"))
        }
        is_loading.set(false)
    })
}

fun load_package_detail(name: String) {
    detail_name.set(name)
    current_page.set("detail")
    is_loading.set(true)
    fetch_json("/api/v1/packages/" + name, fun (json_str: String) => {
        var data: Map<String, Any> = JSON.parse(json_str)
        if (data != nil) {
            detail_name.set(data.get("name"))
            var versions: List<Map<String, String>> = data.get("versions")
            detail_versions.set(versions)
            if (versions.length() > 0) {
                var latest: Map<String, String> = versions[versions.length() - 1]
                detail_latest.set(latest.get("vers"))
                if (latest.has("description")) {
                    detail_description.set(latest.get("description"))
                } else {
                    detail_description.set("")
                }
            }
        }
        is_loading.set(false)
    })
}

fun navigate_home() {
    current_page.set("home")
    search_query.set("")
    load_featured()
}

// =============================================================================
// Components
// =============================================================================

fun PackageCard(pkg: Map<String, String>) {
    var name: String = pkg.get("name")
    var version: String = ""
    if (pkg.has("latest")) { version = pkg.get("latest") }
    if (pkg.has("vers")) { version = pkg.get("vers") }
    var description: String = ""
    if (pkg.has("description")) { description = pkg.get("description") }

    div([class_("bg-navy-800 border border-gray-700 rounded-lg p-5 hover:border-saffron-400 hover:-translate-y-0.5 transition-all cursor-pointer"), on_click(fun (e) => {
        load_package_detail(name)
    })]) {
        div([class_("flex items-center justify-between mb-2")]) {
            h2([class_("text-lg font-bold text-white")]) {
                text(name)
            }
            span([class_("text-xs font-mono bg-gray-700 text-saffron-400 px-2 py-0.5 rounded")]) {
                text("v" + version)
            }
        }
        if (description.length() > 0) {
            p([class_("text-sm text-gray-400 mb-3")]) {
                text(description)
            }
        }
        div([class_("font-mono text-xs bg-navy-950 text-gray-300 px-3 py-2 rounded border border-gray-700")]) {
            code([]) {
                text("pantry add " + name)
            }
        }
    }
}

fun SearchBar() {
    form([class_("w-full max-w-2xl mx-auto mb-8"), on_submit(fun (e) => {
        do_search()
    })]) {
        div([class_("flex gap-2")]) {
            input([
                class_("flex-1 px-4 py-3 bg-navy-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-saffron-400 focus:ring-1 focus:ring-saffron-400 transition-all"),
                type_("text"),
                placeholder("Search packages..."),
                on_input(fun (e) => {
                    search_query.set(e.value)
                })
            ]) {}
            button([class_("px-6 py-3 bg-saffron-500 hover:bg-saffron-400 text-navy-900 font-bold rounded-lg transition-colors"), type_("submit")]) {
                text("Search")
            }
        }
    }
}

fun NavBar() {
    nav([class_("sticky top-0 z-50 bg-navy-900/80 backdrop-blur border-b border-gray-800")]) {
        div([class_("max-w-6xl mx-auto px-6 py-3 flex items-center justify-between")]) {
            a([class_("text-xl font-extrabold bg-gradient-to-r from-saffron-400 to-orange-500 bg-clip-text text-transparent cursor-pointer"), on_click(fun (e) => {
                navigate_home()
            })]) {
                text("Bazaar")
            }
            div([class_("flex items-center gap-5")]) {
                a([class_("text-sm text-gray-400 hover:text-white transition-colors"), href("https://saffron-lang.org/docs")]) {
                    text("Docs")
                }
                a([class_("text-sm text-gray-400 hover:text-white transition-colors"), href("https://github.com/henry232323/saffron")]) {
                    text("GitHub")
                }
                a([class_("text-sm font-medium bg-saffron-500/10 text-saffron-400 hover:bg-saffron-500/20 px-3 py-1.5 rounded-md transition-colors cursor-pointer")]) {
                    text("Publish")
                }
                a([class_("text-sm text-gray-400 hover:text-white transition-colors cursor-pointer")]) {
                    text("Login")
                }
            }
        }
    }
}

fun HomePage() {
    div([class_("min-h-screen")]) {
        header([class_("text-center py-16")]) {
            h1([class_("text-5xl font-extrabold bg-gradient-to-r from-saffron-400 to-orange-500 bg-clip-text text-transparent mb-3")]) {
                text("Bazaar")
            }
            p([class_("text-lg text-gray-400")]) {
                text("The Saffron package registry")
            }
        }
        SearchBar()
        section([class_("max-w-4xl mx-auto px-6")]) {
            h3([class_("text-sm uppercase tracking-wider text-gray-500 mb-4")]) {
                text("All Packages")
            }
            div([class_("grid gap-4")]) {
                var pkgs: List<Map<String, String>> = featured_packages.get()
                var i: Float = 0
                while (i < pkgs.length()) {
                    PackageCard(pkgs[i])
                    i = i + 1
                }
                if (pkgs.length() == 0 and !is_loading.get()) {
                    p([class_("text-center text-gray-500 py-12")]) {
                        text("No packages published yet. Be the first!")
                    }
                }
            }
        }
    }
}

fun SearchResultsPage() {
    div([class_("min-h-screen max-w-4xl mx-auto px-6 py-8")]) {
        SearchBar()
        section([]) {
            h3([class_("text-sm uppercase tracking-wider text-gray-500 mb-4")]) {
                text("Search results for \"" + search_query.get() + "\"")
            }
            div([class_("grid gap-4")]) {
                var pkgs: List<Map<String, String>> = search_results.get()
                var i: Float = 0
                while (i < pkgs.length()) {
                    PackageCard(pkgs[i])
                    i = i + 1
                }
                if (pkgs.length() == 0 and !is_loading.get()) {
                    p([class_("text-center text-gray-500 py-12")]) {
                        text("No packages found matching your query.")
                    }
                }
            }
        }
    }
}

fun PackageDetailPage() {
    var name: String = detail_name.get()
    var latest: String = detail_latest.get()
    var description: String = detail_description.get()
    var versions: List<Map<String, String>> = detail_versions.get()

    div([class_("min-h-screen max-w-4xl mx-auto px-6 py-8")]) {
        // Back navigation
        a([class_("inline-flex items-center gap-1 text-sm text-gray-400 hover:text-saffron-400 transition-colors mb-6 cursor-pointer"), on_click(fun (e) => {
            navigate_home()
        })]) {
            text("← Back to packages")
        }

        // Package header
        div([class_("flex items-center gap-4 mb-4")]) {
            h1([class_("text-3xl font-bold text-white")]) {
                text(name)
            }
            span([class_("text-sm font-mono bg-gray-700 text-saffron-400 px-3 py-1 rounded")]) {
                text("v" + latest)
            }
        }

        if (description.length() > 0) {
            p([class_("text-gray-400 text-lg mb-6")]) {
                text(description)
            }
        }

        // Install command
        div([class_("mb-8")]) {
            h3([class_("text-sm uppercase tracking-wider text-gray-500 mb-2")]) { text("Install") }
            div([class_("bg-navy-800 border border-gray-700 rounded-lg p-4 font-mono text-sm text-gray-200 flex items-center justify-between")]) {
                code([]) {
                    text("pantry add " + name)
                }
                button([class_("text-xs text-gray-500 hover:text-saffron-400 transition-colors ml-4"), on_click(fun (e) => {})]) {
                    text("Copy")
                }
            }
        }

        // Version history
        if (versions.length() > 0) {
            section([]) {
                h3([class_("text-sm uppercase tracking-wider text-gray-500 mb-3")]) {
                    text("Versions (" + versions.length().to_string() + ")")
                }
                div([class_("space-y-2")]) {
                    var i: Float = versions.length() - 1
                    while (i >= 0) {
                        var v: Map<String, String> = versions[i]
                        div([class_("flex items-center justify-between py-2 px-4 bg-navy-800 rounded border border-gray-700/50")]) {
                            span([class_("font-mono text-sm text-white")]) {
                                text(v.get("vers"))
                            }
                            if (v.has("yanked") and v.get("yanked") == "true") {
                                span([class_("text-xs bg-red-900/50 text-red-400 px-2 py-0.5 rounded")]) {
                                    text("yanked")
                                }
                            }
                        }
                        i = i - 1
                    }
                }
            }
        }
    }
}

fun LoadingIndicator() {
    if (is_loading.get()) {
        div([class_("flex items-center justify-center py-12 gap-3")]) {
            div([class_("w-5 h-5 border-2 border-saffron-400 border-t-transparent rounded-full animate-spin")]) {}
            span([class_("text-gray-400 text-sm")]) {
                text("Loading...")
            }
        }
    }
}

// =============================================================================
// App Root
// =============================================================================

fun App() {
    div([id("bazaar-app"), class_("min-h-screen flex flex-col")]) {
        NavBar()
        div([class_("flex-1")]) {
            LoadingIndicator()
            var page: String = current_page.get()
            if (page == "home") {
                HomePage()
            }
            if (page == "search") {
                SearchResultsPage()
            }
            if (page == "detail") {
                PackageDetailPage()
            }
        }
        footer([class_("border-t border-gray-800 py-6 text-center")]) {
            p([class_("text-sm text-gray-500")]) {
                text("Bazaar — the Saffron package registry")
            }
            p([class_("text-xs text-gray-600 mt-1")]) {
                text("Built with Saffron + Turmeric")
            }
        }
    }
}

// =============================================================================
// Entry Point
// =============================================================================

fun main() {
    // Load featured packages on startup
    load_featured()
    // Mount the app
    App()
}

main()
