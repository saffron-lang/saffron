//! Bazaar Frontend — Package registry SPA
//! Built with Turmeric + Basil (auto-caching queries)

import { signal, computed, effect } from "turmeric/signal"
import { Event } from "turmeric/events"
import "turmeric/router" as Router
import { div, span, p, a, b, strong, pre, h1, h2, nav, footer, section, form, input, button, code, text, main, aside, article, select, option, label, mount, event_target_value, render_into } from "turmeric/prelude"
import "./api.sf" as Api

// =============================================================================
// State
// =============================================================================

var router = Router.hash()
var search_query = signal("")
var search_suggestions = signal([])

// Auth state — persists across page navigations
var auth_token_global = signal("")
var auth_username_global = signal("")
var is_logged_in = signal(false)

// Basil queries — auto-caching, signal-based
var packages_query = Api.getPackages()
var search_q = signal("")
var detail_name_sig = signal("")
var _detail_name_raw: String = ""

// Derived queries (re-created when params change)
var search_results_query = signal(nil)
var detail_query = signal(nil)

// Login page state
var login_username_input = signal("")
var login_password_input = signal("")
var login_auth_error = signal("")
var login_has_error = signal(false)
var login_auth_token_display = signal("")
var login_has_token = signal(false)
var login_is_loading = signal(false)
var login_is_register_mode = signal(true)

// Publish page state
var publish_pkg_name = signal("")
var publish_pkg_version = signal("")
var publish_pkg_description = signal("")
var publish_pkg_tarball = signal("")
var publish_error = signal("")
var publish_has_error = signal(false)
var publish_success = signal("")
var publish_has_success = signal(false)
var publish_is_loading = signal(false)

// =============================================================================
// Actions
// =============================================================================

fun do_search() {
    var q: String = search_query.get()
    if (q.length() == 0) {
        packages_query.refetch()
        router.go("/")
        return
    }
    router.go("/search?q=" + q)
    search_results_query.set(Api.searchPackages(q))
}

fun update_suggestions(q: String) {
    if (q.length() < 2) {
        search_suggestions.set([])
        return
    }
    var data = packages_query.data.get()
    if (data != nil and data.has("packages")) {
        var pkgs = data.get("packages")
        var matches = []
        var i: Float = 0
        while (i < pkgs.length()) {
            var pkg_name: String = pkgs[i].get("name")
            if (pkg_name.contains(q)) {
                matches.push(pkg_name)
            }
            i = i + 1
        }
        search_suggestions.set(matches)
    }
}

fun search_category(cat: String) {
    search_query.set(cat)
    do_search()
}

fun load_package_detail(name: String) {
    detail_name_sig.set(name)
    detail_query.set(Api.getPackage(name))
    router.go("/packages/" + name)
}

fun navigate_home() {
    router.go("/")
    search_query.set("")
    packages_query.refetch()
}

// =============================================================================
// Components — Shared
// =============================================================================

fun NavBar() {
    <nav cls="nav">
        {Router.Link(router, "/", cls="nav-brand") { text("Bazaar") }}
        {Router.Link(router, "/search?q=", cls="nav-link") { text("Browse") }}
        <a cls="nav-link">Docs</a>
        <div cls="nav-r">
            {if (is_logged_in.get()) {
                {Router.Link(router, "/publish", cls="btn-a") { text("Publish") }}
                <span cls="nav-user">{auth_username_global.get()}</span>
            } else {
                {Router.Link(router, "/login", cls="btn-g") { text("Sign in") }}
                {Router.Link(router, "/publish", cls="btn-a") { text("Publish") }}
            }}
        </div>
    </nav>
}

fun NavBarWithSearch() {
    <nav cls="nav">
        {Router.Link(router, "/", cls="nav-brand") { text("Bazaar") }}
        {Router.Link(router, "/search?q=", cls="nav-link on") { text("Browse") }}
        <a cls="nav-link">Docs</a>
        <div cls="search-wrapper">
            <form cls="nav-search" on_submit={fun (e: Event) => { search_suggestions.set([]); do_search() }}>
                <input type="text" placeholder="Search packages..." value={search_query.get()} on_input={fun (e: Event) => { search_query.set(event_target_value()); update_suggestions(event_target_value()) }} on_blur={fun (e: Event) => search_suggestions.set([])} />
                <button cls="nav-search-btn" type="submit">→</button>
            </form>
            {if (search_suggestions.get().length() > 0) {
                <div cls="autocomplete">
                    {var items = search_suggestions.get()
                    var i: Float = 0
                    while (i < items.length()) {
                        var suggestion: String = items[i]
                        {Router.Link(router, "/packages/" + suggestion, cls="autocomplete-item") { text(suggestion) }}
                        i = i + 1
                    }}
                </div>
            }}
        </div>
        <div cls="nav-r">
            {if (is_logged_in.get()) {
                {Router.Link(router, "/publish", cls="btn-a") { text("Publish") }}
                <span cls="nav-user">{auth_username_global.get()}</span>
            } else {
                {Router.Link(router, "/login", cls="btn-g") { text("Sign in") }}
                {Router.Link(router, "/publish", cls="btn-a") { text("Publish") }}
            }}
        </div>
    </nav>
}

fun Footer() {
    <footer cls="footer">
        {Router.Link(router, "/", cls="footer-brand") { text("Bazaar") }}
        <div cls="footer-links">
            <a cls="footer-link">Docs</a>
            <a cls="footer-link">Status</a>
            <a cls="footer-link" href="https://github.com/henry232323/saffron">GitHub</a>
            <a cls="footer-link">Terms</a>
        </div>
        <span cls="footer-t">© 2026 Bazaar Registry</span>
    </footer>
}

fun LoadingIndicator(query: Any) {
    if (query != nil and query.isLoading.get()) {
        <div cls="loading">
            <div cls="spinner"></div>
            <span>Loading...</span>
        </div>
    }
}

// =============================================================================
// Components — Package Cards
// =============================================================================

fun PackageCard(pkg: Map<String, String>) {
    var name: String = pkg.get("name")
    var version: String = ""
    if (pkg.has("latest")) { version = pkg.get("latest") }
    var description: String = ""
    if (pkg.has("description")) { description = pkg.get("description") }

    {Router.Link(router, "/packages/" + name, cls="pkg-card") {
        <div cls="pkg-card-top">
            <div cls="pkg-ico">{name.char_at(0)}</div>
            <div>
                <div cls="pkg-name">{name}</div>
                <div cls="pkg-meta">
                    {if (version.length() > 0) {
                        <span cls="ver">v{version}</span>
                    }}
                </div>
            </div>
        </div>
        {if (description.length() > 0) {
            <p cls="pkg-desc">{description}</p>
        }}
        <div cls="pkg-footer">
            <div cls="pkg-tags">
                <span cls="tag">saffron</span>
            </div>
            <code cls="pkg-cmd">pantry add {name}</code>
        </div>
    }}
}

fun PackageRow(pkg: Map<String, String>) {
    var name: String = pkg.get("name")
    var version: String = ""
    if (pkg.has("latest")) { version = pkg.get("latest") }
    var description: String = ""
    if (pkg.has("description")) { description = pkg.get("description") }
    var downloads: String = ""
    if (pkg.has("total_downloads")) { downloads = pkg.get("total_downloads") }

    {Router.Link(router, "/packages/" + name, cls="pkg-row") {
        <div cls="pkg-row-top">
            <div cls="pkg-ico">{name.char_at(0)}</div>
            <div cls="pkg-row-info">
                <div cls="pkg-row-title">
                    <span cls="pkg-row-name">{name}</span>
                    {if (version.length() > 0) {
                        <span cls="ver">{version}</span>
                    }}
                </div>
                {if (description.length() > 0) {
                    <p cls="pkg-row-desc">{description}</p>
                }}
                <div cls="pkg-row-footer">
                    <div cls="pkg-row-tags">
                        <span cls="tag">saffron</span>
                    </div>
                    {if (downloads.length() > 0) {
                        <span cls="pkg-stat">↓ <b>{downloads}</b></span>
                    }}
                    <span cls="pkg-stat">MIT</span>
                    <code cls="pkg-row-cmd">pantry add {name}</code>
                </div>
            </div>
        </div>
    }}
}

// =============================================================================
// Pages — Landing
// =============================================================================

fun _render_pkg_grid(grid_el: Float, data: Any) {
    render_into(grid_el, fun () => {
        if (data != nil and data.has("packages")) {
            var pkgs = data.get("packages")
            if (pkgs.length() == 0) {
                <div cls="empty-state">No packages published yet. Be the first!</div>
            } else {
                var i: Float = 0
                while (i < pkgs.length()) {
                    {PackageCard(pkgs[i])}
                    i = i + 1
                }
            }
        } else {
            <div cls="empty-state">No packages published yet. Be the first!</div>
        }
    })
}

fun HomePage() {
    <div>
        {NavBar()}

        <section cls="hero">
            <div cls="hero-inner">
                <span cls="kicker">OPEN PACKAGE REGISTRY</span>
                <h1 cls="hero-h">Find the right package. Build something lasting.</h1>
                <p cls="hero-sub">Browse packages from the Saffron community. Open source, forever free.</p>
                <div cls="search-wrapper hero-search-wrapper">
                    <form cls="hero-form" on_submit={fun (e: Event) => { search_suggestions.set([]); do_search() }}>
                        <input cls="hero-input" type="text" placeholder="Search packages, tools, components..." value={search_query.get()} on_input={fun (e: Event) => { search_query.set(event_target_value()); update_suggestions(event_target_value()) }} on_blur={fun (e: Event) => search_suggestions.set([])} />
                        <button cls="hero-btn" type="submit">Search</button>
                    </form>
                    {if (search_suggestions.get().length() > 0) {
                        <div cls="autocomplete">
                            {var items = search_suggestions.get()
                            var i: Float = 0
                            while (i < items.length()) {
                                var suggestion: String = items[i]
                                {Router.Link(router, "/packages/" + suggestion, cls="autocomplete-item") { text(suggestion) }}
                                i = i + 1
                            }}
                        </div>
                    }}
                </div>
                <div cls="hero-pills">
                    <span cls="pill" on_click={fun (e: Event) => search_category("ui")}>UI components</span>
                    <span cls="pill" on_click={fun (e: Event) => search_category("cli")}>CLI tools</span>
                    <span cls="pill" on_click={fun (e: Event) => search_category("auth")}>Authentication</span>
                    <span cls="pill" on_click={fun (e: Event) => search_category("data")}>Data parsing</span>
                    <span cls="pill" on_click={fun (e: Event) => search_category("test")}>Testing</span>
                </div>
            </div>
        </section>

        <div cls="section wrap">
            <div cls="section-hd">
                <h2 cls="section-title">All packages</h2>
                {Router.Link(router, "/search?q=", cls="section-more") { text("View all →") }}
            </div>
            {var grid_el = div(cls="pkg-grid", block=fun () => {
                <div cls="empty-state">No packages published yet. Be the first!</div>
            })
            // on_data fires immediately if data already cached, else on fetch completion
            packages_query.on_data(fun (data: Any) => {
                _render_pkg_grid(grid_el, data)
            })
            nil}
        </div>

        {Footer()}
    </div>
}

