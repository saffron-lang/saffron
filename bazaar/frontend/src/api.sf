import { Query, query } from "basil/query"
import { Mutation, mutation } from "basil/mutation"

/// List all packages (paginated)
fun getPackages(): Query {
    return query("/api/v1/packages")
}

/// Get package details by name
fun getPackage(name: String): Query {
    return query("/api/v1/packages/${name}")
}

/// Search packages
fun searchPackages(q: String): Query {
    return query("/api/v1/search?q=${q}")
}

/// Publish a new package version
fun createPublish(): Mutation {
    return mutation("/api/v1/packages/publish")
}

/// Yank a package version
fun createYank(name: String, version: String): Mutation {
    return mutation("/api/v1/packages/${name}/yank/${version}")
}

/// Register a new user with password and get a token
fun createAuthRegister(): Mutation {
    return mutation("/api/v1/auth/register")
}

/// Login with username and password, get a token
fun createAuthLogin(): Mutation {
    return mutation("/api/v1/auth/login")
}

/// Revoke current token
fun createAuthRevoke(): Mutation {
    return mutation("/api/v1/auth/revoke")
}
