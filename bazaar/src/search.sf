//! Package search logic for the Bazaar registry.
//! Delegates to the database layer for SQLite LIKE queries.

import "./db.sf" as Db

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

/// Search packages by name or description substring match.
/// Returns up to `limit` results as a list of maps with {name, description, total_downloads}.
fun search_packages(query: String, limit: Number): List<Map<String, String>> {
    if (query.length() == 0) {
        return []
    }

    var limit_str = "${limit}"
    return Db.search(query, limit_str)
}
