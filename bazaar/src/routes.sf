//! API route handlers for the Bazaar registry.
//! Uses Parsley typed router — handlers return typed response objects,
//! errors are thrown as ApiError (caught by the router middleware).

import "@http/server" as Http
import "@crypto" as Crypto
import { ApiRouter } from "parsley/router"
import { ApiError, not_found, unauthorized, bad_request, conflict } from "parsley/response"
import { param, query_params, parse_body } from "parsley/request"
import "./db.sf" as Db
import "./storage.sf" as Storage
import "./auth.sf" as Auth

// ---------------------------------------------------------------------------
// Response types — typed structures that Parsley serializes to JSON
// ---------------------------------------------------------------------------

class PackageSummary {
    var name: String
    var description: String
    var total_downloads: String
    var latest: String

    fun init(name: String, description: String, total_downloads: String, latest: String) {
        this.name = name
        this.description = description
        this.total_downloads = total_downloads
        this.latest = latest
    }
}

class ListPackagesResponse {
    var packages: List<PackageSummary>
    var total: Int

    fun init(packages: List<PackageSummary>, total: Int) {
        this.packages = packages
        this.total = total
    }
}

class VersionInfo {
    var vers: String
    var cksum: String
    var yanked: Bool
    var published_by: String
    var published_at: String

    fun init(vers: String, cksum: String, yanked: Bool, published_by: String, published_at: String) {
        this.vers = vers
        this.cksum = cksum
        this.yanked = yanked
        this.published_by = published_by
        this.published_at = published_at
    }
}

class PackageDetail {
    var name: String
    var description: String
    var repository: String
    var license: String
    var total_downloads: String
    var versions: List<VersionInfo>

    fun init(name: String, description: String, repository: String, license: String, total_downloads: String, versions: List<VersionInfo>) {
        this.name = name
        this.description = description
        this.repository = repository
        this.license = license
        this.total_downloads = total_downloads
        this.versions = versions
    }
}

class PublishResponse {
    var ok: Bool
    var package_name: String
    var version: String

    fun init(ok: Bool, package_name: String, version: String) {
        this.ok = ok
        this.package_name = package_name
        this.version = version
    }
}

class YankResponse {
    var ok: Bool
    var package_name: String
    var version: String
    var yanked: Bool

    fun init(ok: Bool, package_name: String, version: String, yanked: Bool) {
        this.ok = ok
        this.package_name = package_name
        this.version = version
        this.yanked = yanked
    }
}

class SearchResponse {
    var packages: List<PackageSummary>
    var total: Int

    fun init(packages: List<PackageSummary>, total: Int) {
        this.packages = packages
        this.total = total
    }
}

class AuthResponse {
    var ok: Bool
    var username: String
    var token: String

    fun init(ok: Bool, username: String, token: String) {
        this.ok = ok
        this.username = username
        this.token = token
    }
}

class RevokeResponse {
    var ok: Bool
    var revoked: Bool

    fun init(ok: Bool, revoked: Bool) {
        this.ok = ok
        this.revoked = revoked
    }
}

// ---------------------------------------------------------------------------
// Route registration — typed endpoints via Parsley ApiRouter
// ---------------------------------------------------------------------------

fun register(api: ApiRouter) {
    api.get("/packages", fun (req: Http.Request): ListPackagesResponse => list_packages(req))
        .describe("List all packages with pagination")

    api.get("/packages/:name", fun (req: Http.Request): PackageDetail => get_package(req))
        .describe("Get package details and version history")

    api.get("/packages/:name/:version/download", fun (req: Http.Request): Http.Response => download_package(req))
        .describe("Download package tarball")

    api.post("/packages/publish", fun (req: Http.Request): PublishResponse => publish_package(req))
        .auth(true)
        .describe("Publish a new package version")

    api.post("/packages/:name/yank/:version", fun (req: Http.Request): YankResponse => yank_package(req))
        .auth(true)
        .describe("Yank a package version")

    api.get("/search", fun (req: Http.Request): SearchResponse => search_packages(req))
        .describe("Search packages by query")

    api.post("/auth/register", fun (req: Http.Request): AuthResponse => register_user(req))
        .describe("Register a new user and get API token")

    api.post("/auth/revoke", fun (req: Http.Request): RevokeResponse => revoke_user_token(req))
        .auth(true)
        .describe("Revoke the current API token")
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages — list all packages (paginated)
// ---------------------------------------------------------------------------

fun list_packages(req: Http.Request): ListPackagesResponse {
    var params = query_params(req)
    var offset = "0"
    var limit = "20"
    if (params.has("offset")) { offset = params.get("offset") }
    if (params.has("limit")) { limit = params.get("limit") }

    var packages = Db.list_packages_paginated(offset, limit)
    var total = Db.count_packages()

    return ListPackagesResponse(packages, total)
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages/:name — package info with version list
// ---------------------------------------------------------------------------

fun get_package(req: Http.Request): PackageDetail {
    var name = param(req, "name")
    var pkg = Db.get_package(name)
    if (pkg == nil) {
        throw not_found("package not found")
    }

    var versions = Db.get_versions(name)
    var version_list: List<VersionInfo> = []
    var i = 0
    while (i < versions.length()) {
        var v = versions[i]
        var info = VersionInfo(
            v.get("version"),
            v.get("checksum"),
            v.get("yanked") == "1",
            v.get("published_by"),
            v.get("published_at")
        )
        version_list.push(info)
        i = i + 1
    }

    return PackageDetail(
        name,
        pkg.get("description"),
        pkg.get("repository"),
        pkg.get("license"),
        pkg.get("total_downloads"),
        version_list
    )
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages/:name/:version/download — serve tarball
// (Returns raw Http.Response for binary content — not JSON-serialized)
// ---------------------------------------------------------------------------

fun download_package(req: Http.Request): Http.Response {
    var name = param(req, "name")
    var version = param(req, "version")

    if (!Storage.exists(name, version)) {
        throw not_found("version not found")
    }

    Db.record_download(name, version)
    var content = Storage.retrieve(name, version)
    return Http.Response(200, content)
        .header("Content-Type", "application/gzip")
        .header("Content-Disposition", "attachment; filename=\"${name}-${version}.tar.gz\"")
}

// ---------------------------------------------------------------------------
// POST /api/v1/packages/publish — publish a new package version
// ---------------------------------------------------------------------------

fun publish_package(req: Http.Request): PublishResponse {
    var username = require_auth(req)

    var body = parse_body(req)
    if (body == nil) {
        throw bad_request("invalid request body")
    }

    var name = body.get("name")
    var version = body.get("vers")
    var tarball_data = body.get("tarball")

    if (name == nil or version == nil or tarball_data == nil) {
        throw bad_request("missing required fields: name, vers, tarball")
    }

    var existing = Db.get_version(name, version)
    if (existing != nil) {
        throw conflict("version ${version} already exists")
    }

    Storage.store(name, version, tarball_data)
    var cksum = "sha256:" + Crypto.sha256(tarball_data)

    var description = ""
    if (body.has("description")) { description = body.get("description") }
    var repository = ""
    if (body.has("repository")) { repository = body.get("repository") }
    var license = ""
    if (body.has("license")) { license = body.get("license") }

    var pkg = Db.get_package(name)
    if (pkg == nil) {
        Db.create_package(name, description, repository, license)
        var user_id = Db.ensure_user(username)
        Db.add_owner(name, user_id)
    } else {
        if (description.length() > 0) {
            Db.update_package_description(name, description)
        }
    }

    Db.publish_version(name, version, cksum, username)

    return PublishResponse(true, name, version)
}

// ---------------------------------------------------------------------------
// POST /api/v1/packages/:name/yank/:version — mark version as yanked
// ---------------------------------------------------------------------------

fun yank_package(req: Http.Request): YankResponse {
    var username = require_auth(req)

    var name = param(req, "name")
    var version = param(req, "version")

    var pkg = Db.get_package(name)
    if (pkg == nil) {
        throw not_found("package not found")
    }

    var ver = Db.get_version(name, version)
    if (ver == nil) {
        throw not_found("version not found")
    }

    var user_id = Db.ensure_user(username)
    if (!Db.is_owner(name, user_id)) {
        throw ApiError("not an owner of this package", 403)
    }

    Db.yank_version(name, version)

    return YankResponse(true, name, version, true)
}

// ---------------------------------------------------------------------------
// GET /api/v1/search?q=<query> — search packages
// ---------------------------------------------------------------------------

fun search_packages(req: Http.Request): SearchResponse {
    var params = query_params(req)
    var q = ""
    var limit = "20"
    if (params.has("q")) { q = params.get("q") }
    if (params.has("limit")) { limit = params.get("limit") }

    var results = Db.search(q, limit)
    return SearchResponse(results, results.length())
}

// ---------------------------------------------------------------------------
// POST /api/v1/auth/register — register a user and get a token
// ---------------------------------------------------------------------------

fun register_user(req: Http.Request): AuthResponse {
    var body = parse_body(req)
    if (body == nil) {
        throw bad_request("invalid request body")
    }

    var username = body.get("username")
    if (username == nil or username.length() == 0) {
        throw bad_request("username is required")
    }

    var token = Auth.create_token(username)

    return AuthResponse(true, username, token)
}

// ---------------------------------------------------------------------------
// POST /api/v1/auth/revoke — revoke the current token
// ---------------------------------------------------------------------------

fun revoke_user_token(req: Http.Request): RevokeResponse {
    var username = require_auth(req)
    var token = req.header("Authorization").replace("Bearer ", "")
    Auth.revoke_token(token)

    return RevokeResponse(true, true)
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

/// Extract and validate auth token, throwing unauthorized on failure.
fun require_auth(req: Http.Request): String {
    var auth_header = req.header("Authorization")
    if (auth_header.length() == 0) {
        throw unauthorized("missing authorization")
    }
    var token = auth_header.replace("Bearer ", "")
    var username = Auth.validate_token(token)
    if (username == "") {
        throw unauthorized("invalid token")
    }
    return username
}
