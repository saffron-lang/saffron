//! API route handlers for the Bazaar registry.

import "@http/server" as Http
import "@json" as JSON
import "@crypto" as Crypto
import "./index.sf" as Index
import "./storage.sf" as Storage
import "./auth.sf" as Auth
import "./search.sf" as Search

// ---------------------------------------------------------------------------
// GET /api/v1/packages — list all packages
// ---------------------------------------------------------------------------

fun list_packages(req: Http.Request): Http.Response {
    var names = Index.list_packages()
    var packages = []
    var i = 0
    while (i < names.length()) {
        var name = names[i]
        var entries = Index.load_entry(name)
        if (entries.length() > 0) {
            var latest = entries[entries.length() - 1]
            var info = {}
            info.set("name", name)
            info.set("latest", latest.get("vers"))
            info.set("description", latest.get("description"))
            packages.push(info)
        }
        i = i + 1
    }
    var result = {}
    result.set("packages", packages)
    return Http.json(JSON.to_string(result))
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages/:name — package info
// ---------------------------------------------------------------------------

fun get_package(req: Http.Request): Http.Response {
    var name = req.param("name")
    var entries = Index.load_entry(name)
    if (entries.length() == 0) {
        return Http.not_found()
    }

    var versions = []
    var i = 0
    while (i < entries.length()) {
        var entry = entries[i]
        var version_info = {}
        version_info.set("vers", entry.get("vers"))
        version_info.set("yanked", entry.get("yanked"))
        version_info.set("cksum", entry.get("cksum"))
        if (entry.has("deps")) {
            version_info.set("deps", entry.get("deps"))
        }
        versions.push(version_info)
        i = i + 1
    }

    var result = {}
    result.set("name", name)
    result.set("versions", versions)
    return Http.json(JSON.to_string(result))
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages/:name/:version/download — serve tarball
// ---------------------------------------------------------------------------

fun download_package(req: Http.Request): Http.Response {
    var name = req.param("name")
    var version = req.param("version")

    if (!Storage.exists(name, version)) {
        return Http.not_found()
    }

    var content = Storage.retrieve(name, version)
    return Http.Response(200, content)
        .header("Content-Type", "application/gzip")
        .header("Content-Disposition", "attachment; filename=\"${name}-${version}.tar.gz\"")
}

// ---------------------------------------------------------------------------
// PUT /api/v1/packages/new — publish a new package version
// ---------------------------------------------------------------------------

fun publish_package(req: Http.Request): Http.Response {
    // Authenticate
    var auth_header = req.header("Authorization")
    if (auth_header.length() == 0) {
        return Http.json(JSON.to_string({"error": "missing authorization"})).status_code(401)
    }
    var token = auth_header.replace("Bearer ", "")
    var username = Auth.validate_token(token)
    if (username == "") {
        return Http.json(JSON.to_string({"error": "unauthorized"})).status_code(401)
    }

    // Parse the body — expect JSON with metadata and base64-encoded tarball
    var body = JSON.parse(req.body)
    if (body == nil) {
        return Http.json(JSON.to_string({"error": "invalid request body"})).status_code(400)
    }

    var name = body.get("name")
    var version = body.get("vers")
    var deps = []
    if (body.has("deps")) {
        deps = body.get("deps")
    }
    var tarball_data = body.get("tarball")

    if (name == nil or version == nil or tarball_data == nil) {
        return Http.json(JSON.to_string({"error": "missing required fields: name, vers, tarball"})).status_code(400)
    }

    // Check if version already exists
    var existing = Index.load_entry(name)
    var i = 0
    while (i < existing.length()) {
        if (existing[i].get("vers") == version) {
            return Http.json(JSON.to_string({"error": "version ${version} already exists"})).status_code(409)
        }
        i = i + 1
    }

    // Store the tarball
    Storage.store(name, version, tarball_data)

    // Compute checksum of the tarball data
    var cksum = "sha256:" + Crypto.sha256(tarball_data)

    // Build the index entry
    var entry = {}
    entry.set("name", name)
    entry.set("vers", version)
    entry.set("deps", deps)
    entry.set("cksum", cksum)
    entry.set("yanked", false)
    if (body.has("description")) {
        entry.set("description", body.get("description"))
    }

    // Append to the index and commit
    Index.append_entry(name, entry)
    Index.commit("Publish ${name} ${version}")

    var result = {}
    result.set("ok", true)
    result.set("package", name)
    result.set("version", version)
    return Http.json(JSON.to_string(result))
}

// ---------------------------------------------------------------------------
// DELETE /api/v1/packages/:name/:version/yank — mark version as yanked
// ---------------------------------------------------------------------------

fun yank_package(req: Http.Request): Http.Response {
    // Authenticate
    var auth_header = req.header("Authorization")
    if (auth_header.length() == 0) {
        return Http.json(JSON.to_string({"error": "missing authorization"})).status_code(401)
    }
    var token = auth_header.replace("Bearer ", "")
    var username = Auth.validate_token(token)
    if (username == "") {
        return Http.json(JSON.to_string({"error": "unauthorized"})).status_code(401)
    }

    var name = req.param("name")
    var version = req.param("version")

    var entries = Index.load_entry(name)
    if (entries.length() == 0) {
        return Http.not_found()
    }

    // Find the version and mark it as yanked
    var found = false
    var i = 0
    while (i < entries.length()) {
        if (entries[i].get("vers") == version) {
            entries[i].set("yanked", true)
            found = true
        }
        i = i + 1
    }

    if (!found) {
        return Http.json(JSON.to_string({"error": "version not found"})).status_code(404)
    }

    // Rewrite the index file with updated entries
    Index.rewrite_entry(name, entries)
    Index.commit("Yank ${name} ${version}")

    var result = {}
    result.set("ok", true)
    result.set("package", name)
    result.set("version", version)
    result.set("yanked", true)
    return Http.json(JSON.to_string(result))
}

// ---------------------------------------------------------------------------
// GET /api/v1/search?q=<query> — search packages
// ---------------------------------------------------------------------------

fun search_packages(req: Http.Request): Http.Response {
    var query = req.query
    // Parse q= from query string
    var q = ""
    var parts = query.split("&")
    var i = 0
    while (i < parts.length()) {
        if (parts[i].starts_with("q=")) {
            q = parts[i].slice(2, parts[i].length())
        }
        i = i + 1
    }

    var results = Search.search_packages(q, 20)
    var response = {}
    response.set("packages", results)
    return Http.json(JSON.to_string(response))
}
