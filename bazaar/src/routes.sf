//! API route handlers for the Bazaar registry.

import "@http/server" as Http
import "@json" as JSON
import "@crypto" as Crypto
import "./db.sf" as Db
import "./storage.sf" as Storage
import "./auth.sf" as Auth

fun register(app: Http.App) {
    app.get("/api/v1/packages", fun (req: Http.Request): Http.Response => list_packages(req))
    app.get("/api/v1/packages/:name", fun (req: Http.Request): Http.Response => get_package(req))
    app.get("/api/v1/packages/:name/download/:version", fun (req: Http.Request): Http.Response => download_package(req))
    app.post("/api/v1/packages/publish", fun (req: Http.Request): Http.Response => publish_package(req))
    app.post("/api/v1/packages/:name/yank/:version", fun (req: Http.Request): Http.Response => yank_package(req))
    app.get("/api/v1/search", fun (req: Http.Request): Http.Response => search_packages(req))
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages — list all packages
// ---------------------------------------------------------------------------

fun list_packages(req: Http.Request): Http.Response {
    var packages = Db.list_packages()
    var results = []
    var i = 0
    while (i < packages.length()) {
        var pkg = packages[i]
        var info = {}
        info.set("name", pkg.get("name"))
        info.set("description", pkg.get("description"))
        info.set("total_downloads", pkg.get("total_downloads"))
        results.push(info)
        i = i + 1
    }
    var result = {}
    result.set("packages", results)
    return Http.json(JSON.to_string(result))
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages/:name — package info
// ---------------------------------------------------------------------------

fun get_package(req: Http.Request): Http.Response {
    var name = req.param("name")
    var pkg = Db.get_package(name)
    if (pkg == nil) {
        return Http.not_found()
    }

    var versions = Db.get_versions(name)
    var version_list = []
    var i = 0
    while (i < versions.length()) {
        var v = versions[i]
        var version_info = {}
        version_info.set("vers", v.get("version"))
        version_info.set("cksum", v.get("checksum"))
        version_info.set("yanked", v.get("yanked") == "1")
        version_info.set("published_by", v.get("published_by"))
        version_info.set("published_at", v.get("published_at"))
        version_list.push(version_info)
        i = i + 1
    }

    var result = {}
    result.set("name", name)
    result.set("description", pkg.get("description"))
    result.set("repository", pkg.get("repository"))
    result.set("license", pkg.get("license"))
    result.set("total_downloads", pkg.get("total_downloads"))
    result.set("versions", version_list)
    return Http.json(JSON.to_string(result))
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages/:name/:version/download — serve tarball
// ---------------------------------------------------------------------------

fun download_package(req: Http.Request): Http.Response {
    var name = req.param("name")
    var version = req.param("version")

    if (!Storage.exists(name, version)) {
        return Http.not_found()
    }

    // Record the download
    Db.record_download(name, version)

    var content = Storage.retrieve(name, version)
    return Http.Response(200, content)
        .header("Content-Type", "application/gzip")
        .header("Content-Disposition", "attachment; filename=\"${name}-${version}.tar.gz\"")
}

// ---------------------------------------------------------------------------
// PUT /api/v1/packages/new — publish a new package version
// ---------------------------------------------------------------------------

fun publish_package(req: Http.Request): Http.Response {
    // Authenticate
    var auth_header = req.header("Authorization")
    if (auth_header.length() == 0) {
        return Http.json(JSON.to_string({"error": "missing authorization"})).status_code(401)
    }
    var token = auth_header.replace("Bearer ", "")
    var username = Auth.validate_token(token)
    if (username == "") {
        return Http.json(JSON.to_string({"error": "unauthorized"})).status_code(401)
    }

    // Parse the body — expect JSON with metadata and base64-encoded tarball
    var body = JSON.parse(req.body)
    if (body == nil) {
        return Http.json(JSON.to_string({"error": "invalid request body"})).status_code(400)
    }

    var name = body.get("name")
    var version = body.get("vers")
    var tarball_data = body.get("tarball")

    if (name == nil or version == nil or tarball_data == nil) {
        return Http.json(JSON.to_string({"error": "missing required fields: name, vers, tarball"})).status_code(400)
    }

    // Check if version already exists
    var existing = Db.get_version(name, version)
    if (existing != nil) {
        return Http.json(JSON.to_string({"error": "version ${version} already exists"})).status_code(409)
    }

    // Store the tarball on filesystem
    Storage.store(name, version, tarball_data)

    // Compute checksum of the tarball data
    var cksum = "sha256:" + Crypto.sha256(tarball_data)

    // Get description from body
    var description = ""
    if (body.has("description")) {
        description = body.get("description")
    }

    // Get optional metadata
    var repository = ""
    if (body.has("repository")) {
        repository = body.get("repository")
    }
    var license = ""
    if (body.has("license")) {
        license = body.get("license")
    }

    // Create the package if it doesn't exist, then publish the version
    var pkg = Db.get_package(name)
    if (pkg == nil) {
        Db.create_package(name, description, repository, license)
        // Add the publishing user as owner
        var user_id = Db.ensure_user(username)
        Db.add_owner(name, user_id)
    } else {
        // Update description if provided
        if (description.length() > 0) {
            Db.update_package_description(name, description)
        }
    }

    Db.publish_version(name, version, cksum, username)

    var result = {}
    result.set("ok", true)
    result.set("package", name)
    result.set("version", version)
    return Http.json(JSON.to_string(result))
}

// ---------------------------------------------------------------------------
// DELETE /api/v1/packages/:name/:version/yank — mark version as yanked
// ---------------------------------------------------------------------------

fun yank_package(req: Http.Request): Http.Response {
    // Authenticate
    var auth_header = req.header("Authorization")
    if (auth_header.length() == 0) {
        return Http.json(JSON.to_string({"error": "missing authorization"})).status_code(401)
    }
    var token = auth_header.replace("Bearer ", "")
    var username = Auth.validate_token(token)
    if (username == "") {
        return Http.json(JSON.to_string({"error": "unauthorized"})).status_code(401)
    }

    var name = req.param("name")
    var version = req.param("version")

    // Check package exists
    var pkg = Db.get_package(name)
    if (pkg == nil) {
        return Http.not_found()
    }

    // Check version exists
    var ver = Db.get_version(name, version)
    if (ver == nil) {
        return Http.json(JSON.to_string({"error": "version not found"})).status_code(404)
    }

    // Mark as yanked
    Db.yank_version(name, version)

    var result = {}
    result.set("ok", true)
    result.set("package", name)
    result.set("version", version)
    result.set("yanked", true)
    return Http.json(JSON.to_string(result))
}

// ---------------------------------------------------------------------------
// GET /api/v1/search?q=<query> — search packages
// ---------------------------------------------------------------------------

fun search_packages(req: Http.Request): Http.Response {
    var query = req.query
    // Parse q= from query string
    var q = ""
    var parts = query.split("&")
    var i = 0
    while (i < parts.length()) {
        if (parts[i].starts_with("q=")) {
            q = parts[i].slice(2, parts[i].length())
        }
        i = i + 1
    }

    var results = Db.search(q, "20")
    var response = {}
    response.set("packages", results)
    return Http.json(JSON.to_string(response))
}
