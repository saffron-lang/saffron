//! API route handlers for the Bazaar registry.
//! Routes are registered directly on Http.App (bypasses parsley mount()
//! due to a cross-package closure capture bug in the native compiler).

import "@http/server" as Http
import "@crypto" as Crypto
import "@json" as JSON
import { param, query_params, parse_body } from "parsley/request"
import "./db.sf" as Db
import "./storage.sf" as Storage
import "./auth.sf" as Auth

// ---------------------------------------------------------------------------
// Response types — typed structures serialized to JSON
// ---------------------------------------------------------------------------

class PackageSummary {
    var name: String
    var description: String
    var total_downloads: String
    var latest: String

    fun init(name: String, description: String, total_downloads: String, latest: String) {
        this.name = name
        this.description = description
        this.total_downloads = total_downloads
        this.latest = latest
    }
}

class ListPackagesResponse {
    var packages: List<PackageSummary>
    var total: Int

    fun init(packages: List<PackageSummary>, total: Int) {
        this.packages = packages
        this.total = total
    }
}

class VersionInfo {
    var vers: String
    var cksum: String
    var yanked: Bool
    var published_by: String
    var published_at: String

    fun init(vers: String, cksum: String, yanked: Bool, published_by: String, published_at: String) {
        this.vers = vers
        this.cksum = cksum
        this.yanked = yanked
        this.published_by = published_by
        this.published_at = published_at
    }
}

class PackageDetail {
    var name: String
    var description: String
    var repository: String
    var license: String
    var total_downloads: String
    var versions: List<VersionInfo>

    fun init(name: String, description: String, repository: String, license: String, total_downloads: String, versions: List<VersionInfo>) {
        this.name = name
        this.description = description
        this.repository = repository
        this.license = license
        this.total_downloads = total_downloads
        this.versions = versions
    }
}

class PublishResponse {
    var ok: Bool
    var package_name: String
    var version: String

    fun init(ok: Bool, package_name: String, version: String) {
        this.ok = ok
        this.package_name = package_name
        this.version = version
    }
}

class YankResponse {
    var ok: Bool
    var package_name: String
    var version: String
    var yanked: Bool

    fun init(ok: Bool, package_name: String, version: String, yanked: Bool) {
        this.ok = ok
        this.package_name = package_name
        this.version = version
        this.yanked = yanked
    }
}

class SearchResponse {
    var packages: List<PackageSummary>
    var total: Int

    fun init(packages: List<PackageSummary>, total: Int) {
        this.packages = packages
        this.total = total
    }
}

class AuthResponse {
    var ok: Bool
    var username: String
    var token: String

    fun init(ok: Bool, username: String, token: String) {
        this.ok = ok
        this.username = username
        this.token = token
    }
}

class RevokeResponse {
    var ok: Bool
    var revoked: Bool

    fun init(ok: Bool, revoked: Bool) {
        this.ok = ok
        this.revoked = revoked
    }
}

// ---------------------------------------------------------------------------
// Route registration — direct app.get/post with local JSON wrapping
// (Workaround: parsley mount() creates closures in a different package which
// triggers a cross-package upvalue capture bug in the native compiler.)
// ---------------------------------------------------------------------------

fun register(app: Http.App, prefix: String) {
    _mount_list_packages(app, prefix + "/packages")
    _mount_get_package(app, prefix + "/packages/:name")
    _mount_download_package(app, prefix + "/packages/:name/:version/download")
    _mount_search(app, prefix + "/search")
    _mount_publish(app, prefix + "/packages/publish")
    _mount_yank(app, prefix + "/packages/:name/yank/:version")
    _mount_register(app, prefix + "/auth/register")
    _mount_login(app, prefix + "/auth/login")
    _mount_revoke(app, prefix + "/auth/revoke")
}

// ---------------------------------------------------------------------------
// Mount helpers — each creates ONE closure per route (avoids loop capture)
// ---------------------------------------------------------------------------

fun _mount_list_packages(app: Http.App, path: String) {
    app.get(path, fun (req: Http.Request): Http.Response => {
        return _json_response(list_packages(req))
    })
}

fun _mount_get_package(app: Http.App, path: String) {
    app.get(path, fun (req: Http.Request): Http.Response => {
        return _handle_get_package(req)
    })
}

fun _mount_download_package(app: Http.App, path: String) {
    app.get(path, fun (req: Http.Request): Http.Response => {
        return _handle_download(req)
    })
}

fun _mount_search(app: Http.App, path: String) {
    app.get(path, fun (req: Http.Request): Http.Response => {
        return _json_response(search_packages(req))
    })
}

fun _mount_publish(app: Http.App, path: String) {
    app.post(path, fun (req: Http.Request): Http.Response => {
        return _handle_publish(req)
    })
}

fun _mount_yank(app: Http.App, path: String) {
    app.post(path, fun (req: Http.Request): Http.Response => {
        return _handle_yank(req)
    })
}

fun _mount_register(app: Http.App, path: String) {
    app.post(path, fun (req: Http.Request): Http.Response => {
        return _handle_register(req)
    })
}

fun _mount_login(app: Http.App, path: String) {
    app.post(path, fun (req: Http.Request): Http.Response => {
        return _handle_login(req)
    })
}

fun _mount_revoke(app: Http.App, path: String) {
    app.post(path, fun (req: Http.Request): Http.Response => {
        return _handle_revoke(req)
    })
}

// ---------------------------------------------------------------------------
// Response helpers
// ---------------------------------------------------------------------------

fun _json_response(data: Any): Http.Response {
    return Http.Response(200, JSON.to_string(data))
        .header("Content-Type", "application/json")
}

fun _error_json(status: Int, message: String): Http.Response {
    var body = "{\"error\":" + JSON.escape_string(message) + "}"
    return Http.Response(status, body)
        .header("Content-Type", "application/json")
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages — list all packages (paginated)
// ---------------------------------------------------------------------------

fun list_packages(req: Http.Request): ListPackagesResponse {
    var params = query_params(req)
    var offset = "0"
    var limit = "20"
    if (params.has("offset")) { offset = params.get("offset") }
    if (params.has("limit")) { limit = params.get("limit") }

    var packages = Db.list_packages_paginated(offset, limit)
    var total = Db.count_packages()

    return ListPackagesResponse(packages, total)
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages/:name — package info with version list
// ---------------------------------------------------------------------------

fun _handle_get_package(req: Http.Request): Http.Response {
    var name = param(req, "name")
    if (name == nil or name == "") {
        return _error_json(400, "missing package name")
    }
    var pkg = Db.get_package(name)
    if (pkg == nil) {
        return _error_json(404, "package not found")
    }

    var versions = Db.get_versions(name)
    var version_list: List<VersionInfo> = []
    var i = 0
    while (i < versions.length()) {
        var v = versions[i]
        var info = VersionInfo(
            v.get("version"),
            v.get("checksum"),
            v.get("yanked") == "1",
            v.get("published_by"),
            v.get("published_at")
        )
        version_list.push(info)
        i = i + 1
    }

    var detail = PackageDetail(
        name,
        pkg.get("description"),
        pkg.get("repository"),
        pkg.get("license"),
        pkg.get("total_downloads"),
        version_list
    )
    return _json_response(detail)
}

// ---------------------------------------------------------------------------
// GET /api/v1/packages/:name/:version/download — serve tarball
// ---------------------------------------------------------------------------

fun _handle_download(req: Http.Request): Http.Response {
    var name = param(req, "name")
    var version = param(req, "version")
    if (name == nil or name == "") {
        return _error_json(400, "missing package name")
    }
    if (version == nil or version == "") {
        return _error_json(400, "missing version")
    }

    if (!Storage.exists(name, version)) {
        return _error_json(404, "version not found")
    }

    Db.record_download(name, version)
    var content = Storage.retrieve(name, version)
    return Http.Response(200, content)
        .header("Content-Type", "application/gzip")
        .header("Content-Disposition", "attachment; filename=\"${name}-${version}.tar.gz\"")
}

// ---------------------------------------------------------------------------
// POST /api/v1/packages/publish — publish a new package version
// ---------------------------------------------------------------------------

fun _handle_publish(req: Http.Request): Http.Response {
    var auth_result = _check_auth(req)
    if (auth_result == "") {
        return _error_json(401, "missing or invalid authorization")
    }
    var username = auth_result

    var body = parse_body(req)
    if (body == nil) {
        return _error_json(400, "invalid or empty request body")
    }

    var name = ""
    var version = ""
    var tarball_data = ""
    if (body.has("name")) { name = body.get("name") }
    if (body.has("vers")) { version = body.get("vers") }
    if (body.has("tarball")) { tarball_data = body.get("tarball") }

    if (name == "" or version == "" or tarball_data == "") {
        return _error_json(400, "missing required fields: name, vers, tarball")
    }

    var existing = Db.get_version(name, version)
    if (existing != nil) {
        return _error_json(409, "version ${version} already exists")
    }

    Storage.store(name, version, tarball_data)
    var cksum = "sha256:" + Crypto.sha256(tarball_data)

    var description = ""
    if (body.has("description")) { description = body.get("description") }
    var repository = ""
    if (body.has("repository")) { repository = body.get("repository") }
    var license = ""
    if (body.has("license")) { license = body.get("license") }

    var pkg = Db.get_package(name)
    if (pkg == nil) {
        Db.create_package(name, description, repository, license)
        var user_id = Db.ensure_user(username)
        Db.add_owner(name, user_id)
    } else {
        if (description.length() > 0) {
            Db.update_package_description(name, description)
        }
    }

    Db.publish_version(name, version, cksum, username)

    return _json_response(PublishResponse(true, name, version))
}

// ---------------------------------------------------------------------------
// POST /api/v1/packages/:name/yank/:version — mark version as yanked
// ---------------------------------------------------------------------------

fun _handle_yank(req: Http.Request): Http.Response {
    var auth_result = _check_auth(req)
    if (auth_result == "") {
        return _error_json(401, "missing or invalid authorization")
    }
    var username = auth_result

    var name = param(req, "name")
    var version = param(req, "version")
    if (name == nil or name == "") {
        return _error_json(400, "missing package name")
    }
    if (version == nil or version == "") {
        return _error_json(400, "missing version")
    }

    var pkg = Db.get_package(name)
    if (pkg == nil) {
        return _error_json(404, "package not found")
    }

    var ver = Db.get_version(name, version)
    if (ver == nil) {
        return _error_json(404, "version not found")
    }

    var user_id = Db.ensure_user(username)
    if (!Db.is_owner(name, user_id)) {
        return _error_json(403, "not an owner of this package")
    }

    Db.yank_version(name, version)

    return _json_response(YankResponse(true, name, version, true))
}

// ---------------------------------------------------------------------------
// GET /api/v1/search?q=<query> — search packages
// ---------------------------------------------------------------------------

fun search_packages(req: Http.Request): SearchResponse {
    var params = query_params(req)
    var q = ""
    var limit = "20"
    if (params.has("q")) { q = params.get("q") }
    if (params.has("limit")) { limit = params.get("limit") }

    var results = Db.search(q, limit)
    return SearchResponse(results, results.length())
}

// ---------------------------------------------------------------------------
// POST /api/v1/auth/register — register a user with password and get a token
// ---------------------------------------------------------------------------

fun _handle_register(req: Http.Request): Http.Response {
    var body = parse_body(req)
    if (body == nil) {
        return _error_json(400, "invalid or empty request body")
    }

    var username = ""
    if (body.has("username")) { username = body.get("username") }
    if (username == "" or username == nil) {
        return _error_json(400, "username is required")
    }

    var password = ""
    if (body.has("password")) { password = body.get("password") }
    if (password == "" or password == nil) {
        return _error_json(400, "password is required")
    }
    if (password.length() < 6) {
        return _error_json(400, "password must be at least 6 characters")
    }

    var result = Auth.register(username, password)
    if (result.has("error")) {
        return _error_json(400, result.get("error"))
    }

    return _json_response(AuthResponse(true, result.get("username"), result.get("token")))
}

// ---------------------------------------------------------------------------
// POST /api/v1/auth/login — login with username/password and get a token
// ---------------------------------------------------------------------------

fun _handle_login(req: Http.Request): Http.Response {
    var body = parse_body(req)
    if (body == nil) {
        return _error_json(400, "invalid or empty request body")
    }

    var username = ""
    if (body.has("username")) { username = body.get("username") }
    if (username == "" or username == nil) {
        return _error_json(400, "username is required")
    }

    var password = ""
    if (body.has("password")) { password = body.get("password") }
    if (password == "" or password == nil) {
        return _error_json(400, "password is required")
    }

    var result = Auth.login(username, password)
    if (result.has("error")) {
        return _error_json(401, result.get("error"))
    }

    return _json_response(AuthResponse(true, result.get("username"), result.get("token")))
}

// ---------------------------------------------------------------------------
// POST /api/v1/auth/revoke — revoke the current token
// ---------------------------------------------------------------------------

fun _handle_revoke(req: Http.Request): Http.Response {
    var auth_result = _check_auth(req)
    if (auth_result == "") {
        return _error_json(401, "missing or invalid authorization")
    }
    var auth_header = req.header("Authorization")
    var token = ""
    if (auth_header != nil and auth_header.length() > 0) {
        token = auth_header.replace("Bearer ", "")
    }
    Auth.revoke_token(token)

    return _json_response(RevokeResponse(true, true))
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

/// Check auth and return username, or "" if invalid.
/// Uses return values instead of throw to avoid cross-module exception bugs.
fun _check_auth(req: Http.Request): String {
    var auth_header = req.header("Authorization")
    if (auth_header == nil or auth_header.length() == 0) {
        return ""
    }
    var token = auth_header.replace("Bearer ", "")
    var username = Auth.validate_token(token)
    if (username == nil or username == "") {
        return ""
    }
    return username
}
