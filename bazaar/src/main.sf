//! Bazaar — the Saffron package registry server.
//! Entry point: configures middleware, registers routes, starts server.

import "@http/server" as Http
import "@os" as OS
import "@json" as JSON
import "./routes.sf" as Routes
import "./db.sf" as Db

fun main() {
    try {
        var port_str = OS.env("BAZAAR_PORT")
        var port = 3000
        if (port_str.length() > 0) {
            port = port_str.to_number()
        }

        Db.init()

        var app = Http.server(port)

        // Middleware
        app.use(Http.cors())
        app.use(Http.logger())
        app.after(Http.cors_headers())

        // Register API routes directly on the app
        Routes.register(app, "/api/v1")

        IO.println("Bazaar registry server v0.1.0")
        app.serve()
    } catch (e) {
        IO.println("Fatal: " + e.to_string())
    }
}

main()
