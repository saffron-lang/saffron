//! Bazaar — the Saffron package registry server.
//! Entry point: configures middleware, registers routes, starts server.

import "@http/server" as Http
import "@os" as OS
import { router } from "parsley/router"
import { to_json } from "parsley/spec"
import "./routes.sf" as Routes
import "./index.sf" as Index
import "./db.sf" as Db

fun main() {
    var port_str = OS.env("BAZAAR_PORT")
    var port = 3000
    if (port_str.length() > 0) {
        port = port_str.to_number()
    }

    Db.init()
    Index.init_index()

    var app = Http.server(port)

    // Middleware
    app.use(Http.cors())
    app.use(Http.logger())
    app.use(Http.static_files("/", "static"))
    app.after(Http.cors_headers())

    // Build API router with parsley
    var api = router("/api/v1")
    Routes.register(api)
    api.mount(app)

    // Export spec for frontend client generation
    var spec_json = to_json(api.spec())
    IO.write_file("static/api_spec.json", spec_json)

    IO.println("Bazaar registry server v0.1.0")
    IO.println("API spec exported to static/api_spec.json")
    app.serve()
}

main()
