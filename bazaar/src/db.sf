//! Database layer for the Bazaar registry.
//! Wraps @sqlite to provide a central connection and query helpers.

import "@sqlite" as DB
import "@os" as OS
import "@process" as Process

/// The shared database connection (initialized by init()).
var _db: DB.Database = nil
var _db_path: String = ""

// ---------------------------------------------------------------------------
// Workaround: direct query helpers that bypass Database method dispatch
// (works around a codegen bug where Row fields are lost in method calls)
// ---------------------------------------------------------------------------

fun _run_query(sql: String): String {
    var cmd = "sqlite3 -header -separator '\t' '" + _db_path + "' '" + sql.replace("'", "'\\''") + "'"
    var result = Process.run(cmd)
    return result.stdout
}

fun _parse_result(output: String): List<Map<String, String>> {
    var results: List<Map<String, String>> = []
    var trimmed = output.trim()
    if (trimmed.length() == 0) { return results }
    var lines = trimmed.split("\n")
    if (lines.length() < 2) { return results }
    var columns = lines[0].split("\t")
    var i = 1
    while (i < lines.length()) {
        var line = lines[i]
        if (line.length() > 0) {
            var values = line.split("\t")
            var row: Map<String, String> = {}
            var c = 0
            while (c < columns.length()) {
                var val = ""
                if (c < values.length()) { val = values[c] }
                row.set(columns[c], val)
                c = c + 1
            }
            results.push(row)
        }
        i = i + 1
    }
    return results
}

fun _query_one(sql: String): Map<String, String> {
    var rows = _parse_result(_run_query(sql))
    if (rows.length() == 0) { return nil }
    return rows[0]
}

fun _query_all(sql: String): List<Map<String, String>> {
    return _parse_result(_run_query(sql))
}

fun _exec(sql: String) {
    var cmd = "sqlite3 '" + _db_path + "' '" + sql.replace("'", "'\\''") + "'"
    Process.run(cmd)
}

// ---------------------------------------------------------------------------
// Initialization
// ---------------------------------------------------------------------------

/// Open the database and run pending migrations.
/// Uses BAZAAR_DB env var or defaults to "data/bazaar.db".
fun init() {
    var db_path = OS.env("BAZAAR_DB")
    if (db_path.length() == 0) {
        db_path = "data/bazaar.db"
    }

    // Ensure data directory exists
    if (!OS.file_exists("data")) {
        OS.mkdir("data")
    }

    _db_path = db_path
    try {
        _db = DB.open(db_path)
    } catch (e) {
        IO.println("[db] warning: DB.open failed (" + e.to_string() + "), retrying...")
        // Retry without _ensure_sqlite3 (skip the which check that may fail
        // due to nursery GC invalidating the trimmed path string)
        _db = DB.Database(db_path)
    }
    IO.println("[db] initialized: ${db_path}")
}

/// Return the shared database connection.
fun get_db(): DB.Database {
    return _db
}

// ---------------------------------------------------------------------------
// Package queries
// ---------------------------------------------------------------------------

/// Get package metadata by name. Returns nil if not found.
fun get_package(name: String): Map<String, String> {
    var sql = "SELECT name, description, repository, license, created_at, total_downloads FROM packages WHERE name = ''" + name.replace("'", "''") + "''"
    return _query_one(sql)
}

/// List all packages (name, description, total_downloads, latest version).
fun list_packages(): List<Map<String, String>> {
    return _query_all("SELECT p.name, p.description, p.total_downloads, (SELECT v.version FROM versions v WHERE v.package_name = p.name ORDER BY v.id DESC LIMIT 1) as latest FROM packages p ORDER BY p.total_downloads DESC")
}

/// Create a new package entry.
fun create_package(name: String, description: String, repository: String, license: String) {
    var esc_n = name.replace("'", "''")
    var esc_d = description.replace("'", "''")
    var esc_r = repository.replace("'", "''")
    var esc_l = license.replace("'", "''")
    _exec("INSERT INTO packages (name, description, repository, license) VALUES (''" + esc_n + "'', ''" + esc_d + "'', ''" + esc_r + "'', ''" + esc_l + "'')")
}

/// Update package description.
fun update_package_description(name: String, description: String) {
    var esc_d = description.replace("'", "''")
    var esc_n = name.replace("'", "''")
    _exec("UPDATE packages SET description = ''" + esc_d + "'' WHERE name = ''" + esc_n + "''")
}

// ---------------------------------------------------------------------------
// Version queries
// ---------------------------------------------------------------------------

/// Get all versions for a package.
fun get_versions(package_name: String): List<Map<String, String>> {
    var esc_name = package_name.replace("'", "''")
    return _query_all("SELECT version, checksum, published_by, published_at, yanked FROM versions WHERE package_name = ''" + esc_name + "'' ORDER BY id")
}

/// Get a specific version of a package.
fun get_version(package_name: String, version: String): Map<String, String> {
    var esc_name = package_name.replace("'", "''")
    var esc_ver = version.replace("'", "''")
    return _query_one("SELECT version, checksum, published_by, published_at, yanked FROM versions WHERE package_name = ''" + esc_name + "'' AND version = ''" + esc_ver + "''")
}

/// Publish a new version.
fun publish_version(package_name: String, version: String, checksum: String, published_by: String) {
    var esc_pn = package_name.replace("'", "''")
    var esc_v = version.replace("'", "''")
    var esc_c = checksum.replace("'", "''")
    var esc_pb = published_by.replace("'", "''")
    _exec("INSERT INTO versions (package_name, version, checksum, published_by) VALUES (''" + esc_pn + "'', ''" + esc_v + "'', ''" + esc_c + "'', ''" + esc_pb + "'')")
}

/// Mark a version as yanked.
fun yank_version(package_name: String, version: String) {
    var esc_pn = package_name.replace("'", "''")
    var esc_v = version.replace("'", "''")
    _exec("UPDATE versions SET yanked = 1 WHERE package_name = ''" + esc_pn + "'' AND version = ''" + esc_v + "''")
}

// ---------------------------------------------------------------------------
// Download tracking
// ---------------------------------------------------------------------------

/// Record a download event.
fun record_download(package_name: String, version: String) {
    var esc_pn = package_name.replace("'", "''")
    var esc_v = version.replace("'", "''")
    _exec("INSERT INTO downloads (package_name, version) VALUES (''" + esc_pn + "'', ''" + esc_v + "'')")
    _exec("UPDATE packages SET total_downloads = total_downloads + 1 WHERE name = ''" + esc_pn + "''")
}

/// Get download count for a specific version.
fun get_download_count(package_name: String, version: String): Number {
    var esc_pn = package_name.replace("'", "''")
    var esc_v = version.replace("'", "''")
    var row = _query_one("SELECT count(*) as cnt FROM downloads WHERE package_name = ''" + esc_pn + "'' AND version = ''" + esc_v + "''")
    if (row == nil) { return 0 }
    return row.get("cnt").to_number()
}

// ---------------------------------------------------------------------------
// User / token queries
// ---------------------------------------------------------------------------

/// Find or create a user by username. Returns the user id as a string.
fun ensure_user(username: String): String {
    var esc_u = username.replace("'", "''")
    var row = _query_one("SELECT id FROM users WHERE username = ''" + esc_u + "''")
    if (row != nil) { return row.get("id") }
    _exec("INSERT INTO users (username) VALUES (''" + esc_u + "'')")
    var new_row = _query_one("SELECT id FROM users WHERE username = ''" + esc_u + "''")
    return new_row.get("id")
}

/// Store a hashed token for a user.
fun store_token(token_hash: String, user_id: String) {
    var esc_h = token_hash.replace("'", "''")
    var esc_uid = user_id.replace("'", "''")
    _exec("INSERT INTO tokens (token_hash, user_id) VALUES (''" + esc_h + "'', ''" + esc_uid + "'')")
}

/// Validate a token hash. Returns the username if valid and not revoked, or "" if invalid.
fun validate_token_hash(token_hash: String): String {
    var esc_h = token_hash.replace("'", "''")
    var row = _query_one("SELECT u.username FROM tokens t JOIN users u ON t.user_id = u.id WHERE t.token_hash = ''" + esc_h + "'' AND t.revoked = 0")
    if (row == nil) { return "" }
    return row.get("username")
}

/// Revoke a token by hash.
fun revoke_token(token_hash: String) {
    var esc_h = token_hash.replace("'", "''")
    _exec("UPDATE tokens SET revoked = 1 WHERE token_hash = ''" + esc_h + "''")
}

// ---------------------------------------------------------------------------
// Ownership queries
// ---------------------------------------------------------------------------

/// Add an owner to a package.
fun add_owner(package_name: String, user_id: String) {
    var esc_pn = package_name.replace("'", "''")
    var esc_uid = user_id.replace("'", "''")
    _exec("INSERT OR IGNORE INTO owners (package_name, user_id) VALUES (''" + esc_pn + "'', ''" + esc_uid + "'')")
}

/// Check if a user owns a package.
fun is_owner(package_name: String, user_id: String): Bool {
    var esc_pn = package_name.replace("'", "''")
    var esc_uid = user_id.replace("'", "''")
    var row = _query_one("SELECT 1 as ok FROM owners WHERE package_name = ''" + esc_pn + "'' AND user_id = ''" + esc_uid + "''")
    return row != nil
}

// ---------------------------------------------------------------------------
// Search
// ---------------------------------------------------------------------------

/// Search packages by name (LIKE match). FTS5 not available on all systems.
/// Returns up to `limit` results.
fun search(query: String, limit: String): List<Map<String, String>> {
    if (query.length() == 0) {
        return list_packages()
    }
    var esc_q = query.replace("'", "''")
    return _query_all("SELECT p.name, p.description, p.total_downloads, (SELECT v.version FROM versions v WHERE v.package_name = p.name ORDER BY v.id DESC LIMIT 1) as latest FROM packages p WHERE p.name LIKE ''%" + esc_q + "%'' OR p.description LIKE ''%" + esc_q + "%'' ORDER BY p.total_downloads DESC LIMIT " + limit)
}

/// List packages with pagination.
fun list_packages_paginated(offset: String, limit: String): List<Map<String, String>> {
    return _query_all("SELECT p.name, p.description, p.total_downloads, (SELECT v.version FROM versions v WHERE v.package_name = p.name ORDER BY v.id DESC LIMIT 1) as latest FROM packages p ORDER BY p.total_downloads DESC LIMIT " + limit + " OFFSET " + offset)
}

/// Get total number of packages.
fun count_packages(): Int {
    var row = _query_one("SELECT count(*) as cnt FROM packages")
    if (row == nil) { return 0 }
    return row.get("cnt").to_number()
}
