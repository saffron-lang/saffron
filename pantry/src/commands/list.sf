//! `pantry list` — list installed packages.
import "@args" as Args

import "@os" as OS
import "../config.sf" as Config

fun run(parsed: Args.ParsedArgs) {
    var manifest = Config.load()

    if (manifest.dependencies.length() == 0 and manifest.dev_dependencies.length() == 0) {
        IO.println("No dependencies.")
        return
    }

    if (manifest.dependencies.length() > 0) {
        IO.println("Dependencies:")
        var keys: List<String> = manifest.dependencies.keys()
        var i: Int = 0
        while (i < keys.length()) {
            var name: String = keys[i]
            var version: String = manifest.dependencies.get(name)
            IO.println("  ${name} @ ${version}")
            i = i + 1
        }
    }

    if (manifest.dev_dependencies.length() > 0) {
        IO.println("")
        IO.println("Dev dependencies:")
        var keys: List<String> = manifest.dev_dependencies.keys()
        var i: Int = 0
        while (i < keys.length()) {
            var name: String = keys[i]
            var version: String = manifest.dev_dependencies.get(name)
            IO.println("  ${name} @ ${version}")
            i = i + 1
        }
    }
}
