//! `pantry build` — compile the project.
import "@args" as Args

import "@os" as OS
import "../config.sf" as Config
import "./run.sf" as Run

fun run(parsed: Args.ParsedArgs) {
    var manifest: Config.Manifest = Config.load()
    var scripts: Map<String, String> = Run._collect_scripts(manifest)

    // If there's a build script defined, run it (with script expansion)
    if (scripts.has("build")) {
        var cmd: String = scripts.get("build")
        Run._exec_command(cmd, scripts, 0)
        return
    }

    // Default: compile the entry point with lib-path for installed packages
    var entry: String = manifest.entry
    if (!(OS.file_exists(entry))) {
        IO.println("pantry build: entry file '${entry}' not found")
        OS.exit(1)
    }

    var output_name: String = manifest.name
    if (output_name == "") {
        output_name = "a.out"
    }
    var output_path: String = "build/" + output_name

    OS.exec("mkdir -p build")

    var cmd: String = "saffron build ${entry} -o ${output_path}"
    if (OS.file_exists(".pantry/packages")) {
        cmd = cmd + " --lib-path .pantry/packages"
    }

    IO.println("> ${cmd}")
    var output: String = OS.exec(cmd)
    IO.print(output)
}
