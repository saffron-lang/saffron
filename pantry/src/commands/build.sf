//! `pantry build` — compile the project.
import "@args" as Args
import "@time" as Time
import "@os" as OS
import "../config.sf" as Config
import "./run.sf" as Run

fun run(parsed: Args.ParsedArgs) {
    var manifest: Config.Manifest = Config.load()
    var scripts: Map<String, String> = Run._collect_scripts(manifest)

    IO.println("Building " + manifest.name + "...")
    var start: Float = Time.now()

    // If there's a build script defined, run it (with script expansion)
    if (scripts.has("build")) {
        var cmd: String = scripts.get("build")
        var code: Int = Run._exec_command(cmd, scripts, 0)
        if (code != 0) {
            IO.println("✗ Build failed (exit ${code})")
            OS.exit(code)
        }
        var elapsed: Float = Time.now() - start
        IO.println("✓ Built in " + elapsed.floor().to_string() + "s")
        return
    }

    // Default: compile the entry point with lib-path for installed packages
    var entry: String = manifest.entry
    if (!(OS.file_exists(entry))) {
        IO.println("pantry build: entry file '${entry}' not found")
        OS.exit(1)
    }

    var output_name: String = manifest.name
    if (output_name == "") {
        output_name = "a.out"
    }

    OS.exec("mkdir -p build")

    // Libraries have no `main`, so they cannot be linked into an executable.
    // Compile them to LLVM IR instead; consumers link them via --lib-path.
    var cmd: String = ""
    if (manifest.package_type == "library") {
        var output_path: String = "build/" + output_name + ".ll"
        cmd = "saffronc"
        if (manifest.target != "") {
            cmd = cmd + " --target " + manifest.target
        }
        if (OS.file_exists(".pantry/packages")) {
            cmd = cmd + " --lib-path .pantry/packages"
        }
        cmd = cmd + " ${entry} ${output_path}"
    } else {
        var output_path: String = "build/" + output_name
        cmd = "saffron build"
        if (manifest.target != "") {
            cmd = cmd + " --target " + manifest.target
        }
        if (OS.file_exists(".pantry/packages")) {
            cmd = cmd + " --lib-path .pantry/packages"
        }
        cmd = cmd + " ${entry} -o ${output_path}"
    }

    var code: Int = Run._exec_shell(cmd)
    if (code != 0) {
        IO.println("✗ Build failed (exit ${code})")
        OS.exit(code)
    }
    var elapsed: Float = Time.now() - start
    IO.println("✓ Built in " + elapsed.floor().to_string() + "s")
}
