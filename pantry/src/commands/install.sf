//! `pantry install` — install all dependencies from pantry.toml.
//!
//! For now this resolves dependencies and creates a lockfile.
//! Actual remote fetching requires the HTTP layer.

import "@os" as OS
import "@semver" as SemVer
import "../config.sf" as Config

fun run(parsed: Args.ParsedArgs) {
    var manifest = Config.load()

    if (manifest.dependencies.length() == 0) {
        IO.println("No dependencies to install.")
        return
    }

    IO.println("Resolving dependencies for '${manifest.name}'...")

    var keys = manifest.dependencies.keys()
    var i = 0
    while (i < keys.length()) {
        var name = keys[i]
        var constraint = manifest.dependencies.get(name)
        IO.println("  ${name} @ ${constraint}")
        // TODO: resolve from registry, check cache, download if needed
        // For now, local path dependencies work via relative imports
        i = i + 1
    }

    // Write lockfile
    var lock_path = _manifest_dir() + "/pantry.lock"
    var lock_content = "# pantry.lock — auto-generated, do not edit\n"
    lock_content = lock_content + "# Generated by pantry install\n\n"
    i = 0
    while (i < keys.length()) {
        var name = keys[i]
        var constraint = manifest.dependencies.get(name)
        lock_content = lock_content + "[[package]]\n"
        lock_content = lock_content + "name = \"${name}\"\n"
        lock_content = lock_content + "constraint = \"${constraint}\"\n"
        lock_content = lock_content + "\n"
        i = i + 1
    }

    IO.write_file(lock_path, lock_content)
    IO.println("")
    IO.println("Written pantry.lock (${keys.length()} packages)")
}

fun _manifest_dir(): String {
    var path = Config.find_manifest()
    var last_slash = -1
    var i = 0
    while (i < path.length()) {
        if (path.char_at(i) == "/") {
            last_slash = i
        }
        i = i + 1
    }
    if (last_slash <= 0) { return "." }
    return path.slice(0, last_slash)
}
