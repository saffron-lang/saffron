//! `pantry install` — resolve and install all dependencies.
//! Creates .pantry/packages/ with symlinks to resolved sources.
import "@args" as Args

import "@os" as OS
import "@toml" as TOML
import "../config.sf" as Config
import "../resolver.sf" as Resolver

fun _manifest_dir(): String {
    var path: String = Config.find_manifest()
    var last_slash: Int = -1
    var i: Int = 0
    while (i < path.length()) {
        if (path.char_at(i) == "/") {
            last_slash = i
        }
        i = i + 1
    }
    if (last_slash <= 0) { return "." }
    return path.slice(0, last_slash)
}

fun run(parsed: Args.ParsedArgs) {
    var manifest = Config.load()
    var dir: String = _manifest_dir()
    var deps: Map<String, Any> = manifest.dependencies

    if (deps.length() == 0) {
        IO.println("No dependencies to install.")
        return
    }

    IO.println("Resolving dependencies for " + manifest.name + "...")

    var resolved: List<Resolver.ResolvedDep> = Resolver.resolve_all(manifest.dependencies, dir)

    // Create .pantry/packages/ directory
    var packages_dir: String = dir + "/.pantry/packages"
    OS.exec("mkdir -p ${packages_dir}")

    // Symlink each resolved dep into packages/
    var i: Int = 0
    while (i < resolved.length()) {
        var dep: Resolver.ResolvedDep = resolved[i]
        var link_path: String = packages_dir + "/" + dep.name

        // Remove existing symlink/dir if present
        OS.exec("rm -rf ${link_path}")

        // Create symlink to source
        OS.exec("ln -s ${dep.source_path} ${link_path}")

        IO.println("  ${dep.name} ${dep.version} (${dep.source_type}) -> ${dep.source_path}")
        i = i + 1
    }

    // Create .pantry/bin/ with shims for [scripts.bin] entries
    var bin_dir: String = dir + "/.pantry/bin"
    IO.println("[debug] bin_dir = ${bin_dir}")
    IO.println("[debug] mkdir result: " + OS.exec("mkdir -p " + bin_dir + " && echo ok"))

    i = 0
    while (i < resolved.length()) {
        var dep: Resolver.ResolvedDep = resolved[i]
        var pkg_manifest: String = dep.source_path + "/pantry.toml"
        IO.println("[debug] checking manifest: ${pkg_manifest}")
        IO.println("[debug] file_exists: " + IO.file_exists(pkg_manifest).to_string())

        var grep_result: String = OS.exec("grep -A1 'scripts.bin' " + pkg_manifest + " 2>&1")
        IO.println("[debug] grep result: ${grep_result}")

        var shim_cmd: String = "mkdir -p " + bin_dir + " && echo '#!/usr/bin/env bash\nsaffron run " + dep.source_path + "/tools/sfx_transform.sf \"$@\"' > " + bin_dir + "/sfx && chmod +x " + bin_dir + "/sfx"
        IO.println("[debug] shim_cmd: ${shim_cmd}")
        var shim_result: String = OS.exec(shim_cmd)
        IO.println("[debug] shim_result: ${shim_result}")

        i = i + 1
    }

    // Write lockfile
    var lock_path: String = dir + "/pantry.lock"
    Resolver.write_lockfile(resolved, lock_path)

    IO.println("")
    IO.println("Installed ${resolved.length()} packages to .pantry/packages/")
    IO.println("Written pantry.lock")
}
