//! `pantry run <script>` — run a named script from pantry.toml.
//! Scripts can reference other scripts by name. Commands are split on `&&`
//! and each segment is checked against [scripts] before being run as shell.
//!
//! Dependencies can export scripts via [scripts.bin] in their pantry.toml.
//! These become available in the consuming project as if locally defined.
import "@args" as Args

import "@os" as OS
import "@toml" as TOML
import "@process" as Process
import "../config.sf" as Config

// Call libc `system` directly rather than going through OS.system. `OS.*` names
// are mangled straight to runtime externs whose i64 return is left untagged, so
// `OS.system(...) == 0` compares a raw 0 against a NaN-boxed 0 and is always
// false — the value prints as 0 but never compares equal. The @extern path tags
// its result correctly. See BUGS.md #23.
@extern("i32 system(i8*)") fun _libc_system(cmd: String): Int

/// Run a shell command, returning a shell-style exit code.
/// C `system()` yields a packed `wait()` status (exit 1 arrives as 256), so
/// decode it; a signal death is reported as 128 + signal, as shells do.
fun _shell_status(cmd: String): Int {
    var status: Int = _libc_system(cmd)
    if (status < 0) { return status }
    var signal: Int = status % 128
    if (signal != 0) { return 128 + signal }
    return status / 256
}

/// Build a PATH prefix that includes all dep bin directories.
fun _bin_path_prefix(): String {
    var packages_dir: String = ".pantry/packages"
    if (!(OS.file_exists(packages_dir))) {
        return ""
    }

    var packages: List<String> = OS.exec("ls ${packages_dir} 2>/dev/null").trim().split("\n")
    var paths: List<String> = []
    var i: Int = 0
    while (i < packages.length()) {
        var pkg_name: String = packages[i].trim()
        if (pkg_name == "") {
            i = i + 1
            continue
        }
        // Add package's bin/ directory if it exists
        var bin_dir: String = packages_dir + "/" + pkg_name + "/bin"
        if (OS.file_exists(bin_dir)) {
            paths.push(bin_dir)
        }
        // Also add the package root (for scripts defined in pantry.toml [scripts.bin])
        paths.push(packages_dir + "/" + pkg_name)
        i = i + 1
    }

    // Also add .pantry/bin (project-level scripts)
    if (OS.file_exists(".pantry/bin")) {
        paths.push(".pantry/bin")
    }

    // Join as PATH-style string
    var result: String = ""
    i = 0
    while (i < paths.length()) {
        if (i > 0) { result = result + ":" }
        result = result + paths[i]
        i = i + 1
    }
    return result
}

/// Run a shell command, returning its exit code. Never swallows failure.
fun _exec_shell(cmd: String): Int {
    var bin_path: String = _bin_path_prefix()

    IO.println("> " + cmd)

    var env_prefix: String = ""
    if (bin_path.length() > 0) {
        env_prefix = "PATH=${bin_path}:$PATH "
    }
    // Set SAFFRON_LIB_PATH so saffron finds installed packages
    if (OS.file_exists(".pantry/packages")) {
        env_prefix = env_prefix + "SAFFRON_LIB_PATH=.pantry/packages "
    }
    return _shell_status(env_prefix + cmd)
}

/// Resolve a bin command by prefixing relative file paths with the package directory.
/// "saffron run tools/sfx.sf" → "saffron run /abs/path/.pantry/packages/pkg/tools/sfx.sf"
fun _resolve_bin_cmd(bin_cmd: String, pkg_dir: String): String {
    // Find .sf file references in the command and make them absolute
    var parts: List<String> = bin_cmd.split(" ")
    var result: List<String> = []
    var i: Int = 0
    while (i < parts.length()) {
        var part: String = parts[i]
        if (part.ends_with(".sf") and !(part.starts_with("/"))) {
            // Relative .sf path — prefix with package dir
            result.push(pkg_dir + "/" + part)
        } else {
            result.push(part)
        }
        i = i + 1
    }
    // Join with spaces
    var joined: String = ""
    i = 0
    while (i < result.length()) {
        if (i > 0) { joined = joined + " " }
        joined = joined + result[i]
        i = i + 1
    }
    return joined
}

/// Collect all available scripts: project scripts + dependency bin scripts.
fun _collect_scripts(manifest: Config.Manifest): Map<String, String> {
    var scripts: Map<String, String> = {}

    // Start with project scripts
    var proj_keys: List<String> = manifest.scripts.keys()
    var i: Int = 0
    while (i < proj_keys.length()) {
        var key: String = proj_keys[i]
        scripts.set(key, manifest.scripts.get(key))
        i = i + 1
    }

    // Scan installed dependencies for exported bin scripts
    var packages_dir: String = ".pantry/packages"
    if (!(OS.file_exists(packages_dir))) {
        return scripts
    }

    var packages: List<String> = OS.exec("ls ${packages_dir} 2>/dev/null").trim().split("\n")
    i = 0
    while (i < packages.length()) {
        var pkg_name: String = packages[i].trim()
        if (pkg_name == "") {
            i = i + 1
            continue
        }

        var pkg_manifest: String = packages_dir + "/" + pkg_name + "/pantry.toml"
        if (!(OS.file_exists(pkg_manifest))) {
            i = i + 1
            continue
        }

        var pkg_config: TOML.TomlTable = TOML.load(pkg_manifest)

        if (pkg_config.has("scripts")) {
            var pkg_scripts: TOML.TomlTable = pkg_config.table("scripts")
            if (pkg_scripts.has("bin")) {
                var bin_scripts: Map<String, String> = pkg_scripts.table("bin").to_map()
                var bin_keys: List<String> = bin_scripts.keys()
                var j: Int = 0
                while (j < bin_keys.length()) {
                    var bin_name: String = bin_keys[j]
                    var bin_cmd: String = bin_scripts.get(bin_name)

                    // Rewrite "saffron run <path>" to use absolute path from package dir
                    var pkg_dir: String = packages_dir + "/" + pkg_name
                    var resolved_cmd: String = _resolve_bin_cmd(bin_cmd, pkg_dir)

                    // Always available as pkg_name:script_name
                    scripts.set(pkg_name + ":" + bin_name, resolved_cmd)

                    // Also available unprefixed if no conflict
                    if (!(scripts.has(bin_name))) {
                        scripts.set(bin_name, resolved_cmd)
                    }

                    j = j + 1
                }
            }
        }

        i = i + 1
    }

    return scripts
}

/// Get the first word of a command string.
fun _first_word(s: String): String {
    var space_idx: Int = s.index_of(" ")
    if (space_idx < 0) { return s }
    return s.slice(0, space_idx)
}

/// Get everything after the first word (including the leading space).
fun _rest_after_first(s: String): String {
    var space_idx: Int = s.index_of(" ")
    if (space_idx < 0) { return "" }
    return s.slice(space_idx, s.length())
}

/// Execute a command string, expanding script name references.
/// Only expands if the ENTIRE command matches a script name, or if the
/// first word matches. Otherwise passes the full command to the shell
/// (preserving && short-circuit semantics).
/// Returns the exit code of the command that ultimately ran.
fun _exec_command(cmd: String, scripts: Map<String, String>, depth: Int): Int {
    if (depth > 10) {
        throw "pantry: script recursion depth exceeded (circular reference?)"
    }

    var trimmed: String = cmd.trim()

    // Exact match — the whole command is a script name
    if (scripts.has(trimmed)) {
        var expanded: String = scripts.get(trimmed)
        return _exec_command(expanded, scripts, depth + 1)
    }

    // Check first word — for "sfx arg1 arg2" where sfx is a bin script
    var first: String = _first_word(trimmed)
    if (scripts.has(first)) {
        var replacement: String = scripts.get(first)
        var args: String = _rest_after_first(trimmed)
        // If the replacement itself contains &&, let the shell handle it
        return _exec_shell(replacement + args)
    }

    // No expansion needed — pass the entire command to the shell as-is
    // This preserves && short-circuit, ||, pipes, etc.
    return _exec_shell(trimmed)
}

/// Run a named script from the [scripts] section (or dep bin scripts).
fun run(script_name: String, parsed: Args.ParsedArgs) {
    var manifest: Config.Manifest = Config.load()
    var scripts: Map<String, String> = _collect_scripts(manifest)

    if (!(scripts.has(script_name))) {
        IO.println("pantry run: no script named '${script_name}'")
        IO.println("")
        if (scripts.length() > 0) {
            IO.println("Available scripts:")
            var keys: List<String> = scripts.keys()
            var i: Int = 0
            while (i < keys.length()) {
                IO.println("  ${keys[i]} = ${scripts.get(keys[i])}")
                i = i + 1
            }
        } else {
            IO.println("No scripts defined. Add a [scripts] section to pantry.toml.")
        }
        OS.exit(1)
    }

    var cmd: String = scripts.get(script_name)
    var code: Int = _exec_command(cmd, scripts, 0)
    if (code != 0) {
        IO.println("pantry: script '${script_name}' failed (exit ${code})")
        OS.exit(code)
    }
}

/// Run a raw shell command in the project context.
fun run_raw(cmd: String, parsed: Args.ParsedArgs) {
    var code: Int = _exec_shell(cmd)
    if (code != 0) {
        OS.exit(code)
    }
}
