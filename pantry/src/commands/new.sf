//! `pantry new <name>` — scaffold a new Saffron project.
import "@args" as Args
import "@os" as OS
import "@process" as Process

fun _validate_name(name: String) {
    if (name.length() == 0) {
        IO.println("pantry new: project name cannot be empty")
        OS.exit(1)
    }
    var first: String = name.char_at(0)
    var alpha: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    if (!(alpha.contains(first))) {
        IO.println("pantry new: project name must start with a letter or underscore")
        OS.exit(1)
    }
    var valid_chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_"
    var i: Number = 0
    while (i < name.length()) {
        if (!(valid_chars.contains(name.char_at(i)))) {
            IO.println("pantry new: invalid character in project name (use letters, digits, hyphens, underscores)")
            OS.exit(1)
        }
        i = i + 1
    }
}

fun _write_manifest(dir: String, name: String, is_lib: Bool) {
    var content: String = "[package]\n"
    content = content + "name = \"" + name + "\"\n"
    content = content + "version = \"0.1.0\"\n"
    content = content + "description = \"\"\n"
    if (is_lib) {
        content = content + "entry = \"src/lib.sf\"\n"
    } else {
        content = content + "entry = \"src/main.sf\"\n"
    }
    content = content + "\n[dependencies]\n"
    content = content + "\n[scripts]\n"
    if (!(is_lib)) {
        content = content + "build = \"saffron build src/main.sf -o build/" + name + "\"\n"
        content = content + "test = \"saffron run test/test_main.sf\"\n"
    } else {
        content = content + "test = \"saffron run test/test_lib.sf\"\n"
    }
    IO.write_file(dir + "/pantry.toml", content)
}

fun _write_main(dir: String, name: String) {
    var content: String = "//! " + name + " — a Saffron application.\n\n"
    content = content + "fun main() {\n"
    content = content + "    IO.println(\"Hello from " + name + "!\")\n"
    content = content + "}\n\n"
    content = content + "main()\n"
    IO.write_file(dir + "/src/main.sf", content)
}

fun _write_lib(dir: String, name: String) {
    var content: String = "//! " + name + " — a Saffron library.\n\n"
    content = content + "/// Add two numbers together.\n"
    content = content + "fun add(a: Number, b: Number): Number {\n"
    content = content + "    return a + b\n"
    content = content + "}\n"
    IO.write_file(dir + "/src/lib.sf", content)
}

fun _write_test_app(dir: String, name: String) {
    var content: String = "//! Tests for " + name + ".\n"
    content = content + "import \"@test\" as Test\n\n"
    content = content + "Test.assert(true, \"placeholder test\")\n"
    content = content + "Test.summary()\n"
    IO.write_file(dir + "/test/test_main.sf", content)
}

fun _write_test_lib(dir: String, name: String) {
    var content: String = "//! Tests for " + name + ".\n"
    content = content + "import \"@test\" as Test\n"
    content = content + "import \"../src/lib.sf\" as Lib\n\n"
    content = content + "Test.assert_eq(Lib.add(1, 2), 3, \"add works\")\n"
    content = content + "Test.summary()\n"
    IO.write_file(dir + "/test/test_lib.sf", content)
}

fun _write_readme(dir: String, name: String, is_lib: Bool) {
    var content: String = "# " + name + "\n\nA Saffron project.\n\n"
    if (!(is_lib)) {
        content = content + "## Build\n\n```bash\npantry build\n```\n\n"
        content = content + "## Run\n\n```bash\n./build/" + name + "\n```\n\n"
    }
    content = content + "## Test\n\n```bash\npantry test\n```\n"
    IO.write_file(dir + "/README.md", content)
}

fun _write_gitignore(dir: String) {
    var content: String = "build/\n.pantry/\npantry.lock\n*.ll\n"
    IO.write_file(dir + "/.gitignore", content)
}

fun _write_cli_manifest(dir: String, name: String) {
    var content: String = "[package]\n"
    content = content + "name = \"" + name + "\"\n"
    content = content + "version = \"0.1.0\"\n"
    content = content + "description = \"A CLI tool\"\n"
    content = content + "entry = \"src/main.sf\"\n"
    content = content + "\n[dependencies]\n"
    content = content + "\n[scripts]\n"
    content = content + "build = \"saffron build src/main.sf -o build/" + name + "\"\n"
    content = content + "test = \"saffron run test/test_main.sf\"\n"
    IO.write_file(dir + "/pantry.toml", content)
}

fun _write_cli_main(dir: String, name: String) {
    var content: String = "//! " + name + " — a command-line tool.\n\n"
    content = content + "import \"@args\" as Args\n"
    content = content + "import \"@os\" as OS\n"
    content = content + "import \"@process\" as Process\n\n"
    content = content + "fun usage() {\n"
    content = content + "    IO.println(\"" + name + " — a command-line tool\")\n"
    content = content + "    IO.println(\"\")\n"
    content = content + "    IO.println(\"Usage: " + name + " <command> [options]\")\n"
    content = content + "    IO.println(\"\")\n"
    content = content + "    IO.println(\"Commands:\")\n"
    content = content + "    IO.println(\"  hello       Print a greeting\")\n"
    content = content + "    IO.println(\"  version     Show version\")\n"
    content = content + "    IO.println(\"\")\n"
    content = content + "    IO.println(\"Options:\")\n"
    content = content + "    IO.println(\"  --help, -h  Show this help\")\n"
    content = content + "}\n\n"
    content = content + "var parsed: Args.ParsedArgs = Args.parse()\n"
    content = content + "var positional: List<String> = parsed.positional\n\n"
    content = content + "if (positional.length() == 0 or parsed.flag(\"help\") or parsed.flag(\"h\")) {\n"
    content = content + "    usage()\n"
    content = content + "} else {\n"
    content = content + "    var command: String = positional[0]\n"
    content = content + "    match (command) {\n"
    content = content + "        \"hello\" => IO.println(\"Hello from " + name + "!\")\n"
    content = content + "        \"version\" => IO.println(\"" + name + " 0.1.0\")\n"
    content = content + "        _ => {\n"
    content = content + "            IO.println(\"Unknown command: \" + command)\n"
    content = content + "            IO.println(\"Run '" + name + " --help' for usage.\")\n"
    content = content + "            OS.exit(1)\n"
    content = content + "        }\n"
    content = content + "    }\n"
    content = content + "}\n"
    IO.write_file(dir + "/src/main.sf", content)
}

fun _write_web_manifest(dir: String, name: String) {
    var content: String = "[package]\n"
    content = content + "name = \"" + name + "\"\n"
    content = content + "version = \"0.1.0\"\n"
    content = content + "description = \"A web application built with Turmeric\"\n"
    content = content + "entry = \"src/main.sf\"\n"
    content = content + "target = \"wasm32\"\n"
    content = content + "\n[dependencies]\n"
    content = content + "turmeric = { git = \"https://github.com/henry232323/saffron\", path = \"turmeric\" }\n"
    content = content + "\n[scripts]\n"
    content = content + "build = \"saffron build --target wasm32 src/main.sf -o build/app.wasm\"\n"
    content = content + "dev = \"saffron run dev_server.sf\"\n"
    content = content + "test = \"saffron run test/test_main.sf\"\n"
    IO.write_file(dir + "/pantry.toml", content)
}

fun _write_web_main(dir: String, name: String) {
    var content: String = "//! " + name + " — a web application built with Turmeric.\n\n"
    content = content + "import { signal, mount } from \"turmeric/signal\"\n"
    content = content + "import { div, h1, p, button, text } from \"turmeric/generated_types\"\n"
    content = content + "import { on_click } from \"turmeric/events\"\n\n"
    content = content + "var count = signal(0)\n\n"
    content = content + "var app = div {\n"
    content = content + "    h1 { text(\"" + name + "\") }\n"
    content = content + "    p { text(\"Count: \" + count.get().to_string()) }\n"
    content = content + "    button(on_click=fun () => count.update(fun (n) => n + 1)) {\n"
    content = content + "        text(\"Increment\")\n"
    content = content + "    }\n"
    content = content + "}\n\n"
    content = content + "mount(app)\n"
    IO.write_file(dir + "/src/main.sf", content)
}

fun _write_web_index(dir: String, name: String) {
    OS.exec("mkdir -p " + dir + "/public")
    var content: String = "<!DOCTYPE html>\n<html>\n<head>\n"
    content = content + "    <meta charset=\"utf-8\">\n"
    content = content + "    <title>" + name + "</title>\n"
    content = content + "    <script src=\"turmeric.js\"></script>\n"
    content = content + "</head>\n<body>\n"
    content = content + "    <div id=\"app\"></div>\n"
    content = content + "    <script type=\"module\">\n"
    content = content + "        const wasm = await Turmeric.load('./app.wasm');\n"
    content = content + "        wasm.mount(document.getElementById('app'));\n"
    content = content + "    </script>\n"
    content = content + "</body>\n</html>\n"
    IO.write_file(dir + "/public/index.html", content)
}

fun _write_web_dev_server(dir: String, name: String) {
    var content: String = "//! Dev server with hot reload for " + name + "\n\n"
    content = content + "import \"turmeric/tools/dev_server\" as DevServer\n\n"
    content = content + "DevServer.serve(\"build/\", 8080, [\"src/\", \"public/\"])\n"
    IO.write_file(dir + "/dev_server.sf", content)
}

fun _prompt_choice(question: String, options: List<String>): String {
    IO.println(question)
    var i: Number = 0
    while (i < options.length()) {
        IO.println("  [${i + 1}] ${options[i]}")
        i = i + 1
    }
    IO.print("> ")
    var input: String = IO.readln().trim()

    // Accept number or name
    var idx: Number = input.to_number()
    if (idx > 0 and idx <= options.length()) {
        return options[idx - 1]
    }
    // Try matching by name (case-insensitive prefix)
    i = 0
    while (i < options.length()) {
        if (options[i].to_lower().starts_with(input.to_lower())) {
            return options[i]
        }
        i = i + 1
    }
    // Default to first option
    return options[0]
}

fun run(name: String, parsed: Args.ParsedArgs) {
    _validate_name(name)

    var is_lib: Bool = parsed.flag("lib")
    var no_git: Bool = parsed.flag("no-git")
    var template: String = parsed.get("template")
    var dir: String = OS.cwd() + "/" + name

    // Interactive setup if no flags given
    if (!(is_lib) and template == "") {
        IO.println("")
        IO.println("Creating project: " + name)
        IO.println("")

        var project_type: String = _prompt_choice("What kind of project?", [
            "Application",
            "Library",
            "CLI tool",
            "Web app (turmeric)"
        ])

        if (project_type == "Library") {
            is_lib = true
        } else if (project_type == "CLI tool") {
            template = "cli"
        } else if (project_type == "Web app (turmeric)") {
            template = "web"
        }

        IO.println("")
    }

    if (OS.file_exists(dir)) {
        IO.println("pantry new: directory '" + name + "' already exists")
        OS.exit(1)
    }

    OS.exec("mkdir -p " + dir + "/src")
    OS.exec("mkdir -p " + dir + "/test")

    if (template == "cli") {
        _write_cli_manifest(dir, name)
        _write_cli_main(dir, name)
        _write_test_app(dir, name)
    } else if (template == "web") {
        _write_web_manifest(dir, name)
        _write_web_main(dir, name)
        _write_web_index(dir, name)
        _write_web_dev_server(dir, name)
        _write_test_app(dir, name)
    } else if (is_lib) {
        _write_manifest(dir, name, true)
        _write_lib(dir, name)
        _write_test_lib(dir, name)
    } else {
        _write_manifest(dir, name, false)
        _write_main(dir, name)
        _write_test_app(dir, name)
    }

    _write_readme(dir, name, is_lib)

    if (!(no_git)) {
        _write_gitignore(dir)
        var git_path: String = Process.which("git")
        if (git_path != "") {
            OS.exec("cd " + dir + " && git init --quiet")
        } else {
            IO.println("  note: git not found, skipping repository initialization")
        }
    }

    IO.println("Created project '" + name + "' in ./" + name + "/")
    IO.println("")
    IO.println("  cd " + name)
    if (is_lib) {
        IO.println("  pantry test")
    } else {
        IO.println("  pantry build")
        IO.println("  pantry test")
    }
}
