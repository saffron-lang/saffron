//! `pantry test` — run the project's test suite.
import "@args" as Args

import "@os" as OS
import "../config.sf" as Config

fun run(parsed: Args.ParsedArgs) {
    var manifest = Config.load()

    // If there's a test script, use it
    if (manifest.scripts.has("test")) {
        var cmd = manifest.scripts.get("test")
        IO.println("> ${cmd}")
        var output = OS.exec(cmd)
        IO.print(output)
        return
    }

    // Default: find test files via shell
    var ls_output: String = OS.exec("ls test/test_*.sf 2>/dev/null")
    var sf_tests: List<String> = ls_output.trim().split("\n")

    if (sf_tests.length() == 0) {
        IO.println("pantry test: no test files found in test/")
        IO.println("Create test files matching test/test_*.sf or define [scripts.test]")
        OS.exit(1)
    }

    var passed: Int = 0
    var failed: Int = 0

    var i: Int = 0
    while (i < sf_tests.length()) {
        var file: String = sf_tests[i]
        IO.print("  ${file} ... ")
        var output: String = OS.exec("saffron run ${file}")
        if (output.contains("passed") and !(output.contains("failed"))) {
            IO.println("ok")
            passed = passed + 1
        } else {
            IO.println("FAIL")
            IO.println(output)
            failed = failed + 1
        }
        i = i + 1
    }

    IO.println("")
    IO.println("${passed} passed, ${failed} failed")
    if (failed > 0) {
        OS.exit(1)
    }
}
