//! `pantry test` — run the project's test suite.
import "@args" as Args

import "@os" as OS
import "../config.sf" as Config
import "./run.sf" as Run

fun run(parsed: Args.ParsedArgs) {
    var manifest = Config.load()
    var scripts: Map<String, String> = Run._collect_scripts(manifest)

    // If there's a test script, use it
    if (scripts.has("test")) {
        var cmd = scripts.get("test")
        var script_code: Int = Run._exec_command(cmd, scripts, 0)
        if (script_code != 0) {
            IO.println("pantry test: test script failed (exit ${script_code})")
            OS.exit(script_code)
        }
        return
    }

    // Default: find test files via shell
    var ls_output: String = OS.exec("ls test/test_*.sf 2>/dev/null")
    var sf_tests: List<String> = ls_output.trim().split("\n")

    if (sf_tests.length() == 0) {
        IO.println("pantry test: no test files found in test/")
        IO.println("Create test files matching test/test_*.sf or define [scripts.test]")
        OS.exit(1)
    }

    var passed: Int = 0
    var failed: Int = 0

    var i: Int = 0
    while (i < sf_tests.length()) {
        var file: String = sf_tests[i]
        if (file == "") {
            i = i + 1
            continue
        }
        IO.print("  ${file} ... ")
        // Judge by exit code, not by grepping output: compiler warnings such as
        // "type inference failed" contain the word "failed" and would otherwise
        // mark a fully passing test as a failure.
        var code: Int = Run._shell_status("saffron run ${file} > /dev/null 2>&1")
        if (code == 0) {
            IO.println("ok")
            passed = passed + 1
        } else {
            IO.println("FAIL")
            // Re-run with output shown so the failure is diagnosable.
            Run._shell_status("saffron run ${file} 2>&1 | grep -v '^\\[codegen\\] Warning' | grep -v '^\\[checker\\] Warning'")
            failed = failed + 1
        }
        i = i + 1
    }

    IO.println("")
    IO.println("${passed} passed, ${failed} failed")
    if (failed > 0) {
        OS.exit(1)
    }
}
