//! Load and manage pantry.toml configuration.
//!
//! Supports both static `pantry.toml` manifests and executable `pantry.sf` manifests.
//! When a `pantry.sf` file is present and newer than `pantry.toml` (or the .toml does
//! not exist), pantry will execute the .sf file to regenerate pantry.toml before reading.

import "@toml" as TOML
import "@os" as OS
import "@process" as Process

fun manifest_name(): String {
    return "pantry.toml"
}

fun script_manifest_name(): String {
    return "pantry.sf"
}

/// Represents a parsed pantry.toml manifest.
class Manifest {
    var name: String
    var version: String
    var description: String
    var authors: List<String>
    var license: String
    var entry: String
    var dependencies: Map<String, Any>
    var dev_dependencies: Map<String, Any>
    var scripts: Map<String, String>
    var raw: Map<String, Any>

    fun init() {
        this.name = ""
        this.version = "0.1.0"
        this.description = ""
        this.authors = []
        this.license = ""
        this.entry = "src/main.sf"
        this.dependencies = {}
        this.dev_dependencies = {}
        this.scripts = {}
        this.raw = {}
    }
}

fun _parent_dir(path: String): String {
    var last_slash: Int = -1
    var i: Int = 0
    while (i < path.length()) {
        if (path.char_at(i) == "/") {
            last_slash = i
        }
        i = i + 1
    }
    if (last_slash <= 0) { return "" }
    return path.slice(0, last_slash)
}

/// Check if `pantry.sf` is newer than `pantry.toml` by comparing modification times.
/// Uses `stat` to get mtime. Returns true if .sf is newer or .toml does not exist.
fun _sf_is_newer(sf_path: String, toml_path: String): Bool {
    if (!OS.file_exists(toml_path)) {
        return true
    }
    // Use stat to compare modification timestamps (Unix epoch seconds)
    var sf_mtime_raw = Process.run("stat -f '%m' '" + sf_path + "' 2>/dev/null || stat -c '%Y' '" + sf_path + "' 2>/dev/null")
    var toml_mtime_raw = Process.run("stat -f '%m' '" + toml_path + "' 2>/dev/null || stat -c '%Y' '" + toml_path + "' 2>/dev/null")
    if (!sf_mtime_raw.success or !toml_mtime_raw.success) {
        // If stat fails, assume we need to regenerate
        return true
    }
    var sf_mtime = sf_mtime_raw.stdout.trim()
    var toml_mtime = toml_mtime_raw.stdout.trim()
    // Compare as numbers — sf is newer if its mtime >= toml mtime
    try {
        return sf_mtime.to_number() >= toml_mtime.to_number()
    } catch (e) {
        return true
    }
}

/// Execute a pantry.sf file to regenerate pantry.toml.
/// The .sf file is expected to call Pantry.write_toml() which writes pantry.toml.
fun _regenerate_from_sf(sf_path: String) {
    var result = Process.run("saffron run " + sf_path)
    if (!result.success) {
        var msg = "pantry: failed to execute " + sf_path
        if (result.stderr.length() > 0) {
            msg = msg + "\n" + result.stderr
        }
        if (result.stdout.length() > 0) {
            msg = msg + "\n" + result.stdout
        }
        throw msg
    }
}

/// Find the manifest by walking up from the current directory.
/// Checks for `pantry.sf` first — if present and newer than `pantry.toml`,
/// executes it to regenerate the TOML. Then returns the path to `pantry.toml`.
fun find_manifest(): String {
    var dir = OS.cwd()
    while (true) {
        var sf_candidate = dir + "/" + script_manifest_name()
        var toml_candidate = dir + "/" + manifest_name()

        // Check for pantry.sf first
        if (OS.file_exists(sf_candidate)) {
            if (_sf_is_newer(sf_candidate, toml_candidate)) {
                _regenerate_from_sf(sf_candidate)
            }
            // After regeneration, pantry.toml should exist
            if (OS.file_exists(toml_candidate)) {
                return toml_candidate
            }
        }

        // Fall back to checking for pantry.toml directly
        if (OS.file_exists(toml_candidate)) {
            return toml_candidate
        }

        var parent = _parent_dir(dir)
        if (parent == dir or parent == "") {
            throw "pantry: no ${manifest_name()} or ${script_manifest_name()} found in ${OS.cwd()} or any parent directory"
        }
        dir = parent
    }
    return ""
}

/// Load a manifest from a specific path.
fun load_from(path: String): Manifest {
    var config: TOML.TomlTable = TOML.load(path)
    var manifest = Manifest()
    manifest.raw = config.to_map()

    if (config.has("package")) {
        var pkg: TOML.TomlTable = config.table("package")
        manifest.name = pkg.string_or("name", "")
        manifest.version = pkg.string_or("version", "0.1.0")
        manifest.description = pkg.string_or("description", "")
        manifest.license = pkg.string_or("license", "")
        manifest.entry = pkg.string_or("entry", "src/main.sf")
        if (pkg.has("authors")) {
            manifest.authors = pkg.list("authors")
        }
    }

    if (config.has("dependencies")) {
        manifest.dependencies = config.table("dependencies").to_map()
    }
    if (config.has("dev-dependencies")) {
        manifest.dev_dependencies = config.table("dev-dependencies").to_map()
    }
    if (config.has("scripts")) {
        manifest.scripts = config.table("scripts").to_map()
    }

    return manifest
}

/// Load and parse the manifest file from the current project.
fun load(): Manifest {
    var path = find_manifest()
    return load_from(path)
}

/// Serialize a manifest back to TOML and write to disk.
fun save(manifest: Manifest, path: String) {
    var toml_data: Map<String, Any> = {}

    var pkg: Map<String, Any> = {}
    pkg.set("name", manifest.name)
    pkg.set("version", manifest.version)
    if (manifest.description != "") { pkg.set("description", manifest.description) }
    if (manifest.license != "") { pkg.set("license", manifest.license) }
    if (manifest.entry != "src/main.sf") { pkg.set("entry", manifest.entry) }
    if (manifest.authors.length() > 0) { pkg.set("authors", manifest.authors) }
    toml_data.set("package", pkg)

    if (manifest.dependencies.length() > 0) {
        toml_data.set("dependencies", manifest.dependencies)
    }

    if (manifest.dev_dependencies.length() > 0) {
        toml_data.set("dev-dependencies", manifest.dev_dependencies)
    }

    if (manifest.scripts.length() > 0) {
        toml_data.set("scripts", manifest.scripts)
    }

    IO.write_file(path, TOML.stringify(toml_data))
}
