// Test Float vs Int type distinction

// Test 1: Float literals produce float arithmetic
var pi = 3.14
var r = 2.5
var area = pi * r * r
IO.println(area.to_string())

// Test 2: Float comparisons
var a = 1.5
var b = 2.5
if (a < b) {
    IO.println("1.5 < 2.5: true")
} else {
    IO.println("1.5 < 2.5: false")
}

// Test 3: Float addition
var sum = a + b
IO.println(sum.to_string())

// Test 4: Float subtraction
var diff = b - a
IO.println(diff.to_string())

// Test 5: Float division
var quot = b / a
IO.println(quot.to_string())

// Test 6: Integer loops still work (var i: Float = 0 pattern)
var i: Float = 0
var count: Float = 0
while (i < 5) {
    count = count + 1
    i = i + 1
}
IO.println(count.to_string())

// Test 7: floor() on actual floats
var x = 3.7
var floored = x.floor()
IO.println(floored.to_string())

IO.println("DONE")
