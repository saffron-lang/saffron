//! Parsley Client Generator
//! Reads a Parsley route spec and generates a typed Basil client module.
//!
//! Usage: saffron run parsley/tools/gen_client.sf <spec.json> <output.sf>

import "@args" as Args
import "@json" as JSON

var parsed = Args.parse()
var positional = parsed.positional

if (positional.length() < 2) {
    IO.println("Usage: saffron run gen_client.sf <spec.json> <output.sf>")
    IO.println("")
    IO.println("Generates a typed Basil client from a Parsley API spec.")
    return
}

var spec_path: String = positional[0]
var output_path: String = positional[1]

// Read spec
var spec_json: String = IO.read_file(spec_path)
var endpoints = JSON.parse(spec_json)

if (endpoints == nil) {
    IO.println("Error: failed to parse spec file: " + spec_path)
    return
}

// Generate client module
var sb = StringBuilder()
sb.append("// AUTO-GENERATED by parsley gen_client — do not edit\n")
sb.append("// Source: " + spec_path + "\n")
sb.append("// Regenerate: saffron run parsley/tools/gen_client.sf " + spec_path + " " + output_path + "\n")
sb.append("\n")
sb.append("import { Query, query } from \"basil/query\"\n")
sb.append("import { Mutation, mutation } from \"basil/mutation\"\n")
sb.append("\n")

var i: Float = 0
while (i < endpoints.length()) {
    var ep = endpoints[i]
    var method: String = ep.get("method")
    var path: String = ep.get("path")
    var description: String = ""
    if (ep.has("description")) { description = ep.get("description") }

    // Generate function name from path: /api/v1/packages/:name → getPackage
    var func_name: String = path_to_func_name(path, method)

    // Extract path params
    var params: List<String> = extract_params(path)

    if (description.length() > 0) {
        sb.append("/// " + description + "\n")
    }

    if (method == "GET") {
        // Query function
        if (params.length() == 0) {
            sb.append("fun " + func_name + "(): Query {\n")
            sb.append("    return query(\"" + path + "\")\n")
            sb.append("}\n\n")
        } else {
            var param_str: String = params_to_sig(params)
            var url_expr: String = path_to_interpolation(path, params)
            sb.append("fun " + func_name + "(" + param_str + "): Query {\n")
            sb.append("    return query(" + url_expr + ")\n")
            sb.append("}\n\n")
        }
    } else {
        // Mutation function
        if (params.length() == 0) {
            sb.append("fun " + func_name + "(): Mutation {\n")
            sb.append("    return mutation(\"" + path + "\")\n")
            sb.append("}\n\n")
        } else {
            var param_str: String = params_to_sig(params)
            var url_expr: String = path_to_interpolation(path, params)
            sb.append("fun " + func_name + "(" + param_str + "): Mutation {\n")
            sb.append("    return mutation(" + url_expr + ")\n")
            sb.append("}\n\n")
        }
    }

    i = i + 1
}

IO.write_file(output_path, sb.to_string())
IO.println("Generated: " + output_path + " (" + endpoints.length().to_string() + " endpoints)")

// --- Helpers ---

fun path_to_func_name(path: String, method: String): String {
    // /api/v1/packages/:name → getPackage (for GET) or postPackage (for POST)
    var parts: List<String> = path.split("/")
    var meaningful: List<String> = []
    var i: Float = 0
    while (i < parts.length()) {
        var part: String = parts[i]
        if (part.length() > 0 and !part.starts_with(":") and part != "api" and part != "v1") {
            meaningful.push(part)
        }
        i = i + 1
    }
    var prefix: String = "get"
    if (method == "POST") { prefix = "create" }
    else if (method == "PUT") { prefix = "update" }
    else if (method == "DELETE") { prefix = "delete" }

    if (meaningful.length() == 0) { return prefix }

    var name: String = prefix
    i = 0
    while (i < meaningful.length()) {
        var word: String = meaningful[i]
        // Capitalize first letter
        name = name + word.char_at(0).to_upper() + word.slice(1, word.length())
        i = i + 1
    }
    return name
}

fun extract_params(path: String): List<String> {
    var params: List<String> = []
    var parts: List<String> = path.split("/")
    var i: Float = 0
    while (i < parts.length()) {
        if (parts[i].starts_with(":")) {
            params.push(parts[i].slice(1, parts[i].length()))
        }
        i = i + 1
    }
    return params
}

fun params_to_sig(params: List<String>): String {
    var parts: List<String> = []
    var i: Float = 0
    while (i < params.length()) {
        parts.push(params[i] + ": String")
        i = i + 1
    }
    return parts.join(", ")
}

fun path_to_interpolation(path: String, params: List<String>): String {
    var result: String = path
    var i: Float = 0
    while (i < params.length()) {
        result = result.replace(":" + params[i], "${" + params[i] + "}")
        i = i + 1
    }
    return "\"" + result + "\""
}
