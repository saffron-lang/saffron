//! Typed response types for Parsley.

import "@http/server" as Http
import "@json" as JSON

/// Successful JSON response wrapping any serializable type.
class ApiResponse {
    var data: Any
    var status: Int
    var body: String

    fun init(data: Any, status: Int) {
        this.data = data
        this.status = status
        this.body = JSON.to_string(data)
    }
}

/// Error response body.
class ApiError {
    var error: String
    var status: Int
    var body: String

    fun init(message: String, status: Int) {
        this.error = message
        this.status = status
        this.body = "{\"error\":" + JSON.escape_string(message) + "}"
    }
}

/// Wrap a value in a 200 JSON success response.
fun json(data: Any): ApiResponse {
    return ApiResponse(data, 200)
}

/// Wrap a value in a success response. Alias for `json`.
fun ok(data: Any): ApiResponse {
    return ApiResponse(data, 200)
}

/// 201 Created.
fun created(data: Any): ApiResponse {
    return ApiResponse(data, 201)
}

/// 404 Not Found error.
fun not_found(message: String): ApiError {
    return ApiError(message, 404)
}

/// 400 Bad Request error.
fun bad_request(message: String): ApiError {
    return ApiError(message, 400)
}

/// 401 Unauthorized error.
fun unauthorized(message: String): ApiError {
    return ApiError(message, 401)
}

/// 409 Conflict error.
fun conflict(message: String): ApiError {
    return ApiError(message, 409)
}
