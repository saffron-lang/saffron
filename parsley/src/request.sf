//! Typed request parsing for Parsley.

import "@http/server" as Http
import "@json" as JSON

/// Parse a JSON request body. Returns the parsed Map, or nil if body is empty/invalid.
fun parse_body(req: Http.Request): Any {
    if (req.body == nil) { return nil }
    if (req.body.length() == 0) { return nil }
    try {
        return JSON.parse(req.body)
    } catch (e) {
        return nil
    }
}

/// Alias for parse_body.
fun body(req: Http.Request): Any {
    return parse_body(req)
}

/// Get a path parameter. Returns "" if not found.
fun param(req: Http.Request, name: String): String {
    if (req.params == nil) { return "" }
    if (!req.params.has(name)) { return "" }
    return req.params.get(name)
}

/// Parse query string from raw string.
fun query_params_from_string(qs: String): Map<String, String> {
    var result: Map<String, String> = {}
    if (qs.length() == 0) { return result }
    var parts: List<String> = qs.split("&")
    var i: Int = 0
    while (i < parts.length()) {
        var pair: String = parts[i]
        var eq: Int = pair.index_of("=")
        if (eq > 0) {
            var key: String = pair.slice(0, eq)
            var value: String = pair.slice(eq + 1, pair.length())
            result.set(key, value)
        }
        i = i + 1
    }
    return result
}

/// Parse query string from a request.
fun query_params(req: Http.Request): Map<String, String> {
    if (req.query == nil) { return {} }
    return query_params_from_string(req.query)
}
