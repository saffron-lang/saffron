//! Parsley — Typed API framework for Saffron
//!
//! Provides compile-time type safety for HTTP API routes.
//! The response type of each handler is captured and used for:
//! - Automatic JSON serialization in mount()
//! - Client code generation via gen_client
//! - Compile-time validation that handlers return correct types
//!
//! Usage:
//!   import "parsley" as Parsley
//!
//!   var api = Parsley.router("/api/v1")
//!   api.get("/users", list_users)        // infers Endpoint<ListUsersResponse>
//!   api.post<CreateUserReq, User>("/users", create_user)
//!   api.mount(app)

import { router, ApiRouter, Endpoint } from "./router.sf"
import { ok, created, not_found, bad_request, unauthorized, conflict, ApiResponse, ApiError } from "./response.sf"
import { body, param, query_params, query_params_from_string } from "./request.sf"
import { to_json, to_manifest } from "./spec.sf"
