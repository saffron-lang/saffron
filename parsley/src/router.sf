//! Parsley Router — typed API route definitions
//! Routes declared with endpoint() auto-generate spec for client generation.

import "@http/server" as Http

class Endpoint {
    var method: String
    var path: String
    var handler: (Http.Request) => Http.Response
    var response_type: String
    var body_type: String
    var auth_required: Bool
    var description: String
}

class ApiRouter {
    var endpoints: List<Endpoint>
    var prefix: String

    fun init(prefix: String) {
        this.endpoints = []
        this.prefix = prefix
    }

    fun get(path: String, handler: (Http.Request) => Http.Response): Endpoint {
        var ep = Endpoint("GET", this.prefix + path, handler, "", "", false, "")
        this.endpoints.push(ep)
        return ep
    }

    fun post(path: String, handler: (Http.Request) => Http.Response): Endpoint {
        var ep = Endpoint("POST", this.prefix + path, handler, "", "", false, "")
        this.endpoints.push(ep)
        return ep
    }

    fun put(path: String, handler: (Http.Request) => Http.Response): Endpoint {
        var ep = Endpoint("PUT", this.prefix + path, handler, "", "", false, "")
        this.endpoints.push(ep)
        return ep
    }

    fun delete(path: String, handler: (Http.Request) => Http.Response): Endpoint {
        var ep = Endpoint("DELETE", this.prefix + path, handler, "", "", false, "")
        this.endpoints.push(ep)
        return ep
    }

    /// Register all endpoints with an Http.App
    fun mount(app: Http.App) {
        var i: Float = 0
        while (i < this.endpoints.length()) {
            var ep: Endpoint = this.endpoints[i]
            if (ep.method == "GET") { app.get(ep.path, ep.handler) }
            else if (ep.method == "POST") { app.post(ep.path, ep.handler) }
            else if (ep.method == "PUT") { app.put(ep.path, ep.handler) }
            else if (ep.method == "DELETE") { app.delete(ep.path, ep.handler) }
            i = i + 1
        }
    }

    /// Generate API spec as a list of endpoint descriptors
    fun spec(): List<Map<String, String>> {
        var result: List<Map<String, String>> = []
        var i: Float = 0
        while (i < this.endpoints.length()) {
            var ep: Endpoint = this.endpoints[i]
            var entry: Map<String, String> = {}
            entry.set("method", ep.method)
            entry.set("path", ep.path)
            entry.set("response_type", ep.response_type)
            entry.set("body_type", ep.body_type)
            entry.set("auth", ep.auth_required.to_string())
            entry.set("description", ep.description)
            result.push(entry)
            i = i + 1
        }
        return result
    }
}

/// Create a new API router with a URL prefix
fun router(prefix: String): ApiRouter {
    return ApiRouter(prefix)
}
