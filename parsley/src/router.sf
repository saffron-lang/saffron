//! Parsley Router — typed API route definitions with compile-time type safety.

import "@http/server" as Http
import "@json" as JSON

/// A typed endpoint that knows its response type at compile time.
class Endpoint<TResponse> {
    var method: String
    var path: String
    var handler: (Http.Request) => TResponse
    var auth_required: Bool
    var description: String

    fun init(method: String, path: String, handler: (Http.Request) => TResponse) {
        this.method = method
        this.path = path
        this.handler = handler
        this.auth_required = false
        this.description = ""
    }

    fun auth(required: Bool): Endpoint<TResponse> {
        this.auth_required = required
        return this
    }

    fun describe(desc: String): Endpoint<TResponse> {
        this.description = desc
        return this
    }
}

/// Typed API router — captures response types for each endpoint.
class ApiRouter {
    var endpoints: List<Endpoint<Any>>
    var prefix: String

    fun init(prefix: String) {
        this.endpoints = []
        this.prefix = prefix
    }

    /// Register a GET endpoint with typed response.
    fun get<T>(path: String, handler: (Http.Request) => T): Endpoint<T> {
        var ep = Endpoint("GET", this.prefix + path, handler)
        this.endpoints.push(ep)
        return ep
    }

    /// Register a POST endpoint with typed request body and response.
    fun post<TBody, TResponse>(path: String, handler: (Http.Request) => TResponse): Endpoint<TResponse> {
        var ep = Endpoint("POST", this.prefix + path, handler)
        this.endpoints.push(ep)
        return ep
    }

    /// Register a PUT endpoint.
    fun put<T>(path: String, handler: (Http.Request) => T): Endpoint<T> {
        var ep = Endpoint("PUT", this.prefix + path, handler)
        this.endpoints.push(ep)
        return ep
    }

    /// Register a DELETE endpoint.
    fun delete<T>(path: String, handler: (Http.Request) => T): Endpoint<T> {
        var ep = Endpoint("DELETE", this.prefix + path, handler)
        this.endpoints.push(ep)
        return ep
    }

    /// Mount all routes to an Http.App
    fun mount(app: Http.App) {
        var i: Float = 0
        while (i < this.endpoints.length()) {
            var ep = this.endpoints[i]
            var h = ep.handler
            if (ep.method == "GET") {
                app.get(ep.path, fun (req: Http.Request): Http.Response => {
                    var result = h(req)
                    return Http.json(JSON.to_string(result))
                })
            } else if (ep.method == "POST") {
                app.post(ep.path, fun (req: Http.Request): Http.Response => {
                    var result = h(req)
                    return Http.json(JSON.to_string(result))
                })
            } else if (ep.method == "PUT") {
                app.put(ep.path, fun (req: Http.Request): Http.Response => {
                    var result = h(req)
                    return Http.json(JSON.to_string(result))
                })
            } else if (ep.method == "DELETE") {
                app.delete(ep.path, fun (req: Http.Request): Http.Response => {
                    var result = h(req)
                    return Http.json(JSON.to_string(result))
                })
            }
            i = i + 1
        }
    }
}

/// Create a new typed API router.
fun router(prefix: String): ApiRouter {
    return ApiRouter(prefix)
}
