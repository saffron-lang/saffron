//! Parsley Router — typed API route definitions with compile-time type safety.

import "@http/server" as Http
import "@json" as JSON

/// A typed endpoint that knows its response type at compile time.
class Endpoint {
    var method: String
    var path: String
    var handler: (Http.Request) => TResponse
    var auth_required: Bool
    var description: String

    fun init(method: String, path: String, handler: (Http.Request) => TResponse) {
        this.method = method
        this.path = path
        this.handler = handler
        this.auth_required = false
        this.description = ""
    }

    fun auth(required: Bool): Endpoint {
        this.auth_required = required
        return this
    }

    fun describe(desc: String): Endpoint {
        this.description = desc
        return this
    }
}

/// Typed API router — captures response types for each endpoint.
class ApiRouter {
    var endpoints: List<Endpoint<Any>>
    var prefix: String

    fun init(prefix: String) {
        this.endpoints = []
        this.prefix = prefix
    }

    /// Register a GET endpoint with typed response.
    fun get<T>(path: String, handler: (Http.Request) => T): Endpoint {
        var ep = Endpoint("GET", this.prefix + path, handler)
        this.endpoints.push(ep)
        return ep
    }

    /// Register a POST endpoint with typed request body and response.
    fun post<TBody, TResponse>(path: String, handler: (Http.Request) => TResponse): Endpoint {
        var ep = Endpoint("POST", this.prefix + path, handler)
        this.endpoints.push(ep)
        return ep
    }

    /// Register a PUT endpoint.
    fun put<T>(path: String, handler: (Http.Request) => T): Endpoint {
        var ep = Endpoint("PUT", this.prefix + path, handler)
        this.endpoints.push(ep)
        return ep
    }

    /// Register a DELETE endpoint.
    fun delete<T>(path: String, handler: (Http.Request) => T): Endpoint {
        var ep = Endpoint("DELETE", this.prefix + path, handler)
        this.endpoints.push(ep)
        return ep
    }

    /// Generate API spec as a list of endpoint descriptors (for client generation)
    fun spec(): List<Map<String, String>> {
        var result: List<Map<String, String>> = []
        var i: Int = 0
        while (i < this.endpoints.length()) {
            var ep = this.endpoints[i]
            var entry: Map<String, String> = {}
            entry.set("method", ep.method)
            entry.set("path", ep.path)
            entry.set("auth", ep.auth_required.to_string())
            entry.set("description", ep.description)
            result.push(entry)
            i = i + 1
        }
        return result
    }

    /// Mount all routes to an Http.App
    fun mount(app: Http.App) {
        var i: Float = 0
        while (i < this.endpoints.length()) {
            var ep = this.endpoints[i]
            if (ep.method == "GET") {
                _mount_get(app, ep)
            } else if (ep.method == "POST") {
                _mount_post(app, ep)
            } else if (ep.method == "PUT") {
                _mount_put(app, ep)
            } else if (ep.method == "DELETE") {
                _mount_delete(app, ep)
            }
            i = i + 1
        }
    }
}

/// Mount a single GET endpoint — takes handler as direct function parameter.
fun _mount_get(app: Http.App, ep: Endpoint) {
    _register_get(app, ep.path, ep.handler)
}

fun _register_get(app: Http.App, path: String, handler: Fun) {
    app.get(path, fun (req: Http.Request): Http.Response => {
        try {
            var result = handler(req)
            return Http.json(JSON.to_string(result))
        } catch (e) {
            return _error_response(e)
        }
    })
}

/// Mount a single POST endpoint.
fun _mount_post(app: Http.App, ep: Endpoint) {
    app.post(ep.path, fun (req: Http.Request): Http.Response => {
        try {
            var result = ep.handler(req)
            return Http.json(JSON.to_string(result))
        } catch (e) {
            return _error_response(e)
        }
    })
}

/// Mount a single PUT endpoint.
fun _mount_put(app: Http.App, ep: Endpoint) {
    app.put(ep.path, fun (req: Http.Request): Http.Response => {
        try {
            var result = ep.handler(req)
            return Http.json(JSON.to_string(result))
        } catch (e) {
            return _error_response(e)
        }
    })
}

/// Mount a single DELETE endpoint.
fun _mount_delete(app: Http.App, ep: Endpoint) {
    app.delete(ep.path, fun (req: Http.Request): Http.Response => {
        try {
            var result = ep.handler(req)
            return Http.json(JSON.to_string(result))
        } catch (e) {
            return _error_response(e)
        }
    })
}

/// Convert a caught exception to an HTTP error response.
/// NOTE: Due to a cross-package closure capture bug in the native compiler,
/// mount() does not work reliably for multi-route apps. Use direct registration
/// from the same module as the route handlers instead (see bazaar/src/routes.sf).
fun _error_response(e: Any): Http.Response {
    // Handle string errors directly
    if (e is String) {
        var body = "{\"error\":" + JSON.escape_string(e) + "}"
        return Http.Response(500, body).header("Content-Type", "application/json")
    }
    // Fallback for non-string errors
    return Http.Response(500, "{\"error\":\"internal server error\"}").header("Content-Type", "application/json")
}

/// Create a new typed API router.
fun router(prefix: String): ApiRouter {
    return ApiRouter(prefix)
}
