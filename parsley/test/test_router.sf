import "@test" as Test
import "../src/router.sf" as Parsley
import "@http/server" as Http

// --- Domain types ---
class Package {
    var name: String
    var version: String
}

class PackageList {
    var packages: List<Package>
    var total: Int
}

class PublishRequest {
    var name: String
    var vers: String
    var tarball: String
}

class PublishResponse {
    var ok: Bool
    var package_name: String
    var version: String
}

// --- Handlers with real return types ---
fun list_packages(req: Http.Request): PackageList {
    return PackageList([], 0)
}

fun get_package(req: Http.Request): Package {
    return Package("saffron", "1.0.0")
}

fun publish(req: Http.Request): PublishResponse {
    return PublishResponse(true, "saffron", "1.0.0")
}

// --- Test ---
Test.assert(true, "parsley loads")

var api = Parsley.router("/api/v1")

// These capture the return type T from the handler:
api.get("/packages", list_packages)        // Endpoint<PackageList>
api.get("/packages/:name", get_package)    // Endpoint<Package>
api.post("/packages/publish", publish)     // Endpoint<PublishResponse>

Test.assert_eq(api.endpoints.length(), 3, "three endpoints registered")
Test.assert_eq(api.endpoints[0].method, "GET", "first is GET")
Test.assert_eq(api.endpoints[0].path, "/api/v1/packages", "path with prefix")
Test.assert_eq(api.endpoints[1].path, "/api/v1/packages/:name", "param path")
Test.assert_eq(api.endpoints[2].method, "POST", "third is POST")

// Chained metadata
api.get("/health", fun (req: Http.Request): String => "ok")
    .describe("Health check endpoint")
    .auth(false)

Test.assert_eq(api.endpoints[3].description, "Health check endpoint", "description set via chain")

Test.summary()
