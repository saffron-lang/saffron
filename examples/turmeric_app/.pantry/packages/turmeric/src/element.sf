// Turmeric Element Types — virtual DOM node tree

import "./signal.sf" as Sig

// =============================================================================
// Node Tree
// =============================================================================

enum Node {
    Element(tag: String, attrs: List<Attr>, children: List<Node>),
    Text(content: String),
    Fragment(children: List<Node>)
}

enum Attr {
    Prop(name: String, value: String),
    Event(name: String, handler: (Float) => Nil),
    Bind(name: String, signal: Sig.Signal<String>)
}

// =============================================================================
// Rendering Context — collects children during builder blocks
// =============================================================================

class Context {
    var children: List<Node>

    fun init() {
        this.children = []
    }

    fun add(node: Node) {
        this.children.push(node)
    }
}

var _ctx_stack: List<Context> = []

fun _push_ctx(): Context {
    var ctx = Context()
    _ctx_stack.push(ctx)
    return ctx
}

fun _pop_ctx(): Context {
    return _ctx_stack.pop()
}

fun _current_ctx(): Context {
    return _ctx_stack[_ctx_stack.length() - 1]
}

fun _el(tag: String, attrs: List<Attr>, block: () => Nil): Node {
    var ctx: Context = _push_ctx()
    block()
    _pop_ctx()
    var node: Node = Node.Element(tag, attrs, ctx.children)
    if (_ctx_stack.length() > 0) {
        _current_ctx().add(node)
    }
    return node
}

fun text(content: String) {
    _current_ctx().add(Node.Text(content))
}

// =============================================================================
// Render to HTML (for testing / SSR)
// =============================================================================

fun render_to_html(node: Node): String {
    return match (node) {
        Text(content) => content
        Fragment(children) => {
            var html: String = ""
            var i: Float = 0
            while (i < children.length()) {
                html = html + render_to_html(children[i])
                i = i + 1
            }
            html
        }
        Element(tag, attrs, children) => {
            var html: String = "<" + tag
            var i: Float = 0
            while (i < attrs.length()) {
                match (attrs[i]) {
                    Prop(n, v) => { html = html + " " + n + "=\"" + v + "\"" }
                    Event(n, h) => {}
                    Bind(n, sig) => { html = html + " " + n + "=\"" + sig.get() + "\"" }
                }
                i = i + 1
            }
            if (tag == "br" or tag == "hr" or tag == "img" or tag == "input") {
                return html + " />"
            }
            html = html + ">"
            i = 0
            while (i < children.length()) {
                html = html + render_to_html(children[i])
                i = i + 1
            }
            html + "</" + tag + ">"
        }
    }
}
