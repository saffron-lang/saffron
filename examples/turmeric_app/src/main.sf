// Turmeric Demo — what a real app looks like
import "turmeric" as T

// =============================================================================
// State
// =============================================================================

var count = T.signal(0)
var page = T.signal("counter")
var todos = T.signal(["Buy milk", "Write compiler", "Ship framework"])
var new_todo = T.signal("")

// =============================================================================
// Components
// =============================================================================

fun CounterPage(): T.Node {
    var doubled = T.computed(fun (): Float => count.get() * 2)
    var parity = T.computed(fun (): String => {
        if (count.get() % 2 == 0) { return "even" }
        return "odd"
    })

    return section(cls="counter") {
        h1 { "Reactive Counter" }
        p(cls="count-display") { "${count.get()}" }
        p(cls="derived") { "Doubled: ${doubled.get()} | ${parity.get()}" }

        div(cls="button-row") {
            button(on_click=fun (e: T.Event) => count.update(fun (n: Float): Float => n + 1)) {
                "+ Increment"
            }
            button(on_click=fun (e: T.Event) => count.update(fun (n: Float): Float => n - 1)) {
                "- Decrement"
            }
            button(cls="danger", on_click=fun (e: T.Event) => count.set(0)) {
                "Reset"
            }
        }
    }
}

fun TodoPage(): T.Node {
    var active_count = T.computed(fun (): Float => {
        var items: List<String> = todos.get()
        return items.length()
    })

    return section(cls="todos") {
        div(cls="todo-header") {
            h1 { "Todo List" }
            span(cls="badge") { "${active_count.get()} items" }
        }

        div(cls="todo-input") {
            input(
                type="text",
                placeholder="What needs doing?",
                bind_value=new_todo,
                on_keydown=fun (e: T.Event) => {
                    match (e) {
                        KeyDown(data) => {
                            if (data.key =="Enter" and new_todo.get().length() > 0) {
                                todos.update(fun (list: List<String>): List<String> => {
                                    list.push(new_todo.get())
                                    return list
                                })
                                new_todo.set("")
                            }
                        }
                        _ => {}
                    }
                }
            )
            button(on_click=fun (e: T.Event) => {
                if (new_todo.get().length() > 0) {
                    todos.update(fun (list: List<String>): List<String> => {
                        list.push(new_todo.get())
                        return list
                    })
                    new_todo.set("")
                }
            }) {
                "Add"
            }
        }

        ul(cls="todo-list") {
            T.each(todos.get()) { todo =>
                li(cls="todo-item") { todo }
            }
        }
    }
}

fun AboutPage(): T.Node {
    return section(cls="about") {
        h1 { "About Turmeric" }
        p { "A reactive web framework for Saffron, compiled to WebAssembly." }

        ul(cls="features") {
            li { "Fine-grained reactivity via Signals" }
            li { "No virtual DOM — surgical DOM updates" }
            li { "Compiles to < 40KB WASM binary" }
            li { "Typed from the DOM spec (112 elements)" }
            li { "Pattern matching on events" }
            li { "Component lifecycle with automatic cleanup" }
            li { "Client-side routing" }
            li { "Scoped CSS + theming" }
        }
    }
}

// =============================================================================
// App Shell
// =============================================================================

fun App(): T.Node {
    return div(id="app") {
        header(cls="app-header") {
            h1(cls="logo") { "Turmeric" }

            nav(cls="nav") {
                button(
                    cls=T.cx({"nav-link": true, "active": page.get() == "counter"}),
                    on_click=fun (e: T.Event) => page.set("counter")
                ) { "Counter" }

                button(
                    cls=T.cx({"nav-link": true, "active": page.get() == "todos"}),
                    on_click=fun (e: T.Event) => page.set("todos")
                ) { "Todos" }

                button(
                    cls=T.cx({"nav-link": true, "active": page.get() == "about"}),
                    on_click=fun (e: T.Event) => page.set("about")
                ) { "About" }
            }
        }

        main(cls="content") {
            match (page.get()) {
                "counter" => CounterPage()
                "todos" => TodoPage()
                "about" => AboutPage()
                _ => p { "404 — Not Found" }
            }
        }

        footer(cls="app-footer") {
            "Built with Saffron + Turmeric | Signals + Effects + WASM"
        }
    }
}

// =============================================================================
// Mount
// =============================================================================

T.mount("#app", App)
