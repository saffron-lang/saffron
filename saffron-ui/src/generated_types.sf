fun name(value: String): Attr { return Attr.Prop("name", value) }
fun value(value: String): Attr { return Attr.Prop("value", value) }
fun placeholder(value: String): Attr { return Attr.Prop("placeholder", value) }
fun disabled(value: String): Attr { return Attr.Prop("disabled", value) }
fun checked(value: String): Attr { return Attr.Prop("checked", value) }
fun readonly_(value: String): Attr { return Attr.Prop("readonly", value) }
fun required(value: String): Attr { return Attr.Prop("required", value) }
fun multiple(value: String): Attr { return Attr.Prop("multiple", value) }
fun selected(value: String): Attr { return Attr.Prop("selected", value) }
fun action(value: String): Attr { return Attr.Prop("action", value) }
fun method(value: String): Attr { return Attr.Prop("method", value) }
fun target(value: String): Attr { return Attr.Prop("target", value) }
fun rel(value: String): Attr { return Attr.Prop("rel", value) }
fun width(value: String): Attr { return Attr.Prop("width", value) }
fun height(value: String): Attr { return Attr.Prop("height", value) }
fun min(value: String): Attr { return Attr.Prop("min", value) }
fun max(value: String): Attr { return Attr.Prop("max", value) }
fun step(value: String): Attr { return Attr.Prop("step", value) }
fun pattern(value: String): Attr { return Attr.Prop("pattern", value) }
fun autocomplete(value: String): Attr { return Attr.Prop("autocomplete", value) }
fun autofocus(value: String): Attr { return Attr.Prop("autofocus", value) }
fun for_(value: String): Attr { return Attr.Prop("for", value) }
fun colspan(value: String): Attr { return Attr.Prop("colspan", value) }
fun rowspan(value: String): Attr { return Attr.Prop("rowspan", value) }

// --- Data & ARIA attributes ---

fun data(name: String, value: String): Attr { return Attr.Prop("data-" + name, value) }
fun aria(name: String, value: String): Attr { return Attr.Prop("aria-" + name, value) }
