<idea-plugin>
    <!-- Not dev.saffron.intellij: the Plugin Verifier rejects any plugin ID
         containing "intellij" as a leftover from the project template
         (TemplateWordInPluginId), which made `verifyPlugin` unable to check
         anything else. Renamed rather than muted because at 0.1.0 nothing is
         published and no installed plugin has this ID to break (an ID change
         makes an already-installed plugin a different plugin). The Kotlin
         package stays dev.saffron.intellij; only the ID is checked. -->
    <id>dev.saffron.lang</id>
    <name>Saffron</name>
    <version>0.1.0</version>
    <vendor>saffron-lang</vendor>
    <description>Language support for Saffron (.sf files)</description>

    <!-- The LSP client API (com.intellij.platform.lsp) is Ultimate-only; it is
         not in com.intellij.modules.platform, so this dependency is what keeps
         the plugin from installing into Community and then failing to load its
         only extension point. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <depends optional="true" config-file="textmate.xml">org.jetbrains.plugins.textmate</depends>

    <!-- idea-version is injected by build.gradle.kts (intellijPlatform
         .pluginConfiguration.ideaVersion), not declared here: the Gradle plugin
         overwrites this element during patchPluginXml, so a value written here
         is silently replaced. See that block for the chosen range and why. -->

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider
            implementation="dev.saffron.intellij.SaffronLspServerSupportProvider"/>
        <configurationType
            implementation="dev.saffron.intellij.SaffronPantryConfigurationType"/>
    </extensions>
</idea-plugin>
