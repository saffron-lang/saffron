<idea-plugin>
    <id>dev.saffron.intellij</id>
    <name>Saffron</name>
    <version>0.1.0</version>
    <vendor>saffron-lang</vendor>
    <description>Language support for Saffron (.sf files)</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider
            implementation="dev.saffron.intellij.SaffronLspServerSupportProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.textmate">
        <bundleProvider implementation="dev.saffron.intellij.SaffronTextMateBundleProvider"/>
    </extensions>
</idea-plugin>
