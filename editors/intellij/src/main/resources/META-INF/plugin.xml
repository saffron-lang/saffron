<idea-plugin>
    <id>dev.saffron.intellij</id>
    <name>Saffron</name>
    <version>0.1.0</version>
    <vendor>saffron-lang</vendor>
    <description>Language support for Saffron (.sf files)</description>

    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Saffron"
            implementationClass="dev.saffron.intellij.SaffronFileType"
            fieldName="INSTANCE"
            language="Saffron"
            extensions="sf"/>

        <lang.parserDefinition
            language="Saffron"
            implementationClass="dev.saffron.intellij.SaffronParserDefinition"/>

        <platform.lsp.serverSupportProvider
            implementation="dev.saffron.intellij.SaffronLspServerSupportProvider"/>
    </extensions>
</idea-plugin>
