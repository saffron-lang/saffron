{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "/*", "close": " */", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "onEnterRules": [
    {
      "comment": "Continue a /// doc comment on the next line.",
      "beforeText": "^\\s*///.*$",
      "action": { "indent": "none", "appendText": "/// " }
    },
    {
      "comment": "Continue a //! module-doc comment on the next line.",
      "beforeText": "^\\s*//!.*$",
      "action": { "indent": "none", "appendText": "//! " }
    },
    {
      "comment": "Inside a /* */ block, prefix continuation lines with ' * '.",
      "beforeText": "^\\s*/\\*(?!.*\\*/).*$",
      "action": { "indent": "none", "appendText": " * " }
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}\"']*$",
    "decreaseIndentPattern": "^\\s*\\}"
  }
}
