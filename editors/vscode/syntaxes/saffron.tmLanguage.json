{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Saffron",
  "scopeName": "source.saffron",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#constants" },
    { "include": "#modules" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.saffron",
          "begin": "@(\\w+)(\\()",
          "beginCaptures": {
            "1": { "name": "entity.name.tag.annotation.saffron" },
            "2": { "name": "punctuation.definition.annotation.begin.saffron" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.annotation.end.saffron" }
          },
          "patterns": [
            { "include": "#strings" }
          ]
        },
        {
          "name": "meta.annotation.saffron",
          "match": "@(\\w+)\\b",
          "captures": {
            "1": { "name": "entity.name.tag.annotation.saffron" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.saffron",
          "match": "//[/!].*$"
        },
        {
          "name": "comment.line.double-slash.saffron",
          "match": "//.*$"
        },
        {
          "name": "comment.block.saffron",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.saffron",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.saffron",
              "match": "\\\\[nrt\\\\\"0/]"
            },
            {
              "name": "meta.embedded.expression.saffron",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.saffron" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.saffron" }
              },
              "patterns": [
                { "include": "source.saffron" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.saffron",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.saffron",
          "match": "\\b(if|else|for|while|return|break|continue|match|yield|throw|try|catch|finally|import|as|in|is)\\b"
        },
        {
          "name": "keyword.operator.logical.saffron",
          "match": "\\b(and|or)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "comment": "Access modifiers are SOFT keywords: a modifier only when a declaration introducer follows, so `var private = 1` and `private.close()` still read as identifiers. Mirrors parser.sf::at_visibility_modifier (var/let/fun/enum/class/interface/actor/type/@/extend).",
          "name": "storage.modifier.saffron",
          "match": "\\b(private|public|protected|internal)\\b(?=\\s+(var|let|fun|enum|class|interface|actor|type|extend|@))"
        },
        {
          "name": "storage.type.saffron",
          "match": "\\b(var|let|fun|class|enum|interface|actor|type|extends|extend)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.saffron",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "variable.language.saffron",
          "match": "\\b(this|super)\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "support.class.saffron",
          "match": "\\b(IO|Math|Time|Json|Reflect|Task|Iter|Test|Async)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.saffron",
          "match": "\\b(Number|String|Bool|Nil|Any|Never|List|Map)\\b"
        },
        {
          "name": "entity.name.type.saffron",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.saffron",
          "match": "\\b([a-z_][a-zA-Z0-9_]*[?!]?)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.saffron",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.saffron",
          "match": "=>"
        },
        {
          "name": "keyword.operator.saffron",
          "match": "[+\\-*/%=!<>]=?|\\|"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.saffron",
          "match": "\\b[a-z_][a-zA-Z0-9_]*[?!]?\\b"
        }
      ]
    }
  }
}
