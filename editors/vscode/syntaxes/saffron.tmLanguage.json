{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Saffron",
  "scopeName": "source.saffron",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#atoms" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#constants" },
    { "include": "#modules" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.saffron",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.saffron",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.saffron",
              "match": "\\\\[nrt\\\\\"0/]"
            },
            {
              "name": "meta.embedded.expression.saffron",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.saffron" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.saffron" }
              },
              "patterns": [
                { "include": "source.saffron" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.saffron",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "atoms": {
      "patterns": [
        {
          "name": "constant.other.atom.saffron",
          "match": ":[a-zA-Z_][a-zA-Z0-9_]*[?!]?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.saffron",
          "match": "\\b(if|else|for|while|return|break|continue|match|yield|await|resume|throw|try|catch|finally|import|as|in|is)\\b"
        },
        {
          "name": "keyword.operator.logical.saffron",
          "match": "\\b(and|or)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.saffron",
          "match": "\\b(var|let|fun|class|data|enum|interface|type|extends)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.saffron",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "variable.language.saffron",
          "match": "\\b(this|super)\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "support.class.saffron",
          "match": "\\b(IO|Math|Time|Json|Reflect|Task|Iter|Test|Async)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.saffron",
          "match": "\\b(Number|String|Bool|Nil|Any|Never|List|Map)\\b"
        },
        {
          "name": "entity.name.type.saffron",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.saffron",
          "match": "\\b([a-z_][a-zA-Z0-9_]*[?!]?)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.saffron",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.saffron",
          "match": "=>"
        },
        {
          "name": "keyword.operator.saffron",
          "match": "[+\\-*/%=!<>]=?|\\|"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.saffron",
          "match": "\\b[a-z_][a-zA-Z0-9_]*[?!]?\\b"
        }
      ]
    }
  }
}
