//! Generate mdBook markdown documentation from Saffron source files.
//! Parses /// doc-comments and function/class/enum signatures.
//!
//! Usage: saffron tools/gen_docs.sf <source_dir> <output_dir>

import "@os" as OS
import "@path" as Path

/// A documented item extracted from source.
enum DocItem {
    FunDoc(name: String, params: String, return_type: String, doc: String),
    ClassDoc(name: String, doc: String),
    EnumDoc(name: String, doc: String),
    VarDoc(name: String, type_ann: String, doc: String),
    ModuleDoc(doc: String)
}

/// Parse a single .sf file and extract documented items.
fun parse_file(path: String): List<DocItem> {
    var source = IO.read_file(path)
    var lines = source.split("\n")
    var items: List<DocItem> = []
    var current_doc: List<String> = []
    var module_doc: List<String> = []
    var in_module_doc = true

    var i = 0
    while (i < lines.length()) {
        var line = lines[i].trim()

        if (line.starts_with("//!")) {
            if (in_module_doc) {
                var text = strip_doc_prefix(line, "//!")
                module_doc.push(text)
            }
            i = i + 1
            continue
        }

        in_module_doc = false

        if (line.starts_with("///")) {
            var text = strip_doc_prefix(line, "///")
            current_doc.push(text)
            i = i + 1
            continue
        }

        if (current_doc.length() > 0) {
            var doc = join_lines(current_doc)
            var item = parse_declaration(line, doc)
            if (!(item is Nil)) {
                items.push(item)
            }
            current_doc = []
        }

        i = i + 1
    }

    if (module_doc.length() > 0) {
        var mod_item = DocItem.ModuleDoc(join_lines(module_doc))
        items = [mod_item] + items
    }

    return items
}

/// Join a list of strings with newlines.
fun join_lines(lines: List<String>): String {
    var result = ""
    var i = 0
    while (i < lines.length()) {
        if (i > 0) {
            result = result + "\n"
        }
        result = result + lines[i]
        i = i + 1
    }
    return result
}

/// Strip a doc-comment prefix and optional leading space.
fun strip_doc_prefix(line: String, prefix: String): String {
    var after = line.slice(prefix.length(), line.length())
    if (after.length() > 0 and after.char_at(0) == " ") {
        return after.slice(1, after.length())
    }
    return after
}

/// Try to parse a declaration line into a DocItem.
fun parse_declaration(line: String, doc: String) {
    if (line.starts_with("fun ")) {
        return parse_fun_decl(line, doc)
    }
    if (line.starts_with("class ")) {
        return parse_class_decl(line, doc)
    }
    if (line.starts_with("enum ")) {
        return parse_enum_decl(line, doc)
    }
    if (line.starts_with("var ") or line.starts_with("let ")) {
        return parse_var_decl(line, doc)
    }
    return nil
}

/// Parse a function declaration line.
fun parse_fun_decl(line: String, doc: String): DocItem {
    var rest = line.slice(4, line.length())

    var paren_idx = rest.index_of("(")
    if (paren_idx < 0) {
        return DocItem.FunDoc(rest.trim(), "", "", doc)
    }

    var name = rest.slice(0, paren_idx).trim()

    var generic_idx = name.index_of("<")
    if (generic_idx >= 0) {
        name = name.slice(0, generic_idx)
    }

    var after_name = rest.slice(paren_idx, rest.length())
    var close_paren = find_matching_paren(after_name)
    var params = ""
    if (close_paren > 0) {
        params = after_name.slice(1, close_paren)
    }

    var return_type = ""
    if (close_paren > 0) {
        var after_params = after_name.slice(close_paren + 1, after_name.length()).trim()
        if (after_params.starts_with(":")) {
            var type_str = after_params.slice(1, after_params.length()).trim()
            var brace_idx = type_str.index_of("{")
            if (brace_idx >= 0) {
                type_str = type_str.slice(0, brace_idx).trim()
            }
            return_type = type_str
        }
    }

    return DocItem.FunDoc(name, params, return_type, doc)
}

/// Find the index of the matching closing paren.
fun find_matching_paren(s: String): Number {
    var depth = 0
    var i = 0
    while (i < s.length()) {
        var ch = s.char_at(i)
        if (ch == "(") {
            depth = depth + 1
        } else if (ch == ")") {
            depth = depth - 1
            if (depth == 0) {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

/// Parse a class declaration line.
fun parse_class_decl(line: String, doc: String): DocItem {
    var rest = line.slice(6, line.length()).trim()
    var name = extract_identifier(rest)
    return DocItem.ClassDoc(name, doc)
}

/// Parse an enum declaration line.
fun parse_enum_decl(line: String, doc: String): DocItem {
    var rest = line.slice(5, line.length()).trim()
    var name = extract_identifier(rest)
    return DocItem.EnumDoc(name, doc)
}

/// Parse a variable declaration line.
fun parse_var_decl(line: String, doc: String): DocItem {
    var rest = line.slice(4, line.length()).trim()
    var colon_idx = rest.index_of(":")
    var eq_idx = rest.index_of("=")

    var name = ""
    var type_ann = ""

    if (colon_idx >= 0 and (eq_idx < 0 or colon_idx < eq_idx)) {
        name = rest.slice(0, colon_idx).trim()
        if (eq_idx >= 0) {
            type_ann = rest.slice(colon_idx + 1, eq_idx).trim()
        } else {
            type_ann = rest.slice(colon_idx + 1, rest.length()).trim()
        }
    } else if (eq_idx >= 0) {
        name = rest.slice(0, eq_idx).trim()
    } else {
        name = rest
    }

    return DocItem.VarDoc(name, type_ann, doc)
}

/// Extract an identifier (stops at space, <, {, or end).
fun extract_identifier(s: String): String {
    var i = 0
    while (i < s.length()) {
        var ch = s.char_at(i)
        if (ch == " " or ch == "<" or ch == "{" or ch == "(") {
            return s.slice(0, i)
        }
        i = i + 1
    }
    return s
}

/// Format a list of DocItems as mdBook markdown.
fun render_module(module_name: String, items: List<DocItem>): String {
    var out: List<String> = []
    out.push("# ${module_name}")
    out.push("")

    for (item in items) {
        var section = render_item(item)
        out.push(section)
    }

    return join_lines(out)
}

/// Render a single DocItem to markdown.
fun render_item(item: DocItem): String {
    return match (item) {
        ModuleDoc(doc) => doc + "\n",
        FunDoc(name, params, return_type, doc) => render_fun(name, params, return_type, doc),
        ClassDoc(name, doc) => render_class(name, doc),
        EnumDoc(name, doc) => render_enum(name, doc),
        VarDoc(name, type_ann, doc) => render_var(name, type_ann, doc)
    }
}

fun render_fun(name: String, params: String, return_type: String, doc: String): String {
    var sig = "fun ${name}(${params})"
    if (return_type != "") {
        sig = sig + ": ${return_type}"
    }
    var out: List<String> = []
    out.push("### `${name}`")
    out.push("")
    out.push("```saffron")
    out.push(sig)
    out.push("```")
    out.push("")
    out.push(doc)
    out.push("")
    return join_lines(out)
}

fun render_class(name: String, doc: String): String {
    var out: List<String> = []
    out.push("## ${name}")
    out.push("")
    out.push(doc)
    out.push("")
    return join_lines(out)
}

fun render_enum(name: String, doc: String): String {
    var out: List<String> = []
    out.push("## ${name}")
    out.push("")
    out.push(doc)
    out.push("")
    return join_lines(out)
}

fun render_var(name: String, type_ann: String, doc: String): String {
    var sig = name
    if (type_ann != "") {
        sig = name + ": ${type_ann}"
    }
    var out: List<String> = []
    out.push("### `${name}`")
    out.push("")
    out.push("```saffron")
    out.push("var ${sig}")
    out.push("```")
    out.push("")
    out.push(doc)
    out.push("")
    return join_lines(out)
}

/// Generate docs for all .sf files in a directory.
fun generate_docs(source_dir: String, output_dir: String) {
    var files = IO.list_dir(source_dir)

    for (file in files) {
        if (file.ends_with(".sf") == false) {
            continue
        }

        var filepath = Path.join([source_dir, file])
        var items = parse_file(filepath)

        if (items.length() == 0) {
            continue
        }

        var module_name = Path.stem(file)
        var markdown = render_module(module_name, items)
        var out_path = Path.join([output_dir, module_name + ".md"])

        IO.write_file(out_path, markdown)
        IO.println("  ${file} -> ${out_path}")
    }
}

// Main
var args = OS.args()
if (args.length() < 3) {
    IO.println("Usage: saffron tools/gen_docs.sf <source_dir> <output_dir>")
    IO.println("")
    IO.println("Generates mdBook markdown from /// doc-comments in .sf files.")
    IO.println("")
    IO.println("Example:")
    IO.println("  saffron tools/gen_docs.sf src/lib/ docs/src/stdlib/")
    OS.exit(1)
}

var source_dir = args[1]
var output_dir = args[2]

IO.println("Generating docs from ${source_dir} -> ${output_dir}")
generate_docs(source_dir, output_dir)
IO.println("Done.")
