//! Generate mdBook markdown documentation from Saffron source files.
//! Uses the @parser and @ast modules for proper source analysis.
//!
//! Usage: saffron tools/gen_docs.sf <source_dir> <output_dir>

import "@os" as OS
import "@path" as Path
import "@parser" as Parser
import "@ast" as AST

/// Extract the module docstring (//! lines) from raw source.
/// Parser doesn't expose this directly yet, so we parse it from the text.
fun extract_module_doc(source: String): String {
    var lines = source.split("\n")
    var doc_lines: List<String> = []
    var i = 0
    while (i < lines.length()) {
        var line = lines[i].trim()
        if (line.starts_with("//!")) {
            var text = line.slice(3, line.length())
            if (text.length() > 0 and text.char_at(0) == " ") {
                text = text.slice(1, text.length())
            }
            doc_lines.push(text)
        } else if (!(line == "") and !(line.starts_with("//"))) {
            break
        }
        i = i + 1
    }
    return join_lines(doc_lines)
}

/// Find all documented top-level var declarations in a statement list.
fun find_vars(stmts: List<AST.Stmt>): List<AST.Stmt> {
    var results: List<AST.Stmt> = []
    for (stmt in stmts) {
        match (stmt) {
            VarDecl(name, type_ann, initializer, docstring, v_vis) => {
                if (!(docstring == "")) {
                    results.push(stmt)
                }
            }
        }
    }
    return results
}

/// Generate markdown documentation for a single source file.
fun generate_file_docs(path: String): String {
    var source = IO.read_file(path)
    var stmts = Parser.parse_file(path)
    var module_name = Path.stem(Path.basename(path))
    var out: List<String> = []

    out.push("# ${module_name}")
    out.push("")

    // Import line
    out.push("```saffron")
    out.push("import \"@${module_name}\" as ${capitalize(module_name)}")
    out.push("```")
    out.push("")

    // Module-level docstring
    var module_doc = extract_module_doc(source)
    if (!(module_doc == "")) {
        out.push(module_doc)
        out.push("")
    }

    var functions = AST.find_functions(stmts)
    var classes = AST.find_classes(stmts)
    var enums = AST.find_enums(stmts)
    var vars = find_vars(stmts)

    if (enums.length() > 0) {
        for (enum_stmt in enums) {
            out.push(render_enum(enum_stmt))
        }
    }

    if (classes.length() > 0) {
        for (class_stmt in classes) {
            out.push(render_class(class_stmt))
        }
    }

    if (vars.length() > 0) {
        out.push("## Constants")
        out.push("")
        for (var_stmt in vars) {
            out.push(render_var(var_stmt))
        }
    }

    if (functions.length() > 0) {
        out.push("## Functions")
        out.push("")
        for (fn_stmt in functions) {
            out.push(render_function(fn_stmt))
        }
    }

    return join_lines(out)
}

/// Render a function declaration to markdown.
fun render_function(stmt: AST.Stmt): String {
    var name = AST.stmt_name(stmt)
    var doc = AST.stmt_doc(stmt)
    var out: List<String> = []

    out.push("### `${name}`")
    out.push("")

    // Extract signature from the FunDecl fields
    match (stmt) {
        FunDecl(fn_name, params, ret_type, body, docstring, f_vis) => {
            var sig = "fun ${fn_name}(${params})"
            if (!(ret_type == "")) {
                sig = sig + ": ${ret_type}"
            }
            out.push("```saffron")
            out.push(sig)
            out.push("```")
            out.push("")
        }
    }

    if (!(doc == "")) {
        out.push(doc)
        out.push("")
    }

    return join_lines(out)
}

/// Render a class declaration to markdown.
fun render_class(stmt: AST.Stmt): String {
    var name = AST.stmt_name(stmt)
    var doc = AST.stmt_doc(stmt)
    var out: List<String> = []

    out.push("## class `${name}`")
    out.push("")

    if (!(doc == "")) {
        out.push(doc)
        out.push("")
    }

    // Render class methods
    match (stmt) {
        ClassDecl(cls_name, type_params, parents, fields, methods, docstring) => {
            if (!(fields == "")) {
                out.push("**Fields:** ${fields}")
                out.push("")
            }
            var documented_methods = AST.find_functions(methods)
            for (method in documented_methods) {
                out.push(render_function(method))
            }
        }
    }

    return join_lines(out)
}

/// Render an enum declaration to markdown.
fun render_enum(stmt: AST.Stmt): String {
    var name = AST.stmt_name(stmt)
    var doc = AST.stmt_doc(stmt)
    var out: List<String> = []

    out.push("## enum `${name}`")
    out.push("")

    if (!(doc == "")) {
        out.push(doc)
        out.push("")
    }

    match (stmt) {
        EnumDecl(enum_name, variants, docstring, e_vis) => {
            if (variants.length() > 0) {
                out.push("**Variants:**")
                out.push("")
                for (variant in variants) {
                    match (variant) {
                        Variant(vname, fields) => {
                            if (fields == "") {
                                out.push("- `${vname}`")
                            } else {
                                out.push("- `${vname}(${fields})`")
                            }
                        }
                    }
                }
                out.push("")
            }
        }
    }

    return join_lines(out)
}

/// Render a documented variable/constant to markdown.
fun render_var(stmt: AST.Stmt): String {
    var name = AST.stmt_name(stmt)
    var doc = AST.stmt_doc(stmt)
    var out: List<String> = []

    out.push("### `${name}`")
    out.push("")

    match (stmt) {
        VarDecl(vname, type_ann, initializer, docstring, v_vis) => {
            if (!(type_ann == "")) {
                out.push("```saffron")
                out.push("var ${vname}: ${type_ann}")
                out.push("```")
                out.push("")
            }
        }
    }

    if (!(doc == "")) {
        out.push(doc)
        out.push("")
    }

    return join_lines(out)
}

/// Capitalize the first letter of a string.
fun capitalize(s: String): String {
    if (s.length() == 0) {
        return s
    }
    var first = s.char_at(0).to_upper()
    if (s.length() == 1) {
        return first
    }
    return first + s.slice(1, s.length())
}

/// Join a list of strings with newlines.
fun join_lines(lines: List<String>): String {
    var result = ""
    var i = 0
    while (i < lines.length()) {
        if (i > 0) {
            result = result + "\n"
        }
        result = result + lines[i]
        i = i + 1
    }
    return result
}

/// Generate docs for all .sf files in a directory.
fun generate_docs(source_dir: String, output_dir: String) {
    var files = IO.list_dir(source_dir)

    for (file in files) {
        if (file.ends_with(".sf") == false) {
            continue
        }

        var filepath = Path.join([source_dir, file])
        var markdown = generate_file_docs(filepath)

        var module_name = Path.stem(file)
        var out_path = Path.join([output_dir, module_name + ".md"])

        IO.write_file(out_path, markdown)
        IO.println("  ${file} -> ${out_path}")
    }
}

// Main
var args = OS.args()
if (args.length() < 3) {
    IO.println("Usage: saffron tools/gen_docs.sf <source_dir> <output_dir>")
    IO.println("")
    IO.println("Generates mdBook markdown from documented Saffron source files.")
    IO.println("Uses @parser and @ast for proper source analysis.")
    IO.println("")
    IO.println("Example:")
    IO.println("  saffron tools/gen_docs.sf src/lib/ docs/src/stdlib/")
    OS.exit(1)
}

var source_dir = args[1]
var output_dir = args[2]

IO.println("Generating docs from ${source_dir} -> ${output_dir}")
generate_docs(source_dir, output_dir)
IO.println("Done.")
