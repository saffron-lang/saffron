#!/usr/bin/env bash
# saffron — unified driver for the Saffron language
#
# Usage:
#   saffron run file.sf          Run a .sf file (compile + execute)
#   saffron build file.sf -o out Compile to native binary
#   saffron emit-ir file.sf      Output LLVM IR (for debugging)
#   saffron file.sf              Shorthand for: saffron run file.sf
#
# This wraps saffronc + clang into a single user-facing command.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SAFFRONC="${SAFFRONC:-$SCRIPT_DIR/build/saffronc}"
RUNTIME="${SAFFRON_RUNTIME:-$SCRIPT_DIR/build/stage3/runtime.ll}"
RUNTIME_SRC="${SAFFRON_RUNTIME_SRC:-$SCRIPT_DIR/src/runtime/runtime.sf}"
RUNTIME_BASE="${SAFFRON_RUNTIME_BASE:-$SCRIPT_DIR/src/runtime/base.ll}"
RUNTIME_GC="${SAFFRON_RUNTIME_GC:-$SCRIPT_DIR/src/runtime/gc.ll}"

usage() {
    echo "saffron — The Saffron Programming Language"
    echo ""
    echo "Usage:"
    echo "  saffron run <file.sf>              Run a Saffron program"
    echo "  saffron build <file.sf> -o <out>   Compile to native binary"
    echo "  saffron build <file.sf>            Compile to ./a.out"
    echo "  saffron emit-ir <file.sf>          Print LLVM IR to stdout"
    echo "  saffron <file.sf>                  Shorthand for: saffron run <file.sf>"
    echo "  saffron version                    Show version"
    echo ""
    echo "Options:"
    echo "  -o <path>    Output binary path (for build)"
    echo "  --opt, -O    Optimization level (default: -O2)"
    echo "  --verbose    Show compilation steps"
    exit 0
}

error() {
    echo "saffron: $1" >&2
    exit 1
}

# --- Parse arguments ---

COMMAND=""
INPUT=""
OUTPUT=""
OPT="-O2"
TARGET=""
VERBOSE=false
LIB_PATHS=()
EXTRA_SAFFRONC_FLAGS=""

if [[ $# -eq 0 ]]; then
    usage
fi

case "$1" in
    run|build|emit-ir|version|--help|-h)
        COMMAND="$1"
        shift
        ;;
    *.sf)
        COMMAND="run"
        ;;
    *)
        error "unknown command '$1'. Run 'saffron --help' for usage."
        ;;
esac

if [[ "$COMMAND" == "--help" || "$COMMAND" == "-h" ]]; then
    usage
fi

if [[ "$COMMAND" == "version" ]]; then
    echo "saffron 0.1.0 (native)"
    exit 0
fi

# Parse remaining args
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)
            shift
            OUTPUT="$1"
            ;;
        --opt|-O)
            shift
            OPT="-O$1"
            ;;
        --verbose)
            VERBOSE=true
            ;;
        --target)
            shift
            TARGET="$1"
            ;;
        --lib-path)
            shift
            LIB_PATHS+=("$1")
            ;;
        *.sf)
            INPUT="$1"
            ;;
        *)
            # Pass through as program arguments for 'run'
            break
            ;;
    esac
    shift
done

if [[ -z "$INPUT" && "$COMMAND" != "version" ]]; then
    error "no input file specified"
fi

if [[ ! -f "$INPUT" ]]; then
    error "file not found: $INPUT"
fi

# --- Check prerequisites ---

if [[ ! -x "$SAFFRONC" ]]; then
    error "saffronc not found at $SAFFRONC. Build with: ./bootstrap.sh"
fi

if ! command -v clang &>/dev/null; then
    error "clang not found. Install LLVM/Clang to compile Saffron programs."
fi

# --- Commands ---

TMPDIR=$(mktemp -d /tmp/saffron_build_XXXXXX)
trap "rm -rf $TMPDIR" EXIT

STDLIB="${SAFFRON_STDLIB:-$SCRIPT_DIR/src/lib}"

compile_to_ir() {
    local input="$1"
    local output="$2"
    [[ "$VERBOSE" == true ]] && echo "  compile: $input -> $output"
    "$SAFFRONC" --stdlib "$STDLIB" "$input" "$output"
}

# Recursively discover all .sf files imported (via relative paths) from an entry file.
# Outputs one absolute path per line, in dependency order (leaves first).
discover_sources() {
    local entry="$1"
    local entry_dir
    entry_dir="$(cd "$(dirname "$entry")" && pwd)"
    local entry_abs="$entry_dir/$(basename "$entry")"

    local -a visited=()
    local -a ordered=()

    _visit() {
        local file="$1"
        local dir
        dir="$(dirname "$file")"

        # Skip if already visited
        for v in "${visited[@]:-}"; do
            [[ "$v" == "$file" ]] && return 0
        done
        visited+=("$file")

        # Find relative imports: import "./foo.sf" or import "../bar.sf"
        local imports
        imports=$(grep -oE 'import "\./[^"]+"|import "\.\./[^"]+"' "$file" 2>/dev/null | \
                  sed 's/import "//;s/"//' || true)

        for imp in $imports; do
            local resolved
            resolved="$(cd "$dir" && cd "$(dirname "$imp")" && pwd)/$(basename "$imp")"
            if [[ -f "$resolved" ]]; then
                _visit "$resolved"
            fi
        done

        ordered+=("$file")
    }

    _visit "$entry_abs"
    printf '%s\n' "${ordered[@]}"
}

# Compile all source files in a project and link into one binary.
build_project() {
    local entry="$1"
    local output="$2"

    local ll_path="$TMPDIR/output.ll"
    local saffronc_flags=""
    [[ -n "$TARGET" ]] && saffronc_flags="--target $TARGET"
    for lp in "${LIB_PATHS[@]:-}"; do
        [[ -n "$lp" ]] && saffronc_flags="$saffronc_flags --lib-path $lp"
    done

    [[ "$VERBOSE" == true ]] && echo "  compile: $entry"
    "$SAFFRONC" $saffronc_flags "$entry" "$ll_path" || {
        echo "saffron: compilation failed: $entry" >&2
        exit 1
    }

    [[ "$VERBOSE" == true ]] && echo "  link: $entry -> $output"
    if [[ "$TARGET" == "wasm" || "$TARGET" == "wasm64" ]]; then
        local WASM_BASE="${SCRIPT_DIR}/src/runtime/wasm_base.ll"
        local WASM_CLANG="${WASM_CLANG:-/opt/homebrew/opt/llvm/bin/clang}"
        local WASM_LD_PATH="${WASM_LD:-/opt/homebrew/bin/wasm-ld}"
        if [[ ! -x "$WASM_CLANG" ]]; then
            WASM_CLANG="clang"
        fi
        # Compile runtime for wasm64
        local runtime_ll="$TMPDIR/runtime.ll"
        "$SAFFRONC" --target wasm "$RUNTIME_SRC" "$runtime_ll" 2>/dev/null || true
        # Link order: wasm_base first (GC stubs + __int_to_string), user code, runtime last
        "$WASM_CLANG" --target=wasm64-unknown-unknown -O2 -w --no-standard-libraries \
            -fuse-ld="$WASM_LD_PATH" \
            -Wl,--no-entry -Wl,--export=_start -Wl,--export=malloc -Wl,--export=memory \
            -Wl,--allow-multiple-definition -Wl,--allow-undefined \
            -o "$output" "$WASM_BASE" "$ll_path" "$runtime_ll" || {
            echo "saffron: wasm64 linking failed" >&2
            exit 1
        }
    elif [[ "$TARGET" == "wasm32" ]]; then
        local WASM_BASE="${SCRIPT_DIR}/src/runtime/wasm_base.ll"
        local WASM_CLANG="${WASM_CLANG:-/opt/homebrew/opt/llvm/bin/clang}"
        if [[ ! -x "$WASM_CLANG" ]]; then
            WASM_CLANG="clang"
        fi
        "$WASM_CLANG" --target=wasm32-unknown-unknown -O2 -w --no-standard-libraries \
            -Wl,--no-entry -Wl,--export-all -Wl,--allow-multiple-definition -Wl,--allow-undefined \
            -o "$output" "$ll_path" "$RUNTIME" "$RUNTIME_GC" "$WASM_BASE" || {
            echo "saffron: wasm linking failed" >&2
            exit 1
        }
    else
        clang "$OPT" -w -Wl,-stack_size,0x10000000 -o "$output" "$ll_path" "$RUNTIME" "$RUNTIME_GC" "$RUNTIME_BASE" || {
            echo "saffron: linking failed" >&2
            exit 1
        }
    fi
}

case "$COMMAND" in
    emit-ir)
        TMPIR="$TMPDIR/output.ll"
        compile_to_ir "$INPUT" "$TMPIR"
        cat "$TMPIR"
        exit 0
        ;;
    build)
        if [[ -z "$OUTPUT" ]]; then
            OUTPUT="a.out"
        fi
        build_project "$INPUT" "$OUTPUT"
        [[ "$VERBOSE" == true ]] && echo "  done: $OUTPUT"
        exit 0
        ;;
    run)
        TMPBIN="$TMPDIR/program"
        build_project "$INPUT" "$TMPBIN"
        chmod +x "$TMPBIN"
        "$TMPBIN" "$@"
        ;;
esac
