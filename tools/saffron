#!/usr/bin/env bash
# saffron — unified driver for the Saffron language
#
# Usage:
#   saffron run file.sf          Run a .sf file (compile + execute)
#   saffron build file.sf -o out Compile to native binary
#   saffron emit-ir file.sf      Output LLVM IR (for debugging)
#   saffron file.sf              Shorthand for: saffron run file.sf
#
# This wraps saffronc + clang into a single user-facing command.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SAFFRONC="${SAFFRONC:-$SCRIPT_DIR/build/saffronc}"
RUNTIME="${SAFFRON_RUNTIME:-$SCRIPT_DIR/build/stage3/runtime.ll}"
RUNTIME_SRC="${SAFFRON_RUNTIME_SRC:-$SCRIPT_DIR/src/runtime/runtime.sf}"
RUNTIME_BASE="${SAFFRON_RUNTIME_BASE:-$SCRIPT_DIR/src/runtime/base_nanbox.ll}"
RUNTIME_GC="${SAFFRON_RUNTIME_GC:-$SCRIPT_DIR/src/runtime/gc.ll}"

usage() {
    echo "saffron — The Saffron Programming Language"
    echo ""
    echo "Usage:"
    echo "  saffron run <file.sf>              Run a Saffron program"
    echo "  saffron build <file.sf> -o <out>   Compile to native binary"
    echo "  saffron build <file.sf>            Compile to ./a.out"
    echo "  saffron emit-ir <file.sf>          Print LLVM IR to stdout"
    echo "  saffron <file.sf>                  Shorthand for: saffron run <file.sf>"
    echo "  saffron version                    Show version"
    echo ""
    echo "Options:"
    echo "  -o <path>    Output binary path (for build)"
    echo "  --opt, -O    Optimization level (default: -O2)"
    echo "  --verbose    Show compilation steps"
    exit 0
}

error() {
    echo "saffron: $1" >&2
    exit 1
}

# --- Parse arguments ---

COMMAND=""
INPUT=""
OUTPUT=""
OPT="-O2"
TARGET=""
VERBOSE=false
LIB_PATHS=()
EXTRA_SAFFRONC_FLAGS=""

if [[ $# -eq 0 ]]; then
    usage
fi

case "$1" in
    run|build|emit-ir|version|--help|-h)
        COMMAND="$1"
        shift
        ;;
    *.sf)
        COMMAND="run"
        ;;
    *)
        error "unknown command '$1'. Run 'saffron --help' for usage."
        ;;
esac

if [[ "$COMMAND" == "--help" || "$COMMAND" == "-h" ]]; then
    usage
fi

if [[ "$COMMAND" == "version" ]]; then
    echo "saffron 0.1.0 (native)"
    exit 0
fi

# Parse remaining args
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)
            shift
            OUTPUT="$1"
            ;;
        --opt|-O)
            shift
            OPT="-O$1"
            ;;
        --verbose)
            VERBOSE=true
            ;;
        --target)
            shift
            TARGET="$1"
            ;;
        --lib-path)
            shift
            LIB_PATHS+=("$1")
            ;;
        *.sf)
            INPUT="$1"
            ;;
        *)
            # Pass through as program arguments for 'run'
            break
            ;;
    esac
    shift
done

if [[ -z "$INPUT" && "$COMMAND" != "version" ]]; then
    error "no input file specified"
fi

if [[ ! -f "$INPUT" ]]; then
    error "file not found: $INPUT"
fi

# --- Dependency discovery ---
#
# Package dependencies live in <project>/.pantry/packages. Find them without
# making the user pass --lib-path by hand: honor SAFFRON_LIB_PATH (colon-
# separated, as pantry sets it), then walk up from the input file to the nearest
# pantry.toml and add its .pantry/packages if present.

if [[ -n "${SAFFRON_LIB_PATH:-}" ]]; then
    IFS=':' read -r -a _env_libs <<< "$SAFFRON_LIB_PATH"
    for _lp in "${_env_libs[@]}"; do
        [[ -n "$_lp" && -d "$_lp" ]] && LIB_PATHS+=("$_lp")
    done
fi

find_project_root() {
    local dir
    dir="$(cd "$(dirname "$1")" && pwd)"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/pantry.toml" ]]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

if PROJECT_ROOT="$(find_project_root "$INPUT")"; then
    if [[ -d "$PROJECT_ROOT/.pantry/packages" ]]; then
        # Skip if the user already passed this path explicitly.
        _already=false
        for _lp in "${LIB_PATHS[@]:-}"; do
            [[ "$_lp" == "$PROJECT_ROOT/.pantry/packages" ]] && _already=true
        done
        [[ "$_already" == false ]] && LIB_PATHS+=("$PROJECT_ROOT/.pantry/packages")
    fi
fi

# --- Check prerequisites ---

if [[ ! -x "$SAFFRONC" ]]; then
    error "saffronc not found at $SAFFRONC. Build with: ./bootstrap.sh"
fi

if ! command -v clang &>/dev/null; then
    error "clang not found. Install LLVM/Clang to compile Saffron programs."
fi

# --- Commands ---

TMPDIR=$(mktemp -d /tmp/saffron_build_XXXXXX)
trap "rm -rf $TMPDIR" EXIT

STDLIB="${SAFFRON_STDLIB:-$SCRIPT_DIR/src/lib}"

compile_to_ir() {
    local input="$1"
    local output="$2"
    local flags=""
    [[ -n "$TARGET" ]] && flags="--target $TARGET"
    for lp in "${LIB_PATHS[@]:-}"; do
        [[ -n "$lp" ]] && flags="$flags --lib-path $lp"
    done
    [[ "$VERBOSE" == true ]] && echo "  compile: $input -> $output"
    "$SAFFRONC" --stdlib "$STDLIB" $flags "$input" "$output"
}

# Recursively discover all .sf files imported (via relative paths) from an entry file.
# Outputs one absolute path per line, in dependency order (leaves first).
discover_sources() {
    local entry="$1"
    local entry_dir
    entry_dir="$(cd "$(dirname "$entry")" && pwd)"
    local entry_abs="$entry_dir/$(basename "$entry")"

    local -a visited=()
    local -a ordered=()

    _visit() {
        local file="$1"
        local dir
        dir="$(dirname "$file")"

        # Skip if already visited
        for v in "${visited[@]:-}"; do
            [[ "$v" == "$file" ]] && return 0
        done
        visited+=("$file")

        # Find relative imports: import "./foo.sf" or import "../bar.sf"
        local imports
        imports=$(grep -oE 'import "\./[^"]+"|import "\.\./[^"]+"' "$file" 2>/dev/null | \
                  sed 's/import "//;s/"//' || true)

        for imp in $imports; do
            local resolved
            resolved="$(cd "$dir" && cd "$(dirname "$imp")" && pwd)/$(basename "$imp")"
            if [[ -f "$resolved" ]]; then
                _visit "$resolved"
            fi
        done

        ordered+=("$file")
    }

    _visit "$entry_abs"
    printf '%s\n' "${ordered[@]}"
}

# Compile all source files in a project and link into one binary.
build_project() {
    local entry="$1"
    local output="$2"

    local ll_path="$TMPDIR/output.ll"
    local saffronc_flags=""
    [[ -n "$TARGET" ]] && saffronc_flags="--target $TARGET"
    for lp in "${LIB_PATHS[@]:-}"; do
        [[ -n "$lp" ]] && saffronc_flags="$saffronc_flags --lib-path $lp"
    done

    [[ "$VERBOSE" == true ]] && echo "  compile: $entry"
    "$SAFFRONC" $saffronc_flags "$entry" "$ll_path" || {
        echo "saffron: compilation failed: $entry" >&2
        exit 1
    }

    [[ "$VERBOSE" == true ]] && echo "  link: $entry -> $output"
    if [[ "$TARGET" == "wasm" || "$TARGET" == "wasm64" ]]; then
        local WASM_BASE="${SCRIPT_DIR}/src/runtime/wasm_base.ll"
        local WASM_CLANG="${WASM_CLANG:-/opt/homebrew/opt/llvm/bin/clang}"
        local WASM_LD_PATH="${WASM_LD:-/opt/homebrew/bin/wasm-ld}"
        if [[ ! -x "$WASM_CLANG" ]]; then
            WASM_CLANG="clang"
        fi
        # Compile runtime for wasm64
        local runtime_ll="$TMPDIR/runtime.ll"
        "$SAFFRONC" --target wasm "$RUNTIME_SRC" "$runtime_ll" 2>/dev/null || true
        # Link order: wasm_base first (GC stubs + __int_to_string), user code, runtime last
        "$WASM_CLANG" --target=wasm64-unknown-unknown -O2 -w --no-standard-libraries \
            -fuse-ld="$WASM_LD_PATH" \
            -Wl,--no-entry -Wl,--export=_start -Wl,--export=malloc -Wl,--export=memory -Wl,--export=__dispatch_event \
            -Wl,--allow-multiple-definition -Wl,--allow-undefined \
            -o "$output" "$WASM_BASE" "$runtime_ll" "$ll_path" || {
            echo "saffron: wasm64 linking failed" >&2
            exit 1
        }
    elif [[ "$TARGET" == "wasm32" ]]; then
        local WASM_BASE="${SCRIPT_DIR}/src/runtime/wasm_base_32.ll"
        local WASM_CLANG="${WASM_CLANG:-/opt/homebrew/opt/llvm/bin/clang}"
        local WASM_LD_PATH="${WASM_LD:-/opt/homebrew/bin/wasm-ld}"
        if [[ ! -x "$WASM_CLANG" ]]; then
            WASM_CLANG="clang"
        fi
        # Compile runtime for wasm32.
        #
        # --identity-mode is REQUIRED and was missing. runtime.sf is the layer
        # that implements NaN-boxing, so it must be compiled with values treated
        # as raw i64 bits; without the flag the compiler re-boxes them and every
        # tag inspection in the runtime operates on doubly-tagged values.
        # bootstrap.sh has always passed it for the native runtime (see the
        # `--identity-mode` calls there); only this wasm32 path did not.
        #
        # The visible symptom was `[3.0, 6.0].join(", ")` yielding ", " on
        # wasm32: `elem >> 48` in __list_join went through __val_untag_int,
        # which on wasm32 converts a float to its integer VALUE (fptosi), so
        # 3.0 became 3, `3 >> 48` became 0, and 0 is exactly the "plausible
        # bare heap pointer" case — the float was then dereferenced as a string.
        local runtime_ll="$TMPDIR/runtime.ll"
        "$SAFFRONC" --target wasm32 --identity-mode --stdlib "$SCRIPT_DIR/src/lib" \
            "$RUNTIME_SRC" "$runtime_ll" 2>/dev/null || true
        # Discover dispatch/callback symbols to export (module-prefixed names)
        # No --export=memory: memory is not a linker symbol, so wasm-ld errors on it
        # ("symbol exported via --export not found: memory"). It exports the memory
        # automatically anyway unless --import-memory is passed. This error was
        # present before and masked by --allow-undefined.
        local EXPORT_FLAGS="-Wl,--no-entry -Wl,--export=_start -Wl,--export=malloc"
        # __sched_pump drives the cooperative scheduler from the host event loop.
        # Exported if-defined so non-async programs, which never pull in the
        # scheduler, still link.
        EXPORT_FLAGS="$EXPORT_FLAGS -Wl,--export-if-defined=__sched_pump"
        # Scan the compiled IR for functions that need JS-side dispatch
        for sym in $(grep -oE 'define i64 @[a-zA-Z0-9_]*__dispatch_[a-zA-Z0-9_]+' "$ll_path" | sed 's/define i64 @//'); do
            EXPORT_FLAGS="$EXPORT_FLAGS -Wl,--export-if-defined=$sym"
        done
        for sym in $(grep -oE 'define i64 @[a-zA-Z0-9_]*__on_[a-zA-Z0-9_]+' "$ll_path" | sed 's/define i64 @//'); do
            EXPORT_FLAGS="$EXPORT_FLAGS -Wl,--export-if-defined=$sym"
        done
        # --import-undefined, not --allow-undefined. Both let the js_* imports
        # through, but --allow-undefined silently accepts EVERY missing symbol: it
        # was hiding the fact that nothing scheduler-related was linked, producing a
        # 441-byte module that looked like a successful build. --import-undefined
        # turns genuinely-missing internals back into link errors while still
        # importing the js_* functions the glue supplies.
        "$WASM_CLANG" --target=wasm32-unknown-unknown -O2 -w --no-standard-libraries \
            -fuse-ld="$WASM_LD_PATH" \
            $EXPORT_FLAGS \
            -Wl,--allow-multiple-definition -Wl,--import-undefined \
            -Wl,--initial-memory=4194304 -Wl,--max-memory=16777216 \
            -o "$output" "$WASM_BASE" "$runtime_ll" "$ll_path" || {
            echo "saffron: wasm32 linking failed" >&2
            exit 1
        }
    else
        local ASYNC_NATIVE="$SCRIPT_DIR/src/runtime/async_native.c"
        local SOCKET_NATIVE="$SCRIPT_DIR/src/runtime/socket_native.c"
        local WATCH_NATIVE="$SCRIPT_DIR/src/runtime/watch_native.c"
        local PROCESS_NATIVE="$SCRIPT_DIR/src/runtime/process_native.c"
        # Find OpenSSL (Homebrew on macOS, system elsewhere)
        local SSL_FLAGS=""
        if command -v brew &>/dev/null; then
            local SSL_PREFIX
            SSL_PREFIX="$(brew --prefix openssl 2>/dev/null || true)"
            if [[ -n "$SSL_PREFIX" && -d "$SSL_PREFIX" ]]; then
                SSL_FLAGS="-I${SSL_PREFIX}/include -L${SSL_PREFIX}/lib"
            fi
        fi
        clang "$OPT" -w -Wl,-stack_size,0x10000000 $SSL_FLAGS -o "$output" "$ll_path" "$RUNTIME" "$RUNTIME_GC" "$RUNTIME_BASE" "$ASYNC_NATIVE" "$SOCKET_NATIVE" "$WATCH_NATIVE" "$PROCESS_NATIVE" -lssl -lcrypto || {
            echo "saffron: linking failed" >&2
            exit 1
        }
    fi
}

case "$COMMAND" in
    emit-ir)
        TMPIR="$TMPDIR/output.ll"
        compile_to_ir "$INPUT" "$TMPIR"
        cat "$TMPIR"
        exit 0
        ;;
    build)
        if [[ -z "$OUTPUT" ]]; then
            OUTPUT="a.out"
        fi
        build_project "$INPUT" "$OUTPUT"
        [[ "$VERBOSE" == true ]] && echo "  done: $OUTPUT"
        exit 0
        ;;
    run)
        TMPBIN="$TMPDIR/program"
        build_project "$INPUT" "$TMPBIN"
        chmod +x "$TMPBIN"
        "$TMPBIN" "$@"
        ;;
esac
