//! claude_tui — entry point.
//!
//! Wires the shared app module (state + view + logic) to the Sumac reactive
//! runtime: sizes the terminal, focuses the prompt, registers key handlers, and
//! enters the render loop with `Rt.run(App.view)`. All UI state and the view
//! builder live in `app.sf` so the render test can exercise the exact same tree.
//!
//! The `claude` subprocess is driven NON-BLOCKING: `submit()` spawns it and
//! returns immediately, and an `Rt.on_tick` handler pumps its streaming stdout a
//! little per loop iteration. Enter therefore never blocks — while a response is
//! in flight it enqueues the next prompt. No `GC.disable()` — BUGS #192 is fixed.

import "../../../src/runtime.sf" as Rt
import "../../../src/tty.sf" as Tty
import "../../../src/input.sf" as Ev
import "../../../src/widgets/textarea.sf" as TA
import "@args" as Args
import "./app.sf" as App

fun main() {
    // --- Launch flags --------------------------------------------------------
    //
    // Parse sclaude's OWN argv for the session-launch flags:
    //   --continue / -c        resume the most recent conversation (first turn)
    //   --resume               show the interactive picker before the chat
    //   --resume=<id>          resume that session directly (skip the picker)
    // Args.parse() splits short flags char-by-char, so `-c` lands as flag "c".
    var pa: Args.ParsedArgs = Args.parse()
    if (pa.has("continue") or pa.has("c")) {
        App.set_continue_mode()
    }
    // `--resume` bare is a flag; `--resume=<id>` is an option carrying the id.
    if (pa.options.has("resume")) {
        App.set_session_id(pa.get("resume"))
    } else if (pa.flags.has("resume")) {
        App.enter_picker()
    }

    // Size the app to the real terminal before the first frame.
    var sz: Tty.TermSize = Tty.size()
    App.set_size(sz.cols, sz.rows)

    // Focus the prompt editor so typing goes straight into it.
    var t: TA.TextArea = App.prompt
    t.focus()

    // --- Idle/tick pump ------------------------------------------------------
    //
    // Fires ~every 50ms after input dispatch, whether or not input arrived. This
    // is what makes streaming non-blocking: it reads whatever the claude child
    // has produced, folds it into the transcript, advances the spinner, and
    // requests a repaint only when something changed. Bind the module function to
    // a typed local (an untyped module-global call can be silently dropped).
    Rt.on_tick(fun () {
        var changed: Bool = App.pump()
        if (changed) { Rt.request_render() }
    })

    // --- Global key handlers -------------------------------------------------

    // Enter: in picker mode it resumes the highlighted conversation; otherwise
    // it submits the prompt (start immediately when idle, enqueue while busy).
    Rt.on_key("enter", fun () {
        if (App.in_picker()) { App.picker_choose() }
        else { App.submit() }
        Rt.request_render()
    })

    // Esc: in picker mode it cancels to a fresh session; otherwise it interrupts
    // a running generation (no-op when idle).
    Rt.on_key("esc", fun () {
        if (App.in_picker()) { App.picker_cancel() }
        else { App.interrupt() }
        Rt.request_render()
    })

    // Quit on ctrl+c / ctrl+d.
    Rt.on_key("ctrl+c", fun () => Rt.quit())
    Rt.on_key("ctrl+d", fun () => Rt.quit())

    // Clear the transcript (^L).
    Rt.on_key("ctrl+l", fun () { App.clear_transcript(); Rt.request_render() })

    // Shift+Tab cycles the permission-mode indicator (normal → accept edits →
    // bypass). Visual parity only — the wrapper can't change claude's real mode
    // over -p. `backtab` is the alternate name some terminals send for shift+tab.
    Rt.on_key("shift+tab", fun () { App.cycle_perm_mode(); Rt.request_render() })
    Rt.on_key("backtab", fun () { App.cycle_perm_mode(); Rt.request_render() })

    // Up-arrow precedence: when the input is EMPTY and a queue exists, up pops
    // the last queued message back into the input for editing; otherwise up
    // scrolls the transcript. This keeps the common "scroll" flow intact while
    // adding Claude-Code's "edit queued messages" affordance.
    Rt.on_key("up", fun () {
        if (App.in_picker()) {
            App.picker_key("up")
        } else if (!App.edit_last_queued()) { App.scroll_up() }
        Rt.request_render()
    })
    Rt.on_key("down", fun () {
        if (App.in_picker()) { App.picker_key("down") }
        else { App.scroll_down() }
        Rt.request_render()
    })
    Rt.on_key("pgup", fun () {
        if (App.in_picker()) { App.picker_key("pgup") }
        else { App.page_up() }
        Rt.request_render()
    })
    Rt.on_key("pgdown", fun () {
        if (App.in_picker()) { App.picker_key("pgdown") }
        else { App.page_down() }
        Rt.request_render()
    })

    // Everything else (printable keys, backspace, arrows/word-edits in text) goes
    // to the focused prompt editor via the catch-all handler. Typing is always
    // allowed — even while streaming — so the user can compose the next prompt.
    Rt.on_event(fun (e: Ev.Event) {
        if (e.key != nil) {
            var k: Ev.KeyEvent = e.key
            var name: String = k.name()
            // Keys already claimed by a global handler must not double-fire into
            // the editor.
            if (name == "enter" or name == "esc" or name == "up" or name == "down" or
                name == "pgup" or name == "pgdown" or
                name == "shift+tab" or name == "backtab" or
                name == "ctrl+c" or name == "ctrl+d" or name == "ctrl+l") {
                return
            }
            // In picker mode, printable keys + backspace narrow the filter
            // rather than typing into the (hidden) prompt editor.
            if (App.in_picker()) {
                App.picker_filter_key(name)
                Rt.request_render()
                return
            }
        }
        var ed: TA.TextArea = App.prompt
        ed.handle(e)
        Rt.request_render()
    })

    Rt.run(App.view)
}

main()
