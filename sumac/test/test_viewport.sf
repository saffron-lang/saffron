// Verify the Viewport widget: scrolling ops with clamping, at_bottom/to_top/
// to_bottom/scroll_to_bottom, key handling, and the visible-window render.
// Renders view() into a Buffer via L._collect + L.render_node and asserts on
// the row contents.
import "../src/buffer.sf" as Buf
import "../src/style.sf" as St
import "../src/signal.sf" as Sig
import "../src/layout.sf" as L
import "../src/input.sf" as Ev
import "../src/widgets/viewport.sf" as V
import "@test" as T
import "io" as IO

// another cross-module class instance (Buffer's List<Cell>) corrupts the heap
// after ~45 allocations. Disabling GC sidesteps it for this logic test.

// Read one cell's rune at (x,y); blank -> ".".
fun rune_at(buf: Buf.Buffer, x: Int, y: Int): String {
    var c: Buf.Cell = buf.get(x, y)
    if (c.rune == " " or c.rune == "") { return "." }
    return c.rune
}

// Dump one row of the buffer as a display string (blanks as ".").
fun row(buf: Buf.Buffer, y: Int): String {
    var out: String = ""
    var x: Int = 0
    while (x < buf.w) {
        out = out + rune_at(buf, x, y)
        x = x + 1
    }
    return out
}

// Render a Viewport widget's view() into a fresh Buffer of the given size.
fun render_widget(vp: V.Viewport, w: Int, h: Int): Buf.Buffer {
    var tree: List<L.LNode> = L._collect(fun () {
        vp.view()
    })
    var buf: Buf.Buffer = Buf.Buffer(w, h)
    L.render_node(tree[0], buf, 0, 0, w, h)
    return buf
}

fun main() {

    // 10 lines "L0".."L9", height 4.
    var content: List<String> = []
    var i: Int = 0
    while (i < 10) {
        content.push("L" + i.to_string())
        i = i + 1
    }
    var lines: Sig.Signal<List<String>> = Sig.signal(content)
    var offset: Sig.Signal<Int> = Sig.signal(0)
    var vp: V.Viewport = V.Viewport(lines, offset, 8, 4, St.style(), true)

    // -----------------------------------------------------------------
    // Scrolling ops + clamping.
    // -----------------------------------------------------------------
    T.assert_eq(vp.total(), 10, "total is 10")
    T.assert_eq(vp.get_offset(), 0, "offset starts at 0")
    T.assert_eq(vp.max_offset(), 6, "max_offset is total-height = 6")

    vp.scroll_down(2)
    T.assert_eq(vp.get_offset(), 2, "scroll_down(2) -> offset 2")

    vp.scroll_down(100)
    T.assert_eq(vp.get_offset(), 6, "scroll_down(100) clamps to 6")
    T.assert(vp.at_bottom(), "at_bottom() true at offset 6")

    vp.scroll_up(3)
    T.assert_eq(vp.get_offset(), 3, "scroll_up(3) -> offset 3")
    T.assert(!vp.at_bottom(), "at_bottom() false at offset 3")

    vp.to_top()
    T.assert_eq(vp.get_offset(), 0, "to_top() -> 0")

    vp.to_bottom()
    T.assert_eq(vp.get_offset(), 6, "to_bottom() -> 6")

    vp.to_top()
    vp.scroll_to_bottom()
    T.assert_eq(vp.get_offset(), 6, "scroll_to_bottom() -> 6")

    // scroll_up below 0 clamps to 0.
    vp.to_top()
    vp.scroll_up(5)
    T.assert_eq(vp.get_offset(), 0, "scroll_up past top clamps to 0")

    // page_down / page_up move by height (4).
    vp.to_top()
    vp.page_down()
    T.assert_eq(vp.get_offset(), 4, "page_down() -> offset 4 (by height)")
    vp.page_up()
    T.assert_eq(vp.get_offset(), 0, "page_up() -> offset 0")

    // -----------------------------------------------------------------
    // handle(): a synthetic "down" key event scrolls and is consumed.
    // -----------------------------------------------------------------
    vp.to_top()
    var down_ev: Ev.Event = Ev.key_event(Ev.KEY_DOWN, "", Ev.MOD_NONE)
    var consumed: Bool = vp.handle(down_ev)
    T.assert(consumed, "handle('down') consumed")
    T.assert_eq(vp.get_offset(), 1, "handle('down') scrolled to offset 1")

    // "j" also scrolls down.
    var j_ev: Ev.Event = Ev.key_event(Ev.KEY_RUNE, "j", Ev.MOD_NONE)
    T.assert(vp.handle(j_ev), "handle('j') consumed")
    T.assert_eq(vp.get_offset(), 2, "handle('j') -> offset 2")

    // "space" pages down by height.
    var space_ev: Ev.Event = Ev.key_event(Ev.KEY_SPACE, " ", Ev.MOD_NONE)
    T.assert(vp.handle(space_ev), "handle('space') consumed")
    T.assert_eq(vp.get_offset(), 6, "handle('space') pages down, clamps to 6")

    // A wheel-up mouse event scrolls up by 3.
    var wheel_up: Ev.Event = Ev.mouse_event(Ev.MOUSE_WHEEL_UP, 0, 0, 0, Ev.MOD_NONE)
    T.assert(vp.handle(wheel_up), "handle(wheel up) consumed")
    T.assert_eq(vp.get_offset(), 3, "wheel up -> offset 3")

    // An unhandled key ("enter") is not consumed.
    var enter_ev: Ev.Event = Ev.key_event(Ev.KEY_ENTER, "", Ev.MOD_NONE)
    T.assert(!vp.handle(enter_ev), "handle('enter') not consumed")

    // -----------------------------------------------------------------
    // Render: the visible window shows lines [offset .. offset+height).
    // At offset 0, rows should be L0..L3.
    // -----------------------------------------------------------------
    vp.to_top()
    var b0: Buf.Buffer = render_widget(vp, 12, 4)
    IO.println("offset 0:")
    var r: Int = 0
    while (r < 4) {
        IO.println("[" + row(b0, r) + "]")
        r = r + 1
    }
    T.assert(row(b0, 0).contains("L0"), "row 0 shows L0")
    T.assert(row(b0, 1).contains("L1"), "row 1 shows L1")
    T.assert(row(b0, 2).contains("L2"), "row 2 shows L2")
    T.assert(row(b0, 3).contains("L3"), "row 3 shows L3")

    // At offset 6 (bottom), rows should be L6..L9.
    vp.to_bottom()
    var b6: Buf.Buffer = render_widget(vp, 12, 4)
    IO.println("offset 6:")
    var r2: Int = 0
    while (r2 < 4) {
        IO.println("[" + row(b6, r2) + "]")
        r2 = r2 + 1
    }
    T.assert(row(b6, 0).contains("L6"), "row 0 shows L6")
    T.assert(row(b6, 3).contains("L9"), "row 3 shows L9")

    // The scrollbar column is drawn just after the fixed-width (8) content
    // column, i.e. at x == width == 8: some cell there is a thumb "█".
    var any_thumb: Bool = false
    var ry: Int = 0
    while (ry < 4) {
        if (rune_at(b6, 8, ry) == "█") { any_thumb = true }
        ry = ry + 1
    }
    T.assert(any_thumb, "scrollbar thumb rendered in scrollbar column (x=8)")

    // -----------------------------------------------------------------
    // Clipping: a line longer than width is hard-clipped.
    // -----------------------------------------------------------------
    var wide: List<String> = ["0123456789ABCDEF"]
    var wlines: Sig.Signal<List<String>> = Sig.signal(wide)
    var woff: Sig.Signal<Int> = Sig.signal(0)
    var wvp: V.Viewport = V.Viewport(wlines, woff, 5, 2, St.style(), false)
    var bw: Buf.Buffer = render_widget(wvp, 10, 2)
    IO.println("clip:")
    IO.println("[" + row(bw, 0) + "]")
    // width 5 -> "01234"; cell 5 should be blank.
    T.assert_eq(rune_at(bw, 0, 0), "0", "clip: cell 0 is '0'")
    T.assert_eq(rune_at(bw, 4, 0), "4", "clip: cell 4 is '4'")
    T.assert_eq(rune_at(bw, 5, 0), ".", "clip: cell 5 blank (clipped at width 5)")

    // Constructor defaults: empty content, offset 0, scrollbar on.
    var dvp: V.Viewport = V.viewport(20, 5)
    T.assert_eq(dvp.total(), 0, "viewport(): empty content")
    T.assert_eq(dvp.get_offset(), 0, "viewport(): offset 0")
    T.assert(dvp.focusable(), "viewport is focusable")

    T.summary()
}

main()
