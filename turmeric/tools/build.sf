// turmeric-build — Build a Turmeric app to WASM
// Usage: saffron run tools/build.sf [--dev]
//
// Reads pantry.toml for entry, compiles to WASM, bundles public/ → build/

import "@process" as Process
import "@args" as Args

var parsed = Args.parse()
var is_dev: Bool = parsed.flags.has("dev")

// --- Config ---
var entry: String = "src/main.sf"
var public_dir: String = "public"
var build_dir: String = "build"
var port: String = "8080"

// Read entry from pantry.toml
if (IO.file_exists("pantry.toml")) {
    var toml: String = IO.read_file("pantry.toml")
    var lines: List<String> = toml.split("\n")
    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i].trim()
        if (line.starts_with("entry")) {
            var eq: Float = line.index_of("=")
            if (eq > 0) {
                var val: String = line.slice(eq + 1, line.length()).trim()
                if (val.starts_with("\"") and val.ends_with("\"")) {
                    entry = val.slice(1, val.length() - 1)
                }
            }
        }
        i = i + 1
    }
}

// --- Step 1: Compile ---
IO.println("[1/3] Compiling " + entry + " → WASM...")
// The lib path must be ABSOLUTE. With the relative ".pantry/packages" the
// compiler's module-dedup map — which is keyed on the path *string*
// (src/compiler/main.sf:547) — records the auto-imported package prelude under
// the relative spelling, while the explicit `import ... from "turmeric/prelude"`
// resolves to the symlink's absolute realpath. Two keys, one file, so the prelude
// is emitted twice and the build dies in `opt`:
//
//   error: redefinition of global '@__g_turmeric_prelude__tc_event'
//
// This is a workaround, not the fix: the compiler should canonicalise paths before
// using them as identities. See BUGS.md #57.
var pkg_dir: String = Process.run("pwd").stdout.trim() + "/.pantry/packages"
var compile_cmd: String = "saffron build --target wasm32 --lib-path " + pkg_dir + " " + entry + " -o " + build_dir + "/app.wasm"
var compile_result = Process.run(compile_cmd)
if (!compile_result.success) {
    IO.println("Error: Compilation failed")
    IO.println(compile_result.stderr)
    IO.println(compile_result.stdout)
    return
}

// --- Step 2: Bundle ---
IO.println("[2/3] Bundling " + public_dir + "/ → " + build_dir + "/...")

// Copy public files
if (IO.file_exists(public_dir)) {
    Process.run("cp -r " + public_dir + "/* " + build_dir + "/")
}

// Transform index.html: rewrite .sf script src to ./app.js
var html_path: String = build_dir + "/index.html"
if (IO.file_exists(html_path)) {
    var html: String = IO.read_file(html_path)
    // Replace src="...*.sf" with src="./app.js"
    var lines: List<String> = html.split("\n")
    var out: StringBuilder = StringBuilder()
    // `li` MUST be Int, not Float. Indexing a list with a Float-typed variable
    // silently reads element 0 every time (BUGS.md #72), so with `var li: Float`
    // this loop rewrote every app's index.html into N copies of its first line —
    // i.e. a bare `<!DOCTYPE html>` repeated, and a blank page.
    var li: Int = 0
    while (li < lines.length()) {
        var line: String = lines[li]
        if (line.contains(".sf\"")) {
            // Rewrite script src
            var start: Int = line.index_of("src=\"")
            if (start >= 0) {
                var before: String = line.slice(0, start)
                var after_src: String = line.slice(start + 5, line.length())
                var end_quote: Int = after_src.index_of("\"")
                var after: String = after_src.slice(end_quote, after_src.length())
                line = before + "src=\"./app.js" + after
            }
        }
        out.append(line)
        if (li < lines.length() - 1) { out.append("\n") }
        li = li + 1
    }
    IO.write_file(html_path, out.to_string())
}

// Emit the runtime. turmeric.js is the single source of truth (DOM glue, event
// dispatch, NaN-box marshalling); it is always copied so that both the generated
// app.js shim and any app-provided app.js can `import { mount } from './turmeric.js'`.
IO.println("[3/3] Emitting runtime (turmeric.js)...")
var runtime_js: String = IO.read_file(pkg_dir + "/turmeric/runtime/turmeric.js")
IO.write_file(build_dir + "/turmeric.js", runtime_js)

// Generate app.js — but never clobber an app's own loader.
//
// Step 2 copies public/ into build/, so an app that ships its own public/app.js
// has already put it in place. Unconditionally writing the generic shim over it
// would discard that file: the playground's loader passes mount() extra imports
// (js_run_wasm and a custom loader) so it can instantiate the user's compiled
// module in a second isolated wasm instance. It imports the same turmeric.js, so
// it shares the runtime rather than forking it.
//
// An app opting out of the generated loader is the normal case once it needs any
// host FFI of its own, so the app's file wins.
if (IO.file_exists(public_dir + "/app.js")) {
    IO.println("      Keeping app-provided app.js (public/app.js)")
} else {
    IO.println("      Generating app.js shim...")
    var app_js: String = IO.read_file(pkg_dir + "/turmeric/runtime/app_template.js")
    IO.write_file(build_dir + "/app.js", app_js)
}

// --- Done ---
IO.println("")
IO.println("✓ Build complete: " + build_dir + "/")
if (IO.file_exists(build_dir + "/app.wasm")) {
    IO.println("  app.wasm  — WASM binary")
}
IO.println("  index.html — entry page")
if (IO.file_exists(public_dir + "/app.js")) {
    IO.println("  app.js     — loader (from public/, app-provided)")
} else {
    IO.println("  app.js     — loader (auto-generated)")
}

// --- Dev server ---
if (is_dev) {
    IO.println("")
    IO.println("  Serving at http://localhost:" + port)
    Process.run("cd " + build_dir + " && python3 -m http.server " + port)
}
