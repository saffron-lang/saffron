// generate_types.sf — Generate Saffron UI element types from dom.generated.d.ts
// Usage: saffron run tools/generate_types.sf

var INPUT: String = "tools/dom.generated.d.ts"
var OUTPUT: String = "src/generated_types.sf"
var OUTPUT_PRELUDE: String = "src/generated_prelude.sf"

// --- Helpers ---

// Known acronyms to keep as single units
fun replace_acronyms(name: String): String {
    var result: String = name
    result = result.replace("URI", "Uri")
    result = result.replace("URL", "Url")
    result = result.replace("HTML", "Html")
    result = result.replace("CSS", "Css")
    result = result.replace("DOM", "Dom")
    result = result.replace("API", "Api")
    result = result.replace("HTTP", "Http")
    result = result.replace("XML", "Xml")
    result = result.replace("JSON", "Json")
    result = result.replace("SVG", "Svg")
    return result
}

fun to_snake_case(name: String): String {
    var upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var fixed: String = replace_acronyms(name)
    var result: String = ""
    var i: Float = 0
    while (i < fixed.length()) {
        var ch: String = fixed.char_at(i)
        if (upper.contains(ch)) {
            if (i > 0) {
                result = result + "_"
            }
            result = result + ch.to_lower()
        } else {
            result = result + ch
        }
        i = i + 1
    }
    return result
}

fun is_all_upper(s: String): Bool {
    var lower: String = "abcdefghijklmnopqrstuvwxyz"
    var i: Float = 0
    while (i < s.length()) {
        if (lower.contains(s.char_at(i))) return false
        i = i + 1
    }
    return true
}

fun map_ts_type(ts_type: String): String {
    var t: String = ts_type.trim()
    if (t == "string") return "String"
    if (t == "number") return "Float"
    if (t == "boolean") return "Bool"
    if (t == "null" or t == "undefined" or t == "void") return "Nil"
    if (t == "any") return "Any"
    if (t.starts_with("\"")) return "String"
    return "String"
}

fun is_saffron_keyword(name: String): Bool {
    if (name == "var") return true
    if (name == "class") return true
    if (name == "import") return true
    if (name == "return") return true
    if (name == "if") return true
    if (name == "else") return true
    if (name == "while") return true
    if (name == "for") return true
    if (name == "in") return true
    if (name == "fun") return true
    if (name == "try") return true
    if (name == "catch") return true
    if (name == "throw") return true
    if (name == "match") return true
    if (name == "is") return true
    if (name == "true") return true
    if (name == "false") return true
    if (name == "nil") return true
    if (name == "this") return true
    if (name == "enum") return true
    if (name == "let") return true
    if (name == "type") return true
    return false
}

// Void elements that are self-closing
fun is_void_element(tag: String): Bool {
    if (tag == "area") return true
    if (tag == "base") return true
    if (tag == "br") return true
    if (tag == "col") return true
    if (tag == "embed") return true
    if (tag == "hr") return true
    if (tag == "img") return true
    if (tag == "input") return true
    if (tag == "link") return true
    if (tag == "meta") return true
    if (tag == "source") return true
    if (tag == "track") return true
    if (tag == "wbr") return true
    return false
}

// --- Parsing ---

fun extract_tag_map(lines: List<String>): Map<String, String> {
    var tag_map: Map<String, String> = {}
    var in_map: Bool = false

    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i].trim()
        if (line.contains("interface HTMLElementTagNameMap")) {
            in_map = true
            i = i + 1
            continue
        }
        if (in_map) {
            if (line == "}") {
                break
            }
            // Parse: "tag": InterfaceName;
            if (line.contains("\":")) {
                var quote1: Float = line.index_of("\"")
                var rest: String = line.slice(quote1 + 1, line.length())
                var quote2: Float = rest.index_of("\"")
                var tag: String = rest.slice(0, quote2)
                var colon: Float = line.index_of(": ")
                var semi: Float = line.index_of(";")
                if (colon >= 0 and semi > colon) {
                    var elem_type: String = line.slice(colon + 2, semi).trim()
                    tag_map.set(tag, elem_type)
                }
            }
        }
        i = i + 1
    }
    return tag_map
}

fun extract_event_map(lines: List<String>): Map<String, String> {
    var event_map: Map<String, String> = {}
    var in_map: Bool = false

    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i].trim()
        if (line.contains("interface GlobalEventHandlersEventMap")) {
            in_map = true
            i = i + 1
            continue
        }
        if (in_map) {
            if (line == "}") break
            if (line.contains("\":")) {
                var quote1: Float = line.index_of("\"")
                var rest: String = line.slice(quote1 + 1, line.length())
                var quote2: Float = rest.index_of("\"")
                var event_name: String = rest.slice(0, quote2)
                var colon: Float = line.index_of(": ")
                var semi: Float = line.index_of(";")
                if (colon >= 0 and semi > colon) {
                    var event_type: String = line.slice(colon + 2, semi).trim()
                    event_map.set(event_name, event_type)
                }
            }
        }
        i = i + 1
    }
    return event_map
}

fun extract_interface_props(lines: List<String>, interface_name: String): List<List<String>> {
    var props: List<List<String>> = []
    var in_iface_name: Bool = false
    var depth: Float = 0
    var deprecated: Bool = false

    var target: String = "interface " + interface_name

    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i]
        var trimmed: String = line.trim()

        if (!in_iface_name) {
            if (trimmed.starts_with(target)) {
                in_iface_name = true
                depth = 1
                i = i + 1
                continue
            }
        } else {
            // Track brace depth
            var j: Float = 0
            while (j < trimmed.length()) {
                if (trimmed.char_at(j) == "{") { depth = depth + 1 }
                if (trimmed.char_at(j) == "}") { depth = depth - 1 }
                j = j + 1
            }
            if (depth <= 0) break

            if (trimmed.contains("@deprecated")) {
                deprecated = true
                i = i + 1
                continue
            }

            // Skip readonly, methods, complex types
            if (!trimmed.starts_with("readonly") and !deprecated and trimmed.contains(": ") and trimmed.ends_with(";")) {
                if (!trimmed.contains("(") and !trimmed.contains("=>") and !trimmed.contains("{")) {
                    // Extract property name and type
                    var colon: Float = trimmed.index_of(": ")
                    if (colon > 0) {
                        var prop_name: String = trimmed.slice(0, colon).trim()
                        // Remove optional marker
                        if (prop_name.ends_with("?")) {
                            prop_name = prop_name.slice(0, prop_name.length() - 1)
                        }
                        var semi: Float = trimmed.index_of(";")
                        var prop_type: String = trimmed.slice(colon + 2, semi).trim()

                        // Skip ALL_CAPS constants and complex union types
                        if (!is_all_upper(prop_name) and !prop_type.contains("|") and !prop_type.contains("<")) {
                            var sf_type: String = map_ts_type(prop_type)
                            if (sf_type == "String" or sf_type == "Float" or sf_type == "Bool") {
                                props.push([prop_name, sf_type])
                            }
                        }
                    }
                }
            }

            if (!trimmed.starts_with("*") and !trimmed.starts_with("/*") and !trimmed.starts_with("//")) {
                deprecated = false
            }
        }
        i = i + 1
    }
    return props
}

// --- Code generation ---

fun generate(tag_map: Map<String, String>, event_map: Map<String, String>, lines: List<String>): String {
    var sb = StringBuilder()

    sb.append("// AUTO-GENERATED from dom.generated.d.ts\n")
    sb.append("// Run: saffron run tools/generate_types.sf\n\n")

    // --- Event types ---
    sb.append("// =============================================================================\n")
    sb.append("// Event Types\n")
    sb.append("// =============================================================================\n\n")

    var event_types: List<String> = []
    var event_keys: List<String> = event_map.keys()
    var ei: Float = 0
    while (ei < event_keys.length()) {
        var etype: String = event_map.get(event_keys[ei])
        if (!event_types.contains(etype)) {
            event_types.push(etype)
        }
        ei = ei + 1
    }

    // Generate event classes
    var eti: Float = 0
    while (eti < event_types.length()) {
        var etype: String = event_types[eti]
        var props: List<List<String>> = extract_interface_props(lines, etype)

        sb.append("class " + etype + " {\n")
        var pi: Float = 0
        while (pi < props.length() and pi < 15) {
            var prop: List<String> = props[pi]
            var sf_name: String = to_snake_case(prop[0])
            sb.append("    var " + sf_name + ": " + prop[1] + "\n")
            pi = pi + 1
        }
        sb.append("    fun init() {}\n")
        sb.append("    fun prevent_default() {}\n")
        sb.append("    fun stop_propagation() {}\n")
        sb.append("}\n\n")
        eti = eti + 1
    }

    // --- Element builders ---
    sb.append("// =============================================================================\n")
    sb.append("// Element Builder Functions\n")
    sb.append("// =============================================================================\n\n")

    var tags: List<String> = tag_map.keys()
    tags.sort()
    var ti: Float = 0
    while (ti < tags.length()) {
        var tag: String = tags[ti]
        var fn_name: String = tag
        if (is_saffron_keyword(tag)) {
            fn_name = tag + "_"
        }

        if (is_void_element(tag)) {
            sb.append("fun " + fn_name + "(attrs: List<Attr> = []): Node {\n")
            sb.append("    return Node.Element(\"" + tag + "\", attrs, [])\n")
            sb.append("}\n\n")
        } else {
            sb.append("fun " + fn_name + "(attrs: List<Attr> = [], block: () => Nil = fun () {}): Node {\n")
            sb.append("    return _el(\"" + tag + "\", attrs, block)\n")
            sb.append("}\n\n")
        }
        ti = ti + 1
    }

    // --- Event handler helpers ---
    sb.append("// =============================================================================\n")
    sb.append("// Event Handler Helpers\n")
    sb.append("// =============================================================================\n\n")

    var common_events: List<String> = [
        "click", "dblclick", "mousedown", "mouseup", "mousemove",
        "mouseenter", "mouseleave", "mouseover", "mouseout",
        "keydown", "keyup",
        "input", "change", "submit", "reset",
        "focus", "blur", "focusin", "focusout",
        "scroll", "resize",
        "dragstart", "drag", "dragend", "dragenter", "dragleave", "dragover", "drop",
        "touchstart", "touchmove", "touchend",
        "pointerdown", "pointerup", "pointermove", "pointerenter", "pointerleave",
        "animationstart", "animationend",
        "transitionend",
        "contextmenu", "wheel",
        "copy", "cut", "paste",
        "load", "error"
    ]

    var ci: Float = 0
    while (ci < common_events.length()) {
        var ev: String = common_events[ci]
        if (event_map.has(ev)) {
            var ev_type: String = event_map.get(ev)
            sb.append("fun on_" + ev + "(handler: (" + ev_type + ") => Nil): Attr {\n")
            sb.append("    return Attr.Event(\"" + ev + "\", handler)\n")
            sb.append("}\n\n")
        }
        ci = ci + 1
    }

    // --- Attribute helpers ---
    sb.append("// =============================================================================\n")
    sb.append("// Attribute Helpers\n")
    sb.append("// =============================================================================\n\n")

    var attr_defs: List<List<String>> = [
        ["class_", "class"], ["id", "id"], ["style", "style"],
        ["title", "title"], ["tabindex", "tabindex"], ["role", "role"],
        ["hidden", "hidden"], ["draggable", "draggable"],
        ["contenteditable", "contenteditable"], ["dir", "dir"],
        ["lang", "lang"], ["spellcheck", "spellcheck"],
        ["href", "href"], ["src", "src"], ["alt", "alt"],
        ["type_", "type"], ["name", "name"], ["value", "value"],
        ["placeholder", "placeholder"], ["disabled", "disabled"],
        ["checked", "checked"], ["readonly_", "readonly"],
        ["required", "required"], ["multiple", "multiple"],
        ["selected", "selected"], ["action", "action"],
        ["method", "method"], ["target", "target"], ["rel", "rel"],
        ["width", "width"], ["height", "height"],
        ["min", "min"], ["max", "max"], ["step", "step"],
        ["pattern", "pattern"], ["autocomplete", "autocomplete"],
        ["autofocus", "autofocus"], ["for_", "for"],
        ["colspan", "colspan"], ["rowspan", "rowspan"]
    ]

    var ai: Float = 0
    while (ai < attr_defs.length()) {
        var def: List<String> = attr_defs[ai]
        sb.append("fun " + def[0] + "(value: String): Attr { return Attr.Prop(\"" + def[1] + "\", value) }\n")
        ai = ai + 1
    }

    sb.append("\n// --- Data & ARIA attributes ---\n\n")
    sb.append("fun data(name: String, value: String): Attr { return Attr.Prop(\"data-\" + name, value) }\n")
    sb.append("fun aria(name: String, value: String): Attr { return Attr.Prop(\"aria-\" + name, value) }\n")

    return sb.to_string()
}

// --- Prelude generation: typed per-element functions for direct DOM manipulation ---

// Properties to skip (readonly, computed, or not useful as constructor params)
fun is_skip_prop(name: String): Bool {
    // Layout/measurement (readonly-like)
    if (name == "offsetWidth") return true
    if (name == "offsetHeight") return true
    if (name == "offsetLeft") return true
    if (name == "offsetTop") return true
    if (name == "offsetParent") return true
    if (name == "scrollWidth") return true
    if (name == "scrollHeight") return true
    if (name == "scrollLeft") return true
    if (name == "scrollTop") return true
    if (name == "clientWidth") return true
    if (name == "clientHeight") return true
    if (name == "clientLeft") return true
    if (name == "clientTop") return true
    if (name == "naturalWidth") return true
    if (name == "naturalHeight") return true
    if (name == "videoWidth") return true
    if (name == "videoHeight") return true
    if (name == "complete") return true
    if (name == "currentSrc") return true
    if (name == "networkState") return true
    if (name == "readyState") return true
    if (name == "seeking") return true
    if (name == "ended") return true
    if (name == "paused") return true
    if (name == "duration") return true
    if (name == "currentTime") return true
    if (name == "buffered") return true
    if (name == "played") return true
    if (name == "seekable") return true
    // Security risk
    if (name == "innerHTML") return true
    if (name == "outerHTML") return true
    if (name == "innerText") return true
    if (name == "outerText") return true
    if (name == "textContent") return true
    // Internal/computed
    if (name == "validity") return true
    if (name == "validationMessage") return true
    if (name == "willValidate") return true
    if (name == "form") return true
    if (name == "labels") return true
    if (name == "list") return true
    if (name == "options") return true
    if (name == "selectedOptions") return true
    if (name == "files") return true
    if (name == "elements") return true
    if (name == "length") return true
    if (name == "selectedIndex") return true
    if (name == "defaultChecked") return true
    if (name == "defaultValue") return true
    if (name == "defaultSelected") return true
    if (name == "command") return true
    if (name == "commandForElement") return true
    if (name == "popoverTargetAction") return true
    if (name == "popoverTargetElement") return true
    if (name == "encoding") return true
    if (name == "relList") return true
    if (name == "assignedSlot") return true
    if (name == "sheet") return true
    if (name == "contentDocument") return true
    if (name == "contentWindow") return true
    if (name == "sandbox") return true
    if (name == "srcdoc") return true
    if (name == "referrerPolicy") return true
    if (name == "loading") return true
    if (name == "decoding") return true
    if (name == "fetchPriority") return true
    if (name == "crossOrigin") return true
    if (name == "useMap") return true
    if (name == "isMap") return true
    if (name == "sizes") return true
    if (name == "srcset") return true
    if (name == "x") return true
    if (name == "y") return true
    if (name == "text") return true
    if (name == "ping") return true
    if (name == "selectionStart") return true
    if (name == "selectionEnd") return true
    if (name == "selectionDirection") return true
    if (name == "dirName") return true
    if (name == "formAction") return true
    if (name == "formEnctype") return true
    if (name == "formMethod") return true
    if (name == "formNoValidate") return true
    if (name == "formTarget") return true
    if (name == "capture") return true
    if (name == "indeterminate") return true
    if (name == "accept") return true
    if (name == "acceptCharset") return true
    // Not useful as construction params
    if (name == "valueAsNumber") return true
    if (name == "valueAsDate") return true
    if (name == "webkitdirectory") return true
    if (name == "webkitEntries") return true
    // Deprecated layout
    if (name == "align") return true
    if (name == "border") return true
    if (name == "hspace") return true
    if (name == "vspace") return true
    if (name == "longDesc") return true
    if (name == "coords") return true
    if (name == "shape") return true
    if (name == "noWrap") return true
    if (name == "ch") return true
    if (name == "chOff") return true
    if (name == "vAlign") return true
    if (name == "compact") return true
    if (name == "event") return true
    if (name == "htmlFor") return true
    // Marquee (deprecated)
    if (name == "behavior") return true
    if (name == "bgColor") return true
    if (name == "direction") return true
    if (name == "scrollAmount") return true
    if (name == "scrollDelay") return true
    if (name == "trueSpeed") return true
    if (name == "loop") return true
    // URL parts from HTMLHyperlinkElementUtils (only want href)
    if (name == "hash") return true
    if (name == "host") return true
    if (name == "hostname") return true
    if (name == "origin") return true
    if (name == "password") return true
    if (name == "pathname") return true
    if (name == "port") return true
    if (name == "protocol") return true
    if (name == "search") return true
    if (name == "username") return true
    return false
}

// Special name mappings
fun prelude_param_name(prop_name: String): String {
    if (prop_name == "className") return "cls"
    var sn: String = to_snake_case(prop_name)
    if (is_saffron_keyword(sn)) return sn + "_"
    return sn
}

// Map attr name to HTML attribute name for _tc_set_attr
fun html_attr_name(prop_name: String): String {
    if (prop_name == "className") return "class"
    if (prop_name == "htmlFor") return "for"
    if (prop_name == "noValidate") return "novalidate"
    if (prop_name == "tabIndex") return "tabindex"
    if (prop_name == "accessKey") return "accesskey"
    if (prop_name == "readOnly") return "readonly"
    if (prop_name == "colSpan") return "colspan"
    if (prop_name == "rowSpan") return "rowspan"
    if (prop_name == "hreflang") return "hreflang"
    if (prop_name == "noWrap") return "nowrap"
    if (prop_name == "maxLength") return "maxlength"
    if (prop_name == "minLength") return "minlength"
    if (prop_name == "dateTime") return "datetime"
    if (prop_name == "cellPadding") return "cellpadding"
    if (prop_name == "cellSpacing") return "cellspacing"
    if (prop_name == "type") return "type"
    if (prop_name == "autocomplete") return "autocomplete"
    // General camelCase -> lowercase for HTML attributes
    return to_snake_case(prop_name).replace("_", "")
}

// Extract the extends list for an interface (returns the base interface names)
fun extract_extends(lines: List<String>, interface_name: String): List<String> {
    var extends_list: List<String> = []
    var target: String = "interface " + interface_name
    var i: Float = 0
    while (i < lines.length()) {
        var line: String = lines[i].trim()
        if (line.starts_with(target)) {
            var ext_idx: Float = line.index_of(" extends ")
            if (ext_idx > 0) {
                var brace_idx: Float = line.index_of("{")
                if (brace_idx < 0) { brace_idx = line.length() }
                var ext_str: String = line.slice(ext_idx + 9, brace_idx).trim()
                var parts: List<String> = ext_str.split(",")
                var pi: Float = 0
                while (pi < parts.length()) {
                    var base: String = parts[pi].trim()
                    if (base.length() > 0) {
                        extends_list.push(base)
                    }
                    pi = pi + 1
                }
            }
            break
        }
        i = i + 1
    }
    return extends_list
}

// Bases to skip when collecting mixin props
fun is_skip_base(name: String): Bool {
    if (name == "HTMLElement") return true
    if (name == "Element") return true
    if (name == "HTMLMediaElement") return true
    if (name == "Node") return true
    if (name == "EventTarget") return true
    if (name == "ElementCSSInlineStyle") return true
    if (name == "ElementContentEditable") return true
    if (name == "GlobalEventHandlers") return true
    if (name == "HTMLOrSVGElement") return true
    if (name == "WindowEventHandlers") return true
    if (name == "PopoverTargetAttributes") return true
    return false
}

// Extract props from an interface + its mixin bases
fun extract_all_props(lines: List<String>, interface_name: String): List<List<String>> {
    var props: List<List<String>> = extract_interface_props(lines, interface_name)
    var seen: List<String> = []
    var pi: Float = 0
    while (pi < props.length()) {
        seen.push(props[pi][0])
        pi = pi + 1
    }

    var extends_list: List<String> = extract_extends(lines, interface_name)
    var ei: Float = 0
    while (ei < extends_list.length()) {
        var base: String = extends_list[ei]
        if (!is_skip_base(base)) {
            var mixin_props: List<List<String>> = extract_interface_props(lines, base)
            var mi: Float = 0
            while (mi < mixin_props.length()) {
                var prop_name: String = mixin_props[mi][0]
                if (!seen.contains(prop_name)) {
                    props.push(mixin_props[mi])
                    seen.push(prop_name)
                }
                mi = mi + 1
            }
        }
        ei = ei + 1
    }
    return props
}

// Which events to include per element category
fun events_for_element(tag: String): List<List<String>> {
    var events: List<List<String>> = []
    // All elements get on_click
    events.push(["on_click", "click"])
    if (tag == "input" or tag == "textarea") {
        events.push(["on_input", "input"])
        events.push(["on_change", "change"])
        events.push(["on_focus", "focus"])
        events.push(["on_blur", "blur"])
        events.push(["on_keydown", "keydown"])
    } else if (tag == "select") {
        events.push(["on_change", "change"])
        events.push(["on_focus", "focus"])
        events.push(["on_blur", "blur"])
    } else if (tag == "form") {
        events.push(["on_submit", "submit"])
        events.push(["on_reset", "reset"])
    } else if (tag == "button") {
        events.push(["on_submit", "submit"])
    } else if (tag == "a") {
        // just on_click (already added)
    } else if (tag == "details") {
        events.push(["on_toggle", "toggle"])
    } else if (tag == "video" or tag == "audio") {
        events.push(["on_play", "play"])
        events.push(["on_pause", "pause"])
        events.push(["on_ended", "ended"])
    }
    return events
}

// Elements that should get fully typed functions (have their own interface with useful props)
fun is_typed_element(tag: String, interface_name: String): Bool {
    if (interface_name == "HTMLElement") return false
    if (tag == "body" or tag == "head" or tag == "html") return false
    if (tag == "script" or tag == "noscript") return false
    if (tag == "style") return false
    if (tag == "template" or tag == "slot") return false
    if (tag == "object") return false
    return true
}

// Default value for a Saffron type
fun default_for_type(sf_type: String): String {
    if (sf_type == "String") return "\"\""
    if (sf_type == "Bool") return "false"
    if (sf_type == "Float") return "0"
    return "nil"
}

// Generate a typed prelude function for an element
fun generate_prelude_fn(sb: StringBuilder, tag: String, fn_name: String,
                        props: List<List<String>>, is_void: Bool) {
    var events: List<List<String>> = events_for_element(tag)

    // Build param list: cls, id, style + element-specific + events + attrs + block
    sb.append("fun " + fn_name + "(cls: String = \"\", id: String = \"\", style: String = \"\"")

    // Element-specific typed params (but not cls/id/style which are common)
    var pi: Float = 0
    while (pi < props.length()) {
        var prop: List<String> = props[pi]
        var prop_name: String = prop[0]
        var sf_type: String = prop[1]
        // Skip className (we have cls), skip id, skip style
        if (prop_name != "className" and prop_name != "id" and prop_name != "style") {
            var param: String = prelude_param_name(prop_name)
            var def: String = default_for_type(sf_type)
            sb.append(",\n           " + param + ": " + sf_type + " = " + def)
        }
        pi = pi + 1
    }

    // Event params
    var ei: Float = 0
    while (ei < events.length()) {
        var ev: List<String> = events[ei]
        sb.append(",\n           " + ev[0] + ": (Event) => Nil = nil")
        ei = ei + 1
    }

    // Overflow attrs + block
    sb.append(",\n           attrs: Map<String, Any> = {}")
    if (!is_void) {
        sb.append(", block: () => Nil = nil")
    }
    sb.append("): Float {\n")

    // Body: create element
    sb.append("    var el: Float = _tc_create(\"" + tag + "\")\n")

    // Common attrs
    sb.append("    if (cls.length() > 0) { _tc_set_attr(el, \"class\", cls) }\n")
    sb.append("    if (id.length() > 0) { _tc_set_attr(el, \"id\", id) }\n")
    sb.append("    if (style.length() > 0) { _tc_set_attr(el, \"style\", style) }\n")

    // Element-specific attrs
    pi = 0
    while (pi < props.length()) {
        var prop: List<String> = props[pi]
        var prop_name: String = prop[0]
        var sf_type: String = prop[1]
        if (prop_name != "className" and prop_name != "id" and prop_name != "style") {
            var param: String = prelude_param_name(prop_name)
            var attr_name: String = html_attr_name(prop_name)
            if (sf_type == "Bool") {
                sb.append("    if (" + param + ") { _tc_set_attr(el, \"" + attr_name + "\", \"true\") }\n")
            } else if (sf_type == "Float") {
                sb.append("    if (" + param + " != 0) { _tc_set_attr(el, \"" + attr_name + "\", " + param + ".to_string()) }\n")
            } else {
                sb.append("    if (" + param + ".length() > 0) { _tc_set_attr(el, \"" + attr_name + "\", " + param + ") }\n")
            }
        }
        pi = pi + 1
    }

    // Events
    ei = 0
    while (ei < events.length()) {
        var ev: List<String> = events[ei]
        sb.append("    if (" + ev[0] + " != nil) { _tc_add_event(el, \"" + ev[1] + "\", fun () => " + ev[0] + "(_tc_event)) }\n")
        ei = ei + 1
    }

    // Overflow attrs
    sb.append("    _tc_apply_attrs(el, attrs)\n")

    // Append to parent
    sb.append("    var parent: Float = _tc_current()\n")
    sb.append("    _tc_append(parent, el)\n")

    // Block (for non-void)
    if (!is_void) {
        sb.append("    if (block != nil) { _tc_push(el); block(); _tc_pop() }\n")
    }

    sb.append("    return el\n")
    sb.append("}\n\n")
}

// Generate a simple prelude function (no element-specific attrs)
fun generate_simple_prelude_fn(sb: StringBuilder, tag: String, fn_name: String, is_void: Bool) {
    if (is_void) {
        sb.append("fun " + fn_name + "(cls: String = \"\", id: String = \"\", style: String = \"\",\n")
        sb.append("       on_click: (Event) => Nil = nil, attrs: Map<String, Any> = {}): Float {\n")
        sb.append("    var el: Float = _tc_create(\"" + tag + "\")\n")
        sb.append("    if (cls.length() > 0) { _tc_set_attr(el, \"class\", cls) }\n")
        sb.append("    if (id.length() > 0) { _tc_set_attr(el, \"id\", id) }\n")
        sb.append("    if (style.length() > 0) { _tc_set_attr(el, \"style\", style) }\n")
        sb.append("    if (on_click != nil) { _tc_add_event(el, \"click\", fun () => on_click(_tc_event)) }\n")
        sb.append("    _tc_apply_attrs(el, attrs)\n")
        sb.append("    var parent: Float = _tc_current()\n")
        sb.append("    _tc_append(parent, el)\n")
        sb.append("    return el\n")
        sb.append("}\n\n")
    } else {
        sb.append("fun " + fn_name + "(cls: String = \"\", id: String = \"\", style: String = \"\",\n")
        sb.append("       on_click: (Event) => Nil = nil, attrs: Map<String, Any> = {}, block: () => Nil = nil): Float {\n")
        sb.append("    var el: Float = _tc_el_with_common(\"" + tag + "\", cls, id, style, attrs, block)\n")
        sb.append("    if (on_click != nil) { _tc_add_event(el, \"click\", fun () => on_click(_tc_event)) }\n")
        sb.append("    return el\n")
        sb.append("}\n\n")
    }
}

fun generate_prelude(tag_map: Map<String, String>, lines: List<String>): String {
    var sb = StringBuilder()

    sb.append("// AUTO-GENERATED from dom.generated.d.ts — Turmeric Prelude element functions\n")
    sb.append("// Run: saffron run tools/generate_types.sf\n")
    sb.append("// Provides fully typed per-element builder functions for direct DOM manipulation.\n\n")

    // --- Element functions ---
    sb.append("// =============================================================================\n")
    sb.append("// Element Builder Functions (typed per-element params)\n")
    sb.append("// =============================================================================\n\n")

    var tags: List<String> = tag_map.keys()
    tags.sort()
    var ti: Float = 0
    while (ti < tags.length()) {
        var tag: String = tags[ti]
        var interface_name: String = tag_map.get(tag)
        var fn_name: String = tag
        if (is_saffron_keyword(tag)) {
            fn_name = tag + "_"
        }
        // 'map' conflicts with Map type
        if (fn_name == "map") {
            fn_name = "map_el"
        }
        // Skip head, html, body, script, style, template, slot, noscript
        if (tag == "head" or tag == "html" or tag == "body" or tag == "script" or
            tag == "noscript" or tag == "style" or tag == "template" or tag == "slot") {
            ti = ti + 1
            continue
        }

        var void_el: Bool = is_void_element(tag)

        if (is_typed_element(tag, interface_name)) {
            // Get props from the interface + its mixin bases
            var props: List<List<String>> = extract_all_props(lines, interface_name)

            // Filter out skipped props and common params (cls, id, style)
            var filtered: List<List<String>> = []
            var fi: Float = 0
            while (fi < props.length()) {
                var prop: List<String> = props[fi]
                if (!is_skip_prop(prop[0]) and prop[0] != "className" and prop[0] != "id" and prop[0] != "style") {
                    filtered.push(prop)
                }
                fi = fi + 1
            }

            if (filtered.length() > 0) {
                generate_prelude_fn(sb, tag, fn_name, filtered, void_el)
            } else {
                generate_simple_prelude_fn(sb, tag, fn_name, void_el)
            }
        } else {
            generate_simple_prelude_fn(sb, tag, fn_name, void_el)
        }
        ti = ti + 1
    }

    return sb.to_string()
}

// --- Main ---

IO.println("Reading " + INPUT + "...")
var content: String = IO.read_file(INPUT)
var lines: List<String> = content.split("\n")
IO.println("  " + lines.length().to_string() + " lines")

IO.println("Extracting tag map...")
var tag_map: Map<String, String> = extract_tag_map(lines)
IO.println("  " + tag_map.keys().length().to_string() + " elements")

IO.println("Extracting event map...")
var event_map: Map<String, String> = extract_event_map(lines)
IO.println("  " + event_map.keys().length().to_string() + " events")

IO.println("Generating types...")
var output: String = generate(tag_map, event_map, lines)

IO.write_file(OUTPUT, output)
IO.println("Written to " + OUTPUT)

IO.println("Generating prelude...")
var prelude_output: String = generate_prelude(tag_map, lines)

IO.write_file(OUTPUT_PRELUDE, prelude_output)
IO.println("Written to " + OUTPUT_PRELUDE)
