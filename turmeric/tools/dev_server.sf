//! Turmeric Dev Server — serves static files with SSE hot reload.
//!
//! ```saffron
//! import "turmeric/tools/dev_server" as DevServer
//! DevServer.serve("build/", 8080, ["src/", "build/"])
//! ```

import "@http/server" as Http
import "@socket" as Socket
import "@watch" as Watch

var _sse_clients: List<Int> = []

var RELOAD_SCRIPT: String = "\n<script>\n(function() {\n    var es = new EventSource('/__reload');\n    es.onmessage = function(e) { if (e.data === 'reload') window.location.reload(); };\n    es.onerror = function() { setTimeout(function() { window.location.reload(); }, 1000); };\n})();\n</script>\n"

fun mime_for(path: String): String {
    if (path.ends_with(".html")) { return "text/html; charset=utf-8" }
    if (path.ends_with(".js")) { return "application/javascript" }
    if (path.ends_with(".mjs")) { return "application/javascript" }
    if (path.ends_with(".css")) { return "text/css" }
    if (path.ends_with(".wasm")) { return "application/wasm" }
    if (path.ends_with(".json")) { return "application/json" }
    if (path.ends_with(".png")) { return "image/png" }
    if (path.ends_with(".svg")) { return "image/svg+xml" }
    if (path.ends_with(".ico")) { return "image/x-icon" }
    return "application/octet-stream"
}

fun notify_reload() {
    var i = 0
    while (i < _sse_clients.length()) {
        Socket.write(_sse_clients[i], "data: reload\n\n")
        Socket.close(_sse_clients[i])
        i = i + 1
    }
    _sse_clients = []
}

fun serve(build_dir: String, port: Number, watch_dirs: List<String>) {
    var watcher = Watch.create()
    var wi = 0
    while (wi < watch_dirs.length()) {
        watcher.add(watch_dirs[wi])
        wi = wi + 1
    }

    var app = Http.create(port)

    app.get("/__reload", fun (req: Http.Request): Http.Response => {
        // SSE handled below in the custom serve loop
        var h: Map<String, String> = {}
        h.set("Content-Type", "text/event-stream")
        h.set("Cache-Control", "no-cache")
        h.set("Access-Control-Allow-Origin", "*")
        return Http.Response(200, "OK", h, "data: connected\n\n")
    })

    app.all("*", fun (req: Http.Request): Http.Response => {
        var path = req.path
        var file_path: String = build_dir + path
        if (path == "/" or path == "") {
            file_path = build_dir + "/index.html"
        }
        if (!IO.file_exists(file_path)) {
            file_path = build_dir + "/index.html"
        }
        if (!IO.file_exists(file_path)) {
            return Http.not_found()
        }
        var content: String = IO.read_file(file_path)
        var mime: String = mime_for(file_path)
        if (mime.starts_with("text/html")) {
            content = content.replace("</body>", RELOAD_SCRIPT + "</body>")
        }
        return Http.file(content, mime)
    })

    IO.println("")
    IO.println("  Turmeric dev server")
    IO.println("  http://localhost:" + port.to_string())
    IO.println("  Watching: " + watch_dirs.join(", "))
    IO.println("  Press Ctrl+C to stop")
    IO.println("")

    // Custom serve loop with file watching integrated
    import "@server" as Server
    var listener = Server.listen("0.0.0.0", port)
    while (true) {
        if (watcher.poll(0)) {
            IO.println("  [reload] file changed")
            notify_reload()
        }

        var client: Int = listener.accept()
        if (client >= 0) {
            var raw: String = Socket.read(client, 8192)
            if (raw.length() == 0) {
                Socket.close(client)
            } else {
                var req: Http.Request = Http.parse_request(raw)
                if (req.path == "/__reload") {
                    var sse_headers: String = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: keep-alive\r\nAccess-Control-Allow-Origin: *\r\n\r\ndata: connected\n\n"
                    Socket.write(client, sse_headers)
                    _sse_clients.push(client)
                } else {
                    var resp: Http.Response = app.route(req)
                    Socket.write(client, resp.to_http())
                    Socket.close(client)
                }
            }
        }
    }
}
