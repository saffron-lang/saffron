fun dt(block: Any = nil): Float { return _tc_el("dt", block) }
fun dd(block: Any = nil): Float { return _tc_el("dd", block) }
fun table(block: Any = nil): Float { return _tc_el("table", block) }
fun thead(block: Any = nil): Float { return _tc_el("thead", block) }
fun tbody(block: Any = nil): Float { return _tc_el("tbody", block) }
fun tr(block: Any = nil): Float { return _tc_el("tr", block) }
fun th(block: Any = nil): Float { return _tc_el("th", block) }
fun td(block: Any = nil): Float { return _tc_el("td", block) }
