// --- Interactive elements (extra typed params for events/attributes) ---

fun button(cls: String = "", id: String = "", style: String = "",
           on_click: Any = nil, disabled: String = "",
           attrs: Map<String, Any> = {}, block: Any = nil): Float {
    var el: Float = _tc_create("button")
    if (cls.length() > 0) { _tc_set_attr(el, "class", cls) }
    if (id.length() > 0) { _tc_set_attr(el, "id", id) }
    if (style.length() > 0) { _tc_set_attr(el, "style", style) }
    if (disabled.length() > 0) { _tc_set_attr(el, "disabled", disabled) }
    if (on_click != nil) { _tc_add_event(el, "click", on_click) }
    _tc_apply_attrs(el, attrs)
    var parent: Float = _tc_current()
    _tc_append(parent, el)
    if (block != nil) { _tc_push(el); block(); _tc_pop() }
    return el
}

fun input(cls: String = "", id: String = "", style: String = "",
          type: String = "", value: String = "", placeholder: String = "",
          on_input: Any = nil, on_change: Any = nil,
          attrs: Map<String, Any> = {}, block: Any = nil): Float {
    var el: Float = _tc_create("input")
    if (cls.length() > 0) { _tc_set_attr(el, "class", cls) }
    if (id.length() > 0) { _tc_set_attr(el, "id", id) }
    if (style.length() > 0) { _tc_set_attr(el, "style", style) }
    if (type.length() > 0) { _tc_set_attr(el, "type", type) }
    if (value.length() > 0) { _tc_set_attr(el, "value", value) }
    if (placeholder.length() > 0) { _tc_set_attr(el, "placeholder", placeholder) }
    if (on_input != nil) { _tc_add_event(el, "input", on_input) }
    if (on_change != nil) { _tc_add_event(el, "change", on_change) }
    _tc_apply_attrs(el, attrs)
    var parent: Float = _tc_current()
    _tc_append(parent, el)
    if (block != nil) { _tc_push(el); block(); _tc_pop() }
    return el
}

fun a(cls: String = "", id: String = "", style: String = "",
      href: String = "", target: String = "",
      attrs: Map<String, Any> = {}, block: Any = nil): Float {
    var el: Float = _tc_create("a")
    if (cls.length() > 0) { _tc_set_attr(el, "class", cls) }
    if (id.length() > 0) { _tc_set_attr(el, "id", id) }
    if (style.length() > 0) { _tc_set_attr(el, "style", style) }
    if (href.length() > 0) { _tc_set_attr(el, "href", href) }
    if (target.length() > 0) { _tc_set_attr(el, "target", target) }
    _tc_apply_attrs(el, attrs)
    var parent: Float = _tc_current()
    _tc_append(parent, el)
    if (block != nil) { _tc_push(el); block(); _tc_pop() }
    return el
}

