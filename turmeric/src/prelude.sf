// --- Self-closing elements (no block) ---
fun br(attrs: Map<String, Any> = {}): Float { return _tc_el("br", attrs, nil) }
fun hr(attrs: Map<String, Any> = {}): Float { return _tc_el("hr", attrs, nil) }
fun img(attrs: Map<String, Any> = {}): Float { return _tc_el("img", attrs, nil) }
