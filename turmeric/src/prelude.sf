// Each function creates a DOM element with typed parameters derived from the
// TypeScript DOM spec. Common params (cls, id, style) come first, followed by
// element-specific attributes, event handlers, and an overflow attrs map.

// =============================================================================
// Element Builder Functions (typed per-element params)
// =============================================================================

fun a(cls: String = "", id: String = "", style: String = "",
      download: String = "",
      hreflang: String = "",
      rel: String = "",
      target: String = "",
      type_: String = "",
      href: String = "",
      on_click: (Event) => Nil = nil,
      attrs: Map<String, Any> = {},
      block: () => Nil = nil): Float {
    var el: Float = _tc_create("a")
    if (cls.length() > 0) { _tc_set_attr(el, "class", cls) }
    if (id.length() > 0) { _tc_set_attr(el, "id", id) }
    if (style.length() > 0) { _tc_set_attr(el, "style", style) }
    if (download.length() > 0) { _tc_set_attr(el, "download", download) }
    if (hreflang.length() > 0) { _tc_set_attr(el, "hreflang", hreflang) }
    if (rel.length() > 0) { _tc_set_attr(el, "rel", rel) }
    if (target.length() > 0) { _tc_set_attr(el, "target", target) }
    if (type_.length() > 0) { _tc_set_attr(el, "type", type_) }
    if (href.length() > 0) { _tc_set_attr(el, "href", href) }
    if (on_click != nil) { _tc_add_event(el, "click", fun () => on_click(_tc_event)) }
    _tc_apply_attrs(el, attrs)
    var parent: Float = _tc_current()
    _tc_append(parent, el)
    if (block != nil) { _tc_push(el); block(); _tc_pop() }
    return el
}

