// Turmeric Prelude — auto-imported into any app that depends on turmeric
// Provides HTML element builder functions and text() for inline HTML support

@extern("i64 js_dom_create_element(void*)") fun _dom_create(tag: String): Float
@extern("void js_dom_set_text(i64, void*)") fun _dom_set_text(handle: Float, text: String)
@extern("void js_dom_set_attribute(i64, void*, void*)") fun _dom_set_attr(handle: Float, name: String, value: String)
@extern("void js_dom_append_child(i64, i64)") fun _dom_append(parent: Float, child: Float)
@extern("void js_dom_add_event_listener(i64, void*, i64)") fun _dom_on(handle: Float, event: String, cb: Float)

// --- Text node ---
fun text(content: String) {
    // In WASM: creates a text node and appends to current parent
    // For now: noop (framework wires this up at mount time)
}

// --- Element builders ---
// Each creates an element, applies named args as attrs, calls block for children

