fun h4(block: Any = nil): Float { return _tc_el("h4", block) }
fun h5(block: Any = nil): Float { return _tc_el("h5", block) }
fun h6(block: Any = nil): Float { return _tc_el("h6", block) }
fun button(block: Any = nil): Float { return _tc_el("button", block) }
fun input(): Float { return _tc_el("input", nil) }
fun textarea(block: Any = nil): Float { return _tc_el("textarea", block) }
fun select(block: Any = nil): Float { return _tc_el("select", block) }
fun option(block: Any = nil): Float { return _tc_el("option", block) }
fun form(block: Any = nil): Float { return _tc_el("form", block) }
fun label(block: Any = nil): Float { return _tc_el("label", block) }
