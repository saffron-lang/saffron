// Turmeric Prelude — auto-imported into any app that depends on turmeric
// Provides HTML element builder functions that create real DOM nodes
//
// Element functions are auto-generated from the TypeScript DOM spec.
// To regenerate: saffron run tools/generate_types.sf
// Then run: tools/build_prelude.sh (concatenates infra + generated elements)

// --- DOM FFI (provided by wasm_base.ll) ---
@extern("i64 js_event_get_string(i64, void*)") fun _tc_event_get_string(event_ptr: Float, field: String): String
@extern("i64 js_dom_create_element(void*)") fun _tc_create(tag: String): Float

// --- Event value accessor: reads from the current JS event on the _eventStack ---
// Used by prelude on_input/on_change handlers where the full typed Event is unavailable.
fun event_target_value(): String {
    return _tc_event_get_string(0, "target.value")
}

// =============================================================================
// Event class — lightweight wrapper around the JS event stack
// Passed to all on_* handlers so users can access event properties directly.
// Methods read from the _eventStack via FFI (the event is on the stack while
// the handler executes).
// =============================================================================

@extern("void js_event_prevent_default(i64)") fun _tc_event_prevent_default(event_ptr: Float)
@extern("void js_event_stop_propagation(i64)") fun _tc_event_stop_propagation(event_ptr: Float)
@extern("i64 js_event_get_float(i64, void*)") fun _tc_event_get_float(event_ptr: Float, field: String): Float
@extern("i64 js_event_get_bool(i64, void*)") fun _tc_event_get_bool(event_ptr: Float, field: String): Bool

class Event {
    fun init() {}

    fun target_value(): String {
        return _tc_event_get_string(0, "target.value")
    }

    fun target_checked(): Bool {
        return _tc_event_get_bool(0, "target.checked")
    }

    fun key(): String {
        return _tc_event_get_string(0, "key")
    }

    fun code(): String {
        return _tc_event_get_string(0, "code")
    }

    fun prevent_default() {
        _tc_event_prevent_default(0)
    }

    fun stop_propagation() {
        _tc_event_stop_propagation(0)
    }

    fun client_x(): Float {
        return _tc_event_get_float(0, "clientX")
    }

    fun client_y(): Float {
        return _tc_event_get_float(0, "clientY")
    }

    fun offset_x(): Float {
        return _tc_event_get_float(0, "offsetX")
    }

    fun offset_y(): Float {
        return _tc_event_get_float(0, "offsetY")
    }

    fun button(): Float {
        return _tc_event_get_float(0, "button")
    }

    fun alt_key(): Bool {
        return _tc_event_get_bool(0, "altKey")
    }

    fun ctrl_key(): Bool {
        return _tc_event_get_bool(0, "ctrlKey")
    }

    fun shift_key(): Bool {
        return _tc_event_get_bool(0, "shiftKey")
    }

    fun meta_key(): Bool {
        return _tc_event_get_bool(0, "metaKey")
    }

    fun get_string(field: String): String {
        return _tc_event_get_string(0, field)
    }

    fun get_float(field: String): Float {
        return _tc_event_get_float(0, field)
    }

    fun get_bool(field: String): Bool {
        return _tc_event_get_bool(0, field)
    }
}

// Shared Event instance — reused across dispatches (the Event class reads
// lazily from the JS event stack, so a single instance works for all calls).
var _tc_event: Event = Event()
@extern("void js_dom_set_text(i64, void*)") fun _tc_set_text(handle: Float, text: String)
@extern("void js_dom_append_child(i64, i64)") fun _tc_append(parent: Float, child: Float)
@extern("void js_dom_set_attr(i64, void*, void*)") fun _tc_set_attr(handle: Float, name: String, value: String)
@extern("void js_dom_add_event(i64, void*, i64)") fun _tc_add_event_raw(handle: Float, event: String, callback_id: Float)
@extern("void js_dom_set_inner_html(i64, void*)") fun _tc_set_html(handle: Float, html: String)
@extern("i64 js_dom_query_selector(void*)") fun _tc_query(selector: String): Float

// --- Event callback registry ---
// Callbacks have varying signatures: () => Nil, (Event) => Nil, etc.
// Must remain Any because the list is heterogeneous and the codegen dispatches
// handler() via a dynamic call that works regardless of the actual function arity.
var _tc_callbacks: List<Any> = []

fun _tc_register_callback(handler: Any): Float {
    _tc_callbacks.push(handler)
    return _tc_callbacks.length() - 1
}

// handler is Any because callers pass both () => Nil and (Event) => Nil callbacks.
fun _tc_add_event(handle: Float, event: String, handler: Any) {
    var id: Float = _tc_register_callback(handler)
    _tc_add_event_raw(handle, event, id)
}


// Exported: JS calls this when a DOM event fires
fun __dispatch_event(callback_id: Float) {
    if (callback_id >= 0 and callback_id < _tc_callbacks.length()) {
        var handler: Any = _tc_callbacks[callback_id]
        handler()
    }
}

// --- Context stack: tracks current parent for nesting ---
var _tc_stack: List<Float> = []
var _tc_root: Float = 0

fun _tc_push(handle: Float) {
    _tc_stack.push(handle)
}

fun _tc_pop(): Float {
    if (_tc_stack.length() == 0) {
        throw "turmeric: element stack underflow — more pops than pushes (check nesting)"
    }
    return _tc_stack.pop()
}

fun _tc_current(): Float {
    if (_tc_stack.length() == 0) { return _tc_root }
    return _tc_stack[_tc_stack.length() - 1]
}

// --- Text node ---
fun text(content: String) {
    var parent: Float = _tc_current()
    _tc_set_text(parent, content)
}

// --- Reactive text: re-evaluates and updates DOM when signals change ---
// Usage: reactive(fun () => count.get().to_string())
// Creates a <span>, renders initial value, and re-renders when deps change.
// Uses the turmeric signal module's effect() for dependency tracking.
// compute is logically () => String, but must remain Any because the prelude
// has no module prefix and the codegen can't resolve generic function types here.
fun reactive(compute: Any) {
    var parent: Float = _tc_current()
    var text_el: Float = _tc_create("span")
    _tc_append(parent, text_el)
    turmeric_signal_effect(fun () => {
        var val: String = compute()
        _tc_set_text(text_el, val)
    })
}

// --- Reactive class: updates element className when deps change ---
// Usage: var el = div(); reactive_class(el, fun () => cx({"active": sig.get()}))
// rc_compute is logically () => String, but must remain Any — codegen can't
// resolve generic function types in the no-prefix prelude context.
fun reactive_class(rc_el: Float, rc_compute: Any) {
    var rc_handle: Float = rc_el
    turmeric_signal_effect(fun () => {
        var cls: String = rc_compute()
        _tc_set_attr(rc_handle, "class", cls)
    })
}

// --- Reactive attr: updates any attribute reactively ---
// Usage: reactive_attr(el, "style", fun () => "color:" + color.get())
// ra_compute is logically () => String, but must remain Any — codegen can't
// resolve generic function types in the no-prefix prelude context.
fun reactive_attr(ra_el: Float, ra_name: String, ra_compute: Any) {
    var ra_handle: Float = ra_el
    var ra_attr: String = ra_name
    turmeric_signal_effect(fun () => {
        var val: String = ra_compute()
        _tc_set_attr(ra_handle, ra_attr, val)
    })
}

// --- Reactive visibility: show/hide element based on signal ---
// Usage: reactive_show(el, fun () => if (visible) { return "" } return "display:none")
// Compute must return "" (show) or "display:none" (hide).
// rs_compute is logically () => String, but must remain Any — codegen can't
// resolve generic function types in the no-prefix prelude context.
fun reactive_show(rs_el: Float, rs_compute: Any) {
    var rs_handle: Float = rs_el
    turmeric_signal_effect(fun () => {
        var style_val: String = rs_compute()
        _tc_set_attr(rs_handle, "style", style_val)
    })
}

// --- Render Into: clears a container and executes a builder into it ---
// Used by router outlet. Temporarily disables tracking so inner signal
// reads don't subscribe the caller's effect.
fun render_into(container: Float, builder: () => Nil) {
    var was: Bool = turmeric_signal__tracking
    turmeric_signal__tracking = false
    _tc_set_html(container, "")
    _tc_push(container)
    builder()
    _tc_pop()
    turmeric_signal__tracking = was
}

// --- Attribute application: maps keys to DOM operations ---
// attrs values are heterogeneous: String for attributes, () => Nil for on_ handlers.
// Map<String, Any> is intentional — no union type covers both cleanly.
fun _tc_apply_attrs(el: Float, attrs: Map<String, Any>) {
    var keys = attrs.keys()
    var i = 0
    while (i < keys.length()) {
        var key = keys[i]
        var value = attrs.get(key)
        if (key == "cls" or key == "class") {
            _tc_set_attr(el, "class", value)
        } else if (key == "id") {
            _tc_set_attr(el, "id", value)
        } else if (key.starts_with("on_")) {
            var event_name = key.slice(3, key.length())
            _tc_add_event(el, event_name, value)
        } else {
            _tc_set_attr(el, key, value)
        }
        i = i + 1
    }
}

// --- Common attribute helper: creates element, sets typed common attrs, applies overflow, nests block ---
fun _tc_el_with_common(tag: String, cls: String, id: String, style: String,
                       attrs: Map<String, Any>, block: () => Nil): Float {
    var el: Float = _tc_create(tag)
    if (cls.length() > 0) { _tc_set_attr(el, "class", cls) }
    if (id.length() > 0) { _tc_set_attr(el, "id", id) }
    if (style.length() > 0) { _tc_set_attr(el, "style", style) }
    _tc_apply_attrs(el, attrs)
    var parent: Float = _tc_current()
    _tc_append(parent, el)
    if (block != nil) {
        _tc_push(el)
        block()
        _tc_pop()
    }
    return el
}

// =============================================================================
// Timers — setTimeout / setInterval / debounce
// =============================================================================

@extern("i64 js_set_timeout(i64, i64)") fun _tc_set_timeout(callback_id: Float, ms: Float): Float
@extern("void js_clear_timeout(i64)") fun _tc_clear_timeout(timer_id: Float)
@extern("i64 js_set_interval(i64, i64)") fun _tc_set_interval(callback_id: Float, ms: Float): Float
@extern("void js_clear_interval(i64)") fun _tc_clear_interval(timer_id: Float)

var _tc_timer_callbacks: List<Any> = []

fun _tc_register_timer(handler: () => Nil): Float {
    _tc_timer_callbacks.push(handler)
    return _tc_timer_callbacks.length() - 1
}

fun __on_timeout(callback_id: Float) {
    if (callback_id >= 0 and callback_id < _tc_timer_callbacks.length()) {
        var handler: Any = _tc_timer_callbacks[callback_id]
        if (handler != nil) {
            handler()
        }
    }
}

fun set_timeout(handler: () => Nil, ms: Float): Float {
    var id: Float = _tc_register_timer(handler)
    return _tc_set_timeout(id, ms)
}

fun clear_timeout(timer_id: Float) {
    _tc_clear_timeout(timer_id)
}

fun set_interval(handler: () => Nil, ms: Float): Float {
    var id: Float = _tc_register_timer(handler)
    return _tc_set_interval(id, ms)
}

fun clear_interval(timer_id: Float) {
    _tc_clear_interval(timer_id)
}

fun debounce(handler: () => Nil, ms: Float): () => Nil {
    var timer_id: Float = -1
    return fun () => {
        if (timer_id >= 0) {
            clear_timeout(timer_id)
        }
        timer_id = set_timeout(handler, ms)
    }
}

