// Turmeric Signals — fully generic reactive primitives

// =============================================================================
// Dependency Tracking
// =============================================================================

var _tracker_deps: List<Subscribable> = []
var _tracking: Bool = false
var _sub_id_counter: Float = 0

interface Subscribable {
    fun subscribe(fn: () => Nil): Float
    fun unsubscribe(id: Float)
}

fun start_tracking() {
    _tracking = true
    _tracker_deps = []
}

fun stop_tracking(): List<Subscribable> {
    _tracking = false
    var deps: List<Subscribable> = _tracker_deps
    _tracker_deps = []
    return deps
}

fun record_dep(sig: Subscribable) {
    if (_tracking) {
        _tracker_deps.push(sig)
    }
}

fun next_sub_id(): Float {
    _sub_id_counter = _sub_id_counter + 1
    return _sub_id_counter
}

// =============================================================================
// Subscription
// =============================================================================

class Subscription {
    var id: Float
    var fn: () => Nil
    var active: Bool

    fun init(id: Float, fn: () => Nil) {
        this.id = id
        this.fn = fn
        this.active = true
    }
}

// =============================================================================
// Signal<T> — mutable reactive state
// =============================================================================

class Signal<T> extends Subscribable {
    var value: T
    var subs: List<Subscription>

    fun init(initial: T) {
        this.value = initial
        this.subs = []
    }

    fun get(): T {
        record_dep(this)
        return this.value
    }

    fun set(next: T) {
        this.value = next
        this.notify()
    }

    fun update(fn: (T) => T) {
        this.set(fn(this.value))
    }

    fun notify() {
        var i: Float = 0
        while (i < this.subs.length()) {
            if (this.subs[i].active) {
                this.subs[i].fn()
            }
            i = i + 1
        }
    }

    fun subscribe(fn: () => Nil): Float {
        var id: Float = next_sub_id()
        this.subs.push(Subscription(id, fn))
        return id
    }

    fun unsubscribe(id: Float) {
        var i: Float = 0
        while (i < this.subs.length()) {
            if (this.subs[i].id == id) {
                this.subs[i].active = false
            }
            i = i + 1
        }
    }
}

fun signal<T>(initial: T): Signal<T> {
    return Signal(initial)
}

// =============================================================================
// Computed<T> — derived reactive value
// =============================================================================

class Computed<T> extends Subscribable {
    var value: T
    var compute: () => T
    var subs: List<Subscription>

    fun init(compute: () => T) {
        this.compute = compute
        this.subs = []
        this.recompute()
    }

    fun get(): T {
        record_dep(this)
        return this.value
    }

    fun recompute() {
        start_tracking()
        this.value = this.compute()
        var deps: List<Subscribable> = stop_tracking()
        var i: Float = 0
        while (i < deps.length()) {
            deps[i].subscribe(fun () => {
                this.value = this.compute()
                this.notify()
            })
            i = i + 1
        }
    }

    fun notify() {
        var i: Float = 0
        while (i < this.subs.length()) {
            if (this.subs[i].active) {
                this.subs[i].fn()
            }
            i = i + 1
        }
    }

    fun subscribe(fn: () => Nil): Float {
        var id: Float = next_sub_id()
        this.subs.push(Subscription(id, fn))
        return id
    }

    fun unsubscribe(id: Float) {
        var i: Float = 0
        while (i < this.subs.length()) {
            if (this.subs[i].id == id) {
                this.subs[i].active = false
            }
            i = i + 1
        }
    }
}

fun computed<T>(compute: () => T): Computed<T> {
    return Computed(compute)
}

// =============================================================================
// Effect — returns disposable handle
// =============================================================================

class EffectHandle {
    var sub_ids: List<Float>
    var deps: List<Subscribable>

    fun init(sub_ids: List<Float>, deps: List<Subscribable>) {
        this.sub_ids = sub_ids
        this.deps = deps
    }

    fun dispose() {
        var i: Float = 0
        while (i < this.deps.length()) {
            this.deps[i].unsubscribe(this.sub_ids[i])
            i = i + 1
        }
    }
}

fun effect(fn: () => Nil): EffectHandle {
    start_tracking()
    fn()
    var deps: List<Subscribable> = stop_tracking()
    var sub_ids: List<Float> = []
    var i: Float = 0
    while (i < deps.length()) {
        sub_ids.push(deps[i].subscribe(fn))
        i = i + 1
    }
    return EffectHandle(sub_ids, deps)
}

// =============================================================================
// Batch — defer notifications
// =============================================================================

var _batch_depth: Float = 0
var _batch_pending: List<() => Nil> = []

fun batch(fn: () => Nil) {
    _batch_depth = _batch_depth + 1
    fn()
    _batch_depth = _batch_depth - 1
    if (_batch_depth == 0) {
        var pending: List<() => Nil> = _batch_pending
        _batch_pending = []
        var i: Float = 0
        while (i < pending.length()) {
            pending[i]()
            i = i + 1
        }
    }
}

// =============================================================================
// Untrack — read without creating dependencies
// =============================================================================

fun untrack<T>(fn: () => T): T {
    var was_tracking: Bool = _tracking
    _tracking = false
    var result: T = fn()
    _tracking = was_tracking
    return result
}
