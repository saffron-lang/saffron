// Turmeric Signals — fully generic reactive primitives

// =============================================================================
// Reactive Interface (documented, not applied until codegen supports vtable dispatch)
// Both Signal<T> and Computed<T> implement subscribe/unsubscribe with compatible
// memory layouts (subs at offset 1). The codegen dispatches via Signal__subscribe
// for both, which works due to identical field offsets.
// =============================================================================

// =============================================================================
// Dependency Tracking
// =============================================================================

// _tracker_deps holds both Signal and Computed instances. Both conform to
// the Reactive interface, but we use Any here because the codegen dispatches
// .subscribe()/.unsubscribe() via memory-offset compatibility between Signal
// and Computed (both have `subs: List<Subscription>` at the same field offset).
// Changing to Reactive would break this accidental-but-relied-upon dispatch.
var _tracker_stack: List<List<Any>> = []
var _tracking: Bool = false
var _tracker_deps: List<Any> = []
var _sub_id_counter: Float = 0


fun start_tracking() {
    if (_tracking) {
        _tracker_stack.push(_tracker_deps)
    }
    _tracking = true
    _tracker_deps = []
}

fun stop_tracking(): List<Any> {
    var deps: List<Any> = _tracker_deps
    if (_tracker_stack.length() > 0) {
        _tracker_deps = _tracker_stack.pop()
    } else {
        _tracker_deps = []
        _tracking = false
    }
    return deps
}

// record_dep accepts Any because both Signal<T> and Computed<T> call it.
// The codegen relies on memory-offset dispatch for .subscribe()/.unsubscribe().
fun record_dep(sig: Any) {
    if (_tracking) {
        _tracker_deps.push(sig)
    }
}

fun next_sub_id(): Float {
    _sub_id_counter = _sub_id_counter + 1
    return _sub_id_counter
}

// =============================================================================
// Batch — defer notifications until outermost batch completes
// =============================================================================

var _batch_depth: Float = 0
var _batch_queue: List<Any> = []
var _batch_signals: List<Any> = []

fun _schedule_notify(sig: Any, notify_fn: () => Nil) {
    if (_batch_depth > 0) {
        _batch_queue.push(notify_fn)
        _batch_signals.push(sig)
    } else {
        notify_fn()
    }
}

fun _flush_batch() {
    while (_batch_queue.length() > 0) {
        var queue: List<Any> = _batch_queue
        _batch_queue = []
        _batch_signals = []
        var i: Float = 0
        while (i < queue.length()) {
            var fn: () => Nil = queue[i]
            fn()
            i = i + 1
        }
    }
}

fun batch(fn: () => Nil) {
    _batch_depth = _batch_depth + 1
    fn()
    _batch_depth = _batch_depth - 1
    if (_batch_depth == 0) {
        _flush_batch()
    }
}

// =============================================================================
// Subscription
// =============================================================================

class Subscription {
    var id: Float
    var fn: () => Nil
    var active: Bool

    fun init(id: Float, fn: () => Nil) {
        this.id = id
        this.fn = fn
        this.active = true
    }
}

// =============================================================================
// Signal<T> — mutable reactive state
// =============================================================================

class Signal<T> {
    var value: T
    var subs: List<Subscription>

    fun init(initial: T) {
        this.value = initial
        this.subs = []
    }

    fun get(): T {
        record_dep(this)
        return this.value
    }

    fun set(next: T) {
        this.value = next
    }

    fun update(fn: (T) => T) {
        this.set(fn(this.value))
    }

    fun notify() {
        var i: Float = 0
        while (i < this.subs.length()) {
            if (this.subs[i].active) {
                this.subs[i].fn()
            }
            i = i + 1
        }
    }

    fun subscribe(fn: () => Nil): Float {
        var id: Float = next_sub_id()
        this.subs.push(Subscription(id, fn))
        return id
    }

    fun unsubscribe(id: Float) {
        var i: Float = 0
        while (i < this.subs.length()) {
            if (this.subs[i].id == id) {
                this.subs[i].active = false
            }
            i = i + 1
        }
    }
}

fun signal<T>(initial: T): Signal<T> {
    return Signal(initial)
}

// =============================================================================
// Computed<T> — derived reactive value
// =============================================================================

class Computed<T> {
    var value: T
    var subs: List<Subscription>
    var compute: () => T

    fun init(compute: () => T) {
        this.compute = compute
        this.subs = []
        this.recompute()
    }

    fun get(): T {
        record_dep(this)
        return this.value
    }

    fun recompute() {
        start_tracking()
        this.value = this.compute()
        // deps is List<Any> — holds mixed Signal/Computed, dispatched by memory offset
        var deps: List<Any> = stop_tracking()
        var i: Float = 0
        while (i < deps.length()) {
            deps[i].subscribe(fun () => {
                this.value = this.compute()
                _schedule_notify(this, fun () => this.notify())
            })
            i = i + 1
        }
    }

    fun notify() {
        var i: Float = 0
        while (i < this.subs.length()) {
            if (this.subs[i].active) {
                this.subs[i].fn()
            }
            i = i + 1
        }
    }

    fun subscribe(fn: () => Nil): Float {
        var id: Float = next_sub_id()
        this.subs.push(Subscription(id, fn))
        return id
    }

    fun unsubscribe(id: Float) {
        var i: Float = 0
        while (i < this.subs.length()) {
            if (this.subs[i].id == id) {
                this.subs[i].active = false
            }
            i = i + 1
        }
    }
}

fun computed<T>(compute: () => T): Computed<T> {
    return Computed(compute)
}

// =============================================================================
// Effect — returns disposable handle
// =============================================================================

class EffectHandle {
    var sub_ids: List<Float>
    // deps holds mixed Signal<T> and Computed<T> — both conform to Reactive,
    // but we use Any to preserve codegen's memory-offset dispatch of .unsubscribe().
    var deps: List<Any>

    fun init(sub_ids: List<Float>, deps: List<Any>) {
        this.sub_ids = sub_ids
        this.deps = deps
    }

    fun dispose() {
        var i: Float = 0
        while (i < this.deps.length()) {
            this.deps[i].unsubscribe(this.sub_ids[i])
            i = i + 1
        }
    }
}

fun effect(fn: () => Nil): EffectHandle {
    start_tracking()
    fn()
    var deps: List<Any> = stop_tracking()
    var sub_ids: List<Float> = []
    var i: Float = 0
    while (i < deps.length()) {
        sub_ids.push(deps[i].subscribe(fn))
        i = i + 1
    }
    return EffectHandle(sub_ids, deps)
}

// =============================================================================
// Untrack — read without creating dependencies
// =============================================================================

fun untrack<T>(fn: () => T): T {
    var was_tracking: Bool = _tracking
    _tracking = false
    var result: T = fn()
    _tracking = was_tracking
    return result
}
