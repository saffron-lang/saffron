// Turmeric Router — client-side SPA routing
//
// Supports multiple routing modes:
//   - Hash:    /#/path — no server config needed, works everywhere
//   - History: /path   — clean URLs, requires server fallback to index.html
//   - Memory:  in-memory only — for testing or embedded use
//
// Usage:
//   import "turmeric/router" as Router
//
//   var router = Router.hash()   // or Router.history() or Router.memory("/")
//   router.route("/", fun (p) => HomePage())
//   router.route("/users/:id", fun (p) => UserPage(p.get("id")))
//   router.mount(parent_el)
//
//   // Navigate programmatically:
//   router.push("/users/42")
//   router.back()

import "./signal.sf" as Sig
import { Event } from "./events.sf"

// =============================================================================
// Route Params — passed to route handlers
// =============================================================================

class RouteParams {
    var path: String
    var params: Map<String, String>
    var query: Map<String, String>

    fun init(path: String, params: Map<String, String>, query: Map<String, String>) {
        this.path = path
        this.params = params
        this.query = query
    }

    fun get(name: String): String {
        if (this.params.has(name)) { return this.params.get(name) }
        return ""
    }

    fun query_get(name: String): String {
        if (this.query.has(name)) { return this.query.get(name) }
        return ""
    }
}

// =============================================================================
// Route pattern matching
// =============================================================================

fun split_path(path: String): List<String> {
    var segments: List<String> = []
    var parts: List<String> = path.split("/")
    var i: Float = 0
    while (i < parts.length()) {
        if (parts[i].length() > 0) {
            segments.push(parts[i])
        }
        i = i + 1
    }
    return segments
}

fun parse_query(qs: String): Map<String, String> {
    var result: Map<String, String> = {}
    if (qs.length() == 0) { return result }
    var str: String = qs
    if (str.starts_with("?")) { str = str.slice(1, str.length()) }
    var pairs: List<String> = str.split("&")
    var i: Float = 0
    while (i < pairs.length()) {
        var pair: String = pairs[i]
        var eq: Float = pair.index_of("=")
        if (eq > 0) {
            result.set(pair.slice(0, eq), pair.slice(eq + 1, pair.length()))
        }
        i = i + 1
    }
    return result
}

fun match_pattern(pattern: String, path: String): Map<String, String> {
    if (pattern == "*") { return {} }

    var pat_segs: List<String> = split_path(pattern)
    var path_segs: List<String> = split_path(path)
    var params: Map<String, String> = {}

    var i: Float = 0
    while (i < pat_segs.length()) {
        var seg: String = pat_segs[i]

        if (seg.starts_with("*")) {
            var name: String = seg.slice(1, seg.length())
            var rest: List<String> = []
            while (i < path_segs.length()) {
                rest.push(path_segs[i])
                i = i + 1
            }
            if (name.length() > 0) { params.set(name, rest.join("/")) }
            return params
        }

        if (i >= path_segs.length()) { return nil }

        if (seg.starts_with(":")) {
            var name: String = seg.slice(1, seg.length())
            params.set(name, path_segs[i])
        } else {
            if (seg != path_segs[i]) { return nil }
        }

        i = i + 1
    }

    if (path_segs.length() != pat_segs.length()) { return nil }
    return params
}

// =============================================================================
// Routing Mode — how the URL is read/written
// =============================================================================

enum Mode {
    Hash,
    History,
    Memory
}

// =============================================================================
// Router
// =============================================================================

// FFI — provided by the JS runtime
@extern("void js_set_hash(void*)") fun _js_set_hash(hash: String)
@extern("void* js_get_hash()") fun _js_get_hash(): String
@extern("void js_push_state(void*)") fun _js_push_state(path: String)
@extern("void* js_get_pathname()") fun _js_get_pathname(): String

// DOM FFI — needed for reactive outlet rendering
@extern("i64 js_dom_create_element(void*)") fun _rt_create(tag: String): Float
@extern("void js_dom_append_child(i64, i64)") fun _rt_append(parent: Float, child: Float)
@extern("void js_dom_set_inner_html(i64, void*)") fun _rt_set_html(handle: Float, html: String)

class RouteDef {
    var pattern: String
    var handler: (RouteParams) => Nil

    fun init(pattern: String, handler: (RouteParams) => Nil) {
        this.pattern = pattern
        this.handler = handler
    }
}

class Router {
    var mode: Mode
    var path: Sig.Signal<String>
    var routes: List<RouteDef>
    var _memory_path: String

    fun init(mode: Mode, initial: String) {
        this.mode = mode
        this.routes = []
        this._memory_path = initial
        this.path = Sig.signal(initial)
    }

    fun route(pattern: String, handler: (RouteParams) => Nil) {
        this.routes.push(RouteDef(pattern, handler))
    }

    fun go(url: String) {
        _js_set_hash(url)
        this.path.set(url)
    }

    fun current(): String {
        return this.path.get()
    }

    fun current_signal(): Sig.Signal<String> {
        return this.path
    }

    fun resolve(): RouteParams {
        var current_path: String = this.path.get()
        var i: Float = 0
        while (i < this.routes.length()) {
            var r: RouteDef = this.routes[i]
            var params: Map<String, String> = match_pattern(r.pattern, current_path)
            if (params != nil) {
                return RouteParams(current_path, params, {})
            }
            i = i + 1
        }
        return RouteParams(current_path, {}, {})
    }

    fun dispatch(current_path: String) {
        // Split path from query string
        var path_part: String = current_path
        var query_part: String = ""
        var qmark: Float = current_path.index_of("?")
        if (qmark >= 0) {
            path_part = current_path.slice(0, qmark)
            query_part = current_path.slice(qmark + 1, current_path.length())
        }
        var query: Map<String, String> = parse_query(query_part)

        var i: Float = 0
        while (i < this.routes.length()) {
            var r: RouteDef = this.routes[i]
            var params: Map<String, String> = match_pattern(r.pattern, path_part)
            if (params != nil) {
                r.handler(RouteParams(current_path, params, query))
                return
            }
            i = i + 1
        }
    }

    fun render() {
        // Create a persistent outlet element
        var outlet: Float = _rt_create("div")
        var parent: Float = _tc_current()
        _rt_append(parent, outlet)

        // Use effect to reactively re-render when path changes
        var self = this
        Sig.effect(fun () => {
            var current_path: String = self.path.get()
            // Clear outlet contents
            _rt_set_html(outlet, "")
            // Render matched route into outlet with tracking disabled
            // (so signal reads inside page components don't subscribe to this effect)
            var was: Bool = Sig._tracking
            Sig._tracking = false
            _tc_push(outlet)
            self.dispatch(current_path)
            _tc_pop()
            Sig._tracking = was
        })
    }


    fun _on_external_change() {
        this.path.set(_js_get_hash())
    }
}

// =============================================================================
// Constructors
// =============================================================================

fun hash(): Router {
    var initial: String = _js_get_hash()
    if (initial.length() == 0) { initial = "/" }
    return Router(Mode.Hash, initial)
}

fun history(): Router {
    var initial: String = _js_get_pathname()
    return Router(Mode.History, initial)
}

fun memory(initial: String): Router {
    return Router(Mode.Memory, initial)
}

// =============================================================================
// Link — SPA navigation component
// =============================================================================
// Renders <a href="..."> with proper href and click interception.
// href format matches the router mode:
//   Hash:    href="#/about"     (works without server config)
//   History: href="/about"      (clean URLs, needs server fallback)
//   Memory:  href="javascript:void(0)"  (no real navigation)
//
// Usage:
//   import { Link } from "turmeric/router"
//   Link(router, "/about", cls="nav-link") { text("About") }

fun Link(r: Router, to: String, cls: String = "", id: String = "", style: String = "", block: () => Nil = nil) {
    var href: String = to
    if (r._mode == Mode.Hash) {
        href = "#" + to
    } else if (r._mode == Mode.Memory) {
        href = "javascript:void(0)"
    }
    a(cls=cls, id=id, style=style, href=href, block=block)
}
