// Turmeric Context — dependency injection without prop-drilling
// Like React's Context or Solid's createContext

import "./signal.sf" as Sig

// =============================================================================
// Context<T> — a typed slot that can be provided and consumed in the tree
// =============================================================================

class Context<T> {
    var name: String
    var default_value: T

    fun init(name: String, default_value: T) {
        this.name = name
        this.default_value = default_value
    }
}

fun create_context<T>(name: String, default_value: T): Context<T> {
    return Context(name, default_value)
}

// =============================================================================
// Context Stack — tracks provided values during component tree construction
// =============================================================================

// Stack of context scopes. Each scope is a map of context_name → value.
// When a component provides a context, it pushes a scope.
// When a component consumes a context, it searches up the stack.

var _context_stack: List<Map<String, ContextEntry>> = []

class ContextEntry {
    var value: Sig.Signal<Any>

    fun init(value: Sig.Signal<Any>) {
        this.value = value
    }
}

fun _push_scope() {
    _context_stack.push({})
}

fun _pop_scope() {
    _context_stack.pop()
}

// =============================================================================
// Provide — make a value available to all descendants
// =============================================================================

fun provide<T>(ctx: Context<T>, value: T) {
    if (_context_stack.length() == 0) {
        _push_scope()
    }
    var scope: Map<String, ContextEntry> = _context_stack[_context_stack.length() - 1]
    scope.set(ctx.name, ContextEntry(Sig.signal(value)))
}

fun provide_signal<T>(ctx: Context<T>, sig: Sig.Signal<T>) {
    if (_context_stack.length() == 0) {
        _push_scope()
    }
    var scope: Map<String, ContextEntry> = _context_stack[_context_stack.length() - 1]
    scope.set(ctx.name, ContextEntry(sig))
}

// =============================================================================
// Consume — read the nearest provided value (searches up the stack)
// =============================================================================

fun use_context<T>(ctx: Context<T>): T {
    // Search from top of stack downward
    var i: Float = _context_stack.length() - 1
    while (i >= 0) {
        var scope: Map<String, ContextEntry> = _context_stack[i]
        if (scope.has(ctx.name)) {
            return scope.get(ctx.name).value.get()
        }
        i = i - 1
    }
    // Not found — return default
    return ctx.default_value
}

fun use_context_signal<T>(ctx: Context<T>): Sig.Signal<T> {
    var i: Float = _context_stack.length() - 1
    while (i >= 0) {
        var scope: Map<String, ContextEntry> = _context_stack[i]
        if (scope.has(ctx.name)) {
            return scope.get(ctx.name).value
        }
        i = i - 1
    }
    // Not found — create a signal with default
    return Sig.signal(ctx.default_value)
}

// =============================================================================
// Scoped Provider — RAII-style context scope for component builders
// =============================================================================

class ContextScope {
    fun init() {
        _push_scope()
    }

    fun provide<T>(ctx: Context<T>, value: T) {
        provide(ctx, value)
    }

    fun provide_signal<T>(ctx: Context<T>, sig: Sig.Signal<T>) {
        provide_signal(ctx, sig)
    }

    fun dispose() {
        _pop_scope()
    }
}

fun scoped(): ContextScope {
    return ContextScope()
}

// =============================================================================
// Common Contexts (pre-defined for typical app needs)
// =============================================================================

// Theme context
class ThemeConfig {
    var mode: String
    var primary_color: String
    var surface_color: String
    var text_color: String
    var font_family: String

    fun init(mode: String) {
        this.mode = mode
        if (mode == "dark") {
            this.primary_color = "#4fc3f7"
            this.surface_color = "#2d2d44"
            this.text_color = "#e0e0e0"
            this.font_family = "-apple-system, sans-serif"
        } else {
            this.primary_color = "#1976d2"
            this.surface_color = "#f5f5f5"
            this.text_color = "#1a1a1a"
            this.font_family = "-apple-system, sans-serif"
        }
    }
}

var ThemeContext: Context<ThemeConfig> = create_context("theme", ThemeConfig("dark"))

// Auth context
class AuthState {
    var logged_in: Bool
    var user_id: String
    var username: String
    var token: String

    fun init() {
        this.logged_in = false
        this.user_id = ""
        this.username = ""
        this.token = ""
    }
}

var AuthContext: Context<AuthState> = create_context("auth", AuthState())

// Router context (so deep components can navigate)
var RouterContext: Context<String> = create_context("router_path", "/")

// Locale/i18n context
class LocaleConfig {
    var language: String
    var direction: String

    fun init(language: String) {
        this.language = language
        if (language == "ar" or language == "he") {
            this.direction = "rtl"
        } else {
            this.direction = "ltr"
        }
    }
}

var LocaleContext: Context<LocaleConfig> = create_context("locale", LocaleConfig("en"))
