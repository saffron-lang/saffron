fun section(block: Any): Any {
    return _build_element("section", nil, block)
}

fun main(block: Any): Any {
    return _build_element("main", nil, block)
}

// --- Text node helper ---
// Inside a builder block, call text() to add text content

fun text(content: String) {
    _current_ctx().text(content)
}
